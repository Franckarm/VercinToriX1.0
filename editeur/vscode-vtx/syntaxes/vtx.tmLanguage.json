{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Vercintorix",
  "scopeName": "source.vtx",
  "patterns": [
    {
      "name": "comment.line.double-slash.vtx",
      "match": "//.*$"
    },
    {
      "name": "constant.numeric.adn.vtx",
      "match": "adn\"[ACGTUacgtu]{1,16}\""
    },
    {
      "name": "string.quoted.double.vtx",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.vtx",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.character.vtx",
      "match": "'(\\\\.|[^'\\\\])'"
    },
    {
      "name": "constant.numeric.cube.vtx",
      "match": "#(?:[0-9A-Fa-f]{8}|[0-9A-Fa-f]{6})(?![\\p{L}\\p{N}_])"
    },
    {
      "name": "constant.numeric.vtx",
      "match": "(?<![\\p{L}\\p{N}_])(?:0q[0-3_]+|0x[0-9A-Fa-f_]+L?|\\d[\\d_]*\\.\\d[\\d_]*(?:[eE][-+]?\\d+)?|\\d[\\d_]*[eE][-+]?\\d+|\\d[\\d_]*L?)(?![\\p{L}\\p{N}_])"
    },
    {
      "name": "keyword.control.vtx",
      "match": "(?<![\\p{L}\\p{N}_])(?:fonction|soit|si|sinon|tantque|pour|dans|par|en|segments|cumulant|retour|constante|structure|tableau|de|donnees|données|arrêter|arreter|continuer|hypothèse|hypothese|annuler|valider|selon|autre|importer|et|ou|non)(?![\\p{L}\\p{N}_])"
    },
    {
      "name": "storage.type.vtx",
      "match": "(?<![\\p{L}\\p{N}_])(?:entier|flottant|long|logique|quits|texte)(?![\\p{L}\\p{N}_])"
    },
    {
      "name": "constant.language.logique.vtx",
      "match": "(?<![\\p{L}\\p{N}_])(?:vrai|faux|inconnu|variable|nul)(?![\\p{L}\\p{N}_])"
    },
    {
      "name": "constant.language.etage.vtx",
      "match": "(?<![\\p{L}\\p{N}_])(?:CPU|GPU|PARTAGE|DISQUE)(?![\\p{L}\\p{N}_])"
    },
    {
      "name": "support.function.vtx",
      "match": "(?<![\\p{L}\\p{N}_])(?:sortie|entrée|entree|ecrire_car|lire_car|ecrire_texte|ecrire_nombre|ouvrir_lecture|ouvrir_ecriture|fermer|fin_de|et4|ou4|non4|anti|fusion|consensus|comme_logique|min4|max4|addm4|gdot|gemv|cmp3|qegal|nb_bits|flottant|flottant_signe|arrondi|racine|comme_flottant|bits|long_signe|long_de|bas|haut|abs|min|max|inf|sup|divs|mods|asr|signe|exp2|poids|gdotn|copier|melange|longueur|car|changer_car|texte_egal|nouveau|nouveau_de|tas_marque|tas_retour|texte_neuf|afficher|ecrire_entier|ecrire_flottant|ecrire_long|ecrire_logique|ecrire_hexa|pi|plancher|plafond|sinus|cosinus|tangente|exponentielle|logarithme|puissance|arctangente|arctangente2|arcsinus|arccosinus|graine|hasard|hasard_entre|hasard_flottant|hasard_mot|ecrire|texte|sous_texte|position|nombre|bruit|bruit_logique|graine_bruit)(?=\\s*\\()"
    },
    {
      "match": "(?<![\\p{L}\\p{N}_])(fonction)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
      "captures": {
        "1": {
          "name": "keyword.control.vtx"
        },
        "2": {
          "name": "entity.name.function.vtx"
        }
      }
    },
    {
      "match": "(?<![\\p{L}\\p{N}_])(structure)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
      "captures": {
        "1": {
          "name": "keyword.control.vtx"
        },
        "2": {
          "name": "entity.name.type.vtx"
        }
      }
    },
    {
      "name": "entity.name.function.call.vtx",
      "match": "[\\p{L}_][\\p{L}\\p{N}_]*(?=\\s*\\()"
    },
    {
      "name": "keyword.operator.memoire.vtx",
      "match": "@"
    },
    {
      "name": "keyword.operator.vtx",
      "match": "<<q|>>q|\\.>>|\\.<=|\\.>=|\\.<|\\.>|\\./|\\.%|\\.\\.|<<|>>|<=|>=|==|!=|&&|\\|\\||[-+*/%&|^~<>=!]"
    }
  ]
}