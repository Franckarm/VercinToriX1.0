{
  "Fonction": {
    "prefix": "fonction",
    "body": [
      "fonction ${1:nom}(${2}) {",
      "    $0",
      "}"
    ],
    "description": "une fonction"
  },
  "Principal": {
    "prefix": "principal",
    "body": [
      "fonction principal() {",
      "    $0",
      "}"
    ],
    "description": "le point de départ du programme"
  },
  "Soit": {
    "prefix": "soit",
    "body": [
      "soit ${1:x} = ${2:0};"
    ],
    "description": "une variable"
  },
  "Si": {
    "prefix": "si",
    "body": [
      "si ${1:condition} {",
      "    $0",
      "}"
    ],
    "description": "si"
  },
  "Si sinon": {
    "prefix": "sisinon",
    "body": [
      "si ${1:condition} {",
      "    $2",
      "} sinon {",
      "    $0",
      "}"
    ],
    "description": "si … sinon"
  },
  "Pour": {
    "prefix": "pour",
    "body": [
      "pour ${1:i} dans ${2:0}..${3:n} {",
      "    $0",
      "}"
    ],
    "description": "une boucle de a à b (b exclu)"
  },
  "Pour en segments": {
    "prefix": "segments",
    "body": [
      "pour ${1:i} dans ${2:0}..${3:n} en segments {",
      "    $0",
      "}"
    ],
    "description": "une boucle découpée sur plusieurs cœurs"
  },
  "Tantque": {
    "prefix": "tantque",
    "body": [
      "tantque ${1:condition} {",
      "    $0",
      "}"
    ],
    "description": "tant que"
  },
  "Selon": {
    "prefix": "selon",
    "body": [
      "selon ${1:l} {",
      "    vrai { $2 }",
      "    faux { $3 }",
      "    inconnu { $4 }",
      "    variable { $5 }",
      "}"
    ],
    "description": "les quatre valeurs d'un logique"
  },
  "Structure": {
    "prefix": "structure",
    "body": [
      "structure ${1:Nom} { ${2:champ} }"
    ],
    "description": "une structure"
  },
  "Tableau": {
    "prefix": "tableau",
    "body": [
      "tableau ${1:t}[${2:16}] @${3:1}[${4:0}];"
    ],
    "description": "un tableau rangé dans un étage"
  },
  "Texte": {
    "prefix": "texte",
    "body": [
      "ecrire_texte(1, \"${1:bonjour}\\n\");"
    ],
    "description": "écrire sur la console"
  },
  "Hypothèse": {
    "prefix": "hypothese",
    "body": [
      "hypothèse {",
      "    $1",
      "    si ${2:raté} { annuler; }",
      "    valider;",
      "}"
    ],
    "description": "essayer, puis garder ou défaire"
  }
}