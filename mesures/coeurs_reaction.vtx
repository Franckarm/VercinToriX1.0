// 0.857 : les réactions sur plusieurs cœurs, forgées par vtxc128 : une somme pour chaque (l'intervalle partagé entre
// les cœurs), une vague de deux atomes lourds (chacun sur son cœur), et quatre souvenirs (ceux qui ont oublié
// réagissent ensemble). VTX_COEURS=1 : tout sur un seul cœur, pour comparer. La même sortie dans les deux cas.
fonction carre_mod(i) { soit k = 0; soit x = i; tantque k < 20 { x = (x * x + 7) % 1000003; k = k + 1; } retour x; }
fonction bande_somme(a, b) { soit s = 0; pour i dans a..b { s = s + carre_mod(i); } retour s; }
fonction lourd(n) { soit s = 0; pour i dans 0..n { s = s + carre_mod(i) % 7; } retour s; }
reaction calcul(n) -> r {
    total = somme pour chaque i dans 0..n : carre_mod(i)   -> t
    = bande_somme(0, n / 2)    -> h
    = bande_somme(n / 2, n)    -> b
    = t + h + b            -> r
}
reaction scene(decor) -> r {
    = lourd(decor)         -> a
    = lourd(decor + 1)     -> b
    = lourd(decor + 2)     -> c
    = lourd(decor + 3)     -> d
    = a + b + c + d        -> r
}
fonction principal() {
    soit t0 = horloge();
    soit x = calcul(4000000);
    soit t1 = horloge();
    soit y = 0;
    pour k dans 0..40 { y = y + scene(200000 + (k / 4) * 7); }
    soit t2 = horloge();
    afficher(x);
    afficher(y);
    ecrire_texte(1, "pour chaque et vague : ");
    ecrire_entier(1, t1 - t0);
    ecrire_texte(1, " ms ; souvenirs : ");
    ecrire_entier(1, t2 - t1);
    ecrire_texte(1, " ms\n");
}
