fonction principal() {
    soit total = 0;
    pour py dans 0..300 {
        soit ci = flottant(py) * 0.008 - 1.2;
        pour px dans 0..400 {
            soit cr = flottant(px) * 0.0075 - 2.1;
            soit x = 0.0;
            soit y = 0.0;
            soit k = 0;
            tantque k < 200 && x * x + y * y <= 4.0 {
                soit t = x * x - y * y + cr;
                y = 2.0 * x * y + ci;
                x = t;
                k = k + 1;
            }
            total = total + k;
        }
    }
    sortie(total);
}
