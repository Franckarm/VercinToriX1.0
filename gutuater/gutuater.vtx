// machine : lugus
// Gutuater (0.825 ; son rôle redit le 26 novembre) : le prêtre-invocateur, qui vit dans le processeur. Il tient les
// gènes du graphisme et de la 3D quand ils tournent au processeur (la carte directe : le monde d'un seul tenant ; à venir :
// les fils, les bandes, les segments). Son carnet et son ARN sont dans le nemeton (carnet.vtx, synapse.vtx).
//
//     lugus gutuater/gutuater.vtx      (il lit une ligne : le nemeton du programme)

importer "synapse.vtx";
importer "carnet.vtx";

fonction principal() {
    tenir_carnet(dossier_lu(), "gutuater", "Gutuater");
}
