// machine : lugus
// Gutuater (0.825), le prêtre-invocateur : celui qui prononce les paroles justes. Il tient le carnet (l'épigénétique)
// et en tire l'ARN, le plan que lit le vergobret ; le programme (l'ADN) ne change jamais.
//
//     lugus gutuater/gutuater.vtx      (il lit une ligne : le dossier du programme forgé)
//
// Dans ce dossier : gutuater.mesures (écrit par le vergobret : « mesure GENE LIEU A B », deux temps en microsecondes :
// la variante exprimée, puis la variante tue), gutuater.carnet (ses synapses : « gene GENE LIEU POUR CONTRE ETAT »),
// gutuater.arn (le plan : « GENE LIEU ETAT »). 0.826 : le seuil d'une preuve tremble (synapse.vtx, preuve_tremblee).
// 0.826 : « infidele GENE LIEU » (la garde a vu la variante trahir) :
// le gène est tu pour toujours. Les mesures lues sont effacées : chacune ne compte qu'une fois.

importer "synapse.vtx";

fonction lire_fichier(nom: texte): texte {
    soit canal = ouvrir_lecture(nom);
    si canal == 18446744073709551615 {
        retour "";
    }
    soit cs = tableau(0);
    soit ch = lire_car(canal);
    tantque ch != 18446744073709551615 {
        si ch != 13 {
            ajouter(cs, ch);
        }
        ch = lire_car(canal);
    }
    fermer(canal);
    soit r = texte_neuf(longueur(cs));
    pour i dans 0..longueur(cs) {
        changer_car(r, i, cs[i]);
    }
    retour r;
}

fonction principal() {
    soit dossier = lire_ligne();
    // la fin de ligne de Windows, et les blancs de la fin
    tantque longueur(dossier) > 0 && (car(dossier, longueur(dossier) - 1) == 13 || car(dossier, longueur(dossier) - 1) == 32) {
        dossier = sous_texte(dossier, 0, longueur(dossier) - 1);
    }
    si longueur(dossier) > 0 && finit_par(dossier, "/") == 0 && finit_par(dossier, "\\") == 0 {
        dossier = dossier + "/";
    }
    // le carnet, en mémoire : un gène par place (son nom, son lieu, ses preuves, le dernier gain en pour mille + 1000)
    soit noms = ["lot"];
    soit lieux = [0];
    soit vp = [0];
    soit vc = [0];
    soit gains = [0];
    retirer(noms);
    retirer(lieux);
    retirer(vp);
    retirer(vc);
    retirer(gains);
    // 0.830 : les temps des gènes de la forge, en attendant leur paire
    soit tnoms = ["carte_directe"];
    soit tlieux = [0];
    soit tun = [0];
    soit tzero = [0];
    retirer(tnoms);
    retirer(tlieux);
    retirer(tun);
    retirer(tzero);
    // 1. le carnet d'avant, puis 2. les mesures du vergobret (une mesure : une preuve, ou rien dans le bruit)
    soit nm = 0;
    soit textes = [lire_fichier(dossier + "gutuater.carnet"), lire_fichier(dossier + "gutuater.mesures")];
    // 0.826 : le seuil tremble ; la graine vient des mesures elles-mêmes (la même entrée, la même décision : on peut
    // la refaire et la vérifier ; une autre source plus tard, un hasard quantique par exemple)
    soit g0 = 1469598103;
    pour qc dans 0..longueur(textes[1]) {
        g0 = (g0 * 16777619 + car(textes[1], qc)) % 4294967291;
    }
    graine(g0);
    pour quel dans 0..2 {
        pour l dans decouper(textes[quel], "\n") {
            soit m = mots(l);
            // 0.826 : « infidele GENE LIEU » : la variante a trahi la garde (une autre image) : une preuve contre définitive
            si quel == 1 && longueur(m) >= 3 {
                si m[0] == "infidele" {
                    soit nom_i = m[1];
                    soit lieu_i = nombre(m[2]);
                    soit ji = longueur(noms);
                    pour ki dans 0..longueur(noms) {
                        si noms[ki] == nom_i && lieux[ki] == lieu_i {
                            ji = ki;
                        }
                    }
                    si ji == longueur(noms) {
                        ajouter(noms, nom_i);
                        ajouter(lieux, lieu_i);
                        ajouter(vp, 0);
                        ajouter(vc, 0);
                        ajouter(gains, 0);
                    }
                    vp[ji] = 0;
                    vc[ji] = DEFINITIF;
                    nm = nm + 1;
                }
            }
            // 0.830 : « temps GENE LIEU VARIANTE MICROSECONDES » : un gène choisi à la forge ; chaque programme forgé
            // dit son temps entier et sa variante (1 exprimée, 0 tue) ; deux temps, une de chaque, font une mesure
            si quel == 1 && longueur(m) >= 5 {
                si m[0] == "temps" {
                    soit nom_t = m[1];
                    soit lieu_t2 = nombre(m[2]);
                    soit jt = longueur(tnoms);
                    pour kt dans 0..longueur(tnoms) {
                        si tnoms[kt] == nom_t && tlieux[kt] == lieu_t2 {
                            jt = kt;
                        }
                    }
                    si jt == longueur(tnoms) {
                        ajouter(tnoms, nom_t);
                        ajouter(tlieux, lieu_t2);
                        ajouter(tun, 0);
                        ajouter(tzero, 0);
                    }
                    si nombre(m[3]) == 1 {
                        tun[jt] = nombre(m[4]);
                    } sinon {
                        tzero[jt] = nombre(m[4]);
                    }
                }
            }
            si longueur(m) >= 5 {
                si (quel == 0 && m[0] == "gene") || (quel == 1 && m[0] == "mesure") {
                    soit nom = m[1];
                    soit lieu = nombre(m[2]);
                    soit j = longueur(noms);
                    pour k dans 0..longueur(noms) {
                        si noms[k] == nom && lieux[k] == lieu {
                            j = k;
                        }
                    }
                    si j == longueur(noms) {
                        ajouter(noms, nom);
                        ajouter(lieux, lieu);
                        ajouter(vp, 0);
                        ajouter(vc, 0);
                        ajouter(gains, 0);
                    }
                    soit a = nombre(m[3]);
                    soit b = nombre(m[4]);
                    si quel == 0 {
                        vp[j] = a;
                        vc[j] = b;
                    } sinon {
                        soit r = 1 + hasard(100);
                        vp[j] = vp[j] + preuve_pour(a, b, r);
                        vc[j] = vc[j] + preuve_pour(b, a, r);
                        si b > 0 && a <= b {
                            gains[j] = 1000 + ((b - a) * 1000) / b;
                        }
                        si b > 0 && a > b {
                            gains[j] = 1;
                            si (a - b) * 1000 / b < 999 {
                                gains[j] = 1000 - ((a - b) * 1000) / b;
                            }
                        }
                        nm = nm + 1;
                    }
                }
            }
        }
    }
    // 0.830 : chaque paire de temps (la variante exprimée, la variante tue) devient une mesure ; une moitié attend
    soit reste = "";
    pour kp dans 0..longueur(tnoms) {
        si tun[kp] > 0 && tzero[kp] > 0 {
            soit jp = longueur(noms);
            pour kq dans 0..longueur(noms) {
                si noms[kq] == tnoms[kp] && lieux[kq] == tlieux[kp] {
                    jp = kq;
                }
            }
            si jp == longueur(noms) {
                ajouter(noms, tnoms[kp]);
                ajouter(lieux, tlieux[kp]);
                ajouter(vp, 0);
                ajouter(vc, 0);
                ajouter(gains, 0);
            }
            soit rp = 1 + hasard(100);
            vp[jp] = vp[jp] + preuve_pour(tun[kp], tzero[kp], rp);
            vc[jp] = vc[jp] + preuve_pour(tzero[kp], tun[kp], rp);
            si tun[kp] <= tzero[kp] {
                gains[jp] = 1000 + ((tzero[kp] - tun[kp]) * 1000) / tzero[kp];
            } sinon {
                gains[jp] = 1;
                si (tun[kp] - tzero[kp]) * 1000 / tzero[kp] < 999 {
                    gains[jp] = 1000 - ((tun[kp] - tzero[kp]) * 1000) / tzero[kp];
                }
            }
            nm = nm + 1;
        } sinon si tun[kp] > 0 {
            reste = reste + "temps " + tnoms[kp] + " " + texte(tlieux[kp]) + " 1 " + texte(tun[kp]) + "\n";
        } sinon si tzero[kp] > 0 {
            reste = reste + "temps " + tnoms[kp] + " " + texte(tlieux[kp]) + " 0 " + texte(tzero[kp]) + "\n";
        }
    }
    // 3. l'usure, puis le carnet et l'ARN
    soit carnet = ouvrir_ecriture(dossier + "gutuater.carnet");
    soit arn = ouvrir_ecriture(dossier + "gutuater.arn");
    ecrire_texte(carnet, "# carnet de Gutuater : gene, lieu (la ligne), preuves pour, preuves contre, etat\n");
    ecrire_texte(arn, "# ARN de Gutuater, lu par le vergobret : gene, lieu, etat (vrai : exprime ; faux : tu ; inconnu, variable : a mesurer)\n");
    pour k dans 0..longueur(noms) {
        soit np = user_pour(vp[k], vc[k]);
        soit nc = user_contre(vp[k], vc[k]);
        soit e = nom_etat(etat_synapse(np, nc));
        soit lieu_t = texte(lieux[k]);
        ecrire_texte(carnet, "gene " + noms[k] + " " + lieu_t + " " + texte(np) + " " + texte(nc) + " " + e + "\n");
        ecrire_texte(arn, noms[k] + " " + lieu_t + " " + e + "\n");
        soit dit = "gutuater : " + noms[k] + " ligne " + lieu_t + " : pour " + texte(np) + ", contre " + texte(nc) + " : " + e;
        si gains[k] >= 1000 {
            dit = dit + " (dernière mesure : exprimé, il gagne " + texte((gains[k] - 1000) / 10) + " %)";
        } sinon si gains[k] > 0 {
            dit = dit + " (dernière mesure : exprimé, il coûte " + texte((1000 - gains[k]) / 10) + " % de plus)";
        }
        si nc >= DEFINITIF {
            dit = dit + " (infidèle : tu pour toujours)";
        }
        afficher(dit);
    }
    fermer(carnet);
    fermer(arn);
    // les mesures lues sont effacées (un temps sans sa paire reste)
    soit vide = ouvrir_ecriture(dossier + "gutuater.mesures");
    ecrire_texte(vide, reste);
    fermer(vide);
    afficher("gutuater : " + texte(nm) + " mesure(s) lue(s), " + texte(longueur(noms)) + " gène(s) au carnet");
}
