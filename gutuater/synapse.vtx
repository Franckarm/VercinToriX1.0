// machine : lugus
// La synapse quaternaire de Gutuater (0.825) : deux compteurs, les preuves pour et les preuves contre ; l'état est
// celui de Belnap : inconnu (rien de su), vrai, faux, variable (les preuves se contredisent : cela dépend de la scène
// ou de la machine). Une contradiction ne se moyenne pas : elle devient variable, et c'est une information.

constante SUR = 3;              // 0.826 : le poids qu'il faut d'un côté pour croire (une preuve forte, ou trois petites)
constante PLEIN = 24;           // l'usure : au-delà de 24 (en poids), les deux compteurs sont divisés par 2
constante DOMINE = 3;           // un côté l'emporte s'il a au moins trois fois le poids de l'autre
constante DEFINITIF = 64;       // 0.826 : une variante infidèle : tant de preuves contre, que l'usure ne touche pas

// 0.826 : la preuve tremblée (le bruit mis à profit : la résonance stochastique, l'arrondi stochastique). Un seuil
// fixe de 5 % jette pour toujours un vrai gain de 4 % : il n'apprend jamais (la stagnation de l'arrondi au plus près).
// Ici le seuil tremble, tiré au hasard entre 0,1 % et 10 % (r, en pour mille, de 1 à 100) : un gain g donne une petite
// preuve (un poids de 1) avec la chance g / 10 % ; au-delà de 10 %, toujours une preuve forte (un poids de SUR, qui
// suffit seule). En moyenne, le poids des preuves suit le gain : un petit gain réel s'accumule ; le bruit pur donne
// autant de pour que de contre, et reste inconnu ou variable : il n'est jamais pris pour un gain.
// Deux temps mesurés (en microsecondes ; plus petit est meilleur) : le poids de la preuve pour a (contre : échanger)
fonction preuve_pour(a, b, r) {
    si a * 1000 + 100 * b <= b * 1000 {
        retour SUR;
    }
    si a * 1000 + r * b <= b * 1000 {
        retour 1;
    }
    retour 0;
}

fonction etat_synapse(npour, ncontre): logique {
    si npour < SUR && ncontre < SUR {
        retour inconnu;
    }
    si npour >= SUR && npour >= DOMINE * ncontre {
        retour vrai;
    }
    si ncontre >= SUR && ncontre >= DOMINE * npour {
        retour faux;
    }
    retour variable;
}

// l'usure : une machine ou une scène nouvelle peut renverser une vieille croyance (une infidélité, jamais)
fonction user_pour(npour, ncontre) {
    si npour + ncontre > PLEIN && ncontre < DEFINITIF {
        retour npour / 2;
    }
    retour npour;
}
fonction user_contre(npour, ncontre) {
    si npour + ncontre > PLEIN && ncontre < DEFINITIF {
        retour ncontre / 2;
    }
    retour ncontre;
}

fonction nom_etat(l: logique): texte {
    selon l {
        vrai { retour "vrai"; }
        faux { retour "faux"; }
        inconnu { retour "inconnu"; }
        variable { retour "variable"; }
    }
    retour "inconnu";
}
