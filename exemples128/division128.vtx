// machine : lugus
// 0.834 : la division et le modulo de 128 bits (signés ou non, par zéro, le plus petit par -1, un diviseur de plus de
// 64 bits). Gobannos les traduit aussi (ses routines R_DIV128, R_DIVS128) : l'exécutable donne la même sortie.
//     lugus exemples128/division128.vtx
fonction principal() {
    soit a = (1 << 100) + 12345;
    afficher(a / 7, a % 7);
    afficher(a / ((1 << 70) + 3), a % ((1 << 70) + 3));
    afficher((0 - 1) / 3, (0 - 1) % 1000);
    afficher((0 - 100) ./ 7, (0 - 100) .% 7, 100 ./ (0 - 7));
    afficher(a / 0, a % 0);
    soit m = 1 << 127;
    afficher(m ./ (0 - 1), m .% (0 - 1));
    afficher(((1 << 127) + 5) / ((1 << 127) + 1), ((1 << 127) + 5) % ((1 << 127) + 1));
    soit x = 0;
    pour i dans 1..2000 { x = x + (a * i) / (i + 1) % 1000003; }
    afficher(x);
}
