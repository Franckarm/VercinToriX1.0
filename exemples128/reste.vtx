// 0.61b : le reste exact. Un garde fait sa ronde de 7,5 lieues sur un chemin de 2 lieues qui boucle : où en est-il ?
// Le même mot pour les entiers ; le doute ne se comble pas (un reste par zéro est une contradiction : variable).
fonction principal() {
    afficher("la ronde de 7.5 lieues sur une boucle de 2 :", reste(7.5, 2.0));
    afficher("à rebours :", reste(0.0 - 7.5, 2.0), "; tout juste :", reste(6.0, 2.0));
    afficher("100.05 par 0.1 (le reste exact des nombres rangés, qui ne sont pas 100.05 ni 0.1 tout juste) :", reste(100.05, 0.1));
    afficher("par zéro :", reste(7.5, 0.0), "; une boucle sans fin :", reste(7.5, 1.0 / 0.0));
    afficher("les heures : 29 h, c'est", reste(29, 24), "h ; 17 par -5 :", reste(17, 0 - 5));
}
