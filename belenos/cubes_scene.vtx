// Belenos : le paysage fait dans le cube (0.808).
//
// Le monde est fait de 2 × 2 tuiles ; chaque tuile a deux cubes, chacun à sa fréquence dans l'étage 2 :
//     le cube de texture  (fréquence FTEX + tuile) : la couleur de chaque point (0xRRGGBB)
//     le cube d'élément   (fréquence FELT + tuile) : ce qu'est chaque point : son état de Belnap (inconnu : vide ;
//                         vrai : matière), sa matière (roche, herbe, neige, eau…) et, pour un point de surface, son
//                         orientation (la normale)
// Un cube ne garde que ses points de surface : il est rangé en blocs de 8 × 8 × 8 ; son annuaire (les 32 768 premiers
// mots) dit pour chaque bloc s'il est vide, plein d'une même chose (un mot suffit) ou s'il porte une surface (alors ses
// 512 points sont rangés plus loin, dans la réserve du cube). Un rayon saute un bloc vide d'un coup.
// Le monde se lit en coordonnées globales : un rayon qui passe d'une tuile à l'autre passe d'un cube (d'une fréquence)
// à l'autre sans couture.
// 0.809 : la taille du monde est une échelle RN / RD (posée par le programme principal, avant d'importer ce fichier) :
// 1/2 (une tuile de 256), 1 (2 × 2 tuiles), 2 (4 × 4 tuiles : le même paysage, deux fois plus fin) ; les blocs vides
// savent à quelle distance est la matière (en blocs) : un rayon saute d'un coup tout le vide qu'ils promettent ;
// au-dessus du plus haut point du monde, un rayon qui monte ne lit plus rien.
// L'image : un rayon par point de l'écran ; l'ombre par la clepsydre (quatre rayons vers les quatre bords du soleil :
// les quatre en clair, vrai ; aucun, faux ; entre les deux, variable, la pénombre et sa densité) ; quatre rayons courts
// vers le ciel autour de la normale (l'occlusion) ; l'eau renvoie le monde (Divona : le rayon retourné), ridée.
// 0.810 : la lumière se range dans le cube, en deux calques par tuile (un octet par point de surface) : le ciel, une fois
// pour toutes ; la clepsydre, refaite quand le soleil bouge. L'œil qui vole ne paie plus qu'un rayon par point.

constante W = 1280;
constante H = 720;
constante TUILES = 2 * RN / RD;    // TUILES × TUILES tuiles
constante MONDE = 256 * TUILES;    // le côté du monde, en points
constante MASQ = MONDE - 1;
constante NB = MONDE / 8;          // le côté du monde, en blocs
constante FTEX = 1;                // le cube de texture de la tuile t : fréquence FTEX + t (jusqu'à 16 tuiles)
constante FELT = 17;               // le cube d'élément de la tuile t : fréquence FELT + t
constante FCIEL = 33;              // 0.810 : le calque du ciel de la tuile t (fréquence FCIEL + t) : ce que chaque point
                                   // de surface voit du ciel, rangé une fois (un octet par point, huit points par mot)
constante FSOL = 49;               // 0.810 : le calque du soleil de la tuile t (fréquence FSOL + t) : la clepsydre de
                                   // chaque point de surface, refaite seulement quand le soleil bouge
                                   // 0.812 : trois jeux de soleil (jeu 0, 1, 2 : FSOL + 16 · jeu + t ; ses directions
                                   // en SOLEILS + 16 · jeu) : le tapis en construit un pendant que les deux autres servent
constante REP = 32768;             // la réserve d'un cube : après son annuaire
constante MER = 44 * RN / RD;      // le niveau de la mer
constante VIDE = 9223372036854775808;  // 2 << 62 : un bloc vide ; ses bits bas : à combien de blocs est la matière
constante LOIN = 8;                // la distance la plus grande notée (en blocs)
constante MANQUE = 4611686018427387904;  // un rayon qui ne touche rien
constante HAUT_MAX = 16384000;     // 250 points (en 1/65536) : au-dessus, plus rien

// l'étage 2, fréquence 0 : les tables du programme
constante SINUS = 0;               // @2[SINUS + a] : 65536 · sin(2π a / 1024), signé
constante HCOL = 4194304;          // @2[HCOL + z·MONDE + x] : la hauteur du sol, en 1/256 de point
constante PENTE = 6291456;         // @2[PENTE + z·MONDE + x] : la pente du sol (en 1/256)
constante GLOB = 600000;           // la hauteur de l'arche ; les tailles des réserves ; le plus haut point du monde (+ 20)
constante SOLEILS = 600100;        // les quatre directions de la clepsydre (vers les bords du soleil), puis le soleil
constante COMPTE = 600200;         // @2[COMPTE + 4 y + e] : les points de la rangée y dans l'état e
constante DISTA = 1048576;         // la distance au plus proche bloc de matière (en blocs), puis sa copie : deux tableaux
constante DISTB = 2097152;

// les matières
constante ROCHE = 1;
constante HERBE = 2;
constante NEIGE = 3;
constante SABLE = 4;
constante EAU = 5;
constante TERRE = 6;
constante LANDE = 7;

// l'arche, à cheval sur deux tuiles (au milieu du monde : une frontière)
constante ARCHE_X = 256 * RN / RD;
constante ARCHE_Z = 300 * RN / RD;
constante ARCHE_R = 30 * RN / RD;  // le rayon de l'arche
constante ARCHE_E = 7 * RN / RD;   // l'épaisseur de sa pierre
constante P3 = 16 * RN / RD;       // la période du bruit du volume
constante UN = (RN + RD - 1) / RD; // une unité à l'échelle, jamais moins d'un point

// ---------------------------------------------------------------------------------------------------- les tables
fonction preparer_sinus() {
    pour a dans 0..1024 {
        soit u = a & 511;
        soit v = 4 * u * (512 - u) * 65536 / (327680 - u * (512 - u));
        si a >= 512 {
            @2[SINUS + a] = 0 - v;
        } sinon {
            @2[SINUS + a] = v;
        }
    }
}

fonction sin1024(a) {
    retour @2[SINUS + (a & 1023)];
}

fonction cos1024(a) {
    retour @2[SINUS + ((a + 256) & 1023)];
}

// -------------------------------------------------------------------------------------------------- les bruits
fonction hache(x, z) {
    soit h = (x & 4095) * 374761393 + (z & 4095) * 668265263 + 1013904223;
    h = (h ^ (h >> 13)) * 1274126177;
    retour (h ^ (h >> 16)) & 65535;
}

fonction hache3(x, y, z) {
    soit h = (x & 1023) * 374761393 + (y & 1023) * 668265263 + (z & 1023) * 2246822519 + 1013904223;
    h = (h ^ (h >> 13)) * 1274126177;
    retour (h ^ (h >> 16)) & 65535;
}

// le bruit lisse du plan, à la période p (une puissance de deux), sur le monde qui se répète
fonction bruit_lisse(x, z, p) {
    soit x0 = x / p;
    soit z0 = z / p;
    soit fx = (x % p) * 256 / p;
    soit fz = (z % p) * 256 / p;
    soit sx = fx * fx * (768 - 2 * fx) / 65536;
    soit sz = fz * fz * (768 - 2 * fz) / 65536;
    soit n = MONDE / p;
    soit a = hache(x0 % n, z0 % n);
    soit b = hache((x0 + 1) % n, z0 % n);
    soit c = hache(x0 % n, (z0 + 1) % n);
    soit d = hache((x0 + 1) % n, (z0 + 1) % n);
    soit h1 = (a * (256 - sx) + b * sx) / 256;
    soit h2 = (c * (256 - sx) + d * sx) / 256;
    retour (h1 * (256 - sz) + h2 * sz) / 256;
}

// le bruit lisse du volume, à la période P3 : les huit coins, mêlés en douceur (de 0 à 65535)
fonction bruit3(x, y, z) {
    soit x0 = x / P3;
    soit y0 = y / P3;
    soit z0 = z / P3;
    soit fx = (x % P3) * 256 / P3;
    soit fy = (y % P3) * 256 / P3;
    soit fz = (z % P3) * 256 / P3;
    soit sx = fx * fx * (768 - 2 * fx) / 65536;
    soit sy = fy * fy * (768 - 2 * fy) / 65536;
    soit sz = fz * fz * (768 - 2 * fz) / 65536;
    soit a0 = (hache3(x0, y0, z0) * (256 - sx) + hache3(x0 + 1, y0, z0) * sx) / 256;
    soit a1 = (hache3(x0, y0 + 1, z0) * (256 - sx) + hache3(x0 + 1, y0 + 1, z0) * sx) / 256;
    soit a2 = (hache3(x0, y0, z0 + 1) * (256 - sx) + hache3(x0 + 1, y0, z0 + 1) * sx) / 256;
    soit a3 = (hache3(x0, y0 + 1, z0 + 1) * (256 - sx) + hache3(x0 + 1, y0 + 1, z0 + 1) * sx) / 256;
    soit b0 = (a0 * (256 - sy) + a1 * sy) / 256;
    soit b1 = (a2 * (256 - sy) + a3 * sy) / 256;
    retour (b0 * (256 - sz) + b1 * sz) / 256;
}

// ------------------------------------------------------------------------------------------------------ le sol
// la hauteur de chaque colonne du monde (en 1/256 de point) : des collines, des vallées que la mer noie, des monts
fonction creer_sol() {
    pour z dans 0..MONDE en bandes {
        pour x dans 0..MONDE {
            soit h = bruit_lisse(x, z, 256 * RN / RD) * 16 + bruit_lisse(x, z, 128 * RN / RD) * 8
                     + bruit_lisse(x, z, 64 * RN / RD) * 4 + bruit_lisse(x, z, 32 * RN / RD) * 2 + bruit_lisse(x, z, 16 * RN / RD);
            // les octaves additionnées se moyennent : l'écart au milieu est étiré (fois 2,75), pour des vallées que la mer
            // noie et des monts qui montent jusqu'aux neiges
            soit n = h / 31;
            soit e = ((n - 32768) * 11) ./ 4;
            soit n2 = 32768 + e;
            si n2 .< 0 {
                n2 = 0;
            }
            si n2 > 65535 {
                n2 = 65535;
            }
            soit m = 0;
            si n2 > 34000 {
                m = (n2 - 34000) * 65536 / 31535;
            }
            si m > 65535 {
                m = 65535;
            }
            // 0.809 : au-dessus de 100, la pente des monts est divisée par six : le plus haut point reste sous 125 (sous
            // 250 au double de l'échelle : la hauteur d'un cube)
            soit hs = 34 * 256 + n2 * 48 / 256 + m * m / 65536 * 160 / 256;
            si hs > 100 * 256 {
                hs = 100 * 256 + (hs - 100 * 256) / 6;
            }
            @2[HCOL + z * MONDE + x] = hs * RN / RD;
        }
    }
    pour z dans 0..MONDE en bandes {
        pour x dans 0..MONDE {
            soit hx1 = @2[HCOL + z * MONDE + ((x + 1) & MASQ)];
            soit hx0 = @2[HCOL + z * MONDE + ((x + MASQ) & MASQ)];
            soit hz1 = @2[HCOL + ((z + 1) & MASQ) * MONDE + x];
            soit hz0 = @2[HCOL + ((z + MASQ) & MASQ) * MONDE + x];
            soit p = 0;
            si hx1 > hx0 { p = p + hx1 - hx0; } sinon { p = p + hx0 - hx1; }
            si hz1 > hz0 { p = p + hz1 - hz0; } sinon { p = p + hz0 - hz1; }
            @2[PENTE + z * MONDE + x] = p / 2;
        }
    }
    // l'arche se pose sur le sol, au milieu de ses deux pieds
    @2[GLOB] = (@2[HCOL + ARCHE_Z * MONDE + ARCHE_X - ARCHE_R] + @2[HCOL + ARCHE_Z * MONDE + ARCHE_X + ARCHE_R]) / 512;
    // le plus haut point du monde (le sol, ses surplombs, l'arche), en points, avec une marge
    soit haut = 0;
    pour i dans 0..(MONDE * MONDE) {
        si @2[HCOL + i] > haut {
            haut = @2[HCOL + i];
        }
    }
    haut = haut / 256 + 12 * RN / RD;
    si @2[GLOB] + ARCHE_R + ARCHE_E + 4 > haut {
        haut = @2[GLOB] + ARCHE_R + ARCHE_E + 4;
    }
    @2[GLOB + 20] = haut;
}

// l'ampleur des surplombs à la hauteur y (en 1/256 de point) : faible en bas, forte sur les hauteurs
fonction ampleur(y) {
    soit amp = 384 * RN / RD;
    si y > 70 * RN / RD && y < 4000 {
        amp = (384 + (y * RD / RN - 70) * 40) * RN / RD;
        si amp > 1800 * RN / RD {
            amp = 1800 * RN / RD;
        }
    }
    retour amp;
}

// la densité d'un point : positive dans la matière (en 1/256 de point) ; le sol, ses surplombs (le bruit du volume,
// fort sur les hauteurs : des rochers qui avancent au-dessus du vide), et l'arche
fonction densite(x, y, z) {
    soit h = @2[HCOL + (z & MASQ) * MONDE + (x & MASQ)];
    soit d = h - y * 256 - 128;
    soit amp = ampleur(y);
    si d .< amp + 512 && d .> 0 - amp - 512 {
        d = d + ((bruit3(x, y, z) - 32768) * amp) ./ 32768;
    }
    soit ay = @2[GLOB];
    soit ax = x - ARCHE_X;
    soit az = z - ARCHE_Z;
    soit ah = y - ay;
    si ax .> 0 - 48 * RN / RD && ax .< 48 * RN / RD && az .> 0 - 12 * RN / RD && az .< 12 * RN / RD && ah .> 0 - 8 * RN / RD
       && ah .< 48 * RN / RD {
        soit q = racine_entiere((ax * ax + ah * ah) * 65536);
        soit e = q - ARCHE_R * 256;
        soit dist = racine_entiere(e * e + az * az * 65536);
        // la pierre de l'arche n'est pas lisse : le bruit du volume la ronge
        soit da = ARCHE_E * 256 - dist + ((bruit3(x * 2, y * 2, z * 2) - 32768) * (300 * RN / RD)) ./ 32768;
        si da .> d {
            d = da;
        }
    }
    retour d;
}

// ce qu'est un point du monde : (sa couleur << 32) | son mot d'élément (l'état de Belnap sur 2 bits, la matière sur 6,
// la normale sur 24 : nx + 128, ny + 128, nz + 128) ; 0 : vide (inconnu)
fonction composer_point(x, y, z) {
    soit d0 = densite(x, y, z);
    si d0 .<= 0 {
        si y < MER {
            // l'eau : vraie matière, tournée vers le ciel ; sa couleur, plus sombre au large
            soit fond = (MER * 256 - @2[HCOL + (z & MASQ) * MONDE + (x & MASQ)]) ./ (64 * RN / RD);
            si fond .< 0 {
                fond = 0;
            }
            si fond > 120 {
                fond = 120;
            }
            soit ce = rgb24(40 - fond / 6, 96 - fond / 3, 104 - fond / 5);
            retour (ce << 32) | (normale_mot(0, 127, 0) << 8) | (EAU << 2) | 2;
        }
        retour 0;
    }
    soit dxm = densite(x - 1, y, z);
    soit dxp = densite(x + 1, y, z);
    soit dym = densite(x, y - 1, z);
    soit dyp = densite(x, y + 1, z);
    soit dzm = densite(x, y, z - 1);
    soit dzp = densite(x, y, z + 1);
    soit surface = 0;
    si dxm .<= 0 || dxp .<= 0 || dym .<= 0 || dyp .<= 0 || dzm .<= 0 || dzp .<= 0 {
        surface = 1;
    }
    // la matière
    soit col = (z & MASQ) * MONDE + (x & MASQ);
    soit hs = @2[HCOL + col] / 256;
    soit pente = @2[PENTE + col];
    soit mat = HERBE;
    si y + 3 * RN / RD < hs {
        mat = TERRE;
    }
    si dyp .> 0 && surface == 1 {
        // le dessous d'un surplomb, ou un flanc qui ne voit pas le ciel
        mat = ROCHE;
    } sinon si y <= MER + UN && y + UN >= MER {
        mat = SABLE;
    } sinon si y > 108 * RN / RD {
        si pente < 300 {
            mat = NEIGE;
        } sinon {
            mat = ROCHE;
        }
    } sinon si pente > 420 || y > hs + UN {
        mat = ROCHE;
    } sinon si y > 80 * RN / RD {
        mat = LANDE;
    }
    // la couleur : celle de la matière, des taches (le bruit du plan) et un grain (point par point)
    soit r = 78;
    soit g = 120;
    soit b = 58;
    si mat == ROCHE {
        r = 120;
        g = 114;
        b = 106;
    } sinon si mat == NEIGE {
        r = 236;
        g = 240;
        b = 246;
    } sinon si mat == SABLE {
        r = 196;
        g = 182;
        b = 140;
    } sinon si mat == TERRE {
        r = 100;
        g = 80;
        b = 60;
    } sinon si mat == LANDE {
        r = 128;
        g = 118;
        b = 80;
    }
    soit tache = (bruit_lisse(x & MASQ, z & MASQ, 32 * RN / RD) / 2048) + ((y * RD / RN) & 3);
    soit grain = hache3(x, y, z) & 15;
    r = r + tache + grain;
    g = g + tache + grain;
    b = b + tache / 2 + grain;
    soit c = rgb24(r, g, b);
    soit nm = 0;
    si surface == 1 {
        // l'orientation : contre la pente de la densité
        soit nx = dxm - dxp;
        soit ny = dym - dyp;
        soit nz = dzm - dzp;
        soit lg = racine_entiere(nx * nx + ny * ny + nz * nz);
        si lg == 0 {
            nm = normale_mot(0, 127, 0);
        } sinon {
            nm = normale_mot((nx * 127) ./ lg, (ny * 127) ./ lg, (nz * 127) ./ lg);
        }
    }
    retour (c << 32) | (nm << 8) | (mat << 2) | 2;
}

fonction rgb24(r, g, b) {
    si r .< 0 {
        r = 0;
    }
    si g .< 0 {
        g = 0;
    }
    si b .< 0 {
        b = 0;
    }
    si r > 255 {
        r = 255;
    }
    si g > 255 {
        g = 255;
    }
    si b > 255 {
        b = 255;
    }
    retour (r << 16) | (g << 8) | b;
}

fonction normale_mot(nx, ny, nz) {
    retour ((nx + 128) & 255) | (((ny + 128) & 255) << 8) | (((nz + 128) & 255) << 16);
}

// ---------------------------------------------------------------------------------------- les cubes des tuiles
// premier passage : chaque bloc de chaque tuile est classé : vide (0), plein d'une même chose (1 << 62 | le mot), ou
// porteur d'une surface (1 : à remplir) ; le sol de ses colonnes et le bruit du volume suffisent à le dire
fonction classer_blocs() {
    pour q dans 0..(TUILES * TUILES * 1024) en bandes {
        soit t = q >> 10;
        soit bx = q & 31;
        soit bz = (q >> 5) & 31;
        soit x0 = (t % TUILES) * 256 + bx * 8;
        soit z0 = (t / TUILES) * 256 + bz * 8;
        // le sol le plus bas et le plus haut des colonnes du bloc et de leurs voisines
        soit hmin = 1000000;
        soit hmax = 0;
        pour dz dans 0..10 {
            pour dx dans 0..10 {
                soit h = @2[HCOL + ((z0 + dz + MASQ) & MASQ) * MONDE + ((x0 + dx + MASQ) & MASQ)];
                si h < hmin {
                    hmin = h;
                }
                si h > hmax {
                    hmax = h;
                }
            }
        }
        soit base = (FELT + t) << 24;
        soit tex = (FTEX + t) << 24;
        // l'arche : les blocs de sa boîte portent une surface
        soit ay = @2[GLOB];
        soit arche_x = 0;
        si x0 + 8 + 48 * RN / RD > ARCHE_X && x0 < ARCHE_X + 48 * RN / RD && z0 + 8 + 12 * RN / RD > ARCHE_Z
           && z0 < ARCHE_Z + 12 * RN / RD {
            arche_x = 1;
        }
        pour by dans 0..32 {
            soit y0 = by * 8;
            soit amp = ampleur(y0 + 9);
            soit b = (bx << 10) | (by << 5) | bz;
            soit e = 1;
            si arche_x == 1 && y0 + 9 + 8 * RN / RD > ay && y0 < ay + 48 * RN / RD + 1 {
                e = 1;
            } sinon si y0 * 256 > hmax + amp + 640 {
                // au-dessus du sol : l'air, ou l'eau sous la mer
                si y0 >= MER {
                    e = 0;
                } sinon si y0 + 8 <= MER {
                    e = 3;
                }
            } sinon si (y0 + 9) * 256 + 640 + amp < hmin {
                // sous le sol, loin de toute surface : la terre
                e = 2;
            }
            si e == 0 {
                @2[base + b] = VIDE;
            } sinon si e == 2 {
                @2[base + b] = (1 << 62) | (TERRE << 2) | 2;
                @2[tex + b] = rgb24(100, 80, 60);
            } sinon si e == 3 {
                soit c = composer_point(x0 + 4, y0 + 4, z0 + 4);
                @2[base + b] = (1 << 62) | (c & 4294967295);
                @2[tex + b] = c >> 32;
            } sinon {
                @2[base + b] = 1;
            }
        }
    }
}

// deuxième passage (un seul cœur) : chaque bloc porteur d'une surface reçoit sa place dans la réserve de son cube
fonction placer_blocs() {
    pour t dans 0..(TUILES * TUILES) {
        soit base = (FELT + t) << 24;
        soit n = 0;
        pour b dans 0..32768 {
            si @2[base + b] == 1 {
                @2[base + b] = 16 + n;
                n = n + 1;
            }
        }
        @2[GLOB + 1 + t] = n;
    }
}

// troisième passage : les 512 points de chaque bloc porteur, dans les deux cubes (chaque bloc écrit sa seule place)
fonction remplir_blocs() {
    pour q dans 0..(TUILES * TUILES * 1024) en bandes {
        soit t = q >> 10;
        soit bx = q & 31;
        soit bz = (q >> 5) & 31;
        soit x0 = (t % TUILES) * 256 + bx * 8;
        soit z0 = (t / TUILES) * 256 + bz * 8;
        soit base = (FELT + t) << 24;
        soit tex = (FTEX + t) << 24;
        pour by dans 0..32 {
            soit e = @2[base + ((bx << 10) | (by << 5) | bz)];
            si e >= 16 && e < (1 << 62) {
                soit place = REP + (e - 16) * 512;
                pour v dans 0..512 {
                    soit c = composer_point(x0 + (v >> 6), by * 8 + ((v >> 3) & 7), z0 + (v & 7));
                    @2[base + place + v] = c & 4294967295;
                    @2[tex + place + v] = c >> 32;
                }
            }
        }
    }
}

// 0.809 : les blocs vides savent à quelle distance est la matière : la distance (en blocs, au plus LOIN) au plus proche
// bloc qui n'est pas vide, dans les 26 directions (le cube de blocs autour) ; calculée sur tout le monde (les tuiles
// voisines comptent : un rayon passe d'un cube à l'autre) ; chaque tour l'étend d'un bloc (deux tableaux, l'un lu,
// l'autre écrit : les tours vont en bandes)
fonction case_bloc(gx, gy, gz) {
    retour (gy * NB + gz) * NB + gx;
}

fonction mot_bloc(gx, gy, gz) {
    soit t = (gz >> 5) * TUILES + (gx >> 5);
    retour @2[((FELT + t) << 24) + ((gx & 31) << 10) + (gy << 5) + (gz & 31)];
}

fonction distancer_blocs() {
    pour q dans 0..(NB * 32) en bandes {
        soit gy = q / NB;
        soit gz = q % NB;
        pour gx dans 0..NB {
            soit d = 0;
            si (mot_bloc(gx, gy, gz) >> 62) == 2 {
                d = LOIN;
            }
            @2[DISTA + case_bloc(gx, gy, gz)] = d;
        }
    }
    pour tour dans 0..(LOIN - 1) {
        soit de = DISTA;
        soit vers = DISTB;
        si (tour & 1) == 1 {
            de = DISTB;
            vers = DISTA;
        }
        pour q2 dans 0..(NB * 32) en bandes {
            soit gy2 = q2 / NB;
            soit gz2 = q2 % NB;
            pour gx2 dans 0..NB {
                soit d2 = @2[de + case_bloc(gx2, gy2, gz2)];
                si d2 > 1 {
                    pour k dans 0..27 {
                        soit nx = gx2 + (k % 3) - 1;
                        soit ny = gy2 + ((k / 3) % 3) - 1;
                        soit nz = gz2 + (k / 9) - 1;
                        si nx < NB && ny < 32 && nz < NB {
                            soit v = @2[de + case_bloc(nx, ny, nz)] + 1;
                            si v < d2 {
                                d2 = v;
                            }
                        }
                    }
                }
                @2[vers + case_bloc(gx2, gy2, gz2)] = d2;
            }
        }
    }
    // le dernier tableau écrit : DISTB si LOIN - 1 est impair
    soit fin = DISTA;
    si ((LOIN - 1) & 1) == 1 {
        fin = DISTB;
    }
    pour q3 dans 0..(NB * 32) en bandes {
        soit gy3 = q3 / NB;
        soit gz3 = q3 % NB;
        pour gx3 dans 0..NB {
            soit t3 = (gz3 >> 5) * TUILES + (gx3 >> 5);
            soit a3 = ((FELT + t3) << 24) + ((gx3 & 31) << 10) + (gy3 << 5) + (gz3 & 31);
            si (@2[a3] >> 62) == 2 {
                @2[a3] = VIDE | @2[fin + case_bloc(gx3, gy3, gz3)];
            }
        }
    }
}

fonction creer_monde() {
    preparer_sinus();
    creer_sol();
    classer_blocs();
    placer_blocs();
    remplir_blocs();
    distancer_blocs();
}

// ---------------------------------------------------------------------------------------- lire le monde
// le mot d'élément d'un point (x, y, z dans le monde) : 0 si vide ou hors du monde
fonction element(x, y, z) {
    si x >= MONDE || z >= MONDE || y >= 256 {
        retour 0;
    }
    soit base = (FELT + (z >> 8) * TUILES + (x >> 8)) << 24;
    soit e = @2[base + (((x >> 3) & 31) << 10) + (((y >> 3) & 31) << 5) + ((z >> 3) & 31)];
    si (e >> 62) == 2 {
        retour 0;
    }
    si (e >> 62) == 1 {
        retour e & 4294967295;
    }
    retour @2[base + REP + (e - 16) * 512 + ((x & 7) << 6) + ((y & 7) << 3) + (z & 7)];
}

// la couleur d'un point (du cube de texture)
fonction couleur(x, y, z) {
    soit t = (z >> 8) * TUILES + (x >> 8);
    soit b = (((x >> 3) & 31) << 10) + (((y >> 3) & 31) << 5) + ((z >> 3) & 31);
    soit e = @2[((FELT + t) << 24) + b];
    si (e >> 62) == 1 {
        retour @2[((FTEX + t) << 24) + b];
    }
    retour @2[((FTEX + t) << 24) + REP + (e - 16) * 512 + ((x & 7) << 6) + ((y & 7) << 3) + (z & 7)];
}

// la marche d'un rayon : de (ox, oy, oz) dans la direction (dx, dy, dz) (en 1/65536, de longueur 65536), jusqu'à la
// distance tmax ; rend la distance du premier point touché (en 1/65536), ou MANQUE. Un bloc vide se saute d'un coup ;
// dans un bloc porteur, point par point. eau == 0 : l'eau ne compte pas (les rayons d'ombre et de ciel la traversent)
fonction tracer(ox, oy, oz, dx, dy, dz, tmax, eau) {
    soit t = 0;
    // 0.809 : au-dessus du plus haut point du monde, un rayon qui monte ne touchera plus rien
    soit plafond = @2[GLOB + 20] << 16;
    // 0.811 : le rayon apprend sa pente une fois : l'inverse de chaque direction (2^40 / |d|) ; chaque pas multiplie au
    // lieu de diviser (trois divisions de moins par pas : la division est l'opération la plus lente du processeur)
    soit ix = 0;
    soit iy = 0;
    soit iz = 0;
    si dx .> 0 {
        ix = 1099511627776 / dx;
    } sinon si dx .< 0 {
        ix = 1099511627776 / (0 - dx);
    }
    si dy .> 0 {
        iy = 1099511627776 / dy;
    } sinon si dy .< 0 {
        iy = 1099511627776 / (0 - dy);
    }
    si dz .> 0 {
        iz = 1099511627776 / dz;
    } sinon si dz .< 0 {
        iz = 1099511627776 / (0 - dz);
    }
    tantque t < tmax {
        soit px = ox + ((dx * t) .>> 16);
        soit py = oy + ((dy * t) .>> 16);
        soit pz = oz + ((dz * t) .>> 16);
        si py .>= plafond && dy .>= 0 {
            retour MANQUE;
        }
        si py .< 0 || px .< 0 || pz .< 0 || px .>= MONDE * 65536 || pz .>= MONDE * 65536 || py .>= 256 * 65536 {
            retour MANQUE;
        }
        soit x = px >> 16;
        soit y = py >> 16;
        soit z = pz >> 16;
        soit base = (FELT + (z >> 8) * TUILES + (x >> 8)) << 24;
        soit e = @2[base + (((x >> 3) & 31) << 10) + (((y >> 3) & 31) << 5) + ((z >> 3) & 31)];
        soit s = 8;
        // la boîte à quitter : le point (s = 1), son bloc, ou (un bloc vide qui sait sa distance d) les d - 1 blocs
        // autour, tous vides : de (bloc - (d - 1)) · 8 à (bloc + d) · 8 sur chaque axe
        soit av = 1;
        si (e >> 62) == 2 {
            av = e & 255;
        } sinon {
            si (e >> 62) == 1 {
                si eau == 1 || ((e >> 2) & 63) != EAU {
                    retour t;
                }
            } sinon {
                soit v = @2[base + REP + (e - 16) * 512 + ((x & 7) << 6) + ((y & 7) << 3) + (z & 7)];
                si v != 0 && (eau == 1 || ((v >> 2) & 63) != EAU) {
                    retour t;
                }
                s = 1;
            }
        }
        soit arr = 0;
        si s == 8 {
            arr = (av - 1) * 8;
        }
        // la sortie de la cellule (le bloc, ou le point) : la plus proche des trois faces vers où va le rayon
        soit pas = MANQUE;
        si dx .> 0 {
            soit ex1 = (((((x | (s - 1)) + 1 + arr) << 16) - px) * ix) >> 24;
            si ex1 < pas {
                pas = ex1;
            }
        } sinon si dx .< 0 {
            soit ex2 = (((px - (((x & (0 - s)) - arr) << 16)) + 1) * ix) >> 24;
            si ex2 < pas {
                pas = ex2;
            }
        }
        si dy .> 0 {
            soit ey1 = (((((y | (s - 1)) + 1 + arr) << 16) - py) * iy) >> 24;
            si ey1 < pas {
                pas = ey1;
            }
        } sinon si dy .< 0 {
            soit ey2 = (((py - (((y & (0 - s)) - arr) << 16)) + 1) * iy) >> 24;
            si ey2 < pas {
                pas = ey2;
            }
        }
        si dz .> 0 {
            soit ez1 = (((((z | (s - 1)) + 1 + arr) << 16) - pz) * iz) >> 24;
            si ez1 < pas {
                pas = ez1;
            }
        } sinon si dz .< 0 {
            soit ez2 = (((pz - (((z & (0 - s)) - arr) << 16)) + 1) * iz) >> 24;
            si ez2 < pas {
                pas = ez2;
            }
        }
        t = t + pas + 1;
    }
    retour MANQUE;
}

// ---------------------------------------------------------------------------------------------------- la lumière
// le soleil (az, el sur 1024) et les quatre directions de la clepsydre : vers les quatre bords du disque du soleil (un
// disque élargi, à 2 degrés : la pénombre se voit)
fonction preparer_soleil(az, el, jeu) {
    soit so = SOLEILS + 16 * jeu;
    soit lx = (cos1024(el) * sin1024(az)) ./ 65536;
    soit ly = sin1024(el);
    soit lz = (cos1024(el) * cos1024(az)) ./ 65536;
    @2[so + 12] = lx;
    @2[so + 13] = ly;
    @2[so + 14] = lz;
    // deux directions perpendiculaires : u (horizontale), v = u × l
    soit ul = racine_entiere(lx * lx + lz * lz);
    soit ux = (lz * 65536) ./ ul;
    soit uz = (0 - lx) * 65536 ./ ul;
    soit vx = (0 - uz * ly) ./ 65536;
    soit vy = (uz * lx - ux * lz) ./ 65536;
    soit vz = (ux * ly) ./ 65536;
    pour k dans 0..4 {
        soit ex = 0;
        soit ey = 0;
        soit ez = 0;
        si k == 0 {
            ex = ux;
            ez = uz;
        } sinon si k == 1 {
            ex = 0 - ux;
            ez = 0 - uz;
        } sinon si k == 2 {
            ex = vx;
            ey = vy;
            ez = vz;
        } sinon {
            ex = 0 - vx;
            ey = 0 - vy;
            ez = 0 - vz;
        }
        soit sx = lx + (ex * 2300) ./ 65536;
        soit sy = ly + (ey * 2300) ./ 65536;
        soit sz = lz + (ez * 2300) ./ 65536;
        soit lg = racine_entiere(sx * sx + sy * sy + sz * sz);
        @2[so + 3 * k] = (sx * 65536) ./ lg;
        @2[so + 3 * k + 1] = (sy * 65536) ./ lg;
        @2[so + 3 * k + 2] = (sz * 65536) ./ lg;
    }
}

// le ciel dans la direction d : du bleu en haut au clair de l'horizon, le disque du soleil et sa lueur
fonction ciel(dx, dy, dz, jeu) {
    soit hy = dy;
    si hy .< 0 {
        hy = 0;
    }
    soit t = hy * 256 / 65536;
    soit r = (200 * (256 - t) + 92 * t) / 256;
    soit g = (214 * (256 - t) + 128 * t) / 256;
    soit b = (230 * (256 - t) + 184 * t) / 256;
    soit so = SOLEILS + 16 * jeu;
    soit cs = (dx * @2[so + 12] + dy * @2[so + 13] + dz * @2[so + 14]) ./ 65536;
    si cs .> 65500 {
        retour rgb24(255, 248, 228);
    }
    si cs .> 60000 {
        soit lueur = (cs - 60000) * 90 / 5500;
        r = r + lueur;
        g = g + lueur * 3 / 4;
        b = b + lueur / 3;
    }
    retour rgb24(r, g, b);
}

// ---------------------------------------------------------------------------------------- les calques de lumière
// 0.810 : la lumière d'un point de surface se calcule depuis son centre (pas depuis l'endroit où le rayon de l'œil l'a
// touché) : elle ne dépend plus de l'œil, elle se range dans le cube. Le ciel ne dépend ni de l'œil ni du soleil : il se
// range une fois ; la clepsydre dépend du soleil : elle se refait quand il bouge, et l'œil qui vole n'en paie rien.

// le départ des rayons d'un point de surface : son centre, poussé le long de la normale (d'une demi-maille et 1,16 :
// comme depuis sa face, en 0.809) ; si ce départ tombe dans la matière (une arête, une marche : la normale penche vers
// un voisin plein), le centre du voisin vide le mieux tourné vers la normale. Rend 6 (le départ le long de la normale)
// ou le voisin choisi : 0 +x, 1 -x, 2 +y, 3 -y, 4 +z, 5 -z
fonction depart(x, y, z, nx, ny, nz) {
    soit sx = (x << 16) + 32768 + nx * 858;
    soit sy = (y << 16) + 32768 + ny * 858;
    soit sz = (z << 16) + 32768 + nz * 858;
    si element(sx >> 16, sy >> 16, sz >> 16) != 0 {
        soit meilleur = 6;
        soit note = 0 - 1000;
        pour k dans 0..6 {
            soit vx = x;
            soit vy = y;
            soit vz = z;
            soit nk = nx;
            si k == 0 {
                vx = x + 1;
            } sinon si k == 1 {
                vx = x - 1;
                nk = 0 - nx;
            } sinon si k == 2 {
                vy = y + 1;
                nk = ny;
            } sinon si k == 3 {
                vy = y - 1;
                nk = 0 - ny;
            } sinon si k == 4 {
                vz = z + 1;
                nk = nz;
            } sinon {
                vz = z - 1;
                nk = 0 - nz;
            }
            si element(vx, vy, vz) == 0 && nk .> note {
                note = nk;
                meilleur = k;
            }
        }
        retour meilleur;
    }
    retour 6;
}

// la clepsydre d'un point : combien des quatre rayons vers les bords du soleil passent (0 si la pente lui tourne le dos)
fonction soleil_depuis(sx, sy, sz, nx, ny, nz, jeu) {
    soit so = SOLEILS + 16 * jeu;
    soit nl = (nx * @2[so + 12] + ny * @2[so + 13] + nz * @2[so + 14]) ./ 127;
    si nl .<= 0 {
        retour 0;
    }
    soit vus = 0;
    pour k dans 0..4 {
        si tracer(sx, sy, sz, @2[so + 3 * k], @2[so + 3 * k + 1], @2[so + 3 * k + 2], 700 * 65536 * RN / RD, 0)
           == MANQUE {
            vus = vus + 1;
        }
    }
    retour vus;
}

// le ciel vu d'un point : quatre rayons courts autour de la normale (la normale penchée vers deux directions
// perpendiculaires, dans les deux sens) ; combien passent
fonction ciel_depuis(sx, sy, sz, nx, ny, nz) {
    soit n16x = nx * 516;
    soit n16y = ny * 516;
    soit n16z = nz * 516;
    // t1 : perpendiculaire à la normale (sa composante la plus faible mise à part)
    soit t1x = 0;
    soit t1y = 0;
    soit t1z = 0;
    soit ay_ = ny;
    si ay_ .< 0 {
        ay_ = 0 - ay_;
    }
    si ay_ .< 90 {
        // une paroi : t1 = n × (0, 1, 0)
        t1x = 0 - n16z;
        t1z = n16x;
    } sinon {
        // un replat : t1 = n × (1, 0, 0)
        t1y = n16z;
        t1z = 0 - n16y;
    }
    soit l1 = racine_entiere(t1x * t1x + t1y * t1y + t1z * t1z);
    si l1 == 0 {
        l1 = 1;
    }
    t1x = (t1x * 65536) ./ l1;
    t1y = (t1y * 65536) ./ l1;
    t1z = (t1z * 65536) ./ l1;
    soit t2x = (n16y * t1z - n16z * t1y) ./ 65536;
    soit t2y = (n16z * t1x - n16x * t1z) ./ 65536;
    soit t2z = (n16x * t1y - n16y * t1x) ./ 65536;
    soit ouverts = 0;
    pour k dans 0..4 {
        soit ex = t1x;
        soit ey = t1y;
        soit ez = t1z;
        si k == 1 {
            ex = 0 - t1x;
            ey = 0 - t1y;
            ez = 0 - t1z;
        } sinon si k == 2 {
            ex = t2x;
            ey = t2y;
            ez = t2z;
        } sinon si k == 3 {
            ex = 0 - t2x;
            ey = 0 - t2y;
            ez = 0 - t2z;
        }
        soit cx = (n16x * 3 + ex * 4) ./ 5;
        soit cy = (n16y * 3 + ey * 4) ./ 5;
        soit cz = (n16z * 3 + ez * 4) ./ 5;
        si tracer(sx, sy, sz, cx, cy, cz, 14 * 65536 * RN / RD, 0) == MANQUE {
            ouverts = ouverts + 1;
        }
    }
    retour ouverts;
}

// la clepsydre et le ciel d'un point de surface, depuis son centre (ou son voisin vide) : ce qui se range
fonction soleil_vu(x, y, z, nx, ny, nz, jeu) {
    soit sx = (x << 16) + 32768 + nx * 858;
    soit sy = (y << 16) + 32768 + ny * 858;
    soit sz = (z << 16) + 32768 + nz * 858;
    soit dp = depart(x, y, z, nx, ny, nz);
    si dp < 6 {
        sx = (x << 16) + 32768;
        sy = (y << 16) + 32768;
        sz = (z << 16) + 32768;
        si dp == 0 {
            sx = sx + 65536;
        } sinon si dp == 1 {
            sx = sx - 65536;
        } sinon si dp == 2 {
            sy = sy + 65536;
        } sinon si dp == 3 {
            sy = sy - 65536;
        } sinon si dp == 4 {
            sz = sz + 65536;
        } sinon {
            sz = sz - 65536;
        }
    }
    retour soleil_depuis(sx, sy, sz, nx, ny, nz, jeu);
}

fonction ciel_ouvert(x, y, z, nx, ny, nz) {
    soit sx = (x << 16) + 32768 + nx * 858;
    soit sy = (y << 16) + 32768 + ny * 858;
    soit sz = (z << 16) + 32768 + nz * 858;
    soit dp = depart(x, y, z, nx, ny, nz);
    si dp < 6 {
        sx = (x << 16) + 32768;
        sy = (y << 16) + 32768;
        sz = (z << 16) + 32768;
        si dp == 0 {
            sx = sx + 65536;
        } sinon si dp == 1 {
            sx = sx - 65536;
        } sinon si dp == 2 {
            sy = sy + 65536;
        } sinon si dp == 3 {
            sy = sy - 65536;
        } sinon si dp == 4 {
            sz = sz + 65536;
        } sinon {
            sz = sz - 65536;
        }
    }
    retour ciel_depuis(sx, sy, sz, nx, ny, nz);
}

// la normale d'un mot d'élément, en trois nombres signés (rangés en un : x | y << 16 | z << 32, chacun + 128)
fonction normale_de(e) {
    soit nx = ((e >> 8) & 255);
    si nx == 0 {
        retour 128 | (255 << 16) | (128 << 32);
    }
    retour nx | (((e >> 16) & 255) << 16) | (((e >> 24) & 255) << 32);
}

// un point de surface : de la matière (pas de l'eau) avec, à côté, un point vide (par où un rayon peut l'atteindre)
fonction expose(x, y, z) {
    si element(x + 1, y, z) == 0 || element(x - 1, y, z) == 0 || element(x, y + 1, z) == 0 {
        retour 1;
    }
    si element(x, y - 1, z) == 0 || element(x, y, z + 1) == 0 || element(x, y, z - 1) == 0 {
        retour 1;
    }
    retour 0;
}

// ranger les calques : pour chaque point de surface de chaque bloc porteur, sa clepsydre (et, avec_ciel == 1, son ciel) ;
// un octet par point (128 | la valeur : 128 dit « rangé »), huit points par mot, à la place du bloc dans la réserve ;
// chaque colonne de blocs écrit ses seules places (en bandes)
fonction ranger_lumiere(avec_ciel, jeu) {
    pour q dans 0..(TUILES * TUILES * 1024) en bandes {
        ranger_colonne(q, avec_ciel, jeu);
    }
}

// une colonne de blocs (q : la tuile et la place du bloc dans la tuile) : ses calques ; elle n'écrit que ses places
fonction ranger_colonne(q, avec_ciel, jeu) {
    soit t = q >> 10;
    soit bx = q & 31;
    soit bz = (q >> 5) & 31;
    soit x0 = (t % TUILES) * 256 + bx * 8;
    soit z0 = (t / TUILES) * 256 + bz * 8;
    soit base = (FELT + t) << 24;
    pour by dans 0..32 {
        soit e = @2[base + ((bx << 10) | (by << 5) | bz)];
        si e >= 16 && e < (1 << 62) {
            soit n = e - 16;
            pour w dans 0..64 {
                soit ms = 0;
                soit mc = 0;
                pour j dans 0..8 {
                    soit v = w * 8 + j;
                    soit x = x0 + (v >> 6);
                    soit y = by * 8 + ((v >> 3) & 7);
                    soit z = z0 + (v & 7);
                    soit el = @2[base + REP + n * 512 + v];
                    si el != 0 && ((el >> 2) & 63) != EAU {
                        si expose(x, y, z) == 1 {
                            soit nn = normale_de(el);
                            soit nx = (nn & 255) - 128;
                            soit ny = ((nn >> 16) & 255) - 128;
                            soit nz = ((nn >> 32) & 255) - 128;
                            ms = ms | ((128 | soleil_vu(x, y, z, nx, ny, nz, jeu)) << (j * 8));
                            si avec_ciel == 1 {
                                mc = mc | ((128 | ciel_ouvert(x, y, z, nx, ny, nz)) << (j * 8));
                            }
                        }
                    }
                }
                @2[((FSOL + 16 * jeu + t) << 24) + n * 64 + w] = ms;
                si avec_ciel == 1 {
                    @2[((FCIEL + t) << 24) + n * 64 + w] = mc;
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------------------- les étages d'un rayon
// 0.812 : la couleur vue par un rayon se fait en étages (ceux du tapis) : l'image (le point touché : tracer), l'ombre
// (ce que le point reçoit), la lumière (la couleur d'un point de terre), Divona (l'eau), la brume. regarder les enchaîne
// d'un coup ; le tapis les joue chacun à son tour, pour cinq images à la fois. Les mêmes calculs : la même image.

// l'étage de l'ombre : 0 pour le ciel ; sinon 1 | eau << 1 | état << 2 | vus << 4 | ouverts << 8 (vus : la clepsydre ;
// ouverts : le ciel vu ; l'état : 1 faux, 2 vrai, 3 variable)
fonction ombrer(ox, oy, oz, dx, dy, dz, t, jeu) {
    si t == MANQUE {
        retour 0;
    }
    soit px = ox + ((dx * t) .>> 16);
    soit py = oy + ((dy * t) .>> 16);
    soit pz = oz + ((dz * t) .>> 16);
    soit x = px >> 16;
    soit y = py >> 16;
    soit z = pz >> 16;
    soit e = element(x, y, z);
    si ((e >> 2) & 63) == EAU {
        retour 3;
    }
    soit nx = ((e >> 8) & 255) - 128;
    soit ny = ((e >> 16) & 255) - 128;
    soit nz = ((e >> 24) & 255) - 128;
    si nx == 0 - 128 {
        nx = 0;
        ny = 127;
        nz = 0;
    }
    soit so = SOLEILS + 16 * jeu;
    // la pente face au soleil
    soit nl = (nx * @2[so + 12] + ny * @2[so + 13] + nz * @2[so + 14]) ./ 127;
    // 0.810 : la clepsydre et le ciel du point se lisent dans ses calques (rangés) ; un point qui n'y est pas (un
    // point intérieur, touché par un rayon passé entre deux points par leur arête) se calcule sur place, depuis
    // l'endroit touché (comme en 0.809 : son centre est dans la matière)
    soit vus = 0;
    soit ouverts = 0;
    soit connu = 0;
    soit tt = (z >> 8) * TUILES + (x >> 8);
    soit e0 = @2[((FELT + tt) << 24) + (((x >> 3) & 31) << 10) + (((y >> 3) & 31) << 5) + ((z >> 3) & 31)];
    si e0 >= 16 && e0 < (1 << 62) {
        soit iv = ((x & 7) << 6) | ((y & 7) << 3) | (z & 7);
        soit dec = (iv & 7) * 8;
        soit sb = (@2[((FSOL + 16 * jeu + tt) << 24) + (e0 - 16) * 64 + (iv >> 3)] >> dec) & 255;
        si sb >= 128 {
            connu = 1;
            vus = sb & 15;
            ouverts = (@2[((FCIEL + tt) << 24) + (e0 - 16) * 64 + (iv >> 3)] >> dec) & 15;
        }
    }
    si connu == 0 {
        vus = soleil_depuis(px + nx * 600, py + ny * 600, pz + nz * 600, nx, ny, nz, jeu);
        ouverts = ciel_depuis(px + nx * 600, py + ny * 600, pz + nz * 600, nx, ny, nz);
    }
    soit etat = 1;
    si nl .> 0 {
        si vus == 4 {
            etat = 2;
        } sinon si vus > 0 {
            etat = 3;
        }
    }
    retour 1 | (etat << 2) | (vus << 4) | (ouverts << 8);
}

// l'étage de la lumière : la couleur d'un point de terre (om : ce que l'ombre a rendu), avant la brume ; ses trois voies
// sur 12 bits (r | g << 12 | b << 24 : elles peuvent dépasser 255 avant la brume)
fonction eclairer(ox, oy, oz, dx, dy, dz, t, om, jeu) {
    soit px = ox + ((dx * t) .>> 16);
    soit py = oy + ((dy * t) .>> 16);
    soit pz = oz + ((dz * t) .>> 16);
    soit x = px >> 16;
    soit y = py >> 16;
    soit z = pz >> 16;
    soit e = element(x, y, z);
    soit alb = couleur(x, y, z);
    soit nx = ((e >> 8) & 255) - 128;
    soit ny = ((e >> 16) & 255) - 128;
    soit nz = ((e >> 24) & 255) - 128;
    si nx == 0 - 128 {
        nx = 0;
        ny = 127;
        nz = 0;
    }
    soit so = SOLEILS + 16 * jeu;
    soit nl = (nx * @2[so + 12] + ny * @2[so + 13] + nz * @2[so + 14]) ./ 127;
    si nl .<= 0 {
        nl = 0;
    }
    soit vus = (om >> 4) & 15;
    soit ouverts = (om >> 8) & 15;
    // la lumière : le ciel (selon ce qu'on en voit), le soleil (selon la pente et la clepsydre), un renvoi du sol
    soit ciel_part = 40 + ouverts * 30;
    soit soleil = nl * vus / 4 * 256 / 65536;
    soit lr = 76 * ciel_part / 160 + soleil * 255 / 256 + 20;
    soit lg2 = 88 * ciel_part / 160 + soleil * 238 / 256 + 18;
    soit lb = 112 * ciel_part / 160 + soleil * 210 / 256 + 14;
    soit r = ((alb >> 16) & 255) * lr / 200;
    soit g = ((alb >> 8) & 255) * lg2 / 200;
    soit b = (alb & 255) * lb / 200;
    retour r | (g << 12) | (b << 24);
}

// Divona : la couleur d'un point d'eau, avant la brume (trois voies sur 12 bits) : le monde renvoyé (le rayon
// retourné, le monde en miroir sous la surface), ridé par le vent, plus fort en rasant
fonction divona(ox, oy, oz, dx, dy, dz, t, profondeur, temps, jeu) {
    soit px = ox + ((dx * t) .>> 16);
    soit py = oy + ((dy * t) .>> 16);
    soit pz = oz + ((dz * t) .>> 16);
    soit x = px >> 16;
    soit y = py >> 16;
    soit z = pz >> 16;
    soit alb = couleur(x, y, z);
    soit rx = dx + ((bruit_lisse((x + temps) & MASQ, z & MASQ, 16) - 32768) ./ 24);
    soit rz = dz + ((bruit_lisse(x & MASQ, (z + temps * 2) & MASQ, 16) - 32768) ./ 24);
    soit ry = 0 - dy;
    soit lg = racine_entiere(rx * rx + ry * ry + rz * rz);
    rx = (rx * 65536) ./ lg;
    ry = (ry * 65536) ./ lg;
    rz = (rz * 65536) ./ lg;
    soit renvoi = 0;
    si profondeur > 0 {
        renvoi = regarder(px, (MER << 16) + 32768, pz, rx, ry, rz, profondeur - 1, temps, jeu) & 16777215;
    } sinon {
        renvoi = ciel(rx, ry, rz, jeu);
    }
    // la part renvoyée : de 25 % (vu d'en haut) à 85 % (en rasant)
    soit rasant = 65536 - (0 - dy);
    si dy .> 0 {
        rasant = 65536;
    }
    soit part = 64 + rasant * rasant / 65536 * 154 / 65536;
    soit r = (((alb >> 16) & 255) * (256 - part) + ((renvoi >> 16) & 255) * part) / 256;
    soit g = (((alb >> 8) & 255) * (256 - part) + ((renvoi >> 8) & 255) * part) / 256;
    soit b = ((alb & 255) * (256 - part) + (renvoi & 255) * part) / 256;
    retour r | (g << 12) | (b << 24);
}

// la brume : la distance mêle au ciel de l'horizon (c : trois voies sur 12 bits) ; rend 0xRRGGBB
fonction brumer(c, t) {
    soit r = c & 4095;
    soit g = (c >> 12) & 4095;
    soit b = (c >> 24) & 4095;
    soit d = (t >> 16) * RD / RN;
    soit brume = d * d / 1600;
    si brume > 220 {
        brume = 220;
    }
    r = (r * (256 - brume) + 200 * brume) / 256;
    g = (g * (256 - brume) + 214 * brume) / 256;
    b = (b * (256 - brume) + 230 * brume) / 256;
    retour rgb24(r, g, b);
}

// la couleur vue par un rayon, tous les étages d'un coup ; l'eau renvoie le monde (profondeur : combien de renvois
// restent permis). Rend (l'état de la lumière << 24) | 0xRRGGBB ; l'état : 0 inconnu (le ciel), 1 faux (l'ombre), 2
// vrai (le soleil en plein), 3 variable (la pénombre)
fonction regarder(ox, oy, oz, dx, dy, dz, profondeur, temps, jeu) {
    soit t = tracer(ox, oy, oz, dx, dy, dz, 1100 * 65536 * RN / RD, 1);
    si t == MANQUE {
        retour ciel(dx, dy, dz, jeu);
    }
    soit om = ombrer(ox, oy, oz, dx, dy, dz, t, jeu);
    si (om & 2) != 0 {
        retour (2 << 24) | brumer(divona(ox, oy, oz, dx, dy, dz, t, profondeur, temps, jeu), t);
    }
    retour (((om >> 2) & 3) << 24) | brumer(eclairer(ox, oy, oz, dx, dy, dz, t, om, jeu), t);
}

// une image : l'œil en (cx, cy, cz) (en 1/65536 de point), tourné vers l'angle lacet (sur 1024), penché de tangage ;
// chaque rangée de l'écran va à un cœur
fonction rendre_cubes(cx, cy, cz, lacet, tangage, temps) {
    soit sl = sin1024(lacet);
    soit cl = cos1024(lacet);
    soit st = sin1024(tangage);
    soit ct = cos1024(tangage);
    // l'avant, la droite et le haut de l'œil
    soit fx = (sl * ct) ./ 65536;
    soit fy = st;
    soit fz = (cl * ct) ./ 65536;
    soit rx = cl;
    soit rz = 0 - sl;
    soit ux = (0 - sl * st) ./ 65536;
    soit uy = ct;
    soit uz = (0 - cl * st) ./ 65536;
    pour y dans 0..H en bandes {
        soit n0 = 0;
        soit n1 = 0;
        soit n2 = 0;
        soit n3 = 0;
        // tan(35°) · 65536 = 45889 : le champ de 70 degrés en largeur
        soit sy = ((H - 2 * y - 1) * 45889) ./ W;
        pour x dans 0..W {
            soit sx = ((2 * x + 1 - W) * 45889) ./ W;
            soit dx = fx + (rx * sx + ux * sy) ./ 65536;
            soit dy = fy + (uy * sy) ./ 65536;
            soit dz = fz + (rz * sx + uz * sy) ./ 65536;
            soit lg = racine_entiere(dx * dx + dy * dy + dz * dz);
            dx = (dx * 65536) ./ lg;
            dy = (dy * 65536) ./ lg;
            dz = (dz * 65536) ./ lg;
            soit v = regarder(cx, cy, cz, dx, dy, dz, 1, temps, 0);
            soit etat = v >> 24;
            si etat == 0 {
                n0 = n0 + 1;
            } sinon si etat == 1 {
                n1 = n1 + 1;
            } sinon si etat == 2 {
                n2 = n2 + 1;
            } sinon {
                n3 = n3 + 1;
            }
            @1[y * W + x] = rgb((v >> 16) & 255, (v >> 8) & 255, v & 255);
        }
        @2[COMPTE + 4 * y] = n0;
        @2[COMPTE + 4 * y + 1] = n1;
        @2[COMPTE + 4 * y + 2] = n2;
        @2[COMPTE + 4 * y + 3] = n3;
    }
}
