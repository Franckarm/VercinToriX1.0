// machine : lugus
// Belenos : l'épreuve de Gergovie sur la carte (les étages), les fils par blocs de 8 × 4 pixels (0.827) : une vague de la
// carte (32 fils) voit un petit carré de l'image. La même image, la même empreinte que gergovie.vtx.
//     python forge/forge128.py belenos/gergovie_etages_blocs.vtx -o gergovie_etages_blocs ; VTX_EPISSAGE=rapide VTX_CARTE=1 gergovie_etages_blocs
// 0.833 : le graphique compte en 64 bits (comme Taranis et le C++ de référence) : Dunon
dunon;
constante RN = 1;
constante RD = 1;
constante BLOCS = 1;
constante PROGRESSIF = 0;          // 0.828 : la clepsydre refaite en entier
importer "gergovie_scene.vtx";

fonction principal() {
    epreuve(240, 120, 2);
}
