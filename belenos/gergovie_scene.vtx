// Belenos : la scène de l'épreuve de Gergovie (0.822), la demande du créateur : la plaine auvergnate, la chaîne des puys
// au fond (un grand volcan et son cratère, deux petits), un lac où tout se reflète, un camp romain grossier (le castrum :
// ses murs crénelés, ses tours, sa porte, un temple à colonnes et des tentes), et deux armées de mannequins face à face
// dans la plaine, les Romains en rangs (tunique rouge, bouclier rectangulaire, casque) et les Gaulois moins alignés
// (tartan, bouclier rond, cheveux blonds), chacun sa lance. Un test plus chargé : plus d'ombres (des objets fins sous
// un soleil bas), des reflets plus techniques (le volcan, le camp dans le lac).
//
// Le moteur est celui du paysage dans le cube (0.808 à 0.818) : 2 × 2 tuiles, chacune un cube de texture et un cube
// d'élément à leurs fréquences, les seuls blocs de surface, les blocs vides qui savent leur distance, les blocs creusés,
// les calques de lumière (le ciel une fois, la clepsydre quand le soleil bouge), Divona pour l'eau.
// 0.822 : les rayons sont normés sans divisions répétées (un seul inverse par rayon, puis des multiplications) ; le
// regard est écrit une fois pour le processeur et pour la carte (regarder_1 appelle regarder_0 : la carte n'a pas de
// pile) ; le programme principal pose l'échelle (RN, RD) et importe ce fichier.

constante W = 1280;
constante H = 720;
constante TUILES = 2 * RN / RD;    // TUILES × TUILES tuiles
constante MONDE = 256 * TUILES;    // le côté du monde, en points
constante MASQ = MONDE - 1;
constante NB = MONDE / 8;          // le côté du monde, en blocs
constante FTEX = 1;                // le cube de texture de la tuile t : fréquence FTEX + t
constante FELT = 17;               // le cube d'élément de la tuile t : fréquence FELT + t
constante FCIEL = 33;              // le calque du ciel de la tuile t
constante FCREUX = 110;            // les blocs creusés de la tuile t
// 0.847 : la liaison : nommés, la forge lit ces cubes par leur fréquence et leur place, sans refaire l'adresse
cube elements[16] @2 frequence 17;   // FELT + t
cube creux[4] @2 frequence 110;      // FCREUX + t
constante FSOL = 49;               // le calque du soleil de la tuile t (FSOL + 16 · jeu + t)
constante FSOLC = 220;             // 0.850c : le même calque quand la carte le fait (FSOLC + t) : il reste sur la carte
constante CALQUE = 600072;         // 0.850c : la fréquence du calque du soleil (0 : FSOL)
constante REP = 32768;             // la réserve d'un cube : après son annuaire
constante MER = 44 * RN / RD;      // le niveau du lac
constante VIDE = 9223372036854775808;
constante LOIN = 8;
constante MANQUE = 4611686018427387904;
constante SINUS = 0;
constante HCOL = 4194304;
constante PENTE = 6291456;
constante GLOB = 600000;           // + 1… : les tailles des réserves ; + 20 : le plus haut point ; + 30 : le sol du camp ;
                                   // + 31 : le sol des armées
constante SOLEILS = 600100;
constante COMPTE = 600200;
constante DISTA = 1048576;
constante DISTB = 2097152;
constante FINV = 140;              // 0.823 : le bloc de chaque place de la réserve de la tuile t (FINV + t)
constante FIMAGE = 120;            // le cube de l'image (le point i : 0xRRGGBB), où la carte rend
// 0.823 : les étages de la carte, chacun son cube (le point i à sa place) ; les fréquences 200 et plus sont celles de la
// carte : elles restent sur la carte (le processeur ne les lit que par une boucle de la carte)
constante FDIR = 200;              // la direction du rayon de l'œil (trois nombres de 21 bits)
constante FMAT = 201;              // l'étage des matériaux : la distance du point touché (MANQUE : le ciel)
constante FOMB = 202;              // l'étage de l'ombre : l'état quaternaire, la clepsydre, le ciel vu (ombrer)
constante FLUM = 203;              // l'étage de la lumière : la couleur d'un point de terre avant la brume
constante FREF = 204;              // l'étage du reflet : la couleur d'un point d'eau (Divona) avant la brume
constante FECRAN = 206;            // 0.849 : l'image rendue sur la carte (une fréquence de la carte : elle ne redescend pas),
                                   // montrée par presenter_cube (le point i : 0xRRGGBB)
constante FPROJ = 205;             // 0.831 : la projection des points : pour chaque pixel, la profondeur et le point (le plus proche)
constante PIXEL_VIDE = 18446744073709551615;   // 0.831 : un pixel où rien n'est tombé

// les matières
constante ROCHE = 1;
constante HERBE = 2;
constante NEIGE = 3;
constante SABLE = 4;
constante EAU = 5;
constante TERRE = 6;
constante LANDE = 7;
constante PIERRE = 8;
constante TUILE = 9;
constante MARBRE = 10;
constante ROMAIN = 11;
constante GAULOIS = 12;
constante ECU_ROMAIN = 13;
constante ECU_GAULOIS = 14;
constante METAL = 15;
constante BOIS = 16;
constante PEAU = 17;
constante CHEVEUX = 18;
constante BRAIES = 19;
constante TOILE = 20;
constante SCORIE = 21;

// les lieux (à l'échelle)
constante PUY_X = 256 * RN / RD;   // le grand puy, au fond
constante PUY_Z = 70 * RN / RD;
constante PUY_R = 125 * RN / RD;
constante LAC_X = 300 * RN / RD;   // le lac
constante LAC_Z = 245 * RN / RD;
constante LAC_RX = 112 * RN / RD;
constante LAC_RZ = 70 * RN / RD;
constante CAMP_X0 = 140 * RN / RD; // le camp romain
constante CAMP_X1 = 200 * RN / RD;
constante CAMP_Z0 = 310 * RN / RD;
constante CAMP_Z1 = 350 * RN / RD;
constante ARM_X0 = 136 * RN / RD;  // la plaine des armées
constante ARM_X1 = 196 * RN / RD;
constante ARM_Z0 = 386 * RN / RD;
constante ARM_Z1 = 434 * RN / RD;
constante P3 = 16 * RN / RD;
constante UN = (RN + RD - 1) / RD;

fonction preparer_sinus() {
    pour a dans 0..1024 {
        soit u = a & 511;
        soit v = 4 * u * (512 - u) * 65536 / (327680 - u * (512 - u));
        si a >= 512 {
            @2[SINUS + a] = 0 - v;
        } sinon {
            @2[SINUS + a] = v;
        }
    }
}

fonction sin1024(a) {
    retour @2[SINUS + (a & 1023)];
}

fonction cos1024(a) {
    retour @2[SINUS + ((a + 256) & 1023)];
}

// 0.839 : ce que la scène veut sur 64 bits (les hachages tournent sur 64 bits, comme le C++ de référence), écrit :
// sur Lugus (128 bits) le masque garde les 64 bits du bas ; en Dunon il ne coûte rien (Ésus le voit)
constante MOT64 = 18446744073709551615;

// un mot de 64 bits lu avec son signe (le C++ affiche un int64 ; sur Lugus le signe s'étend aux 128 bits)
fonction signe64(x) {
    retour ((x & MOT64) ^ 9223372036854775808) - 9223372036854775808;
}

// -------------------------------------------------------------------------------------------------- les bruits
fonction hache(x, z) {
    soit h = (x & 4095) * 374761393 + (z & 4095) * 668265263 + 1013904223;
    h = ((h ^ (h >> 13)) * 1274126177) & MOT64;
    retour (h ^ (h >> 16)) & 65535;
}

fonction hache3(x, y, z) {
    soit h = (x & 1023) * 374761393 + (y & 1023) * 668265263 + (z & 1023) * 2246822519 + 1013904223;
    h = ((h ^ (h >> 13)) * 1274126177) & MOT64;
    retour (h ^ (h >> 16)) & 65535;
}

// le bruit lisse du plan, à la période p (une puissance de deux), sur le monde qui se répète
fonction bruit_lisse(x, z, p) {
    soit x0 = x / p;
    soit z0 = z / p;
    soit fx = (x % p) * 256 / p;
    soit fz = (z % p) * 256 / p;
    soit sx = fx * fx * (768 - 2 * fx) / 65536;
    soit sz = fz * fz * (768 - 2 * fz) / 65536;
    soit n = MONDE / p;
    soit a = hache(x0 % n, z0 % n);
    soit b = hache((x0 + 1) % n, z0 % n);
    soit c = hache(x0 % n, (z0 + 1) % n);
    soit d = hache((x0 + 1) % n, (z0 + 1) % n);
    soit h1 = (a * (256 - sx) + b * sx) / 256;
    soit h2 = (c * (256 - sx) + d * sx) / 256;
    retour (h1 * (256 - sz) + h2 * sz) / 256;
}

// le bruit lisse du volume, à la période P3 : les huit coins, mêlés en douceur (de 0 à 65535)
fonction bruit3(x, y, z) {
    soit x0 = x / P3;
    soit y0 = y / P3;
    soit z0 = z / P3;
    soit fx = (x % P3) * 256 / P3;
    soit fy = (y % P3) * 256 / P3;
    soit fz = (z % P3) * 256 / P3;
    soit sx = fx * fx * (768 - 2 * fx) / 65536;
    soit sy = fy * fy * (768 - 2 * fy) / 65536;
    soit sz = fz * fz * (768 - 2 * fz) / 65536;
    soit a0 = (hache3(x0, y0, z0) * (256 - sx) + hache3(x0 + 1, y0, z0) * sx) / 256;
    soit a1 = (hache3(x0, y0 + 1, z0) * (256 - sx) + hache3(x0 + 1, y0 + 1, z0) * sx) / 256;
    soit a2 = (hache3(x0, y0, z0 + 1) * (256 - sx) + hache3(x0 + 1, y0, z0 + 1) * sx) / 256;
    soit a3 = (hache3(x0, y0 + 1, z0 + 1) * (256 - sx) + hache3(x0 + 1, y0 + 1, z0 + 1) * sx) / 256;
    soit b0 = (a0 * (256 - sy) + a1 * sy) / 256;
    soit b1 = (a2 * (256 - sy) + a3 * sy) / 256;
    retour (b0 * (256 - sz) + b1 * sz) / 256;
}

// ------------------------------------------------------------------------------------------------------ le sol

// -------------------------------------------------------------------------------------------------------- le sol
// un puy (cône de centre cx, cz, de rayon r et de hauteur h, en points ; cratère de rayon rc) : sa hauteur en
// (x, z), en 1/256 de point
fonction puy(x, z, cx, cz, r, h, rc) {
    soit ax = x - cx;
    soit az = z - cz;
    soit d = racine_entiere((ax * ax + az * az) * 65536);
    si d >= r * 256 {
        retour 0;
    }
    // u : de 0 au pied à 65536 au sommet ; le flanc se creuse un peu (u · (u + 1/2) / (3/2))
    soit u = ((r * 256 - d) * 65536) / (r * 256);
    soit hp = ((h * 256 * u) >> 16) * (u + 32768) / 98304;
    si rc > 0 && d < rc * 256 {
        hp = hp - (rc * 256 - d) * 2;
    }
    retour hp;
}

// la hauteur de chaque colonne du monde (en 1/256 de point) : la plaine qui ondule, les puys, le lac creusé, le sol
// aplani du camp et de la plaine des armées
fonction creer_sol() {
    pour z dans 0..MONDE en bandes {
        pour x dans 0..MONDE {
            soit b1 = bruit_lisse(x, z, 128 * RN / RD);
            soit b2 = bruit_lisse(x, z, 32 * RN / RD);
            soit hs = 52 * 256 + ((b1 - 32768) * 3) ./ 64 + (b2 - 32768) ./ 128;
            // la chaîne des puys : le grand (et son cratère), deux petits sur les côtés ; leur pierre est ridée
            // (les hauteurs en points du monde à l'échelle 1 : tout le sol est mis à l'échelle à la fin)
            soit p = puy(x, z, PUY_X, PUY_Z, PUY_R, 138, 20 * RN / RD);
            p = p + puy(x, z, 70 * RN / RD, 120 * RN / RD, 70 * RN / RD, 62, 7 * RN / RD);
            p = p + puy(x, z, 445 * RN / RD, 105 * RN / RD, 58 * RN / RD, 50, 0);
            si p > 0 {
                p = p + ((bruit_lisse(x, z, 16 * RN / RD) - 32768) * (p >> 6)) ./ 32768;
                si p .< 0 {
                    p = 0;
                }
            }
            hs = hs + p;
            // le lac : une cuvette en ellipse (e : 0 au milieu, 65536 au bord de l'ellipse)
            soit ex = ((x - LAC_X) * 65536) ./ LAC_RX;
            soit ez = ((z - LAC_Z) * 65536) ./ LAC_RZ;
            soit e = racine_entiere(ex * ex + ez * ez);
            // le creux du lac : 22 points au milieu, rien au bord de l'ellipse (fondu : pas de falaise)
            si e < 65536 {
                soit f = 65536 - e;
                hs = hs - (22 * 256 * ((f * (131072 - f)) >> 16)) / 65536;
            }
            @2[HCOL + z * MONDE + x] = (hs * RN) / RD;
        }
    }
    // le sol du camp et celui des armées : la hauteur en leur milieu, puis aplanis (fondus sur 8 points autour)
    @2[GLOB + 30] = @2[HCOL + ((CAMP_Z0 + CAMP_Z1) / 2) * MONDE + (CAMP_X0 + CAMP_X1) / 2];
    @2[GLOB + 31] = @2[HCOL + ((ARM_Z0 + ARM_Z1) / 2) * MONDE + (ARM_X0 + ARM_X1) / 2];
    pour z2 dans 0..MONDE en bandes {
        pour x2 dans 0..MONDE {
            soit h2 = @2[HCOL + z2 * MONDE + x2];
            h2 = aplanir(h2, x2, z2, CAMP_X0, CAMP_X1, CAMP_Z0, CAMP_Z1, @2[GLOB + 30]);
            h2 = aplanir(h2, x2, z2, ARM_X0, ARM_X1, ARM_Z0, ARM_Z1, @2[GLOB + 31]);
            @2[HCOL + z2 * MONDE + x2] = h2;
        }
    }
    pour z dans 0..MONDE en bandes {
        pour x dans 0..MONDE {
            soit hx1 = @2[HCOL + z * MONDE + ((x + 1) & MASQ)];
            soit hx0 = @2[HCOL + z * MONDE + ((x + MASQ) & MASQ)];
            soit hz1 = @2[HCOL + ((z + 1) & MASQ) * MONDE + x];
            soit hz0 = @2[HCOL + ((z + MASQ) & MASQ) * MONDE + x];
            soit pe = 0;
            si hx1 > hx0 { pe = pe + hx1 - hx0; } sinon { pe = pe + hx0 - hx1; }
            si hz1 > hz0 { pe = pe + hz1 - hz0; } sinon { pe = pe + hz0 - hz1; }
            @2[PENTE + z * MONDE + x] = pe / 2;
        }
    }
    soit haut = 0;
    pour i dans 0..(MONDE * MONDE) {
        si @2[HCOL + i] > haut {
            haut = @2[HCOL + i];
        }
    }
    haut = haut / 256 + 12 * RN / RD;
    si @2[GLOB + 30] / 256 + 20 > haut {
        haut = @2[GLOB + 30] / 256 + 20;
    }
    @2[GLOB + 20] = haut;
}

// la hauteur h aplanie à hp dans le rectangle [x0, x1] × [z0, z1], fondue sur 8 points autour
fonction aplanir(h, x, z, x0, x1, z0, z1, hp) {
    soit dx = 0;
    si x < x0 {
        dx = x0 - x;
    } sinon si x > x1 {
        dx = x - x1;
    }
    soit dz = 0;
    si z < z0 {
        dz = z0 - z;
    } sinon si z > z1 {
        dz = z - z1;
    }
    soit k = dx;
    si dz > k {
        k = dz;
    }
    si k >= 8 {
        retour h;
    }
    retour (hp * (8 - k) + h * k) / 8;
}

// l'ampleur des surplombs à la hauteur y : faible dans la plaine, forte sur les puys (la pierre volcanique)
fonction ampleur(y) {
    soit amp = 256 * RN / RD;
    si y > 110 * RN / RD && y < 4000 {
        amp = (256 + (y * RD / RN - 110) * 10) * RN / RD;
        si amp > 900 * RN / RD {
            amp = 900 * RN / RD;
        }
    }
    retour amp;
}

// ------------------------------------------------------------------------------------------------- les objets
// la matière d'un objet au point (x, y, z), 0 s'il n'y en a pas : le camp romain, puis les deux armées
fonction objet(x, y, z) {
    si x >= CAMP_X0 && x <= CAMP_X1 && z >= CAMP_Z0 && z <= CAMP_Z1 {
        retour camp(x - CAMP_X0, y - (@2[GLOB + 30] - 129) / 256 - 1, z - CAMP_Z0);
    }
    si x >= ARM_X0 && x <= ARM_X1 && z >= ARM_Z0 && z <= ARM_Z1 {
        retour armees(x, y - (@2[GLOB + 31] - 129) / 256 - 1, z);
    }
    retour 0;
}

// le camp (lx, lz depuis son coin, ly depuis le sol : 0 est le premier point au-dessus) : murs, tours, porte, temple,
// tentes. Les dimensions sont en points, à toute échelle (un mannequin reste un mannequin)
fonction camp(lx, ly, lz) {
    si ly .< 0 || ly > 14 {
        retour 0;
    }
    soit lxm = CAMP_X1 - CAMP_X0;
    soit lzm = CAMP_Z1 - CAMP_Z0;
    // les tours, aux quatre coins (7 × 7, 12 de haut, crénelées)
    soit coinx = 0;
    si lx < 7 || lx > lxm - 7 {
        coinx = 1;
    }
    soit coinz = 0;
    si lz < 7 || lz > lzm - 7 {
        coinz = 1;
    }
    si coinx == 1 && coinz == 1 {
        si ly <= 11 {
            retour PIERRE;
        }
        si ly == 12 && ((lx + lz) & 2) == 0 {
            retour PIERRE;
        }
        retour 0;
    }
    // les murs (3 d'épaisseur, 8 de haut, des créneaux), la porte au milieu du mur de devant (vers +z)
    soit mur = 0;
    si lx < 3 || lx > lxm - 3 || lz < 3 || lz > lzm - 3 {
        mur = 1;
    }
    si mur == 1 {
        soit milieu = lxm / 2;
        si lz > lzm - 3 && lx + 4 > milieu && lx < milieu + 4 && ly <= 6 {
            retour 0;
        }
        si ly <= 8 {
            retour PIERRE;
        }
        si ly == 9 && ((lx + lz) & 2) == 0 {
            retour PIERRE;
        }
        retour 0;
    }
    // le temple : un socle, deux rangs de colonnes, le toit de tuiles en pente
    soit tx = lx - (lxm / 2 - 10);
    soit tz = lz - 10;
    si tx >= 0 && tx <= 20 && tz >= 0 && tz <= 12 {
        si ly <= 1 {
            retour PIERRE;
        }
        si ly <= 8 && (tz == 1 || tz == 11) && (tx % 3) == 1 {
            retour MARBRE;
        }
        si ly == 9 || ly == 10 {
            retour TUILE;
        }
        si ly == 11 && tz >= 3 && tz <= 9 {
            retour TUILE;
        }
        si ly == 12 && tz >= 5 && tz <= 7 {
            retour TUILE;
        }
        retour 0;
    }
    // les tentes : en rangs, sur les côtés (4 × 3, le faîte au milieu)
    soit cote = 0;
    si lx >= 4 && lx <= 18 {
        cote = 4;
    } sinon si lx + 18 >= lxm && lx + 4 <= lxm {
        cote = lxm - 18;
    }
    si cote > 0 && lz >= 4 && lz <= lzm - 5 {
        soit ux = (lx - cote) % 6;
        soit uz = (lz - 4) % 6;
        si ux <= 3 && uz <= 2 {
            soit pente = uz;
            si uz == 2 {
                pente = 0;
            }
            si ly <= 1 + pente {
                retour TOILE;
            }
        }
    }
    retour 0;
}

// les deux armées face à face : les Romains (vers +x) en rangs, les Gaulois (vers -x) moins alignés
fonction armees(x, ly, z) {
    si ly .< 0 || ly > 11 {
        retour 0;
    }
    soit pas_x = 5 * RN / RD;
    soit pas_z = 4 * RN / RD;
    si pas_x < 2 {
        pas_x = 2;
    }
    si pas_z < 2 {
        pas_z = 2;
    }
    // les Romains : trois rangs, dix files
    soit rx0 = ARM_X0 + 6 * RN / RD;
    soit milieu = (ARM_X0 + ARM_X1) / 2;
    si x < milieu {
        soit i = (x - rx0 + pas_x * 3 / 2) / pas_x;
        si i > 2 {
            i = 2;
        }
        soit j = (z - ARM_Z0 - 2 + pas_z / 2) / pas_z;
        si j > 9 {
            j = 9;
        }
        soit sx = rx0 + i * pas_x;
        soit sz = ARM_Z0 + 4 + j * pas_z;
        retour mannequin(x - sx, ly, z - sz, 0);
    }
    // les Gaulois : trois rangs, dix files, chacun un peu de travers (± 1 point)
    soit gx0 = ARM_X1 - 6 * RN / RD;
    soit i2 = (gx0 - x + pas_x * 3 / 2) / pas_x;
    si i2 > 2 {
        i2 = 2;
    }
    soit j2 = (z - ARM_Z0 - 2 + pas_z / 2) / pas_z;
    si j2 > 9 {
        j2 = 9;
    }
    soit dec = (hache(i2 + 17, j2 + 41) % 3) - 1;
    soit sx2 = gx0 - i2 * pas_x + dec;
    soit sz2 = ARM_Z0 + 4 + j2 * pas_z;
    retour mannequin(sx2 - x, ly, z - sz2, 1);
}

// un mannequin (fx : vers l'avant, depuis son milieu ; ly : depuis le sol ; fz : sur le côté) ; gaulois == 1 : un
// Gaulois. Les jambes, le torse, la tête (casque ou cheveux), le bouclier devant, la lance à droite
fonction mannequin(fx, ly, fz, gaulois) {
    // la lance : un fût de bois, la pointe de fer
    si fx == 0 && fz == 1 {
        si ly <= 9 {
            retour BOIS;
        }
        si ly <= 11 {
            retour METAL;
        }
        retour 0;
    }
    // le bouclier, devant
    si fx == 1 && ly >= 1 && ly <= 5 && fz .>= 0 - 2 && fz .<= 1 {
        si gaulois == 1 {
            // rond : sans ses coins
            si (ly == 1 || ly == 5) && (fz == 0 - 2 || fz == 1) {
                retour 0;
            }
            si ly == 3 && (fz == 0 - 1 || fz == 0) {
                retour METAL;
            }
            retour ECU_GAULOIS;
        }
        si ly == 3 && (fz == 0 - 1 || fz == 0) {
            retour METAL;
        }
        retour ECU_ROMAIN;
    }
    si fz .< 0 - 1 || fz .> 0 {
        retour 0;
    }
    // les jambes
    si ly <= 2 && fx == 0 {
        si gaulois == 1 {
            retour BRAIES;
        }
        retour PEAU;
    }
    // le torse
    si ly >= 3 && ly <= 5 && (fx == 0 || fx == 0 - 1) {
        si gaulois == 1 {
            retour GAULOIS;
        }
        retour ROMAIN;
    }
    // la tête : le visage, puis le casque ou les cheveux
    si ly >= 6 && ly <= 7 && (fx == 0 || fx == 0 - 1) {
        si ly == 7 {
            si gaulois == 1 {
                retour CHEVEUX;
            }
            retour METAL;
        }
        retour PEAU;
    }
    si ly == 8 && gaulois == 0 && fx == 0 - 1 && fz == 0 {
        // le cimier du casque romain
        retour ROMAIN;
    }
    retour 0;
}

// la densité d'un point : positive dans la matière (en 1/256 de point) ; le sol et ses surplombs ; un objet est plein
fonction densite(x, y, z) {
    si objet(x, y, z) != 0 {
        retour 256;
    }
    soit h = @2[HCOL + (z & MASQ) * MONDE + (x & MASQ)];
    soit d = h - y * 256 - 128;
    soit amp = ampleur(y);
    si d .< amp + 512 && d .> 0 - amp - 512 {
        d = d + ((bruit3(x, y, z) - 32768) * amp) ./ 32768;
    }
    retour d;
}

// ce qu'est un point du monde : (sa couleur << 32) | son mot d'élément ; 0 : vide (inconnu)
fonction composer_point(x, y, z) {
    soit ob = objet(x, y, z);
    si ob != 0 {
        retour composer_objet(x, y, z, ob);
    }
    soit d0 = densite(x, y, z);
    si d0 .<= 0 {
        si y < MER {
            // l'eau du lac : sa couleur, plus sombre au large
            soit fond = (MER * 256 - @2[HCOL + (z & MASQ) * MONDE + (x & MASQ)]) ./ (64 * RN / RD);
            si fond .< 0 {
                fond = 0;
            }
            si fond > 120 {
                fond = 120;
            }
            soit ce = rgb24(34 - fond / 6, 84 - fond / 3, 100 - fond / 5);
            retour (ce << 32) | (normale_mot(0, 127, 0) << 8) | (EAU << 2) | 2;
        }
        retour 0;
    }
    soit dxm = densite(x - 1, y, z);
    soit dxp = densite(x + 1, y, z);
    soit dym = densite(x, y - 1, z);
    soit dyp = densite(x, y + 1, z);
    soit dzm = densite(x, y, z - 1);
    soit dzp = densite(x, y, z + 1);
    soit surface = 0;
    si dxm .<= 0 || dxp .<= 0 || dym .<= 0 || dyp .<= 0 || dzm .<= 0 || dzp .<= 0 {
        surface = 1;
    }
    soit col = (z & MASQ) * MONDE + (x & MASQ);
    soit hs = @2[HCOL + col] / 256;
    soit pente = @2[PENTE + col];
    soit mat = HERBE;
    si y + 3 * RN / RD < hs {
        mat = TERRE;
    }
    si dyp .> 0 && surface == 1 {
        mat = ROCHE;
    } sinon si y <= MER + UN && y + UN >= MER {
        mat = SABLE;
    } sinon si y > 168 * RN / RD {
        mat = SCORIE;
    } sinon si pente > 420 || y > hs + UN {
        mat = ROCHE;
    } sinon si y > 72 * RN / RD {
        mat = LANDE;
    }
    // le sol battu du camp et de la plaine des armées
    si mat == HERBE && ((x + 6 >= CAMP_X0 && x <= CAMP_X1 + 6 && z + 6 >= CAMP_Z0 && z <= CAMP_Z1 + 6)
       || (x + 4 >= ARM_X0 && x <= ARM_X1 + 4 && z + 4 >= ARM_Z0 && z <= ARM_Z1 + 4)) {
        mat = TERRE;
    }
    soit r = 78;
    soit g = 120;
    soit b = 58;
    si mat == HERBE {
        // la plaine en champs : des verts, du blé, des labours
        soit champ = hache(x / (24 * RN / RD + 1), z / (20 * RN / RD + 1)) & 7;
        si champ == 1 {
            r = 98;
            g = 134;
            b = 62;
        } sinon si champ == 2 {
            r = 66;
            g = 108;
            b = 50;
        } sinon si champ == 3 {
            r = 176;
            g = 158;
            b = 86;
        } sinon si champ == 4 {
            r = 122;
            g = 98;
            b = 68;
        } sinon si champ == 5 {
            r = 112;
            g = 142;
            b = 72;
        }
    } sinon si mat == ROCHE {
        // la pierre volcanique, sombre
        r = 82;
        g = 76;
        b = 74;
    } sinon si mat == SCORIE {
        r = 116;
        g = 66;
        b = 50;
    } sinon si mat == SABLE {
        r = 186;
        g = 172;
        b = 134;
    } sinon si mat == TERRE {
        r = 112;
        g = 92;
        b = 68;
    } sinon si mat == LANDE {
        r = 110;
        g = 104;
        b = 70;
    }
    soit tache = (bruit_lisse(x & MASQ, z & MASQ, 32 * RN / RD) / 2048) + ((y * RD / RN) & 3);
    soit grain = hache3(x, y, z) & 15;
    r = r + tache + grain;
    g = g + tache + grain;
    b = b + tache / 2 + grain;
    soit c = rgb24(r, g, b);
    soit nm = 0;
    si surface == 1 {
        soit nx = dxm - dxp;
        soit ny = dym - dyp;
        soit nz = dzm - dzp;
        soit lg = racine_entiere(nx * nx + ny * ny + nz * nz);
        si lg == 0 {
            nm = normale_mot(0, 127, 0);
        } sinon {
            nm = normale_mot((nx * 127) ./ lg, (ny * 127) ./ lg, (nz * 127) ./ lg);
        }
    }
    retour (c << 32) | (nm << 8) | (mat << 2) | 2;
}

// un point d'objet : sa matière, sa couleur, sa normale (par ses voisins pleins : des faces franches)
fonction plein(x, y, z) {
    si densite(x, y, z) .> 0 {
        retour 1;
    }
    retour 0;
}

fonction composer_objet(x, y, z, ob) {
    soit nx = plein(x - 1, y, z) - plein(x + 1, y, z);
    soit ny = plein(x, y - 1, z) - plein(x, y + 1, z);
    soit nz = plein(x, y, z - 1) - plein(x, y, z + 1);
    soit surface = 1 - plein(x - 1, y, z) * plein(x + 1, y, z) * plein(x, y - 1, z) * plein(x, y + 1, z)
                   * plein(x, y, z - 1) * plein(x, y, z + 1);
    soit r = 150;
    soit g = 150;
    soit b = 156;
    si ob == PIERRE {
        // la pierre du camp, en assises (les joints plus sombres)
        r = 194;
        g = 178;
        b = 148;
        si (y % 3) == 0 || ((x + z + (y / 3) * 2) % 6) == 0 {
            r = 160;
            g = 146;
            b = 120;
        }
    } sinon si ob == TUILE {
        r = 168;
        g = 72;
        b = 50;
        si (x & 1) == 0 {
            r = 150;
            g = 62;
            b = 44;
        }
    } sinon si ob == MARBRE {
        r = 228;
        g = 224;
        b = 214;
    } sinon si ob == ROMAIN {
        r = 170;
        g = 30;
        b = 34;
    } sinon si ob == GAULOIS {
        // le tartan : deux couleurs en damier
        r = 40;
        g = 98;
        b = 70;
        si ((x + y + z) & 1) == 1 {
            r = 64;
            g = 72;
            b = 136;
        }
    } sinon si ob == ECU_ROMAIN {
        r = 152;
        g = 26;
        b = 28;
    } sinon si ob == ECU_GAULOIS {
        r = 50;
        g = 86;
        b = 150;
    } sinon si ob == BOIS {
        r = 108;
        g = 76;
        b = 46;
    } sinon si ob == PEAU {
        r = 204;
        g = 152;
        b = 118;
    } sinon si ob == CHEVEUX {
        r = 198;
        g = 162;
        b = 82;
    } sinon si ob == BRAIES {
        r = 124;
        g = 94;
        b = 62;
    } sinon si ob == TOILE {
        r = 216;
        g = 206;
        b = 182;
    }
    soit grain = hache3(x, y, z) & 7;
    soit c = rgb24(r + grain, g + grain, b + grain);
    soit nm = 0;
    si surface == 1 {
        si nx == 0 && ny == 0 && nz == 0 {
            nm = normale_mot(0, 127, 0);
        } sinon {
            soit lg = racine_entiere((nx * nx + ny * ny + nz * nz) * 16129);
            nm = normale_mot((nx * 16129) ./ lg, (ny * 16129) ./ lg, (nz * 16129) ./ lg);
        }
    }
    retour (c << 32) | (nm << 8) | (ob << 2) | 2;
}

fonction rgb24(r, g, b) {
    si r .< 0 {
        r = 0;
    }
    si g .< 0 {
        g = 0;
    }
    si b .< 0 {
        b = 0;
    }
    si r > 255 {
        r = 255;
    }
    si g > 255 {
        g = 255;
    }
    si b > 255 {
        b = 255;
    }
    retour (r << 16) | (g << 8) | b;
}

fonction normale_mot(nx, ny, nz) {
    retour ((nx + 128) & 255) | (((ny + 128) & 255) << 8) | (((nz + 128) & 255) << 16);
}

// ---------------------------------------------------------------------------------------- les cubes des tuiles
// premier passage : chaque bloc de chaque tuile est classé : vide (0), plein d'une même chose (1 << 62 | le mot), ou
// porteur d'une surface (1 : à remplir) ; le sol de ses colonnes et le bruit du volume suffisent à le dire

// ---------------------------------------------------------------------------------------- les cubes des tuiles
// premier passage : chaque bloc est classé : vide (0), plein d'une même chose (1 << 62 | le mot), ou porteur d'une
// surface (1 : à remplir) ; le sol de ses colonnes, le bruit du volume et les boîtes des objets suffisent à le dire
fonction classer_blocs() {
    pour q dans 0..(TUILES * TUILES * 1024) en bandes {
        soit t = q >> 10;
        soit bx = q & 31;
        soit bz = (q >> 5) & 31;
        soit x0 = (t % TUILES) * 256 + bx * 8;
        soit z0 = (t / TUILES) * 256 + bz * 8;
        soit hmin = 1000000;
        soit hmax = 0;
        pour dz dans 0..10 {
            pour dx dans 0..10 {
                soit h = @2[HCOL + ((z0 + dz + MASQ) & MASQ) * MONDE + ((x0 + dx + MASQ) & MASQ)];
                si h < hmin {
                    hmin = h;
                }
                si h > hmax {
                    hmax = h;
                }
            }
        }
        soit base = (FELT + t) << 24;
        soit tex = (FTEX + t) << 24;
        // les objets : les blocs de leurs boîtes (et un bloc autour) portent une surface, jusqu'à 16 points du sol
        soit dans_objet = 0;
        si x0 + 9 >= CAMP_X0 && x0 <= CAMP_X1 + 1 && z0 + 9 >= CAMP_Z0 && z0 <= CAMP_Z1 + 1 {
            dans_objet = 1;
        }
        si x0 + 9 >= ARM_X0 && x0 <= ARM_X1 + 1 && z0 + 9 >= ARM_Z0 && z0 <= ARM_Z1 + 1 {
            dans_objet = 1;
        }
        pour by dans 0..32 {
            soit y0 = by * 8;
            soit amp = ampleur(y0 + 9);
            soit b = (bx << 10) | (by << 5) | bz;
            soit e = 1;
            si dans_objet == 1 && y0 * 256 <= hmax + 16 * 256 && (y0 + 9) * 256 + 640 + amp >= hmin {
                e = 1;
            } sinon si y0 * 256 > hmax + amp + 640 {
                si y0 >= MER {
                    e = 0;
                } sinon si y0 + 8 <= MER {
                    e = 3;
                }
            } sinon si (y0 + 9) * 256 + 640 + amp < hmin {
                e = 2;
            }
            si e == 0 {
                @2[base + b] = VIDE;
            } sinon si e == 2 {
                @2[base + b] = (1 << 62) | (TERRE << 2) | 2;
                @2[tex + b] = rgb24(112, 92, 68);
            } sinon si e == 3 {
                soit c = composer_point(x0 + 4, y0 + 4, z0 + 4);
                @2[base + b] = (1 << 62) | (c & 4294967295);
                @2[tex + b] = c >> 32;
            } sinon {
                @2[base + b] = 1;
            }
        }
    }
}

// deuxième passage (un seul cœur) : chaque bloc porteur d'une surface reçoit sa place dans la réserve de son cube
fonction placer_blocs() {
    pour t dans 0..(TUILES * TUILES) {
        soit base = (FELT + t) << 24;
        soit n = 0;
        pour b dans 0..32768 {
            si @2[base + b] == 1 {
                @2[base + b] = 16 + n;
                // 0.823 : le chemin inverse (la place n dans la réserve → le bloc b), pour la clepsydre sur la carte
                @2[((FINV + t) << 24) + n] = b;
                n = n + 1;
            }
        }
        @2[GLOB + 1 + t] = n;
    }
}

// troisième passage : les 512 points de chaque bloc porteur, dans les deux cubes (chaque bloc écrit sa seule place)
fonction remplir_blocs() {
    pour q dans 0..(TUILES * TUILES * 1024) en bandes {
        soit t = q >> 10;
        soit bx = q & 31;
        soit bz = (q >> 5) & 31;
        soit x0 = (t % TUILES) * 256 + bx * 8;
        soit z0 = (t / TUILES) * 256 + bz * 8;
        soit base = (FELT + t) << 24;
        soit tex = (FTEX + t) << 24;
        pour by dans 0..32 {
            soit e = @2[base + ((bx << 10) | (by << 5) | bz)];
            si e >= 16 && e < (1 << 62) {
                soit place = REP + (e - 16) * 512;
                pour v dans 0..512 {
                    soit c = composer_point(x0 + (v >> 6), by * 8 + ((v >> 3) & 7), z0 + (v & 7));
                    @2[base + place + v] = c & 4294967295;
                    @2[tex + place + v] = c >> 32;
                }
            }
        }
    }
}

// 0.809 : les blocs vides savent à quelle distance est la matière : la distance (en blocs, au plus LOIN) au plus proche
// bloc qui n'est pas vide, dans les 26 directions (le cube de blocs autour) ; calculée sur tout le monde (les tuiles
// voisines comptent : un rayon passe d'un cube à l'autre) ; chaque tour l'étend d'un bloc (deux tableaux, l'un lu,
// l'autre écrit : les tours vont en bandes)
fonction case_bloc(gx, gy, gz) {
    retour (gy * NB + gz) * NB + gx;
}

fonction mot_bloc(gx, gy, gz) {
    soit t = (gz >> 5) * TUILES + (gx >> 5);
    retour @2[((FELT + t) << 24) + ((gx & 31) << 10) + (gy << 5) + (gz & 31)];
}

fonction distancer_blocs() {
    pour q dans 0..(NB * 32) en bandes {
        soit gy = q / NB;
        soit gz = q % NB;
        pour gx dans 0..NB {
            soit d = 0;
            si (mot_bloc(gx, gy, gz) >> 62) == 2 {
                d = LOIN;
            }
            @2[DISTA + case_bloc(gx, gy, gz)] = d;
        }
    }
    pour tour dans 0..(LOIN - 1) {
        soit de = DISTA;
        soit vers = DISTB;
        si (tour & 1) == 1 {
            de = DISTB;
            vers = DISTA;
        }
        pour q2 dans 0..(NB * 32) en bandes {
            soit gy2 = q2 / NB;
            soit gz2 = q2 % NB;
            pour gx2 dans 0..NB {
                soit d2 = @2[de + case_bloc(gx2, gy2, gz2)];
                si d2 > 1 {
                    pour k dans 0..27 {
                        soit nx = gx2 + (k % 3) - 1;
                        soit ny = gy2 + ((k / 3) % 3) - 1;
                        soit nz = gz2 + (k / 9) - 1;
                        si nx < NB && ny < 32 && nz < NB {
                            soit v = @2[de + case_bloc(nx, ny, nz)] + 1;
                            si v < d2 {
                                d2 = v;
                            }
                        }
                    }
                }
                @2[vers + case_bloc(gx2, gy2, gz2)] = d2;
            }
        }
    }
    // le dernier tableau écrit : DISTB si LOIN - 1 est impair
    soit fin = DISTA;
    si ((LOIN - 1) & 1) == 1 {
        fin = DISTB;
    }
    pour q3 dans 0..(NB * 32) en bandes {
        soit gy3 = q3 / NB;
        soit gz3 = q3 % NB;
        pour gx3 dans 0..NB {
            soit t3 = (gz3 >> 5) * TUILES + (gx3 >> 5);
            soit a3 = ((FELT + t3) << 24) + ((gx3 & 31) << 10) + (gy3 << 5) + (gz3 & 31);
            si (@2[a3] >> 62) == 2 {
                @2[a3] = VIDE | @2[fin + case_bloc(gx3, gy3, gz3)];
            }
        }
    }
}


fonction creer_monde() {
    preparer_sinus();
    creer_sol();
    classer_blocs();
    placer_blocs();
    remplir_blocs();
    distancer_blocs();
    creuser_blocs();
}


// 0.818 : les blocs creusés. Un rayon passait les trois quarts de ses pas point par point dans les blocs porteurs d'une
// surface (38 pas sur 49 en moyenne : un bloc qui porte un peu de terrain est surtout du vide au-dessus) ; chaque bloc
// porteur garde la carte de ses sous-blocs vides (de 4³ et de 2³), et le rayon les traverse d'un seul pas (38 → 11)
fonction creuser_blocs() {
    pour t dans 0..(TUILES * TUILES) {
        soit n = @2[GLOB + 1 + t];
        soit base = (FELT + t) << 24;
        pour b dans 0..n en bandes {
            soit m = 0;
            pour v dans 0..512 {
                si @2[base + REP + b * 512 + v] != 0 {
                    soit lx = v >> 6;
                    soit ly = (v >> 3) & 7;
                    soit lz = v & 7;
                    soit s4 = ((lx >> 2) << 2) | ((ly >> 2) << 1) | (lz >> 2);
                    soit s2 = (((lx >> 1) & 1) << 2) | (((ly >> 1) & 1) << 1) | ((lz >> 1) & 1);
                    m = m | (1 << (s4 * 8 + s2));
                }
            }
            @2[((FCREUX + t) << 24) + b] = m;
        }
    }
}

// ---------------------------------------------------------------------------------------- lire le monde
// le mot d'élément d'un point (x, y, z dans le monde) : 0 si vide ou hors du monde
fonction element(x, y, z) {
    si x >= MONDE || z >= MONDE || y >= 256 {
        retour 0;
    }
    soit tu = (z >> 8) * TUILES + (x >> 8);
    soit e = @elements(tu)[(((x >> 3) & 31) << 10) + (((y >> 3) & 31) << 5) + ((z >> 3) & 31)];
    si (e >> 62) == 2 {
        retour 0;
    }
    si (e >> 62) == 1 {
        retour e & 4294967295;
    }
    retour @elements(tu)[REP + (e - 16) * 512 + ((x & 7) << 6) + ((y & 7) << 3) + (z & 7)];
}

// la couleur d'un point (du cube de texture)
fonction couleur(x, y, z) {
    soit t = (z >> 8) * TUILES + (x >> 8);
    soit b = (((x >> 3) & 31) << 10) + (((y >> 3) & 31) << 5) + ((z >> 3) & 31);
    soit e = @2[((FELT + t) << 24) + b];
    si (e >> 62) == 1 {
        retour @2[((FTEX + t) << 24) + b];
    }
    retour @2[((FTEX + t) << 24) + REP + (e - 16) * 512 + ((x & 7) << 6) + ((y & 7) << 3) + (z & 7)];
}

// la marche d'un rayon : de (ox, oy, oz) dans la direction (dx, dy, dz) (en 1/65536, de longueur 65536), jusqu'à la
// distance tmax ; rend la distance du premier point touché (en 1/65536), ou MANQUE. Un bloc vide se saute d'un coup ;
// dans un bloc porteur, point par point. eau == 0 : l'eau ne compte pas (les rayons d'ombre et de ciel la traversent)
fonction tracer(ox, oy, oz, dx, dy, dz, tmax, eau) {
    soit t = 0;
    // 0.809 : au-dessus du plus haut point du monde, un rayon qui monte ne touchera plus rien
    soit plafond = @2[GLOB + 20] << 16;
    // 0.811 : le rayon apprend sa pente une fois : l'inverse de chaque direction (2^40 / |d|) ; chaque pas multiplie au
    // lieu de diviser (trois divisions de moins par pas : la division est l'opération la plus lente du processeur)
    soit ix = 0;
    soit iy = 0;
    soit iz = 0;
    si dx .> 0 {
        ix = 1099511627776 / dx;
    } sinon si dx .< 0 {
        ix = 1099511627776 / (0 - dx);
    }
    si dy .> 0 {
        iy = 1099511627776 / dy;
    } sinon si dy .< 0 {
        iy = 1099511627776 / (0 - dy);
    }
    si dz .> 0 {
        iz = 1099511627776 / dz;
    } sinon si dz .< 0 {
        iz = 1099511627776 / (0 - dz);
    }
    tantque t < tmax {
        soit px = ox + ((dx * t) .>> 16);
        soit py = oy + ((dy * t) .>> 16);
        soit pz = oz + ((dz * t) .>> 16);
        si py .>= plafond && dy .>= 0 {
            retour MANQUE;
        }
        si py .< 0 || px .< 0 || pz .< 0 || px .>= MONDE * 65536 || pz .>= MONDE * 65536 || py .>= 256 * 65536 {
            retour MANQUE;
        }
        soit x = px >> 16;
        soit y = py >> 16;
        soit z = pz >> 16;
        soit tu = (z >> 8) * TUILES + (x >> 8);
        soit e = @elements(tu)[(((x >> 3) & 31) << 10) + (((y >> 3) & 31) << 5) + ((z >> 3) & 31)];
        soit s = 8;
        // la boîte à quitter : le point (s = 1), son bloc, ou (un bloc vide qui sait sa distance d) les d - 1 blocs
        // autour, tous vides : de (bloc - (d - 1)) · 8 à (bloc + d) · 8 sur chaque axe
        soit av = 1;
        si (e >> 62) == 2 {
            av = e & 255;
        } sinon {
            si (e >> 62) == 1 {
                si eau == 1 || ((e >> 2) & 63) != EAU {
                    retour t;
                }
            } sinon {
                soit v = @elements(tu)[REP + (e - 16) * 512 + ((x & 7) << 6) + ((y & 7) << 3) + (z & 7)];
                si v != 0 && (eau == 1 || ((v >> 2) & 63) != EAU) {
                    retour t;
                }
                s = 1;
                // 0.818 : un point vide : son sous-bloc de 4³, ou de 2³, est-il tout vide ? (les blocs creusés)
                si v == 0 {
                    soit cm = @creux(tu)[e - 16];
                    soit cx4 = (((x >> 2) & 1) << 2) | (((y >> 2) & 1) << 1) | ((z >> 2) & 1);
                    si ((cm >> (cx4 * 8)) & 255) == 0 {
                        s = 4;
                    } sinon {
                        soit cx2 = (((x >> 1) & 1) << 2) | (((y >> 1) & 1) << 1) | ((z >> 1) & 1);
                        si ((cm >> (cx4 * 8 + cx2)) & 1) == 0 {
                            s = 2;
                        }
                    }
                }
            }
        }
        soit arr = 0;
        si s == 8 {
            arr = (av - 1) * 8;
        }
        // la sortie de la cellule (le bloc, ou le point) : la plus proche des trois faces vers où va le rayon
        soit pas = MANQUE;
        si dx .> 0 {
            soit ex1 = (((((x | (s - 1)) + 1 + arr) << 16) - px) * ix) >> 24;
            si ex1 < pas {
                pas = ex1;
            }
        } sinon si dx .< 0 {
            soit ex2 = (((px - (((x & (0 - s)) - arr) << 16)) + 1) * ix) >> 24;
            si ex2 < pas {
                pas = ex2;
            }
        }
        si dy .> 0 {
            soit ey1 = (((((y | (s - 1)) + 1 + arr) << 16) - py) * iy) >> 24;
            si ey1 < pas {
                pas = ey1;
            }
        } sinon si dy .< 0 {
            soit ey2 = (((py - (((y & (0 - s)) - arr) << 16)) + 1) * iy) >> 24;
            si ey2 < pas {
                pas = ey2;
            }
        }
        si dz .> 0 {
            soit ez1 = (((((z | (s - 1)) + 1 + arr) << 16) - pz) * iz) >> 24;
            si ez1 < pas {
                pas = ez1;
            }
        } sinon si dz .< 0 {
            soit ez2 = (((pz - (((z & (0 - s)) - arr) << 16)) + 1) * iz) >> 24;
            si ez2 < pas {
                pas = ez2;
            }
        }
        t = t + pas + 1;
    }
    retour MANQUE;
}

// ---------------------------------------------------------------------------------------------------- la lumière
// le soleil (az, el sur 1024) et les quatre directions de la clepsydre : vers les quatre bords du disque du soleil (un
// disque élargi, à 2 degrés : la pénombre se voit)
fonction preparer_soleil(az, el, jeu) {
    soit so = SOLEILS + 16 * jeu;
    soit lx = (cos1024(el) * sin1024(az)) ./ 65536;
    soit ly = sin1024(el);
    soit lz = (cos1024(el) * cos1024(az)) ./ 65536;
    poser_soleil(lx, ly, lz, jeu);
}

// 0.850b : un soleil plus fin (az, el en 1/65536 de tour, la table lue entre deux cases) : le soleil d'un jeu, qui
// bouge d'un centième de degré par image
fonction sin_fin(a) {
    soit i = (a >> 6) & 1023;
    soit s0 = @2[SINUS + i];
    soit s1 = @2[SINUS + ((i + 1) & 1023)];
    retour s0 + ((s1 - s0) * (a & 63)) ./ 64;
}

fonction preparer_soleil_fin(az, el, jeu) {
    soit ce = sin_fin(el + 16384);
    soit lx = (ce * sin_fin(az)) ./ 65536;
    soit ly = sin_fin(el);
    soit lz = (ce * sin_fin(az + 16384)) ./ 65536;
    poser_soleil(lx, ly, lz, jeu);
}

fonction poser_soleil(lx, ly, lz, jeu) {
    soit so = SOLEILS + 16 * jeu;
    @2[so + 12] = lx;
    @2[so + 13] = ly;
    @2[so + 14] = lz;
    // deux directions perpendiculaires : u (horizontale), v = u × l
    soit ul = racine_entiere(lx * lx + lz * lz);
    soit ux = (lz * 65536) ./ ul;
    soit uz = (0 - lx) * 65536 ./ ul;
    soit vx = (0 - uz * ly) ./ 65536;
    soit vy = (uz * lx - ux * lz) ./ 65536;
    soit vz = (ux * ly) ./ 65536;
    pour k dans 0..4 {
        soit ex = 0;
        soit ey = 0;
        soit ez = 0;
        si k == 0 {
            ex = ux;
            ez = uz;
        } sinon si k == 1 {
            ex = 0 - ux;
            ez = 0 - uz;
        } sinon si k == 2 {
            ex = vx;
            ey = vy;
            ez = vz;
        } sinon {
            ex = 0 - vx;
            ey = 0 - vy;
            ez = 0 - vz;
        }
        soit sx = lx + (ex * 2300) ./ 65536;
        soit sy = ly + (ey * 2300) ./ 65536;
        soit sz = lz + (ez * 2300) ./ 65536;
        soit lg = racine_entiere(sx * sx + sy * sy + sz * sz);
        @2[so + 3 * k] = (sx * 65536) ./ lg;
        @2[so + 3 * k + 1] = (sy * 65536) ./ lg;
        @2[so + 3 * k + 2] = (sz * 65536) ./ lg;
    }
}

// le ciel dans la direction d : du bleu en haut au clair de l'horizon, le disque du soleil et sa lueur
fonction ciel(dx, dy, dz, jeu) {
    soit hy = dy;
    si hy .< 0 {
        hy = 0;
    }
    soit t = hy * 256 / 65536;
    soit r = (200 * (256 - t) + 92 * t) / 256;
    soit g = (214 * (256 - t) + 128 * t) / 256;
    soit b = (230 * (256 - t) + 184 * t) / 256;
    soit so = SOLEILS + 16 * jeu;
    soit cs = (dx * @2[so + 12] + dy * @2[so + 13] + dz * @2[so + 14]) ./ 65536;
    si cs .> 65500 {
        retour rgb24(255, 248, 228);
    }
    si cs .> 60000 {
        soit lueur = (cs - 60000) * 90 / 5500;
        r = r + lueur;
        g = g + lueur * 3 / 4;
        b = b + lueur / 3;
    }
    retour rgb24(r, g, b);
}

// ---------------------------------------------------------------------------------------- les calques de lumière
// 0.810 : la lumière d'un point de surface se calcule depuis son centre (pas depuis l'endroit où le rayon de l'œil l'a
// touché) : elle ne dépend plus de l'œil, elle se range dans le cube. Le ciel ne dépend ni de l'œil ni du soleil : il se
// range une fois ; la clepsydre dépend du soleil : elle se refait quand il bouge, et l'œil qui vole n'en paie rien.

// le départ des rayons d'un point de surface : son centre, poussé le long de la normale (d'une demi-maille et 1,16 :
// comme depuis sa face, en 0.809) ; si ce départ tombe dans la matière (une arête, une marche : la normale penche vers
// un voisin plein), le centre du voisin vide le mieux tourné vers la normale. Rend 6 (le départ le long de la normale)
// ou le voisin choisi : 0 +x, 1 -x, 2 +y, 3 -y, 4 +z, 5 -z
fonction depart(x, y, z, nx, ny, nz) {
    soit sx = (x << 16) + 32768 + nx * 858;
    soit sy = (y << 16) + 32768 + ny * 858;
    soit sz = (z << 16) + 32768 + nz * 858;
    si element(sx >> 16, sy >> 16, sz >> 16) != 0 {
        soit meilleur = 6;
        soit note = 0 - 1000;
        pour k dans 0..6 {
            soit vx = x;
            soit vy = y;
            soit vz = z;
            soit nk = nx;
            si k == 0 {
                vx = x + 1;
            } sinon si k == 1 {
                vx = x - 1;
                nk = 0 - nx;
            } sinon si k == 2 {
                vy = y + 1;
                nk = ny;
            } sinon si k == 3 {
                vy = y - 1;
                nk = 0 - ny;
            } sinon si k == 4 {
                vz = z + 1;
                nk = nz;
            } sinon {
                vz = z - 1;
                nk = 0 - nz;
            }
            si nk .> note {
                si element(vx, vy, vz) == 0 {
                    note = nk;
                    meilleur = k;
                }
            }
        }
        retour meilleur;
    }
    retour 6;
}

// la clepsydre d'un point : combien des quatre rayons vers les bords du soleil passent (0 si la pente lui tourne le dos)
fonction soleil_depuis(sx, sy, sz, nx, ny, nz, jeu) {
    soit so = SOLEILS + 16 * jeu;
    soit nl = (nx * @2[so + 12] + ny * @2[so + 13] + nz * @2[so + 14]) ./ 127;
    si nl .<= 0 {
        retour 0;
    }
    soit vus = 0;
    pour k dans 0..4 {
        si tracer(sx, sy, sz, @2[so + 3 * k], @2[so + 3 * k + 1], @2[so + 3 * k + 2], 700 * 65536 * RN / RD, 0)
           == MANQUE {
            vus = vus + 1;
        }
    }
    retour vus;
}

// le ciel vu d'un point : quatre rayons courts autour de la normale (la normale penchée vers deux directions
// perpendiculaires, dans les deux sens) ; combien passent
fonction ciel_depuis(sx, sy, sz, nx, ny, nz) {
    soit n16x = nx * 516;
    soit n16y = ny * 516;
    soit n16z = nz * 516;
    // t1 : perpendiculaire à la normale (sa composante la plus faible mise à part)
    soit t1x = 0;
    soit t1y = 0;
    soit t1z = 0;
    soit ay_ = ny;
    si ay_ .< 0 {
        ay_ = 0 - ay_;
    }
    si ay_ .< 90 {
        // une paroi : t1 = n × (0, 1, 0)
        t1x = 0 - n16z;
        t1z = n16x;
    } sinon {
        // un replat : t1 = n × (1, 0, 0)
        t1y = n16z;
        t1z = 0 - n16y;
    }
    soit l1 = racine_entiere(t1x * t1x + t1y * t1y + t1z * t1z);
    si l1 == 0 {
        l1 = 1;
    }
    t1x = (t1x * 65536) ./ l1;
    t1y = (t1y * 65536) ./ l1;
    t1z = (t1z * 65536) ./ l1;
    soit t2x = (n16y * t1z - n16z * t1y) ./ 65536;
    soit t2y = (n16z * t1x - n16x * t1z) ./ 65536;
    soit t2z = (n16x * t1y - n16y * t1x) ./ 65536;
    soit ouverts = 0;
    pour k dans 0..4 {
        soit ex = t1x;
        soit ey = t1y;
        soit ez = t1z;
        si k == 1 {
            ex = 0 - t1x;
            ey = 0 - t1y;
            ez = 0 - t1z;
        } sinon si k == 2 {
            ex = t2x;
            ey = t2y;
            ez = t2z;
        } sinon si k == 3 {
            ex = 0 - t2x;
            ey = 0 - t2y;
            ez = 0 - t2z;
        }
        soit cx = (n16x * 3 + ex * 4) ./ 5;
        soit cy = (n16y * 3 + ey * 4) ./ 5;
        soit cz = (n16z * 3 + ez * 4) ./ 5;
        si tracer(sx, sy, sz, cx, cy, cz, 14 * 65536 * RN / RD, 0) == MANQUE {
            ouverts = ouverts + 1;
        }
    }
    retour ouverts;
}

// la clepsydre et le ciel d'un point de surface, depuis son centre (ou son voisin vide) : ce qui se range
fonction soleil_vu(x, y, z, nx, ny, nz, jeu) {
    soit sx = (x << 16) + 32768 + nx * 858;
    soit sy = (y << 16) + 32768 + ny * 858;
    soit sz = (z << 16) + 32768 + nz * 858;
    soit dp = depart(x, y, z, nx, ny, nz);
    si dp < 6 {
        sx = (x << 16) + 32768;
        sy = (y << 16) + 32768;
        sz = (z << 16) + 32768;
        si dp == 0 {
            sx = sx + 65536;
        } sinon si dp == 1 {
            sx = sx - 65536;
        } sinon si dp == 2 {
            sy = sy + 65536;
        } sinon si dp == 3 {
            sy = sy - 65536;
        } sinon si dp == 4 {
            sz = sz + 65536;
        } sinon {
            sz = sz - 65536;
        }
    }
    retour soleil_depuis(sx, sy, sz, nx, ny, nz, jeu);
}

fonction ciel_ouvert(x, y, z, nx, ny, nz) {
    soit sx = (x << 16) + 32768 + nx * 858;
    soit sy = (y << 16) + 32768 + ny * 858;
    soit sz = (z << 16) + 32768 + nz * 858;
    soit dp = depart(x, y, z, nx, ny, nz);
    si dp < 6 {
        sx = (x << 16) + 32768;
        sy = (y << 16) + 32768;
        sz = (z << 16) + 32768;
        si dp == 0 {
            sx = sx + 65536;
        } sinon si dp == 1 {
            sx = sx - 65536;
        } sinon si dp == 2 {
            sy = sy + 65536;
        } sinon si dp == 3 {
            sy = sy - 65536;
        } sinon si dp == 4 {
            sz = sz + 65536;
        } sinon {
            sz = sz - 65536;
        }
    }
    retour ciel_depuis(sx, sy, sz, nx, ny, nz);
}

// la normale d'un mot d'élément, en trois nombres signés (rangés en un : x | y << 16 | z << 32, chacun + 128)
fonction normale_de(e) {
    soit nx = ((e >> 8) & 255);
    si nx == 0 {
        retour 128 | (255 << 16) | (128 << 32);
    }
    retour nx | (((e >> 16) & 255) << 16) | (((e >> 24) & 255) << 32);
}

// un point de surface : de la matière (pas de l'eau) avec, à côté, un point vide (par où un rayon peut l'atteindre)
fonction expose(x, y, z) {
    // 0.823 : sans court-circuit autour des appels (la carte le refuse) : un appel par test, le même sens
    si element(x + 1, y, z) == 0 {
        retour 1;
    }
    si element(x - 1, y, z) == 0 {
        retour 1;
    }
    si element(x, y + 1, z) == 0 {
        retour 1;
    }
    si element(x, y - 1, z) == 0 {
        retour 1;
    }
    si element(x, y, z + 1) == 0 {
        retour 1;
    }
    si element(x, y, z - 1) == 0 {
        retour 1;
    }
    retour 0;
}

// ranger les calques : pour chaque point de surface de chaque bloc porteur, sa clepsydre (et, avec_ciel == 1, son ciel) ;
// un octet par point (128 | la valeur : 128 dit « rangé »), huit points par mot, à la place du bloc dans la réserve ;
// chaque colonne de blocs écrit ses seules places (en bandes)
fonction ranger_lumiere(avec_ciel, jeu) {
    pour q dans 0..(TUILES * TUILES * 1024) en bandes {
        ranger_colonne(q, avec_ciel, jeu);
    }
}

// une colonne de blocs (q : la tuile et la place du bloc dans la tuile) : ses calques ; elle n'écrit que ses places
fonction ranger_colonne(q, avec_ciel, jeu) {
    soit t = q >> 10;
    soit bx = q & 31;
    soit bz = (q >> 5) & 31;
    soit x0 = (t % TUILES) * 256 + bx * 8;
    soit z0 = (t / TUILES) * 256 + bz * 8;
    soit base = (FELT + t) << 24;
    pour by dans 0..32 {
        soit e = @2[base + ((bx << 10) | (by << 5) | bz)];
        si e >= 16 && e < (1 << 62) {
            soit n = e - 16;
            pour w dans 0..64 {
                soit ms = 0;
                soit mc = 0;
                pour j dans 0..8 {
                    soit v = w * 8 + j;
                    soit x = x0 + (v >> 6);
                    soit y = by * 8 + ((v >> 3) & 7);
                    soit z = z0 + (v & 7);
                    soit el = @2[base + REP + n * 512 + v];
                    si el != 0 && ((el >> 2) & 63) != EAU {
                        si expose(x, y, z) == 1 {
                            soit nn = normale_de(el);
                            soit nx = (nn & 255) - 128;
                            soit ny = ((nn >> 16) & 255) - 128;
                            soit nz = ((nn >> 32) & 255) - 128;
                            ms = ms | ((128 | soleil_vu(x, y, z, nx, ny, nz, jeu)) << (j * 8));
                            si avec_ciel == 1 {
                                mc = mc | ((128 | ciel_ouvert(x, y, z, nx, ny, nz)) << (j * 8));
                            }
                        }
                    }
                }
                @2[((fsol() + 16 * jeu + t) << 24) + n * 64 + w] = ms;
                si avec_ciel == 1 {
                    @2[((FCIEL + t) << 24) + n * 64 + w] = mc;
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------------------- les étages d'un rayon
// 0.812 : la couleur vue par un rayon se fait en étages (ceux du tapis) : l'image (le point touché : tracer), l'ombre
// (ce que le point reçoit), la lumière (la couleur d'un point de terre), Divona (l'eau), la brume. regarder les enchaîne
// d'un coup ; le tapis les joue chacun à son tour, pour cinq images à la fois. Les mêmes calculs : la même image.

// l'étage de l'ombre : 0 pour le ciel ; sinon 1 | eau << 1 | état << 2 | vus << 4 | ouverts << 8 (vus : la clepsydre ;
// ouverts : le ciel vu ; l'état : 1 faux, 2 vrai, 3 variable)
fonction ombrer(ox, oy, oz, dx, dy, dz, t, jeu) {
    si t == MANQUE {
        retour 0;
    }
    soit px = ox + ((dx * t) .>> 16);
    soit py = oy + ((dy * t) .>> 16);
    soit pz = oz + ((dz * t) .>> 16);
    soit x = px >> 16;
    soit y = py >> 16;
    soit z = pz >> 16;
    soit e = element(x, y, z);
    si ((e >> 2) & 63) == EAU {
        retour 3;
    }
    soit nx = ((e >> 8) & 255) - 128;
    soit ny = ((e >> 16) & 255) - 128;
    soit nz = ((e >> 24) & 255) - 128;
    si nx == 0 - 128 {
        nx = 0;
        ny = 127;
        nz = 0;
    }
    soit so = SOLEILS + 16 * jeu;
    // la pente face au soleil
    soit nl = (nx * @2[so + 12] + ny * @2[so + 13] + nz * @2[so + 14]) ./ 127;
    // 0.810 : la clepsydre et le ciel du point se lisent dans ses calques (rangés) ; un point qui n'y est pas (un
    // point intérieur, touché par un rayon passé entre deux points par leur arête) se calcule sur place, depuis
    // l'endroit touché (comme en 0.809 : son centre est dans la matière)
    soit vus = 0;
    soit ouverts = 0;
    soit connu = 0;
    soit tt = (z >> 8) * TUILES + (x >> 8);
    soit e0 = @2[((FELT + tt) << 24) + (((x >> 3) & 31) << 10) + (((y >> 3) & 31) << 5) + ((z >> 3) & 31)];
    si e0 >= 16 && e0 < (1 << 62) {
        soit iv = ((x & 7) << 6) | ((y & 7) << 3) | (z & 7);
        soit dec = (iv & 7) * 8;
        soit sb = (@2[((fsol() + 16 * jeu + tt) << 24) + (e0 - 16) * 64 + (iv >> 3)] >> dec) & 255;
        si sb >= 128 {
            connu = 1;
            vus = sb & 15;
            ouverts = (@2[((FCIEL + tt) << 24) + (e0 - 16) * 64 + (iv >> 3)] >> dec) & 15;
        }
    }
    si connu == 0 {
        vus = soleil_depuis(px + nx * 600, py + ny * 600, pz + nz * 600, nx, ny, nz, jeu);
        ouverts = ciel_depuis(px + nx * 600, py + ny * 600, pz + nz * 600, nx, ny, nz);
    }
    soit etat = 1;
    si nl .> 0 {
        si vus == 4 {
            etat = 2;
        } sinon si vus > 0 {
            etat = 3;
        }
    }
    // 0.850b : le feu (0 s'il est éteint, ou pour un point hors des calques)
    soit fe = 0;
    si connu == 1 {
        fe = feu_point(tt, e0, x, y, z);
    }
    retour 1 | (etat << 2) | (vus << 4) | (ouverts << 8) | (fe << 12);
}

// l'étage de la lumière : la couleur d'un point de terre (om : ce que l'ombre a rendu), avant la brume ; ses trois voies
// sur 12 bits (r | g << 12 | b << 24 : elles peuvent dépasser 255 avant la brume)
fonction eclairer(ox, oy, oz, dx, dy, dz, t, om, jeu) {
    soit px = ox + ((dx * t) .>> 16);
    soit py = oy + ((dy * t) .>> 16);
    soit pz = oz + ((dz * t) .>> 16);
    soit x = px >> 16;
    soit y = py >> 16;
    soit z = pz >> 16;
    soit e = element(x, y, z);
    soit alb = couleur(x, y, z);
    soit nx = ((e >> 8) & 255) - 128;
    soit ny = ((e >> 16) & 255) - 128;
    soit nz = ((e >> 24) & 255) - 128;
    si nx == 0 - 128 {
        nx = 0;
        ny = 127;
        nz = 0;
    }
    soit so = SOLEILS + 16 * jeu;
    soit nl = (nx * @2[so + 12] + ny * @2[so + 13] + nz * @2[so + 14]) ./ 127;
    si nl .<= 0 {
        nl = 0;
    }
    soit vus = (om >> 4) & 15;
    soit ouverts = (om >> 8) & 15;
    soit fe = (om >> 12) & 15;
    // la lumière : le ciel (selon ce qu'on en voit), le soleil (selon la pente et la clepsydre), un renvoi du sol ; le
    // feu (0.850b), orangé
    soit ciel_part = 40 + ouverts * 30;
    soit soleil = nl * vus / 4 * 256 / 65536;
    soit lr = 76 * ciel_part / 160 + soleil * 255 / 256 + 20 + fe * 16;
    soit lg2 = 88 * ciel_part / 160 + soleil * 238 / 256 + 18 + fe * 9;
    soit lb = 112 * ciel_part / 160 + soleil * 210 / 256 + 14 + fe * 3;
    soit r = ((alb >> 16) & 255) * lr / 200;
    soit g = ((alb >> 8) & 255) * lg2 / 200;
    soit b = (alb & 255) * lb / 200;
    retour r | (g << 12) | (b << 24);
}

// 0.813 : l'ombre et la lumière d'un même étage (l'idée du créateur) : le point, son élément, sa normale et sa pente
// face au soleil calculés une seule fois. Rend comme ombrer, et pour un point de terre sa couleur avant la brume au-dessus
// (om | couleur << 16) : le même résultat que ombrer puis eclairer
fonction clarte(ox, oy, oz, dx, dy, dz, t, jeu) {
    si t == MANQUE {
        retour 0;
    }
    soit px = ox + ((dx * t) .>> 16);
    soit py = oy + ((dy * t) .>> 16);
    soit pz = oz + ((dz * t) .>> 16);
    soit x = px >> 16;
    soit y = py >> 16;
    soit z = pz >> 16;
    soit e = element(x, y, z);
    si ((e >> 2) & 63) == EAU {
        retour 3;
    }
    soit nx = ((e >> 8) & 255) - 128;
    soit ny = ((e >> 16) & 255) - 128;
    soit nz = ((e >> 24) & 255) - 128;
    si nx == 0 - 128 {
        nx = 0;
        ny = 127;
        nz = 0;
    }
    soit so = SOLEILS + 16 * jeu;
    soit nl = (nx * @2[so + 12] + ny * @2[so + 13] + nz * @2[so + 14]) ./ 127;
    // l'ombre : la clepsydre et le ciel, lus dans les calques (ou calculés sur place pour un point intérieur)
    soit vus = 0;
    soit ouverts = 0;
    soit connu = 0;
    soit tt = (z >> 8) * TUILES + (x >> 8);
    soit e0 = @2[((FELT + tt) << 24) + (((x >> 3) & 31) << 10) + (((y >> 3) & 31) << 5) + ((z >> 3) & 31)];
    si e0 >= 16 && e0 < (1 << 62) {
        soit iv = ((x & 7) << 6) | ((y & 7) << 3) | (z & 7);
        soit dec = (iv & 7) * 8;
        soit sb = (@2[((fsol() + 16 * jeu + tt) << 24) + (e0 - 16) * 64 + (iv >> 3)] >> dec) & 255;
        si sb >= 128 {
            connu = 1;
            vus = sb & 15;
            ouverts = (@2[((FCIEL + tt) << 24) + (e0 - 16) * 64 + (iv >> 3)] >> dec) & 15;
        }
    }
    si connu == 0 {
        vus = soleil_depuis(px + nx * 600, py + ny * 600, pz + nz * 600, nx, ny, nz, jeu);
        ouverts = ciel_depuis(px + nx * 600, py + ny * 600, pz + nz * 600, nx, ny, nz);
    }
    soit etat = 1;
    si nl .> 0 {
        si vus == 4 {
            etat = 2;
        } sinon si vus > 0 {
            etat = 3;
        }
    } sinon {
        nl = 0;
    }
    // 0.850b : le feu (0 s'il est éteint, ou pour un point hors des calques)
    soit fe = 0;
    si connu == 1 {
        fe = feu_point(tt, e0, x, y, z);
    }
    // la lumière : le ciel (selon ce qu'on en voit), le soleil (selon la pente et la clepsydre), un renvoi du sol ; le
    // feu, orangé
    soit alb = couleur(x, y, z);
    soit ciel_part = 40 + ouverts * 30;
    soit soleil = nl * vus / 4 * 256 / 65536;
    soit lr = 76 * ciel_part / 160 + soleil * 255 / 256 + 20 + fe * 16;
    soit lg2 = 88 * ciel_part / 160 + soleil * 238 / 256 + 18 + fe * 9;
    soit lb = 112 * ciel_part / 160 + soleil * 210 / 256 + 14 + fe * 3;
    soit r = ((alb >> 16) & 255) * lr / 200;
    soit g = ((alb >> 8) & 255) * lg2 / 200;
    soit b = (alb & 255) * lb / 200;
    retour 1 | (etat << 2) | (vus << 4) | (ouverts << 8) | (fe << 12) | ((r | (g << 12) | (b << 24)) << 16);
}


// la brume : la distance mêle au ciel de l'horizon (c : trois voies sur 12 bits) ; rend 0xRRGGBB
fonction brumer(c, t) {
    soit r = c & 4095;
    soit g = (c >> 12) & 4095;
    soit b = (c >> 24) & 4095;
    soit d = (t >> 16) * RD / RN;
    soit brume = d * d / 1600;
    si brume > 220 {
        brume = 220;
    }
    r = (r * (256 - brume) + 200 * brume) / 256;
    g = (g * (256 - brume) + 214 * brume) / 256;
    b = (b * (256 - brume) + 230 * brume) / 256;
    retour rgb24(r, g, b);
}

// la couleur vue par un rayon, tous les étages d'un coup ; l'eau renvoie le monde (profondeur : combien de renvois
// restent permis). Rend (l'état de la lumière << 24) | 0xRRGGBB ; l'état : 0 inconnu (le ciel), 1 faux (l'ombre), 2
// vrai (le soleil en plein), 3 variable (la pénombre)

// ---------------------------------------------------------------------------------------------------- le regard
// 0.822 : le regard sans appel de soi-même (la carte n'a pas de pile) et sans divisions répétées : l'œil (regarder_1),
// puis le renvoi du lac (regarder_0, qui ne renvoie que le ciel). Une direction se norme par un seul inverse :
// inv = 2^48 / longueur, puis chaque composante × inv >> 32 (une division au lieu de trois). Le processeur et la carte
// jouent ces mêmes fonctions : la même image.
fonction inverse_longueur(x, y, z) {
    retour 281474976710656 / racine_entiere(x * x + y * y + z * z);
}

fonction divona_0(ox, oy, oz, dx, dy, dz, t, temps) {
    soit px = ox + ((dx * t) .>> 16);
    soit py = oy + ((dy * t) .>> 16);
    soit pz = oz + ((dz * t) .>> 16);
    soit x = px >> 16;
    soit y = py >> 16;
    soit z = pz >> 16;
    soit alb = couleur(x, y, z);
    soit rx = dx + ((bruit_lisse((x + temps) & MASQ, z & MASQ, 16) - 32768) ./ 24);
    soit rz = dz + ((bruit_lisse(x & MASQ, (z + temps * 2) & MASQ, 16) - 32768) ./ 24);
    soit ry = 0 - dy;
    soit inv = inverse_longueur(rx, ry, rz);
    rx = (rx * inv) .>> 32;
    ry = (ry * inv) .>> 32;
    rz = (rz * inv) .>> 32;
    soit renvoi = ciel(rx, ry, rz, 0);
    soit rasant = 65536 - (0 - dy);
    si dy .> 0 {
        rasant = 65536;
    }
    soit part = 64 + rasant * rasant / 65536 * 154 / 65536;
    soit r = (((alb >> 16) & 255) * (256 - part) + ((renvoi >> 16) & 255) * part) / 256;
    soit g = (((alb >> 8) & 255) * (256 - part) + ((renvoi >> 8) & 255) * part) / 256;
    soit b = ((alb & 255) * (256 - part) + (renvoi & 255) * part) / 256;
    retour r | (g << 12) | (b << 24);
}

fonction regarder_0(ox, oy, oz, dx, dy, dz, temps) {
    soit t = tracer(ox, oy, oz, dx, dy, dz, 1100 * 65536 * RN / RD, 1);
    si t == MANQUE {
        retour ciel(dx, dy, dz, 0);
    }
    soit om = clarte(ox, oy, oz, dx, dy, dz, t, 0);
    si (om & 2) != 0 {
        retour (2 << 24) | brumer(divona_0(ox, oy, oz, dx, dy, dz, t, temps), t);
    }
    retour (((om >> 2) & 3) << 24) | brumer(om >> 16, t);
}

fonction divona_1(ox, oy, oz, dx, dy, dz, t, temps) {
    soit px = ox + ((dx * t) .>> 16);
    soit py = oy + ((dy * t) .>> 16);
    soit pz = oz + ((dz * t) .>> 16);
    soit x = px >> 16;
    soit y = py >> 16;
    soit z = pz >> 16;
    soit alb = couleur(x, y, z);
    soit rx = dx + ((bruit_lisse((x + temps) & MASQ, z & MASQ, 16) - 32768) ./ 24);
    soit rz = dz + ((bruit_lisse(x & MASQ, (z + temps * 2) & MASQ, 16) - 32768) ./ 24);
    soit ry = 0 - dy;
    soit inv = inverse_longueur(rx, ry, rz);
    rx = (rx * inv) .>> 32;
    ry = (ry * inv) .>> 32;
    rz = (rz * inv) .>> 32;
    soit renvoi = regarder_0(px, (MER << 16) + 32768, pz, rx, ry, rz, temps) & 16777215;
    soit rasant = 65536 - (0 - dy);
    si dy .> 0 {
        rasant = 65536;
    }
    soit part = 64 + rasant * rasant / 65536 * 154 / 65536;
    soit r = (((alb >> 16) & 255) * (256 - part) + ((renvoi >> 16) & 255) * part) / 256;
    soit g = (((alb >> 8) & 255) * (256 - part) + ((renvoi >> 8) & 255) * part) / 256;
    soit b = ((alb & 255) * (256 - part) + (renvoi & 255) * part) / 256;
    retour r | (g << 12) | (b << 24);
}

fonction regarder_1(ox, oy, oz, dx, dy, dz, temps) {
    soit t = tracer(ox, oy, oz, dx, dy, dz, 1100 * 65536 * RN / RD, 1);
    si t == MANQUE {
        retour ciel(dx, dy, dz, 0);
    }
    soit om = clarte(ox, oy, oz, dx, dy, dz, t, 0);
    si (om & 2) != 0 {
        retour (2 << 24) | brumer(divona_1(ox, oy, oz, dx, dy, dz, t, temps), t);
    }
    retour (((om >> 2) & 3) << 24) | brumer(om >> 16, t);
}

// le regard du point i de l'écran (i = y · W + x), l'œil en (cx, cy, cz), tourné (lacet) et penché (tangage) : rend
// 0xRRGGBB
fonction point_vu(i, cx, cy, cz, lacet, tangage, temps) {
    soit sl = sin1024(lacet);
    soit cl = cos1024(lacet);
    soit st = sin1024(tangage);
    soit ct = cos1024(tangage);
    soit iy = i / W;
    soit ix = i - iy * W;
    // tan(35°) · 65536 = 45889 : le champ de 70 degrés en largeur
    soit sy = ((H - 2 * iy - 1) * 45889) ./ W;
    soit sx = ((2 * ix + 1 - W) * 45889) ./ W;
    soit dx = (sl * ct) ./ 65536 + (cl * sx + ((0 - sl * st) ./ 65536) * sy) ./ 65536;
    soit dy = st + (ct * sy) ./ 65536;
    soit dz = (cl * ct) ./ 65536 + ((0 - sl) * sx + ((0 - cl * st) ./ 65536) * sy) ./ 65536;
    soit inv = inverse_longueur(dx, dy, dz);
    dx = (dx * inv) .>> 32;
    dy = (dy * inv) .>> 32;
    dz = (dz * inv) .>> 32;
    retour regarder_1(cx, cy, cz, dx, dy, dz, temps) & 16777215;
}

// ---------------------------------------------------------------------------------------- les étages (0.823)
// La même image que point_vu, faite en cinq passes sur la carte, chacune son noyau (l'idée du créateur, le rendu
// différé des moteurs) : les matériaux (le rayon de l'œil : la distance du point touché), l'ombre (l'état quaternaire du
// point : inconnu le ciel, faux l'ombre, vrai le soleil en plein, variable la pénombre), la lumière (la couleur d'un
// point de terre), le reflet (Divona, pour les seuls points d'eau), le cache (la composition, la brume : l'image).

// 0.827 : l'ordre des fils sur la carte (BLOCS, dans le programme principal) : 0, ligne par ligne (le point i est le
// pixel i) ; 1, par blocs de 8 × 4 pixels (32 fils : une vague de la carte), les blocs ligne par ligne. Une vague voit
// alors un petit carré de l'image, et non une ligne de 32 pixels : ses rayons sont voisins, ils lisent les mêmes cases
// du cube (le cache de la carte sert mieux) et prennent les mêmes chemins (le ciel, l'eau, la terre : moins de
// divergence). L'image est la même, point pour point : seul l'ordre change.
fonction pixel_de(q) {
    si BLOCS == 0 {
        retour q;
    }
    soit b = q >> 5;
    soit r = q & 31;
    soit by = b / (W / 8);
    soit bx = b - by * (W / 8);
    retour (by * 4 + (r >> 3)) * W + bx * 8 + (r & 7);
}

// le rang du fil qui fait le pixel (x, y)
fonction rang_de(x, y) {
    si BLOCS == 0 {
        retour y * W + x;
    }
    retour (((y >> 2) * (W / 8) + (x >> 3)) << 5) + ((y & 3) << 3) + (x & 7);
}

// la direction du rayon de l'œil du point i, normée, rangée en un mot (trois nombres signés de 21 bits)
fonction direction_vue(i, cx, cy, cz, lacet, tangage) {
    soit sl = sin1024(lacet);
    soit cl = cos1024(lacet);
    soit st = sin1024(tangage);
    soit ct = cos1024(tangage);
    soit pv = pixel_de(i);
    soit iy = pv / W;
    soit ix = pv - iy * W;
    soit sy = ((H - 2 * iy - 1) * 45889) ./ W;
    soit sx = ((2 * ix + 1 - W) * 45889) ./ W;
    soit dx = (sl * ct) ./ 65536 + (cl * sx + ((0 - sl * st) ./ 65536) * sy) ./ 65536;
    soit dy = st + (ct * sy) ./ 65536;
    soit dz = (cl * ct) ./ 65536 + ((0 - sl) * sx + ((0 - cl * st) ./ 65536) * sy) ./ 65536;
    soit inv = inverse_longueur(dx, dy, dz);
    dx = (dx * inv) .>> 32;
    dy = (dy * inv) .>> 32;
    dz = (dz * inv) .>> 32;
    retour (dx & 2097151) | ((dy & 2097151) << 21) | ((dz & 2097151) << 42);
}

fonction dir_x(w) {
    retour (w << 43) .>> 43;
}

fonction dir_y(w) {
    retour (w << 22) .>> 43;
}

fonction dir_z(w) {
    retour (w << 1) .>> 43;
}

// l'étage des matériaux : le rayon de l'œil jusqu'au point touché
fonction etage_materiaux(i, cx, cy, cz, lacet, tangage) {
    soit w = direction_vue(i, cx, cy, cz, lacet, tangage);
    @2[(FDIR << 24) + i] = w;
    @2[(FMAT << 24) + i] = tracer(cx, cy, cz, dir_x(w), dir_y(w), dir_z(w), 1100 * 65536 * RN / RD, 1);
}

// l'étage de l'ombre : ce que le point reçoit (ombrer : 1 | eau << 1 | état << 2 | vus << 4 | ouverts << 8 ; 0 le ciel)
fonction etage_ombre(i, cx, cy, cz) {
    soit w = @2[(FDIR << 24) + i];
    @2[(FOMB << 24) + i] = ombrer(cx, cy, cz, dir_x(w), dir_y(w), dir_z(w), @2[(FMAT << 24) + i], 0);
}

// l'étage de la lumière : la couleur d'un point de terre (rien pour le ciel et l'eau)
fonction etage_lumiere(i, cx, cy, cz) {
    soit om = @2[(FOMB << 24) + i];
    si (om & 1) == 1 && (om & 2) == 0 {
        soit w = @2[(FDIR << 24) + i];
        @2[(FLUM << 24) + i] = eclairer(cx, cy, cz, dir_x(w), dir_y(w), dir_z(w), @2[(FMAT << 24) + i], om, 0);
    }
}

// l'étage du reflet : Divona, pour les seuls points d'eau
fonction etage_reflet(i, cx, cy, cz, temps) {
    si (@2[(FOMB << 24) + i] & 2) != 0 {
        soit w = @2[(FDIR << 24) + i];
        @2[(FREF << 24) + i] = divona_1(cx, cy, cz, dir_x(w), dir_y(w), dir_z(w), @2[(FMAT << 24) + i], temps);
    }
}

// le cache : la composition (le ciel, la brume) : le point de l'image
fonction etage_cache(i, fi) {
    // 0.849 : fi, la fréquence de l'image : FECRAN (elle reste sur la carte), ou FIMAGE (l'ordre par blocs)
    soit t = @2[(FMAT << 24) + i];
    soit w = @2[(FDIR << 24) + i];
    si t == MANQUE {
        @2[(fi << 24) + i] = ciel(dir_x(w), dir_y(w), dir_z(w), 0) & 16777215;
    } sinon si (@2[(FOMB << 24) + i] & 2) != 0 {
        @2[(fi << 24) + i] = brumer(@2[(FREF << 24) + i], t);
    } sinon {
        @2[(fi << 24) + i] = brumer(@2[(FLUM << 24) + i], t);
    }
}

// une image par les étages, sur la carte (chaque étage une boucle en segments : un noyau de Taranis)
// 0.849 : l'œil des étages (GLOB + 50 à 54) et s'il est encore celui des étages des matériaux (GLOB + 55) : l'œil
// immobile, les directions et les points touchés (FDIR, FMAT, sur la carte) restent ; seuls l'ombre, la lumière, le
// reflet et le cache sont refaits (le soleil bouge). Le noyau unique ne peut pas : il refait tout, à chaque image
constante OEIL = 600050;

fonction oeil_garde(cx, cy, cz, lacet, tangage) {
    si @2[OEIL + 5] == 1 && @2[OEIL] == cx && @2[OEIL + 1] == cy && @2[OEIL + 2] == cz && @2[OEIL + 3] == lacet
            && @2[OEIL + 4] == tangage {
        retour 1;
    }
    @2[OEIL] = cx;
    @2[OEIL + 1] = cy;
    @2[OEIL + 2] = cz;
    @2[OEIL + 3] = lacet;
    @2[OEIL + 4] = tangage;
    @2[OEIL + 5] = 1;
    retour 0;
}

fonction image_etages(cx, cy, cz, lacet, tangage, temps) {
    si oeil_garde(cx, cy, cz, lacet, tangage) == 0 {
        pour i dans 0..(W * H) en segments {
            etage_materiaux(i, cx, cy, cz, lacet, tangage);
        }
    }
    pour i2 dans 0..(W * H) en segments {
        etage_ombre(i2, cx, cy, cz);
    }
    pour i3 dans 0..(W * H) en segments {
        etage_lumiere(i3, cx, cy, cz);
    }
    pour i4 dans 0..(W * H) en segments {
        etage_reflet(i4, cx, cy, cz, temps);
    }
    si BLOCS == 0 {
        // 0.849 : l'image reste sur la carte : presenter_cube la montre
        pour i6 dans 0..(W * H) en segments {
            etage_cache(i6, FECRAN);
        }
        retour;
    }
    pour i5 dans 0..(W * H) en segments {
        etage_cache(i5, FIMAGE);
    }
    pour y dans 0..H en bandes {
        pour x dans 0..W {
            soit v = @2[(FIMAGE << 24) + rang_de(x, y)];
            @1[y * W + x] = rgb((v >> 16) & 255, (v >> 8) & 255, v & 255);
        }
    }
}

// la clepsydre sur la carte (le jour) : un fil par mot du calque (huit points de surface), sur toutes les tuiles : des
// centaines de milliers de fils (une colonne de blocs par fil n'en faisait que 1024, chacun trop chargé)
fonction ranger_lumiere_carte(avec_ciel, jeu) {
    soit total = 0;
    pour t dans 0..(TUILES * TUILES) {
        total = total + @2[GLOB + 1 + t] * 64;
    }
    pour q dans 0..total en segments {
        ranger_mot(q, avec_ciel, jeu);
    }
}

// le mot q du calque (toutes les tuiles à la suite) : sa tuile, sa place dans la réserve, son mot (huit points)
fonction ranger_mot(q, avec_ciel, jeu) {
    soit t = 0;
    soit r = q;
    soit cherche = 1;
    pour k dans 0..(TUILES * TUILES) {
        si cherche == 1 {
            soit nk = @2[GLOB + 1 + k] * 64;
            si r < nk {
                t = k;
                cherche = 0;
            } sinon {
                r = r - nk;
            }
        }
    }
    ranger_mot_tnw(t, r >> 6, r & 63, avec_ciel, jeu);
}

// le mot w du bloc n de la tuile t : huit points en ligne droite (le long de z) : la clepsydre (et le ciel) de chacun
fonction ranger_mot_tnw(t, n, w, avec_ciel, jeu) {
    soit b = @2[((FINV + t) << 24) + n];
    soit bx = b >> 10;
    soit by = (b >> 5) & 31;
    soit bz = b & 31;
    soit x0 = (t % TUILES) * 256 + bx * 8;
    soit z0 = (t / TUILES) * 256 + bz * 8;
    soit base = (FELT + t) << 24;
    soit ms = 0;
    soit mc = 0;
    pour j dans 0..8 {
        soit v = w * 8 + j;
        soit x = x0 + (v >> 6);
        soit y = by * 8 + ((v >> 3) & 7);
        soit z = z0 + (v & 7);
        soit el = @2[base + REP + n * 512 + v];
        si el != 0 && ((el >> 2) & 63) != EAU {
            si expose(x, y, z) == 1 {
                soit nn = normale_de(el);
                soit nx = (nn & 255) - 128;
                soit ny = ((nn >> 16) & 255) - 128;
                soit nz = ((nn >> 32) & 255) - 128;
                ms = ms | ((128 | soleil_vu(x, y, z, nx, ny, nz, jeu)) << (j * 8));
                si avec_ciel == 1 {
                    mc = mc | ((128 | ciel_ouvert(x, y, z, nx, ny, nz)) << (j * 8));
                }
            }
        }
    }
    @2[((fsol() + 16 * jeu + t) << 24) + n * 64 + w] = ms;
    si avec_ciel == 1 {
        @2[((FCIEL + t) << 24) + n * 64 + w] = mc;
    }
}

// une image au processeur : chaque rangée à un cœur
fonction image_processeur(cx, cy, cz, lacet, tangage, temps) {
    pour y dans 0..H en bandes {
        pour x dans 0..W {
            soit v = point_vu(y * W + x, cx, cy, cz, lacet, tangage, temps);
            @1[y * W + x] = rgb((v >> 16) & 255, (v >> 8) & 255, v & 255);
        }
    }
}

// une image sur la carte : un fil par point (Taranis), le point rendu dans FIMAGE, puis posé à l'écran
fonction image_carte(cx, cy, cz, lacet, tangage, temps) {
    // 0.849 : sans l'ordre par blocs, l'image reste sur la carte (FECRAN) : presenter_cube la montre depuis la carte
    si BLOCS == 0 {
        pour i dans 0..(W * H) en segments {
            @2[(FECRAN << 24) + i] = point_vu(i, cx, cy, cz, lacet, tangage, temps);
        }
        retour;
    }
    pour i dans 0..(W * H) en segments {
        @2[(FIMAGE << 24) + i] = point_vu(pixel_de(i), cx, cy, cz, lacet, tangage, temps);
    }
    pour y dans 0..H en bandes {
        pour x dans 0..W {
            soit v = @2[(FIMAGE << 24) + rang_de(x, y)];
            @1[y * W + x] = rgb((v >> 16) & 255, (v >> 8) & 255, v & 255);
        }
    }
}

// ---------------------------------------------------------------------------------------------- l'épreuve
fonction empreinte_image() {
    soit h = 14695981039346656037;
    pour i dans 0..(W * H) {
        soit c = @1[i];
        soit rgb3 = ((c >> 56) & 255) * 65536 + ((c >> 40) & 255) * 256 + ((c >> 24) & 255);
        h = ((h ^ rgb3) * 1099511628211) & MOT64;
    }
    retour h;
}

// le survol, image i sur n : au-dessus des armées, puis du camp, jusqu'à la rive du lac, face au grand puy (son
// reflet dans le lac) ; l'œil descend un peu et se redresse ; sur_carte : 0 le processeur, 1 la carte d'un seul
// noyau, 2 la carte par les étages
// ---------------------------------------------------------------------- 0.831 : la projection des points hex
// L'inverse du rayon (l'idée du créateur : « une fréquence, une couleur, une intensité » ; la technique de Schütz,
// Kerbl et Wimmer, TU Wien) : chaque point de surface du cube, connu par son adresse (son hex), se projette sur l'écran,
// et dans chaque pixel le plus proche gagne (« garder le minimum » : la profondeur et le point dans un mot de 64 bits).
// Puis chaque pixel s'éclaire depuis le point qui l'a gagné (la même lumière que le rayon : celle du point). Un pixel où
// rien n'est tombé reste inconnu : lui seul lance un rayon (le ciel, ou un trou de près) ; l'eau aussi (Divona).
fonction image_projection(cx, cy, cz, lacet, tangage, temps) {
    soit total = 0;
    pour t dans 0..(TUILES * TUILES) {
        total = total + @2[GLOB + 1 + t] * 64;
    }
    pour i dans 0..(W * H) en segments {
        @2[(FPROJ << 24) + i] = PIXEL_VIDE;
    }
    pour q dans 0..total en segments {
        projeter_mot(q, cx, cy, cz, lacet, tangage);
    }
    pour i2 dans 0..(W * H) en segments {
        @2[(FIMAGE << 24) + i2] = resoudre(i2, cx, cy, cz, lacet, tangage, temps);
    }
    pour y dans 0..H en bandes {
        pour x dans 0..W {
            soit v = @2[(FIMAGE << 24) + y * W + x];
            @1[y * W + x] = rgb((v >> 16) & 255, (v >> 8) & 255, v & 255);
        }
    }
}

// les huit points du mot q du calque (une ligne le long de z) : chacun qui est une surface (la terre exposée au
// calque du soleil, ou le dessus de l'eau) se projette
fonction projeter_mot(q, cx, cy, cz, lacet, tangage) {
    soit t = 0;
    soit r = q;
    soit cherche = 1;
    pour k dans 0..(TUILES * TUILES) {
        si cherche == 1 {
            soit nk = @2[GLOB + 1 + k] * 64;
            si r < nk {
                t = k;
                cherche = 0;
            } sinon {
                r = r - nk;
            }
        }
    }
    soit n = r >> 6;
    soit w = r & 63;
    soit b = @2[((FINV + t) << 24) + n];
    soit x0 = (t % TUILES) * 256 + (b >> 10) * 8;
    soit y0 = ((b >> 5) & 31) * 8;
    soit z0 = (t / TUILES) * 256 + (b & 31) * 8;
    soit ms = @2[((fsol() + t) << 24) + n * 64 + w];
    soit base = (FELT + t) << 24;
    // la caméra : devant, à droite, en haut (16.16), comme direction_vue
    soit sl = sin1024(lacet);
    soit cl = cos1024(lacet);
    soit st = sin1024(tangage);
    soit ct = cos1024(tangage);
    soit fx = (sl * ct) ./ 65536;
    soit fz = (cl * ct) ./ 65536;
    soit ux = (0 - sl * st) ./ 65536;
    soit uz = (0 - cl * st) ./ 65536;
    pour j dans 0..8 {
        soit v = w * 8 + j;
        soit x = x0 + (v >> 6);
        soit y = y0 + ((v >> 3) & 7);
        soit z = z0 + (v & 7);
        soit terre = 0;
        si ((ms >> (j * 8)) & 255) >= 128 {
            terre = 1;
        }
        soit eau = 0;
        soit el = @2[base + REP + n * 512 + v];
        si el != 0 && ((el >> 2) & 63) == EAU {
            si element(x, y + 1, z) == 0 {
                eau = 1;
            }
        }
        si terre == 1 || eau == 1 {
            // le point visé : le centre du point, poussé d'un demi-point le long de sa normale (sa face vue, là où le
            // rayon le touche) ; l'eau : le dessus
            soit nx = ((el >> 8) & 255) - 128;
            soit ny = ((el >> 16) & 255) - 128;
            soit nz = ((el >> 24) & 255) - 128;
            si nx == 0 - 128 || eau == 1 {
                nx = 0;
                ny = 127;
                nz = 0;
            }
            projeter_point(x, y, z, eau, nx * 258, ny * 258, nz * 258, cx, cy, cz, fx, st, fz, cl, sl, ux, ct, uz);
        }
    }
}

fonction projeter_point(x, y, z, eau, ex, ey, ez, cx, cy, cz, fx, fy, fz, rx, sl, ux, uy, uz) {
    soit vx = x * 65536 + 32768 + ex - cx;
    soit vy = y * 65536 + 32768 + ey - cy;
    soit vz = z * 65536 + 32768 + ez - cz;
    soit zc = (vx * fx + vy * fy + vz * fz) .>> 16;
    si zc .> 65536 {
        soit xc = (vx * rx - vz * sl) .>> 16;
        soit yc = (vx * ux + vy * uy + vz * uz) .>> 16;
        soit inv = 4294967296 ./ zc;
        soit sx = (xc * inv) .>> 16;
        soit sy = (yc * inv) .>> 16;
        soit px = ((sx * W) ./ 45889 + W) .>> 1;
        soit py = (H - (sy * W) ./ 45889) .>> 1;
        // la taille du point à l'écran (en pixels) : W · 0,714 / sa profondeur (en points)
        soit taille = (W * 46797) ./ zc;
        soit rr = (taille + 1) >> 1;
        // la face vue de biais (un sol au loin) est plus basse que large : la hauteur du carré suit le cosinus entre
        // la normale et le regard (sinon le point déborde sur ce qui est derrière lui)
        soit ndv = (ex * vx + ey * vy + ez * vz) .>> 15;
        si ndv .< 0 {
            ndv = 0 - ndv;
        }
        soit lv = racine_entiere((vx .>> 8) * (vx .>> 8) + (vy .>> 8) * (vy .>> 8) + (vz .>> 8) * (vz .>> 8)) << 8;
        soit ry = rr;
        si lv > 0 {
            ry = (rr * ((ndv * 512) / lv) + 255) >> 8;
        }
        si ry > rr {
            ry = rr;
        }
        si rr <= 24 {
            soit cle = (zc << 32) | (eau << 30) | (x << 20) | (y << 10) | z;
            pour dy dans 0..(2 * ry + 1) {
                soit yy = py + dy - ry;
                si yy .>= 0 && yy .< H {
                    pour dx dans 0..(2 * rr + 1) {
                        soit xx = px + dx - rr;
                        si xx .>= 0 && xx .< W {
                            soit a = (FPROJ << 24) + yy * W + xx;
                            si cle < @2[a] {
                                @2[a] = cle;
                            }
                        }
                    }
                }
            }
        }
    }
}

// le pixel i : depuis le point qui l'a gagné (la lumière de ce point, la brume de sa profondeur) ; rien (inconnu) ou
// l'eau : le rayon
fonction resoudre(i, cx, cy, cz, lacet, tangage, temps) {
    soit k = @2[(FPROJ << 24) + i];
    si k == PIXEL_VIDE {
        retour point_vu(i, cx, cy, cz, lacet, tangage, temps);
    }
    si ((k >> 30) & 1) == 1 {
        retour point_vu(i, cx, cy, cz, lacet, tangage, temps);
    }
    soit x = (k >> 20) & 1023;
    soit y = (k >> 10) & 1023;
    soit z = k & 1023;
    soit ox = x * 65536 + 32768;
    soit oy = y * 65536 + 32768;
    soit oz = z * 65536 + 32768;
    soit om = ombrer(ox, oy, oz, 0, 0, 0, 0, 0);
    soit c = eclairer(ox, oy, oz, 0, 0, 0, 0, om, 0);
    retour brumer(c, (k >> 32) & 4294967295);
}

fonction image_gergovie(i, n, temps, sur_carte) {
    soit cx = (176 * 65536 + (96 * 65536 / n) * i) * RN / RD;
    soit cy = (84 * 65536 - (24 * 65536 / n) * i) * RN / RD;
    soit cz = (470 * 65536 - (160 * 65536 / n) * i) * RN / RD;
    soit lacet = (504 + (16 * i) / n) & 1023;
    soit tangage = (978 + (32 * i) / n) & 1023;
    si sur_carte == 3 {
        image_projection(cx, cy, cz, lacet, tangage, temps);
    } sinon si sur_carte == 2 {
        image_etages(cx, cy, cz, lacet, tangage, temps);
    } sinon si sur_carte == 1 {
        image_carte(cx, cy, cz, lacet, tangage, temps);
    } sinon {
        image_processeur(cx, cy, cz, lacet, tangage, temps);
    }
}

fonction en_dixiemes(d): texte {
    retour texte(d / 10) + "," + texte(d % 10);
}

// le bilan d'une épreuve de n images (les temps, en ms, dans @2[TEMPS + i])
constante TEMPS = 605000;

fonction bilan(nom: texte, n, derniere) {
    // 0.849 : derniere, l'empreinte de la dernière image (presenter_cube la rend ; sinon celle de l'étage 1)
    soit total = 0;
    soit pire = 0;
    pour i dans 0..n {
        total = total + @2[TEMPS + i];
        si @2[TEMPS + i] > pire {
            pire = @2[TEMPS + i];
        }
    }
    soit k = n / 100;
    si k == 0 {
        k = 1;
    }
    soit lents = 0;
    pour j dans 0..k {
        soit m = 0;
        soit place = 0;
        pour i dans 0..n {
            si @2[TEMPS + i] >= m {
                m = @2[TEMPS + i];
                place = i;
            }
        }
        lents = lents + m;
        @2[TEMPS + place] = 0;
    }
    si total == 0 {
        total = 1;
    }
    si lents == 0 {
        lents = 1;
    }
    afficher("gergovie : " + nom + " : " + texte(n) + " images, " + en_dixiemes(10000 * n / total)
             + " images par seconde en moyenne, 1 % bas " + en_dixiemes(10000 * k / lents) + ", pire image "
             + texte(pire) + " ms ; empreinte " + texte(signe64(derniere)));
}

// l'épreuve : le monde, la mise en place (pas comptée), le vol (vol images, le soleil fixe), le jour (jour images,
// le soleil bouge : la clepsydre refaite à chaque image, sur la carte quand l'image y est faite) ; sur_carte : 0 le
// processeur, 1 la carte d'un seul noyau, 2 la carte par les étages
fonction epreuve(vol, jour, sur_carte) {
    epreuve_complete(vol, jour, 0, sur_carte);
}

// ------------------------------------------------------------------ 0.850 : l'ombre à marges (l'idée du créateur)
// La clepsydre n'est refaite que là où le soleil a pu changer quelque chose. Pour chaque mot du calque (huit points de
// surface), une marge : la plus grande corde (|d' - d|, en 1/65536) dont les directions du soleil peuvent tourner sans
// changer un seul des huit octets. Un rayon libre le reste tant que le rayon tourné passe loin de la matière : au pas
// t, il s'écarte de t · corde ; la marge est le plus petit (garde - EPS) / t le long du rayon, où la garde est une
// distance sûre à la matière (les blocs vides qui savent leur distance, les 26 voisins de chaque point des blocs
// porteurs, rangés une fois : FVOIS). Un rayon arrêté le reste tant que le rayon tourné entre encore dans la matière :
// la meilleure profondeur / t un peu au-delà du point touché. La pente (n · soleil) : sa marge aussi. Les états du
// créateur s'y lisent : vrai, l'ombre installée (gardée) ; inconnu, la lumière installée (gardée) ; variable, le bord
// (sa marge est épuisée : refait) ; faux, le point qui sort de l'ombre (refait, puis gardé). Une marge nulle (un mot
// jamais calculé) oblige à calculer. Le monde ne doit pas changer (l'ADN) ; l'épreuve compare chaque image (l'empreinte
// du film) à la clepsydre complète.
constante FVOIS = 150;             // FVOIS + t : les voisins de chaque point de la réserve de la tuile t (deux par mot)
constante FMARGE = 210;            // FMARGE + t (sur la carte) : pour chaque mot du calque : (g << 32) | la marge
constante HIST = 700000;           // HIST + 16 · (g & 4095) : les cinq directions du soleil (jeu 0) de l'image g
constante GSOL = 600062;           // le numéro de la prochaine image du soleil
constante EPS = 64;                // en 1/65536 de point : les arrondis (le pas, la position)
constante MARGE_MAX = 262144;
constante FBOITE = 160;            // FBOITE + t : la boîte de la matière de chaque bloc porteur (six nombres de 0 à 7 ;
                                   // 1 << 62 : pas de matière)      // une marge plus grande ne sert à rien (une corde vaut au plus 2 · 65536)

// de la matière pour un rayon du soleil (l'eau n'arrête pas)
fonction solide(x, y, z) {
    soit el = element(x, y, z);
    si el != 0 && ((el >> 2) & 63) != EAU {
        retour 1;
    }
    retour 0;
}

// pour chaque point de chaque bloc porteur : bit 31, de la matière ; bits 0 à 25, ceux des 26 voisins qui sont d'une
// autre sorte (de la matière autour d'un point vide, du vide autour d'un point de matière) ; deux points par mot
fonction preparer_voisins() {
    pour t dans 0..(TUILES * TUILES) {
        soit n = @2[GLOB + 1 + t];
        pour b dans 0..n en bandes {
            voisins_bloc(t, b);
        }
    }
}

fonction voisins_bloc(t, b) {
    soit blk = @2[((FINV + t) << 24) + b];
    soit x0 = (t % TUILES) * 256 + (blk >> 10) * 8;
    soit y0 = ((blk >> 5) & 31) * 8;
    soit z0 = (t / TUILES) * 256 + (blk & 31) * 8;
    soit bx0 = 8;
    soit by0 = 8;
    soit bz0 = 8;
    soit bx1 = 0;
    soit by1 = 0;
    soit bz1 = 0;
    pour p dans 0..256 {
        soit mot = 0;
        pour h dans 0..2 {
            soit v = p * 2 + h;
            soit x = x0 + (v >> 6);
            soit y = y0 + ((v >> 3) & 7);
            soit z = z0 + (v & 7);
            soit soi = solide(x, y, z);
            si soi == 1 {
                si (v >> 6) < bx0 { bx0 = v >> 6; }
                si (v >> 6) > bx1 { bx1 = v >> 6; }
                si ((v >> 3) & 7) < by0 { by0 = (v >> 3) & 7; }
                si ((v >> 3) & 7) > by1 { by1 = (v >> 3) & 7; }
                si (v & 7) < bz0 { bz0 = v & 7; }
                si (v & 7) > bz1 { bz1 = v & 7; }
            }
            soit m = soi << 31;
            soit bit = 0;
            pour k dans 0..27 {
                si k != 13 {
                    soit autre = solide(x + k / 9 - 1, y + (k / 3) % 3 - 1, z + k % 3 - 1);
                    si autre != soi {
                        m = m | (1 << bit);
                    }
                    bit = bit + 1;
                }
            }
            mot = mot | (m << (h * 32));
        }
        @2[((FVOIS + t) << 24) + b * 256 + p] = mot;
    }
    si bx0 == 8 {
        @2[((FBOITE + t) << 24) + b] = 1 << 62;
    } sinon {
        @2[((FBOITE + t) << 24) + b] = bx0 | (by0 << 3) | (bz0 << 6) | (bx1 << 9) | (by1 << 12) | (bz1 << 15);
    }
}

// l'écart (signé) d'une coordonnée p à l'intervalle [lo, hi]
fonction ecart(p, lo, hi) {
    si p .< lo {
        retour lo - p;
    }
    si p .> hi {
        retour p - hi;
    }
    retour 0;
}

// la distance (de Tchebychev, plus petite que la vraie) du point p (en 1/65536) à la boîte de côté c (en points) au
// coin (ax, ay, az)
fonction dist_boite(px, py, pz, ax, ay, az, c) {
    soit d = ecart(px, ax << 16, (ax + c) << 16);
    soit dy = ecart(py, ay << 16, (ay + c) << 16);
    soit dz = ecart(pz, az << 16, (az + c) << 16);
    si dy .> d {
        d = dy;
    }
    si dz .> d {
        d = dz;
    }
    retour d;
}

// la distance du point p aux voisins marqués (masque de 26 bits) du point (vx, vy, vz) ; au plus un point
fonction dist_voisins(px, py, pz, vx, vy, vz, masque) {
    soit d = 65536;
    soit reste = masque;
    tantque reste != 0 {
        soit bit = zeros_en_queue(reste);
        reste = reste & (reste - 1);
        soit k = bit;
        si bit >= 13 {
            k = bit + 1;
        }
        soit e = dist_boite(px, py, pz, vx + k / 9 - 1, vy + (k / 3) % 3 - 1, vz + k % 3 - 1, 1);
        si e .< d {
            d = e;
        }
    }
    retour d;
}

// la garde sûre du morceau de rayon [ta, tb] dans le point (vx, vy, vz) : en quatre parts, chacune par ses deux bouts
// (la distance ne change pas plus vite que le chemin)
fonction garde_voisins(ox, oy, oz, dx, dy, dz, dmax, ta, tb, vx, vy, vz, masque) {
    soit g = 65536;
    soit pa = dist_voisins(ox + ((dx * ta) .>> 16), oy + ((dy * ta) .>> 16), oz + ((dz * ta) .>> 16), vx, vy, vz, masque);
    soit a = ta;
    pour k dans 1..5 {
        soit b = ta + ((tb - ta) * k) / 4;
        soit pb = dist_voisins(ox + ((dx * b) .>> 16), oy + ((dy * b) .>> 16), oz + ((dz * b) .>> 16), vx, vy, vz, masque);
        soit l = ((b - a) * dmax) >> 16;
        soit gk = (pa + pb - l - 2 * EPS) ./ 2;
        si gk .< g {
            g = gk;
        }
        pa = pb;
        a = b;
    }
    retour g;
}

// la distance du point p à la matière des 26 blocs voisins du bloc (gx, gy, gz) : un bloc plein (pas d'eau) par sa
// boîte, un bloc porteur par la boîte de sa matière ; au plus 8 points
fonction dist_blocs(px, py, pz, gx, gy, gz) {
    soit d = 8 * 65536;
    pour k dans 0..27 {
        soit ax = gx + k / 9 - 1;
        soit ay = gy + (k / 3) % 3 - 1;
        soit az = gz + k % 3 - 1;
        si k != 13 && ax .>= 0 && ay .>= 0 && az .>= 0 && ax .< NB && ay .< 32 && az .< NB {
            soit tu = (az >> 5) * TUILES + (ax >> 5);
            soit e = @elements(tu)[((ax & 31) << 10) + ((ay & 31) << 5) + (az & 31)];
            soit c = 8 * 65536;
            si (e >> 62) == 1 {
                si ((e >> 2) & 63) != EAU {
                    c = dist_boite(px, py, pz, ax * 8, ay * 8, az * 8, 8);
                }
            } sinon si (e >> 62) == 0 {
                soit bt = @2[((FBOITE + tu) << 24) + e - 16];
                si bt != (1 << 62) {
                    soit lx = ecart(px, (ax * 8 + (bt & 7)) << 16, (ax * 8 + ((bt >> 9) & 7) + 1) << 16);
                    soit ly = ecart(py, (ay * 8 + ((bt >> 3) & 7)) << 16, (ay * 8 + ((bt >> 12) & 7) + 1) << 16);
                    soit lz = ecart(pz, (az * 8 + ((bt >> 6) & 7)) << 16, (az * 8 + ((bt >> 15) & 7) + 1) << 16);
                    c = lx;
                    si ly .> c {
                        c = ly;
                    }
                    si lz .> c {
                        c = lz;
                    }
                }
            }
            si c .< d {
                d = c;
            }
        }
    }
    retour d;
}

// le pas jusqu'à la sortie de la cellule de côté s (1 : un point, 8 : un bloc) qui contient p (comme dans tracer)
fonction pas_cellule(px, py, pz, dx, dy, dz, ix, iy, iz, s) {
    soit x = px .>> 16;
    soit y = py .>> 16;
    soit z = pz .>> 16;
    soit pas = MANQUE;
    si dx .> 0 {
        soit e1 = (((((x | (s - 1)) + 1) << 16) - px) * ix) >> 24;
        si e1 < pas {
            pas = e1;
        }
    } sinon si dx .< 0 {
        soit e2 = (((px - ((x & (0 - s)) << 16)) + 1) * ix) >> 24;
        si e2 < pas {
            pas = e2;
        }
    }
    si dy .> 0 {
        soit e3 = (((((y | (s - 1)) + 1) << 16) - py) * iy) >> 24;
        si e3 < pas {
            pas = e3;
        }
    } sinon si dy .< 0 {
        soit e4 = (((py - ((y & (0 - s)) << 16)) + 1) * iy) >> 24;
        si e4 < pas {
            pas = e4;
        }
    }
    si dz .> 0 {
        soit e5 = (((((z | (s - 1)) + 1) << 16) - pz) * iz) >> 24;
        si e5 < pas {
            pas = e5;
        }
    } sinon si dz .< 0 {
        soit e6 = (((pz - ((z & (0 - s)) << 16)) + 1) * iz) >> 24;
        si e6 < pas {
            pas = e6;
        }
    }
    retour pas;
}

// la valeur absolue d'un nombre signé
fonction absolu(a) {
    si a .< 0 {
        retour 0 - a;
    }
    retour a;
}

// la marge d'un morceau de rayon [.., te] gardé à g de la matière
fonction marge_morceau(g, te) {
    si g .<= EPS {
        retour 0;
    }
    soit c = ((g - EPS) * 65536) / (te + 1);
    si c > MARGE_MAX {
        retour MARGE_MAX;
    }
    retour c;
}

// la marge d'un rayon libre (tracer a rendu MANQUE) : la plus petite garde / t le long du rayon, jusqu'à tmax
fonction marge_libre(ox, oy, oz, dx, dy, dz, tmax) {
    soit m = MARGE_MAX;
    soit ix = 0;
    soit iy = 0;
    soit iz = 0;
    si dx != 0 {
        ix = 1099511627776 / absolu(dx);
    }
    si dy != 0 {
        iy = 1099511627776 / absolu(dy);
    }
    si dz != 0 {
        iz = 1099511627776 / absolu(dz);
    }
    soit dmax = absolu(dx);
    si absolu(dy) > dmax {
        dmax = absolu(dy);
    }
    si absolu(dz) > dmax {
        dmax = absolu(dz);
    }
    soit haut = @2[GLOB + 20] << 16;
    soit t = 0;
    tantque t < tmax && m > 0 {
        soit px = ox + ((dx * t) .>> 16);
        soit py = oy + ((dy * t) .>> 16);
        soit pz = oz + ((dz * t) .>> 16);
        soit te = t;
        si dy .> 0 && py .>= haut + 2 * 65536 {
            // au-dessus de toute matière et montant : la garde ne fait que croître ; deux bornes (ici, et à tmax)
            soit g0 = py - haut;
            soit c1 = marge_morceau(g0, t);
            si c1 < m {
                m = c1;
            }
            si dy < m {
                m = dy;
            }
            t = tmax;
        } sinon si px .< 0 || py .< 0 || pz .< 0 || px .>= MONDE * 65536 || pz .>= MONDE * 65536 || py .>= 256 * 65536 {
            // hors du monde : la distance au monde (un morceau de la moitié de cette distance, au moins un point)
            soit g1 = ecart(px, 0, MONDE * 65536);
            soit gy = ecart(py, 0, 256 * 65536);
            soit gz = ecart(pz, 0, MONDE * 65536);
            si gy .> g1 {
                g1 = gy;
            }
            si gz .> g1 {
                g1 = gz;
            }
            si g1 < 2 * 65536 {
                // tout près du monde : point par point, ses voisins lus (hors du monde, rien n'arrête)
                soit ux = px .>> 16;
                soit uy = py .>> 16;
                soit uz = pz .>> 16;
                soit mq = 0;
                soit bq = 0;
                pour kq dans 0..27 {
                    si kq != 13 {
                        si solide(ux + kq / 9 - 1, uy + (kq / 3) % 3 - 1, uz + kq % 3 - 1) == 1 {
                            mq = mq | (1 << bq);
                        }
                        bq = bq + 1;
                    }
                }
                te = t + pas_cellule(px, py, pz, dx, dy, dz, ix, iy, iz, 1);
                soit g3 = 65536;
                si mq != 0 {
                    g3 = garde_voisins(ox, oy, oz, dx, dy, dz, dmax, t, te, ux, uy, uz, mq);
                }
                soit c2b = marge_morceau(g3, te);
                si c2b < m {
                    m = c2b;
                }
            } sinon {
                // plus loin : la distance au monde (un morceau de la moitié de cette distance)
                soit lg = g1 / 2;
                te = t + (lg * 65536) / dmax;
                soit c2 = marge_morceau(g1 - lg, te);
                si c2 < m {
                    m = c2;
                }
            }
            t = te + 1;
        } sinon {
            soit x = px >> 16;
            soit y = py >> 16;
            soit z = pz >> 16;
            soit tu = (z >> 8) * TUILES + (x >> 8);
            soit e = @elements(tu)[(((x >> 3) & 31) << 10) + (((y >> 3) & 31) << 5) + ((z >> 3) & 31)];
            si (e >> 62) == 2 && (e & 255) >= 2 {
                // un bloc vide qui sait sa distance d : tout son intérieur est à (d - 1) · 8 points de la matière
                te = t + pas_cellule(px, py, pz, dx, dy, dz, ix, iy, iz, 8);
                soit c3 = marge_morceau(((e & 255) - 1) * 8 * 65536, te);
                si c3 < m {
                    m = c3;
                }
                t = te + 1;
            } sinon si (e >> 62) == 0 {
                // un bloc porteur : point par point, par ses voisins
                soit vv = ((x & 7) << 6) + ((y & 7) << 3) + (z & 7);
                soit w = (@2[((FVOIS + tu) << 24) + (e - 16) * 256 + (vv >> 1)] >> ((vv & 1) * 32)) & 4294967295;
                te = t + pas_cellule(px, py, pz, dx, dy, dz, ix, iy, iz, 1);
                si (w >> 31) == 1 {
                    m = 0;
                } sinon {
                    soit msq = w & 67108863;
                    soit g2 = 65536;
                    si msq != 0 {
                        g2 = garde_voisins(ox, oy, oz, dx, dy, dz, dmax, t, te, x, y, z, msq);
                    }
                    soit c4 = marge_morceau(g2, te);
                    si c4 < m {
                        m = c4;
                    }
                }
                t = te + 1;
            } sinon si (e >> 62) == 1 && ((e >> 2) & 63) != EAU {
                // un bloc plein de matière sur un rayon libre : ne devrait pas être ; prudence
                m = 0;
            } sinon {
                // un bloc vide à côté de la matière, ou de l'eau : par les blocs voisins, en morceaux de deux points
                soit gx = x >> 3;
                soit gyb = y >> 3;
                soit gzb = z >> 3;
                soit fin = t + pas_cellule(px, py, pz, dx, dy, dz, ix, iy, iz, 8);
                soit morceau = (4 * 65536 * 65536) / dmax;
                soit a = t;
                soit ba = dist_blocs(px, py, pz, gx, gyb, gzb);
                tantque a < fin && m > 0 {
                    soit b = a + morceau;
                    si b > fin {
                        b = fin;
                    }
                    soit rx = ox + ((dx * b) .>> 16);
                    soit ry = oy + ((dy * b) .>> 16);
                    soit rz = oz + ((dz * b) .>> 16);
                    soit bb = dist_blocs(rx, ry, rz, gx, gyb, gzb);
                    soit lb = ((b - a) * dmax) >> 16;
                    soit c5 = marge_morceau((ba + bb - lb - 2 * EPS) ./ 2, b);
                    si c5 < m {
                        m = c5;
                    }
                    ba = bb;
                    a = b + 1;
                }
                t = fin + 1;
            }
        }
    }
    retour m;
}

// la profondeur sûre du point p dans la matière (0 s'il n'y est pas)
fonction profondeur(px, py, pz) {
    si px .< 0 || py .< 0 || pz .< 0 || px .>= MONDE * 65536 || pz .>= MONDE * 65536 || py .>= 256 * 65536 {
        retour 0;
    }
    soit x = px >> 16;
    soit y = py >> 16;
    soit z = pz >> 16;
    soit tu = (z >> 8) * TUILES + (x >> 8);
    soit e = @elements(tu)[(((x >> 3) & 31) << 10) + (((y >> 3) & 31) << 5) + ((z >> 3) & 31)];
    si (e >> 62) == 2 {
        retour 0;
    }
    si (e >> 62) == 1 {
        si ((e >> 2) & 63) == EAU {
            retour 0;
        }
        // un bloc plein : la distance à ses faces (ses voisins ne sont pas lus)
        soit d = 8 * 65536;
        soit lx = px - ((x & (0 - 8)) << 16);
        soit ly = py - ((y & (0 - 8)) << 16);
        soit lz = pz - ((z & (0 - 8)) << 16);
        si lx < d { d = lx; }
        si 8 * 65536 - lx < d { d = 8 * 65536 - lx; }
        si ly < d { d = ly; }
        si 8 * 65536 - ly < d { d = 8 * 65536 - ly; }
        si lz < d { d = lz; }
        si 8 * 65536 - lz < d { d = 8 * 65536 - lz; }
        retour d;
    }
    soit vv = ((x & 7) << 6) + ((y & 7) << 3) + (z & 7);
    soit w = (@2[((FVOIS + tu) << 24) + (e - 16) * 256 + (vv >> 1)] >> ((vv & 1) * 32)) & 4294967295;
    si (w >> 31) == 0 {
        retour 0;
    }
    soit msq = w & 67108863;
    si msq == 0 {
        retour 65536;
    }
    retour dist_voisins(px, py, pz, x, y, z, msq);
}

// la marge d'un rayon arrêté au pas th : la meilleure profondeur / t sur six points au-delà (un demi-point de pas)
fonction marge_bloquee(ox, oy, oz, dx, dy, dz, th, tmax) {
    soit meilleur = 0;
    soit sous = (@2[GLOB + 20] - 1) << 16;
    pour k dans 0..13 {
        soit t = th + k * 32768;
        si t + 65536 < tmax {
            soit px = ox + ((dx * t) .>> 16);
            soit py = oy + ((dy * t) .>> 16);
            soit pz = oz + ((dz * t) .>> 16);
            si py .< sous {
                soit c = marge_morceau(profondeur(px, py, pz) - EPS, t);
                si c > meilleur {
                    meilleur = c;
                }
            }
        }
    }
    retour meilleur;
}

// la clepsydre d'un point et sa marge : vus | marge << 8 (comme soleil_vu, jeu 0)
fonction soleil_vu_marge(x, y, z, nx, ny, nz) {
    soit sx = (x << 16) + 32768 + nx * 858;
    soit sy = (y << 16) + 32768 + ny * 858;
    soit sz = (z << 16) + 32768 + nz * 858;
    soit dp = depart(x, y, z, nx, ny, nz);
    si dp < 6 {
        sx = (x << 16) + 32768;
        sy = (y << 16) + 32768;
        sz = (z << 16) + 32768;
        si dp == 0 {
            sx = sx + 65536;
        } sinon si dp == 1 {
            sx = sx - 65536;
        } sinon si dp == 2 {
            sy = sy + 65536;
        } sinon si dp == 3 {
            sy = sy - 65536;
        } sinon si dp == 4 {
            sz = sz + 65536;
        } sinon {
            sz = sz - 65536;
        }
    }
    soit so = SOLEILS;
    // la pente : nl = (n · soleil) ./ 127 ; elle reste du même côté de 0 tant que la corde reste sous |s - 127| / |n|₁
    soit s = nx * @2[so + 12] + ny * @2[so + 13] + nz * @2[so + 14];
    soit n1 = absolu(nx) + absolu(ny) + absolu(nz);
    soit m = MARGE_MAX;
    si n1 > 0 {
        si s .>= 127 {
            m = (s - 127) / n1;
        } sinon {
            m = (127 - s - 1) / n1;
        }
        si m > MARGE_MAX {
            m = MARGE_MAX;
        }
    }
    si s .< 127 {
        retour m << 8;
    }
    soit vus = 0;
    soit tmax = 700 * 65536 * RN / RD;
    pour k dans 0..4 {
        soit ddx = @2[so + 3 * k];
        soit ddy = @2[so + 3 * k + 1];
        soit ddz = @2[so + 3 * k + 2];
        soit r = tracer(sx, sy, sz, ddx, ddy, ddz, tmax, 0);
        soit mk = 0;
        si r == MANQUE {
            vus = vus + 1;
            mk = marge_libre(sx, sy, sz, ddx, ddy, ddz, tmax);
        } sinon {
            mk = marge_bloquee(sx, sy, sz, ddx, ddy, ddz, r, tmax);
        }
        si mk < m {
            m = mk;
        }
    }
    retour vus | (m << 8);
}

// la clepsydre à marges sur la carte (jeu 0, sans le ciel) : un fil par mot du calque ; un mot dont la marge tient
// n'est pas touché
fonction ranger_lumiere_marges() {
    soit g = @2[GSOL];
    soit h = HIST + 16 * (g & 4095);
    pour k dans 0..15 {
        @2[h + k] = @2[SOLEILS + k];
    }
    soit total = 0;
    pour t dans 0..(TUILES * TUILES) {
        total = total + @2[GLOB + 1 + t] * 64;
    }
    pour q dans 0..total en segments {
        ranger_mot_marges(q, g);
    }
    @2[GSOL] = g + 1;
}

// 0.850b (l'idée du créateur) : la marge ne se calcule que là où elle sert. Un mot du calque est soit neutre (sa
// marge tient : on n'y touche pas), soit dans la bande (le bord : refait simplement à chaque image, sans marge). Un mot
// de la bande qui ne change plus depuis CALME images se calme : sa marge est calculée une fois, et il devient neutre ;
// si elle ne tiendrait pas trois images du soleil d'aujourd'hui, il reste dans la bande ATTENTE images avant de
// réessayer (le calque apprend où la marge vaut la peine). Un mot neutre dont la marge s'épuise retourne dans la bande.
// FMARGE : (g << 32) | marge (20 bits) | calme << 20 | attente << 24 ; neutre : marge > 0 ; dans la bande : marge = 0.
constante CALME = 3;
constante FFEU = 214;              // FFEU + t (0.850b) : le calque du feu, rangé comme celui du soleil (128 | 0 à 15)
constante FEU = 600066;            // 1 : le feu brûle ; + 1, + 2, + 3 : sa place (en 1/65536 de point) ; + 4 : rangé
constante FEU_R = 48 * RN / RD;    // la portée du feu (en points)
constante ORAGE = 690000;          // ORAGE : le nombre d'images de l'orage ; + 1 + i : un saut ; + 300 + i : les mots refaits ; + 700 + i : le temps de la clepsydre ; + 1000 + i : le feu
constante ATTENTE = 16;

// la plus grande corde (au carré) des cinq directions du soleil entre les images ga et gb
fonction corde2(ga, gb) {
    soit ha = HIST + 16 * (ga & 4095);
    soit hb = HIST + 16 * (gb & 4095);
    soit c = 0;
    pour k dans 0..5 {
        soit ex = @2[hb + 3 * k] - @2[ha + 3 * k];
        soit ey = @2[hb + 3 * k + 1] - @2[ha + 3 * k + 1];
        soit ez = @2[hb + 3 * k + 2] - @2[ha + 3 * k + 2];
        soit e = ex * ex + ey * ey + ez * ez;
        si e > c {
            c = e;
        }
    }
    retour c;
}

fonction ranger_mot_marges(q, g) {
    soit t = 0;
    soit r = q;
    soit cherche = 1;
    pour k dans 0..(TUILES * TUILES) {
        si cherche == 1 {
            soit nk = @2[GLOB + 1 + k] * 64;
            si r < nk {
                t = k;
                cherche = 0;
            } sinon {
                r = r - nk;
            }
        }
    }
    soit n = r >> 6;
    soit w = r & 63;
    soit am = ((FMARGE + t) << 24) + n * 64 + w;
    soit mg = @2[am];
    soit g0 = mg >> 32;
    soit m = mg & 1048575;
    soit garde = 0;
    si m > 0 && g - g0 < 4000 {
        si corde2(g0, g) < m * m {
            garde = 1;
        }
    }
    // (sans retour au milieu : la carte le refuse)
    si garde == 0 {
        soit calme = (mg >> 20) & 15;
        soit attente = (mg >> 24) & 255;
        si m > 0 {
            // un mot neutre dont la marge s'épuise : il retourne dans la bande
            calme = 0;
            attente = 0;
        }
        ranger_mot_bande(t, n, w, g, am, calme, attente);
    }
}

fonction ranger_mot_bande(t, n, w, g, am, calme, attente) {
    soit b = @2[((FINV + t) << 24) + n];
    soit x0 = (t % TUILES) * 256 + (b >> 10) * 8;
    soit y0 = ((b >> 5) & 31) * 8;
    soit z0 = (t / TUILES) * 256 + (b & 31) * 8;
    soit base = (FELT + t) << 24;
    soit asol = ((fsol() + t) << 24) + n * 64 + w;
    soit avant = @2[asol];
    // calculer la marge : le mot est calme, et il n'attend pas ; un peu de hasard par mot (son numéro) pour que les mots
    // calmés en même temps ne la calculent pas tous à la même image
    soit avec = 0;
    si attente == 0 && calme >= CALME + ((n * 7 + w) & 3) {
        avec = 1;
    }
    soit ms = 0;
    soit mw = MARGE_MAX;
    pour j dans 0..8 {
        soit v = w * 8 + j;
        soit x = x0 + (v >> 6);
        soit y = y0 + ((v >> 3) & 7);
        soit z = z0 + (v & 7);
        soit el = @2[base + REP + n * 512 + v];
        si el != 0 && ((el >> 2) & 63) != EAU {
            si expose(x, y, z) == 1 {
                soit nn = normale_de(el);
                soit nx = (nn & 255) - 128;
                soit ny = ((nn >> 16) & 255) - 128;
                soit nz = ((nn >> 32) & 255) - 128;
                si avec == 1 {
                    soit sv = soleil_vu_marge(x, y, z, nx, ny, nz);
                    ms = ms | ((128 | (sv & 255)) << (j * 8));
                    si (sv >> 8) < mw {
                        mw = sv >> 8;
                    }
                } sinon {
                    ms = ms | ((128 | soleil_vu(x, y, z, nx, ny, nz, 0)) << (j * 8));
                }
            }
        }
    }
    @2[asol] = ms;
    soit etat = 0;
    si ms != avant {
        // il a changé : le bord passe ici ; il reste dans la bande
        etat = 0;
    } sinon si avec == 1 {
        // calme : neutre si la marge tient au moins trois images du soleil d'aujourd'hui
        soit c1 = 0;
        si g > 0 {
            c1 = corde2(g - 1, g);
        }
        si mw > 0 && mw * mw > 9 * c1 {
            etat = mw;
        } sinon {
            etat = ATTENTE << 24;
        }
    } sinon {
        soit c2 = calme + 1;
        si c2 > 15 {
            c2 = 15;
        }
        soit a2 = 0;
        si attente > 0 {
            a2 = attente - 1;
        }
        etat = (c2 << 20) | (a2 << 24);
    }
    @2[am] = (g << 32) | etat;
}

// 0.850 : pour l'épreuve (au processeur seulement) : combien de mots du calque l'image g a refaits
fonction compter_refaits(g) {
    soit c = 0;
    pour t dans 0..(TUILES * TUILES) {
        pour q dans 0..(@2[GLOB + 1 + t] * 64) {
            si (@2[((FMARGE + t) << 24) + q] >> 32) == g {
                c = c + 1;
            }
        }
    }
    retour c;
}

// 0.850c : la fréquence du calque du soleil. Sur la carte, il se range à FSOLC (200 et plus : il ne redescend pas au
// processeur ; mesuré chez le créateur en 0.850b : la clepsydre 16 ms par image, dont 7 de carte, le reste à rendre
// au processeur 650 000 mots qu'il ne lit pas) ; au processeur, à FSOL
fonction fsol() {
    si @2[CALQUE] == 0 {
        retour FSOL;
    }
    retour @2[CALQUE];
}

// 0.850b : la seconde lumière (la demande du créateur : une lumière qui apparaît dans une ombre) : un feu au fond du
// cratère du grand puy, que ses parois tiennent dans l'ombre du soleil presque toujours. Le feu ne bouge pas, le monde
// non plus : son calque (ce que chaque point de surface en reçoit : sa vue du feu, sa pente, la distance) se range une
// fois, la première fois qu'il s'allume ; ensuite, l'allumer ou l'éteindre ne coûte rien (l'image le lit, ou non). Les
// marges du soleil n'en sont pas touchées : chaque lumière a son calque.
fonction placer_feu() {
    soit h = @2[HCOL + PUY_Z * MONDE + PUY_X] / 256;
    @2[FEU + 1] = (PUY_X << 16) + 32768;
    @2[FEU + 2] = ((h + 3) << 16) + 32768;
    @2[FEU + 3] = (PUY_Z << 16) + 32768;
}

fonction ranger_feu() {
    soit total = 0;
    pour t dans 0..(TUILES * TUILES) {
        total = total + @2[GLOB + 1 + t] * 64;
    }
    pour q dans 0..total en segments {
        ranger_mot_feu(q);
    }
    @2[FEU + 4] = 1;
}

fonction ranger_mot_feu(q) {
    soit t = 0;
    soit r = q;
    soit cherche = 1;
    pour k dans 0..(TUILES * TUILES) {
        si cherche == 1 {
            soit nk = @2[GLOB + 1 + k] * 64;
            si r < nk {
                t = k;
                cherche = 0;
            } sinon {
                r = r - nk;
            }
        }
    }
    soit n = r >> 6;
    soit w = r & 63;
    soit b = @2[((FINV + t) << 24) + n];
    soit x0 = (t % TUILES) * 256 + (b >> 10) * 8;
    soit y0 = ((b >> 5) & 31) * 8;
    soit z0 = (t / TUILES) * 256 + (b & 31) * 8;
    soit fx = @2[FEU + 1];
    soit fy = @2[FEU + 2];
    soit fz = @2[FEU + 3];
    soit portee = FEU_R << 16;
    // le bloc entier hors de portée : rien
    soit ex = absolu(((x0 + 4) << 16) - fx);
    soit ey = absolu(((y0 + 4) << 16) - fy);
    soit ez = absolu(((z0 + 4) << 16) - fz);
    soit mf = 0;
    si ex < portee + 7 * 65536 && ey < portee + 7 * 65536 && ez < portee + 7 * 65536 {
        soit base = (FELT + t) << 24;
        pour j dans 0..8 {
            soit v = w * 8 + j;
            soit x = x0 + (v >> 6);
            soit y = y0 + ((v >> 3) & 7);
            soit z = z0 + (v & 7);
            soit el = @2[base + REP + n * 512 + v];
            si el != 0 && ((el >> 2) & 63) != EAU {
                si expose(x, y, z) == 1 {
                    soit nn = normale_de(el);
                    soit nx = (nn & 255) - 128;
                    soit ny = ((nn >> 16) & 255) - 128;
                    soit nz = ((nn >> 32) & 255) - 128;
                    mf = mf | ((128 | feu_vu(x, y, z, nx, ny, nz)) << (j * 8));
                }
            }
        }
    }
    @2[((FFEU + t) << 24) + n * 64 + w] = mf;
}

// ce que le point (x, y, z) de normale n reçoit du feu : 0 à 15 (sa vue du feu, sa pente, la distance)
fonction feu_vu(x, y, z, nx, ny, nz) {
    soit sx = (x << 16) + 32768 + nx * 858;
    soit sy = (y << 16) + 32768 + ny * 858;
    soit sz = (z << 16) + 32768 + nz * 858;
    soit lx = @2[FEU + 1] - sx;
    soit ly = @2[FEU + 2] - sy;
    soit lz = @2[FEU + 3] - sz;
    soit d = racine_entiere(((lx .>> 8) * (lx .>> 8) + (ly .>> 8) * (ly .>> 8) + (lz .>> 8) * (lz .>> 8))) << 8;
    soit portee = FEU_R << 16;
    si d >= portee || d < 65536 {
        retour 0;
    }
    soit dx = (lx * 65536) ./ d;
    soit dy = (ly * 65536) ./ d;
    soit dz = (lz * 65536) ./ d;
    soit nl = (nx * dx + ny * dy + nz * dz) ./ 127;
    si nl .<= 0 {
        retour 0;
    }
    si tracer(sx, sy, sz, dx, dy, dz, d, 0) != MANQUE {
        retour 0;
    }
    // (1 - (d / portée)²) · pente, borné à 15
    soit pd = (d >> 8) * (d >> 8);
    soit pp = (portee >> 8) * (portee >> 8);
    soit f = (40 * (pp - pd) / pp) * nl / 65536;
    si f > 15 {
        f = 15;
    }
    retour f;
}

// le feu reçu par le point (x, y, z) de la réserve e0 (0 si le feu est éteint)
fonction feu_point(tt, e0, x, y, z) {
    si @2[FEU] != 1 {
        retour 0;
    }
    soit iv = ((x & 7) << 6) | ((y & 7) << 3) | (z & 7);
    soit fb = (@2[((FFEU + tt) << 24) + (e0 - 16) * 64 + (iv >> 3)] >> ((iv & 7) * 8)) & 255;
    retour fb & 15;
}

// 0.850 : la clepsydre d'une image où le soleil bouge : à marges (MARGES, dans le programme principal : 1 ; 2 : et
// compter les mots refaits), sinon toute
fonction clepsydre(sur_carte) {
    si MARGES >= 1 {
        ranger_lumiere_marges();
        si MARGES == 2 {
            @2[GLOB + 63] = @2[GLOB + 63] + compter_refaits(@2[GSOL] - 1);
        }
    } sinon si sur_carte == 0 {
        ranger_lumiere(0, 0);
    } sinon {
        ranger_lumiere_carte(0, 0);
    }
}

// 0.850 : MARGES == 2 : la part des mots du calque refaits, en moyenne, sur n images
fonction dire_refaits(nom: texte, n) {
    si MARGES == 2 {
        soit total = 0;
        pour t dans 0..(TUILES * TUILES) {
            total = total + @2[GLOB + 1 + t] * 64;
        }
        afficher("gergovie : " + nom + " : la clepsydre à marges : " + texte((@2[GLOB + 63] * 1000) / (n * total))
                 + " pour mille des mots du calque refaits par image (" + texte(total) + " mots)");
        @2[GLOB + 63] = 0;
    }
}

// 0.849 : le lieu du choix « les étages » pour le Vergobret (gene, noter_gene)
constante GENE_ETAGES = 1;

// une image du soir : l'œil arrêté, le soleil qui bouge ; mode 4 : le Vergobret choisit les étages ou le noyau unique
// (ce qu'il a appris ; sinon il mesure l'un et l'autre, une paire par deux images)
// 0.849d : la mesure est bornée. Les CHAUFFE premières images ne comptent pas (l'œil vient d'arriver, et les gènes
// « lot » et « fondre » se mesurent encore : la carte prépare leurs noyaux, 948 ms à une image en 0.849c) ; puis
// MESURES paires sont notées pour le Vergobret, et le programme décide pour la fin du soir à la majorité de ces
// paires (@2[OEIL + 8] : 1 les étages, 2 le noyau unique). En 0.849c il mesurait tout le soir (20 images par seconde
// au lieu de 33).
constante CHAUFFE = 8;
constante MESURES = 6;

fonction image_soir(k, n, temps, sur_carte, i) {
    si sur_carte != 4 {
        image_gergovie(k, n, temps, sur_carte);
        retour;
    }
    selon gene(GENE_ETAGES) {
        vrai { image_gergovie(k, n, temps, 2); }
        faux { image_gergovie(k, n, temps, 1); }
        autre {
            si @2[OEIL + 8] == 1 {
                image_gergovie(k, n, temps, 2);
                retour;
            }
            si @2[OEIL + 8] == 2 {
                image_gergovie(k, n, temps, 1);
                retour;
            }
            soit t1 = horloge_us();
            image_gergovie(k, n, temps, 2 - (i & 1));
            soit d = horloge_us() - t1;
            si i < CHAUFFE {
                retour;
            }
            si (i & 1) == 0 {
                @2[OEIL + 6] = d;
            } sinon {
                noter_gene(GENE_ETAGES, @2[OEIL + 6], d);
                si @2[OEIL + 6] < d {
                    @2[OEIL + 9] = @2[OEIL + 9] + 1;
                }
                @2[OEIL + 7] = @2[OEIL + 7] + 1;
                si @2[OEIL + 7] >= MESURES {
                    @2[OEIL + 8] = 2;
                    si @2[OEIL + 9] * 2 > MESURES {
                        @2[OEIL + 8] = 1;
                    }
                }
            }
        }
    }
}

fonction epreuve_complete(vol, jour, soir, sur_carte_demande) {
    // 0.849 : le mode 4 (le Vergobret choisit, le soir) joue le vol et le jour d'un seul noyau
    soit sur_carte = sur_carte_demande;
    si sur_carte == 4 {
        sur_carte = 1;
    }
    soit t0 = horloge();
    creer_monde();
    si MARGES >= 1 {
        preparer_voisins();
    }
    afficher("le monde : " + texte(horloge() - t0) + " ms ; blocs porteurs d'une surface, par tuile : "
             + texte(@2[GLOB + 1]) + ", " + texte(@2[GLOB + 2]) + ", " + texte(@2[GLOB + 3]) + ", " + texte(@2[GLOB + 4]));
    ecran(W, H);
    // 0.849 : presenter_cube est compté dans le temps de l'image : la fenêtre n'attend pas (sans cela, presenter attend
    // 16 ms entre deux images : 60 images par seconde au plus)
    cadence(0);
    pour i dans 0..(W * H) {
        @2[(FIMAGE << 24) + i] = 0;
        @2[(FDIR << 24) + i] = 0;
        @2[(FMAT << 24) + i] = 0;
        @2[(FOMB << 24) + i] = 0;
        @2[(FLUM << 24) + i] = 0;
        @2[(FREF << 24) + i] = 0;
        @2[(FPROJ << 24) + i] = PIXEL_VIDE;
        @2[(FECRAN << 24) + i] = 0;
    }
    // 0.849 : sur la carte (sans l'ordre par blocs), l'image reste sur la carte et presenter_cube la montre ; elle est
    // comptée dans le temps de l'image (le temps qu'il faut pour qu'elle soit prête à l'écran : à armes égales)
    @2[OEIL + 5] = 0;
    // 0.850c : sur la carte, le calque du soleil reste sur la carte
    @2[CALQUE] = 0;
    si sur_carte != 0 {
        @2[CALQUE] = FSOLC;
    }
    // 0.849d : la mesure du soir (OEIL + 6 à 9) recommence
    pour q dans 6..10 {
        @2[OEIL + q] = 0;
    }
    soit sur_cube = 0;
    si (sur_carte == 1 || sur_carte == 2) && BLOCS == 0 {
        sur_cube = 1;
    }
    preparer_soleil(360, 70, 0);
    ranger_lumiere(1, 0);
    // 0.824 : la mise en place (pas comptée) : trois images et trois clepsydres (pour le même soleil : la même
    // lumière) ; chaque noyau de la carte s'y compile, et le vergobret y fait ses essais (la carte ou le processeur,
    // combien de cœurs) : rien de cela ne tombe plus pendant le vol ni le jour
    pour mise dans 0..3 {
        image_gergovie(0, vol, 0, sur_carte);
        clepsydre(sur_carte);
    }
    @2[GLOB + 63] = 0;
    soit lieu = " (au processeur)";
    si sur_carte == 1 {
        lieu = " (sur la carte, un noyau)";
    } sinon si sur_carte == 2 {
        lieu = " (sur la carte, les étages)";
    } sinon si sur_carte == 3 {
        lieu = " (sur la carte, la projection des points)";
    }
    // 0.829 : l'empreinte du film entier (chaque image comptée, hors du chronomètre) : la dernière image ne suffit pas
    // à juger une lumière qui change d'une image à l'autre
    soit film = 14695981039346656037;
    soit derniere = 0;
    pour i dans 0..vol {
        soit ti = horloge();
        image_gergovie(i, vol, i * 3, sur_carte);
        si sur_cube == 1 {
            soit ev = presenter_cube(FECRAN);
            @2[TEMPS + i] = horloge() - ti;
            film = ((film ^ ev) * 1099511628211) & MOT64;
            derniere = ev;
        } sinon {
            @2[TEMPS + i] = horloge() - ti;
            presenter();
            soit epev = empreinte_image();
            film = ((film ^ epev) * 1099511628211) & MOT64;
            derniere = epev;
        }
    }
    bilan("le vol" + lieu, vol, derniere);
    afficher("gergovie : le vol" + lieu + " : le film entier, empreinte " + texte(signe64(film)));
    film = 14695981039346656037;
    pour i dans 0..jour {
        soit tj = horloge();
        preparer_soleil(300 + i * 3, 50 + i, 0);
        clepsydre(sur_carte);
        image_gergovie(i, jour, i * 3, sur_carte);
        si sur_cube == 1 {
            soit ej = presenter_cube(FECRAN);
            @2[TEMPS + i] = horloge() - tj;
            film = ((film ^ ej) * 1099511628211) & MOT64;
            derniere = ej;
        } sinon {
            @2[TEMPS + i] = horloge() - tj;
            presenter();
            soit epej = empreinte_image();
            film = ((film ^ epej) * 1099511628211) & MOT64;
            derniere = epej;
        }
    }
    bilan("le jour" + lieu, jour, derniere);
    dire_refaits("le jour", jour);
    afficher("gergovie : le jour" + lieu + " : le film entier, empreinte " + texte(signe64(film)));
    // 0.849 : le soir : l'œil arrêté (au milieu du vol), le soleil qui descend ; les étages n'y refont que l'ombre, la
    // lumière, le reflet et le cache ; le mode 4 : le Vergobret choisit
    si soir > 0 {
        soit lieu_soir = lieu;
        si sur_carte_demande == 4 {
            lieu_soir = " (sur la carte, le Vergobret choisit)";
        }
        film = 14695981039346656037;
        pour i dans 0..soir {
            soit tsoir = horloge();
            preparer_soleil(200 + i * 2, 40 - (i * 30) / soir, 0);
            clepsydre(sur_carte);
            image_soir(vol / 2, vol, i * 3, sur_carte_demande, i);
            si sur_cube == 1 {
                soit es = presenter_cube(FECRAN);
                @2[TEMPS + i] = horloge() - tsoir;
                film = ((film ^ es) * 1099511628211) & MOT64;
                derniere = es;
            } sinon {
                @2[TEMPS + i] = horloge() - tsoir;
                presenter();
                soit eps = empreinte_image();
                film = ((film ^ eps) * 1099511628211) & MOT64;
                derniere = eps;
            }
        }
        bilan("le soir" + lieu_soir, soir, derniere);
        dire_refaits("le soir", soir);
        afficher("gergovie : le soir" + lieu_soir + " : le film entier, empreinte " + texte(signe64(film)));
    }
    // 0.850b : l'orage (la demande du créateur : une lumière qui apparaît au hasard) : l'œil arrêté, le soleil d'un jeu
    // (lent), qui saute au hasard (une image sur 24 en moyenne, la graine fixe : le même orage pour tous) ; pour
    // voir combien l'ombre coûte quand tout change d'un coup, et en combien d'images elle se recalme
    soit orage = @2[ORAGE];
    si orage > 0 {
        graine(1789);
        soit az = 250 * 64;
        soit el = 45 * 64;
        soit sauts = 0;
        soit feux = 0;
        @2[FEU] = 0;
        @2[FEU + 4] = 0;
        film = 14695981039346656037;
        pour i dans 0..orage {
            soit to = horloge();
            // le soleil d'un jeu : deux 65536e de tour par image (un centième de degré)
            az = az + 2;
            @2[ORAGE + 1 + i] = 0;
            si i > 0 && hasard(16) == 0 {
                az = hasard(65536);
                el = (15 + hasard(60)) * 64;
                @2[ORAGE + 1 + i] = 1;
                sauts = sauts + 1;
            }
            preparer_soleil_fin(az, el, 0);
            // le feu s'allume ou s'éteint au hasard (une image sur dix en moyenne) ; la première fois, son calque se range
            @2[ORAGE + 1000 + i] = 0;
            si i > 0 && hasard(10) == 0 {
                si @2[FEU + 4] == 0 {
                    placer_feu();
                    soit tf = horloge_us();
                    ranger_feu();
                    @2[ORAGE + 999] = horloge_us() - tf;
                }
                @2[FEU] = 1 - @2[FEU];
                @2[ORAGE + 1000 + i] = 1;
                feux = feux + 1;
            }
            soit avant = @2[GLOB + 63];
            soit tc = horloge_us();
            clepsydre(sur_carte);
            @2[ORAGE + 700 + i] = horloge_us() - tc;
            @2[ORAGE + 300 + i] = @2[GLOB + 63] - avant;
            image_gergovie(vol / 2, vol, i * 3, sur_carte);
            si sur_cube == 1 {
                soit eo = presenter_cube(FECRAN);
                @2[TEMPS + i] = horloge() - to;
                film = ((film ^ eo) * 1099511628211) & MOT64;
                derniere = eo;
            } sinon {
                @2[TEMPS + i] = horloge() - to;
                presenter();
                soit epo = empreinte_image();
                film = ((film ^ epo) * 1099511628211) & MOT64;
                derniere = epo;
            }
        }
        bilan("l'orage" + lieu, orage, derniere);
        // le temps de la clepsydre seule (à l'image d'un saut, et en moyenne) ; sur la carte, il dit l'envoi et l'attente
        soit tt = 0;
        soit ts = 0;
        pour i dans 0..orage {
            tt = tt + @2[ORAGE + 700 + i];
            si @2[ORAGE + 1 + i] == 1 {
                ts = ts + @2[ORAGE + 700 + i];
            }
        }
        // au calme : pas de saut depuis huit images
        soit tcal = 0;
        soit ncal = 0;
        pour i dans 8..orage {
            soit sj = 0;
            pour j dans 0..8 {
                sj = sj + @2[ORAGE + 1 + i - j];
            }
            si sj == 0 {
                tcal = tcal + @2[ORAGE + 700 + i];
                ncal = ncal + 1;
            }
        }
        soit dit_saut = "";
        si ncal > 0 {
            dit_saut = ", au calme (pas de saut depuis huit images) " + texte(tcal / (ncal * 100)) + " dixièmes de ms";
        }
        si sauts > 0 {
            dit_saut = dit_saut + ", à l'image d'un saut " + texte(ts / (sauts * 1000)) + " ms";
        }
        afficher("gergovie : l'orage" + lieu + " : la clepsydre " + texte(tt / (orage * 100)) + " dixièmes de ms par image en moyenne"
                 + dit_saut);
        si MARGES == 2 {
            dire_orage(orage, sauts);
        }
        dire_refaits("l'orage", orage);
        afficher("gergovie : l'orage" + lieu + " : le film entier, empreinte " + texte(signe64(film)) + " (" + texte(sauts)
                 + " sauts du soleil, le feu allumé ou éteint " + texte(feux) + " fois ; son calque rangé en "
                 + texte(@2[ORAGE + 999] / 1000) + " ms, une fois)");
        @2[FEU] = 0;
    }
}

// 0.850b : l'orage, après chaque saut : les mots refaits à l'image du saut, puis aux trois suivantes (pour mille)
fonction dire_orage(orage, sauts) {
    soit total = 0;
    pour t dans 0..(TUILES * TUILES) {
        total = total + @2[GLOB + 1 + t] * 64;
    }
    soit s0 = 0;
    soit s1 = 0;
    soit s2 = 0;
    soit s3 = 0;
    soit calme = 0;
    soit nc = 0;
    pour i dans 0..orage {
        si @2[ORAGE + 1 + i] == 1 {
            s0 = s0 + @2[ORAGE + 300 + i];
            si i + 1 < orage { s1 = s1 + @2[ORAGE + 301 + i]; }
            si i + 2 < orage { s2 = s2 + @2[ORAGE + 302 + i]; }
            si i + 3 < orage { s3 = s3 + @2[ORAGE + 303 + i]; }
        }
    }
    pour i dans 4..orage {
        // une image sans saut depuis quatre images : le calme de l'orage
        si @2[ORAGE + 1 + i] + @2[ORAGE + i] + @2[ORAGE + i - 1] + @2[ORAGE + i - 2] + @2[ORAGE + i - 3] == 0 {
            calme = calme + @2[ORAGE + 300 + i];
            nc = nc + 1;
        }
    }
    si sauts > 0 {
        afficher("gergovie : l'orage : la clepsydre à marges, à l'image du saut " + texte((s0 * 1000) / (sauts * total))
                 + " pour mille des mots refaits, puis " + texte((s1 * 1000) / (sauts * total)) + ", "
                 + texte((s2 * 1000) / (sauts * total)) + ", " + texte((s3 * 1000) / (sauts * total)) + " ; au calme "
                 + texte((calme * 1000) / ((nc + 1) * total)));
    }
}

// 0.850b : l'épreuve avec l'orage (n images après le soir)
fonction epreuve_orage(vol, jour, soir, orage, sur_carte) {
    @2[ORAGE] = orage;
    epreuve_complete(vol, jour, soir, sur_carte);
}
