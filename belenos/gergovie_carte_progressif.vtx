// machine : lugus
// Belenos : l'épreuve de Gergovie sur la carte (un noyau), la clepsydre progressive (0.828) : quand le soleil bouge, un
// mot du calque sur quatre est refait à chaque image (tiré par son lieu dans le cube), et la lumière d'une ligne de
// huit points se calcule d'abord aux bouts et au centre. Une autre image que gergovie.vtx au jour (l'ombre suit le
// soleil avec un peu de retard) ; le vol est le même. La référence : gergovie_ref.cpp avec -DPROGRESSIF.
//     python forge/forge128.py belenos/gergovie_carte_progressif.vtx -o gergovie_carte_progressif
constante RN = 1;
constante RD = 1;
constante BLOCS = 0;
constante PROGRESSIF = 1;
importer "gergovie_scene.vtx";

fonction principal() {
    epreuve(240, 120, 1);
}
