// machine : lugus
// Belenos : l'épreuve de Gergovie sur la carte (un noyau), les fils par blocs de 8 × 4 pixels (0.827) : une vague de la
// carte (32 fils) voit un petit carré de l'image. La même image, la même empreinte que gergovie.vtx.
//     python forge/forge128.py belenos/gergovie_carte_blocs.vtx -o gergovie_carte_blocs ; VTX_EPISSAGE=rapide VTX_CARTE=1 gergovie_carte_blocs
constante RN = 1;
constante RD = 1;
constante BLOCS = 1;
constante PROGRESSIF = 0;          // 0.828 : la clepsydre refaite en entier
importer "gergovie_scene.vtx";

fonction principal() {
    epreuve(240, 120, 1);
}
