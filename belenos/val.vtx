// machine : lugus
// Belenos : « Le val des neiges », la scène d'essai qu'on parcourt.
//     vtx toile128 belenos/val.vtx         (flèches : avancer, tourner ; a / q : monter, descendre ; o / p : tourner le
//                                           soleil ; i / k : le monter, le descendre (jusque sous l'horizon : la
//                                           nuit) ; n : le jour ou la nuit d'un coup ; f : les feux ; Échap : finir)
// La scène elle-même (le relief, la lumière, le rendu) est dans val_scene.vtx ; le banc de mesure dans val_banc.vtx,
// et le même calcul en C dans val_ref.c (la même image au point près : on compare les temps à armes égales).
importer "val_scene.vtx";

fonction principal() {
    ecran(W, H);
    preparer_tables();
    creer_relief();
    peindre_relief();
    cadence(0);
    // le soleil : au sud-ouest, à 25 degrés ; tout le relief éclairé une première fois
    soit az = 640;
    soit el = 71;
    eclairer_tout(az, el);
    // le tapis roulant de la lumière : la prochaine bande à éclairer, et ce qui reste à refaire depuis que le soleil a bougé
    soit bande = 0;
    soit reste = 0;
    soit tour = 2;              // 0.802 : 1 pendant le premier tour du tapis après un saut de lumière
    soit avant = horloge();
    soit ms = 0;
    // l'œil : au milieu de la grille (avec une marge pour rester positif), au-dessus du sol
    soit cx = (1 << 40) + (G / 2) * 65536;
    soit cz = (1 << 40) + (G / 2) * 65536;
    soit a = 0;
    soit au_sol = 4000;
    soit hor = H / 3;
    soit images = 0;
    soit fini = 0;
    tantque fini == 0 {
        // les touches : avancer, reculer, tourner, monter, descendre
        soit sa = @2[SINUS + (a & 1023)];
        soit ca = @2[SINUS + ((a + 256) & 1023)];
        si appuyee(touche_haut()) {
            cx = cx + sa ./ 2;
            cz = cz + ca ./ 2;
        }
        si appuyee(touche_bas()) {
            cx = cx - sa ./ 2;
            cz = cz - ca ./ 2;
        }
        si appuyee(touche_gauche()) {
            a = a - 8;
        }
        si appuyee(touche_droite()) {
            a = a + 8;
        }
        si appuyee(97) {
            au_sol = au_sol + 120;
        }
        si appuyee(113) && au_sol > 400 {
            au_sol = au_sol - 120;
        }
        // le soleil : o / p le tournent, i / k le montent et le descendent ; la lumière se refait bande par bande
        si appuyee(111) {
            az = (az + 1024 - 4) & 1023;
            reste = G;
        }
        si appuyee(112) {
            az = (az + 4) & 1023;
            reste = G;
        }
        si appuyee(105) && el .< 250 {
            el = el + 2;
            reste = G;
        }
        si appuyee(107) && el .> 0 - 70 {
            el = el - 2;
            reste = G;
        }
        si reste > 0 {
            eclairer_lignes(bande, bande + BANDE, az, el);
            bande = (bande + BANDE) & MASQUE;
            si reste > BANDE {
                reste = reste - BANDE;
            } sinon {
                reste = 0;
            }
            // 0.802 : la pyramide des renvois, refaite toutes les quatre bandes et quand la lumière est finie (les
            // bandes suivantes la lisent) : le renvoi change lentement, il n'a pas besoin de plus
            si (bande & 63) == 0 || reste == 0 {
                construire_pyramide();
            }
            // le second tour : après un saut de lumière (n, f), les premières bandes ont lu une pyramide d'avant : on
            // refait un tour avec la pyramide de la nouvelle lumière
            si reste == 0 && tour == 1 {
                tour = 2;
                reste = G;
            }
        }
        // la hauteur de l'œil : le sol sous lui, plus la hauteur choisie
        soit sol = @2[HAUT + ((cz >> 16) & MASQUE) * G + ((cx >> 16) & MASQUE)];
        rendre(cx, cz, sol + au_sol, a, hor, az, el);
        // le compteur : le temps de l'image précédente, le soleil
        soit haut_s = texte(el * 360 / 1024);
        si el .< 0 {
            haut_s = "-" + texte((0 - el) * 360 / 1024);
        }
        soit feux_s = "feux éteints";
        si @2[REGLES] == 1 {
            feux_s = "feux allumés";
        }
        texte_image(4, 4, "image " + texte(ms) + " ms   soleil " + texte(az * 360 / 1024) + " / " + haut_s + "   " + feux_s,
                    rgb(255, 255, 255));
        // 0.79 : l'ombre quaternaire (0.80 : la lumière de chaque case, du blanc au noir) : la part de chaque état (les lignes pas encore refaites : inconnu)
        soit tv = 0;
        soit tf = 0;
        soit tvar = 0;
        pour nl dans 0..G {
            tf = tf + @2[COMPTE + 4 * nl + 1];
            tv = tv + @2[COMPTE + 4 * nl + 2];
            tvar = tvar + @2[COMPTE + 4 * nl + 3];
        }
        soit tout = G * G;
        soit tinc = reste * G;
        texte_image(4, 16, "vrai " + texte(tv * 100 / tout) + " %   faux " + texte(tf * 100 / tout) + " %   variable " +
                    texte(tvar * 100 / tout) + " %   inconnu " + texte(tinc * 100 / tout) + " %", rgb(255, 230, 160));
        images = images + 1;
        si presenter() == 1 {
            fini = 1;
        }
        soit maintenant = horloge();
        ms = maintenant - avant;
        avant = maintenant;
        soit t = touche();
        tantque t != 0 {
            si t == 27 {
                fini = 1;
            }
            // 0.80 : f allume ou éteint les feux ; n passe du jour à la nuit (et retour) : toute la lumière à refaire
            si t == 102 {
                @2[REGLES] = 1 - @2[REGLES];
                reste = G;
                tour = 1;
            }
            si t == 110 {
                si el .> 0 {
                    el = 0 - 40;
                } sinon {
                    el = 71;
                }
                reste = G;
                tour = 1;
            }
            t = touche();
        }
    }
    afficher("images :", images);
}
