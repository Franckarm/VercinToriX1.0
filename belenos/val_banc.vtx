// machine : lugus
// Belenos : le banc du val des neiges. Sans fenêtre, toujours le même passage : douze images, l'œil qui avance et
// tourne, le soleil qui tourne (0.803 : toute la lumière refaite à chaque image) ; à la fin, l'empreinte de la dernière
// image (FNV-1a sur ses points). Les mêmes nombres partout : Lugus, la machine en Python, le .exe traduit en x86, et
// la même scène écrite dans un autre langage (pour la comparer) doivent donner la même empreinte.
//     LUGUS_TEMPS=1 lugus belenos/val_banc.vtx        (le temps et les instructions)
// 0.833 : le graphique compte en 64 bits (comme Taranis et les références) : Dunon
dunon;
importer "val_scene.vtx";

constante IMAGES = 12;

fonction empreinte_image() {
    soit h = 14695981039346656037;
    pour i dans 0..(W * H) {
        soit c = @1[i];
        // la couleur sur trois octets (le point profond : chaque voie répétée deux fois)
        soit rgb3 = ((c >> 56) & 255) * 65536 + ((c >> 40) & 255) * 256 + ((c >> 24) & 255);
        h = (h ^ rgb3) * 1099511628211;
    }
    retour h;
}

fonction principal() {
    ecran(W, H);
    preparer_tables();
    creer_relief();
    peindre_relief();
    soit az = 640;
    soit el = 71;
    eclairer_tout(az, el);
    soit t_images = horloge();
    soit cx = (1 << 40) + (G / 2) * 65536;
    soit cz = (1 << 40) + (G / 2) * 65536;
    soit a = 0;
    pour n dans 0..IMAGES {
        soit sa = @2[SINUS + (a & 1023)];
        soit ca = @2[SINUS + ((a + 256) & 1023)];
        cx = cx + sa ./ 2;
        cz = cz + ca ./ 2;
        a = (a + 6) & 1023;
        az = (az + 4) & 1023;
        // 0.803 : toute la lumière à chaque image (le soleil a bougé) : ce que coûte un changement instantané
        eclairer_tout(az, el);
        soit sol = @2[HAUT + ((cz >> 16) & MASQUE) * G + ((cx >> 16) & MASQUE)];
        rendre(cx, cz, sol + 4000, a, H / 3, az, el);
    }
    soit duree = horloge() - t_images;
    afficher("empreinte :", empreinte_image());
    // le temps, sur une deuxième ligne (la comparaison des machines ne regarde que l'empreinte)
    soit c = duree * 100 / IMAGES;
    soit zero = "";
    si c % 100 < 10 {
        zero = "0";
    }
    afficher(texte(IMAGES) + " images en " + texte(duree) + " ms (" + texte(c / 100) + "," + zero + texte(c % 100) +
             " ms par image)");
}
