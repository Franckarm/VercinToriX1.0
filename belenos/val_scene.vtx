// machine : lugus
// Belenos : « Le val des neiges », la scène (sans programme principal) : val.vtx la parcourt, val_banc.vtx la mesure.
// 0.72 : le soleil qu'on fait tourner (o / p) et monter (i / k), la lumière selon la pente face au soleil et les ombres
// portées (l'ombre du relief projetée depuis le soleil, avec sa pénombre), recalculées par bandes quand le soleil bouge
// (le tapis roulant : chaque image ne paie que sa bande) ; le ciel et le disque du soleil ; le compteur de l'image.
// 0.801 : l'ombre et la lumière ensemble (une seule lumière par case, du blanc au noir) et les sources diverses : le
// soleil, le ciel, le renvoi du sol éclairé, les feux, la lune. 0.802 : le renvoi par la pyramide de cubes.
// Un relief vallonné de pentes variées (une grille de 512 × 512 hauteurs, du bruit sur cinq octaves), la neige au-dessus
// d'une altitude et sur les pentes douces, la roche sur les pentes fortes, l'herbe en bas ; le ciel et la brume du loin.
// Chaque image : chaque colonne lance un rayon qui avance du plus près au plus loin et peint de bas en haut ce qu'il
// découvre (le tampon de hauteur de la colonne : rien n'est peint deux fois). Tout en entiers : les mêmes nombres partout.
//     vtx toile128 belenos/val.vtx         (flèches : avancer, tourner ; a / q : monter, descendre ; o / p : tourner le
//                                           soleil ; i / k : le monter, le descendre ; Échap : finir)
// Sans fenêtre (les essais) : --scenario rejoue des touches, et la scène s'arrête à Échap.

constante W = 1280;                // l'image : 0.807, en 720p (480 × 270 jusqu'à la 0.806)
constante H = 720;
constante G = 512;                 // la grille du relief : G × G cases (elle se répète : on marche sans bord)
constante MASQUE = 511;
constante HAUT = 1048576;          // @2[HAUT + z·G + x] : la hauteur, en 1/256 d'unité
constante COUL = 2097152;          // @2[COUL + z·G + x] : la couleur (le point profond, éclairé)
constante SINUS = 3145728;         // @2[SINUS + a] : 65536 · sin(2π a / 1024), en entier signé (deux compléments)
constante INV = 3146752;           // @2[INV + k] : 65536 · ECHELLE / distance(k)
constante DIST = 3147264;          // @2[DIST + k] : la distance du pas k, en 1/256 d'unité
constante BRUME = 3147776;         // @2[BRUME + k] : la part de brume du pas k (sur 256)
constante YBUF = 3148288;          // @2[YBUF + x] : le haut déjà peint de la colonne x
constante CIEL = 3149312;          // @2[CIEL + y] : 0.78, la couleur du ciel à la rangée y
constante ALB = 4194304;           // @2[ALB + z·G + x] : la couleur propre de la case (0xRRGGBB, sans lumière)
constante NPAS = 400;              // les pas d'un rayon
constante BANDE = 16;              // les lignes de la grille éclairées de nouveau à chaque image quand le soleil bouge
constante ECHELLE = 587;           // la hauteur à l'écran d'une unité à une unité de distance (220 en 480 × 270 : le même champ)
constante DISQUE = 24;             // le demi-côté du carré où se cherche le disque du soleil (9 en 480 × 270)

// ------------------------------------------------------------------------------------------------------- le relief
fonction hache(x, z) {
    soit h = (x & MASQUE) * 374761393 + (z & MASQUE) * 668265263 + 1013904223;
    h = (h ^ (h >> 13)) * 1274126177;
    retour (h ^ (h >> 16)) & 65535;
}

// le bruit lisse à la période p (une puissance de deux) : les quatre coins, mêlés en douceur (en 1/65536)
fonction bruit_lisse(x, z, p) {
    soit x0 = x / p;
    soit z0 = z / p;
    soit fx = (x % p) * 256 / p;
    soit fz = (z % p) * 256 / p;
    // la courbe douce : 3t² - 2t³ (sur 256)
    soit sx = fx * fx * (768 - 2 * fx) / 65536;
    soit sz = fz * fz * (768 - 2 * fz) / 65536;
    soit pas_g = G / p;
    soit a = hache(x0 % pas_g, z0 % pas_g);
    soit b = hache((x0 + 1) % pas_g, z0 % pas_g);
    soit c = hache(x0 % pas_g, (z0 + 1) % pas_g);
    soit d = hache((x0 + 1) % pas_g, (z0 + 1) % pas_g);
    soit h1 = (a * (256 - sx) + b * sx) / 256;
    soit h2 = (c * (256 - sx) + d * sx) / 256;
    retour (h1 * (256 - sz) + h2 * sz) / 256;
}

fonction creer_relief() {
    pour z dans 0..G en bandes {
        pour x dans 0..G {
            // cinq octaves : les grandes collines, puis les plis de plus en plus fins
            soit h = bruit_lisse(x, z, 256) * 16 + bruit_lisse(x, z, 128) * 8 + bruit_lisse(x, z, 64) * 4 + bruit_lisse(x, z, 32) * 2
                     + bruit_lisse(x, z, 16);
            // les crêtes plus hautes, les vallées plus douces : la hauteur au carré (le relief de montagne)
            soit n = h / 31;
            // les vallées aplanies sous 20000, les monts au-dessus, en carré : de 0 à 60000 (234 unités)
            soit m = 0;
            si n > 20000 {
                m = (n - 20000) * 2;
            }
            si m > 65535 {
                m = 65535;
            }
            @2[HAUT + z * G + x] = m * m / 65536 * 5 / 2 + n / 6;
        }
    }
}

// l'éclairage et la matière de chaque case : la pente (la différence avec les voisines), l'altitude
fonction peindre_relief() {
    pour z dans 0..G en bandes {
        pour x dans 0..G {
            soit h = @2[HAUT + z * G + x];
            soit hx = @2[HAUT + z * G + ((x + 1) & MASQUE)];
            soit hz = @2[HAUT + ((z + 1) & MASQUE) * G + x];
            soit pente = 0;
            si hx > h { pente = pente + hx - h; } sinon { pente = pente + h - hx; }
            si hz > h { pente = pente + hz - h; } sinon { pente = pente + h - hz; }
            soit r = 70;
            soit g = 110;
            soit b = 60;
            si pente > 700 {
                // la roche des pentes fortes
                r = 110;
                g = 105;
                b = 100;
            } sinon si h > 30000 || (h > 20000 && pente < 260) {
                // la neige : en haut, et sur les replats déjà hauts
                r = 235;
                g = 238;
                b = 245;
            } sinon si h > 12000 {
                // la lande d'altitude
                r = 120;
                g = 115;
                b = 80;
            }
            // un grain : la case n'est pas tout à fait la même que sa voisine
            soit grain = hache(x * 7, z * 13) & 15;
            r = r + grain;
            g = g + grain;
            b = b + grain;
            si r > 255 { r = 255; }
            si g > 255 { g = 255; }
            si b > 255 { b = 255; }
            @2[ALB + z * G + x] = r * 65536 + g * 256 + b;
        }
    }
    preparer_normales();
    // 0.80 : l'ouverture au ciel, les feux et leur lumière (le relief ne bouge pas : une fois)
    preparer_ouverture();
    preparer_feux();
    eclairer_feux();
}

// ------------------------------------------------------------------------------------------------------- le soleil
// le soleil : l'azimut az et la hauteur el (sur 1024 pour un tour) ; sa direction en 1/65536 (signée)
fonction sin1024(a) {
    retour @2[SINUS + (a & 1023)];
}

fonction cos1024(a) {
    retour @2[SINUS + ((a + 256) & 1023)];
}

fonction hauteur_en(x, z) {
    retour @2[HAUT + (z & MASQUE) * G + (x & MASQUE)];
}

// ------------------------------------------------------------------------------------------- l'ombre quaternaire
// 0.79 : l'ombre par balayage (l'ombre du cube projetée par le soleil). La lumière parcourt le relief en lignes
// parallèles, dans la direction où elle va ; chaque ligne porte son horizon (le relief le plus haut déjà rencontré, qui
// descend de la pente du soleil à chaque pas) et la distance au point qui fait l'ombre. Chaque case reçoit son état,
// en quaternaire :
//     vrai      au-dessus de l'horizon : éclairée
//     faux      sous l'horizon, au-delà de la pénombre (ou tournée à l'opposé du soleil) : l'ombre pleine
//     variable  dans la pénombre : sa densité (la part de lumière) ; la pénombre s'élargit avec la distance au point
//               qui fait l'ombre (un soleil n'est pas un point) : nette au pied d'un rocher, floue loin derrière
//     inconnu   une ligne pas encore refaite depuis que le soleil a bougé
// Chaque case est vue deux fois (un tour pour l'horizon, un tour pour l'écrire), au lieu de dix-sept sondages vers le
// soleil ; chaque ligne n'écrit que ses cases : les lignes vont en bandes.
constante ETAT = 5242880;          // @2[ETAT + z·G + x] : l'état de la case (0 inconnu, 1 faux, 2 vrai, 3 variable)
constante COMPTE = 5505024;        // @2[COMPTE + 4 n + e] : le nombre de cases de la ligne n dans l'état e
// 0.79 : la pente de chaque case, calculée une fois (le relief ne bouge pas) : -gx, -gz (signés) et la longueur de la
// normale (-gx, 512, -gz)
constante NX = 5767168;
constante NZ = 6029312;
constante NL = 6291456;
constante NUNIT = 8388608;         // @2[NUNIT + cell] : 0.804, la normale unitaire en un mot (sur 4096 : x + 8192 << 28 |
                                   // y << 14 | z + 8192) : le balayage n'a plus de division à faire
constante INVW = 8650752;          // @2[INVW + d] : 0.804, 128 · 65536 / (12 + 6 d) : la pénombre sans division

fonction preparer_normales() {
    pour z dans 0..G en bandes {
        pour x dans 0..G {
            soit gx = hauteur_en(x + 1, z) - hauteur_en(x + G - 1, z);    // signés
            soit gz = hauteur_en(x, z + 1) - hauteur_en(x, z + G - 1);
            @2[NX + z * G + x] = 0 - gx;
            @2[NZ + z * G + x] = 0 - gz;
            soit lg_ = racine_entiere(gx * gx + 262144 + gz * gz);
            @2[NL + z * G + x] = lg_;
            soit ux_ = ((0 - gx) * 4096) ./ lg_;
            soit uy_ = 512 * 4096 / lg_;
            soit uz_ = ((0 - gz) * 4096) ./ lg_;
            @2[NUNIT + z * G + x] = ((ux_ + 8192) << 28) | (uy_ << 14) | (uz_ + 8192);
        }
    }
}

// ------------------------------------------------------------------- 0.80 : l'ombre et la lumière ensemble
// L'ombre n'est plus un aplat : chaque case reçoit une seule lumière, de 256 au noir, faite de plusieurs sources :
//     le soleil   direct, là où il touche (la pente face à lui, adoucie par la pénombre)
//     le ciel     selon l'heure (bleuté de jour, faible la nuit) et selon l'ouverture de la case au ciel (un creux en
//                 voit peu, un sommet le voit tout)
//     le renvoi   la lumière que renvoie le sol éclairé, 0.802 : par la pyramide de cubes (la diffusion) : la carte de
//                 ce que chaque case renvoie, moyennée par blocs de 2, 4, 8 et 16 cases ; chaque case lit les quatre
//                 niveaux autour d'elle : le renvoi vient de toutes les directions, et baisse en s'éloignant du sol
//                 éclairé ; il arrive par la part du ciel que le relief cache (une case à découvert n'en reçoit guère,
//                 un creux ou le pied d'une paroi beaucoup) : l'ombre est claire près de son bord, sombre loin dedans
//     les feux    des feux de camp, une forge, des lanternes, dans les creux : leur lumière baisse avec la distance et
//                 passe ou non le relief, en quaternaire (leur ombre a sa pénombre comme celle du soleil)
// L'état de la case vient de la lumière reçue : vrai, une source la touche en plein (le coin blanc du cube) ; faux,
// presque rien n'arrive (le coin noir) ; variable, tout le gris entre les deux, l'ombre éclairée par le ciel et les
// renvois (à la fois dans l'ombre et dans la lumière) ; inconnu, pas encore refait.
constante OMBRE = 7471104;         // @2[OMBRE + cell] : la lumière de l'astre (0 à 256) << 2 | l'état (1 faux, 2 vrai, 3 variable)
constante FEUR = 8651776;          // @2[FEUR + cell] : ce que la case renvoie de la lumière des feux (fixe)
constante TEINTES = 8913920;       // le ciel (r, g, b), l'astre (r, g, b), les feux allumés : pour le calque
constante OUV = 6553600;           // @2[OUV + cell] : l'ouverture au ciel (256 : tout le ciel)
constante FEU = 6815744;           // @2[FEU + cell] : la lumière des feux (r << 32 | g << 16 | b), et 1 << 60 : un foyer
constante PYR1 = 7340032;          // la pyramide des renvois : des sommes de 4, 16, 64 et 256 cases (16 bits par voie)
constante PYR2 = 7405568;
constante PYR3 = 7421952;
constante PYR4 = 7426048;
constante RV1 = 7733248;           // le renvoi redescendu de la pyramide (en seizièmes) : 256², 128², 64², 32²
constante RV2 = 7798784;
constante RV3 = 7815168;
constante RV4 = 7819264;
constante FOYERS = 7962624;        // les feux : x, z, hauteur de la flamme, r, g, b (6 mots chacun)
constante REGLES = 7962700;        // @2[REGLES] : 1 si les feux sont allumés
constante DIRS = 7962710;          // les huit directions (dx, dz), signées
constante NFEUX = 8;
constante RAYON = 40;              // la portée d'un feu, en cases
constante NOIR = 24;               // sous cette lumière (moyenne des trois voies), la case est faux : noire

// l'ouverture au ciel : dans huit directions, la plus haute pente vers le relief voisin (à 3, 6, 12 et 24 cases) ; le
// ciel caché par une pente de tangente t est t² / (1 + t²) (le ciel pondéré par l'angle) ; calculée une fois
fonction preparer_ouverture() {
    pour oz dans 0..G en bandes {
        pour ox dans 0..G {
            soit oh = @2[HAUT + oz * G + ox];
            soit occ = 0;
            pour dir dans 0..8 {
                soit ux = @2[DIRS + 2 * dir];
                soit uz = @2[DIRS + 2 * dir + 1];
                soit pas = 256;
                si (dir & 1) == 1 {
                    pas = 362;
                }
                soit m = 0;
                soit d = 3;
                tantque d < 40 {
                    soit e = hauteur_en(ox + ux * d, oz + uz * d) - oh;
                    si e .> 0 {
                        soit t = e * 256 / (d * pas);
                        si t > m {
                            m = t;
                        }
                    }
                    d = d * 2;
                }
                occ = occ + m * m * 256 / (m * m + 65536);
            }
            soit ouv = 256 - occ / 8;
            si ouv < 16 {
                ouv = 16;
            }
            @2[OUV + oz * G + ox] = ouv;
        }
    }
}

// les feux : dans les creux et les replats bas (là où l'on campe), loin les uns des autres, choisis par la hache (les
// mêmes partout) ; trois sortes : le feu de camp, la forge, la lanterne
fonction preparer_feux() {
    soit n = 0;
    soit k = 0;
    tantque n < NFEUX && k < 4096 {
        soit fx = hache(k * 31 + 5, k * 17 + 3) & MASQUE;
        soit fz = hache(k * 13 + 11, k * 29 + 7) & MASQUE;
        soit fh = hauteur_en(fx, fz);
        soit gx = @2[NX + fz * G + fx];
        soit gz = @2[NZ + fz * G + fx];
        si gx .< 0 {
            gx = 0 - gx;
        }
        si gz .< 0 {
            gz = 0 - gz;
        }
        soit bon = 0;
        si fh < 14000 && gx + gz < 500 {
            bon = 1;
        }
        pour q dans 0..n {
            soit ax = (fx + G - @2[FOYERS + 6 * q]) & MASQUE;
            soit az2 = (fz + G - @2[FOYERS + 6 * q + 1]) & MASQUE;
            si ax > G / 2 {
                ax = G - ax;
            }
            si az2 > G / 2 {
                az2 = G - az2;
            }
            si ax < 60 && az2 < 60 {
                bon = 0;
            }
        }
        si bon == 1 {
            soit f = FOYERS + 6 * n;
            @2[f] = fx;
            @2[f + 1] = fz;
            @2[f + 2] = fh + 768;
            soit sorte = n % 3;
            si sorte == 0 {
                @2[f + 3] = 1115;
                @2[f + 4] = 612;
                @2[f + 5] = 262;
            } sinon si sorte == 1 {
                @2[f + 3] = 955;
                @2[f + 4] = 337;
                @2[f + 5] = 150;
            } sinon {
                @2[f + 3] = 638;
                @2[f + 4] = 538;
                @2[f + 5] = 375;
            }
            n = n + 1;
        }
        k = k + 1;
    }
    @2[REGLES] = 1;
}

// la lumière des feux, une fois (le relief et les feux ne bougent pas) : pour chaque case à portée, la valeur dégressive
// depuis le feu (nulle à RAYON cases), le relief entre les deux (la ligne de vue depuis la flamme : sa plus grande
// marge sous le relief, en quaternaire : passe, coupée, ou la pénombre entre les deux) et la pente face au feu
fonction eclairer_feux() {
    pour vz dans 0..G en bandes {
        pour vx dans 0..G {
            soit cell = vz * G + vx;
            soit hc = @2[HAUT + cell];
            soit lr = 0;
            soit lg = 0;
            soit lb = 0;
            soit foyer = 0;
            pour f dans 0..NFEUX {
                soit fb = FOYERS + 6 * f;
                soit fx = @2[fb];
                soit fz = @2[fb + 1];
                soit hs = @2[fb + 2];
                soit ddx = ((vx + G + G / 2 - fx) & MASQUE) - G / 2;     // signé
                soit ddz = ((vz + G + G / 2 - fz) & MASQUE) - G / 2;
                si ddx .< RAYON && ddx .> 0 - RAYON && ddz .< RAYON && ddz .> 0 - RAYON {
                    soit d2 = ddx * ddx + ddz * ddz;
                    si d2 < RAYON * RAYON {
                        si d2 <= 2 {
                            foyer = 1;
                        }
                        soit dd = racine_entiere(d2 * 65536);
                        soit reste_d = RAYON * 256 - dd;
                        soit att = reste_d * reste_d / (RAYON * RAYON * 256);
                        soit adx = ddx;
                        si ddx .< 0 {
                            adx = 0 - ddx;
                        }
                        soit adz = ddz;
                        si ddz .< 0 {
                            adz = 0 - ddz;
                        }
                        soit nmax = adx;
                        si adz > nmax {
                            nmax = adz;
                        }
                        soit vis = 256;
                        soit face = 256;
                        si nmax > 1 {
                            soit cible = hc + 128;
                            soit pire = 0 - 1000000000;
                            pour t dans 1..nmax {
                                soit sx = fx + (ddx * t) ./ nmax;
                                soit sz = fz + (ddz * t) ./ nmax;
                                soit hy = hs + ((cible - hs) * t) ./ nmax;
                                soit m = hauteur_en(sx, sz) - hy;
                                si m .> pire {
                                    pire = m;
                                }
                            }
                            si pire .>= 160 {
                                vis = 0;
                            } sinon si pire .> 0 - 160 {
                                vis = 256 - ((pire + 160) * 128) ./ 160;
                            }
                            // la pente face au feu : la normale contre la direction de la case vers la flamme
                            soit wx = (0 - ddx) * 256;
                            soit wz = (0 - ddz) * 256;
                            soit wy = hs - hc;
                            soit pd = @2[NX + cell] * wx + 512 * wy + @2[NZ + cell] * wz;
                            face = 0;
                            si pd .> 0 {
                                soit lv = racine_entiere(wx * wx + wy * wy + wz * wz);
                                face = (pd ./ @2[NL + cell]) * 256 ./ lv;
                                si face > 256 {
                                    face = 256;
                                }
                            }
                        }
                        soit part = att * vis / 256 * face / 256;
                        lr = lr + @2[fb + 3] * part / 256;
                        lg = lg + @2[fb + 4] * part / 256;
                        lb = lb + @2[fb + 5] * part / 256;
                    }
                }
            }
            si lr > 4095 {
                lr = 4095;
            }
            si lg > 4095 {
                lg = 4095;
            }
            si lb > 4095 {
                lb = 4095;
            }
            @2[FEU + cell] = (foyer << 60) | (lr << 32) | (lg << 16) | lb;
            // 0.804 : ce que la case renvoie de la lumière des feux (fixe : préparé une fois)
            soit alb = @2[ALB + cell];
            soit fr = ((alb >> 16) & 255) * lr / 256;
            soit fg = ((alb >> 8) & 255) * lg / 256;
            soit fb2 = (alb & 255) * lb / 256;
            si fr > 255 {
                fr = 255;
            }
            si fg > 255 {
                fg = 255;
            }
            si fb2 > 255 {
                fb2 = 255;
            }
            @2[FEUR + cell] = (fr << 32) | (fg << 16) | fb2;
        }
    }
}

// ----------------------------------------------------------------- 0.804 : la lumière en calque
// Le décor fixe se prépare une fois (la couleur propre, l'ouverture au ciel, la lumière des feux et ce qu'ils
// renvoient). Quand l'astre bouge, on ne refait que le calque d'ombre (le balayage : l'état quaternaire de chaque case
// et la lumière de l'astre qu'elle reçoit, dans OMBRE), puis la pyramide du renvoi. La couleur finale est posée au
// moment de peindre (teinte), seulement sur les cases que l'œil voit.

// la pyramide de cubes : le premier niveau somme ce que renvoient 2 × 2 cases (l'astre et les feux, sur la couleur
// propre ; un seul rebond) ; chaque niveau somme 2 × 2 blocs du niveau d'en dessous (les voies tiennent dans 16 bits :
// au plus 255 × 256) ; puis la redescente. 0.806 : le premier niveau et la redescente sur l'équipe du vergobret
fonction construire_pyramide() {
    soit sr = @2[TEINTES + 3];
    soit sg = @2[TEINTES + 4];
    soit sb = @2[TEINTES + 5];
    soit feux = @2[TEINTES + 6];
    pour qz dans 0..256 en bandes {
        pour qx dans 0..256 {
            soit c0 = 2 * qz * G + 2 * qx;
            soit somme = 0;
            pour k dans 0..4 {
                soit c = c0 + (k & 1) + (k >> 1) * G;
                soit d = @2[OMBRE + c] >> 2;
                soit alb = @2[ALB + c];
                soit fr = @2[FEUR + c] * feux;
                soit or_ = ((alb >> 16) & 255) * (d * sr / 256) / 256 + ((fr >> 32) & 65535);
                soit og = ((alb >> 8) & 255) * (d * sg / 256) / 256 + ((fr >> 16) & 65535);
                soit ob = (alb & 255) * (d * sb / 256) / 256 + (fr & 65535);
                si or_ > 255 {
                    or_ = 255;
                }
                si og > 255 {
                    og = 255;
                }
                si ob > 255 {
                    ob = 255;
                }
                somme = somme + ((or_ << 32) | (og << 16) | ob);
            }
            @2[PYR1 + qz * 256 + qx] = somme;
        }
    }
    reduire(PYR1, PYR2, 128);
    reduire(PYR2, PYR3, 64);
    reduire(PYR3, PYR4, 32);
    // la redescente : chaque niveau reçoit le niveau d'au-dessus, mêlé (bilinéaire), plus sa propre moyenne pondérée
    // (les plus proches comptent plus : 96, 80, 64, 64 sur 256), en seizièmes ; à la fin, RV1 (256²) dit le renvoi
    // autour de chaque bloc de 2 × 2 cases
    pour hz dans 0..32 {
        pour hx dans 0..32 {
            soit q4 = @2[PYR4 + hz * 32 + hx];
            @2[RV4 + hz * 32 + hx] = (((q4 >> 32) & 65535) / 64 << 32) | (((q4 >> 16) & 65535) / 64 << 16) | ((q4 & 65535) / 64);
        }
    }
    descendre(RV4, PYR3, RV3, 64, 1, 16);
    descendre(RV3, PYR2, RV2, 128, 5, 16);
    descendre(RV2, PYR1, RV1, 256, 3, 2);
}

// un niveau de la redescente : le niveau d'au-dessus (n / 2 blocs) mêlé, plus la somme du niveau · num / den
fonction descendre(dessus, somme, dessous, n, num, den) {
    pour dz dans 0..n en bandes {
        pour dx dans 0..n {
            soit up = lire_niveau(dessus, n / 2, 1, dx, dz);
            soit sm = @2[somme + dz * n + dx];
            soit vr = ((up >> 32) & 65535) + ((sm >> 32) & 65535) * num / den;
            soit vg = ((up >> 16) & 65535) + ((sm >> 16) & 65535) * num / den;
            soit vb = (up & 65535) + (sm & 65535) * num / den;
            @2[dessous + dz * n + dx] = (vr << 32) | (vg << 16) | vb;
        }
    }
}

fonction reduire(dessous, dessus, n) {
    pour rz dans 0..n {
        pour rx dans 0..n {
            soit s0 = dessous + 4 * rz * n + 2 * rx;
            @2[dessus + rz * n + rx] = @2[s0] + @2[s0 + 1] + @2[s0 + 2 * n] + @2[s0 + 2 * n + 1];
        }
    }
}

// une carte de nn × nn blocs lue à la case (x, z) d'une carte 2^l fois plus fine, en mêlant ses quatre blocs voisins
// (bilinéaire, en 1/256, sur le tore) : les trois voies (r << 32 | g << 16 | b)
fonction lire_niveau(base, nn, l, x, z) {
    soit mk = nn - 1;
    soit u = ((x * 256 + 128) >> l) + nn * 256 - 128;
    soit v = ((z * 256 + 128) >> l) + nn * 256 - 128;
    soit ix = (u >> 8) & mk;
    soit iz = (v >> 8) & mk;
    soit ix1 = (ix + 1) & mk;
    soit iz1 = (iz + 1) & mk;
    soit tx = u & 255;
    soit tz = v & 255;
    soit pa = @2[base + iz * nn + ix];
    soit pb = @2[base + iz * nn + ix1];
    soit pc = @2[base + iz1 * nn + ix];
    soit pd = @2[base + iz1 * nn + ix1];
    soit wa = (256 - tx) * (256 - tz);
    soit wb = tx * (256 - tz);
    soit wc = (256 - tx) * tz;
    soit wd = tx * tz;
    soit vr = (((pa >> 32) & 65535) * wa + ((pb >> 32) & 65535) * wb + ((pc >> 32) & 65535) * wc + ((pd >> 32) & 65535) * wd) >> 16;
    soit vg = (((pa >> 16) & 65535) * wa + ((pb >> 16) & 65535) * wb + ((pc >> 16) & 65535) * wc + ((pd >> 16) & 65535) * wd) >> 16;
    soit vb = ((pa & 65535) * wa + (pb & 65535) * wb + (pc & 65535) * wc + (pd & 65535) * wd) >> 16;
    retour (vr << 32) | (vg << 16) | vb;
}

// le calque d'ombre, par balayage : l'horizon de la ligne (l'ombre du cube), et pour chaque case la lumière de l'astre
// qu'elle reçoit (la pente face à lui, adoucie par la pénombre) et son état : vrai (en plein), variable (la pénombre,
// avec sa densité), faux (rien) ; trois mots lus par case au plus, un écrit, aucune division
fonction eclairer_lignes(n0, n1, az, el) {
    // la nuit, la lune prend le relais : à l'opposé du soleil, aussi haute qu'il est bas, faible et bleutée ; elle a son
    // ombre, faite par le même balayage
    soit se_vrai = sin1024(el);
    soit l_az = az;
    soit l_el = el;
    soit lune = 0;
    si se_vrai .< 0 {
        lune = 1;
        l_az = (az + 512) & 1023;
        l_el = 0 - el;
    }
    soit se = sin1024(l_el);
    soit ce = cos1024(l_el);
    soit sa = sin1024(l_az);
    soit ca = cos1024(l_az);
    soit lx = (ce * sa) ./ 65536;          // la direction de l'astre, en 1/65536
    soit lz = (ce * ca) ./ 65536;
    soit ly = se;
    // la lumière du soleil : blanche haut dans le ciel, orangée au ras de l'horizon ; gardée pour le calque
    soit chaud = 256;
    si se .< 30000 {
        chaud = 96 + se * 160 / 30000;
        si se .< 0 {
            chaud = 96;
        }
    }
    soit sr = 255;
    soit sg = 150 + chaud * 100 / 256;
    soit sb = 90 + chaud * 160 / 256;
    si lune == 1 {
        sr = 60;
        sg = 72;
        sb = 104;
    }
    @2[TEINTES + 3] = sr;
    @2[TEINTES + 4] = sg;
    @2[TEINTES + 5] = sb;
    // la descente du rayon, par case, en 1/256 d'unité : 256 · tan(el)
    soit montee = 0;
    si se .> 0 && ce .> 0 {
        montee = se * 256 / ce;
    }
    // la direction où va la lumière : (-sa, -ca) ; l'axe dominant avance d'une case à chaque pas, l'autre de dmin
    // (en 1/65536 de case)
    soit asa = sa;
    si sa .< 0 {
        asa = 0 - sa;
    }
    soit aca = ca;
    si ca .< 0 {
        aca = 0 - ca;
    }
    soit axe_x = 0;
    si asa >= aca {
        axe_x = 1;
    }
    soit dmaj = 1;
    soit dmin = 0;
    si axe_x == 1 {
        si sa .> 0 {
            dmaj = 0 - 1;
        }
        dmin = ((0 - ca) * 65536) ./ asa;
    } sinon {
        si ca .> 0 {
            dmaj = 0 - 1;
        }
        dmin = ((0 - sa) * 65536) ./ aca;
    }
    // la longueur d'un pas (en 1/65536 de case), et la descente du rayon sur un pas
    soit longueur = racine_entiere(65536 * 65536 + dmin * dmin);
    soit chute = montee * longueur / 65536;
    pour n dans n0..n1 en bandes {
        soit ligne = n & MASQUE;
        soit horizon = 0 - 1000000000;
        soit docc = 0;
        soit nv = 0;
        soit nf = 0;
        soit nvar = 0;
        pour i dans 0..(2 * G) {
            soit maj = (i * dmaj) & MASQUE;
            soit mino = (((ligne << 16) + i * dmin) .>> 16) & MASQUE;
            soit x = maj;
            soit z = mino;
            si axe_x == 0 {
                x = mino;
                z = maj;
            }
            soit cell = z * G + x;
            soit h = @2[HAUT + cell];
            horizon = horizon - chute;
            docc = docc + 1;
            si i >= G {
                // la pente face à l'astre : la normale unitaire (gardée depuis la préparation) contre sa direction
                soit nu = @2[NUNIT + cell];
                soit dot = (((nu >> 28) & 16383) - 8192) * lx + ((nu >> 14) & 16383) * ly + ((nu & 16383) - 8192) * lz;
                soit diffus = 0;
                si dot .> 0 {
                    diffus = dot >> 20;
                }
                si diffus > 256 {
                    diffus = 256;
                }
                // l'astre vu : la marge sous l'horizon, rapportée à la demi-largeur de la pénombre (plus large loin du
                // point qui fait l'ombre)
                soit marge = horizon - h;
                soit dc = docc;
                si dc > 1023 {
                    dc = 1023;
                }
                soit w = 12 + dc * 6;
                soit lumiere = 256;
                si se .<= 0 || diffus == 0 {
                    lumiere = 0;
                } sinon si marge .>= w {
                    lumiere = 0;
                } sinon si marge .> 0 - w {
                    lumiere = 256 - (((marge + w) * @2[INVW + dc]) >> 16);
                }
                soit direct = diffus * lumiere / 256;
                soit etat = 1;
                si direct > 0 {
                    etat = 3;
                    si lumiere == 256 {
                        etat = 2;
                    }
                }
                @2[OMBRE + cell] = (direct << 2) | etat;
                si etat == 2 {
                    nv = nv + 1;
                } sinon si etat == 1 {
                    nf = nf + 1;
                } sinon {
                    nvar = nvar + 1;
                }
            }
            si h .> horizon {
                horizon = h;
                docc = 0;
            }
        }
        @2[COMPTE + 4 * ligne] = 0;
        @2[COMPTE + 4 * ligne + 1] = nf;
        @2[COMPTE + 4 * ligne + 2] = nv;
        @2[COMPTE + 4 * ligne + 3] = nvar;
    }
}

// le calque posé sur une case, au moment de la peindre : sa couleur propre sous le ciel (selon son ouverture), l'astre
// (le calque d'ombre), les feux, et le renvoi (la carte redescendue de la pyramide, mêlée autour de la case, reçue par
// la part du ciel que le relief cache, plus un fond)
fonction teinte(cell, px, pz) {
    soit fe = 0;
    si @2[TEINTES + 6] == 1 {
        fe = @2[FEU + cell];
        si (fe >> 60) == 1 {
            // le foyer lui-même : la flamme
            retour 0xFFFFC0;
        }
    }
    soit alb = @2[ALB + cell];
    soit d = @2[OMBRE + cell] >> 2;
    soit ouv = @2[OUV + cell];
    soit rv = lire_niveau(RV1, 256, 1, px, pz);
    soit recu = 128 + (256 - ouv) * 2;
    soit tr = @2[TEINTES] * ouv / 256 + d * @2[TEINTES + 3] / 256 + ((fe >> 32) & 65535) + ((rv >> 32) & 65535) * recu / 4096;
    soit tg = @2[TEINTES + 1] * ouv / 256 + d * @2[TEINTES + 4] / 256 + ((fe >> 16) & 65535) + ((rv >> 16) & 65535) * recu / 4096;
    soit tb = @2[TEINTES + 2] * ouv / 256 + d * @2[TEINTES + 5] / 256 + (fe & 65535) + (rv & 65535) * recu / 4096;
    soit qr = ((alb >> 16) & 255) * tr / 256;
    soit qg = ((alb >> 8) & 255) * tg / 256;
    soit qb = (alb & 255) * tb / 256;
    si qr > 255 {
        qr = 255;
    }
    si qg > 255 {
        qg = 255;
    }
    si qb > 255 {
        qb = 255;
    }
    retour qr * 65536 + qg * 256 + qb;
}

// toute la lumière qui dépend de l'astre (le ciel de l'heure, le calque d'ombre, la pyramide du renvoi), dans l'image
// même où elle change
fonction eclairer_tout(az, el) {
    soit se_vrai = sin1024(el);
    soit jour = 256;
    si se_vrai .< 16000 {
        jour = 0;
        si se_vrai .> 0 - 6000 {
            jour = (se_vrai + 6000) * 256 / 22000;
        }
    }
    @2[TEINTES] = 8 + 52 * jour / 256;
    @2[TEINTES + 1] = 11 + 57 * jour / 256;
    @2[TEINTES + 2] = 24 + 60 * jour / 256;
    @2[TEINTES + 6] = @2[REGLES];
    eclairer_lignes(0, G, az, el);
    construire_pyramide();
}

fonction preparer_tables() {
    // le sinus en entiers (la formule de Bhaskara, à 0,2 % près) : les mêmes nombres sur toutes les machines et dans
    // tous les langages (un sinus en flottants pourrait différer d'un arrondi)
    pour a dans 0..1024 {
        soit u = a & 511;
        soit v = 4 * u * (512 - u) * 65536 / (327680 - u * (512 - u));
        si a >= 512 {
            @2[SINUS + a] = 0 - v;
        } sinon {
            @2[SINUS + a] = v;
        }
    }
    // les pas d'un rayon : serrés près de l'œil, de plus en plus longs au loin
    soit dist = 256;
    pour k dans 0..NPAS {
        @2[DIST + k] = dist;
        @2[INV + k] = 65536 * ECHELLE * 256 / dist;
        soit brume = k * k * 256 / (NPAS * NPAS);
        @2[BRUME + k] = brume;
        dist = dist + 64 + dist / 60;
    }
    // 0.804 : la pénombre sans division
    pour d dans 0..1024 {
        @2[INVW + d] = 128 * 65536 / (12 + 6 * d);
    }
    // 0.80 : les huit directions (dx, dz) : est, sud-est, sud, sud-ouest, ouest, nord-ouest, nord, nord-est
    @2[DIRS] = 1;
    @2[DIRS + 1] = 0;
    @2[DIRS + 2] = 1;
    @2[DIRS + 3] = 1;
    @2[DIRS + 4] = 0;
    @2[DIRS + 5] = 1;
    @2[DIRS + 6] = 0 - 1;
    @2[DIRS + 7] = 1;
    @2[DIRS + 8] = 0 - 1;
    @2[DIRS + 9] = 0;
    @2[DIRS + 10] = 0 - 1;
    @2[DIRS + 11] = 0 - 1;
    @2[DIRS + 12] = 0;
    @2[DIRS + 13] = 0 - 1;
    @2[DIRS + 14] = 1;
    @2[DIRS + 15] = 0 - 1;
}

// ------------------------------------------------------------------------------------------------------- l'image
constante CIEL_HAUT = 0x5A7CB4;
constante CIEL_BAS = 0xC8D6E6;

fonction profond(c) {
    retour rgb((c >> 16) & 255, (c >> 8) & 255, c & 255);
}

// la couleur c fondue vers la brume (part sur 256) ; 0.80 : la couleur de la brume suit l'heure (@2[BRUMEC], 3 mots)
constante BRUMEC = 7962730;
fonction embrume(c, part) {
    soit r = ((c >> 16) & 255) * (256 - part) + @2[BRUMEC] * part;
    soit g = ((c >> 8) & 255) * (256 - part) + @2[BRUMEC + 1] * part;
    soit b = (c & 255) * (256 - part) + @2[BRUMEC + 2] * part;
    retour rgb(r / 256, g / 256, b / 256);
}

// une image : l'œil en (cx, cz) (en 1/65536 de case), à la hauteur ch (en 1/256), regardant vers l'angle a (sur 1024),
// l'horizon à la ligne hor
fonction rendre(cx, cz, ch, a, hor, az, el) {
    // 0.78 : chaque point de l'écran est écrit une seule fois (avant : tout le ciel d'abord, puis le relief par-dessus) :
    // les couleurs du ciel, rangée par rangée, dans une table ; chaque colonne peint son relief, puis son ciel au-dessus
    soit se = sin1024(el);
    soit soir = 0;
    si se .< 24000 {
        soir = 160 - se * 160 / 24000;
        si se .< 0 {
            soir = 160;
        }
    }
    // 0.80 : la nuit : le ciel et la brume s'assombrissent quand le soleil passe sous l'horizon
    soit nuit = 0;
    si se .< 4000 {
        nuit = 220;
        si se .> 0 - 6000 {
            nuit = (4000 - se) * 220 / 10000;
        }
    }
    @2[BRUMEC] = 200 * (256 - nuit) / 256 + nuit / 22;
    @2[BRUMEC + 1] = 214 * (256 - nuit) / 256 + nuit / 16;
    @2[BRUMEC + 2] = 230 * (256 - nuit) / 256 + nuit / 7;
    pour y dans 0..H {
        soit t = y * 256 / H;
        soit r = (0x5A * (256 - t) + (0xC8 + soir * 55 / 160) * t) / 256;
        soit g = (0x7C * (256 - t) + (0xD6 - soir * 40 / 160) * t) / 256;
        soit b = (0xB4 * (256 - t) + (0xE6 - soir * 110 / 160) * t) / 256;
        r = r * (256 - nuit) / 256 + nuit / 40;
        g = g * (256 - nuit) / 256 + nuit / 30;
        b = b * (256 - nuit) / 256 + nuit / 12;
        @2[CIEL + y] = rgb(r, g, b);
    }
    // le disque du soleil, s'il est dans le champ (60 degrés : 85 sur 1024 de chaque côté) : son centre (sx, sy)
    soit sx = 0;
    soit sy = 0;
    soit soleil_vu = 0;
    // 0.801 : la nuit, la lune (à l'opposé du soleil, plus petite et pâle)
    soit astre_az = az;
    soit astre_el = el;
    soit astre_c = rgb(255, 245, 220);
    soit rayon2 = 455;
    si se .< 0 {
        astre_az = (az + 512) & 1023;
        astre_el = 0 - el;
        astre_c = rgb(225, 230, 245);
        rayon2 = 213;
    }
    soit ase = sin1024(astre_el);
    soit ecart_s = (astre_az - a + 512) & 1023;
    si ecart_s > 512 - 85 && ecart_s < 512 + 85 && ase .> 0 {
        sx = W / 2 + (ecart_s - 512) * (W / 2) ./ 85;
        soit sy_haut = ase * ECHELLE ./ cos1024(astre_el);
        si sy_haut < hor + 53 {
            sy = hor - sy_haut;
            soleil_vu = 1;
        }
    }
    soit sa = @2[SINUS + (a & 1023)];
    soit ca = @2[SINUS + ((a + 256) & 1023)];
    // les colonnes en segments : chaque cylindre (un cœur) peint ses colonnes, aucune n'écrit chez une autre
    pour x dans 0..W en bandes {
        // la direction du rayon de la colonne : l'axe de la vue, plus un écart à droite (un champ de 60 degrés)
        soit ecart = x * 2 * 37837 / W;                 // tan(30°) · 65536 = 37837, de -1 à +1 fois cela
        // dir = avant + (ecart - 37837) · droite, avec avant = (sin a, cos a), droite = (cos a, -sin a)
        soit e = ecart - 37837;                          // signé (deux compléments)
        soit dx = sa + (e * ca) ./ 65536;
        soit dz = ca - (e * sa) ./ 65536;
        soit haut = H;
        soit k = 0;
        tantque k < NPAS && haut > 0 {
            soit dist = @2[DIST + k];
            soit px = (cx + (dx * dist) ./ 256) >> 16;
            soit pz = (cz + (dz * dist) ./ 256) >> 16;
            soit cell = (pz & MASQUE) * G + (px & MASQUE);
            soit h = @2[HAUT + cell];
            soit inv = @2[INV + k];
            // la ligne à l'écran : hor + (ch - h) · inv
            soit ys = 0;
            soit dessus = ch * inv / 16777216;
            soit dessous = h * inv / 16777216;
            si hor + dessus > dessous {
                ys = hor + dessus - dessous;
            }
            si ys < haut {
                soit cc = embrume(teinte(cell, px & MASQUE, pz & MASQUE), @2[BRUME + k]);
                pour yy dans ys..haut {
                    @1[yy * W + x] = cc;
                }
                haut = ys;
            }
            k = k + 1;
        }
        // le ciel au-dessus du relief, et le disque du soleil là où il se voit
        soit ex = x - sx;
        pour yc dans 0..haut {
            soit pc = @2[CIEL + yc];
            si soleil_vu == 1 && (ex .< DISQUE && ex .> 0 - DISQUE) {
                soit ey = yc - sy;
                si ey .< DISQUE && ey .> 0 - DISQUE && ex * ex + ey * ey < rayon2 {
                    pc = astre_c;
                }
            }
            @1[yc * W + x] = pc;
        }
    }
}
