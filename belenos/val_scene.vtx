// machine : lugus
// Belenos : « Le val des neiges », la scène (sans programme principal) : val.vtx la parcourt, val_banc.vtx la mesure.
// 0.72 : le soleil qu'on fait tourner (o / p) et monter (i / k), la lumière selon la pente face au soleil et les ombres
// portées (l'ombre du relief projetée depuis le soleil, avec sa pénombre), recalculées par bandes quand le soleil bouge
// (le tapis roulant : chaque image ne paie que sa bande) ; le ciel et le disque du soleil ; le compteur de l'image.
// Un relief vallonné de pentes variées (une grille de 512 × 512 hauteurs, du bruit sur cinq octaves), la neige au-dessus
// d'une altitude et sur les pentes douces, la roche sur les pentes fortes, l'herbe en bas ; le ciel et la brume du loin.
// Chaque image : chaque colonne lance un rayon qui avance du plus près au plus loin et peint de bas en haut ce qu'il
// découvre (le tampon de hauteur de la colonne : rien n'est peint deux fois). Tout en entiers : les mêmes nombres partout.
//     vtx toile128 belenos/val.vtx         (flèches : avancer, tourner ; a / q : monter, descendre ; o / p : tourner le
//                                           soleil ; i / k : le monter, le descendre ; Échap : finir)
// Sans fenêtre (les essais) : --scenario rejoue des touches, et la scène s'arrête à Échap.

constante W = 480;                 // l'image
constante H = 270;
constante G = 512;                 // la grille du relief : G × G cases (elle se répète : on marche sans bord)
constante MASQUE = 511;
constante HAUT = 1048576;          // @2[HAUT + z·G + x] : la hauteur, en 1/256 d'unité
constante COUL = 2097152;          // @2[COUL + z·G + x] : la couleur (le point profond, éclairé)
constante SINUS = 3145728;         // @2[SINUS + a] : 65536 · sin(2π a / 1024), en entier signé (deux compléments)
constante INV = 3146752;           // @2[INV + k] : 65536 · ECHELLE / distance(k)
constante DIST = 3147264;          // @2[DIST + k] : la distance du pas k, en 1/256 d'unité
constante BRUME = 3147776;         // @2[BRUME + k] : la part de brume du pas k (sur 256)
constante YBUF = 3148288;          // @2[YBUF + x] : le haut déjà peint de la colonne x
constante CIEL = 3149312;          // @2[CIEL + y] : 0.78, la couleur du ciel à la rangée y
constante ALB = 4194304;           // @2[ALB + z·G + x] : la couleur propre de la case (0xRRGGBB, sans lumière)
constante NPAS = 400;              // les pas d'un rayon
constante BANDE = 16;              // les lignes de la grille éclairées de nouveau à chaque image quand le soleil bouge
constante ECHELLE = 220;           // la hauteur à l'écran d'une unité à une unité de distance

// ------------------------------------------------------------------------------------------------------- le relief
fonction hache(x, z) {
    soit h = (x & MASQUE) * 374761393 + (z & MASQUE) * 668265263 + 1013904223;
    h = (h ^ (h >> 13)) * 1274126177;
    retour (h ^ (h >> 16)) & 65535;
}

// le bruit lisse à la période p (une puissance de deux) : les quatre coins, mêlés en douceur (en 1/65536)
fonction bruit_lisse(x, z, p) {
    soit x0 = x / p;
    soit z0 = z / p;
    soit fx = (x % p) * 256 / p;
    soit fz = (z % p) * 256 / p;
    // la courbe douce : 3t² - 2t³ (sur 256)
    soit sx = fx * fx * (768 - 2 * fx) / 65536;
    soit sz = fz * fz * (768 - 2 * fz) / 65536;
    soit pas_g = G / p;
    soit a = hache(x0 % pas_g, z0 % pas_g);
    soit b = hache((x0 + 1) % pas_g, z0 % pas_g);
    soit c = hache(x0 % pas_g, (z0 + 1) % pas_g);
    soit d = hache((x0 + 1) % pas_g, (z0 + 1) % pas_g);
    soit h1 = (a * (256 - sx) + b * sx) / 256;
    soit h2 = (c * (256 - sx) + d * sx) / 256;
    retour (h1 * (256 - sz) + h2 * sz) / 256;
}

fonction creer_relief() {
    pour z dans 0..G en bandes {
        pour x dans 0..G {
            // cinq octaves : les grandes collines, puis les plis de plus en plus fins
            soit h = bruit_lisse(x, z, 256) * 16 + bruit_lisse(x, z, 128) * 8 + bruit_lisse(x, z, 64) * 4 + bruit_lisse(x, z, 32) * 2
                     + bruit_lisse(x, z, 16);
            // les crêtes plus hautes, les vallées plus douces : la hauteur au carré (le relief de montagne)
            soit n = h / 31;
            // les vallées aplanies sous 20000, les monts au-dessus, en carré : de 0 à 60000 (234 unités)
            soit m = 0;
            si n > 20000 {
                m = (n - 20000) * 2;
            }
            si m > 65535 {
                m = 65535;
            }
            @2[HAUT + z * G + x] = m * m / 65536 * 5 / 2 + n / 6;
        }
    }
}

// l'éclairage et la matière de chaque case : la pente (la différence avec les voisines), l'altitude
fonction peindre_relief() {
    pour z dans 0..G en bandes {
        pour x dans 0..G {
            soit h = @2[HAUT + z * G + x];
            soit hx = @2[HAUT + z * G + ((x + 1) & MASQUE)];
            soit hz = @2[HAUT + ((z + 1) & MASQUE) * G + x];
            soit pente = 0;
            si hx > h { pente = pente + hx - h; } sinon { pente = pente + h - hx; }
            si hz > h { pente = pente + hz - h; } sinon { pente = pente + h - hz; }
            soit r = 70;
            soit g = 110;
            soit b = 60;
            si pente > 700 {
                // la roche des pentes fortes
                r = 110;
                g = 105;
                b = 100;
            } sinon si h > 30000 || (h > 20000 && pente < 260) {
                // la neige : en haut, et sur les replats déjà hauts
                r = 235;
                g = 238;
                b = 245;
            } sinon si h > 12000 {
                // la lande d'altitude
                r = 120;
                g = 115;
                b = 80;
            }
            // un grain : la case n'est pas tout à fait la même que sa voisine
            soit grain = hache(x * 7, z * 13) & 15;
            r = r + grain;
            g = g + grain;
            b = b + grain;
            si r > 255 { r = 255; }
            si g > 255 { g = 255; }
            si b > 255 { b = 255; }
            @2[ALB + z * G + x] = r * 65536 + g * 256 + b;
        }
    }
    preparer_normales();
}

// ------------------------------------------------------------------------------------------------------- le soleil
// le soleil : l'azimut az et la hauteur el (sur 1024 pour un tour) ; sa direction en 1/65536 (signée)
fonction sin1024(a) {
    retour @2[SINUS + (a & 1023)];
}

fonction cos1024(a) {
    retour @2[SINUS + ((a + 256) & 1023)];
}

fonction hauteur_en(x, z) {
    retour @2[HAUT + (z & MASQUE) * G + (x & MASQUE)];
}

// ------------------------------------------------------------------------------------------- l'ombre quaternaire
// 0.79 : l'ombre par balayage (l'ombre du cube projetée par le soleil). La lumière parcourt le relief en lignes
// parallèles, dans la direction où elle va ; chaque ligne porte son horizon (le relief le plus haut déjà rencontré, qui
// descend de la pente du soleil à chaque pas) et la distance au point qui fait l'ombre. Chaque case reçoit son état,
// en quaternaire :
//     vrai      au-dessus de l'horizon : éclairée
//     faux      sous l'horizon, au-delà de la pénombre (ou tournée à l'opposé du soleil) : l'ombre pleine
//     variable  dans la pénombre : sa densité (la part de lumière) ; la pénombre s'élargit avec la distance au point
//               qui fait l'ombre (un soleil n'est pas un point) : nette au pied d'un rocher, floue loin derrière
//     inconnu   une ligne pas encore refaite depuis que le soleil a bougé
// Chaque case est vue deux fois (un tour pour l'horizon, un tour pour l'écrire), au lieu de dix-sept sondages vers le
// soleil ; chaque ligne n'écrit que ses cases : les lignes vont en bandes.
constante ETAT = 5242880;          // @2[ETAT + z·G + x] : l'état de la case (0 inconnu, 1 faux, 2 vrai, 3 variable)
constante COMPTE = 5505024;        // @2[COMPTE + 4 n + e] : le nombre de cases de la ligne n dans l'état e
// 0.79 : la pente de chaque case, calculée une fois (le relief ne bouge pas) : -gx, -gz (signés) et la longueur de la
// normale (-gx, 512, -gz)
constante NX = 5767168;
constante NZ = 6029312;
constante NL = 6291456;

fonction preparer_normales() {
    pour z dans 0..G en bandes {
        pour x dans 0..G {
            soit gx = hauteur_en(x + 1, z) - hauteur_en(x + G - 1, z);    // signés
            soit gz = hauteur_en(x, z + 1) - hauteur_en(x, z + G - 1);
            @2[NX + z * G + x] = 0 - gx;
            @2[NZ + z * G + x] = 0 - gz;
            @2[NL + z * G + x] = racine_entiere(gx * gx + 262144 + gz * gz);
        }
    }
}

fonction eclairer_lignes(n0, n1, az, el) {
    soit se = sin1024(el);
    soit ce = cos1024(el);
    soit sa = sin1024(az);
    soit ca = cos1024(az);
    soit lx = (ce * sa) ./ 65536;          // la direction du soleil, en 1/65536
    soit lz = (ce * ca) ./ 65536;
    soit ly = se;
    // la lumière du soleil : blanche haut dans le ciel, orangée au ras de l'horizon
    soit chaud = 256;
    si se .< 30000 {
        chaud = 96 + se * 160 / 30000;
        si se .< 0 {
            chaud = 96;
        }
    }
    soit sr = 255;
    soit sg = 150 + chaud * 100 / 256;
    soit sb = 90 + chaud * 160 / 256;
    // la descente du rayon, par case, en 1/256 d'unité : 256 · tan(el)
    soit montee = 0;
    si se .> 0 && ce .> 0 {
        montee = se * 256 / ce;
    }
    // la direction où va la lumière : (-sa, -ca) ; l'axe dominant avance d'une case à chaque pas, l'autre de dmin
    // (en 1/65536 de case)
    soit asa = sa;
    si sa .< 0 {
        asa = 0 - sa;
    }
    soit aca = ca;
    si ca .< 0 {
        aca = 0 - ca;
    }
    soit axe_x = 0;
    si asa >= aca {
        axe_x = 1;
    }
    soit dmaj = 1;
    soit dmin = 0;
    si axe_x == 1 {
        si sa .> 0 {
            dmaj = 0 - 1;
        }
        dmin = ((0 - ca) * 65536) ./ asa;
    } sinon {
        si ca .> 0 {
            dmaj = 0 - 1;
        }
        dmin = ((0 - sa) * 65536) ./ aca;
    }
    // la longueur d'un pas (en 1/65536 de case), et la descente du rayon sur un pas
    soit longueur = racine_entiere(65536 * 65536 + dmin * dmin);
    soit chute = montee * longueur / 65536;
    pour n dans n0..n1 en bandes {
        soit ligne = n & MASQUE;
        soit horizon = 0 - 1000000000;
        soit docc = 0;
        soit nv = 0;
        soit nf = 0;
        soit nvar = 0;
        pour i dans 0..(2 * G) {
            soit maj = (i * dmaj) & MASQUE;
            soit mino = (((ligne << 16) + i * dmin) .>> 16) & MASQUE;
            soit x = maj;
            soit z = mino;
            si axe_x == 0 {
                x = mino;
                z = maj;
            }
            soit cell = z * G + x;
            soit h = @2[HAUT + cell];
            horizon = horizon - chute;
            docc = docc + 1;
            si i >= G {
                // la pente face au soleil : la normale (-gx, 512, -gz), gardée depuis la préparation
                soit nl = @2[NL + cell];
                soit pd = @2[NX + cell] * lx + 512 * ly + @2[NZ + cell] * lz;
                soit diffus = 0;
                si pd .> 0 {
                    diffus = pd ./ nl / 256;
                }
                si diffus > 256 {
                    diffus = 256;
                }
                // l'état : la marge sous l'horizon, rapportée à la demi-largeur de la pénombre
                soit marge = horizon - h;
                soit w = 12 + docc * 6;
                soit lumiere = 256;
                soit etat = 2;
                si se .<= 0 || diffus == 0 {
                    lumiere = 0;
                    etat = 1;
                } sinon si marge .>= w {
                    lumiere = 0;
                    etat = 1;
                } sinon si marge .> 0 - w {
                    lumiere = 256 - ((marge + w) * 128) ./ w;
                    etat = 3;
                }
                si etat == 2 {
                    nv = nv + 1;
                } sinon si etat == 1 {
                    nf = nf + 1;
                } sinon {
                    nvar = nvar + 1;
                }
                soit direct = diffus * lumiere / 256;
                soit c = @2[ALB + cell];
                soit r = (c >> 16) & 255;
                soit g = (c >> 8) & 255;
                soit b = c & 255;
                // le ciel (bleuté) partout, le soleil là où il touche
                soit rr = r * (60 + direct * sr / 256) / 256;
                soit gg = g * (68 + direct * sg / 256) / 256;
                soit bb = b * (84 + direct * sb / 256) / 256;
                si rr > 255 { rr = 255; }
                si gg > 255 { gg = 255; }
                si bb > 255 { bb = 255; }
                @2[COUL + cell] = rr * 65536 + gg * 256 + bb;
                @2[ETAT + cell] = etat;
            }
            si h .> horizon {
                horizon = h;
                docc = 0;
            }
        }
        @2[COMPTE + 4 * ligne] = 0;
        @2[COMPTE + 4 * ligne + 1] = nf;
        @2[COMPTE + 4 * ligne + 2] = nv;
        @2[COMPTE + 4 * ligne + 3] = nvar;
    }
}

fonction preparer_tables() {
    // le sinus en entiers (la formule de Bhaskara, à 0,2 % près) : les mêmes nombres sur toutes les machines et dans
    // tous les langages (un sinus en flottants pourrait différer d'un arrondi)
    pour a dans 0..1024 {
        soit u = a & 511;
        soit v = 4 * u * (512 - u) * 65536 / (327680 - u * (512 - u));
        si a >= 512 {
            @2[SINUS + a] = 0 - v;
        } sinon {
            @2[SINUS + a] = v;
        }
    }
    // les pas d'un rayon : serrés près de l'œil, de plus en plus longs au loin
    soit dist = 256;
    pour k dans 0..NPAS {
        @2[DIST + k] = dist;
        @2[INV + k] = 65536 * ECHELLE * 256 / dist;
        soit brume = k * k * 256 / (NPAS * NPAS);
        @2[BRUME + k] = brume;
        dist = dist + 64 + dist / 60;
    }
}

// ------------------------------------------------------------------------------------------------------- l'image
constante CIEL_HAUT = 0x5A7CB4;
constante CIEL_BAS = 0xC8D6E6;

fonction profond(c) {
    retour rgb((c >> 16) & 255, (c >> 8) & 255, c & 255);
}

// la couleur c fondue vers la brume (part sur 256)
fonction embrume(c, part) {
    soit r = ((c >> 16) & 255) * (256 - part) + 200 * part;
    soit g = ((c >> 8) & 255) * (256 - part) + 214 * part;
    soit b = (c & 255) * (256 - part) + 230 * part;
    retour rgb(r / 256, g / 256, b / 256);
}

// une image : l'œil en (cx, cz) (en 1/65536 de case), à la hauteur ch (en 1/256), regardant vers l'angle a (sur 1024),
// l'horizon à la ligne hor
fonction rendre(cx, cz, ch, a, hor, az, el) {
    // 0.78 : chaque point de l'écran est écrit une seule fois (avant : tout le ciel d'abord, puis le relief par-dessus) :
    // les couleurs du ciel, rangée par rangée, dans une table ; chaque colonne peint son relief, puis son ciel au-dessus
    soit se = sin1024(el);
    soit soir = 0;
    si se .< 24000 {
        soir = 160 - se * 160 / 24000;
        si se .< 0 {
            soir = 160;
        }
    }
    pour y dans 0..H {
        soit t = y * 256 / H;
        soit r = (0x5A * (256 - t) + (0xC8 + soir * 55 / 160) * t) / 256;
        soit g = (0x7C * (256 - t) + (0xD6 - soir * 40 / 160) * t) / 256;
        soit b = (0xB4 * (256 - t) + (0xE6 - soir * 110 / 160) * t) / 256;
        @2[CIEL + y] = rgb(r, g, b);
    }
    // le disque du soleil, s'il est dans le champ (60 degrés : 85 sur 1024 de chaque côté) : son centre (sx, sy)
    soit sx = 0;
    soit sy = 0;
    soit soleil_vu = 0;
    soit ecart_s = (az - a + 512) & 1023;
    si ecart_s > 512 - 85 && ecart_s < 512 + 85 && se .> 0 {
        sx = W / 2 + (ecart_s - 512) * (W / 2) ./ 85;
        soit sy_haut = se * ECHELLE ./ cos1024(el);
        si sy_haut < hor + 20 {
            sy = hor - sy_haut;
            soleil_vu = 1;
        }
    }
    soit sa = @2[SINUS + (a & 1023)];
    soit ca = @2[SINUS + ((a + 256) & 1023)];
    // les colonnes en segments : chaque cylindre (un cœur) peint ses colonnes, aucune n'écrit chez une autre
    pour x dans 0..W en bandes {
        // la direction du rayon de la colonne : l'axe de la vue, plus un écart à droite (un champ de 60 degrés)
        soit ecart = x * 2 * 37837 / W;                 // tan(30°) · 65536 = 37837, de -1 à +1 fois cela
        // dir = avant + (ecart - 37837) · droite, avec avant = (sin a, cos a), droite = (cos a, -sin a)
        soit e = ecart - 37837;                          // signé (deux compléments)
        soit dx = sa + (e * ca) ./ 65536;
        soit dz = ca - (e * sa) ./ 65536;
        soit haut = H;
        soit k = 0;
        tantque k < NPAS && haut > 0 {
            soit dist = @2[DIST + k];
            soit px = (cx + (dx * dist) ./ 256) >> 16;
            soit pz = (cz + (dz * dist) ./ 256) >> 16;
            soit cell = (pz & MASQUE) * G + (px & MASQUE);
            soit h = @2[HAUT + cell];
            soit inv = @2[INV + k];
            // la ligne à l'écran : hor + (ch - h) · inv
            soit ys = 0;
            soit dessus = ch * inv / 16777216;
            soit dessous = h * inv / 16777216;
            si hor + dessus > dessous {
                ys = hor + dessus - dessous;
            }
            si ys < haut {
                soit cc = embrume(@2[COUL + cell], @2[BRUME + k]);
                pour yy dans ys..haut {
                    @1[yy * W + x] = cc;
                }
                haut = ys;
            }
            k = k + 1;
        }
        // le ciel au-dessus du relief, et le disque du soleil là où il se voit
        soit ex = x - sx;
        pour yc dans 0..haut {
            soit pc = @2[CIEL + yc];
            si soleil_vu == 1 && (ex .< 9 && ex .> 0 - 9) {
                soit ey = yc - sy;
                si ey .< 9 && ey .> 0 - 9 && ex * ex + ey * ey < 64 {
                    pc = rgb(255, 245, 220);
                }
            }
            @1[yc * W + x] = pc;
        }
    }
}
