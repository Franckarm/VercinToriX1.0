// machine : lugus
// Belenos : l'épreuve de Gergovie sur la carte graphique, le modèle classique (0.820). Le même paysage, le même trajet
// que gergovie.vtx ; mais chaque image est faite d'un coup sur la carte : un fil de la carte par point de l'image (une
// boucle en segments sur W × H), tout le regard (le rayon, la clarté, Divona, la brume) dans le fil. La scène reste sur
// la carte (la résidence) ; à lancer avec VTX_EPISSAGE=rapide : ne montent que les pages que le processeur a changées
// (le modèle classique), et la promesse n'est pas vérifiée sur la carte (le programme écrit chaque point une fois, à
// sa place). Le point est rendu dans FIMAGE, puis posé à l'écran.
//     python forge/forge128.py belenos/gergovie_carte.vtx -o gergovie_carte ; VTX_EPISSAGE=rapide VTX_CARTE=1 gergovie_carte
constante RN = 1;
constante RD = 1;
importer "cubes_film.vtx";

constante VOL = 240;
constante JOUR = 120;
constante TEMPS = 605000;           // @2[TEMPS + i] : le temps de l'image i (en ms)
constante FIMAGE = 120;             // le cube de l'image : @2[(FIMAGE << 24) + i] = 0xRRGGBB du point i

// le regard, sans appel de soi-même (la carte n'a pas de pile) : l'œil (profondeur 1), puis le renvoi de l'eau
// (profondeur 0, qui ne renvoie que le ciel) ; le même calcul que regarder et divona de cubes_scene.vtx
fonction divona_0(ox, oy, oz, dx, dy, dz, t, temps) {
    soit px = ox + ((dx * t) .>> 16);
    soit pz = oz + ((dz * t) .>> 16);
    soit py = oy + ((dy * t) .>> 16);
    soit x = px >> 16;
    soit y = py >> 16;
    soit z = pz >> 16;
    soit alb = couleur(x, y, z);
    soit rx = dx + ((bruit_lisse((x + temps) & MASQ, z & MASQ, 16) - 32768) ./ 24);
    soit rz = dz + ((bruit_lisse(x & MASQ, (z + temps * 2) & MASQ, 16) - 32768) ./ 24);
    soit ry = 0 - dy;
    soit lg = racine_entiere(rx * rx + ry * ry + rz * rz);
    rx = (rx * 65536) ./ lg;
    ry = (ry * 65536) ./ lg;
    rz = (rz * 65536) ./ lg;
    soit renvoi = ciel(rx, ry, rz, 0);
    soit rasant = 65536 - (0 - dy);
    si dy .> 0 {
        rasant = 65536;
    }
    soit part = 64 + rasant * rasant / 65536 * 154 / 65536;
    soit r = (((alb >> 16) & 255) * (256 - part) + ((renvoi >> 16) & 255) * part) / 256;
    soit g = (((alb >> 8) & 255) * (256 - part) + ((renvoi >> 8) & 255) * part) / 256;
    soit b = ((alb & 255) * (256 - part) + (renvoi & 255) * part) / 256;
    retour r | (g << 12) | (b << 24);
}

fonction regarder_0(ox, oy, oz, dx, dy, dz, temps) {
    soit t = tracer(ox, oy, oz, dx, dy, dz, 1100 * 65536 * RN / RD, 1);
    si t == MANQUE {
        retour ciel(dx, dy, dz, 0);
    }
    soit om = clarte(ox, oy, oz, dx, dy, dz, t, 0);
    si (om & 2) != 0 {
        retour (2 << 24) | brumer(divona_0(ox, oy, oz, dx, dy, dz, t, temps), t);
    }
    retour (((om >> 2) & 3) << 24) | brumer(om >> 16, t);
}

fonction divona_1(ox, oy, oz, dx, dy, dz, t, temps) {
    soit px = ox + ((dx * t) .>> 16);
    soit py = oy + ((dy * t) .>> 16);
    soit pz = oz + ((dz * t) .>> 16);
    soit x = px >> 16;
    soit y = py >> 16;
    soit z = pz >> 16;
    soit alb = couleur(x, y, z);
    soit rx = dx + ((bruit_lisse((x + temps) & MASQ, z & MASQ, 16) - 32768) ./ 24);
    soit rz = dz + ((bruit_lisse(x & MASQ, (z + temps * 2) & MASQ, 16) - 32768) ./ 24);
    soit ry = 0 - dy;
    soit lg = racine_entiere(rx * rx + ry * ry + rz * rz);
    rx = (rx * 65536) ./ lg;
    ry = (ry * 65536) ./ lg;
    rz = (rz * 65536) ./ lg;
    soit renvoi = regarder_0(px, (MER << 16) + 32768, pz, rx, ry, rz, temps) & 16777215;
    soit rasant = 65536 - (0 - dy);
    si dy .> 0 {
        rasant = 65536;
    }
    soit part = 64 + rasant * rasant / 65536 * 154 / 65536;
    soit r = (((alb >> 16) & 255) * (256 - part) + ((renvoi >> 16) & 255) * part) / 256;
    soit g = (((alb >> 8) & 255) * (256 - part) + ((renvoi >> 8) & 255) * part) / 256;
    soit b = ((alb & 255) * (256 - part) + (renvoi & 255) * part) / 256;
    retour r | (g << 12) | (b << 24);
}

fonction regarder_1(ox, oy, oz, dx, dy, dz, temps) {
    soit t = tracer(ox, oy, oz, dx, dy, dz, 1100 * 65536 * RN / RD, 1);
    si t == MANQUE {
        retour ciel(dx, dy, dz, 0);
    }
    soit om = clarte(ox, oy, oz, dx, dy, dz, t, 0);
    si (om & 2) != 0 {
        retour (2 << 24) | brumer(divona_1(ox, oy, oz, dx, dy, dz, t, temps), t);
    }
    retour (((om >> 2) & 3) << 24) | brumer(om >> 16, t);
}

// une image sur la carte : un fil par point (i = y · W + x)
fonction image_carte(cx, cy, cz, lacet, tangage, temps) {
    soit sl = sin1024(lacet);
    soit cl = cos1024(lacet);
    soit st = sin1024(tangage);
    soit ct = cos1024(tangage);
    soit fx = (sl * ct) ./ 65536;
    soit fy = st;
    soit fz = (cl * ct) ./ 65536;
    soit rx = cl;
    soit rz = 0 - sl;
    soit ux = (0 - sl * st) ./ 65536;
    soit uy = ct;
    soit uz = (0 - cl * st) ./ 65536;
    pour i dans 0..(W * H) en segments {
        soit iy = i / W;
        soit ix = i - iy * W;
        soit sy = ((H - 2 * iy - 1) * 45889) ./ W;
        soit sx = ((2 * ix + 1 - W) * 45889) ./ W;
        soit dx = fx + (rx * sx + ux * sy) ./ 65536;
        soit dy = fy + (uy * sy) ./ 65536;
        soit dz = fz + (rz * sx + uz * sy) ./ 65536;
        soit lg = racine_entiere(dx * dx + dy * dy + dz * dz);
        dx = (dx * 65536) ./ lg;
        dy = (dy * 65536) ./ lg;
        dz = (dz * 65536) ./ lg;
        @2[(FIMAGE << 24) + i] = regarder_1(cx, cy, cz, dx, dy, dz, temps) & 16777215;
    }
    // l'image posée à l'écran (sur les cœurs du processeur)
    pour y dans 0..H en bandes {
        pour x dans 0..W {
            soit v = @2[(FIMAGE << 24) + y * W + x];
            @1[y * W + x] = rgb((v >> 16) & 255, (v >> 8) & 255, v & 255);
        }
    }
}

// l'œil, image i sur n : le même trajet que gergovie.vtx
fonction image_gergovie(i, n) {
    soit ay = @2[GLOB];
    soit avant = n * 7 / 12;
    soit cx = ARCHE_X * 65536;
    soit cy = 0;
    soit cz = 0;
    si i < avant {
        cy = 110 * 65536 * RN / RD - ((110 * RN / RD - ay - 12 * RN / RD) * 65536 / avant) * i;
        cz = 470 * 65536 * RN / RD - (170 * 65536 * RN / RD / avant) * i;
    } sinon {
        soit j = i - avant;
        soit reste = n - avant;
        cy = (ay + 12 * RN / RD) * 65536 + (((64 * RN / RD - ay - 12 * RN / RD) * 65536) ./ reste) * j;
        cz = ARCHE_Z * 65536 - (110 * 65536 * RN / RD / reste) * j;
    }
    soit vy = (ay + 14 * RN / RD) * 65536 - cy;
    soit tangage = 0;
    soit vu = 0 - 4611686018427387904;
    pour k dans 0..129 {
        soit a = (k + 1024 - 64) & 1023;
        soit p = (vy ./ 256) * sin1024(a) + (80 * 256 * RN / RD) * cos1024(a);
        si p .> vu {
            vu = p;
            tangage = a;
        }
    }
    image_carte(cx, cy, cz, 512, tangage, i * 3);
}

fonction en_dixiemes(d): texte {
    retour texte(d / 10) + "," + texte(d % 10);
}

fonction bilan(nom: texte, n) {
    soit total = 0;
    soit pire = 0;
    pour i dans 0..n {
        total = total + @2[TEMPS + i];
        si @2[TEMPS + i] > pire {
            pire = @2[TEMPS + i];
        }
    }
    soit k = n / 100;
    si k == 0 {
        k = 1;
    }
    soit lents = 0;
    pour j dans 0..k {
        soit m = 0;
        soit place = 0;
        pour i dans 0..n {
            si @2[TEMPS + i] >= m {
                m = @2[TEMPS + i];
                place = i;
            }
        }
        lents = lents + m;
        @2[TEMPS + place] = 0;
    }
    si total == 0 {
        total = 1;
    }
    si lents == 0 {
        lents = 1;
    }
    afficher("gergovie : " + nom + " : " + texte(n) + " images, " + en_dixiemes(10000 * n / total)
             + " images par seconde en moyenne, 1 % bas " + en_dixiemes(10000 * k / lents) + ", pire image "
             + texte(pire) + " ms ; empreinte " + texte(empreinte_image()));
}

fonction principal() {
    soit t0 = horloge();
    creer_monde();
    afficher("le monde : " + texte(horloge() - t0) + " ms");
    ecran(W, H);
    // le cube de l'image existe avant la première image (la carte y écrit)
    pour i dans 0..(W * H) {
        @2[(FIMAGE << 24) + i] = 0;
    }
    preparer_soleil(360, 70, 0);
    ranger_lumiere(1, 0);
    // la mise en place (comme le chargement d'un jeu : pas comptée) : une première image, qui installe tout
    image_gergovie(0, VOL);
    pour i dans 0..VOL {
        soit ti = horloge();
        image_gergovie(i, VOL);
        @2[TEMPS + i] = horloge() - ti;
        presenter();
    }
    bilan("le vol (l'oeil bouge), sur la carte", VOL);
    pour i dans 0..JOUR {
        soit tj = horloge();
        preparer_soleil(300 + i * 3, 50 + i, 0);
        ranger_lumiere(0, 0);
        image_gergovie(i, JOUR);
        @2[TEMPS + i] = horloge() - tj;
        presenter();
    }
    bilan("le jour (le soleil bouge aussi), sur la carte", JOUR);
}
