// machine : lugus
// Le Druide (0.835) : il conseille, modèle, propose, organise, connecte et déconnecte, apprend (le créateur) ; il
// touche l'ARN et le cube, jamais l'ADN. Ses cinq gestes, à chaque forge :
//
//     lugus druide/druide.vtx      (il lit une ligne : le chemin du relevé d'Ésus, PROG.esus, écrit par la forge)
//
// 1. se souvenir : les quatre points de chaque variable (le relevé d'Ésus) rangés dans son cube, sous le cube mère du
//    programme, dans son dossier à lui (cube128-PROG-e-4040.cub) : les quatre étages de la fréquence 4040 ; l'empreinte
//    du nom à 4041. La machine range chaque cube avec son anti-cube et son ombre : les sommets de secours.
// 2. apprendre : il compare avec ce qu'il savait (vrai : pareil ou plus serré ; faux : plus large ; inconnu : nouvelle ;
//    variable : déplacée) et en fait une synapse par variable (4042 : pour, contre ; les règles de Gutuater : il faut
//    trois preuves d'un côté, et trois fois plus que de l'autre) : une borne vraie de forge en forge est une règle.
// 3. relier : le travail de chaque molécule (PROG.poids, quand la forge les a comptés : VTX_DRUIDE=poids) et le temps
//    du programme (PROG.temps) ; il les garde (4043 : chaque molécule, son état, son poids).
// 4. proposer : PROG.conseils, les molécules par leur poids, et ce qui aiderait Ésus dans chacune.
// 5. adapter et évoluer : son ARN (PROG.arn, lu par la forge) connecte ou déconnecte Ésus molécule par molécule. À
//    chaque génération, une mutation (une molécule lourde, tirée au hasard, basculée) ; le programme se mesure ; la
//    variante est gardée si elle va plus vite (2 % au moins), sinon il revient au parent (4044 : la génération, le temps
//    du parent, la mutation en attente). La garde : Ésus est exact par preuve ; aucune variante ne change le résultat.
// 0.836 : le signe et le codon. Chaque variable a aussi son plus petit et son plus grand lus avec le signe (4045,
// étages 0 et 1 : 0 - 5 est -5) ; et son dossier codon (4045, étage 2 ; bibliotheque/codon.vtx, avec ordre) : trois
// lettres, A inconnu, C faux, G vrai, U variable, comme le tableau du code génétique. Place 0 : la mémoire (ce que la
// forge d'avant disait) ; place 1 : la forge du jour ; place 2 : le recoupement, ce que le programme a vraiment fait
// (PROG.observe, écrit par la passe de mesure VTX_DRUIDE=poids : les valeurs prises dedans la preuve, G ; dehors, U :
// la preuve d'Ésus est démentie, le Druide le déconnecte de la molécule, pour toujours). Une variable déplacée n'est
// plus jugée d'un coup : son dossier reste en suspens, tranché quand les témoins s'accordent, échu au bout du délai.
// Son carnet : PROG.druide.

importer "../bibliotheque/codon.vtx";

constante F_POINTS = 4040;
constante F_NOMS = 4041;
constante F_SYNAPSES = 4042;
constante F_MOLECULES = 4043;
constante F_LIGNEE = 4044;
constante F_SIGNES = 4045;
constante F_CELLULES = 4046;
constante MOITIE = 170141183460469231731687303715884105728;
constante PLACES = 65536;
constante PLACES_M = 4096;
constante SUR = 3;
constante PLEIN = 24;
constante TOUT = 340282366920938463463374607431768211455;

fonction lire_fichier(nom: texte): texte {
    soit canal = ouvrir_lecture(nom);
    si canal == (0 - 1) {
        retour "";
    }
    soit cs = tableau(0);
    soit ch = lire_car(canal);
    tantque ch != (0 - 1) {
        si ch != 13 {
            ajouter(cs, ch);
        }
        ch = lire_car(canal);
    }
    fermer(canal);
    soit r = texte_neuf(longueur(cs));
    pour i dans 0..longueur(cs) {
        changer_car(r, i, cs[i]);
    }
    retour r;
}

// un nombre écrit en hex (sans #), sur 128 bits
fonction de_hexa(t: texte) {
    soit v = 0;
    pour i dans 0..longueur(t) {
        soit c = car(t, i);
        soit d = 0;
        si c >= 48 && c <= 57 {
            d = c - 48;
        } sinon si c >= 97 && c <= 102 {
            d = c - 87;
        } sinon si c >= 65 && c <= 70 {
            d = c - 55;
        }
        v = (v << 4) | d;
    }
    retour v;
}

// 0.836 : un nombre signé écrit en hex (« -1e » vaut -30)
fonction de_signe(t: texte) {
    si commence_par(t, "-") == 1 {
        retour 0 - de_hexa(sous_texte(t, 1, longueur(t)));
    }
    retour de_hexa(t);
}

// l'empreinte d'un nom (FNV-1a de 64 bits), jamais nulle : 0 marque une place libre
fonction empreinte_nom(t: texte) {
    soit h = 14695981039346656037;
    pour i dans 0..longueur(t) {
        h = ((h ^ car(t, i)) * 1099511628211) & 18446744073709551615;
    }
    retour h | 1;
}

// la place d'un nom dans le cube : la sienne si elle y est, sinon la première libre après son empreinte
fonction place_de(h) {
    soit p = h % PLACES;
    soit n = 0;
    tantque n < PLACES {
        soit x = @[cube_adresse(0, F_NOMS, p)];
        si x == 0 || x == h {
            retour p;
        }
        p = (p + 1) % PLACES;
        n = n + 1;
    }
    retour 0 - 1;
}

// la place d'une molécule (4043, étage 0 : l'empreinte de son nom)
fonction place_molecule(h) {
    soit p = h % PLACES_M;
    soit n = 0;
    tantque n < PLACES_M {
        soit x = @[cube_adresse(0, F_MOLECULES, p)];
        si x == 0 || x == h {
            retour p;
        }
        p = (p + 1) % PLACES_M;
        n = n + 1;
    }
    retour 0 - 1;
}

// l'état d'une synapse (les règles de Gutuater)
fonction etat_synapse(vp, vc): logique {
    si vp < SUR && vc < SUR {
        retour inconnu;
    }
    si vp >= SUR && vp >= 3 * vc {
        retour vrai;
    }
    si vc >= SUR && vc >= 3 * vp {
        retour faux;
    }
    retour variable;
}

// un morceau de texte, seulement si c vaut 1
fonction nom_si(c, t: texte): texte {
    si c == 1 {
        retour t;
    }
    retour "";
}

// un texte est-il dans la liste (par son contenu) ?
fonction dans_liste(l, x: texte) {
    soit liste = ["x"];
    liste = l;
    pour k dans 0..longueur(liste) {
        si liste[k] == x {
            retour 1;
        }
    }
    retour 0;
}

fonction temps_de(t: texte) {
    pour l dans decouper(t, "\n") {
        soit m = mots(l);
        si longueur(m) == 2 && m[0] == "temps" {
            retour nombre(m[1]);
        }
    }
    retour 0;
}

// ce qu'il savait (a…) contre ce qu'Ésus prouve maintenant (n…)
fonction comparer(connu, ab, ah, az, ao, nb, nh, nz, no, asb, ash, nsb, nsh): logique {
    si connu == 0 {
        retour inconnu;
    }
    // plus serré ou pareil : l'intervalle neuf est dans l'ancien (sans signe et avec), et il sait au moins les mêmes bits
    soit dedans = nb >= ab && nh <= ah && (nz & az) == az && (no & ao) == ao && nsb .>= asb && nsh .<= ash;
    si dedans {
        retour vrai;
    }
    soit autour = nb <= ab && nh >= ah && (az & nz) == nz && (ao & no) == no && nsb .<= asb && nsh .>= ash;
    si autour {
        retour faux;
    }
    retour variable;
}

// 0.836 : un nombre en hexadécimal, comme dans le relevé d'Ésus et les points du cube (#…, sans zéros devant)
fonction lisible(n): texte {
    si n == 0 {
        retour "#0";
    }
    soit chiffres = "0123456789abcdef";
    soit t = "";
    soit v = n;
    tantque v != 0 {
        t = car_texte(car(chiffres, v & 15)) + t;
        v = v >> 4;
    }
    retour "#" + t;
}

// 0.836 : un nombre lu avec le signe
fonction lisible_s(n): texte {
    si n >= MOITIE {
        retour "-" + lisible(0 - n);
    }
    retour lisible(n);
}

// 0.836 : les lettres du codon, comme le tableau du code génétique
fonction base_de(l: logique): texte {
    soit b = "A";
    selon l {
        inconnu { b = "A"; }
        faux { b = "C"; }
        vrai { b = "G"; }
        variable { b = "U"; }
    }
    retour b;
}

// ce qui a changé, en clair (le quit de la comparaison ; l'ancien bas et haut, le neuf)
fonction expliquer(q, ab, ah, nb, nh): texte {
    soit de = "bas " + lisible(ab) + " -> " + lisible(nb) + ", haut " + lisible(ah) + " -> " + lisible(nh);
    si q == 0 {
        retour "nouvelle : bas " + lisible(nb) + ", haut " + lisible(nh);
    }
    si q == 4 {
        retour "plus serrée avec le signe";
    }
    si q == 2 {
        si nb == ab && nh == ah {
            retour "pareille";
        }
        retour "plus serrée : " + de;
    }
    si q == 1 {
        retour "plus large (elle peut dépasser son ancien maximum ou minimum) : " + de;
    }
    // variable : ni dedans ni autour
    si nb > ab && nh > ah {
        retour "déplacée vers le haut (plus grande que l'ancien maximum, jamais aussi petite qu'avant) : " + de;
    }
    si nb < ab && nh < ah {
        retour "déplacée vers le bas (plus petite que l'ancien minimum, jamais aussi grande qu'avant) : " + de;
    }
    retour "mêmes limites, d'autres bits sûrs (sa forme a changé, pas sa taille) : " + de;
}

fonction nom_logique(l: logique): texte {
    soit r = "inconnu";
    selon l {
        vrai { r = "vrai"; }
        faux { r = "faux"; }
        inconnu { r = "inconnu"; }
        variable { r = "variable"; }
    }
    retour r;
}

// 1 et 2 : se souvenir et apprendre (une variable) ; rend l'état de la comparaison, en quit (0 inconnu, 1 faux,
// 2 vrai, 3 variable)
fonction apprendre_variable(mol: texte, var: texte, nb, nh, nz, no, nsb, nsh, vu, ob, oh, osb, osh, carnet) {
    soit h = empreinte_nom(mol + " " + var);
    soit p = place_de(h);
    si p == (0 - 1) {
        retour 0;
    }
    soit connu = 0;
    si @[cube_adresse(0, F_NOMS, p)] == h {
        connu = 1;
    }
    // le signé d'avant (une variable rangée avant la 0.836 n'en a pas : tout l'intervalle)
    soit asb = MOITIE;
    soit ash = MOITIE - 1;
    si connu == 1 && @[cube_adresse(3, F_SIGNES, p)] == 1 {
        asb = @[cube_adresse(0, F_SIGNES, p)];
        ash = @[cube_adresse(1, F_SIGNES, p)];
    }
    soit etat_c = comparer(connu, @[cube_adresse(0, F_POINTS, p)], @[cube_adresse(1, F_POINTS, p)],
                           @[cube_adresse(2, F_POINTS, p)], @[cube_adresse(3, F_POINTS, p)], nb, nh, nz, no, asb, ash,
                           nsb, nsh);
    soit pareil_s = asb == nsb && ash == nsh;
    soit q = 0;
    selon etat_c {
        vrai { q = 2; }
        faux { q = 1; }
        inconnu { q = 0; }
        variable { q = 3; }
    }
    // la synapse : vrai, une preuve pour ; faux, une contre ; variable, l'une et l'autre ; l'usure au-delà de PLEIN
    soit vp = 0;
    soit vc = 0;
    si connu == 1 {
        vp = @[cube_adresse(0, F_SYNAPSES, p)];
        vc = @[cube_adresse(1, F_SYNAPSES, p)];
    }
    soit noms_q = ["inconnu", "faux", "vrai", "variable"];
    soit qe = q;
    si q == 2 && pareil_s == 0 {
        qe = 4;   // pareille sans signe, plus serrée avec
    }
    ecrire_texte(carnet, mol + " " + var + " " + noms_q[q] + " : " + expliquer(qe, @[cube_adresse(0, F_POINTS, p)],
                 @[cube_adresse(1, F_POINTS, p)], nb, nh) + "\n");
    si nsb >= MOITIE || ash >= MOITIE || asb != nsb || ash != nsh {
        si (nsb >= MOITIE || asb >= MOITIE) && !(nsb == MOITIE && nsh == MOITIE - 1 && asb == MOITIE && ash == MOITIE - 1) {
            ecrire_texte(carnet, "    avec le signe : de " + lisible_s(asb) + " -> " + lisible_s(nsb) + ", à " + lisible_s(ash)
                         + " -> " + lisible_s(nsh) + "\n");
        }
    }
    // le codon : la mémoire (la lettre du jour de la forge d'avant), la forge du jour, le recoupement (l'observation)
    soit dav = 0;
    si connu == 1 {
        dav = @[cube_adresse(2, F_SIGNES, p)];
    }
    soit l0 = inconnu;
    soit l2 = inconnu;
    si connu == 1 {
        l0 = lettre(dav, 1);
        si q == 2 {
            l2 = lettre(dav, 2);   // la borne n'a pas bougé : l'observation d'avant vaut encore
        }
    }
    soit dementie = 0;
    si vu == 1 {
        si ob >= nb && oh <= nh && osb .>= nsb && osh .<= nsh {
            l2 = vrai;
        } sinon {
            l2 = variable;
            dementie = 1;
        }
    }
    soit l1 = comme_logique(q);
    soit c = codon(l0, l1, l2);
    soit d = c;
    si (dav & 63) == c {
        d = dav;
    }
    d = consolider_ordonne(d);
    si dementie == 1 {
        d = (d & 63) + 128;   // un fait contre une preuve : la contradiction est fixée (échue), pas un avis à peser
    }
    soit dit = "    codon " + base_de(l0) + base_de(l1) + base_de(l2) + " (mémoire, forge, observation) : "
               + nom_logique(verdict_ordonne(d)) + ", " + nom_etat(d);
    si dementie == 1 {
        dit = "    codon " + base_de(l0) + base_de(l1) + base_de(l2) + " (mémoire, forge, observation) : variable, échu (la preuve démentie)";
    }
    si etat(d) == 0 {
        dit = dit + " (âge " + texte(age(d)) + " sur " + texte(delai()) + ")";
    }
    si vu == 1 {
        dit = dit + " ; vu de " + lisible_s(osb) + " à " + lisible_s(osh) + " (sans signe " + lisible(ob) + " à " + lisible(oh) + ")";
    }
    ecrire_texte(carnet, dit + "\n");
    si dementie == 1 {
        ecrire_texte(carnet, "    ALERTE : la valeur vue sort de la preuve d'Ésus : Ésus est déconnecté de " + mol + " (la garde)\n");
        poser_esus(mol, 1);
        poser_rejet(mol, 2);
    }
    @[cube_adresse(0, F_SIGNES, p)] = nsb;
    @[cube_adresse(1, F_SIGNES, p)] = nsh;
    @[cube_adresse(2, F_SIGNES, p)] = d;
    @[cube_adresse(3, F_SIGNES, p)] = 1;
    si q == 2 || q == 3 {
        vp = vp + 1;
    }
    si q == 1 || q == 3 {
        vc = vc + 1;
    }
    si vp + vc > PLEIN {
        vp = vp / 2;
        vc = vc / 2;
    }
    @[cube_adresse(0, F_NOMS, p)] = h;
    @[cube_adresse(0, F_POINTS, p)] = nb;
    @[cube_adresse(1, F_POINTS, p)] = nh;
    @[cube_adresse(2, F_POINTS, p)] = nz;
    @[cube_adresse(3, F_POINTS, p)] = no;
    @[cube_adresse(0, F_SYNAPSES, p)] = vp;
    @[cube_adresse(1, F_SYNAPSES, p)] = vc;
    retour q;
}

// 0.837 : le dossier codon d'une variable (4045, étage 2), 0 si elle n'est pas connue
fonction codon_de(mol: texte, var: texte) {
    soit h = empreinte_nom(mol + " " + var);
    soit p = place_de(h);
    si p == (0 - 1) || @[cube_adresse(0, F_NOMS, p)] != h {
        retour 0;
    }
    retour @[cube_adresse(2, F_SIGNES, p)];
}

// la règle apprise d'une variable (sa synapse)
fonction regle(mol: texte, var: texte): logique {
    soit h = empreinte_nom(mol + " " + var);
    soit p = place_de(h);
    si p == (0 - 1) || @[cube_adresse(0, F_NOMS, p)] != h {
        retour inconnu;
    }
    retour etat_synapse(@[cube_adresse(0, F_SYNAPSES, p)], @[cube_adresse(1, F_SYNAPSES, p)]);
}

// 4043 : l'état d'Ésus dans une molécule (0 jamais vue : connecté ; 1 déconnecté ; 2 connecté), son poids
fonction etat_esus(mol: texte) {
    soit h = empreinte_nom(mol);
    soit p = place_molecule(h);
    si p == (0 - 1) || @[cube_adresse(0, F_MOLECULES, p)] != h {
        retour 2;
    }
    soit e = @[cube_adresse(1, F_MOLECULES, p)];
    si e == 0 {
        retour 2;
    }
    retour e;
}

fonction poser_esus(mol: texte, e) {
    soit h = empreinte_nom(mol);
    soit p = place_molecule(h);
    si p != (0 - 1) {
        @[cube_adresse(0, F_MOLECULES, p)] = h;
        @[cube_adresse(1, F_MOLECULES, p)] = e;
    }
}

// 4043, étage 3 : la mutation de cette molécule a été rejetée (1) : elle n'est plus retentée tant qu'elle ne change pas
fonction rejetee(mol: texte) {
    soit h = empreinte_nom(mol);
    soit p = place_molecule(h);
    si p == (0 - 1) || @[cube_adresse(0, F_MOLECULES, p)] != h {
        retour 0;
    }
    retour @[cube_adresse(3, F_MOLECULES, p)];
}

fonction poser_rejet(mol: texte, r) {
    soit h = empreinte_nom(mol);
    soit p = place_molecule(h);
    si p != (0 - 1) && @[cube_adresse(0, F_MOLECULES, p)] == h && @[cube_adresse(3, F_MOLECULES, p)] == 2 {
        retour 0;   // 0.836 : une molécule où la preuve a été démentie reste à la garde
    }
    si p != (0 - 1) {
        @[cube_adresse(0, F_MOLECULES, p)] = h;
        @[cube_adresse(3, F_MOLECULES, p)] = r;
    }
}

fonction poids_de(mol: texte) {
    soit h = empreinte_nom(mol);
    soit p = place_molecule(h);
    si p == (0 - 1) || @[cube_adresse(0, F_MOLECULES, p)] != h {
        retour 0;
    }
    retour @[cube_adresse(2, F_MOLECULES, p)];
}

fonction poser_poids(mol: texte, w) {
    soit h = empreinte_nom(mol);
    soit p = place_molecule(h);
    si p != (0 - 1) {
        @[cube_adresse(0, F_MOLECULES, p)] = h;
        @[cube_adresse(2, F_MOLECULES, p)] = w;
    }
}

// 0.837 : 4046 : l'arrangement d'une molécule (sa place : celle de 4043) : étage 1 son dépliage (0 : le compilateur
// décide ; 1 : gardée à part ; 2 : dépliée dans ses appelants), étage 2 la mutation de dépliage rejetée
fonction etat_deplier(mol: texte) {
    soit h = empreinte_nom(mol);
    soit p = place_molecule(h);
    si p == (0 - 1) || @[cube_adresse(0, F_MOLECULES, p)] != h {
        retour 0;
    }
    retour @[cube_adresse(1, F_CELLULES, p)];
}

fonction poser_deplier(mol: texte, e) {
    soit h = empreinte_nom(mol);
    soit p = place_molecule(h);
    si p != (0 - 1) {
        @[cube_adresse(0, F_MOLECULES, p)] = h;
        @[cube_adresse(1, F_CELLULES, p)] = e;
    }
}

fonction rejet_deplier(mol: texte) {
    soit h = empreinte_nom(mol);
    soit p = place_molecule(h);
    si p == (0 - 1) || @[cube_adresse(0, F_MOLECULES, p)] != h {
        retour 0;
    }
    retour @[cube_adresse(2, F_CELLULES, p)];
}

fonction poser_rejet_deplier(mol: texte, r) {
    soit h = empreinte_nom(mol);
    soit p = place_molecule(h);
    si p != (0 - 1) {
        @[cube_adresse(0, F_MOLECULES, p)] = h;
        @[cube_adresse(2, F_CELLULES, p)] = r;
    }
}

// un gène : « esus MOL » (Ésus connecté ou non dans la molécule) ou « deplier MOL » (son arrangement)
fonction gene_mol(g: texte): texte {
    retour sous_texte(g, position(g, " ") + 1, longueur(g));
}

fonction gene_etat(g: texte) {
    si commence_par(g, "esus ") == 1 {
        retour etat_esus(gene_mol(g));
    }
    retour etat_deplier(gene_mol(g));
}

fonction gene_poser(g: texte, v) {
    si commence_par(g, "esus ") == 1 {
        poser_esus(gene_mol(g), v);
    } sinon {
        poser_deplier(gene_mol(g), v);
    }
}

fonction gene_rejete(g: texte) {
    si commence_par(g, "esus ") == 1 {
        retour rejetee(gene_mol(g));
    }
    retour rejet_deplier(gene_mol(g));
}

fonction gene_rejeter(g: texte, r) {
    si commence_par(g, "esus ") == 1 {
        poser_rejet(gene_mol(g), r);
    } sinon {
        poser_rejet_deplier(gene_mol(g), r);
    }
}

// l'état muté : Ésus basculé ; le dépliage : déplié, ou gardé à part s'il l'était
fonction gene_muter(g: texte, avant) {
    si commence_par(g, "esus ") == 1 {
        si avant == 1 {
            retour 2;
        }
        retour 1;
    }
    si avant == 2 {
        retour 1;
    }
    retour 2;
}

fonction gene_dire(g: texte, v): texte {
    soit m = gene_mol(g);
    si commence_par(g, "esus ") == 1 {
        si v == 1 {
            retour "déconnecte Ésus dans " + m;
        }
        retour "connecte Ésus dans " + m;
    }
    si v == 2 {
        retour "déplie " + m + " dans ses appelants (la cellule fondue)";
    }
    retour "garde " + m + " à part";
}

fonction principal() {
    soit chemin = lire_ligne();
    tantque longueur(chemin) > 0 && (car(chemin, longueur(chemin) - 1) == 13 || car(chemin, longueur(chemin) - 1) == 32) {
        chemin = sous_texte(chemin, 0, longueur(chemin) - 1);
    }
    // le nom du programme : le relevé PROG.esus, sans son dossier
    soit debut = 0;
    pour k dans 0..longueur(chemin) {
        si car(chemin, k) == 47 || car(chemin, k) == 92 {
            debut = k + 1;
        }
    }
    soit fin = longueur(chemin);
    si finit_par(chemin, ".esus") == 1 {
        fin = fin - 5;
    }
    soit prog = sous_texte(chemin, debut, fin);
    soit base = sous_texte(chemin, 0, fin);
    soit releve = lire_fichier(chemin);
    si longueur(releve) == 0 {
        afficher("le Druide : pas de relevé d'Ésus à", chemin);
        retour;
    }
    cube_mere(prog);

    // 1 et 2 : se souvenir, apprendre
    soit carnet = ouvrir_ecriture(base + ".druide");
    ecrire_texte(carnet, "# carnet du Druide pour " + prog + "\n# les variables : molécule variable état : ce qui a changé (vrai : pareille ou plus serrée ; faux : plus large ; inconnu : nouvelle ; variable : déplacée)\n");
    soit compte = [0, 0, 0, 0];
    soit nlu = 0;
    soit lmol = ["x"];
    soit lvar = ["x"];
    soit lhaut = [0];
    soit letat = [0];
    retirer(lmol);
    retirer(lvar);
    retirer(lhaut);
    retirer(letat);
    // 0.836 : ce que les variables ont vraiment pris (la passe de mesure : PROG.observe), consommé après lecture
    soit obs_txt = lire_fichier(base + ".observe");
    fermer(ouvrir_ecriture(base + ".observe"));
    soit ocle = ["x"];
    soit ovals = [["x"]];
    retirer(ocle);
    retirer(ovals);
    pour lo dans decouper(obs_txt, "\n") {
        soit mo = mots(lo);
        si longueur(mo) == 7 {
            ajouter(ocle, mo[0] + " " + mo[1]);
            ajouter(ovals, mo);
        }
    }
    soit lsb = [0];
    soit lsh = [0];
    retirer(lsb);
    retirer(lsh);
    pour l dans decouper(releve, "\n") {
        soit m = mots(l);
        si (longueur(m) == 6 || longueur(m) == 8) && commence_par(l, "#") == 0 {
            soit nh = de_hexa(m[3]);
            soit sb = MOITIE;
            soit sh = MOITIE - 1;
            si longueur(m) == 8 {
                sb = de_signe(m[6]);
                sh = de_signe(m[7]);
            }
            soit vu = 0;
            soit ob = 0;
            soit oh = 0;
            soit osb = 0;
            soit osh = 0;
            pour ko dans 0..longueur(ocle) {
                si ocle[ko] == m[0] + " " + m[1] {
                    soit vo = ["x"];
                    vo = ovals[ko];
                    vu = 1;
                    ob = de_hexa(vo[2]);
                    oh = de_hexa(vo[3]);
                    osb = de_signe(vo[4]);
                    osh = de_signe(vo[5]);
                }
            }
            soit q = apprendre_variable(m[0], m[1], de_hexa(m[2]), nh, de_hexa(m[4]), de_hexa(m[5]), sb, sh, vu, ob, oh,
                                        osb, osh, carnet);
            ajouter(lsb, sb);
            ajouter(lsh, sh);
            compte[q] = compte[q] + 1;
            ajouter(lmol, m[0]);
            ajouter(lvar, m[1]);
            ajouter(lhaut, nh);
            ajouter(letat, q);
            ecrire_texte(carnet, "    sa règle (apprise de forge en forge) : " + nom_logique(regle(m[0], m[1])) + "\n");
            nlu = nlu + 1;
        }
    }

    // une molécule retouchée (une de ses variables plus large ou déplacée) redevient candidate aux mutations
    pour kr0 dans 0..longueur(lmol) {
        si letat[kr0] == 1 || letat[kr0] == 3 {
            poser_rejet(lmol[kr0], 0);
            poser_rejet_deplier(lmol[kr0], 0);
        }
    }
    // 3 : relier : le travail de chaque molécule (s'il a été compté), puis le temps du programme
    soit poids_txt = lire_fichier(base + ".poids");
    pour lp dans decouper(poids_txt, "\n") {
        soit mp = mots(lp);
        si longueur(mp) == 2 {
            poser_poids(mp[0], nombre(mp[1]));
        }
    }
    // les molécules connues : celles du relevé (et du poids) ; leur poids total
    soit lm = ["x"];
    retirer(lm);
    pour km dans 0..longueur(lmol) {
        si dans_liste(lm, lmol[km]) == 0 {
            ajouter(lm, lmol[km]);
        }
    }
    pour lq dans decouper(poids_txt, "\n") {
        soit mq = mots(lq);
        si longueur(mq) == 2 && dans_liste(lm, mq[0]) == 0 {
            ajouter(lm, mq[0]);
        }
    }
    soit total = 0;
    pour kt dans 0..longueur(lm) {
        total = total + poids_de(lm[kt]);
    }
    soit t = temps_de(lire_fichier(base + ".temps"));
    // un temps ne compte qu'une fois (comme les mesures de Gutuater)
    fermer(ouvrir_ecriture(base + ".temps"));

    // 5 : évoluer, à la manière de Gutuater : pendant une mutation, le parent et la variante jouent tour à tour (le
    // bruit de la mesure ne décide pas sur un seul essai) ; chaque paire est une preuve (3 % de mieux : pour ; de moins :
    // contre) ; la synapse décide (vrai : la variante est gardée ; faux : retour au parent) ; huit paires sans décision :
    // le doute garde le parent. La lignée (4044) : génération, temps du parent, molécule en attente, son état d'avant ;
    // à l'adresse 1 : le tour (1 : ce passage était la variante ; 2 : le parent), le temps de la variante, pour, contre ;
    // à l'adresse 2 : les paires jouées.
    soit gen = @[cube_adresse(0, F_LIGNEE, 0)];
    soit tp = @[cube_adresse(1, F_LIGNEE, 0)];
    soit attente = @[cube_adresse(2, F_LIGNEE, 0)];
    soit avant = @[cube_adresse(3, F_LIGNEE, 0)];
    soit tour = @[cube_adresse(0, F_LIGNEE, 1)];
    soit tv = @[cube_adresse(1, F_LIGNEE, 1)];
    soit sp = @[cube_adresse(2, F_LIGNEE, 1)];
    soit sc = @[cube_adresse(3, F_LIGNEE, 1)];
    soit paires = @[cube_adresse(0, F_LIGNEE, 2)];
    soit mute = "";
    // 0.837 : les gènes : Ésus dans chaque molécule ; le dépliage de chaque molécule appelée par une autre (les cellules)
    soit cel_txt = lire_fichier(base + ".cellules");
    soit appelees = ["x"];
    retirer(appelees);
    pour lc dans decouper(cel_txt, "\n") {
        soit mc = mots(lc);
        si longueur(mc) >= 3 && commence_par(lc, "#") == 0 {
            pour kc2 dans 3..longueur(mc) {
                si dans_liste(appelees, mc[kc2]) == 0 {
                    ajouter(appelees, mc[kc2]);
                }
            }
        }
    }
    soit genes = ["x"];
    retirer(genes);
    // en 64 bits (un programme « dunon; »), Ésus ne travaille pas : seul l'arrangement est un gène
    soit large = 1;
    si position(cel_txt, "(64 bits)") < longueur(cel_txt) {
        large = 0;
    }
    pour kg0 dans 0..longueur(lm) {
        si large == 1 {
            ajouter(genes, "esus " + lm[kg0]);
        }
        si dans_liste(appelees, lm[kg0]) == 1 {
            ajouter(genes, "deplier " + lm[kg0]);
        }
    }
    pour ka dans 0..longueur(genes) {
        si attente != 0 && empreinte_nom(genes[ka]) == attente {
            mute = genes[ka];
        }
    }
    // 0.838 : la bibliothèque des cellules du dossier (cellules.bibliotheque, à côté du relevé) : une cellule déjà connue
    // (dans ce programme ou un autre : la même empreinte) apporte ses gènes, jugés ; l'évolution n'a plus à les chercher
    soit dossier = "";
    pour kd dans 0..longueur(base) {
        si car(base, kd) == 47 || car(base, kd) == 92 {
            dossier = sous_texte(base, 0, kd + 1);
        }
    }
    soit chemin_bib = dossier + "cellules.bibliotheque";
    soit bib_txt = lire_fichier(chemin_bib);
    soit bemp = ["x"];
    soit blig = ["x"];
    retirer(bemp);
    retirer(blig);
    pour lb dans decouper(bib_txt, "\n") {
        soit mb = mots(lb);
        si longueur(mb) >= 5 && commence_par(lb, "#") == 0 {
            ajouter(bemp, mb[0]);
            ajouter(blig, lb);
        }
    }
    pour lc4 dans decouper(cel_txt, "\n") {
        soit m4 = mots(lc4);
        si longueur(m4) >= 3 && commence_par(lc4, "#") == 0 {
            soit h4 = empreinte_nom(m4[0]);
            soit p4 = place_molecule(h4);
            soit vu4 = 0;
            si p4 != (0 - 1) && @[cube_adresse(0, F_MOLECULES, p4)] == h4 {
                vu4 = @[cube_adresse(0, F_CELLULES, p4)];
            }
            pour kb dans 0..longueur(bemp) {
                si bemp[kb] == m4[2] && vu4 == 0 && !(attente != 0 && (mute == "esus " + m4[0] || mute == "deplier " + m4[0])) {
                    soit mb2 = mots(blig[kb]);
                    soit e4 = nombre(mb2[1]);
                    soit d4 = nombre(mb2[2]);
                    si large == 1 && e4 != 0 {
                        poser_esus(m4[0], e4);
                        poser_rejet(m4[0], 3);
                    }
                    poser_deplier(m4[0], d4);
                    poser_rejet_deplier(m4[0], 3);
                    ecrire_texte(carnet, "cellule " + m4[0] + " : reprise de la bibliothèque (connue dans " + mb2[3]
                                 + ", la même empreinte " + m4[2] + ") : ses gènes sont jugés\n");
                }
            }
            si p4 != (0 - 1) {
                @[cube_adresse(0, F_MOLECULES, p4)] = h4;
                @[cube_adresse(0, F_CELLULES, p4)] = 1;
            }
        }
    }
    ecrire_texte(carnet, "# la lignée : génération " + texte(gen) + ", ce passage " + texte(t) + " µs\n");
    si attente != 0 && longueur(mute) == 0 {
        attente = 0;
    }
    si attente != 0 && t > 0 {
        si tour == 1 {
            tv = t;
        } sinon {
            tp = t;
        }
        si tour == 1 && tp > 0 {
            paires = paires + 1;
            si tv * 100 <= tp * 97 {
                sp = sp + 1;
            } sinon si tv * 100 >= tp * 103 {
                sc = sc + 1;
            }
            ecrire_texte(carnet, "évolution : « " + mute + " » : la variante " + texte(tv) + " µs contre le parent " + texte(tp)
                         + " µs (pour " + texte(sp) + ", contre " + texte(sc) + ")\n");
        }
        soit decide = etat_synapse(sp, sc);
        soit fini = 0;
        selon decide {
            vrai {
                ecrire_texte(carnet, "évolution : la mutation « " + mute + " » est gardée (plus rapide)\n");
                gene_rejeter(mute, 3);   // 0.838 : jugée (gardée) : elle ne se retente pas
                fini = 1;
            }
            faux {
                gene_poser(mute, avant);
                gene_rejeter(mute, 1);
                ecrire_texte(carnet, "évolution : la mutation « " + mute + " » est rejetée (plus lente) : retour au parent\n");
                fini = 1;
            }
            inconnu { }
            variable { }
        }
        si fini == 0 && paires >= 8 {
            gene_poser(mute, avant);
            gene_rejeter(mute, 1);
            ecrire_texte(carnet, "évolution : la mutation « " + mute + " » n'a rien prouvé en huit paires : le parent reste\n");
            fini = 1;
        }
        si fini == 1 {
            attente = 0;
        } sinon {
            // le tour suivant : l'autre
            si tour == 1 {
                tour = 2;
            } sinon {
                tour = 1;
            }
        }
    } sinon si t > 0 {
        tp = t;
    }
    // une mutation neuve : une molécule qui pèse (2 % au moins du travail), tirée au hasard (la graine : le temps)
    si attente == 0 && t > 0 && total > 0 {
        soit candidates = ["x"];
        retirer(candidates);
        pour kc dans 0..longueur(genes) {
            si poids_de(gene_mol(genes[kc])) * 50 >= total && gene_rejete(genes[kc]) == 0 {
                ajouter(candidates, genes[kc]);
            }
        }
        si longueur(candidates) > 0 {
            graine(t + gen);
            mute = candidates[hasard(longueur(candidates))];
            avant = gene_etat(mute);
            soit neuf = gene_muter(mute, avant);
            gene_poser(mute, neuf);
            attente = empreinte_nom(mute);
            gen = gen + 1;
            tour = 1;
            tv = 0;
            sp = 0;
            sc = 0;
            paires = 0;
            ecrire_texte(carnet, "évolution : génération " + texte(gen) + " : la mutation " + gene_dire(mute, neuf) + "\n");
        } sinon {
            ecrire_texte(carnet, "évolution : rien à essayer (les mutations des molécules lourdes ont été jugées) : la lignée est stable\n");
        }
    }
    // 0.836 : la garde l'emporte sur l'évolution : une molécule où la preuve a été démentie reste sans Ésus
    pour kg dans 0..longueur(lm) {
        si rejetee(lm[kg]) == 2 {
            poser_esus(lm[kg], 1);
            si attente != 0 && mute == "esus " + lm[kg] {
                attente = 0;
                ecrire_texte(carnet, "évolution : la mutation de " + mute + " est arrêtée : la garde l'a reprise\n");
            }
        }
    }
    // 0.837 : les cellules à connaître : une molécule et celles qu'elle appelle ; connue quand chaque variable de chacune
    // a son dossier codon tranché vrai (les témoins d'accord) et que rien n'a été démenti
    ecrire_texte(carnet, "# les cellules (une molécule et celles qu'elle appelle ; connue : tous ses dossiers tranchés vrai)\n");
    soit ncel = 0;
    soit nconnues = 0;
    pour lc2 dans decouper(cel_txt, "\n") {
        soit mc2 = mots(lc2);
        si longueur(mc2) >= 3 && commence_par(lc2, "#") == 0 && commence_par(mc2[0], "__") == 0 {
            soit membres = [mc2[0]];
            pour kc3 dans 3..longueur(mc2) {
                ajouter(membres, mc2[kc3]);
            }
            soit sures = 0;
            soit suspens = 0;
            soit echues = 0;
            soit dem2 = 0;
            pour kv2 dans 0..longueur(lmol) {
                si dans_liste(membres, lmol[kv2]) == 1 {
                    soit dc = codon_de(lmol[kv2], lvar[kv2]);
                    si etat(dc) == 1 && verdict_ordonne(dc) == vrai {
                        sures = sures + 1;
                    } sinon si etat(dc) == 2 {
                        echues = echues + 1;
                    } sinon {
                        suspens = suspens + 1;
                    }
                }
            }
            pour km2 dans 0..longueur(membres) {
                si rejetee(membres[km2]) == 2 {
                    dem2 = 1;
                }
            }
            // ses gènes (ceux de ses membres) : tous jugés ?
            soit ngenes = 0;
            soit njuges = 0;
            pour kg5 dans 0..longueur(genes) {
                si dans_liste(membres, gene_mol(genes[kg5])) == 1 {
                    ngenes = ngenes + 1;
                    // une molécule légère (moins de 2 % du travail) n'est pas mise à l'épreuve : le compilateur décide
                    si gene_rejete(genes[kg5]) != 0 || poids_de(gene_mol(genes[kg5])) * 50 < total {
                        njuges = njuges + 1;
                    }
                }
            }
            soit connue = 0;
            si suspens == 0 && echues == 0 && dem2 == 0 && (sures > 0 || (ngenes > 0 && njuges == ngenes)) {
                connue = 1;
            }
            // connue : rangée dans la bibliothèque du dossier (son empreinte, Ésus, son dépliage, le programme)
            si connue == 1 && njuges == ngenes && !(attente != 0 && dans_liste(membres, gene_mol(mute)) == 1) {
                soit neuve = mc2[2] + " " + texte(etat_esus(mc2[0])) + " " + texte(etat_deplier(mc2[0])) + " " + prog + " "
                             + mc2[0];
                soit trouve = 0;
                pour kb2 dans 0..longueur(bemp) {
                    si bemp[kb2] == mc2[2] {
                        blig[kb2] = neuve;
                        trouve = 1;
                    }
                }
                si trouve == 0 {
                    ajouter(bemp, mc2[2]);
                    ajouter(blig, neuve);
                }
            }
            soit hc = empreinte_nom(mc2[0]);
            soit pc = place_molecule(hc);
            soit avant_c = 0;
            si pc != (0 - 1) && @[cube_adresse(0, F_MOLECULES, pc)] == hc {
                avant_c = @[cube_adresse(3, F_CELLULES, pc)];
            }
            soit dit2 = "à connaître";
            si connue == 1 && njuges == ngenes {
                dit2 = "faite (connue, ses gènes jugés : gardée dans la bibliothèque)";
            } sinon si connue == 1 && avant_c == 1 {
                dit2 = "connue";
            } sinon si connue == 1 {
                dit2 = "devient connue";
            } sinon si avant_c == 1 {
                dit2 = "n'est plus connue (une variable a bougé)";
            }
            soit app = "";
            si longueur(membres) > 1 {
                app = " ; elle appelle " + assembler(tranche(membres, 1, longueur(membres)), ", ");
            }
            ecrire_texte(carnet, "cellule " + mc2[0] + " (membrane " + mc2[1] + app + ") : " + dit2 + " ; " + texte(sures)
                         + " dossiers tranchés vrai, " + texte(suspens) + " en suspens, " + texte(echues) + " échus ; gènes jugés "
                         + texte(njuges) + " sur " + texte(ngenes)
                         + nom_si(dem2, ", une preuve démentie") + nom_si(etat_deplier(mc2[0]) == 2, " ; dépliée")
                         + nom_si(etat_deplier(mc2[0]) == 1, " ; gardée à part") + "\n");
            si pc != (0 - 1) {
                @[cube_adresse(0, F_MOLECULES, pc)] = hc;
                @[cube_adresse(3, F_CELLULES, pc)] = connue;
            }
            ncel = ncel + 1;
            nconnues = nconnues + connue;
        }
    }
    soit bib = ouvrir_ecriture(chemin_bib);
    ecrire_texte(bib, "# la bibliothèque des cellules du dossier (le Druide) : empreinte esus (1 déconnecté, 2 connecté) deplier (0, 1 à part, 2 dépliée) programme molécule\n");
    pour kb3 dans 0..longueur(blig) {
        ecrire_texte(bib, blig[kb3] + "\n");
    }
    fermer(bib);
    @[cube_adresse(0, F_LIGNEE, 0)] = gen;
    @[cube_adresse(1, F_LIGNEE, 0)] = tp;
    @[cube_adresse(2, F_LIGNEE, 0)] = attente;
    @[cube_adresse(3, F_LIGNEE, 0)] = avant;
    @[cube_adresse(0, F_LIGNEE, 1)] = tour;
    @[cube_adresse(1, F_LIGNEE, 1)] = tv;
    @[cube_adresse(2, F_LIGNEE, 1)] = sp;
    @[cube_adresse(3, F_LIGNEE, 1)] = sc;
    @[cube_adresse(0, F_LIGNEE, 2)] = paires;
    fermer(carnet);

    // 5 : adapter : l'ARN (la forge le lit : « esus MOLÉCULE 0 » déconnecte Ésus de la molécule)
    soit arn = ouvrir_ecriture(base + ".arn");
    ecrire_texte(arn, "# ARN du Druide pour " + prog + ", lu par la forge : esus MOLÉCULE 0 (Ésus déconnecté) ; deplier MOLÉCULE 1 (dépliée dans ses appelants), 0 (à part)\n");
    pour ke dans 0..longueur(lm) {
        soit ee = etat_esus(lm[ke]);
        si attente != 0 && mute == "esus " + lm[ke] && tour == 2 {
            ee = avant;
        }
        si ee == 1 {
            ecrire_texte(arn, "esus " + lm[ke] + " 0\n");
        }
        soit dp = etat_deplier(lm[ke]);
        si attente != 0 && mute == "deplier " + lm[ke] && tour == 2 {
            dp = avant;
        }
        si dp == 1 {
            ecrire_texte(arn, "deplier " + lm[ke] + " 0\n");
        }
        si dp == 2 {
            ecrire_texte(arn, "deplier " + lm[ke] + " 1\n");
        }
    }
    fermer(arn);

    // 4 : proposer : les molécules par leur poids, et ce qui aiderait Ésus dans chacune
    soit cons = ouvrir_ecriture(base + ".conseils");
    ecrire_texte(cons, "# conseils du Druide pour " + prog + " (les molécules par leur travail ; ce qu'Ésus prouve ou non)\n");
    soit pris = tableau(longueur(lm));
    pour rang dans 0..10 {
        soit meilleur = 0 - 1;
        soit wmax = 0;
        pour kr dans 0..longueur(lm) {
            si pris[kr] == 0 && poids_de(lm[kr]) > wmax {
                wmax = poids_de(lm[kr]);
                meilleur = kr;
            }
        }
        si meilleur != (0 - 1) && wmax * 100 < total {
            meilleur = 0 - 1;
        }
        si meilleur != (0 - 1) {
            pris[meilleur] = 1;
            soit nomm = lm[meilleur];
            soit part = 0;
            si total > 0 {
                part = wmax * 1000 / total;
            }
            soit etat_e = "connecté";
            si etat_esus(nomm) == 1 {
                etat_e = "déconnecté";
            }
            si large == 0 {
                etat_e = "sans travail (64 bits)";
            }
            soit dp_e = "";
            si etat_deplier(nomm) == 2 {
                dp_e = " ; dépliée dans ses appelants";
            }
            si etat_deplier(nomm) == 1 {
                dp_e = " ; gardée à part";
            }
            ecrire_texte(cons, nomm + " : " + texte(part / 10) + "," + texte(part % 10) + " % du travail ; Ésus " + etat_e + dp_e + "\n");
            pour kv dans 0..longueur(lmol) {
                si lmol[kv] == nomm {
                    si lhaut[kv] == TOUT && lsb[kv] >= MOITIE && lsh[kv] < MOITIE && lsh[kv] - lsb[kv] < 18446744073709551615 {
                        ecrire_texte(cons, "    " + lvar[kv] + " : des valeurs négatives, bornées de " + lisible_s(lsb[kv]) + " à "
                                     + lisible_s(lsh[kv]) + " : Ésus prend ses opérations signées en 64 bits\n");
                    } sinon si lhaut[kv] == TOUT {
                        ecrire_texte(cons, "    " + lvar[kv] + " : aucune borne prouvée (128 bits) ; un masque, ou une borne de boucle, la mettrait en 64 bits\n");
                    } sinon si lhaut[kv] <= 18446744073709551615 {
                        selon regle(nomm, lvar[kv]) {
                            vrai { ecrire_texte(cons, "    " + lvar[kv] + " : borne stable (au plus " + texte(lhaut[kv]) + ") : ses opérations en 64 bits\n"); }
                            faux { ecrire_texte(cons, "    " + lvar[kv] + " : sa borne s'élargit d'une forge à l'autre : à regarder\n"); }
                            inconnu { ecrire_texte(cons, "    " + lvar[kv] + " : au plus " + texte(lhaut[kv]) + " (à confirmer aux prochaines forges)\n"); }
                            variable { ecrire_texte(cons, "    " + lvar[kv] + " : sa borne se déplace : à regarder\n"); }
                        }
                    }
                }
            }
        }
    }
    fermer(cons);

    soit pages = ranger_cube(0, F_NOMS);
    pour el dans 0..4 {
        pages = pages + ranger_cube(el, F_LIGNEE);
    }
    pour e dans 0..4 {
        pages = pages + ranger_cube(e, F_POINTS);
    }
    pages = pages + ranger_cube(0, F_SYNAPSES) + ranger_cube(1, F_SYNAPSES);
    pour es dans 0..4 {
        pages = pages + ranger_cube(es, F_SIGNES);
    }
    pour em dans 0..4 {
        pages = pages + ranger_cube(em, F_MOLECULES);
    }
    pages = pages + ranger_cube(0, F_CELLULES) + ranger_cube(1, F_CELLULES) + ranger_cube(2, F_CELLULES) + ranger_cube(3, F_CELLULES);
    afficher("le Druide :", prog, ":", nlu, "variables ; pareilles ou plus serrées", compte[2], ", plus larges", compte[1],
             ", nouvelles", compte[0], ", déplacées", compte[3], "; cellules connues", nconnues, "sur", ncel, "; génération", gen, "; temps", t, "µs ;", pages, "pages rangées");
}
