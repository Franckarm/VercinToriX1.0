// vtxc64 : le compilateur de Vercintorix écrit en Vercintorix, pour le SPU-64 (mot de 64 bits, point profond
// #RRRRGGGGBBBBAAAA, flottants quaternaires, brin ADN / ARN). Il donne exactement les mêmes mots que vtx64.py.
// Il lit « source.vtx » et écrit « code.mots » : les mots du code machine du SPU-64, séparés par des virgules.
// Il produit le même code que vtx.py sans optimisation ni prélude, pour le noyau du langage :
// constantes, structures (champs typés), tableaux simples, fonctions (paramètres et retours entiers ou références),
// soit, affectation, si / sinon si / sinon, tantque, pour, retour, arrêter, continuer, @étage[adresse], @(étage)[adresse],
// champs, construction Structure { … }, nouveau_de, textes, caractères, opérateurs entiers, entrées et sorties,
// et le cœur quaternaire : la logique à quatre valeurs (logique, vrai, faux, inconnu, variable, et4, ou4, non4, anti,
// fusion, consensus, logique(), comme_logique(), selon), les quits (<<q, >>q, x.q(i), min4, max4, addm4, gdot, cmp3,
// qegal, nb_bits) et les comparaisons signées (.< .<= .> .>=, ./ .% .>> par le prélude).
// Comme vtx ne convertit jamais un entier en référence, toutes les listes sont chaînées et typées.

constante MASQUE = 16777215;

// --------------------------------------------------------------------------------------------- mémoire et tas
fonction lit(a) {
    retour @[a];
}

fonction ecrit(a, v) {
    @[a] = v;
}

// Le tas de vtxc64 commence à #800000 du cube 0 de l'étage 3 et continue, d'un seul tenant, dans les cubes suivants
// (l'adresse longue porte le cube dans ses bits 47-24) : il n'a plus de plafond à 14 680 056 (vtxc64 qui se compile
// lui-même dépassait les 6,3 millions de mots de l'ancienne place et écrasait ses propres données). Son pointeur est
// rangé à part, dans le cube 2999 (les tables sont dans les cubes 3000 et au-delà).
fonction nouveau(n) {
    soit p = @[13835058105597034496];
    si p == 0 {
        p = 8388608;
    }
    @[13835058105597034496] = p + n;      // le tas ne reprend jamais un bloc : la mémoire neuve est à zéro
    retour 13835058055282163712 + p;      // l'adresse longue : étage 3, à partir du cube 0
}

// --------------------------------------------------------------------------------------------- textes
fonction longueur(t) {
    retour @[t];
}

fonction car(t, i) {
    retour @[t + 1 + i];
}

fonction texte_egal(a, b) {
    si a == b {
        retour 1;
    }
    soit n = @[a];
    si n != @[b] {
        retour 0;
    }
    pour i dans 1..n + 1 {
        si @[a + i] != @[b + i] {
            retour 0;
        }
    }
    retour 1;
}

fonction ecrire_texte(c, t) {
    pour i dans 0..longueur(t) {
        ecrire_car(c, car(t, i));
    }
}

fonction ecrire_nombre(c, n) {
    // chiffre par chiffre, du plus fort au plus faible, sans s'appeler soi-même (un appel par chiffre coûtait cher :
    // le code d'un programme, ce sont des centaines de milliers de nombres écrits)
    soit p = 1;
    tantque n / p >= 10 {
        p = p * 10;
    }
    tantque p > 0 {
        ecrire_car(c, 48 + (n / p) % 10);
        p = p / 10;
    }
}

// --------------------------------------------------------------------------------------------- listes d'entiers
structure Liste { n, cap, mem }

fonction liste(): Liste {
    retour Liste { cap: 64, mem: nouveau(64) };
}

fonction ajouter(l: Liste, x) {
    si l.n == l.cap {
        soit m = nouveau(l.cap * 2);
        pour i dans 0..l.n {
            @[m + i] = @[l.mem + i];
        }
        l.mem = m;
        l.cap = l.cap * 2;
    }
    @[l.mem + l.n] = x;
    l.n = l.n + 1;
}

fonction elem(l: Liste, i) {
    retour @[l.mem + i];
}

fonction poser(l: Liste, i, x) {
    @[l.mem + i] = x;
}

// Texte neuf fait des caractères debut..fin de la liste
fonction texte_de(l: Liste, debut, fin) {
    soit t = nouveau(fin - debut + 1);
    @[t] = fin - debut;
    pour i dans debut..fin {
        @[t + 1 + i - debut] = @[l.mem + i];
    }
    retour t;
}

// --------------------------------------------------------------------------------------------- structures du compilateur
// Jeton : genre 1 identifiant, 2 mot-clé, 3 nombre, 4 opérateur, 5 texte, 6 fin
structure Jeton { genre, val, texte, ligne, suivant: Jeton }

// Noeud de l'arbre : genre (voir les constantes plus bas), op (texte), val, nom (texte), enfants a, b, c,
// liste chaînée d'instructions ou d'arguments (premier), suivant dans une liste, ligne
// zet, zlo, zhi : la zone mémoire d'un accès à un tableau (étage + 1, début, fin) ; copie : boucle recopiée (partition)
structure Noeud { genre, op, val, nom, a: Noeud, b: Noeud, c: Noeud, premier: Noeud, deuxieme: Noeud, suivant: Noeud, ligne,
                  zet, zlo, zhi, copie, expl, el }   // el : dans un corps recopiable, la place du paramètre (1, 2…)

structure Champ { nom, type, suivant: Champ }
structure Struct { nom, champs: Champ, nb, suivant: Struct }
structure Param { nom, type, suivant: Param, usages }   // usages : dans un corps recopiable
// garde : la fonction est générée ; suite : file des fonctions demandées pendant la génération (élagage)
// el : 1 si la fonction peut être recopiée en ligne (retour E), 2 (une instruction), 0 sinon ; el_corps : E ou
// l'instruction ; el_sans : son corps n'écrit rien (sans appel d'une fonction qui ne soit pas pure) ; el_pure : 1
// fonction pure qui lit la mémoire, 2 pure qui ne fait que calculer ; el_actif : en cours de recopie
structure Fonction { nom, params: Param, nb, rtype, corps: Noeud, etiq, ligne, garde, suivant: Fonction, suite: Fonction,
                     er: Liste, ew: Liste, prelude, el, el_corps: Noeud, el_sans, el_pure, el_actif }
structure Constante { nom, val, type, haut, suivant: Constante }
// sorte : 0 tableau d'entiers, 1 de quits, 2 de logiques (32 par mot), 3 de structures (st : son numéro)
structure Tableau { nom, etage, base, taille, sorte, st, suivant: Tableau }
structure Texte { val, etiq, suivant: Texte }
structure Donnee { etage, adr, vals: Liste, etiq, suivant: Donnee }
structure Var { nom, off, type, genre, haut, reg, score, suivant: Var }
structure Boucle { haut, fin, suivant: Boucle }
structure Cumul { nom, suivant: Cumul }

structure Ctx {
    src: Liste,
    jetons: Jeton,
    tok: Jeton,
    structs: Struct,
    fonctions: Fonction,
    der_fonction: Fonction,
    consts: Constante,
    tableaux: Tableau,
    textes: Texte,
    der_texte: Texte,
    ntextes,
    code: Liste,
    etiq: Liste,
    fix_pos: Liste,
    fix_etiq: Liste,
    fix_genre: Liste,
    vars: Var,
    boucles: Boucle,
    ffin,
    fcour: Fonction,
    nselon,
    nrangee,
    nvect,
    blocs: Donnee,
    der_bloc: Donnee,
    vus: Liste,
    segs: Liste,
    nlignes,
    en_prelude,
    optim,              // 1 : les optimisations de vtx.py
    partition,          // 1 : la partition des tâches en accords (plusieurs cœurs)
    naccords,
    copie_libre,
    marques: Liste,     // (adresse, genre 1 tâche / 2 fin, accord, mesure) pour la table des accords
    file_debut: Fonction,
    file_fin: Fonction,
    pile: Liste,        // contexte d'analyse : 1 boucle, 2 boucle en segments, 3 hypothèse
    nseg,
    nhyp,
    cumul_utilise,
    lex_genre,
    lex_val,
    lex_haut,
    tab_w: Liste,       // entier_128 : les mots 1 à 3 des constantes, trois par constante (le noeud et le jeton portent l'indice du premier)
    lignes_dbg,         // 1 : écrire aussi la table adresse -> ligne du programme (pas à pas de l'atelier)
    niter,              // compteur des boucles « pour x dans t » (variables cachées __itN, __ikN)
    tabtextes: Liste,   // typer_textes : les variables qui contiennent un tableau de textes
    tabflot: Liste,     // typer_textes : les variables qui contiennent un tableau de flottants
    dbg: Liste,
    segs_prog: Liste,
    kconst,             // 1 : les constantes du prélude (table à part)
    retour_final,       // 1 : le « retour » en cours est la dernière instruction de la fonction (pas de saut)
    sans_ligne,         // 1 : l'instruction suivante est recopiée en ligne (pas de ligne notée)
    el_prof,            // expansions en ligne l'une dans l'autre
    erreur
}

// genres des noeuds
constante N_NOMBRE = 1;
constante N_VAR = 2;
constante N_ETIQ = 3;
constante N_NON = 4;
constante N_NONLOG = 5;
constante N_BIN = 6;
constante N_LIRE = 7;
constante N_APPEL = 8;
constante N_CHAMP = 9;
constante N_CONSTRUIRE = 10;
constante N_NOUVEAU = 11;
constante N_SOIT = 20;
constante N_AFFECTER = 21;
constante N_ECRIRE = 22;
constante N_ECRIRE_CHAMP = 23;
constante N_SI = 24;
constante N_TANTQUE = 25;
constante N_POUR = 26;
constante N_RETOUR = 27;
constante N_ARRETER = 28;
constante N_CONTINUER = 29;
constante N_EXPR = 30;
constante N_BLIT = 12;       // vrai ou faux : val = code logique (2 ou 1) ; entier 1 ou 0 hors d'un contexte logique
constante N_QNOMBRE = 13;    // inconnu 0, faux 1, vrai 2, variable 3
constante N_QUIT = 14;       // x.q(i)
constante N_RLIRE = 15;      // t[i] d'un tableau de quits ou de logiques : nom du tableau, a = indice
constante N_RECRIRE = 31;
constante N_DONNEES = 32;
constante N_ANNULER = 33;
constante N_ACCORD = 35;     // val = numéro ; premier = les mesures
constante N_MESURE = 36;     // premier = les tâches
constante N_BLOC = 37;       // premier = des instructions
constante N_INFO = 40;       // boucle en segments : val = segments, ligne = numéro, premier = tableaux cumulés
constante CANAUX = 6;
constante ZONE_TOUT = 4;     // étage inconnu
constante ZONE_ES = 5;       // entrées et sorties
constante N_VALIDER = 34;
constante MAX_SEGMENTS = 18;
constante COPIES_DEBUT = 0xE00000;
constante COPIES_FIN = 0xF00000;    // la copie des blocs de données (fonction __init)
constante DRAPEAU = 16777215; // étage 3, dernière adresse : données déjà copiées    // t[i] = v : nom, a = indice, c = valeur, val = numéro des deux variables cachées

// types : 0 entier, 1..T_LOG-1 une référence à la structure de ce numéro, T_LOG le logique
constante T_LOG = 1000000;
constante T_F = 1000001;     // flottant : le flottant quaternaire de 64 bits
constante T_I = 1000002;     // entier_32 : rangé sans signe dans 64 bits
constante T_T = 1000003;
constante T_W = 1000006;     // entier_petuar : deux mots dans R1:R4 (le mot bas d'abord)
constante T_X = 1000007;     // flottant_petuar : le flottant quaternaire de 128 bits, deux mots dans R1:R4
constante T_S = 1000005;     // flottant_32 : le flottant quaternaire de 32 bits
constante T_TF = 1000004;    // flottant[] : la poignée d'un tableau de flottants ; redevient un entier (typer_textes)     // texte : l'adresse d'un bloc ; redevient un entier avant la génération (typer_textes)
constante N_FNOMBRE = 16;    // val = les bits du flottant
constante N_INOMBRE = 17;    // entier_32 écrit (42S) : val
constante N_WNOMBRE = 19;    // entier_petuar : val = mot bas, nom = mot haut
constante N_XNOMBRE = 41;    // flottant_petuar : val = mot bas, nom = mot haut
constante N_SNOMBRE = 18;    // flottant_32 écrit (1.5S) : val = ses bits
constante SIGNE = 9223372036854775808;
constante BITS_V = 0xAAAAAAAAAAAAAAAA;
constante BITS_F = 0x5555555555555555;

fonction est_struct(t) {
    retour t > 0 && t < T_LOG;
}

// « ligne N », ou « fichier, ligne N » pour une ligne venue d'un fichier importé
fonction ecrire_ligne(c: Ctx, ligne) {
    soit k = 0 - 1;
    si c.segs != nul {
        pour i dans 0..c.segs.n / 3 {
            si elem(c.segs, 3 * i) <= ligne {
                k = i;
            }
        }
    }
    si k == 0 - 1 || ligne == 0 {
        ecrire_texte(1, "ligne ");
        ecrire_nombre(1, ligne);
        retour;
    }
    soit fichier = elem(c.segs, 3 * k + 1);
    si fichier != 0 {
        ecrire_texte(1, fichier);
        ecrire_texte(1, ", ");
    }
    ecrire_texte(1, "ligne ");
    ecrire_nombre(1, elem(c.segs, 3 * k + 2) + ligne - elem(c.segs, 3 * k));
}

fonction erreur(c: Ctx, ligne, message) {
    si c.erreur == 0 {
        ecrire_texte(1, "erreur ");
        ecrire_ligne(c, ligne);
        ecrire_texte(1, " : ");
        ecrire_texte(1, message);
        ecrire_car(1, 10);
    }
    c.erreur = 1;
}

// Erreur qui nomme ce qui manque : « message : nom »
fonction erreur_nom(c: Ctx, ligne, message, nom) {
    si c.erreur == 0 {
        ecrire_texte(1, "erreur ");
        ecrire_ligne(c, ligne);
        ecrire_texte(1, " : ");
        ecrire_texte(1, message);
        ecrire_texte(1, " « ");
        ecrire_texte(1, nom);
        ecrire_texte(1, " »\n");
    }
    c.erreur = 1;
}

// --------------------------------------------------------------------------------------------- tables dans les cubes
// Les noms (fonctions, variables, textes, fonctions du prélude, mots-clés, intégrés) sont rangés dans des cubes
// chromatiques de l'étage 3, comme les rayons d'un magasin : un rayon par rôle et par durée de vie (la fréquence du
// cube), une case par nom (le #RRGGBB vient du hachage du nom). Le permanent (mots-clés, intégrés) ; ce qui vit toute
// la compilation (fonctions, constantes, textes, prélude) ; le frais : les variables de la fonction en cours, rayon vidé
// d'un coup à chaque fonction (le cube de transfert jetable). Chaque table occupe trois cubes : la clé (fréquence k),
// la valeur (k + 1) et la distance de la case à la case d'origine du nom (k + 2).
// Hachage Robin Hood : comme l'eau qui se met de niveau. Quand deux noms veulent la même case, celui qui est déjà le
// plus loin de sa case d'origine la garde, l'autre continue ; les distances s'égalisent, et une recherche s'arrête dès
// qu'elle rencontre un nom plus proche de chez lui qu'elle ne l'est (le sien serait déjà rangé avant). Les tables ne
// servent qu'à trouver vite : l'ordre (des fonctions, des textes) reste celui des listes, et les mots ne changent pas.
constante K_MOTS = 20000;          // permanent : les mots-clés
constante K_INTEGRES = 20004;      // permanent : les fonctions intégrées (type rendu, nombre d'arguments)
constante K_SORTES = 20010;        // permanent : la sorte de chaque instruction (épissage), à l'adresse de son code
constante K_FONCTIONS = 6500;      // la compilation : les fonctions
constante K_CONSTANTES = 6000;     // la compilation : les constantes du programme (6004 : celles du prélude)
constante K_TEXTES = 5000;         // la compilation : les textes écrits dans le programme et le prélude
constante K_PRELUDE = 4000;        // la compilation : les fonctions du prélude (lecture à la demande)
constante K_VARS = 3000;           // le frais : les variables et les paramètres de la fonction en cours

// l'adresse longue de la case a du cube de fréquence k (étage 3)
fonction cube_t(k, a) {
    retour 13835058055282163712 | (k << 24) | a;
}

// FNV-1a de 64 bits des caractères u[d..d+n] (la graine mêlée du numéro de la table), replié sur 24 bits
fonction hache_k(k, u, d, n) {
    soit h = 14695981039346656037 ^ (k * 1099511628211);
    soit p = u + 1 + d;
    pour i dans 0..n {
        h = (h ^ @[p + i]) * 1099511628211;
    }
    retour (h ^ (h >> 24) ^ (h >> 48)) & 16777215;
}

// le nom rangé en x est-il u[d..d+n] ?
fonction meme_nom(x, u, d, n) {
    si @[x] != n {
        retour 0;
    }
    soit p = u + 1 + d;
    pour i dans 0..n {
        si @[x + 1 + i] != @[p + i] {
            retour 0;
        }
    }
    retour 1;
}

// la case du nom u[d..d+n] dans la table k, ou -1 s'il n'y est pas
fonction chercher_k(k, u, d, n) {
    soit a = hache_k(k, u, d, n);
    soit dist = 0;
    tantque 1 {
        soit x = @[cube_t(k, a)];
        si x == 0 || @[cube_t(k + 2, a)] < dist {
            retour 0 - 1;                  // une case vide, ou un nom plus proche de chez lui : le nôtre n'y est pas
        }
        si meme_nom(x, u, d, n) {
            retour a;
        }
        a = (a + 1) & 16777215;
        dist = dist + 1;
    }
    retour 0 - 1;
}

// ---- le cube des noms (l'internement) : chaque nom distinct est écrit une seule fois, dans le cube K_TNOMS, et sa
// place y devient son identité. Le lexeur cherche chaque nom une fois dans l'index (Robin Hood, ci-dessus) et rend le nom
// canonique : ensuite, deux noms canoniques sont égaux si et seulement si ce sont les mêmes adresses, et chaque table
// d'un rôle (fonctions, variables, constantes…) est un cube en miroir du cube des noms : la valeur d'un nom est à la
// même place que lui, dans le cube du rôle. Le nom rappelle sa définition, sans hachage ni comparaison de textes.
constante K_NOMS = 7000;           // l'index : contenu -> nom canonique (cherché une fois par nom lu)
constante K_TNOMS = 7100;          // le cube des noms ; la case 0 garde la première place libre

// le nom est-il canonique (écrit dans le cube des noms) ?
fonction est_nom_canon(t) {
    retour (t >> 24) == 824633727932;           // (cube_t(K_TNOMS, 0) >> 24)
}

// le nom canonique des caractères u[d..d+n] : cherché dans l'index ; écrit dans le cube des noms la première fois
fonction nom_sous(u, d, n) {
    soit a = chercher_k(K_NOMS, u, d, n);
    si a != 0 - 1 {
        retour @[cube_t(K_NOMS + 1, a)];
    }
    soit libre = @[cube_t(K_TNOMS, 0)];
    si libre == 0 {
        libre = 1;
    }
    soit t = cube_t(K_TNOMS, libre);
    @[t] = n;
    soit p = u + 1 + d;
    pour i dans 0..n {
        @[t + 1 + i] = @[p + i];
    }
    @[cube_t(K_TNOMS, 0)] = libre + n + 1;
    index_poser(K_NOMS, t, t);
    retour t;
}

// le nom canonique d'un texte (lui-même s'il l'est déjà)
fonction nom_canon(t) {
    si est_nom_canon(t) {
        retour t;
    }
    retour nom_sous(t, 0, @[t]);
}

// l'identité d'un nom : sa place dans le cube des noms
fonction id_nom(t) {
    retour nom_canon(t) & 16777215;
}

// deux noms égaux : deux noms canoniques le sont s'ils ont la même adresse ; sinon on compare les caractères
fonction meme_texte(a, b) {
    retour a == b || (!(est_nom_canon(a) && est_nom_canon(b)) && texte_egal(a, b));
}

// texte_egal, en écartant d'abord sans appel la plupart des textes différents (longueur, premier caractère)
fonction egal(a, b) {
    retour a == b || (@[a] == @[b] && @[a + 1] == @[b + 1] && texte_egal(a, b));
}

// la valeur du nom t dans la table k (0 : absent) : dans le cube k + 1, à la place du nom
fonction table_lire(k, t) {
    retour @[cube_t(k + 1, id_nom(t))];
}

fonction table_lire_sous(k, u, d, n) {
    retour @[cube_t(k + 1, nom_sous(u, d, n) & 16777215)];
}

// la valeur v du nom t dans la table k
fonction table_poser(k, t, v) {
    @[cube_t(k + 1, id_nom(t))] = v;
}

// range dans l'index k le nom t (un texte qui ne bouge plus) et sa valeur v (non nulle) ; un nom déjà là reçoit la
// nouvelle valeur
fonction index_poser(k, t, v) {
    soit a0 = chercher_k(k, t, 0, @[t]);
    si a0 != 0 - 1 {
        @[cube_t(k + 1, a0)] = v;
        retour;
    }
    soit a = hache_k(k, t, 0, @[t]);
    soit dist = 0;
    tantque 1 {
        soit x = @[cube_t(k, a)];
        si x == 0 {
            @[cube_t(k, a)] = t;
            @[cube_t(k + 1, a)] = v;
            @[cube_t(k + 2, a)] = dist;
            retour;
        }
        soit dx = @[cube_t(k + 2, a)];
        si dx < dist {
            // Robin Hood : le plus loin de chez lui prend la case, l'autre continue à sa place
            soit vx = @[cube_t(k + 1, a)];
            @[cube_t(k, a)] = t;
            @[cube_t(k + 1, a)] = v;
            @[cube_t(k + 2, a)] = dist;
            t = x;
            v = vx;
            dist = dx;
        }
        a = (a + 1) & 16777215;
        dist = dist + 1;
    }
}

// le rayon vidé d'un coup : ses trois cubes quittent la mémoire
fonction table_jeter(k) {
    __service(13, cube_t(k, 0));
    __service(13, cube_t(k + 1, 0));
    __service(13, cube_t(k + 2, 0));
}

// range dans la table k chaque nom d'une liste écrite (séparés par des espaces) ; pour les intégrés, la valeur dit le
// type rendu et le nombre d'arguments
fonction ranger_noms(k, noms) {
    soit a = 0;
    tantque a < @[noms] {
        soit b = a;
        tantque b < @[noms] && @[noms + 1 + b] != ' ' {
            b = b + 1;
        }
        soit t = nouveau(b - a + 1);
        @[t] = b - a;
        pour i dans a..b {
            @[t + 1 + i - a] = @[noms + 1 + i];
        }
        si k == K_INTEGRES {
            table_poser(k, t, ((retour_integre_lent(t) + 1) << 8) | (arite_integre_lent(t) + 1));
        } sinon {
            table_poser(k, t, 1);
        }
        a = b + 1;
    }
}

// les mots-clés et les intégrés, rangés une fois au départ
fonction tables_glacees() {
    ranger_noms(K_MOTS, "fonction soit si sinon tantque retour constante pour dans donnees arrêter continuer hypothèse annuler valider selon");
    ranger_noms(K_INTEGRES, "__service addm4 arrondi bas bits brin bruit cmp3 comme_flottant comme_flottant_32 comme_flottant_petuar de_ieee128 de_ieee64 ecrire_car entier entier_128 entier_128_de entier_128_signe entier_32 entier_petuar entier_petuar_de entier_petuar_signe entrée fermer fin_de flottant flottant_128 flottant_32 flottant_64 flottant_petuar flottant_signe gdot gemv haut liberer_brin lire_car marquer_adn marquer_arn max4 min4 mul_haut mul_haut_signe nb_bits ouvrir_ecriture ouvrir_lecture pile qegal racine sortie vers_ieee128 vers_ieee64");
}

fonction est_mot_cle(t) {
    retour table_lire(K_MOTS, t) != 0;
}

// le type rendu par une fonction intégrée (-1 : pas dans la table des conversions)
fonction retour_integre(nom) {
    soit v = table_lire(K_INTEGRES, nom);
    si v == 0 {
        retour 0 - 1;
    }
    retour (v >> 8) - 1;
}

// le nombre d'arguments d'une fonction intégrée (-1 : ce n'en est pas une)
fonction arite_integre(nom) {
    soit v = table_lire(K_INTEGRES, nom);
    si v == 0 {
        retour 0 - 1;
    }
    retour (v & 255) - 1;
}

// la sorte d'une instruction (épissage), calculée une fois par code d'opération
fonction ri_sorte(op) {
    soit a = cube_t(K_SORTES, op & 16777215);
    soit v = @[a];
    si v == 0 {
        v = ri_sorte_lent(op) + 1;
        @[a] = v;
    }
    retour v - 1;
}

fonction fonction_de(c: Ctx, nom): Fonction {
    soit f: Fonction = table_lire(K_FONCTIONS, nom);
    retour f;
}

fonction noter_fonction(f: Fonction) {
    table_poser(K_FONCTIONS, f.nom, bits(f));
}

fonction var_ou_nul(c: Ctx, nom): Var {
    soit v: Var = table_lire(K_VARS, nom);
    retour v;
}

fonction noter_var(c: Ctx) {
    table_poser(K_VARS, c.vars.nom, bits(c.vars));
}

// --------------------------------------------------------------------------------------------- grands entiers
// Chiffres de 16 bits, poids faible d'abord : de quoi lire un flottant décimal exactement, comme Python
// (arrondi correct vers un double, puis du double vers binary32, au plus proche pair).
fonction big(n): Liste {
    soit l = liste();
    tantque n > 0 {
        ajouter(l, n & 65535);
        n = n >> 16;
    }
    retour l;
}

fonction big_norm(a: Liste) {
    tantque a.n > 0 && elem(a, a.n - 1) == 0 {
        a.n = a.n - 1;
    }
}

// a = a * k + d (k et d < 65536)
fonction big_mul_ajoute(a: Liste, k, d) {
    soit r = d;
    pour i dans 0..a.n {
        soit x = elem(a, i) * k + r;
        poser(a, i, x & 65535);
        r = x >> 16;
    }
    tantque r > 0 {
        ajouter(a, r & 65535);
        r = r >> 16;
    }
}

fonction big_bits(a: Liste) {
    big_norm(a);
    si a.n == 0 {
        retour 0;
    }
    soit h = elem(a, a.n - 1);
    soit b = 0;
    tantque h > 0 {
        b = b + 1;
        h = h >> 1;
    }
    retour (a.n - 1) * 16 + b;
}

fonction big_bit(a: Liste, i) {
    si (i >> 4) >= a.n {
        retour 0;
    }
    retour (elem(a, i >> 4) >> (i & 15)) & 1;
}

// -1, 0 ou 1
fonction big_cmp(a: Liste, b: Liste) {
    big_norm(a);
    big_norm(b);
    si a.n != b.n {
        si a.n < b.n { retour 0 - 1; }
        retour 1;
    }
    soit i = a.n;
    tantque i > 0 {
        i = i - 1;
        si elem(a, i) != elem(b, i) {
            si elem(a, i) < elem(b, i) { retour 0 - 1; }
            retour 1;
        }
    }
    retour 0;
}

// a = a - b (a >= b)
fonction big_sub(a: Liste, b: Liste) {
    soit emprunt = 0;
    pour i dans 0..a.n {
        soit y = emprunt;
        si i < b.n {
            y = y + elem(b, i);
        }
        soit x = elem(a, i);
        si x >= y {
            poser(a, i, x - y);
            emprunt = 0;
        } sinon {
            poser(a, i, x + 65536 - y);
            emprunt = 1;
        }
    }
    big_norm(a);
}

fonction big_shl(a: Liste, s): Liste {
    soit r = liste();
    pour i dans 0..(s >> 4) {
        ajouter(r, 0);
    }
    soit k = s & 15;
    soit retenue = 0;
    pour j dans 0..a.n {
        soit x = (elem(a, j) << k) | retenue;
        ajouter(r, x & 65535);
        retenue = x >> 16;
    }
    ajouter(r, retenue);
    big_norm(r);
    retour r;
}

fonction big_shr(a: Liste, s): Liste {
    soit r = liste();
    soit nb = big_bits(a);
    // bit par bit : les nombres sont petits
    pour k dans 0..(nb + 15) / 16 {
        ajouter(r, 0);
    }
    pour b dans s..nb {
        si big_bit(a, b) {
            soit p = b - s;
            poser(r, p >> 4, elem(r, p >> 4) | (1 << (p & 15)));
        }
    }
    big_norm(r);
    retour r;
}

// q = a / b (rendu), r = a % b (dans reste)
fonction big_divmod(a: Liste, b: Liste, reste: Liste): Liste {
    soit q = liste();
    pour k dans 0..a.n + 1 {
        ajouter(q, 0);
    }
    reste.n = 0;
    soit i = big_bits(a);
    tantque i > 0 {
        i = i - 1;
        big_mul_ajoute(reste, 2, big_bit(a, i));
        si big_cmp(reste, b) != 0 - 1 {
            big_sub(reste, b);
            poser(q, i >> 4, elem(q, i >> 4) | (1 << (i & 15)));
        }
    }
    big_norm(q);
    retour q;
}

fonction big_entier(a: Liste) {
    soit v = 0;
    soit i = a.n;
    si i > 4 {
        i = 4;
    }
    tantque i > 0 {
        i = i - 1;
        v = (v << 16) | elem(a, i);
    }
    retour v;
}

// Arrondi au plus proche pair de q / 2^d
fonction big_arrondi(q: Liste, d): Liste {
    si d == 0 {
        retour big_shr(q, 0);
    }
    soit m = big_shr(q, d);
    soit reste = big_shr(q, 0);
    big_sub(reste, big_shl(m, d));
    soit demi = big_shl(big(1), d - 1);
    soit k = big_cmp(reste, demi);
    si k == 1 || (k == 0 && big_bit(m, 0) == 1) {
        big_mul_ajoute(m, 1, 1);
    }
    retour m;
}

// a = a × 10^k (k >= 0), par paquets de quatre chiffres
fonction big_mul10k(a: Liste, k) {
    tantque k >= 4 {
        big_mul_ajoute(a, 10000, 0);
        k = k - 4;
    }
    tantque k > 0 {
        big_mul_ajoute(a, 10, 0);
        k = k - 1;
    }
}

// a >> s, par chiffres de 16 bits (rapide)
fonction big_droite(a: Liste, s): Liste {
    soit r = liste();
    soit q = s >> 4;
    soit b = s & 15;
    soit i = q;
    tantque i < a.n {
        soit lo = elem(a, i) >> b;
        soit hi = 0;
        si b != 0 && i + 1 < a.n {
            hi = (elem(a, i + 1) << (16 - b)) & 65535;
        }
        ajouter(r, lo | hi);
        i = i + 1;
    }
    big_norm(r);
    retour r;
}

// a = a >> 1, sur place (sans prendre de mémoire)
fonction big_droite1(a: Liste) {
    soit r = 0;
    soit i = a.n;
    tantque i > 0 {
        i = i - 1;
        soit x = elem(a, i);
        poser(a, i, (x >> 1) | (r << 15));
        r = x & 1;
    }
    big_norm(a);
}

// 1 si les s bits bas de a ne sont pas tous nuls
fonction big_bas_non_nul(a: Liste, s) {
    soit q = s >> 4;
    pour i dans 0..q {
        si i < a.n && elem(a, i) != 0 {
            retour 1;
        }
    }
    si (s & 15) != 0 && q < a.n && (elem(a, q) & ((1 << (s & 15)) - 1)) != 0 {
        retour 1;
    }
    retour 0;
}

// Le flottant quaternaire le plus proche de n × 10^k (k signé, n > 0 ou nul), au format de P bits de mantisse (P / 2
// quits), d'exposant de ebits bits et de biais donné : Q32 (22, 8, 138), Q64 (52, 10, 537), Q128 (112, 14, 8247).
// Les 64 bits bas dans c.lex_val, les 64 bits hauts (Q128) dans c.lex_haut ; rend 0 si le nombre est trop grand (il
// serait l'infini). La valeur exacte sur P + 4 bits et un bit collant, puis l'arrondi au plus proche (pair au milieu)
// à un exposant binaire pair : le même résultat que qflot.py (Format.depuis).
fonction bits_q(c: Ctx, n: Liste, k, p, ebits, biais) {
    soit w = p + 4;
    soit taille = 2 + ebits + p;
    soit emax = (1 << ebits) - 1;
    soit e = 0;
    soit q = liste();
    si big_bits(n) != 0 {
        soit ordre = k + (big_bits(n) * 30103) / 100000;
        si ordre .> 5000 {
            retour 0;
        }
        si ordre .>= 0 - 5000 {
            soit m = liste();
            soit s = 0;
            soit collant = 0;
            si k .>= 0 {
                // un entier : ses w bits du haut, et le reste en bit collant
                soit a = big_shr(n, 0);
                big_mul10k(a, k);
                soit nb = big_bits(a);
                si nb <= w {
                    m = big_shl(a, w - nb);
                    s = w - nb;
                } sinon {
                    m = big_droite(a, nb - w);
                    collant = big_bas_non_nul(a, nb - w);
                    s = 0 - (nb - w);
                }
            } sinon {
                // n / 10^-k : les w bits du quotient par la division posée, bit à bit, sur w + 1 bits au plus
                soit b = big(1);
                big_mul10k(b, 0 - k);
                s = (w - 1) - (big_bits(n) - big_bits(b));
                soit encore = 1;
                tantque encore {
                    soit ra = big_shr(n, 0);
                    soit bs = big_shr(b, 0);
                    si s .>= 0 {
                        ra = big_shl(n, s);
                    } sinon {
                        bs = big_shl(b, 0 - s);
                    }
                    m = liste();
                    pour z dans 0..(w + 17) / 16 {
                        ajouter(m, 0);
                    }
                    soit i = w + 1;
                    soit bi = big_shl(bs, w);
                    tantque i > 0 {
                        i = i - 1;
                        si big_cmp(ra, bi) != 0 - 1 {
                            big_sub(ra, bi);
                            poser(m, i >> 4, elem(m, i >> 4) | (1 << (i & 15)));
                        }
                        big_droite1(bi);
                    }
                    big_norm(m);
                    big_norm(ra);
                    collant = ra.n != 0;
                    soit nq = big_bits(m);
                    encore = 0;
                    si nq > w {
                        s = s - 1;
                        encore = 1;
                    } sinon si nq < w {
                        s = s + 1;
                        encore = 1;
                    }
                }
            }
            // l'arrondi : une mantisse de p - 1 ou p bits à un exposant binaire pair (des puissances de 4)
            soit ex = 0 - s;
            soit kk = w - p;
            si ((ex + kk) & 1) == 1 {
                kk = kk + 1;
            }
            soit plancher = 2 * (1 - biais);
            si (ex + kk) .< plancher {
                kk = plancher - ex;
            }
            q = big_shr(m, kk);
            soit r = big_shr(m, 0);
            big_sub(r, big_shl(q, kk));
            soit kc = big_cmp(r, big_shl(big(1), kk - 1));
            si kc == 1 || (kc == 0 && (collant || big_bit(q, 0) == 1)) {
                big_mul_ajoute(q, 1, 1);
            }
            ex = ex + kk;
            si big_bits(q) == p + 1 {
                q = big_shr(q, 2);
                ex = ex + 2;
            }
            si big_bits(q) >= p - 1 {
                soit h = 0;
                si ex .< 0 {
                    h = 0 - ((0 - ex) >> 1);
                } sinon {
                    h = ex >> 1;
                }
                e = h + biais;
                si e .>= emax {
                    retour 0;
                }
            }
        }
    }
    // état positif (2), exposant, mantisse
    soit bas_ = big_entier(q);
    soit haut_ = big_entier(big_shr(q, 64));
    si taille > 64 {
        haut_ = haut_ | (e << (p - 64)) | (2 << (taille - 66));
    } sinon {
        bas_ = bas_ | (e << p) | (2 << (taille - 2));
    }
    c.lex_val = bas_;
    c.lex_haut = haut_;
    retour 1;
}

// --------------------------------------------------------------------------------------------- analyse lexicale
fonction lettre(x) {
    retour (x >= 'a' && x <= 'z') || (x >= 'A' && x <= 'Z') || x == '_' || x >= 128;
}

fonction chiffre(x) {
    retour x >= '0' && x <= '9';
}

fonction valeur_hexa(x) {
    si chiffre(x) {
        retour x - '0';
    }
    si x >= 'a' && x <= 'f' {
        retour x - 'a' + 10;
    }
    si x >= 'A' && x <= 'F' {
        retour x - 'A' + 10;
    }
    retour 99;
}

fonction nouveau_jeton(c: Ctx, dernier: Jeton, genre, val, texte, ligne): Jeton {
    soit j = Jeton { genre: genre, val: val, texte: texte, ligne: ligne };
    si dernier == nul {
        c.jetons = j;
    } sinon {
        dernier.suivant = j;
    }
    retour j;
}

// Échappement après une barre oblique inverse : rend le caractère, ou 0 si inconnu
fonction echappe(x) {
    si x == 'n' { retour 10; }
    si x == 't' { retour 9; }
    si x == '0' { retour 0; }
    si x == '\\' || x == '\'' || x == '"' { retour x; }
    retour 4294967295;
}

// opérateurs, du plus long au plus court
fonction operateur(c: Ctx, i) {
    soit s = c.src;
    soit x = elem(s, i);
    soit y = 0;
    soit z = 0;
    si i + 1 < s.n { y = elem(s, i + 1); }
    si i + 2 < s.n { z = elem(s, i + 2); }
    si (x == '<' && y == '<' && z == 'q') || (x == '>' && y == '>' && z == 'q') || (x == '.' && y == '>' && z == '>')
        || (x == '.' && (y == '<' || y == '>') && z == '=') {
        retour 3;
    }
    si (x == '<' && y == '<') || (x == '>' && y == '>') || (x == '<' && y == '=') || (x == '>' && y == '=')
        || (x == '=' && y == '=') || (x == '!' && y == '=') || (x == '&' && y == '&') || (x == '|' && y == '|')
        || (x == '.' && (y == '<' || y == '>' || y == '/' || y == '%' || y == '.')) {
        retour 2;
    }
    si x == '-' || x == '+' || x == '*' || x == '/' || x == '%' || x == '&' || x == '|' || x == '^' || x == '~'
        || x == '<' || x == '>' || x == '=' || x == '@' || x == '[' || x == ']' || x == '(' || x == ')' || x == '{'
        || x == '}' || x == ';' || x == ',' || x == '.' || x == '!' || x == ':' {
        retour 1;
    }
    retour 0;
}

// Après « adn » en position i : "ACGT…" (1 à 64 lettres) ? Rend 1 et range sa valeur dans c.lex_val (jeton entier),
// ou, au-delà de 32 lettres, un entier_petuar (jeton 10, mot haut dans c.lex_haut), sinon 0
fonction valeur_adn(c: Ctx, s: Liste, i) {
    si i >= s.n || elem(s, i) != '"' {
        retour 0;
    }
    soit v = 0;
    soit bv = liste();
    soit k = i + 1;
    tantque k < s.n && elem(s, k) != '"' {
        soit x = elem(s, k);
        si x >= 'a' && x <= 'z' {
            x = x - 32;
        }
        soit q = 0 - 1;
        si x == 'A' { q = 0; }
        si x == 'C' { q = 1; }
        si x == 'G' { q = 2; }
        si x == 'T' || x == 'U' { q = 3; }
        si q == 0 - 1 || k - i > 64 {
            retour 0;
        }
        v = v * 4 + q;
        big_mul_ajoute(bv, 4, q);
        k = k + 1;
    }
    si k >= s.n || k == i + 1 {
        retour 0;
    }
    c.lex_genre = 3;
    c.lex_val = v;
    c.lex_haut = 0;
    si k - i - 1 > 32 {
        c.lex_genre = 10;
        c.lex_val = big_entier(bv);
        c.lex_haut = big_entier(big_shr(bv, 64));
    }
    retour 1;
}

fonction alnum(x) {
    retour lettre(x) || chiffre(x);
}

fonction car_en(s: Liste, i) {
    si i < s.n {
        retour elem(s, i);
    }
    retour 0;
}

// #RRGGBBAA (8 bits par canal) -> point profond #RRRRGGGGBBBBAAAA (chaque octet c devient c × 257)
fonction approfondir(v) {
    soit r = 0;
    pour k dans 0..4 {
        r = r | ((((v >> (8 * k)) & 255) * 257) << (16 * k));
    }
    retour r;
}

// Un nombre à la position i ; rend la position qui suit. Genres : 3 entier (64 bits), 7 flottant (quaternaire, 64 bits),
// 8 entier_32, 9 flottant_32, 10 entier_petuar et 11 flottant_petuar (mot bas dans lex_val, mot haut dans lex_haut).
// Mêmes formes que vtx64.py : 0q…, 0x…, 42, 42S, 0x2AS, 42L, 42LL, 1.5, 1.5e-3, 2e10, 1.5S, 1.5D, 5D, 1.5Q, 5Q.
fonction nombre_lexical(c: Ctx, i, ligne) {
    soit s = c.src;
    c.lex_genre = 3;
    c.lex_haut = 0;
    soit x = elem(s, i);
    soit y = car_en(s, i + 1);
    si x == '0' && y == 'q' && ((car_en(s, i + 2) >= '0' && car_en(s, i + 2) <= '3') || car_en(s, i + 2) == '_') {
        soit v = 0;
        i = i + 2;
        tantque i < s.n && ((elem(s, i) >= '0' && elem(s, i) <= '3') || elem(s, i) == '_') {
            si elem(s, i) != '_' {
                si (v >> 62) != 0 {
                    erreur(c, ligne, "nombre trop grand pour 64 bits");
                }
                v = v * 4 + elem(s, i) - '0';
            }
            i = i + 1;
        }
        c.lex_val = v;
        retour i;
    }
    // chiffres (base 16 après 0x), en grand entier
    soit base = 10;
    soit d = i;
    si x == '0' && y == 'x' && valeur_hexa(car_en(s, i + 2)) < 16 {
        base = 16;
        d = i + 2;
    }
    soit n = liste();
    soit j = d;
    tantque j < s.n && ((base == 10 && chiffre(elem(s, j))) || (base == 16 && valeur_hexa(elem(s, j)) < 16)
        || elem(s, j) == '_') {
        si elem(s, j) != '_' {
            big_mul_ajoute(n, base, valeur_hexa(elem(s, j)));
        }
        j = j + 1;
    }
    // entier_petuar : …LL
    si car_en(s, j) == 'L' && car_en(s, j + 1) == 'L' && !alnum(car_en(s, j + 2)) {
        si big_bits(n) > 128 {
            erreur(c, ligne, "nombre trop grand pour 128 bits");
        }
        c.lex_genre = 10;
        c.lex_val = big_entier(n);
        c.lex_haut = big_entier(big_shr(n, 64));
        retour j + 2;
    }
    // …L : un entier de 64 bits (l'entier par défaut)
    si car_en(s, j) == 'L' && !alnum(car_en(s, j + 1)) {
        si big_bits(n) > 64 {
            erreur(c, ligne, "nombre trop grand pour 64 bits");
        }
        c.lex_val = big_entier(n);
        retour j + 1;
    }
    // …S d'un entier : un entier_32
    si car_en(s, j) == 'S' && !alnum(car_en(s, j + 1)) {
        si big_bits(n) > 32 {
            erreur(c, ligne, "nombre trop grand pour 32 bits");
        }
        c.lex_genre = 8;
        c.lex_val = big_entier(n);
        retour j + 1;
    }
    si base == 10 {
        soit frac = 0;
        soit flottant = 0;
        si car_en(s, j) == '.' && chiffre(car_en(s, j + 1)) {
            flottant = 1;
            j = j + 1;
            tantque j < s.n && (chiffre(elem(s, j)) || elem(s, j) == '_') {
                si elem(s, j) != '_' {
                    big_mul_ajoute(n, 10, elem(s, j) - '0');
                    frac = frac + 1;
                }
                j = j + 1;
            }
        }
        soit ex = 0;
        soit e1 = car_en(s, j);
        soit e2 = car_en(s, j + 1);
        si (e1 == 'e' || e1 == 'E') && (chiffre(e2) || ((e2 == '+' || e2 == '-') && chiffre(car_en(s, j + 2)))) {
            flottant = 1;
            j = j + 1;
            soit neg = 0;
            si elem(s, j) == '+' || elem(s, j) == '-' {
                neg = elem(s, j) == '-';
                j = j + 1;
            }
            tantque j < s.n && chiffre(elem(s, j)) {
                si ex < 100000 {
                    ex = ex * 10 + elem(s, j) - '0';
                }
                j = j + 1;
            }
            si neg {
                ex = 0 - ex;
            }
        }
        si flottant && car_en(s, j) == 'S' && !alnum(car_en(s, j + 1)) {
            si !bits_q(c, n, ex - frac, 22, 8, 138) {
                erreur(c, ligne, "nombre flottant_32 trop grand");
            }
            c.lex_genre = 9;
            retour j + 1;
        }
        si car_en(s, j) == 'Q' && !alnum(car_en(s, j + 1)) {
            si !bits_q(c, n, ex - frac, 112, 14, 8247) {
                erreur(c, ligne, "nombre flottant_petuar trop grand");
            }
            c.lex_genre = 11;
            retour j + 1;
        }
        soit suffixe_d = car_en(s, j) == 'D' && !alnum(car_en(s, j + 1));
        si flottant || suffixe_d {
            si !bits_q(c, n, ex - frac, 52, 10, 537) {
                erreur(c, ligne, "nombre flottant trop grand");
            }
            c.lex_genre = 7;
            si suffixe_d {
                retour j + 1;
            }
            retour j;
        }
    }
    si big_bits(n) > 64 {
        erreur(c, ligne, "nombre trop grand pour 64 bits");
    }
    c.lex_val = big_entier(n);
    retour j;
}

fonction lexer(c: Ctx) {
    soit s = c.src;
    soit i = 0;
    soit ligne = 1;
    soit dernier: Jeton = nul;
    tantque i < s.n && c.erreur == 0 {
        soit x = elem(s, i);
        si x == ' ' || x == 9 || x == 13 {
            i = i + 1;
        } sinon si x == 10 {
            ligne = ligne + 1;
            i = i + 1;
        } sinon si x == '/' && i + 1 < s.n && elem(s, i + 1) == '/' {
            tantque i < s.n && elem(s, i) != 10 {
                i = i + 1;
            }
        } sinon si lettre(x) {
            soit d = i;
            tantque i < s.n && (lettre(elem(s, i)) || chiffre(elem(s, i))) {
                i = i + 1;
            }
            soit t = nom_sous(s.mem - 1, d, i - d);
            soit adn = 0;
            si egal(t, "adn") {
                adn = valeur_adn(c, s, i);
            }
            si adn {
                // adn"ACGT" : A = 0, C = 1, G = 2, T = U = 3, la première lettre la plus forte
                tantque elem(s, i + 1) != '"' {
                    i = i + 1;
                }
                i = i + 2;
                dernier = nouveau_jeton(c, dernier, c.lex_genre, c.lex_val, c.lex_haut, ligne);
            } sinon si egal(t, "et") {
                dernier = nouveau_jeton(c, dernier, 4, 0, "&&", ligne);
            } sinon si egal(t, "ou") {
                dernier = nouveau_jeton(c, dernier, 4, 0, "||", ligne);
            } sinon si egal(t, "non") {
                dernier = nouveau_jeton(c, dernier, 4, 0, "!", ligne);
            } sinon si egal(t, "entree") {
                dernier = nouveau_jeton(c, dernier, 1, 0, "entrée", ligne);
            } sinon si egal(t, "arreter") {
                dernier = nouveau_jeton(c, dernier, 2, 0, "arrêter", ligne);
            } sinon si egal(t, "données") {
                dernier = nouveau_jeton(c, dernier, 2, 0, "donnees", ligne);
            } sinon si egal(t, "hypothese") {
                dernier = nouveau_jeton(c, dernier, 2, 0, "hypothèse", ligne);
            } sinon si est_mot_cle(t) {
                dernier = nouveau_jeton(c, dernier, 2, 0, t, ligne);
            } sinon {
                dernier = nouveau_jeton(c, dernier, 1, 0, t, ligne);
            }
        } sinon si chiffre(x) {
            i = nombre_lexical(c, i, ligne);
            dernier = nouveau_jeton(c, dernier, c.lex_genre, c.lex_val, c.lex_haut, ligne);
        } sinon si x == '#' {
            // #RRGGBB et #RRGGBBAA s'approfondissent ; #RRRRGGGGBBBBAAAA tel quel ; #…16…_…16… et
            // #RRGGBBAA_RRGGBBAA_RRGGBBAA_RRGGBBAA : 128 bits (un entier_petuar)
            soit d2 = i + 1;
            i = i + 1;
            tantque i < s.n && valeur_hexa(elem(s, i)) < 16 {
                i = i + 1;
            }
            soit nh = i - d2;
            soit v2 = 0;
            pour kh dans d2..i {
                v2 = (v2 << 4) | valeur_hexa(elem(s, kh));
            }
            si nh == 8 && car_en(s, i) == '_' && valeur_hexa(car_en(s, i + 1)) < 16 {
                soit pts = liste();
                ajouter(pts, v2);
                pour kp dans 0..3 {
                    i = i + 1;
                    soit vp = 0;
                    pour kh2 dans 0..8 {
                        vp = vp * 16 + valeur_hexa(car_en(s, i));
                        i = i + 1;
                    }
                    ajouter(pts, vp);
                }
                dernier = nouveau_jeton(c, dernier, 10, (elem(pts, 2) << 32) | elem(pts, 3),
                                        (elem(pts, 0) << 32) | elem(pts, 1), ligne);
            } sinon si nh == 16 && car_en(s, i) == '_' && valeur_hexa(car_en(s, i + 1)) < 16 {
                i = i + 1;
                soit vb = 0;
                pour kh3 dans 0..16 {
                    vb = (vb << 4) | valeur_hexa(car_en(s, i));
                    i = i + 1;
                }
                dernier = nouveau_jeton(c, dernier, 10, vb, v2, ligne);
            } sinon si nh == 16 {
                dernier = nouveau_jeton(c, dernier, 3, v2, 0, ligne);
            } sinon {
                si nh == 6 {
                    v2 = v2 << 8;
                }
                dernier = nouveau_jeton(c, dernier, 3, approfondir(v2), 0, ligne);
            }
        } sinon si x == '\'' {
            soit v3 = elem(s, i + 1);
            i = i + 2;
            si v3 == '\\' {
                v3 = echappe(elem(s, i));
                i = i + 1;
            }
            i = i + 1;
            dernier = nouveau_jeton(c, dernier, 3, v3, 0, ligne);
        } sinon si x == '"' {
            soit l = liste();
            i = i + 1;
            tantque i < s.n && elem(s, i) != '"' {
                soit y = elem(s, i);
                si y == '\\' {
                    i = i + 1;
                    y = echappe(elem(s, i));
                }
                ajouter(l, y);
                i = i + 1;
            }
            i = i + 1;
            dernier = nouveau_jeton(c, dernier, 5, 0, texte_de(l, 0, l.n), ligne);
        } sinon {
            soit n = operateur(c, i);
            si n == 0 {
                erreur(c, ligne, "caractère inattendu");
            }
            dernier = nouveau_jeton(c, dernier, 4, 0, nom_sous(s.mem - 1, i, n), ligne);
            i = i + n;
        }
    }
    dernier = nouveau_jeton(c, dernier, 6, 0, 0, ligne);
}

// --------------------------------------------------------------------------------------------- analyse : outils
fonction est_op(c: Ctx, t) {
    retour c.tok.genre == 4 && @[c.tok.texte + 1] == @[t + 1] && egal(c.tok.texte, t);
}

fonction est_kw(c: Ctx, t) {
    retour c.tok.genre == 2 && egal(c.tok.texte, t);
}

fonction est_id(c: Ctx, t) {
    retour c.tok.genre == 1 && egal(c.tok.texte, t);
}

fonction avancer(c: Ctx): Jeton {
    soit j = c.tok;
    si c.tok.genre != 6 {
        c.tok = c.tok.suivant;
    }
    retour j;
}

fonction attendre(c: Ctx, t) {
    si est_op(c, t) {
        avancer(c);
    } sinon {
        erreur_nom(c, c.tok.ligne, "symbole attendu :", t);
    }
}

fonction fin_possible(c: Ctx) {
    retour est_op(c, ";");
}

// Fin d'une instruction : « ; »
fonction fin_instr(c: Ctx) {
    attendre(c, ";");
}

fonction identifiant(c: Ctx) {
    si c.tok.genre != 1 {
        erreur(c, c.tok.ligne, "identifiant attendu");
        retour "?";
    }
    retour avancer(c).texte;
}

// le nom d'une variable ou d'un paramètre : ni un nom de la logique à quatre valeurs, ni celui d'une constante (chaque
// lecture rendrait sinon la constante, pas la variable)
fonction nom_variable(c: Ctx) {
    soit l = c.tok.ligne;
    soit v = identifiant(c);
    si code_logique(v) != 0 - 1 || egal(v, "et4") || egal(v, "ou4") || egal(v, "non4")
            || egal(v, "anti") || egal(v, "fusion") || egal(v, "consensus") || egal(v, "logique")
            || egal(v, "comme_logique") {
        erreur_nom(c, l, "nom réservé de la logique à quatre valeurs :", v);
    } sinon si constante_de(c, v) != nul || egal(v, "nul") {
        erreur_nom(c, l, "une variable ne peut pas porter le nom d'une constante :", v);
    }
    retour v;
}

fonction struct_de(c: Ctx, nom): Struct {
    soit s = c.structs;
    tantque s != nul {
        si meme_texte(s.nom, nom) {
            retour s;
        }
        s = s.suivant;
    }
    retour nul;
}

// type : 0 entier, sinon le numéro de la structure (son rang + 1)
fonction numero_struct(c: Ctx, nom) {
    soit s = c.structs;
    soit k = 1;
    tantque s != nul {
        si egal(s.nom, nom) {
            retour k;
        }
        s = s.suivant;
        k = k + 1;
    }
    retour 0;
}

fonction struct_numero(c: Ctx, k): Struct {
    soit s = c.structs;
    tantque k > 1 && s != nul {
        s = s.suivant;
        k = k - 1;
    }
    retour s;
}

fonction type_opt(c: Ctx) {
    si !est_op(c, ":") {
        retour 0;
    }
    avancer(c);
    soit nom = identifiant(c);
    si egal(nom, "entier") {
        retour 0;
    }
    si egal(nom, "flottant") {
        si est_op(c, "[") {
            // flottant[] : un tableau dynamique de flottants
            avancer(c);
            attendre(c, "]");
            retour T_TF;
        }
        retour T_F;
    }
    si egal(nom, "long") || egal(nom, "entier_64") {
        retour 0;
    }
    si egal(nom, "entier_32") {
        retour T_I;
    }
    si egal(nom, "flottant_64") {
        retour T_F;
    }
    si egal(nom, "flottant_32") {
        retour T_S;
    }
    si egal(nom, "entier_128") || egal(nom, "petuar") || egal(nom, "entier_petuar") {
        retour T_W;
    }
    si egal(nom, "flottant_petuar") || egal(nom, "flottant_128") {
        retour T_X;
    }
    si egal(nom, "logique") {
        retour T_LOG;
    }
    si egal(nom, "texte") {
        retour T_T;
    }
    soit k = numero_struct(c, nom);
    si k == 0 {
        erreur(c, c.tok.ligne, "type inconnu dans le noyau");
    }
    retour k;
}

fonction constante_de(c: Ctx, nom): Constante {
    soit k: Constante = table_lire(K_CONSTANTES + 4 * c.kconst, nom);
    retour k;
}

fonction tableau_de(c: Ctx, nom): Tableau {
    soit t = c.tableaux;
    tantque t != nul {
        si egal(t.nom, nom) {
            retour t;
        }
        t = t.suivant;
    }
    retour nul;
}

fonction etiquette_texte(c: Ctx, t) {
    soit e = table_lire(K_TEXTES, t);
    si e != 0 {
        retour e - 1;
    }
    soit n = Texte { val: t, etiq: nouvelle_etiquette(c) };
    si c.der_texte == nul {
        c.textes = n;
    } sinon {
        c.der_texte.suivant = n;
    }
    c.der_texte = n;
    table_poser(K_TEXTES, t, n.etiq + 1);
    retour n.etiq;
}

fonction noeud(genre, ligne): Noeud {
    retour Noeud { genre: genre, ligne: ligne };
}

fonction bin(op, a: Noeud, b: Noeud, ligne): Noeud {
    retour Noeud { genre: N_BIN, op: op, a: a, b: b, ligne: ligne };
}

fonction nombre(v, ligne): Noeud {
    retour Noeud { genre: N_NOMBRE, val: v, ligne: ligne };
}

// --------------------------------------------------------------------------------------------- expressions
fonction niveau_op(c: Ctx, n) {
    si c.tok.genre != 4 {
        retour 0;
    }
    soit t = c.tok.texte;
    si n == 0 { retour egal(t, "||"); }
    si n == 1 { retour egal(t, "&&"); }
    si n == 2 {
        retour egal(t, "==") || egal(t, "!=") || egal(t, "<") || egal(t, "<=")
            || egal(t, ">") || egal(t, ">=") || egal(t, ".<") || egal(t, ".<=")
            || egal(t, ".>") || egal(t, ".>=");
    }
    si n == 3 { retour egal(t, "|"); }
    si n == 4 { retour egal(t, "^"); }
    si n == 5 { retour egal(t, "&"); }
    si n == 6 {
        retour egal(t, "<<") || egal(t, ">>") || egal(t, "<<q") || egal(t, ">>q")
            || egal(t, ".>>");
    }
    si n == 7 { retour egal(t, "+") || egal(t, "-"); }
    retour egal(t, "*") || egal(t, "/") || egal(t, "%") || egal(t, "./") || egal(t, ".%");
}

// Opérateurs signés : ./ .% .>> .< .<= .> .>= restent dans l'arbre ; le générateur les traduit selon le type (DIVS, MODS,
// SAR ; comparaisons par bascule du bit de signe)
fonction binaire(op, a: Noeud, b: Noeud, l): Noeud {
    retour bin(op, a, b, l);
}

fonction expr(c: Ctx, n): Noeud {
    si n == 9 {
        retour unaire(c);
    }
    soit g = expr(c, n + 1);
    tantque c.erreur == 0 && niveau_op(c, n) {
        soit j = avancer(c);
        g = binaire(j.texte, g, expr(c, n + 1), j.ligne);
    }
    retour g;
}

// La case i d'un tableau dynamique : la poignée (étage 3) contient la longueur, la capacité et l'adresse des données
fonction element_dyn(h: Noeud, i: Noeud, l): Noeud {
    soit d = Noeud { genre: N_LIRE, val: 3, b: bin("+", h, nombre(2, l), l), ligne: l };
    retour Noeud { genre: N_LIRE, val: 3, b: bin("+", d, i, l), ligne: l };
}

fonction unaire(c: Ctx): Noeud {
    soit l = c.tok.ligne;
    si est_op(c, "~") {
        avancer(c);
        retour Noeud { genre: N_NON, a: unaire(c), ligne: l };
    }
    si est_op(c, "!") {
        avancer(c);
        retour Noeud { genre: N_NONLOG, a: unaire(c), ligne: l };
    }
    si est_op(c, "-") {
        avancer(c);
        retour bin("-", nombre(0, l), unaire(c), l);
    }
    soit e = primaire(c);
    tantque c.erreur == 0 && (est_op(c, ".") || est_op(c, "[")) {
        si est_op(c, "[") {
            // t[i] d'un tableau dynamique : la case i de son bloc de données
            avancer(c);
            soit i = expr(c, 0);
            attendre(c, "]");
            e = element_dyn(e, i, l);
            continuer;
        }
        avancer(c);
        soit nom = identifiant(c);
        si egal(nom, "q") {
            attendre(c, "(");
            e = Noeud { genre: N_QUIT, a: e, b: expr(c, 0), ligne: l };
            attendre(c, ")");
        } sinon {
            e = Noeud { genre: N_CHAMP, a: e, nom: nom, ligne: l };
        }
    }
    retour e;
}

// @étage[adresse], @(expression)[adresse] ou @[adresse longue] : rend un noeud N_LIRE (val = étage, 4 pour l'adresse
// longue telle quelle, ou a = étage calculé)
fonction acces(c: Ctx): Noeud {
    soit l = c.tok.ligne;
    attendre(c, "@");
    soit e = noeud(N_LIRE, l);
    si est_op(c, "[") {
        e.val = 4;
    } sinon si est_op(c, "(") {
        avancer(c);
        e.a = expr(c, 0);
        attendre(c, ")");
    } sinon {
        soit j = avancer(c);
        si j.genre == 1 && constante_de(c, j.texte) != nul {
            e.val = constante_de(c, j.texte).val;
        } sinon si j.genre == 3 {
            e.val = j.val;
        } sinon {
            e.val = 99;
        }
        si e.val > 3 {
            erreur(c, l, "numéro d'étage attendu (0 à 3)");
        }
    }
    attendre(c, "[");
    e.b = expr(c, 0);
    attendre(c, "]");
    retour e;
}

fonction arguments(c: Ctx): Noeud {
    soit premier: Noeud = nul;
    soit dernier: Noeud = nul;
    tantque c.erreur == 0 && !est_op(c, ")") {
        soit a = expr(c, 0);
        si dernier == nul {
            premier = a;
        } sinon {
            dernier.suivant = a;
        }
        dernier = a;
        si est_op(c, ",") {
            avancer(c);
        }
    }
    attendre(c, ")");
    retour premier;
}

// Un appel de fonction quelque part dans e ?
fonction contient_appel(e: Noeud) {
    si e == nul {
        retour 0;
    }
    si e.genre == N_APPEL || e.genre == N_CONSTRUIRE || e.genre == N_NOUVEAU {
        retour 1;
    }
    si contient_appel(e.a) || contient_appel(e.b) || contient_appel(e.c) {
        retour 1;
    }
    soit x = e.premier;
    tantque x != nul {
        si contient_appel(x) || contient_appel(x.a) {
            retour 1;
        }
        x = x.suivant;
    }
    retour 0;
}

fonction indice(c: Ctx, t: Tableau, l): Noeud {
    attendre(c, "[");
    soit idx = expr(c, 0);
    attendre(c, "]");
    si idx.genre == N_NOMBRE && idx.val >= t.taille {
        erreur_nom(c, l, "indice hors du tableau", t.nom);
    }
    retour idx;
}

// [i] d'un tableau de quits ou de logiques : l'indice ne doit pas appeler de fonction (il est évalué deux fois)
fonction indice_rangee(c: Ctx, t: Tableau, l): Noeud {
    soit idx = indice(c, t, l);
    si contient_appel(idx) {
        erreur_nom(c, l, "l'indice ne doit pas appeler de fonction (rangez-le d'abord dans une variable) :", t.nom);
    }
    retour idx;
}

// Adresse de t[i] (tableau d'entiers) ou de t[i].champ (tableau de structures)
fonction case_tableau(c: Ctx, t: Tableau, l): Noeud {
    soit idx = indice(c, t, l);
    si t.sorte != 3 {
        si t.base == 0 {
            retour idx;
        }
        retour bin("+", nombre(t.base, l), idx, l);
    }
    attendre(c, ".");
    soit st = struct_numero(c, t.st);
    soit champ = identifiant(c);
    si champ_de(c, st, champ) == nul {
        erreur_nom(c, l, "champ inconnu :", champ);
    }
    soit pos = idx;
    si st.nb != 1 {
        pos = bin("*", idx, nombre(st.nb, l), l);
    }
    retour bin("+", nombre(t.base + position_champ(st, champ), l), pos, l);
}

fonction mots_tableau(c: Ctx, t: Tableau) {
    si t.sorte == 1 || t.sorte == 2 {
        retour (t.taille + 31) / 32;
    }
    si t.sorte == 3 {
        retour t.taille * struct_numero(c, t.st).nb;
    }
    retour t.taille;
}

fonction zoner(c: Ctx, n: Noeud, t: Tableau) {
    n.zet = t.etage + 1;
    n.zlo = t.base;
    n.zhi = t.base + mots_tableau(c, t);
}

fonction primaire(c: Ctx): Noeud {
    soit j = c.tok;
    soit l = j.ligne;
    si j.genre == 3 {
        avancer(c);
        retour nombre(j.val, l);
    }
    si j.genre == 7 {
        avancer(c);
        retour Noeud { genre: N_FNOMBRE, val: j.val, ligne: l };
    }
    si j.genre == 8 {
        avancer(c);
        retour Noeud { genre: N_INOMBRE, val: j.val, ligne: l };
    }
    si j.genre == 9 {
        avancer(c);
        retour Noeud { genre: N_SNOMBRE, val: j.val, ligne: l };
    }
    si j.genre == 10 {
        avancer(c);
        retour Noeud { genre: N_WNOMBRE, val: j.val, nom: j.texte, ligne: l };
    }
    si j.genre == 11 {
        avancer(c);
        retour Noeud { genre: N_XNOMBRE, val: j.val, nom: j.texte, ligne: l };
    }
    si j.genre == 5 {
        avancer(c);
        etiquette_texte(c, j.texte);
        retour Noeud { genre: N_ETIQ, nom: j.texte, ligne: l };
    }
    si est_op(c, "(") {
        avancer(c);
        soit e = expr(c, 0);
        attendre(c, ")");
        retour e;
    }
    si est_op(c, "@") {
        retour acces(c);
    }
    si est_op(c, "[") {
        // [a, b, c] : un tableau dynamique neuf, rempli
        avancer(c);
        soit premier_v: Noeud = nul;
        soit dernier_v: Noeud = nul;
        soit nv = 0;
        tantque c.erreur == 0 && !est_op(c, "]") {
            soit xv = expr(c, 0);
            si dernier_v == nul {
                premier_v = xv;
            } sinon {
                dernier_v.suivant = xv;
            }
            dernier_v = xv;
            nv = nv + 1;
            si est_op(c, ",") {
                avancer(c);
            }
        }
        attendre(c, "]");
        soit tlit = appel1("tableau", nombre(nv, l), l);
        soit klit = 0;
        soit vlit = premier_v;
        tantque vlit != nul {
            soit suite_v = vlit.suivant;
            soit kn = nombre(klit, l);
            tlit.suivant = kn;
            kn.suivant = vlit;
            vlit.suivant = nul;
            tlit = Noeud { genre: N_APPEL, nom: "__remplir", premier: tlit, ligne: l };
            klit = klit + 1;
            vlit = suite_v;
        }
        retour tlit;
    }
    si j.genre != 1 {
        erreur(c, l, "expression attendue");
        avancer(c);
        retour nombre(0, l);
    }
    avancer(c);
    soit v = j.texte;
    si egal(v, "vrai") {
        retour Noeud { genre: N_BLIT, val: 2, ligne: l };
    }
    si egal(v, "faux") {
        retour Noeud { genre: N_BLIT, val: 1, ligne: l };
    }
    si egal(v, "inconnu") {
        retour Noeud { genre: N_QNOMBRE, val: 0, ligne: l };
    }
    si egal(v, "variable") {
        retour Noeud { genre: N_QNOMBRE, val: 3, ligne: l };
    }
    si egal(v, "nul") {
        retour nombre(0, l);
    }
    soit t = tableau_de(c, v);
    si t != nul && est_op(c, "[") {
        si t.sorte == 1 || t.sorte == 2 {
            retour Noeud { genre: N_RLIRE, nom: v, a: indice_rangee(c, t, l), ligne: l };
        }
        soit lu = noeud(N_LIRE, l);
        lu.val = t.etage;
        lu.b = case_tableau(c, t, l);
        lu.nom = t.nom;
        zoner(c, lu, t);
        retour lu;
    }
    soit st = struct_de(c, v);
    si st != nul && est_op(c, "{") {
        avancer(c);
        soit e2 = Noeud { genre: N_CONSTRUIRE, nom: v, ligne: l };
        soit dernier: Noeud = nul;
        tantque c.erreur == 0 && !est_op(c, "}") {
            soit lc = c.tok.ligne;
            soit champ = identifiant(c);
            attendre(c, ":");
            si champ_de(c, st, champ) == nul {
                erreur_nom(c, lc, "champ inconnu dans la construction :", champ);
            }
            soit q = e2.premier;
            tantque q != nul {
                si egal(q.nom, champ) {
                    erreur_nom(c, lc, "champ donné deux fois :", champ);
                }
                q = q.suivant;
            }
            soit paire = Noeud { genre: 0, nom: champ, a: expr(c, 0), ligne: l };
            si dernier == nul {
                e2.premier = paire;
            } sinon {
                dernier.suivant = paire;
            }
            dernier = paire;
            si est_op(c, ",") {
                avancer(c);
            }
        }
        attendre(c, "}");
        retour e2;
    }
    si egal(v, "nouveau_de") && est_op(c, "(") {
        avancer(c);
        soit nom = identifiant(c);
        attendre(c, ")");
        retour Noeud { genre: N_NOUVEAU, nom: nom, ligne: l };
    }
    si est_op(c, "(") {
        avancer(c);
        retour Noeud { genre: N_APPEL, nom: v, premier: arguments(c), ligne: l };
    }
    soit k = constante_de(c, v);
    si k != nul {
        si k.type == T_F {
            retour Noeud { genre: N_FNOMBRE, val: k.val, ligne: l };
        }
        si k.type == T_I {
            retour Noeud { genre: N_INOMBRE, val: k.val, ligne: l };
        }
        si k.type == T_S {
            retour Noeud { genre: N_SNOMBRE, val: k.val, ligne: l };
        }
        si k.type == T_W {
            retour Noeud { genre: N_WNOMBRE, val: k.val, nom: k.haut, ligne: l };
        }
        si k.type == T_X {
            retour Noeud { genre: N_XNOMBRE, val: k.val, nom: k.haut, ligne: l };
        }
        retour nombre(k.val, l);
    }
    retour Noeud { genre: N_VAR, nom: v, ligne: l };
}

// --------------------------------------------------------------------------------------------- instructions
fonction bloc(c: Ctx): Noeud {
    attendre(c, "{");
    soit premier: Noeud = nul;
    soit dernier: Noeud = nul;
    tantque c.erreur == 0 && !est_op(c, "}") && c.tok.genre != 6 {
        soit s = instruction(c);
        si dernier == nul {
            premier = s;
        } sinon {
            dernier.suivant = s;
        }
        dernier = s;
        tantque dernier.suivant != nul {
            dernier = dernier.suivant;
        }
    }
    attendre(c, "}");
    retour premier;
}

// Nom d'une variable cachée : un préfixe suivi d'un numéro
fonction nom_selon(n) {
    retour nom_cache("__selon", n);
}

fonction nom_cache(p, n) {
    soit l = liste();
    pour i dans 0..longueur(p) {
        ajouter(l, car(p, i));
    }
    soit d = liste();
    tantque n > 0 || d.n == 0 {
        ajouter(d, '0' + n % 10);
        n = n / 10;
    }
    soit k = d.n;
    tantque k > 0 {
        k = k - 1;
        ajouter(l, elem(d, k));
    }
    retour texte_de(l, 0, l.n);
}

fonction code_logique(t) {
    si egal(t, "inconnu") { retour 0; }
    si egal(t, "faux") { retour 1; }
    si egal(t, "vrai") { retour 2; }
    si egal(t, "variable") { retour 3; }
    retour 0 - 1;
}

// Une branche de selon : codes logiques (bits 0 à 3 de val) et corps
structure Branche { codes, liste: Noeud, corps: Noeud, ligne, suivant: Branche }

// selon x { vrai { … } faux, inconnu { … } autre { … } } : la valeur est calculée une fois dans une variable cachée,
// puis rendue comme une suite de si / sinon si, exactement comme vtx.py
fonction analyse_selon(c: Ctx, l): Noeud {
    soit x = expr(c, 0);
    attendre(c, "{");
    soit branches: Branche = nul;
    soit autre: Noeud = nul;
    soit a_autre = 0;
    soit vus = 0;
    tantque c.erreur == 0 && !est_op(c, "}") {
        soit l2 = c.tok.ligne;
        si est_id(c, "autre") {
            avancer(c);
            si a_autre {
                erreur(c, l2, "« autre » apparaît deux fois");
            }
            a_autre = 1;
            autre = bloc(c);
        } sinon {
            soit premier: Noeud = nul;
            soit dernier: Noeud = nul;
            soit encore = 1;
            tantque encore && c.erreur == 0 {
                soit ln = c.tok.ligne;
                soit k = 0 - 1;
                si c.tok.genre == 1 {
                    k = code_logique(c.tok.texte);
                }
                si k == 0 - 1 {
                    erreur(c, ln, "branche de « selon » attendue : vrai, faux, inconnu, variable ou autre");
                } sinon si (vus >> k) & 1 {
                    erreur(c, ln, "cette valeur a déjà sa branche");
                }
                vus = vus | (1 << k);
                avancer(c);
                soit q = Noeud { genre: N_QNOMBRE, val: k, ligne: l2 };
                si dernier == nul {
                    premier = q;
                } sinon {
                    dernier.suivant = q;
                }
                dernier = q;
                encore = est_op(c, ",");
                si encore {
                    avancer(c);
                }
            }
            branches = Branche { liste: premier, corps: bloc(c), ligne: l2, suivant: branches };
        }
    }
    attendre(c, "}");
    c.nselon = c.nselon + 1;
    soit tmp = nom_selon(c.nselon);
    // les branches sont déjà dans l'ordre inverse : on construit la chaîne de la dernière à la première
    soit chaine: Noeud = autre;
    soit a_chaine = a_autre;     // un « autre » vide compte : vtx.py émet alors le saut vers la fin
    soit b = branches;
    tantque b != nul {
        soit cond: Noeud = nul;
        soit q2 = b.liste;
        tantque q2 != nul {
            soit suivant = q2.suivant;
            q2.suivant = nul;
            soit t = bin("==", Noeud { genre: N_VAR, nom: tmp, ligne: b.ligne }, q2, b.ligne);
            si cond == nul {
                cond = t;
            } sinon {
                cond = bin("||", cond, t, b.ligne);
            }
            q2 = suivant;
        }
        soit si_ = Noeud { genre: N_SI, a: cond, premier: b.corps, ligne: b.ligne };
        si a_chaine {
            si_.val = 1;
            si_.deuxieme = chaine;
        }
        chaine = si_;
        a_chaine = 1;
        b = b.suivant;
    }
    retour Noeud { genre: N_SOIT, nom: tmp, val: T_LOG, a: x, ligne: l, suivant: chaine };
}

// « f(a): x, y, z; » : des appels en série. Les jetons sont réécrits en « f(a, x); f(a, y); f(a, z); », chaque appel
// portant la ligne de sa valeur ; sans arguments fixes, « f(): x, y; » donne « f(x); f(y); » (comme vtx.py)
fonction jeton_op(j: Jeton, t) {
    retour j.genre == 4 && egal(j.texte, t);
}
fonction jeton_ouvre(j: Jeton) {
    retour j.genre == 4 && (egal(j.texte, "(") || egal(j.texte, "[") || egal(j.texte, "{"));
}
fonction jeton_ferme(j: Jeton) {
    retour j.genre == 4 && (egal(j.texte, ")") || egal(j.texte, "]") || egal(j.texte, "}"));
}
fonction copie_jeton(j: Jeton, ligne): Jeton {
    retour Jeton { genre: j.genre, val: j.val, texte: j.texte, ligne: ligne };
}
fonction serie(c: Ctx) {
    soit j0 = c.tok;
    soit p = j0.suivant;
    si p == nul || !jeton_op(p, "(") {
        retour;
    }
    soit prof = 0;
    soit q = p;
    tantque 1 {
        si q.genre == 6 {
            retour;
        }
        si jeton_ouvre(q) {
            prof = prof + 1;
        } sinon si jeton_ferme(q) {
            prof = prof - 1;
            si prof == 0 {
                arrêter;
            }
        }
        q = q.suivant;
    }
    soit dp = q.suivant;
    si !jeton_op(dp, ":") {
        retour;
    }
    soit fixes = p.suivant != q;
    soit tete: Jeton = nul;
    soit queue: Jeton = nul;
    soit debut = dp.suivant;
    soit k = debut;
    prof = 0;
    tantque 1 {
        si k.genre == 6 {
            erreur(c, j0.ligne, "« ; » attendu à la fin des appels en série");
            retour;
        }
        si prof == 0 && (jeton_op(k, ",") || jeton_op(k, ";")) {
            si k == debut {
                erreur(c, k.ligne, "une valeur attendue dans les appels en série (« f(a): x, y; »)");
                retour;
            }
            soit lv = debut.ligne;
            // f ( fixes [,] valeur ) ;
            soit n = copie_jeton(j0, lv);
            si tete == nul {
                tete = n;
            } sinon {
                queue.suivant = n;
            }
            queue = n;
            soit x = p;
            tantque x != q {
                queue.suivant = copie_jeton(x, lv);
                queue = queue.suivant;
                x = x.suivant;
            }
            si fixes {
                queue.suivant = Jeton { genre: 4, val: 0, texte: ",", ligne: lv };
                queue = queue.suivant;
            }
            x = debut;
            tantque x != k {
                queue.suivant = copie_jeton(x, x.ligne);
                queue = queue.suivant;
                x = x.suivant;
            }
            queue.suivant = Jeton { genre: 4, val: 0, texte: ")", ligne: lv };
            queue = queue.suivant;
            queue.suivant = Jeton { genre: 4, val: 0, texte: ";", ligne: lv };
            queue = queue.suivant;
            si jeton_op(k, ";") {
                arrêter;
            }
            debut = k.suivant;
        } sinon si jeton_ouvre(k) {
            prof = prof + 1;
        } sinon si jeton_ferme(k) {
            prof = prof - 1;
        }
        k = k.suivant;
    }
    // le premier jeton devient celui de la série : on le remplace sur place (le jeton d'avant pointe vers lui)
    j0.genre = tete.genre;
    j0.val = tete.val;
    j0.texte = tete.texte;
    j0.ligne = tete.ligne;
    j0.suivant = tete.suivant;
    queue.suivant = k.suivant;
}

fonction instruction(c: Ctx): Noeud {
    si c.tok.genre == 1 {
        serie(c);
    }
    soit l = c.tok.ligne;
    si est_kw(c, "soit") {
        avancer(c);
        soit s = noeud(N_SOIT, l);
        s.nom = nom_variable(c);
        soit annote = est_op(c, ":");
        s.val = type_opt(c);
        si annote && s.val == 0 {
            s.expl = 1;             // « soit x: entier = … » : le type écrit est gardé (entier)
        }
        attendre(c, "=");
        s.a = expr(c, 0);
        fin_instr(c);
        retour s;
    }
    si est_kw(c, "si") {
        avancer(c);
        soit s2 = noeud(N_SI, l);
        s2.a = expr(c, 0);
        s2.premier = bloc(c);
        si est_kw(c, "sinon") {
            avancer(c);
            s2.val = 1;
            si est_kw(c, "si") {
                s2.deuxieme = instruction(c);
            } sinon {
                s2.deuxieme = bloc(c);
            }
        }
        retour s2;
    }
    si est_kw(c, "selon") {
        avancer(c);
        retour analyse_selon(c, l);
    }
    si est_kw(c, "tantque") {
        avancer(c);
        soit s3 = noeud(N_TANTQUE, l);
        s3.a = expr(c, 0);
        ajouter(c.pile, 1);
        s3.premier = bloc(c);
        c.pile.n = c.pile.n - 1;
        retour s3;
    }
    si est_kw(c, "hypothèse") {
        avancer(c);
        pour k dans 0..c.pile.n {
            si elem(c.pile, k) == 2 {
                erreur(c, l, "pas d'hypothèse dans une boucle en segments");
            }
        }
        c.nhyp = c.nhyp + 1;
        soit nh = c.nhyp;
        ajouter(c.pile, 3);
        soit corps = bloc(c);
        c.pile.n = c.pile.n - 1;
        retour bloc_hypothese(c, nh, abaisser_liste(c, corps), l);
    }
    si est_kw(c, "annuler") || est_kw(c, "valider") {
        soit g = N_ANNULER;
        si est_kw(c, "valider") {
            g = N_VALIDER;
        }
        avancer(c);
        fin_instr(c);
        si c.pile.n == 0 || elem(c.pile, c.pile.n - 1) != 3 {
            erreur(c, l, "« annuler » ou « valider » doit être directement dans une hypothèse, hors de toute boucle");
        }
        retour noeud(g, l);
    }
    si est_kw(c, "pour") {
        avancer(c);
        soit s4 = noeud(N_POUR, l);
        s4.nom = nom_variable(c);
        soit annot = type_opt(c);
        si !est_kw(c, "dans") {
            erreur(c, l, "« dans » attendu");
        }
        avancer(c);
        s4.a = expr(c, 0);
        si !est_op(c, "..") {
            // pour x dans t { … } : chaque case d'un tableau dynamique, dans l'ordre
            c.niter = c.niter + 1;
            soit tt = nom_cache("__it", c.niter);
            soit kk = nom_cache("__ik", c.niter);
            soit st0 = Noeud { genre: N_SOIT, nom: tt, a: s4.a, ligne: l };
            si annot != 0 && annot != T_T && annot != T_F {
                erreur(c, l, "la variable d'une boucle « pour … dans » est un entier, un flottant ou un texte");
            }
            soit el = element_dyn(var_n(tt, l), var_n(kk, l), l);
            si annot == T_F {
                el = appel1_de("comme_flottant", el, l);
            }
            soit x = Noeud { genre: N_SOIT, nom: s4.nom, val: annot, op: "chaque", a: el, ligne: l };
            s4.nom = kk;
            s4.a = nombre(0, l);
            s4.b = appel1("longueur", var_n(tt, l), l);
            s4.val = 1;
            ajouter(c.pile, 1);
            x.suivant = bloc(c);
            c.pile.n = c.pile.n - 1;
            s4.premier = x;
            st0.suivant = s4;
            retour st0;
        }
        si annot != 0 {
            erreur(c, l, "une boucle entre deux bornes compte en entiers : pas de type ici");
        }
        attendre(c, "..");
        s4.b = expr(c, 0);
        s4.val = 1;
        si est_id(c, "par") {
            avancer(c);
            s4.val = valeur_constante(c, expr(c, 0));
            si s4.val < 1 || s4.val > 2147483647 {
                erreur(c, l, "pas de boucle invalide");
            }
        }
        soit nseg = 0;
        si est_id(c, "en") {
            avancer(c);
            nseg = 12;
            si c.tok.genre == 3 {
                nseg = avancer(c).val;
            }
            si !est_id(c, "segments") {
                erreur(c, c.tok.ligne, "« segments » attendu après « en »");
            }
            avancer(c);
            si nseg < 2 || nseg > MAX_SEGMENTS {
                erreur(c, l, "nombre de segments entre 2 et 18");
            }
            si s4.val != 1 {
                erreur(c, l, "une boucle en segments avance de 1 en 1");
            }
            nseg = ((nseg + CANAUX - 1) / CANAUX) * CANAUX;   // multiple du nombre de cylindres
        }
        soit cumul: Cumul = nul;
        si nseg != 0 && est_id(c, "cumulant") {
            avancer(c);
            soit encore = 1;
            tantque encore && c.erreur == 0 {
                soit ln = c.tok.ligne;
                soit tn = tableau_de(c, c.tok.texte);
                si c.tok.genre != 1 || tn == nul {
                    erreur(c, ln, "nom de tableau attendu après « cumulant »");
                } sinon si tn.sorte == 1 || tn.sorte == 2 {
                    erreur(c, ln, "un tableau de quits ou de logiques ne peut pas être cumulé");
                }
                soit nc = Cumul { nom: avancer(c).texte };
                si cumul == nul {
                    cumul = nc;
                } sinon {
                    soit dc = cumul;
                    tantque dc.suivant != nul {
                        dc = dc.suivant;
                    }
                    dc.suivant = nc;
                }
                encore = est_op(c, ",");
                si encore {
                    avancer(c);
                }
            }
        }
        si nseg != 0 {
            ajouter(c.pile, 2);
        } sinon {
            ajouter(c.pile, 1);
        }
        s4.premier = bloc(c);
        c.pile.n = c.pile.n - 1;
        si nseg == 0 {
            retour s4;
        }
        // sans optimisation, une boucle en segments est une boucle ordinaire entre deux bornes calculées une fois
        verifier_segment(c, s4.nom, s4.premier);
        si cumul != nul {
            verifier_cumul(c, s4.premier, cumul);
            c.cumul_utilise = 1;
        }
        c.nseg = c.nseg + 1;
        soit sa = nom_cache("__sa", c.nseg);
        soit sb = nom_cache("__sb", c.nseg);
        soit p1 = Noeud { genre: N_SOIT, nom: sa, a: s4.a, ligne: l };
        soit p2 = Noeud { genre: N_SOIT, nom: sb, a: s4.b, ligne: l };
        s4.a = var_n(sa, l);
        s4.b = var_n(sb, l);
        s4.op = "segments";          // pas de réécriture en 32 : vtx64.py ne réécrit pas une boucle en segments
        soit info = Noeud { genre: N_INFO, val: nseg, ligne: c.nseg };
        soit dcu: Noeud = nul;
        soit cu = cumul;
        tantque cu != nul {
            soit vn = var_n(cu.nom, l);
            si dcu == nul {
                info.premier = vn;
            } sinon {
                dcu.suivant = vn;
            }
            dcu = vn;
            cu = cu.suivant;
        }
        s4.c = info;
        p1.suivant = p2;
        p2.suivant = s4;
        retour p1;
    }
    si est_kw(c, "retour") {
        pour kr dans 0..c.pile.n {
            si elem(c.pile, kr) == 3 {
                erreur(c, l, "« retour » interdit dans une hypothèse : validez ou annulez d'abord");
            }
        }
        avancer(c);
        soit s5 = noeud(N_RETOUR, l);
        si !fin_possible(c) {
            s5.a = expr(c, 0);
        }
        fin_instr(c);
        retour s5;
    }
    si est_kw(c, "arrêter") || est_kw(c, "continuer") {
        soit ga = N_ARRETER;
        si est_kw(c, "continuer") {
            ga = N_CONTINUER;
        }
        avancer(c);
        fin_instr(c);
        si c.pile.n > 0 && elem(c.pile, c.pile.n - 1) == 3 {
            erreur(c, l, "« arrêter » ou « continuer » ne peut pas sortir d'une hypothèse : utilisez annuler ou valider");
        }
        retour noeud(ga, l);
    }
    si est_id(c, "tableau") && c.tok.suivant.genre == 1 && c.tok.suivant.suivant.genre == 4
        && egal(c.tok.suivant.suivant.texte, "[") {
        // tableau t[n]; dans une fonction : un tableau dynamique de n cases (sur le tas)
        avancer(c);
        soit st = noeud(N_SOIT, l);
        st.nom = nom_variable(c);
        attendre(c, "[");
        st.a = appel1("tableau", expr(c, 0), l);
        attendre(c, "]");
        fin_instr(c);
        retour st;
    }
    si est_op(c, "@") {
        soit m = acces(c);
        attendre(c, "=");
        soit s6 = Noeud { genre: N_ECRIRE, val: m.val, a: m.a, b: m.b, ligne: l };
        s6.c = expr(c, 0);
        fin_instr(c);
        retour s6;
    }
    si c.tok.genre == 1 && tableau_de(c, c.tok.texte) != nul && c.tok.suivant.genre == 4
        && egal(c.tok.suivant.texte, "[") {
        soit t = tableau_de(c, avancer(c).texte);
        si t.sorte == 1 || t.sorte == 2 {
            soit r = Noeud { genre: N_RECRIRE, nom: t.nom, a: indice_rangee(c, t, l), ligne: l };
            c.nrangee = c.nrangee + 1;
            r.val = c.nrangee;
            attendre(c, "=");
            r.c = expr(c, 0);
            fin_instr(c);
            retour r;
        }
        soit s7 = Noeud { genre: N_ECRIRE, val: t.etage, nom: t.nom, ligne: l };
        zoner(c, s7, t);
        s7.b = case_tableau(c, t, l);
        attendre(c, "=");
        s7.c = expr(c, 0);
        fin_instr(c);
        retour s7;
    }
    si c.tok.genre == 1 && c.tok.suivant.genre == 4 && egal(c.tok.suivant.texte, "=") {
        soit s8 = noeud(N_AFFECTER, l);
        s8.nom = avancer(c).texte;
        avancer(c);
        s8.a = expr(c, 0);
        fin_instr(c);
        retour s8;
    }
    soit e = expr(c, 0);
    si est_op(c, "=") {
        avancer(c);
        si e.genre == N_LIRE {
            soit sl = Noeud { genre: N_ECRIRE, val: e.val, a: e.a, b: e.b, ligne: l };
            sl.c = expr(c, 0);
            fin_instr(c);
            retour sl;
        }
        si e.genre != N_CHAMP {
            erreur(c, l, "affectation impossible");
        }
        soit s9 = Noeud { genre: N_ECRIRE_CHAMP, a: e.a, nom: e.nom, ligne: l };
        s9.c = expr(c, 0);
        fin_instr(c);
        retour s9;
    }
    fin_instr(c);
    retour Noeud { genre: N_EXPR, a: e, ligne: l };
}

// --------------------------------------------------------------------------------------------- 32 éléments d'un coup
// Réécrit « pour i dans a..b { T[i] = … ; } » sur des tableaux de quits ou de logiques quand chaque élément ne dépend
// que des éléments de même indice, par des opérations quit par quit : les mots entiers sont traités 32 éléments d'un
// coup ; le début et la fin, qui ne remplissent pas un mot, restent traités un par un. Même règle que vtx.py.

// Une réduction : « n = n + E » (genre 1, somme) ou « si E1 == E2 { n = n + 1; } » (genre 2 ; 3 pour !=)
structure Reduction { nom, genre, e1: Noeud, e2: Noeud, suivant: Reduction }

fonction meme_var(e: Noeud, nom) {
    retour e != nul && e.genre == N_VAR && egal(e.nom, nom);
}

fonction var_n(nom, l): Noeud {
    retour Noeud { genre: N_VAR, nom: nom, ligne: l };
}

fonction appel1(nom, a: Noeud, l): Noeud {
    retour Noeud { genre: N_APPEL, nom: nom, premier: a, ligne: l };
}

fonction reduction(s: Noeud): Reduction {
    si s.genre == N_AFFECTER && s.a.genre == N_BIN && egal(s.a.op, "+") && meme_var(s.a.a, s.nom) {
        retour Reduction { nom: s.nom, genre: 1, e1: s.a.b };
    }
    si s.genre == N_SI && s.val == 0 && s.a.genre == N_BIN && (egal(s.a.op, "==") || egal(s.a.op, "!="))
        && s.premier != nul && s.premier.suivant == nul {
        soit x = s.premier;
        si x.genre == N_AFFECTER && x.a.genre == N_BIN && egal(x.a.op, "+") && meme_var(x.a.a, x.nom)
            && x.a.b.genre == N_NOMBRE && x.a.b.val == 1 {
            soit g = 2;
            si egal(s.a.op, "!=") {
                g = 3;
            }
            retour Reduction { nom: x.nom, genre: g, e1: s.a.a, e2: s.a.b };
        }
    }
    retour nul;
}

// Le noeud e (ou ses enfants, ou ses listes) lit-il la variable nom ?
fonction lit_var(e: Noeud, nom) {
    si e == nul {
        retour 0;
    }
    si meme_var(e, nom) || lit_var(e.a, nom) || lit_var(e.b, nom) || lit_var(e.c, nom) {
        retour 1;
    }
    retour lit_liste(e.premier, nom) || lit_liste(e.deuxieme, nom);
}

fonction lit_liste(x: Noeud, nom) {
    tantque x != nul {
        si lit_var(x, nom) {
            retour 1;
        }
        x = x.suivant;
    }
    retour 0;
}

// Sortes des tableaux rangés lus dans e : bit 1 quits, bit 2 logiques
fonction sortes_lues(c: Ctx, e: Noeud) {
    si e == nul {
        retour 0;
    }
    soit m = sortes_lues(c, e.a) | sortes_lues(c, e.b) | sortes_lues(c, e.c) | sortes_liste(c, e.premier)
        | sortes_liste(c, e.deuxieme);
    si e.genre == N_RLIRE {
        m = m | (1 << tableau_de(c, e.nom).sorte);
    }
    retour m;
}

fonction sortes_liste(c: Ctx, x: Noeud) {
    soit m = 0;
    tantque x != nul {
        m = m | sortes_lues(c, x);
        x = x.suivant;
    }
    retour m;
}

fonction quit_par_quit(nom, sorte) {
    si sorte == 2 {
        retour op_logique(nom) != 0;
    }
    retour egal(nom, "min4") || egal(nom, "max4") || egal(nom, "addm4") || egal(nom, "cmp3")
        || egal(nom, "qegal");
}

// La valeur d'un élément ne tient-elle que dans son quit (les 31 autres à 0) ?
fonction propre(e: Noeud) {
    soit g = e.genre;
    si g == N_RLIRE || g == N_QNOMBRE || g == N_BLIT {
        retour 1;
    }
    si g == N_NOMBRE {
        retour e.val <= 3;
    }
    si g == N_APPEL {
        si egal(e.nom, "comme_logique") {
            retour 1;
        }
        si egal(e.nom, "cmp3") || egal(e.nom, "qegal") {
            retour 0;
        }
        soit x = e.premier;
        tantque x != nul {
            si !propre(x) {
                retour 0;
            }
            x = x.suivant;
        }
        retour 1;
    }
    si g == N_BIN {
        retour propre(e.a) && propre(e.b);
    }
    retour 0;
}

// Le même calcul sur 32 éléments à la fois, ou nul si un élément pourrait dépendre d'un autre
fonction mot_vectoriel(c: Ctx, e: Noeud, var, sorte, vk): Noeud {
    soit g = e.genre;
    soit l = e.ligne;
    si g == N_RLIRE {
        soit t = tableau_de(c, e.nom);
        si !meme_var(e.a, var) || t.sorte != sorte {
            retour nul;
        }
        soit k = var_n(vk, l);
        si t.base != 0 {
            k = bin("+", nombre(t.base, l), k, l);
        }
        retour Noeud { genre: N_LIRE, val: t.etage, b: k, ligne: l, zet: t.etage + 1, zlo: t.base,
                       zhi: t.base + (t.taille + 31) / 32 };
    }
    si sorte == 2 && (g == N_QNOMBRE || g == N_BLIT) {
        retour nombre(e.val * BITS_F, l);
    }
    si sorte == 1 && g == N_NOMBRE {
        retour nombre((e.val & 3) * BITS_F, l);
    }
    si g == N_APPEL {
        soit a = e.premier;
        si (egal(e.nom, "comme_logique") || egal(e.nom, "entier")) && a != nul && a.suivant == nul {
            retour mot_vectoriel(c, a, var, sorte, vk);
        }
        si quit_par_quit(e.nom, sorte) {
            soit premier: Noeud = nul;
            soit dernier: Noeud = nul;
            tantque a != nul {
                soit w = mot_vectoriel(c, a, var, sorte, vk);
                si w == nul {
                    retour nul;
                }
                si dernier == nul {
                    premier = w;
                } sinon {
                    dernier.suivant = w;
                }
                dernier = w;
                a = a.suivant;
            }
            retour Noeud { genre: N_APPEL, nom: e.nom, premier: premier, ligne: e.ligne };
        }
        retour nul;
    }
    si sorte == 1 && g == N_BIN && (egal(e.op, "&") || egal(e.op, "|") || egal(e.op, "^")) {
        soit wa = mot_vectoriel(c, e.a, var, sorte, vk);
        soit wb = mot_vectoriel(c, e.b, var, sorte, vk);
        si wa == nul || wb == nul {
            retour nul;
        }
        retour bin(e.op, wa, wb, l);
    }
    retour nul;
}

// Copie profonde d'une liste d'instructions (la boucle de fin a son propre corps, comme dans vtx.py)
fonction copier(n: Noeud): Noeud {
    si n == nul {
        retour nul;
    }
    retour Noeud { genre: n.genre, op: n.op, val: n.val, nom: n.nom, a: copier(n.a), b: copier(n.b), c: copier(n.c),
                   premier: copier_liste(n.premier), deuxieme: copier_liste(n.deuxieme), ligne: n.ligne,
                   zet: n.zet, zlo: n.zlo, zhi: n.zhi, copie: n.copie, expl: n.expl };
}

fonction copier_liste(x: Noeud): Noeud {
    soit premier: Noeud = nul;
    soit dernier: Noeud = nul;
    tantque x != nul {
        soit y = copier(x);
        si dernier == nul {
            premier = y;
        } sinon {
            dernier.suivant = y;
        }
        dernier = y;
        x = x.suivant;
    }
    retour premier;
}

// Les écritures de tableaux rangés d'une copie reçoivent leurs propres variables cachées
fonction renumeroter(c: Ctx, x: Noeud): Noeud {
    soit y = x;
    tantque y != nul {
        si y.genre == N_RECRIRE {
            c.nrangee = c.nrangee + 1;
            y.val = c.nrangee;
        }
        renumeroter(c, y.premier);
        renumeroter(c, y.deuxieme);
        y = y.suivant;
    }
    retour x;
}

fonction un_bit(m) {
    retour m == 2 || m == 4;
}

fonction boucle_vectorielle(c: Ctx, st: Noeud): Noeud {
    soit corps = st.premier;
    si corps == nul {
        retour nul;
    }
    soit var = st.nom;
    soit l = st.ligne;
    soit reds: Reduction = nul;
    soit der: Reduction = nul;
    soit sortes = 0;
    soit s = corps;
    tantque s != nul {
        si s.genre == N_RECRIRE && meme_var(s.a, var) {
            sortes = sortes | (1 << tableau_de(c, s.nom).sorte);
        } sinon {
            soit r = reduction(s);
            si r == nul || egal(r.nom, var) {
                retour nul;
            }
            si der == nul {
                reds = r;
            } sinon {
                der.suivant = r;
            }
            der = r;
        }
        s = s.suivant;
    }
    // accumulateurs distincts, et lus seulement par leur propre mise à jour
    soit r1 = reds;
    tantque r1 != nul {
        soit r2 = r1.suivant;
        tantque r2 != nul {
            si egal(r1.nom, r2.nom) {
                retour nul;
            }
            r2 = r2.suivant;
        }
        r1 = r1.suivant;
    }
    s = corps;
    tantque s != nul {
        soit propre_r: Reduction = nul;
        si s.genre != N_RECRIRE {
            propre_r = reduction(s);
        }
        r1 = reds;
        tantque r1 != nul {
            si lit_var(s, r1.nom) && !(propre_r != nul && egal(propre_r.nom, r1.nom)) {
                retour nul;
            }
            r1 = r1.suivant;
        }
        s = s.suivant;
    }
    sortes = sortes | sortes_liste(c, corps);
    si !un_bit(sortes) {
        retour nul;
    }
    soit sorte = 1;
    si sortes == 4 {
        sorte = 2;
    }
    soit n = c.nvect + 1;
    soit vk = nom_cache("__vk", n);
    // les écritures de mots
    soit mots: Noeud = nul;
    soit dm: Noeud = nul;
    s = corps;
    tantque s != nul {
        si s.genre == N_RECRIRE && meme_var(s.a, var) {
            soit w = mot_vectoriel(c, s.c, var, sorte, vk);
            si w == nul {
                retour nul;
            }
            soit t = tableau_de(c, s.nom);
            soit k = var_n(vk, s.ligne);
            si t.base != 0 {
                k = bin("+", nombre(t.base, s.ligne), k, s.ligne);
            }
            soit e = Noeud { genre: N_ECRIRE, val: t.etage, b: k, c: w, ligne: s.ligne, zet: t.etage + 1, zlo: t.base,
                             zhi: t.base + (t.taille + 31) / 32 };
            si dm == nul {
                mots = e;
            } sinon {
                dm.suivant = e;
            }
            dm = e;
        }
        s = s.suivant;
    }
    // les réductions : 32 éléments comptés d'un coup
    r1 = reds;
    tantque r1 != nul {
        soit w1 = mot_vectoriel(c, r1.e1, var, sorte, vk);
        soit w2: Noeud = nul;
        soit lu = sortes_lues(c, r1.e1);
        soit pr = propre(r1.e1);
        si r1.genre != 1 {
            w2 = mot_vectoriel(c, r1.e2, var, sorte, vk);
            lu = lu | sortes_lues(c, r1.e2);
            pr = pr && propre(r1.e2);
            si w2 == nul {
                retour nul;
            }
        }
        si w1 == nul || lu == 0 || !pr {
            retour nul;
        }
        soit compte: Noeud = nul;
        si r1.genre == 1 {
            si sorte != 1 {
                retour nul;
            }
            compte = bin("+", appel1("nb_bits", bin("&", w1, nombre(BITS_F, l), l), l),
                bin("*", nombre(2, l), appel1("nb_bits", bin("&", w1, nombre(BITS_V, l), l), l), l), l);
        } sinon {
            w1.suivant = w2;
            compte = appel1("nb_bits", appel1("qegal", w1, l), l);
            si r1.genre == 3 {
                compte = bin("-", nombre(32, l), compte, l);
            }
        }
        soit maj = Noeud { genre: N_AFFECTER, nom: r1.nom, a: bin("+", var_n(r1.nom, l), compte, l), ligne: l };
        si dm == nul {
            mots = maj;
        } sinon {
            dm.suivant = maj;
        }
        dm = maj;
        r1 = r1.suivant;
    }
    c.nvect = n;
    soit va = nom_cache("__va", n);
    soit vb = nom_cache("__vb", n);
    soit vh = nom_cache("__vh", n);
    soit vt = nom_cache("__vt", n);
    soit quinze = Noeud { genre: N_NON, a: nombre(31, l), ligne: l };
    soit s1 = Noeud { genre: N_SOIT, nom: va, a: st.a, ligne: l };
    soit s2 = Noeud { genre: N_SOIT, nom: vb, a: st.b, ligne: l };
    soit s3 = Noeud { genre: N_SOIT, nom: vh, a: bin("&", bin("+", var_n(va, l), nombre(31, l), l), quinze, l), ligne: l };
    soit s4 = Noeud { genre: N_SI, a: bin(">", var_n(vh, l), var_n(vb, l), l),
                      premier: Noeud { genre: N_AFFECTER, nom: vh, a: var_n(vb, l), ligne: l }, ligne: l };
    soit s5 = Noeud { genre: N_SOIT, nom: vt, a: bin("&", var_n(vb, l), Noeud { genre: N_NON, a: nombre(31, l), ligne: l }, l), ligne: l };
    soit s6 = Noeud { genre: N_SI, a: bin("<", var_n(vt, l), var_n(vh, l), l),
                      premier: Noeud { genre: N_AFFECTER, nom: vt, a: var_n(vh, l), ligne: l }, ligne: l };
    soit s7 = Noeud { genre: N_POUR, nom: var, a: var_n(va, l), b: var_n(vh, l), premier: corps, val: 1, ligne: l };
    soit s8 = Noeud { genre: N_POUR, nom: vk, a: bin(">>", var_n(vh, l), nombre(5, l), l),
                      b: bin(">>", var_n(vt, l), nombre(5, l), l), premier: mots, val: 1, ligne: l };
    soit s9 = Noeud { genre: N_POUR, nom: var, a: var_n(vt, l), b: var_n(vb, l), premier: renumeroter(c, copier_liste(corps)), val: 1, ligne: l };
    s1.suivant = s2;
    s2.suivant = s3;
    s3.suivant = s4;
    s4.suivant = s5;
    s5.suivant = s6;
    s6.suivant = s7;
    s7.suivant = s8;
    s8.suivant = s9;
    retour s1;
}

fonction vectoriser(c: Ctx, s: Noeud): Noeud {
    soit tete: Noeud = nul;
    soit dernier: Noeud = nul;
    tantque s != nul {
        soit suivant = s.suivant;
        soit r: Noeud = nul;
        si s.genre == N_POUR && s.val == 1 && s.op == 0 {
            r = boucle_vectorielle(c, s);
        }
        si r == nul {
            r = s;
            si s.genre == N_POUR || s.genre == N_TANTQUE || s.genre == N_SI {
                s.premier = vectoriser(c, s.premier);
            }
            si s.genre == N_SI {
                s.deuxieme = vectoriser(c, s.deuxieme);
            }
            s.suivant = nul;
        }
        si dernier == nul {
            tete = r;
        } sinon {
            dernier.suivant = r;
        }
        dernier = r;
        tantque dernier.suivant != nul {
            dernier = dernier.suivant;
        }
        s = suivant;
    }
    retour tete;
}

// --------------------------------------------------------------------------------------------- segments
// Un segment doit être indépendant des autres : il ne modifie aucune variable déclarée hors de la boucle, ni sa variable
// de boucle, et n'en sort pas (arrêter au premier niveau, retour).
fonction declarees(s: Noeud, l: Liste) {
    tantque s != nul {
        si s.genre == N_SOIT || s.genre == N_POUR {
            ajouter(l, s.nom);
        }
        si s.genre == N_POUR || s.genre == N_TANTQUE || s.genre == N_SI {
            declarees(s.premier, l);
        }
        si s.genre == N_SI && s.val == 1 {
            declarees(s.deuxieme, l);
        }
        s = s.suivant;
    }
}

fonction dans_liste(l: Liste, t) {
    pour i dans 0..l.n {
        si egal(elem(l, i), t) {
            retour 1;
        }
    }
    retour 0;
}

fonction verifier_seg(c: Ctx, s: Noeud, var, internes: Liste, profondeur) {
    tantque s != nul {
        si s.genre == N_AFFECTER && (!dans_liste(internes, s.nom) || egal(s.nom, var)) {
            erreur_nom(c, s.ligne, "un segment ne peut pas modifier une variable déclarée hors de la boucle (chaque segment doit être indépendant : écrivez plutôt dans un tableau, à la case de l'indice) :", s.nom);
        }
        si s.genre == N_ARRETER && profondeur == 0 {
            erreur(c, s.ligne, "« arrêter » ne peut pas sortir d'une boucle en segments");
        }
        si s.genre == N_RETOUR {
            erreur(c, s.ligne, "« retour » interdit dans une boucle en segments");
        }
        si s.genre == N_SI {
            verifier_seg(c, s.premier, var, internes, profondeur);
            si s.val == 1 {
                verifier_seg(c, s.deuxieme, var, internes, profondeur);
            }
        } sinon si s.genre == N_TANTQUE || s.genre == N_POUR {
            verifier_seg(c, s.premier, var, internes, profondeur + 1);
        }
        s = s.suivant;
    }
}

fonction verifier_segment(c: Ctx, var, corps: Noeud) {
    soit internes = liste();
    declarees(corps, internes);
    soit garde = liste();
    pour i dans 0..internes.n {
        si !egal(elem(internes, i), var) {
            ajouter(garde, elem(internes, i));
        }
    }
    verifier_seg(c, corps, var, garde, 0);
}

// Deux expressions identiques (sans les numéros de ligne) ?
fonction meme_expr(a: Noeud, b: Noeud) {
    si a == nul || b == nul {
        retour a == b;
    }
    si a.genre != b.genre || a.val != b.val {
        retour 0;
    }
    si (a.op != 0) != (b.op != 0) || (a.op != 0 && !egal(a.op, b.op)) {
        retour 0;
    }
    soit large_c = a.genre == N_WNOMBRE || a.genre == N_XNOMBRE;
    si !large_c && ((a.nom != 0) != (b.nom != 0) || (a.nom != 0 && !egal(a.nom, b.nom))) {
        retour 0;
    }
    si large_c && a.nom != b.nom {
        retour 0;
    }
    si !meme_expr(a.a, b.a) || !meme_expr(a.b, b.b) || !meme_expr(a.c, b.c) {
        retour 0;
    }
    soit x = a.premier;
    soit y = b.premier;
    tantque x != nul && y != nul {
        si !meme_expr(x, y) {
            retour 0;
        }
        x = x.suivant;
        y = y.suivant;
    }
    retour x == nul && y == nul;
}

fonction est_cumule(cumul: Cumul, nom) {
    si nom == 0 {
        retour 0;
    }
    soit k = cumul;
    tantque k != nul {
        si egal(k.nom, nom) {
            retour 1;
        }
        k = k.suivant;
    }
    retour 0;
}

fonction lit_cumule(e: Noeud, cumul: Cumul) {
    retour e != nul && e.genre == N_LIRE && est_cumule(cumul, e.nom);
}

// Aucune lecture d'un tableau cumulé dans e
fonction interdit_cumul(c: Ctx, e: Noeud, cumul: Cumul, ligne) {
    si e == nul {
        retour;
    }
    si lit_cumule(e, cumul) {
        erreur_nom(c, ligne, "un tableau cumulé ne peut être lu que dans « T[x] = T[x] + valeur » :", e.nom);
        retour;
    }
    interdit_cumul(c, e.a, cumul, ligne);
    interdit_cumul(c, e.b, cumul, ligne);
    interdit_cumul(c, e.c, cumul, ligne);
    soit x = e.premier;
    tantque x != nul {
        interdit_cumul(c, x, cumul, ligne);
        interdit_cumul(c, x.a, cumul, ligne);
        x = x.suivant;
    }
}

// Chaque tableau cumulé ne sert qu'à des additions T[e] = T[e] + v (ou - v), v sans tableau cumulé
fonction verifier_cumul(c: Ctx, s: Noeud, cumul: Cumul) {
    tantque s != nul && c.erreur == 0 {
        si s.genre == N_ECRIRE && est_cumule(cumul, s.nom) {
            soit v = s.c;
            soit bon = 0;
            si v.genre == N_BIN && (egal(v.op, "+") || egal(v.op, "-")) {
                si lit_cumule(v.a, cumul) && egal(v.a.nom, s.nom) && meme_expr(v.a.b, s.b) {
                    interdit_cumul(c, v.b, cumul, s.ligne);
                    bon = 1;
                } sinon si egal(v.op, "+") && lit_cumule(v.b, cumul) && egal(v.b.nom, s.nom) && meme_expr(v.b.b, s.b) {
                    interdit_cumul(c, v.a, cumul, s.ligne);
                    bon = 1;
                }
            }
            si !bon {
                erreur_nom(c, s.ligne, "un tableau cumulé ne s'écrit que sous la forme « T[x] = T[x] + valeur » (ou « - valeur ») :", s.nom);
            }
            interdit_cumul(c, s.b, cumul, s.ligne);
        } sinon si s.genre == N_SI {
            interdit_cumul(c, s.a, cumul, s.ligne);
            verifier_cumul(c, s.premier, cumul);
            si s.val == 1 {
                verifier_cumul(c, s.deuxieme, cumul);
            }
        } sinon si s.genre == N_TANTQUE {
            interdit_cumul(c, s.a, cumul, s.ligne);
            verifier_cumul(c, s.premier, cumul);
        } sinon si s.genre == N_POUR {
            interdit_cumul(c, s.a, cumul, s.ligne);
            interdit_cumul(c, s.b, cumul, s.ligne);
            verifier_cumul(c, s.premier, cumul);
        } sinon {
            interdit_cumul(c, s.a, cumul, s.ligne);
            interdit_cumul(c, s.b, cumul, s.ligne);
            interdit_cumul(c, s.c, cumul, s.ligne);
            soit x = s.premier;
            tantque x != nul {
                interdit_cumul(c, x, cumul, s.ligne);
                x = x.suivant;
            }
        }
        s = s.suivant;
    }
}

// --------------------------------------------------------------------------------------------- hypothèses
// Les accès aux tableaux de quits et de logiques traduits tout de suite en accès aux mots (comme vtx.py avant de
// journaliser les écritures d'une hypothèse)
fonction abaisser_expr(c: Ctx, e: Noeud): Noeud {
    si e == nul {
        retour nul;
    }
    e.a = abaisser_expr(c, e.a);
    e.b = abaisser_expr(c, e.b);
    e.c = abaisser_expr(c, e.c);
    soit premier: Noeud = nul;
    soit dernier: Noeud = nul;
    soit x = e.premier;
    tantque x != nul {
        soit suivant = x.suivant;
        soit y = abaisser_expr(c, x);
        y.suivant = nul;
        si dernier == nul {
            premier = y;
        } sinon {
            dernier.suivant = y;
        }
        dernier = y;
        x = suivant;
    }
    e.premier = premier;
    si e.genre == N_RLIRE {
        retour rangee_basse(c, e);
    }
    retour e;
}

fonction abaisser_liste(c: Ctx, s: Noeud): Noeud {
    soit tete: Noeud = nul;
    soit dernier: Noeud = nul;
    tantque s != nul {
        soit suivant = s.suivant;
        soit r = s;
        s.suivant = nul;
        si s.genre == N_RECRIRE {
            // soit __qi = i ; soit __qv = v ; mot = (mot & ~(3 << d)) | ((__qv & 3) << d)
            soit t = tableau_de(c, s.nom);
            soit l = s.ligne;
            c.nrangee = c.nrangee + 1;
            soit ni = nom_cache("__qi", c.nrangee);
            soit nv = nom_cache("__qv", c.nrangee);
            soit v = abaisser_expr(c, s.c);
            si t.sorte == 2 {
                v = Noeud { genre: N_APPEL, nom: "__code_logique", premier: v, ligne: l };
            }
            soit s1 = Noeud { genre: N_SOIT, nom: ni, a: abaisser_expr(c, s.a), ligne: l };
            soit s2 = Noeud { genre: N_SOIT, nom: nv, a: v, ligne: l };
            soit m = mot_rangee(t, var_n(ni, l), l);
            soit d = decalage_rangee(var_n(ni, l), l);
            soit garde = bin("&", m, Noeud { genre: N_NON, a: bin("<<", nombre(3, l), d, l), ligne: l }, l);
            soit neuf = bin("|", garde, bin("<<", bin("&", var_n(nv, l), nombre(3, l), l), d, l), l);
            s1.suivant = s2;
            s2.suivant = Noeud { genre: N_ECRIRE, val: t.etage, b: m.b, c: neuf, ligne: l, zet: m.zet, zlo: m.zlo, zhi: m.zhi };
            r = s1;
        } sinon {
            s.a = abaisser_expr(c, s.a);
            s.b = abaisser_expr(c, s.b);
            s.c = abaisser_expr(c, s.c);
            si s.genre == N_SI || s.genre == N_TANTQUE || s.genre == N_POUR {
                s.premier = abaisser_liste(c, s.premier);
                s.deuxieme = abaisser_liste(c, s.deuxieme);
            } sinon {
                s.premier = abaisser_expr_liste(c, s.premier);
            }
        }
        si dernier == nul {
            tete = r;
        } sinon {
            dernier.suivant = r;
        }
        dernier = r;
        tantque dernier.suivant != nul {
            dernier = dernier.suivant;
        }
        s = suivant;
    }
    retour tete;
}

fonction abaisser_expr_liste(c: Ctx, x: Noeud): Noeud {
    soit premier: Noeud = nul;
    soit dernier: Noeud = nul;
    tantque x != nul {
        soit suivant = x.suivant;
        soit y = abaisser_expr(c, x);
        y.suivant = nul;
        si dernier == nul {
            premier = y;
        } sinon {
            dernier.suivant = y;
        }
        dernier = y;
        x = suivant;
    }
    retour premier;
}

fonction appel_hyp(nom, a: Noeud, l): Noeud {
    retour Noeud { genre: N_EXPR, a: Noeud { genre: N_APPEL, nom: nom, premier: a, ligne: l }, ligne: l };
}

// Les écritures mémoire d'une hypothèse sont notées (étage, adresse, ancienne valeur) avant d'être faites
fonction journaliser(c: Ctx, s: Noeud, n, cpt: Liste): Noeud {
    soit tete: Noeud = nul;
    soit dernier: Noeud = nul;
    tantque s != nul {
        soit suivant = s.suivant;
        s.suivant = nul;
        soit r = s;
        soit l = s.ligne;
        si s.genre == N_ECRIRE {
            si s.a == nul && s.val == 0 {
                erreur(c, l, "écriture dans l'étage 0 interdite dans une hypothèse");
            }
            poser(cpt, 0, elem(cpt, 0) + 1);
            soit ta = nom_cache2(n, elem(cpt, 0));
            soit s1 = Noeud { genre: N_SOIT, nom: ta, a: s.b, ligne: l };
            s.zet = 0;
            s.nom = 0;
            s.b = var_n(ta, l);
            si s.a == nul && s.val == 4 {
                s.a = bin(">>", var_n(ta, l), nombre(62, l), l);     // @[a] : l'étage est dans l'adresse
            }
            si s.a == nul {
                s1.suivant = appel_hyp("__hyp_noter", nombre(s.val, l), l);
                s1.suivant.a.premier.suivant = var_n(ta, l);
                s1.suivant.suivant = s;
            } sinon {
                poser(cpt, 0, elem(cpt, 0) + 1);
                soit te = nom_cache2(n, elem(cpt, 0));
                soit s2 = Noeud { genre: N_SOIT, nom: te, a: s.a, ligne: l };
                s1.suivant = s2;
                s2.suivant = appel_hyp("__hyp_noter", var_n(te, l), l);
                s2.suivant.a.premier.suivant = var_n(ta, l);
                s2.suivant.suivant = s;
                s.a = var_n(te, l);
            }
            r = s1;
        } sinon si s.genre == N_ANNULER {
            r = appel_hyp("__hyp_annuler", var_n(nom_cache("__h", n), l), l);
            r.suivant = noeud(N_ARRETER, l);
        } sinon si s.genre == N_VALIDER {
            r = appel_hyp("__hyp_valider", nul, l);
            r.suivant = noeud(N_ARRETER, l);
        } sinon si (s.genre == N_SI || s.genre == N_TANTQUE || s.genre == N_POUR) && s.op == 0 {
            s.premier = journaliser(c, s.premier, n, cpt);
            si s.genre == N_SI && s.val == 1 {
                s.deuxieme = journaliser(c, s.deuxieme, n, cpt);
            }
        }
        si dernier == nul {
            tete = r;
        } sinon {
            dernier.suivant = r;
        }
        dernier = r;
        tantque dernier.suivant != nul {
            dernier = dernier.suivant;
        }
        s = suivant;
    }
    retour tete;
}

fonction nom_cache2(n, k) {
    soit l = liste();
    ajouter_texte(l, nom_cache("__t", n));
    ajouter(l, '_');
    soit d = liste();
    tantque k > 0 || d.n == 0 {
        ajouter(d, '0' + k % 10);
        k = k / 10;
    }
    soit i = d.n;
    tantque i > 0 {
        i = i - 1;
        ajouter(l, elem(d, i));
    }
    retour texte_de(l, 0, l.n);
}

// Bloc d'hypothèse -> boucle à un tour : annuler défait les écritures notées, valider (ou la fin du bloc) les garde
fonction bloc_hypothese(c: Ctx, n, corps: Noeud, l): Noeud {
    soit cpt = liste();
    ajouter(cpt, 0);
    soit entree = Noeud { genre: N_SOIT, nom: nom_cache("__h", n), a: Noeud { genre: N_APPEL, nom: "__hyp_debut", ligne: l }, ligne: l };
    entree.suivant = journaliser(c, corps, n, cpt);
    soit d = entree;
    tantque d.suivant != nul {
        d = d.suivant;
    }
    d.suivant = appel_hyp("__hyp_valider", nul, l);
    retour Noeud { genre: N_POUR, nom: nom_cache("__hk", n), a: nombre(0, l), b: nombre(1, l), val: 1, premier: entree, ligne: l };
}

// --------------------------------------------------------------------------------------------- déclarations
fonction valeur_constante(c: Ctx, e: Noeud) {
    si e.genre == N_NOMBRE || e.genre == N_FNOMBRE || e.genre == N_SNOMBRE || e.genre == N_INOMBRE {
        retour e.val;
    }
    si e.genre == N_BIN && egal(e.op, "-") && e.a.genre == N_NOMBRE && e.a.val == 0 && e.b.genre == N_FNOMBRE {
        retour e.b.val ^ 13835058055282163712;
    }
    si e.genre == N_BLIT {
        retour e.val == 2;
    }
    si e.genre == N_NON {
        retour ~valeur_constante(c, e.a);
    }
    si e.genre == N_BIN {
        soit x = valeur_constante(c, e.a);
        soit y = valeur_constante(c, e.b);
        soit o = e.op;
        si egal(o, "+") { retour x + y; }
        si egal(o, "-") { retour x - y; }
        si egal(o, "*") { retour x * y; }
        si egal(o, "/") { retour x / y; }
        si egal(o, "%") { retour x % y; }
        si egal(o, "<<") { retour x << y; }
        si egal(o, ">>") { retour x >> y; }
        si egal(o, "&") { retour x & y; }
        si egal(o, "|") { retour x | y; }
        si egal(o, "^") { retour x ^ y; }
        si egal(o, "<<q") {
            si y >= 32 { retour 0; }
            retour x << (2 * y);
        }
        si egal(o, ">>q") {
            si y >= 32 { retour 0; }
            retour x >> (2 * y);
        }
    }
    erreur(c, e.ligne, "expression constante attendue");
    retour 0;
}

// Les données : une fonction __init, appelée au début de principal, les copie une seule fois (au premier lancement)
fonction injecter_donnees(c: Ctx) {
    si c.blocs == nul {
        retour;
    }
    soit l = 0;
    soit copie = Noeud { genre: N_DONNEES, ligne: l };
    copie.suivant = Noeud { genre: N_ECRIRE, val: 3, b: nombre(DRAPEAU, l), c: nombre(1, l), ligne: l };
    soit cond = bin("==", Noeud { genre: N_LIRE, val: 3, b: nombre(DRAPEAU, l), ligne: l }, nombre(0, l), l);
    soit f = Fonction { nom: "__init", corps: Noeud { genre: N_SI, a: cond, premier: copie, ligne: l }, etiq: nouvelle_etiquette(c) };
    soit p = fonction_de(c, "principal");
    si p != nul {
        soit appel = Noeud { genre: N_EXPR, a: Noeud { genre: N_APPEL, nom: "__init", ligne: l }, ligne: l };
        appel.suivant = p.corps;
        p.corps = appel;
    }
    si c.der_fonction == nul {
        c.fonctions = f;
    } sinon {
        c.der_fonction.suivant = f;
    }
    c.der_fonction = f;
    noter_fonction(f);
}

fonction une_constante(c: Ctx) {
    soit nom = identifiant(c);
    attendre(c, "=");
    soit ec = expr(c, 0);
    fin_instr(c);
    // flottant ou long (éventuellement précédé de -), sinon expression entière constante
    soit neg = ec.genre == N_BIN && egal(ec.op, "-") && ec.a.genre == N_NOMBRE && ec.a.val == 0;
    soit xc = ec;
    si neg {
        xc = ec.b;
    }
    soit k = Constante { nom: nom, suivant: c.consts };
    si xc.genre == N_FNOMBRE {
        k.type = T_F;
        k.val = xc.val;
        si neg {
            k.val = xc.val ^ 13835058055282163712;          // l'état C (négatif) et G (positif) s'échangent
        }
    } sinon si xc.genre == N_SNOMBRE {
        k.type = T_S;
        k.val = xc.val;
        si neg {
            k.val = xc.val ^ 3221225472;
        }
    } sinon si xc.genre == N_INOMBRE {
        k.type = T_I;
        k.val = xc.val;
        si neg {
            k.val = (0 - xc.val) & 4294967295;
        }
    } sinon si xc.genre == N_WNOMBRE {
        k.type = T_W;
        k.val = xc.val;
        k.haut = xc.nom;
        si neg {
            // complément à deux sur 128 bits : la retenue passe au mot haut quand le mot bas est nul
            k.val = 0 - xc.val;
            k.haut = ~xc.nom + (xc.val == 0);
        }
    } sinon si xc.genre == N_XNOMBRE {
        k.type = T_X;
        k.val = xc.val;
        k.haut = xc.nom;
        si neg && ((xc.nom >> 62) == 1 || (xc.nom >> 62) == 2) {
            k.haut = xc.nom ^ 13835058055282163712;          // inconnu et variable restent eux-mêmes
        }
    } sinon {
        k.val = valeur_constante(c, ec);
    }
    c.consts = k;
    table_poser(K_CONSTANTES + 4 * c.kconst, c.consts.nom, bits(c.consts));
}

fonction un_tableau(c: Ctx) {
    soit t = Tableau { nom: identifiant(c) };
    attendre(c, "[");
    t.taille = valeur_constante(c, expr(c, 0));
    attendre(c, "]");
    si est_id(c, "de") {
        avancer(c);
        soit l2 = c.tok.ligne;
        soit sorte = identifiant(c);
        si egal(sorte, "quits") {
            t.sorte = 1;
        } sinon si egal(sorte, "logique") {
            t.sorte = 2;
        } sinon {
            t.st = numero_struct(c, sorte);
            si t.st == 0 {
                erreur_nom(c, l2, "structure inconnue :", sorte);
            }
            t.sorte = 3;
        }
    }
    soit m = acces(c);
    t.etage = m.val;
    t.base = valeur_constante(c, m.b);
    fin_instr(c);
    t.suivant = c.tableaux;
    c.tableaux = t;
}

fonction programme(c: Ctx) {
    tantque c.erreur == 0 && c.tok.genre != 6 {
        soit l = c.tok.ligne;
        si est_kw(c, "constante") {
            avancer(c);
            une_constante(c);
        } sinon si est_id(c, "structure") {
            avancer(c);
            soit nom2 = identifiant(c);
            soit s = Struct { nom: nom2 };
            si c.structs == nul {
                c.structs = s;
            } sinon {
                soit d = c.structs;
                tantque d.suivant != nul {
                    d = d.suivant;
                }
                d.suivant = s;
            }
            attendre(c, "{");
            soit dernier: Champ = nul;
            tantque c.erreur == 0 && !est_op(c, "}") {
                soit ch = Champ { nom: identifiant(c) };
                ch.type = type_opt(c);
                si dernier == nul {
                    s.champs = ch;
                } sinon {
                    dernier.suivant = ch;
                }
                dernier = ch;
                s.nb = s.nb + 1;
                si est_op(c, ";") || est_op(c, ",") {
                    avancer(c);
                }
            }
            attendre(c, "}");
            si est_op(c, ";") {
                avancer(c);
            }
        } sinon si est_kw(c, "donnees") {
            avancer(c);
            soit m2 = acces(c);
            si m2.a != nul {
                erreur(c, l, "étage constant attendu dans donnees");
            }
            soit dd = Donnee { etage: m2.val, adr: valeur_constante(c, m2.b), vals: liste(), etiq: nouvelle_etiquette(c) };
            attendre(c, "=");
            attendre(c, "{");
            tantque c.erreur == 0 && !est_op(c, "}") {
                ajouter(dd.vals, valeur_constante(c, expr(c, 0)));
                si est_op(c, ",") {
                    avancer(c);
                }
            }
            attendre(c, "}");
            fin_instr(c);
            si c.der_bloc == nul {
                c.blocs = dd;
            } sinon {
                c.der_bloc.suivant = dd;
            }
            c.der_bloc = dd;
        } sinon si est_id(c, "tableau") {
            avancer(c);
            un_tableau(c);
        } sinon si est_kw(c, "fonction") {
            avancer(c);
            soit f = Fonction { nom: identifiant(c), ligne: l };
            attendre(c, "(");
            soit dp: Param = nul;
            tantque c.erreur == 0 && !est_op(c, ")") {
                soit p = Param { nom: nom_variable(c) };
                p.type = type_opt(c);
                si dp == nul {
                    f.params = p;
                } sinon {
                    dp.suivant = p;
                }
                dp = p;
                f.nb = f.nb + 1;
                si est_op(c, ",") {
                    avancer(c);
                }
            }
            attendre(c, ")");
            f.rtype = type_opt(c);
            f.etiq = nouvelle_etiquette(c);
            // une fonction du prélude cède la place à celle du programme qui porte le même nom
            soit garder = 1;
            si fonction_de(c, f.nom) != nul {
                garder = 0;
                si !c.en_prelude {
                    erreur_nom(c, l, "fonction déjà définie :", f.nom);
                }
            }
            f.prelude = c.en_prelude;
            si garder {
                si c.der_fonction == nul {
                    c.fonctions = f;
                } sinon {
                    c.der_fonction.suivant = f;
                }
                c.der_fonction = f;
                noter_fonction(f);
            }
            f.corps = vectoriser(c, bloc(c));
        } sinon {
            erreur(c, l, "déclaration attendue");
        }
    }
}

// --------------------------------------------------------------------------------------------- code machine du SPU-64
// Un mot d'instruction : opération (16 bits), d, s, t (4 bits chacun, puis 4 bits nuls), imm (32 bits).
fonction ins(op, d, s, t, imm) {
    retour (op << 48) | (d << 44) | (s << 40) | (t << 36) | (imm & 4294967295);
}

fonction emettre(c: Ctx, w) {
    ajouter(c.code, w);
}

fonction rrr(c: Ctx, op, d, s, t) {
    emettre(c, ins(op, d, s, t, 0));
}

fonction rri(c: Ctx, op, d, s, imm) {
    emettre(c, ins(op, d, s, 0, imm));
}

fonction rr(c: Ctx, op, d, s) {
    emettre(c, ins(op, d, s, 0, 0));
}

fonction mov(c: Ctx, d, s) {
    emettre(c, ins(11, d, s, 0, 0));
}

fonction cmp(c: Ctx, a, b) {
    emettre(c, ins(14, 0, a, b, 0));
}

fonction cmpi(c: Ctx, a, v) {
    emettre(c, ins(15, 0, a, 0, v));
}

fonction pousser(c: Ctx, r) {
    emettre(c, ins(39, 0, r, 0, 0));
}

fonction depiler(c: Ctx, r) {
    emettre(c, ins(40, r, 0, 0, 0));
}

fonction ldf(c: Ctx, r, off) {
    emettre(c, ins(37, r, 0, 0, off));
}

fonction stf(c: Ctx, r, off) {
    emettre(c, ins(38, r, 0, 0, off));
}

// LD d,s,#off : d = M[S + off] ; ST a,v,#off : M[A + off] = V
fonction ld(c: Ctx, d, s, off) {
    emettre(c, ins(32, d, s, 0, off));
}

fonction st(c: Ctx, a, v, off) {
    emettre(c, ins(33, a, v, 0, off));
}

fonction ldis(c: Ctx, r, v) {
    emettre(c, ins(24, r, 0, 0, v));
}

fonction nouvelle_etiquette(c: Ctx) {
    ajouter(c.etiq, 0 - 1);
    retour c.etiq.n - 1;
}

fonction poser_etiquette(c: Ctx, e) {
    poser(c.etiq, e, c.code.n);
}

fonction saut(c: Ctx, op, e) {
    ajouter(c.fix_pos, c.code.n);
    ajouter(c.fix_etiq, e);
    ajouter(c.fix_genre, 0);
    emettre(c, ins(op, 0, 0, 0, 0));
}

fonction ldi_etiquette(c: Ctx, r, e) {
    emettre(c, ins(10, r, 0, 0, 0));
    ajouter(c.fix_pos, c.code.n);
    ajouter(c.fix_etiq, e);
    ajouter(c.fix_genre, 1);
    emettre(c, 0);
}

// une constante de 64 bits : LDIS (32 bits signés), LDIU (32 bits sans signe) ou LDI (le mot suivant)
fonction charger(c: Ctx, r, v) {
    si v < 2147483648 || v >= 18446744071562067968 {
        ldis(c, r, v);
    } sinon si v <= 4294967295 {
        emettre(c, ins(25, r, 0, 0, v));
    } sinon {
        emettre(c, ins(10, r, 0, 0, 0));
        emettre(c, v);
    }
}

// --------------------------------------------------------------------------------------------- types
fonction var_de(c: Ctx, nom, ligne): Var {
    soit v = var_ou_nul(c, nom);
    si v != nul {
        retour v;
    }
    erreur_nom(c, ligne, "variable inconnue :", nom);
    retour Var { nom: nom };
}

fonction champ_de(c: Ctx, st: Struct, nom): Champ {
    soit ch = st.champs;
    tantque ch != nul {
        si meme_texte(ch.nom, nom) {
            retour ch;
        }
        ch = ch.suivant;
    }
    retour nul;
}

fonction position_champ(st: Struct, nom) {
    soit ch = st.champs;
    soit k = 0;
    tantque ch != nul {
        si egal(ch.nom, nom) {
            retour k;
        }
        ch = ch.suivant;
        k = k + 1;
    }
    retour 0;
}

fonction est_entier_t(t) {
    retour t == 0 || t == T_I;
}

fonction est_flottant_t(t) {
    retour t == T_F || t == T_S || t == T_X;
}

fonction large(t) {
    retour t == T_W || t == T_X;
}

// le type commun de deux opérandes (comme Generateur.joindre de vtx64.py)
fonction joindre_types(c: Ctx, a, b, ligne) {
    si a == b {
        retour a;
    }
    si a == T_X || b == T_X {
        si (a == T_X || a == 0 || a == T_I || a == T_F || a == T_S) && (b == T_X || b == 0 || b == T_I || b == T_F || b == T_S) {
            retour T_X;
        }
        erreur(c, ligne, "l'opération mélange un flottant_petuar et un autre type : convertissez avec flottant_petuar()");
        retour 0;
    }
    si a == T_W || b == T_W {
        si (a == T_W || a == 0 || a == T_I) && (b == T_W || b == 0 || b == T_I) {
            retour T_W;
        }
        erreur(c, ligne, "l'opération mélange un entier_petuar et un autre type : convertissez avec entier_petuar()");
        retour 0;
    }
    si est_entier_t(a) && est_entier_t(b) {
        retour 0;
    }
    si (a == T_F || b == T_F) && (a == T_F || est_entier_t(a) || a == T_S) && (b == T_F || est_entier_t(b) || b == T_S) {
        retour T_F;
    }
    si (a == T_S || b == T_S) && (a == T_S || est_entier_t(a)) && (b == T_S || est_entier_t(b)) {
        retour T_S;
    }
    erreur(c, ligne, "types incompatibles dans l'opération");
    retour 0;
}

fonction est_comparaison(o) {
    retour egal(o, "==") || egal(o, "!=") || egal(o, "<") || egal(o, "<=") || egal(o, ">")
        || egal(o, ">=");
}

fonction est_comp_signee(o) {
    retour egal(o, ".<") || egal(o, ".<=") || egal(o, ".>") || egal(o, ".>=");
}

// la comparaison sans le point (.< -> <)
fonction sans_point(o) {
    si egal(o, ".<") { retour "<"; }
    si egal(o, ".<=") { retour "<="; }
    si egal(o, ".>") { retour ">"; }
    si egal(o, ".>=") { retour ">="; }
    retour o;
}

fonction est_arith(o) {
    retour egal(o, "+") || egal(o, "-") || egal(o, "*") || egal(o, "/") || egal(o, "%");
}

fonction est_bits_op(o) {
    retour egal(o, "&") || egal(o, "|") || egal(o, "^");
}

fonction typ_bin(c: Ctx, e: Noeud) {
    soit o = e.op;
    soit ta = typ(c, e.a);
    soit tb = typ(c, e.b);
    soit l = e.ligne;
    si est_struct(ta) || est_struct(tb) {
        soit nul_a = e.a.genre == N_NOMBRE && e.a.val == 0;
        soit nul_b = e.b.genre == N_NOMBRE && e.b.val == 0;
        si (egal(o, "==") || egal(o, "!=")) && (ta == tb || (est_struct(ta) && nul_b) || (est_struct(tb) && nul_a)) {
            retour 0;
        }
        erreur(c, l, "une référence se compare seulement (== ou !=) à une référence de même structure ou à nul");
        retour 0;
    }
    si ta == T_LOG || tb == T_LOG {
        si (egal(o, "==") || egal(o, "!=")) && (ta == tb || e.a.genre == N_BLIT || e.b.genre == N_BLIT) {
            retour 0;
        }
        erreur(c, l, "opérateur sur un logique : utilisez et4(), ou4(), non4(), anti(), fusion(), consensus(), logique() ou entier()");
        retour 0;
    }
    si egal(o, "&&") || egal(o, "||") || est_comparaison(o) || est_comp_signee(o) {
        joindre_types(c, ta, tb, l);
        retour 0;
    }
    si est_arith(o) {
        soit t = joindre_types(c, ta, tb, l);
        si est_flottant_t(t) && egal(o, "%") {
            erreur(c, l, "le reste « % » n'est pas défini pour les flottants");
        }
        retour t;
    }
    si est_bits_op(o) {
        soit t2 = joindre_types(c, ta, tb, l);
        si est_flottant_t(t2) {
            erreur(c, l, "opération bit à bit sur un flottant (voir bits())");
        }
        retour t2;
    }
    si egal(o, "<<") || egal(o, ">>") {
        si est_flottant_t(ta) || !est_entier_t(tb) {
            erreur(c, l, "décalage d'un entier par un entier seulement");
        }
        retour ta;
    }
    si egal(o, "./") || egal(o, ".%") || egal(o, ".>>") {
        soit t3 = ta;
        si !egal(o, ".>>") {
            t3 = joindre_types(c, ta, tb, l);
        }
        si !est_entier_t(t3) || !est_entier_t(tb) {
            erreur(c, l, "les opérateurs signés s'appliquent aux entiers seulement");
        }
        retour t3;
    }
    si !est_entier_t(ta) || !est_entier_t(tb) {
        erreur(c, l, "cet opérateur s'applique aux entiers seulement");
    }
    retour 0;
}

// le type rendu par une fonction intégrée (-1 : pas dans cette table)
fonction retour_integre_lent(nom) {
    si egal(nom, "flottant_petuar") || egal(nom, "flottant_128") || egal(nom, "comme_flottant_petuar")
        || egal(nom, "de_ieee128") {
        retour T_X;
    }
    si egal(nom, "vers_ieee128") || egal(nom, "entier_128") || egal(nom, "entier_petuar")
        || egal(nom, "entier_128_signe") || egal(nom, "entier_petuar_signe") || egal(nom, "entier_128_de")
        || egal(nom, "entier_petuar_de") {
        retour T_W;
    }
    si egal(nom, "flottant") || egal(nom, "flottant_64") || egal(nom, "flottant_signe")
        || egal(nom, "comme_flottant") || egal(nom, "de_ieee64") {
        retour T_F;
    }
    si egal(nom, "flottant_32") || egal(nom, "comme_flottant_32") {
        retour T_S;
    }
    si egal(nom, "entier_32") {
        retour T_I;
    }
    retour 0 - 1;
}

// le nombre d'arguments d'une fonction intégrée (-1 : ce n'en est pas une)
fonction arite_integre_lent(nom) {
    si retour_integre_lent(nom) != 0 - 1 {
        si egal(nom, "entier_128_de") || egal(nom, "entier_petuar_de") {
            retour 2;
        }
        retour 1;
    }
    si egal(nom, "bruit") || egal(nom, "pile") || egal(nom, "entrée") {
        retour 0;
    }
    si egal(nom, "ecrire_car") || egal(nom, "__service") || egal(nom, "min4") || egal(nom, "max4")
        || egal(nom, "addm4") || egal(nom, "gdot") || egal(nom, "qegal") || egal(nom, "mul_haut")
        || egal(nom, "mul_haut_signe") || egal(nom, "marquer_adn") || egal(nom, "marquer_arn")
        || egal(nom, "liberer_brin") {
        retour 2;
    }
    si egal(nom, "gemv") {
        retour 5;
    }
    si egal(nom, "bas") || egal(nom, "haut") || egal(nom, "lire_car") || egal(nom, "ouvrir_lecture")
        || egal(nom, "ouvrir_ecriture") || egal(nom, "fermer") || egal(nom, "fin_de") || egal(nom, "sortie")
        || egal(nom, "cmp3") || egal(nom, "nb_bits") || egal(nom, "brin") || egal(nom, "entier")
        || egal(nom, "arrondi") || egal(nom, "racine") || egal(nom, "bits") || egal(nom, "vers_ieee64") {
        retour 1;
    }
    retour 0 - 1;
}

fonction est_integre(nom) {
    retour arite_integre(nom) != 0 - 1;
}

fonction nb_args(a: Noeud) {
    soit n = 0;
    tantque a != nul {
        n = n + 1;
        a = a.suivant;
    }
    retour n;
}

fonction est_surcharge(nom) {
    retour egal(nom, "abs") || egal(nom, "min") || egal(nom, "max");
}

// abs, min, max d'un flottant, d'un entier_32 ou d'un 128 bits : le type commun ; 0 : la fonction du même nom
fonction type_surcharge(c: Ctx, e: Noeud) {
    si !est_surcharge(e.nom) {
        retour 0;
    }
    soit a = e.premier;
    soit special = 0;
    tantque a != nul {
        soit ta = typ(c, a);
        si ta == T_F || ta == T_S || ta == T_I || ta == T_W || ta == T_X {
            special = 1;
        }
        a = a.suivant;
    }
    si !special {
        retour 0;
    }
    a = e.premier;
    soit t = typ(c, a);
    a = a.suivant;
    tantque a != nul {
        t = joindre_types(c, t, typ(c, a), e.ligne);
        a = a.suivant;
    }
    retour t;
}

fonction typ(c: Ctx, e: Noeud) {
    soit g = e.genre;
    si g == N_NONLOG && typ(c, e.a) == T_LOG {
        erreur(c, e.ligne, "« ! » ne s'applique pas à un logique : utilisez non4() ou anti()");
    }
    si g == N_NOMBRE || g == N_ETIQ || g == N_LIRE || g == N_NONLOG || g == N_BLIT {
        retour 0;
    }
    si g == N_FNOMBRE { retour T_F; }
    si g == N_SNOMBRE { retour T_S; }
    si g == N_INOMBRE { retour T_I; }
    si g == N_WNOMBRE { retour T_W; }
    si g == N_XNOMBRE { retour T_X; }
    si g == N_QNOMBRE { retour T_LOG; }
    si g == N_VAR {
        retour var_de(c, e.nom, e.ligne).type;
    }
    si g == N_CONSTRUIRE || g == N_NOUVEAU {
        retour numero_struct(c, e.nom);
    }
    si g == N_CHAMP {
        soit t = typ(c, e.a);
        si est_struct(t) {
            soit ch = champ_de(c, struct_numero(c, t), e.nom);
            si ch != nul {
                retour ch.type;
            }
            erreur_nom(c, e.ligne, "champ inconnu dans la structure :", e.nom);
            retour 0;
        }
        si !(egal(e.nom, "r") || egal(e.nom, "v") || egal(e.nom, "b") || egal(e.nom, "a")) {
            erreur_nom(c, e.ligne, "il faut une référence à une structure pour ce champ :", e.nom);
        } sinon si !est_entier_t(t) {
            erreur(c, e.ligne, "les champs et les quits s'appliquent à un entier");
        }
        retour 0;
    }
    si g == N_QUIT {
        si !est_entier_t(typ(c, e.a)) {
            erreur(c, e.ligne, "les champs et les quits s'appliquent à un entier");
        }
        retour 0;
    }
    si g == N_NON {
        soit tn = typ(c, e.a);
        si est_flottant_t(tn) {
            erreur(c, e.ligne, "« ~ » ne s'applique pas à un flottant");
        }
        si tn == T_LOG {
            erreur(c, e.ligne, "« ~ » ne s'applique pas à un logique : utilisez non4() ou anti()");
        }
        retour tn;
    }
    si g == N_RLIRE {
        si tableau_de(c, e.nom).sorte == 2 {
            retour T_LOG;
        }
        retour 0;
    }
    si g == N_BIN {
        retour typ_bin(c, e);
    }
    si g == N_APPEL {
        soit nom = e.nom;
        si op_logique(nom) != 0 {
            si nb_args(e.premier) != op_logique(nom) {
                erreur_nom(c, e.ligne, "mauvais nombre d'arguments pour", nom);
                retour 0;
            }
            soit t1 = type_logique(c, e.premier);
            si (t1 != T_LOG && t1 != 0) || (e.premier.suivant != nul && type_logique(c, e.premier.suivant) != t1) {
                erreur_nom(c, e.ligne, "des logiques, ou des entiers qui rangent 32 logiques, sans mélange, pour", nom);
            }
            retour t1;
        }
        si egal(nom, "logique") || egal(nom, "comme_logique") {
            retour T_LOG;
        }
        si egal(nom, "__code_logique") {
            retour 0;
        }
        si (egal(nom, "racine") || egal(nom, "bits")) && e.premier != nul && e.premier.suivant == nul {
            soit t0 = typ(c, e.premier);
            si t0 == T_X {
                si egal(nom, "racine") { retour T_X; }
                retour T_W;
            }
            si egal(nom, "racine") {
                si t0 == T_S { retour T_S; }
                retour T_F;
            }
            retour 0;
        }
        si retour_integre(nom) != 0 - 1 {
            retour retour_integre(nom);
        }
        si est_integre(nom) {
            retour 0;
        }
        si est_surcharge(nom) {
            soit ts = type_surcharge(c, e);
            si ts != 0 {
                retour ts;
            }
        }
        soit f = fonction_de(c, nom);
        si f != nul {
            retour f.rtype;
        }
        erreur_nom(c, e.ligne, "fonction inconnue :", nom);
        retour 0;
    }
    retour 0;
}

// Opérations de la logique à quatre valeurs : nombre d'arguments (0 si ce n'en est pas une)
fonction op_logique(nom) {
    si egal(nom, "et4") || egal(nom, "ou4") || egal(nom, "fusion") || egal(nom, "consensus") {
        retour 2;
    }
    si egal(nom, "non4") || egal(nom, "anti") {
        retour 1;
    }
    retour 0;
}

// Type d'un argument d'une opération logique : vrai et faux y sont des logiques
fonction type_logique(c: Ctx, a: Noeud) {
    si a.genre == N_BLIT {
        retour T_LOG;
    }
    retour typ(c, a);
}

fonction refuser_logique(c: Ctx, e: Noeud) {
    si typ(c, e) == T_LOG {
        erreur(c, e.ligne, "un logique a quatre valeurs et ne sert pas de condition : utilisez « selon », ou comparez (x == vrai)");
    }
}

// --------------------------------------------------------------------------------------------- conversions implicites
// le résultat (R1, ou R1:R4) de type t vers le type voulu
fonction conv(c: Ctx, t, voulu, e: Noeud) {
    si t == voulu {
        retour;
    }
    si voulu == 0 && t == T_I {
        retour;                                  // l'entier_32 est déjà rangé sans signe dans 64 bits
    }
    si voulu == T_F && est_entier_t(t) {
        rr(c, 72, 1, 1);                         // ITOF
    } sinon si voulu == T_F && t == T_S {
        rr(c, 104, 1, 1);                        // STOF
    } sinon si voulu == T_S && est_entier_t(t) {
        rr(c, 72, 1, 1);
        rr(c, 105, 1, 1);                        // FTOS
    } sinon si voulu == T_W && est_entier_t(t) {
        ldis(c, 4, 0);
    } sinon si voulu == T_I && t == 0 && e != nul && e.genre == N_NOMBRE && e.val <= 4294967295 {
        retour;                                  // un nombre écrit qui tient dans 32 bits
    } sinon {
        erreur(c, e.ligne, "conversion implicite impossible : utilisez entier(), entier_32(), flottant(), flottant_32(), entier_petuar(), flottant_petuar() ou logique()");
    }
}

// --------------------------------------------------------------------------------------------- mémoire
// l'adresse longue de @e[adr] : R1 (ou R0) et le décalage pour LD/ST registre,#décalage ; rend reg * 2^32 + décalage.
// e : 0 à 3, 4 pour @[adr] (l'adresse telle quelle), ou etage_calcule non nul pour @(x)[adr]
fonction adresse(c: Ctx, etg, ex: Noeud, adr: Noeud) {
    si ex == nul && etg != 4 && adr.genre == N_NOMBRE {
        soit v = (adr.val & 4611686018427387903) | (etg << 62);
        si etg == 0 && v < 2147483648 {
            retour v;                            // R0 et la petite adresse dans l'instruction
        }
        charger(c, 1, v);
        retour 4294967296;
    }
    soit dec = 0;
    si ex == nul && etg != 4 && adr.genre == N_BIN && egal(adr.op, "+") && adr.a.genre == N_NOMBRE
            && adr.a.val < 2147483648 {
        dec = adr.a.val;
        adr = adr.b;
    }
    si ex == nul {
        gen_v(c, adr, 0);
        si etg != 4 {
            rri(c, 31, 1, 1, etg);                // ETG
        }
        retour 4294967296 + dec;
    }
    gen_v(c, adr, 0);
    pousser(c, 1);
    gen_v(c, ex, 0);
    mov(c, 2, 1);
    depiler(c, 1);
    rrr(c, 34, 1, 1, 2);                         // ETGX
    retour 4294967296;
}

fonction lire_mem(c: Ctx, etg, ex: Noeud, adr: Noeud) {
    soit p = adresse(c, etg, ex, adr);
    ld(c, 1, p >> 32, p & 4294967295);
}

fonction ecrire_mem(c: Ctx, etg, ex: Noeud, adr: Noeud, val: Noeud, ligne) {
    soit t = typ(c, val);
    si large(t) {
        erreur(c, ligne, "une valeur de deux mots : écrivez bas(x) et haut(x) séparément");
        retour;
    }
    si ex == nul && etg != 4 && adr.genre == N_NOMBRE {
        gen(c, val);
        soit v = (adr.val & 4611686018427387903) | (etg << 62);
        si etg == 0 && v < 2147483648 {
            st(c, 0, 1, v);
            retour;
        }
        charger(c, 2, v);
        st(c, 2, 1, 0);
        retour;
    }
    soit p = adresse(c, etg, ex, adr);
    pousser(c, 1);
    gen(c, val);
    mov(c, 2, 1);
    depiler(c, 1);
    st(c, 1, 2, p & 4294967295);
}

// --------------------------------------------------------------------------------------------- conditions
// Valeur de vérité dans R1 : un flottant est vrai s'il est un nombre non nul, un entier_petuar s'il n'est pas nul
fonction gen_bool(c: Ctx, e: Noeud) {
    refuser_logique(c, e);
    si typ(c, e) == T_X {
        erreur(c, e.ligne, "un flottant_petuar a un état à quatre valeurs et ne sert pas de condition : comparez-le, ou utilisez « selon etat(x) »");
    }
    soit t = gen(c, e);
    si t == T_F {
        charger(c, 2, 4611686018427387903);
        rrr(c, 20, 1, 1, 2);
    } sinon si t == T_S {
        charger(c, 2, 1073741823);
        rrr(c, 20, 1, 1, 2);
    } sinon si t == T_W {
        rrr(c, 21, 1, 1, 4);
    }
}

// le saut si la comparaison o (sans point) est vraie, ou fausse avec faux
fonction code_saut(o, inverse) {
    soit vrai_ = 0;
    si egal(o, "==") { vrai_ = 49; }
    si egal(o, "!=") { vrai_ = 50; }
    si egal(o, "<") || egal(o, ">") { vrai_ = 53; }
    si egal(o, ">=") || egal(o, "<=") { vrai_ = 54; }
    si !inverse {
        retour vrai_;
    }
    si vrai_ == 49 { retour 50; }
    si vrai_ == 50 { retour 49; }
    si vrai_ == 53 { retour 54; }
    retour 53;
}

// CMP dans l'ordre de la comparaison : « > » et « <= » échangent les registres
fonction cmp_ordre(c: Ctx, o, ra, rb) {
    si egal(o, ">") || egal(o, "<=") {
        cmp(c, rb, ra);
    } sinon {
        cmp(c, ra, rb);
    }
}

// compare deux entiers (entier ou entier_32) et saute à lab si la comparaison est vraie (ou fausse, avec inverse)
fonction comparer_entiers(c: Ctx, op, a: Noeud, b: Noeud, inverse, lab) {
    soit signe = est_comp_signee(op);
    soit o = sans_point(op);
    soit t = joindre_types(c, typ(c, a), typ(c, b), a.ligne);
    si c.optim && !signe && (egal(o, "==") || egal(o, "!=") || egal(o, "<") || egal(o, ">="))
            && (b.genre == N_NOMBRE || b.genre == N_INOMBRE) && b.val < 2147483648 {
        // comparaison à une petite constante : CMPI (a - constante)
        soit ra0 = reg_var(c, a);
        si ra0 == 0 {
            gen_v(c, a, 0);
            ra0 = 1;
        }
        cmpi(c, ra0, b.val);
        saut(c, code_saut(o, inverse), lab);
        retour;
    }
    soit pk = deux_ops(c, a, b);
    soit ra = pk >> 4;
    soit rb = pk & 15;
    si signe {
        si t == T_I {
            charger(c, 8, 2147483648);
        } sinon {
            charger(c, 8, 9223372036854775808);
        }
        rrr(c, 22, 6, ra, 8);
        rrr(c, 22, 7, rb, 8);
        ra = 6;
        rb = 7;
    }
    cmp_ordre(c, o, ra, rb);
    saut(c, code_saut(o, inverse), lab);
}

fonction saut_faux(c: Ctx, e: Noeud, lab) {
    refuser_logique(c, e);
    soit comp = e.genre == N_BIN && (est_comparaison(e.op) || est_comp_signee(e.op));
    si !c.optim {
        gen_bool(c, e);
        cmp(c, 1, 0);
        saut(c, 49, lab);
        retour;
    }
    si comp && est_comparaison(e.op) {
        soit ta = typ(c, e.a);
        soit tb = typ(c, e.b);
        si ta == T_LOG || tb == T_LOG || est_struct(ta) || est_struct(tb) {
            soit t = T_LOG;
            si ta != T_LOG && tb != T_LOG {
                t = tb;
                si est_struct(ta) {
                    t = ta;
                }
            }
            paire(c, e.a, e.b, t);
            cmp_ordre(c, e.op, 1, 2);
            saut(c, code_saut(e.op, 1), lab);
            retour;
        }
    }
    si comp && est_entier_t(joindre_types(c, typ(c, e.a), typ(c, e.b), e.ligne)) {
        comparer_entiers(c, e.op, e.a, e.b, 1, lab);
        retour;
    }
    si e.genre == N_BIN && egal(e.op, "&&") {
        saut_faux(c, e.a, lab);
        saut_faux(c, e.b, lab);
        retour;
    }
    si e.genre == N_BIN && egal(e.op, "||") {
        soit lb = nouvelle_etiquette(c);
        soit lt = nouvelle_etiquette(c);
        saut_faux(c, e.a, lb);
        saut(c, 48, lt);
        poser_etiquette(c, lb);
        saut_faux(c, e.b, lab);
        poser_etiquette(c, lt);
        retour;
    }
    si e.genre == N_NONLOG {
        soit lc = nouvelle_etiquette(c);
        saut_faux(c, e.a, lc);
        saut(c, 48, lab);
        poser_etiquette(c, lc);
        retour;
    }
    gen_bool(c, e);
    cmp(c, 1, 0);
    saut(c, 49, lab);
}

// --------------------------------------------------------------------------------------------- opérandes
fonction deux(c: Ctx, a: Noeud, b: Noeud) {
    paire(c, a, b, 0);
}

// le registre d'une variable entière (ou entier_32) en registre, sinon 0
fonction reg_var(c: Ctx, e: Noeud) {
    si c.optim && e.genre == N_VAR {
        soit v = var_ou_nul(c, e.nom);
        si v != nul && v.reg != 0 && est_entier_t(v.type) {
            retour v.reg;
        }
    }
    retour 0;
}

// les deux opérandes entiers d'une opération, lus sur place quand ils sont en registres : rend ra * 16 + rb
fonction deux_ops(c: Ctx, a: Noeud, b: Noeud) {
    soit ra = reg_var(c, a);
    soit rb = reg_var(c, b);
    si ra != 0 && rb != 0 {
        retour ra * 16 + rb;
    }
    si ra != 0 {
        si c.optim && b.genre == N_BLIT {
            charger(c, 2, b.val == 2);
        } sinon si c.optim && (b.genre == N_NOMBRE || b.genre == N_QNOMBRE || b.genre == N_INOMBRE) {
            charger(c, 2, b.val);
        } sinon si c.optim && b.genre == N_VAR && est_entier_t(var_de(c, b.nom, b.ligne).type) {
            ldf(c, 2, var_de(c, b.nom, b.ligne).off);
        } sinon {
            gen_v(c, b, 0);
            mov(c, 2, 1);
        }
        retour ra * 16 + 2;
    }
    si rb != 0 {
        gen_v(c, a, 0);
        retour 16 + rb;
    }
    deux(c, a, b);
    retour 18;
}

// a et b convertis au type voulu : R1 et R2, ou R1:R4 et R2:R5 (deux mots)
fonction paire(c: Ctx, a: Noeud, b: Noeud, voulu) {
    gen_v(c, a, voulu);
    si large(voulu) {
        pousser(c, 1);
        pousser(c, 4);
        gen_v(c, b, voulu);
        mov(c, 2, 1);
        mov(c, 5, 4);
        depiler(c, 4);
        depiler(c, 1);
        retour;
    }
    si c.optim && b.genre == N_BLIT && (voulu == 0 || voulu == T_LOG) {
        si voulu == 0 {
            charger(c, 2, b.val == 2);
        } sinon {
            charger(c, 2, b.val);
        }
        retour;
    }
    si c.optim && (b.genre == N_NOMBRE || b.genre == N_QNOMBRE) && (voulu == 0 || voulu == T_LOG) {
        charger(c, 2, b.val);
        retour;
    }
    si c.optim && b.genre == N_INOMBRE && est_entier_t(voulu) {
        charger(c, 2, b.val);
        retour;
    }
    si c.optim && ((b.genre == N_FNOMBRE && voulu == T_F) || (b.genre == N_SNOMBRE && voulu == T_S)) {
        charger(c, 2, b.val);
        retour;
    }
    si c.optim && b.genre == N_VAR {
        soit vb = var_de(c, b.nom, b.ligne);
        si vb.type == voulu {
            si vb.reg != 0 {
                mov(c, 2, vb.reg);
            } sinon {
                ldf(c, 2, vb.off);
            }
            retour;
        }
    }
    pousser(c, 1);
    gen_v(c, b, voulu);
    mov(c, 2, 1);
    depiler(c, 1);
}

// R1 = 1 si le saut conditionnel op (après la comparaison déjà émise) est pris, sinon 0
fonction booleen_saut(c: Ctx, op) {
    soit lv = nouvelle_etiquette(c);
    soit fin = nouvelle_etiquette(c);
    saut(c, op, lv);
    ldis(c, 1, 0);
    saut(c, 48, fin);
    poser_etiquette(c, lv);
    ldis(c, 1, 1);
    poser_etiquette(c, fin);
}

// --------------------------------------------------------------------------------------------- expressions
// e au type voulu (-1 : son propre type) ; rend le type obtenu
fonction gen_v(c: Ctx, e: Noeud, voulu) {
    si e.genre == N_BLIT {
        si voulu == T_LOG {
            charger(c, 1, e.val);
            retour T_LOG;
        }
        charger(c, 1, e.val == 2);
        si voulu != 0 - 1 && voulu != 0 {
            conv(c, 0, voulu, e);
            retour voulu;
        }
        retour 0;
    }
    si est_struct(voulu) && e.genre == N_NOMBRE && e.val == 0 {
        ldis(c, 1, 0);                           // nul
        retour voulu;
    }
    soit t = typ(c, e);
    si est_struct(t) {
        si e.genre == N_NOUVEAU || e.genre == N_CONSTRUIRE {
            soit st0 = struct_de(c, e.nom);
            charger(c, 1, st0.nb);
            pousser(c, 1);
            saut(c, 51, demander(c, fonction_de(c, "nouveau")));
            rri(c, 6, 14, 14, 1);
            si e.genre == N_CONSTRUIRE {
                pousser(c, 1);
                soit p = e.premier;
                tantque p != nul {
                    soit pos = position_champ(st0, p.nom);
                    soit tpc = champ_de(c, st0, p.nom).type;
                    si large(tpc) {
                        erreur(c, e.ligne, "un champ ne peut pas contenir une valeur de deux mots");
                    }
                    gen_v(c, p.a, tpc);
                    mov(c, 2, 1);
                    depiler(c, 1);
                    pousser(c, 1);
                    st(c, 1, 2, pos);
                    p = p.suivant;
                }
                depiler(c, 1);
            }
        } sinon si e.genre == N_CHAMP {
            soit tr = typ(c, e.a);
            gen(c, e.a);
            ld(c, 1, 1, position_champ(struct_numero(c, tr), e.nom));
        } sinon {
            expr_e(c, e);
        }
        si voulu != 0 - 1 && voulu != t {
            conv(c, t, voulu, e);
        }
        retour t;
    }
    si voulu == T_X && (t == 0 || t == T_I || t == T_F || t == T_S) {
        conversion_nom(c, "flottant_petuar", e, e.ligne);      // élargi en flottant_petuar par le prélude
        retour T_X;
    }
    si est_entier_t(t) {
        expr_e(c, e);
    } sinon si t == T_F || t == T_S {
        expr_f(c, e, t);
    } sinon si t == T_LOG {
        si e.genre == N_QNOMBRE {
            charger(c, 1, e.val);
        } sinon {
            expr_e(c, e);
        }
    } sinon si t == T_W {
        expr_w(c, e);
    } sinon si t == T_X {
        expr_x(c, e);
    }
    si voulu != 0 - 1 && voulu != t {
        conv(c, t, voulu, e);
        retour voulu;
    }
    retour t;
}

fonction gen(c: Ctx, e: Noeud) {
    retour gen_v(c, e, 0 - 1);
}

fonction est_operation(o) {
    retour code_operation(o) != 0;
}

fonction code_operation(o) {
    si egal(o, "+") { retour 1; }
    si egal(o, "-") { retour 2; }
    si egal(o, "*") { retour 3; }
    si egal(o, "/") { retour 12; }
    si egal(o, "%") { retour 13; }
    si egal(o, "&") { retour 20; }
    si egal(o, "|") { retour 21; }
    si egal(o, "^") { retour 22; }
    si egal(o, "<<") { retour 8; }
    si egal(o, ">>") { retour 9; }
    retour 0;
}

// ./ .% .>> : DIVS, MODS, SAR (0 sinon)
fonction code_signe(o) {
    si egal(o, "./") { retour 26; }
    si egal(o, ".%") { retour 27; }
    si egal(o, ".>>") { retour 23; }
    retour 0;
}

fonction expr_e(c: Ctx, e: Noeud) {
    soit g = e.genre;
    si c.optim && g == N_BIN && egal(e.op, "&") {
        soit q = motif_quit(e);
        si q != nul {
            // LDQ : le quit i d'un tableau rangé, en une instruction
            gen_v(c, q.idx, 0);
            soit b = q.base | (q.etg << 62);
            soit rq = 0;
            si b != 0 {
                charger(c, 2, b);
                rq = 2;
            }
            rrr(c, 84, 1, rq, 1);
            retour;
        }
    }
    si g == N_NOMBRE || g == N_INOMBRE {
        charger(c, 1, e.val);
    } sinon si g == N_VAR {
        soit vr = var_de(c, e.nom, e.ligne);
        si vr.reg != 0 {
            mov(c, 1, vr.reg);
        } sinon {
            ldf(c, 1, vr.off);
        }
    } sinon si g == N_ETIQ {
        ldi_etiquette(c, 1, etiquette_texte(c, e.nom));
    } sinon si g == N_NON {
        soit tn = gen(c, e.a);
        rr(c, 18, 1, 1);
        si tn == T_I {
            rr(c, 28, 1, 1);
        }
    } sinon si g == N_NONLOG {
        soit lv = nouvelle_etiquette(c);
        soit fin = nouvelle_etiquette(c);
        gen_bool(c, e.a);
        cmp(c, 1, 0);
        saut(c, 49, lv);
        ldis(c, 1, 0);
        saut(c, 48, fin);
        poser_etiquette(c, lv);
        ldis(c, 1, 1);
        poser_etiquette(c, fin);
    } sinon si g == N_BIN {
        gen_bin(c, e);
    } sinon si g == N_CHAMP {
        soit t = typ(c, e.a);
        si est_struct(t) {
            gen(c, e.a);
            ld(c, 1, 1, position_champ(struct_numero(c, t), e.nom));
        } sinon {
            // un canal d'un point profond #RRRRGGGGBBBBAAAA : 16 bits
            gen(c, e.a);
            soit dec = 0;
            si egal(e.nom, "r") { dec = 48; }
            si egal(e.nom, "v") { dec = 32; }
            si egal(e.nom, "b") { dec = 16; }
            si dec != 0 {
                charger(c, 2, dec);
                rrr(c, 9, 1, 1, 2);
            }
            charger(c, 2, 65535);
            rrr(c, 20, 1, 1, 2);
        }
    } sinon si g == N_QUIT {
        // EXQ : le quit i d'un registre
        gen(c, e.a);
        pousser(c, 1);
        gen_v(c, e.b, 0);
        mov(c, 2, 1);
        depiler(c, 1);
        rrr(c, 90, 1, 1, 2);
    } sinon si g == N_LIRE {
        lire_mem(c, e.val, e.a, e.b);
    } sinon si g == N_RLIRE {
        gen(c, rangee_basse(c, e));
    } sinon si g == N_APPEL {
        appel(c, e);
    } sinon si g == N_QNOMBRE {
        charger(c, 1, e.val);
    }
}

fonction gen_bin(c: Ctx, e: Noeud) {
    soit o = e.op;
    soit l = e.ligne;
    si egal(o, "&&") {
        soit lf = nouvelle_etiquette(c);
        soit fin = nouvelle_etiquette(c);
        saut_faux(c, e.a, lf);
        saut_faux(c, e.b, lf);
        ldis(c, 1, 1);
        saut(c, 48, fin);
        poser_etiquette(c, lf);
        ldis(c, 1, 0);
        poser_etiquette(c, fin);
        retour;
    }
    si egal(o, "||") {
        soit lb = nouvelle_etiquette(c);
        soit lt = nouvelle_etiquette(c);
        soit lf2 = nouvelle_etiquette(c);
        soit fin2 = nouvelle_etiquette(c);
        saut_faux(c, e.a, lb);
        saut(c, 48, lt);
        poser_etiquette(c, lb);
        saut_faux(c, e.b, lf2);
        poser_etiquette(c, lt);
        ldis(c, 1, 1);
        saut(c, 48, fin2);
        poser_etiquette(c, lf2);
        ldis(c, 1, 0);
        poser_etiquette(c, fin2);
        retour;
    }
    si est_comparaison(o) || est_comp_signee(o) {
        soit ta = typ(c, e.a);
        soit tb = typ(c, e.b);
        si ta == T_LOG || tb == T_LOG || est_struct(ta) || est_struct(tb) {
            soit tq = T_LOG;
            si ta != T_LOG && tb != T_LOG {
                tq = tb;
                si est_struct(ta) {
                    tq = ta;
                }
            }
            paire(c, e.a, e.b, tq);
            cmp_ordre(c, o, 1, 2);
            booleen_saut(c, code_saut(o, 0));
            retour;
        }
        soit os = sans_point(o);
        soit tc = joindre_types(c, ta, tb, l);
        si tc == T_X {
            soit fc = "__pq_eq";
            si egal(os, "!=") { fc = "__pq_ne"; }
            si egal(os, "<") { fc = "__pq_lt"; }
            si egal(os, "<=") { fc = "__pq_le"; }
            si egal(os, ">") { fc = "__pq_gt"; }
            si egal(os, ">=") { fc = "__pq_ge"; }
            soit ax = bits_x(c, e.a);
            ax.suivant = bits_x(c, e.b);
            appel(c, appel_n(fc, ax, l));
            retour;
        }
        si tc == T_F || tc == T_S {
            paire(c, e.a, e.b, tc);
            soit base = 64;                      // FADD... FEQ 68, FLT 69, FLE 70
            si tc == T_S {
                base = 96;                       // SADD... SEQ 100, SLT 101, SLE 102
            }
            si egal(os, "==") || egal(os, "!=") { rrr(c, base + 4, 1, 1, 2); }
            si egal(os, "<") { rrr(c, base + 5, 1, 1, 2); }
            si egal(os, "<=") { rrr(c, base + 6, 1, 1, 2); }
            si egal(os, ">") { rrr(c, base + 5, 1, 2, 1); }
            si egal(os, ">=") { rrr(c, base + 6, 1, 2, 1); }
            si egal(os, "!=") {
                ldis(c, 2, 1);
                rrr(c, 22, 1, 1, 2);
            }
            retour;
        }
        si tc == T_W {
            si egal(os, "==") || egal(os, "!=") {
                paire(c, e.a, e.b, T_W);
                rrr(c, 22, 1, 1, 2);
                rrr(c, 22, 4, 4, 5);
                rrr(c, 21, 1, 1, 4);
                cmp(c, 1, 0);
                si egal(os, "==") { booleen_saut(c, 49); } sinon { booleen_saut(c, 50); }
                retour;
            }
            soit pa = copier(e.a);
            soit pb = copier(e.b);
            si egal(os, "<") || egal(os, ">=") {
                pa.suivant = pb;
                appel(c, appel_n("__qlt", pa, l));
            } sinon {
                pb.suivant = pa;
                appel(c, appel_n("__qlt", pb, l));
            }
            si egal(os, "<=") || egal(os, ">=") {
                ldis(c, 2, 1);
                rrr(c, 22, 1, 1, 2);
            }
            retour;
        }
        // entiers : la comparaison, puis le booléen
        soit lv = nouvelle_etiquette(c);
        soit fin3 = nouvelle_etiquette(c);
        comparer_entiers(c, o, e.a, e.b, 0, lv);
        ldis(c, 1, 0);
        saut(c, 48, fin3);
        poser_etiquette(c, lv);
        ldis(c, 1, 1);
        poser_etiquette(c, fin3);
        retour;
    }
    si egal(o, "<<q") || egal(o, ">>q") {
        soit tq2 = typ(c, e);
        deux(c, e.a, e.b);
        rrr(c, 1, 2, 2, 2);
        si egal(o, "<<q") { rrr(c, 8, 1, 1, 2); } sinon { rrr(c, 9, 1, 1, 2); }
        si tq2 == T_I && egal(o, "<<q") {
            rr(c, 28, 1, 1);
        }
        retour;
    }
    soit t = typ(c, e);
    si t == T_F || t == T_S {
        expr_f(c, e, t);
        retour;
    }
    si t == T_W {
        expr_w(c, e);
        retour;
    }
    si t == T_X {
        expr_x(c, e);
        retour;
    }
    si t == T_I && code_signe(o) != 0 {
        // entier_32 signé : étendu par le signe, calculé sur 64 bits, ramené à 32
        deux(c, e.a, e.b);
        rr(c, 29, 1, 1);
        si !egal(o, ".>>") {
            rr(c, 29, 2, 2);
        }
        rrr(c, code_signe(o), 1, 1, 2);
        rr(c, 28, 1, 1);
        retour;
    }
    soit pk = deux_ops(c, e.a, e.b);
    soit k = code_operation(o);
    si k == 0 {
        k = code_signe(o);
    }
    rrr(c, k, 1, pk >> 4, pk & 15);
    si t == T_I && (egal(o, "+") || egal(o, "-") || egal(o, "*") || egal(o, "<<") || egal(o, "/")) {
        rr(c, 28, 1, 1);
    }
}

// flottant quaternaire de 64 bits (t = T_F, instructions F) ou de 32 bits (T_S, instructions S)
fonction expr_f(c: Ctx, e: Noeud, t) {
    soit g = e.genre;
    soit base = 64;
    soit neg = 91;                               // FNEG
    si t == T_S {
        base = 96;
        neg = 106;                               // SNEG
    }
    si g == N_FNOMBRE || g == N_SNOMBRE {
        charger(c, 1, e.val);
    } sinon si g == N_VAR {
        soit vr = var_de(c, e.nom, e.ligne);
        si vr.reg != 0 {
            mov(c, 1, vr.reg);
        } sinon {
            ldf(c, 1, vr.off);
        }
    } sinon si g == N_BIN {
        si egal(e.op, "-") && ((e.a.genre == N_NOMBRE || e.a.genre == N_FNOMBRE) && e.a.val == 0) {
            gen_v(c, e.b, t);
            rr(c, neg, 1, 1);
            retour;
        }
        paire(c, e.a, e.b, t);
        si egal(e.op, "+") { rrr(c, base, 1, 1, 2); }
        si egal(e.op, "-") { rrr(c, base + 1, 1, 1, 2); }
        si egal(e.op, "*") { rrr(c, base + 2, 1, 1, 2); }
        si egal(e.op, "/") { rrr(c, base + 3, 1, 1, 2); }
    } sinon si g == N_APPEL {
        appel(c, e);
    } sinon si g == N_CHAMP {
        expr_e(c, e);
    } sinon {
        erreur(c, e.ligne, "expression flottante inattendue");
    }
}

// entier_petuar : deux mots dans R1:R4 (le mot bas d'abord) ; * en ligne, / % << >> par le prélude
fonction expr_w(c: Ctx, e: Noeud) {
    soit g = e.genre;
    soit l = e.ligne;
    si g == N_WNOMBRE {
        charger(c, 1, e.val);
        charger(c, 4, e.nom);
    } sinon si g == N_VAR {
        soit vr = var_de(c, e.nom, l);
        ldf(c, 1, vr.off);
        ldf(c, 4, vr.off - 1);
    } sinon si g == N_NON {
        gen_v(c, e.a, T_W);
        rr(c, 18, 1, 1);
        rr(c, 18, 4, 4);
    } sinon si g == N_BIN {
        soit o = e.op;
        si egal(o, "/") || egal(o, "%") || egal(o, "./") || egal(o, ".%") {
            soit a = copier(e.a);
            a.suivant = copier(e.b);
            a.suivant.suivant = nombre(egal(o, "%") || egal(o, ".%"), l);
            appel(c, appel_n("__qdiv", a, l));
            retour;
        }
        si egal(o, "<<") || egal(o, ">>") || egal(o, ".>>") {
            soit a2 = copier(e.a);
            a2.suivant = copier(e.b);
            si egal(o, "<<") {
                appel(c, appel_n("__qshl", a2, l));
            } sinon {
                appel(c, appel_n("__qsar", a2, l));
            }
            retour;
        }
        paire(c, e.a, e.b, T_W);
        si egal(o, "+") {
            rrr(c, 1, 1, 1, 2);
            rrr(c, 76, 4, 4, 5);
        } sinon si egal(o, "-") {
            rrr(c, 2, 1, 1, 2);
            rrr(c, 77, 4, 4, 5);
        } sinon si egal(o, "*") {
            rrr(c, 78, 6, 1, 2);
            rrr(c, 3, 7, 1, 5);
            rrr(c, 1, 6, 6, 7);
            rrr(c, 3, 7, 4, 2);
            rrr(c, 1, 4, 6, 7);
            rrr(c, 3, 1, 1, 2);
        } sinon si est_bits_op(o) {
            soit k = code_operation(o);
            rrr(c, k, 1, 1, 2);
            rrr(c, k, 4, 4, 5);
        } sinon {
            erreur(c, l, "cet opérateur ne s'applique pas à un entier_petuar");
        }
    } sinon si g == N_APPEL {
        appel(c, e);
    } sinon {
        erreur(c, l, "expression entier_petuar inattendue");
    }
}

fonction appel_n(nom, a: Noeud, l): Noeud {
    retour Noeud { genre: N_APPEL, nom: nom, premier: a, ligne: l };
}

// bits(x) d'un flottant_petuar (élargi d'abord s'il le faut) : ses deux mots, vus comme un entier_petuar
fonction bits_x(c: Ctx, a: Noeud): Noeud {
    soit x = copier(a);
    si typ(c, a) != T_X {
        x = appel_n("flottant_petuar", x, a.ligne);
    }
    retour appel_n("bits", x, a.ligne);
}

// flottant_petuar : deux mots dans R1:R4 ; le calcul par le prélude
fonction expr_x(c: Ctx, e: Noeud) {
    soit g = e.genre;
    soit l = e.ligne;
    si g == N_XNOMBRE {
        charger(c, 1, e.val);
        charger(c, 4, e.nom);
    } sinon si g == N_VAR {
        soit vr = var_de(c, e.nom, l);
        ldf(c, 1, vr.off);
        ldf(c, 4, vr.off - 1);
    } sinon si g == N_BIN {
        soit o = e.op;
        si egal(o, "-") && (e.a.genre == N_NOMBRE || e.a.genre == N_FNOMBRE) && e.a.val == 0 {
            appel(c, appel_n("__pq_neg", bits_x(c, e.b), l));
            retour;
        }
        soit f = 0;
        si egal(o, "+") { f = "__pq_add"; }
        si egal(o, "-") { f = "__pq_sub"; }
        si egal(o, "*") { f = "__pq_mul"; }
        si egal(o, "/") { f = "__pq_div"; }
        si f == 0 {
            erreur(c, l, "cet opérateur ne s'applique pas à un flottant_petuar");
            retour;
        }
        soit ax = bits_x(c, e.a);
        ax.suivant = bits_x(c, e.b);
        appel(c, appel_n(f, ax, l));
    } sinon si g == N_APPEL {
        appel(c, e);
    } sinon {
        erreur(c, l, "expression flottant_petuar inattendue");
    }
}

// --------------------------------------------------------------------------------------------- appels
// et4, ou4, non4, anti, fusion, consensus : des ET et des OU sur les deux bits de chaque quit, donc la même instruction
// traite un logique ou 32 logiques rangés dans un entier
fonction gen_logique(c: Ctx, e: Noeud) {
    soit nom = e.nom;
    soit a = e.premier;
    soit t = typ(c, e);
    si op_logique(nom) == 2 {
        paire(c, a, a.suivant, t);
    } sinon {
        gen_v(c, a, t);
    }
    si egal(nom, "et4") {
        rrr(c, 86, 1, 1, 2);
    } sinon si egal(nom, "ou4") {
        rrr(c, 87, 1, 1, 2);
    } sinon si egal(nom, "fusion") {
        rrr(c, 21, 1, 1, 2);
    } sinon si egal(nom, "consensus") {
        rrr(c, 20, 1, 1, 2);
    } sinon si egal(nom, "anti") && t != T_LOG {
        rr(c, 89, 1, 1);
    } sinon {
        rr(c, 88, 1, 1);
        si egal(nom, "anti") {
            ldis(c, 2, 3);
            rrr(c, 22, 1, 1, 2);
        }
    }
}

// logique(x), comme_logique(x)
fonction gen_vers_logique(c: Ctx, e: Noeud) {
    soit nom = e.nom;
    soit a = e.premier;
    si nb_args(a) != 1 {
        erreur_nom(c, e.ligne, "un argument attendu pour", nom);
        retour;
    }
    soit ta = type_logique(c, a);
    si ta == T_LOG {
        gen_v(c, a, T_LOG);
        retour;
    }
    si !est_entier_t(ta) {
        erreur_nom(c, e.ligne, "il faut un entier pour", nom);
        retour;
    }
    gen(c, a);
    si egal(nom, "comme_logique") {
        ldis(c, 2, 3);
        rrr(c, 20, 1, 1, 2);
    } sinon {
        soit lz = nouvelle_etiquette(c);
        soit lf = nouvelle_etiquette(c);
        cmp(c, 1, 0);
        saut(c, 49, lz);
        ldis(c, 1, 2);
        saut(c, 48, lf);
        poser_etiquette(c, lz);
        ldis(c, 1, 1);
        poser_etiquette(c, lf);
    }
}

// --------------------------------------------------------------------------------------------- expansion en ligne
// Comme vtx64.py (voir ENLIGNE) : une petite fonction dont le corps est une seule instruction (retour E, une écriture,
// un appel) est recopiée à la place de son appel, ses paramètres remplacés par les arguments.

// les noeuds permis dans un corps recopié (et dans un argument « pur »)
fonction el_permis(g) {
    retour g == N_NOMBRE || g == N_ETIQ || g == N_VAR || g == N_LIRE || g == N_BIN || g == N_NON || g == N_NONLOG
        || g == N_CHAMP || g == N_QUIT;
}

// « / », « % », « ./ », « .% »
fonction el_division(n: Noeud) {
    si n.genre != N_BIN {
        retour 0;
    }
    soit o = n.op;
    soit c0 = @[o + 1];
    retour (@[o] == 1 && (c0 == '/' || c0 == '%')) || (@[o] == 2 && c0 == '.' && (@[o + 2] == '/' || @[o + 2] == '%'));
}

// la variable n est-elle un paramètre de f ? sa place est notée dans le noeud, et l'usage compté
fonction el_est_param(f: Fonction, n: Noeud) {
    soit p = f.params;
    soit k = 1;
    tantque p != nul {
        si egal(p.nom, n.nom) {
            n.el = k;
            p.usages = p.usages + 1;
            retour 1;
        }
        p = p.suivant;
        k = k + 1;
    }
    retour 0;
}

// le corps n (une expression) : 1 si ses noeuds sont permis et ses variables des paramètres ; f.el_sans à 0 s'il
// contient un appel
fonction el_corps_ok(f: Fonction, n: Noeud) {
    si n == nul {
        retour 1;
    }
    si n.genre == N_VAR {
        retour el_est_param(f, n);
    }
    si n.genre == N_APPEL {
        f.el_sans = 0;
    } sinon si !el_permis(n.genre) {
        retour 0;
    }
    retour el_corps_ok(f, n.a) && el_corps_ok(f, n.b) && el_corps_ok(f, n.c) && el_corps_liste(f, n.premier)
        && el_corps_liste(f, n.deuxieme);
}

fonction el_corps_liste(f: Fonction, x: Noeud) {
    tantque x != nul {
        si !el_corps_ok(f, x) {
            retour 0;
        }
        x = x.suivant;
    }
    retour 1;
}

// 2 : un calcul (ne lit pas la mémoire) ; 1 : pur (lit la mémoire, n'écrit rien) ; 0 : autre chose
fonction el_classe(c: Ctx, n: Noeud) {
    si n == nul {
        retour 2;
    }
    soit k = 2;
    si el_division(n) {
        retour 0;
    }
    si n.genre == N_APPEL {
        soit g = fonction_de(c, n.nom);
        si g == nul || g.el_pure == 0 {
            retour 0;
        }
        si g.el_pure == 1 {
            k = 1;
        }
    } sinon si n.genre == N_LIRE || n.genre == N_CHAMP {
        k = 1;
    } sinon si n.genre == N_RLIRE {
        // vtx64.py traduit t[i] d'un tableau de quits en lecture d'un mot (pur) dès l'analyse, et celui d'un tableau
        // de logiques en un appel de comme_logique (pas pur) : la même classe ici
        si tableau_de(c, n.nom).sorte == 2 {
            retour 0;
        }
        k = 1;
    } sinon si !el_permis(n.genre) {
        retour 0;
    }
    retour el_moins(el_moins(el_moins(k, el_classe(c, n.a)), el_moins(el_classe(c, n.b), el_classe(c, n.c))),
                    el_moins(el_classe_liste(c, n.premier), el_classe_liste(c, n.deuxieme)));
}

// la classe de deux morceaux ensemble : la plus faible (0 < 1 < 2)
fonction el_moins(a, b) {
    si a < b {
        retour a;
    }
    retour b;
}

fonction el_classe_liste(c: Ctx, x: Noeud) {
    soit k = 2;
    tantque x != nul {
        soit kx = el_classe(c, x);
        si kx == 0 {
            retour 0;
        }
        si kx == 1 {
            k = 1;
        }
        x = x.suivant;
    }
    retour k;
}

// ses seuls appels sont des appels de fonctions pures
fonction el_sans_ecriture(c: Ctx, n: Noeud) {
    si n == nul {
        retour 1;
    }
    si n.genre == N_APPEL {
        soit g = fonction_de(c, n.nom);
        si g == nul || g.el_pure == 0 {
            retour 0;
        }
    }
    retour el_sans_ecriture(c, n.a) && el_sans_ecriture(c, n.b) && el_sans_ecriture(c, n.c)
        && el_sans_ecriture_liste(c, n.premier) && el_sans_ecriture_liste(c, n.deuxieme);
}

fonction el_sans_ecriture_liste(c: Ctx, x: Noeud) {
    tantque x != nul {
        si !el_sans_ecriture(c, x) {
            retour 0;
        }
        x = x.suivant;
    }
    retour 1;
}

fonction el_types_simples(f: Fonction) {
    si large(f.rtype) {
        retour 0;
    }
    soit p = f.params;
    tantque p != nul {
        si large(p.type) {
            retour 0;
        }
        p = p.suivant;
    }
    retour 1;
}

// les fonctions recopiables, puis les pures, puis les corps sans écriture
fonction el_preparer(c: Ctx) {
    soit f = c.fonctions;
    tantque f != nul {
        f.el = 0;
        f.el_pure = 0;
        soit s = f.corps;
        soit pz = f.params;
        tantque pz != nul {
            pz.usages = 0;
            pz = pz.suivant;
        }
        si s != nul && s.suivant == nul && el_types_simples(f) {
            soit corps: Noeud = nul;
            soit genre = 0;
            si s.genre == N_RETOUR && s.a != nul {
                corps = s.a;
                genre = 1;
            } sinon si s.genre == N_ECRIRE || s.genre == N_ECRIRE_CHAMP || s.genre == N_EXPR {
                corps = s;
                genre = 2;
            }
            si genre != 0 {
                f.el_sans = 1;
                soit ok = 0;
                si genre == 1 {
                    ok = el_corps_ok(f, corps);
                } sinon {
                    ok = el_corps_ok(f, corps.a) && el_corps_ok(f, corps.b) && el_corps_ok(f, corps.c)
                        && el_corps_liste(f, corps.premier) && el_corps_liste(f, corps.deuxieme);
                }
                si ok {
                    f.el = genre;
                    f.el_corps = corps;
                }
            }
        }
        f = f.suivant;
    }
    f = c.fonctions;
    tantque f != nul {
        si f.el == 1 && f.el_sans {
            f.el_pure = el_classe(c, f.el_corps);
        }
        f = f.suivant;
    }
    f = c.fonctions;
    tantque f != nul {
        si f.el != 0 && !f.el_sans {
            si f.el == 1 {
                f.el_sans = el_sans_ecriture(c, f.el_corps);
            } sinon {
                f.el_sans = el_sans_ecriture(c, f.el_corps.a) && el_sans_ecriture(c, f.el_corps.b)
                    && el_sans_ecriture(c, f.el_corps.c) && el_sans_ecriture_liste(c, f.el_corps.premier)
                    && el_sans_ecriture_liste(c, f.el_corps.deuxieme);
            }
        }
        f = f.suivant;
    }
}

fonction el_copie1(n: Noeud): Noeud {
    retour Noeud { genre: n.genre, op: n.op, val: n.val, nom: n.nom, a: n.a, b: n.b, c: n.c, premier: n.premier,
                   deuxieme: n.deuxieme, ligne: n.ligne, zet: n.zet, zlo: n.zlo, zhi: n.zhi, copie: n.copie, expl: n.expl };
}

// n recopié, ses variables paramètres de f remplacées par les arguments a
fonction el_copier(f: Fonction, a: Noeud, n: Noeud): Noeud {
    si n == nul {
        retour nul;
    }
    si n.genre == N_VAR && n.el != 0 {
        soit x = a;
        pour k dans 1..n.el {
            x = x.suivant;
        }
        retour el_copie1(x);
    }
    soit m = el_copie1(n);
    m.a = el_copier(f, a, n.a);
    m.b = el_copier(f, a, n.b);
    m.c = el_copier(f, a, n.c);
    m.premier = el_copier_liste(f, a, n.premier);
    m.deuxieme = el_copier_liste(f, a, n.deuxieme);
    retour m;
}

fonction el_copier_liste(f: Fonction, a: Noeud, x: Noeud): Noeud {
    soit premier: Noeud = nul;
    soit dernier: Noeud = nul;
    tantque x != nul {
        soit y = el_copier(f, a, x);
        si dernier == nul {
            premier = y;
        } sinon {
            dernier.suivant = y;
        }
        dernier = y;
        x = x.suivant;
    }
    retour premier;
}

// L'appel nom(a…) recopié en ligne s'il peut l'être ; 0 sinon. instruction : 1 pour un appel écrit comme instruction
// (seules les fonctions à une instruction y sont recopiées), 0 dans une expression (seules les « retour E »).
fonction recopier(c: Ctx, f: Fonction, a: Noeud, instruction) {
    si !c.optim || f == nul || f.el == 0 || f.el_actif || c.el_prof >= 3 {
        retour 0;
    }
    si nb_args(a) != f.nb || (f.el == 2) != instruction {
        retour 0;
    }
    soit x = a;
    soit p = f.params;
    tantque x != nul {
        si typ(c, x) != p.type {
            retour 0;
        }
        si !(x.genre == N_VAR || x.genre == N_NOMBRE || x.genre == N_ETIQ) {
            soit k = 0;
            si p.usages <= 1 {
                k = el_classe(c, x);
            }
            si k == 0 || (k == 1 && !f.el_sans) {
                retour 0;
            }
        }
        x = x.suivant;
        p = p.suivant;
    }
    soit corps = el_copier(f, a, f.el_corps);
    f.el_actif = 1;
    c.el_prof = c.el_prof + 1;
    si f.el == 1 {
        gen_v(c, corps, f.rtype);
    } sinon {
        c.sans_ligne = 1;
        instr(c, corps);
    }
    f.el_actif = 0;
    c.el_prof = c.el_prof - 1;
    retour 1;
}

fonction appel(c: Ctx, e: Noeud) {
    soit nom = e.nom;
    soit a = e.premier;
    soit l = e.ligne;
    si egal(nom, "__code_logique") {
        si type_logique(c, a) != T_LOG {
            erreur(c, l, "un tableau de logique reçoit des logiques (vrai, faux, inconnu, variable) : utilisez logique() ou comme_logique()");
        }
        gen_v(c, a, T_LOG);
        retour;
    }
    si op_logique(nom) != 0 {
        typ(c, e);
        si c.erreur == 0 {
            gen_logique(c, e);
        }
        retour;
    }
    si egal(nom, "logique") || egal(nom, "comme_logique") {
        gen_vers_logique(c, e);
        retour;
    }
    si est_integre(nom) {
        si nb_args(a) != arite_integre(nom) {
            erreur_nom(c, l, "mauvais nombre d'arguments pour", nom);
            retour;
        }
        si egal(nom, "sortie") {
            soit ts = gen(c, a);
            emettre(c, ins(36, 0, 1, 0, 0));
            si large(ts) {
                emettre(c, ins(36, 0, 4, 0, 0));
            }
        } sinon si egal(nom, "entrée") {
            emettre(c, ins(35, 1, 0, 0, 0));
        } sinon si egal(nom, "cmp3") {
            gen_v(c, a, 0);
            rr(c, 18, 1, 1);
        } sinon si egal(nom, "lire_car") {
            gen_v(c, a, 0);
            rr(c, 81, 1, 1);
        } sinon si egal(nom, "ecrire_car") {
            deux(c, a.suivant, a);
            rrr(c, 82, 0, 1, 2);
            ldis(c, 1, 0);
        } sinon si egal(nom, "ouvrir_lecture") || egal(nom, "ouvrir_ecriture") || egal(nom, "fermer")
                || egal(nom, "fin_de") {
            soit code = 4;
            si egal(nom, "ouvrir_lecture") { code = 1; }
            si egal(nom, "ouvrir_ecriture") { code = 2; }
            si egal(nom, "fermer") { code = 3; }
            gen_v(c, a, 0);
            mov(c, 2, 1);
            ldis(c, 1, code);
            rrr(c, 83, 1, 1, 2);
        } sinon si egal(nom, "bruit") {
            ldis(c, 1, 5);
            rrr(c, 83, 1, 1, 0);
        } sinon si egal(nom, "pile") {
            // le sommet de la pile (R14) : pour le ramasse-miettes
            mov(c, 1, 14);
        } sinon si egal(nom, "__service") {
            deux(c, a, a.suivant);
            rrr(c, 83, 1, 1, 2);
        } sinon si egal(nom, "nb_bits") {
            gen_v(c, a, 0);
            rr(c, 80, 1, 1);
        } sinon si egal(nom, "qegal") {
            deux(c, a, a.suivant);
            rrr(c, 79, 1, 1, 2);
        } sinon si egal(nom, "gemv") {
            // n, w, puis les adresses q, k, o, placées à l'étage 2 (le GPU)
            soit x = a;
            soit kx = 0;
            tantque x != nul {
                gen_v(c, x, 0);
                si kx >= 2 {
                    rri(c, 31, 1, 1, 2);
                }
                pousser(c, 1);
                x = x.suivant;
                kx = kx + 1;
            }
            emettre(c, ins(57, 0, 0, 0, 0));
            rri(c, 6, 14, 14, 5);
            ldis(c, 1, 0);
        } sinon si egal(nom, "min4") || egal(nom, "max4") || egal(nom, "addm4") || egal(nom, "gdot")
                || egal(nom, "mul_haut") || egal(nom, "mul_haut_signe") {
            soit op4 = 16;
            si egal(nom, "max4") { op4 = 17; }
            si egal(nom, "addm4") { op4 = 19; }
            si egal(nom, "gdot") { op4 = 56; }
            si egal(nom, "mul_haut") { op4 = 78; }
            si egal(nom, "mul_haut_signe") { op4 = 30; }
            deux(c, a, a.suivant);
            rrr(c, op4, 1, 1, 2);
        } sinon si egal(nom, "brin") {
            // le brin d'un mot : 0 libre, 1 ADN (fixé), 2 ARN (travail)
            gen_v(c, a, 0);
            rr(c, 95, 1, 1);
        } sinon si egal(nom, "marquer_adn") || egal(nom, "marquer_arn") || egal(nom, "liberer_brin") {
            soit q = 0;
            si egal(nom, "marquer_adn") { q = 1; }
            si egal(nom, "marquer_arn") { q = 2; }
            deux(c, a, a.suivant);
            emettre(c, ins(94, 0, 1, 2, q));
            ldis(c, 1, 0);
        } sinon {
            conversion(c, e);
        }
        retour;
    }
    si est_surcharge(nom) {
        soit tsur = type_surcharge(c, e);
        si tsur == T_W {
            soit pw = liste();
            ajouter_texte(pw, "__q");
            ajouter_texte(pw, nom);
            appel(c, Noeud { genre: N_APPEL, nom: texte_de(pw, 0, pw.n), premier: a, ligne: l });
            retour;
        }
        si tsur == T_X {
            soit px = liste();
            ajouter_texte(px, "__pq_");
            ajouter_texte(px, nom);
            soit premier: Noeud = nul;
            soit dernier: Noeud = nul;
            soit y = a;
            tantque y != nul {
                soit bx = bits_x(c, y);
                si dernier == nul { premier = bx; } sinon { dernier.suivant = bx; }
                dernier = bx;
                y = y.suivant;
            }
            appel(c, Noeud { genre: N_APPEL, nom: texte_de(px, 0, px.n), premier: premier, ligne: l });
            retour;
        }
        si tsur == T_F || tsur == T_S || tsur == T_I {
            surcharge(c, e, tsur);
            retour;
        }
    }
    // afficher(x), ecrire(x), texte(x) : la version du prélude qui convient au type de x
    si (egal(nom, "afficher") || egal(nom, "ecrire") || egal(nom, "texte")) && a != nul && a.suivant == nul {
        soit pf = fonction_de(c, nom);
        si pf != nul && pf.prelude {
            soit ta = type_logique(c, a);
            soit suffixe = 0;
            si ta == T_I { suffixe = "_i"; }
            si ta == T_F { suffixe = "_f"; }
            si ta == T_S { suffixe = "_s"; }
            si ta == T_LOG { suffixe = "_q"; }
            si ta == T_W { suffixe = "_w"; }
            si ta == T_X { suffixe = "_x"; }
            si suffixe != 0 {
                soit lt = liste();
                ajouter_texte(lt, "__");
                ajouter_texte(lt, nom);
                ajouter_texte(lt, suffixe);
                nom = texte_de(lt, 0, lt.n);
            }
        }
    }
    soit f = fonction_de(c, nom);
    si f != nul && f.el == 1 && recopier(c, f, a, 0) {
        retour;
    }
    si f == nul {
        erreur_nom(c, l, "fonction inconnue :", nom);
        retour;
    }
    soit etiq_appel = demander(c, f);   // comme vtx64.py : la fonction est demandée avant la génération des arguments
    si nb_args(a) != f.nb {
        erreur_nom(c, l, "mauvais nombre d'arguments pour", nom);
        retour;
    }
    soit n = 0;
    soit p = f.params;
    tantque a != nul {
        gen_v(c, a, p.type);
        pousser(c, 1);
        n = n + 1;
        si large(p.type) {
            pousser(c, 4);
            n = n + 1;
        }
        a = a.suivant;
        p = p.suivant;
    }
    saut(c, 51, etiq_appel);
    si n != 0 {
        rri(c, 6, 14, 14, n);
    }
}

// conversion(nom, x) appelée sur un noeud fabriqué
fonction conversion_nom(c: Ctx, nom, x: Noeud, l) {
    soit y = copier(x);
    y.suivant = nul;
    conversion(c, Noeud { genre: N_APPEL, nom: nom, premier: y, ligne: l });
}

// les conversions et les fonctions intégrées de type (comme Generateur.conversion de vtx64.py)
fonction conversion(c: Ctx, e: Noeud) {
    soit nom = e.nom;
    soit x = e.premier;
    soit l = e.ligne;
    soit t = typ(c, x);
    soit interdit = 0;
    si egal(nom, "flottant_petuar") || egal(nom, "flottant_128") {
        si t == T_X {
            gen(c, x);
        } sinon si est_entier_t(t) {
            appel(c, appel_n("__pq_de_e", copier(x), l));
        } sinon si t == T_F {
            appel(c, appel_n("__pq_de_f", copier(x), l));
        } sinon si t == T_S {
            appel(c, appel_n("__pq_de_s", copier(x), l));
        } sinon si t == T_W {
            appel(c, appel_n("__pq_de_w", copier(x), l));
        } sinon {
            interdit = 1;
        }
    } sinon si egal(nom, "comme_flottant_petuar") {
        interdit = t != T_W;
        si !interdit {
            gen(c, x);
        }
    } sinon si egal(nom, "vers_ieee128") {
        interdit = t != T_X;
        si !interdit {
            appel(c, appel_n("__pq_vers_ieee", bits_x(c, x), l));
        }
    } sinon si egal(nom, "de_ieee128") {
        interdit = t != T_W;
        si !interdit {
            appel(c, appel_n("__pq_de_ieee", copier(x), l));
        }
    } sinon si t == T_X {
        // un flottant_petuar vers les autres types : par le prélude
        si egal(nom, "bits") {
            gen(c, x);
        } sinon si egal(nom, "racine") {
            appel(c, appel_n("__pq_racine", bits_x(c, x), l));
        } sinon si egal(nom, "flottant") || egal(nom, "flottant_64") {
            appel(c, appel_n("__pq_vers_f", bits_x(c, x), l));
        } sinon si egal(nom, "flottant_32") {
            appel(c, appel_n("__pq_vers_s", bits_x(c, x), l));
        } sinon si egal(nom, "entier_128") || egal(nom, "entier_petuar") || egal(nom, "entier")
                || egal(nom, "entier_32") {
            appel(c, appel_n("__pq_vers_w", bits_x(c, x), l));
            si egal(nom, "entier_32") {
                rr(c, 28, 1, 1);
            }
        } sinon {
            interdit = 1;
        }
    } sinon si egal(nom, "flottant") || egal(nom, "flottant_64") {
        si t == T_W {
            appel(c, appel_n("__pq_vers_f", appel_n("__pq_de_w", copier(x), l), l));
        } sinon si est_entier_t(t) || t == T_F || t == T_S {
            gen(c, x);
            si est_entier_t(t) { rr(c, 72, 1, 1); }
            si t == T_S { rr(c, 104, 1, 1); }
        } sinon {
            interdit = 1;
        }
    } sinon si egal(nom, "flottant_32") {
        si est_entier_t(t) || t == T_F || t == T_S {
            gen(c, x);
            si est_entier_t(t) { rr(c, 72, 1, 1); }
            si t != T_S { rr(c, 105, 1, 1); }
        } sinon {
            interdit = 1;
        }
    } sinon si egal(nom, "flottant_signe") {
        si est_entier_t(t) {
            gen(c, x);
            si t == T_I { rr(c, 29, 1, 1); }
            rr(c, 73, 1, 1);
        } sinon {
            interdit = 1;
        }
    } sinon si egal(nom, "entier") || egal(nom, "entier_32") {
        gen(c, x);
        si t != T_W {
            si t == T_S { rr(c, 104, 1, 1); }
            si t == T_F || t == T_S { rr(c, 74, 1, 1); }
        }
        si egal(nom, "entier_32") {
            rr(c, 28, 1, 1);
        }
    } sinon si egal(nom, "arrondi") {
        si t == T_F || t == T_S {
            gen(c, x);
            si t == T_S { rr(c, 104, 1, 1); }
            rr(c, 75, 1, 1);
        } sinon {
            interdit = 1;
        }
    } sinon si egal(nom, "racine") {
        si t == T_S {
            gen(c, x);
            rr(c, 103, 1, 1);
        } sinon {
            gen_v(c, x, T_F);
            rr(c, 71, 1, 1);
        }
    } sinon si egal(nom, "comme_flottant") || egal(nom, "comme_flottant_32") || egal(nom, "bits") {
        si t == T_W || t == T_LOG || (!egal(nom, "bits") && !est_entier_t(t)) {
            interdit = 1;
        } sinon {
            gen(c, x);
            si egal(nom, "comme_flottant_32") {
                rr(c, 28, 1, 1);
            }
        }
    } sinon si egal(nom, "vers_ieee64") {
        si t == T_F {
            gen(c, x);
            rr(c, 108, 1, 1);
        } sinon {
            interdit = 1;
        }
    } sinon si egal(nom, "de_ieee64") {
        si est_entier_t(t) {
            gen(c, x);
            rr(c, 109, 1, 1);
        } sinon {
            interdit = 1;
        }
    } sinon si egal(nom, "entier_128") || egal(nom, "entier_petuar") {
        si t == T_F || t == T_S {
            appel(c, appel_n("__pq_vers_w", appel_n("flottant_petuar", copier(x), l), l));
        } sinon si est_entier_t(t) || t == T_W {
            gen(c, x);
            si est_entier_t(t) {
                ldis(c, 4, 0);
            }
        } sinon {
            interdit = 1;
        }
    } sinon si egal(nom, "entier_128_signe") || egal(nom, "entier_petuar_signe") {
        si est_entier_t(t) {
            gen(c, x);
            si t == T_I { rr(c, 29, 1, 1); }
            ldis(c, 2, 63);
            rrr(c, 23, 4, 1, 2);
        } sinon {
            interdit = 1;
        }
    } sinon si egal(nom, "entier_128_de") || egal(nom, "entier_petuar_de") {
        si est_entier_t(t) && x.suivant != nul && est_entier_t(typ(c, x.suivant)) {
            deux(c, x, x.suivant);
            mov(c, 4, 1);
            mov(c, 1, 2);
        } sinon {
            interdit = 1;
        }
    } sinon si egal(nom, "bas") || egal(nom, "haut") {
        si large(t) {
            gen(c, x);
            si egal(nom, "haut") {
                mov(c, 1, 4);
            }
        } sinon {
            interdit = 1;
        }
    }
    si interdit {
        erreur_nom(c, l, "argument d'un type qui ne convient pas à", nom);
    }
}

// abs, min et max des flottants (64 et 32 bits) et des entier_32, en ligne
fonction surcharge(c: Ctx, e: Noeud, t) {
    soit a = e.premier;
    si egal(e.nom, "abs") {
        si nb_args(a) != 1 {
            erreur(c, e.ligne, "« abs » attend 1 argument");
            retour;
        }
        gen_v(c, a, t);
        soit fin = nouvelle_etiquette(c);
        si t == T_I {
            charger(c, 2, 2147483648);
            rrr(c, 20, 3, 1, 2);
            cmp(c, 3, 0);
            saut(c, 49, fin);
            rrr(c, 2, 1, 0, 1);
            rr(c, 28, 1, 1);
        } sinon {
            // l'état d'un nombre négatif est 1 (Belnap : faux) ; inconnu et variable restent eux-mêmes
            si t == T_F { charger(c, 2, 62); } sinon { charger(c, 2, 30); }
            rrr(c, 9, 3, 1, 2);
            ldis(c, 2, 3);
            rrr(c, 20, 3, 3, 2);
            cmpi(c, 3, 1);
            saut(c, 50, fin);
            si t == T_F { rr(c, 91, 1, 1); } sinon { rr(c, 106, 1, 1); }
        }
        poser_etiquette(c, fin);
        retour;
    }
    si nb_args(a) != 2 {
        erreur_nom(c, e.ligne, "deux arguments attendus pour", e.nom);
        retour;
    }
    paire(c, a, a.suivant, t);
    soit prendre = nouvelle_etiquette(c);
    soit fin2 = nouvelle_etiquette(c);
    soit est_min = egal(e.nom, "min");
    si t == T_F || t == T_S {
        soit flt = 69;
        si t == T_S { flt = 101; }
        si est_min { rrr(c, flt, 3, 2, 1); } sinon { rrr(c, flt, 3, 1, 2); }
        cmp(c, 3, 0);
        saut(c, 50, prendre);
    } sinon {
        charger(c, 8, 2147483648);
        rrr(c, 22, 6, 1, 8);
        rrr(c, 22, 7, 2, 8);
        si est_min { cmp(c, 7, 6); } sinon { cmp(c, 6, 7); }
        saut(c, 53, prendre);
    }
    saut(c, 48, fin2);
    poser_etiquette(c, prendre);
    mov(c, 1, 2);
    poser_etiquette(c, fin2);
}

// --------------------------------------------------------------------------------------------- tableaux rangés
// t[i] d'un tableau de quits ou de logiques (32 par mot) : (@e[base + (i >> 5)] >> ((i & 31) * 2)) & 3
fonction mot_rangee(t: Tableau, idx: Noeud, l): Noeud {
    soit adr = bin(">>", idx, nombre(5, l), l);
    si t.base != 0 {
        adr = bin("+", nombre(t.base, l), adr, l);
    }
    retour Noeud { genre: N_LIRE, val: t.etage, b: adr, ligne: l, zet: t.etage + 1, zlo: t.base,
                   zhi: t.base + (t.taille + 31) / 32 };
}

fonction decalage_rangee(idx: Noeud, l): Noeud {
    retour bin("*", bin("&", idx, nombre(31, l), l), nombre(2, l), l);
}

// t[i] traduit en lecture de mot : (mot >> décalage) & 3, lu comme un logique pour un tableau de logiques
fonction rangee_basse(c: Ctx, e: Noeud): Noeud {
    soit t = tableau_de(c, e.nom);
    soit l = e.ligne;
    soit v = bin("&", bin(">>", mot_rangee(t, e.a, l), decalage_rangee(e.a, l), l), nombre(3, l), l);
    si t.sorte == 2 {
        retour Noeud { genre: N_APPEL, nom: "comme_logique", premier: v, ligne: l };
    }
    retour v;
}

// --------------------------------------------------------------------------------------------- quits rangés
// t[i] d'un tableau de quits ou de logiques s'écrit (@e[base + (i >> 5)] >> ((i & 31) * 2)) & 3 ; avec les
// optimisations, cette forme (et celle de l'écriture) devient LDQ (et STQ) quand l'indice est simple : un nombre, une
// variable, ou a + b, a - b, a × b de ceux-là, le même à chaque place. Comme vtx64.py (motif_quit, motif_ecriture_quit).
structure Quit { etg, base, idx: Noeud, v: Noeud }

fonction est_nombre(e: Noeud, v) {
    retour e != nul && e.genre == N_NOMBRE && e.val == v;
}

fonction est_bin(e: Noeud, o) {
    retour e != nul && e.genre == N_BIN && egal(e.op, o);
}

fonction feuille_q(e: Noeud) {
    retour e != nul && (e.genre == N_NOMBRE || e.genre == N_VAR);
}

fonction indice_simple(e: Noeud) {
    si feuille_q(e) {
        retour 1;
    }
    retour e != nul && e.genre == N_BIN && (egal(e.op, "+") || egal(e.op, "-") || egal(e.op, "*"))
        && feuille_q(e.a) && feuille_q(e.b);
}

fonction meme_feuille(a: Noeud, b: Noeud) {
    si a.genre != b.genre {
        retour 0;
    }
    si a.genre == N_NOMBRE {
        retour a.val == b.val;
    }
    retour egal(a.nom, b.nom) && a.ligne == b.ligne;
}

fonction meme_indice(a: Noeud, b: Noeud) {
    si a.genre != b.genre {
        retour 0;
    }
    si a.genre == N_BIN {
        retour egal(a.op, b.op) && meme_feuille(a.a, b.a) && meme_feuille(a.b, b.b);
    }
    retour meme_feuille(a, b);
}

// base + (i >> 5) (ou i >> 5) et (i & 31) * 2, avec le même indice simple
fonction motif_place(etg, adr: Noeud, dec: Noeud): Quit {
    si !(est_bin(dec, "*") && est_nombre(dec.b, 2) && est_bin(dec.a, "&") && est_nombre(dec.a.b, 31)) {
        retour nul;
    }
    soit idx = dec.a.a;
    si !indice_simple(idx) {
        retour nul;
    }
    si est_bin(adr, ">>") && meme_indice(adr.a, idx) && est_nombre(adr.b, 5) {
        retour Quit { etg: etg, base: 0, idx: idx };
    }
    si est_bin(adr, "+") && adr.a.genre == N_NOMBRE && est_bin(adr.b, ">>") && meme_indice(adr.b.a, idx)
            && est_nombre(adr.b.b, 5) {
        retour Quit { etg: etg, base: adr.a.val, idx: idx };
    }
    retour nul;
}

fonction meme_place(p: Quit, q: Quit) {
    retour p != nul && q != nul && p.etg == q.etg && p.base == q.base && meme_indice(p.idx, q.idx);
}

fonction motif_quit(e: Noeud): Quit {
    si !(est_bin(e, "&") && est_nombre(e.b, 3) && est_bin(e.a, ">>")) {
        retour nul;
    }
    soit lu = e.a.a;
    si lu.genre != N_LIRE || lu.a != nul || lu.val == 4 {
        retour nul;
    }
    retour motif_place(lu.val, lu.b, e.a.b);
}

fonction motif_ecriture_quit(s: Noeud): Quit {
    soit nv = s.c;
    si s.a != nul || s.val == 4 || !(est_bin(nv, "|") && est_bin(nv.a, "&") && est_bin(nv.b, "<<")) {
        retour nul;
    }
    soit lu = nv.a.a;
    soit garde = nv.a.b;
    soit mis = nv.b;
    si !(lu.genre == N_LIRE && lu.a == nul && lu.val == s.val && garde.genre == N_NON && est_bin(garde.a, "<<")
            && est_nombre(garde.a.a, 3) && est_bin(mis.a, "&") && est_nombre(mis.a.b, 3)) {
        retour nul;
    }
    soit q = motif_place(s.val, s.b, garde.a.b);
    si q == nul || !meme_place(motif_place(s.val, lu.b, garde.a.b), q) || !meme_place(motif_place(s.val, s.b, mis.b), q) {
        retour nul;
    }
    q.v = mis.a.a;
    retour q;
}

// --------------------------------------------------------------------------------------------- génération des instructions
// Pas à pas : l'adresse où commence une instruction du programme et sa ligne dans le fichier (pas les fichiers
// importés ni le prélude)
fonction noter_ligne(c: Ctx, ligne) {
    si ligne == 0 || c.fcour == nul || c.fcour.prelude {
        retour;
    }
    soit l = ligne;
    si c.segs_prog != nul {
        soit k = 0 - 1;
        pour i dans 0..c.segs_prog.n / 3 {
            si elem(c.segs_prog, 3 * i) <= ligne {
                k = i;
            }
        }
        si k != 0 - 1 {
            si elem(c.segs_prog, 3 * k + 1) != 0 {
                retour;
            }
            l = elem(c.segs_prog, 3 * k + 2) + ligne - elem(c.segs_prog, 3 * k);
        }
    }
    ajouter(c.dbg, c.code.n);
    ajouter(c.dbg, l);
}

// x = a op b, x entier en registre : le calcul va directement dans le registre de x
fonction reg_direct(c: Ctx, s: Noeud) {
    soit v = var_ou_nul(c, s.nom);
    si v == nul || v.reg == 0 || v.type != 0 {
        retour 0;
    }
    soit x = s.a;
    si x.genre == N_RLIRE {
        // vtx64.py a déjà traduit t[i] d'un tableau de quits en (mot >> décalage) & 3 : le même calcul, direct
        x = rangee_basse(c, x);
    }
    si x.genre != N_BIN || code_operation(x.op) == 0 {
        retour 0;
    }
    si typ(c, x) != 0 || typ(c, x.a) != 0 || typ(c, x.b) != 0 {
        retour 0;
    }
    soit rt = v.reg;
    si (egal(x.op, "+") || egal(x.op, "-")) && x.a.genre == N_VAR && egal(x.a.nom, s.nom)
            && x.b.genre == N_NOMBRE && x.b.val < 2147483648 {
        si egal(x.op, "+") {
            rri(c, 6, rt, rt, x.b.val);
        } sinon {
            rri(c, 7, rt, rt, x.b.val);
        }
        retour 1;
    }
    soit pk = deux_ops(c, x.a, x.b);
    rrr(c, code_operation(x.op), rt, pk >> 4, pk & 15);
    retour 1;
}

fonction ranger(c: Ctx, v: Var) {
    si v.reg != 0 {
        mov(c, v.reg, 1);
        retour;
    }
    stf(c, 1, v.off);
    si large(v.type) {
        stf(c, 4, v.off - 1);
    }
}

fonction instr(c: Ctx, s: Noeud) {
    soit g = s.genre;
    si c.lignes_dbg == 1 && c.sans_ligne == 0 {
        noter_ligne(c, s.ligne);
    }
    c.sans_ligne = 0;
    si (g == N_SOIT || g == N_AFFECTER) && c.optim && reg_direct(c, s) {
        retour;
    }
    si g == N_SOIT || g == N_AFFECTER {
        soit v = var_de(c, s.nom, s.ligne);
        si g == N_SOIT && est_struct(v.type) && s.val == v.type && (s.a.genre == N_VAR || s.a.genre == N_APPEL)
                && typ(c, s.a) == 0 {
            // soit x: Structure = variable ou appel entier : la déclaration explicite vaut conversion
            gen(c, s.a);
        } sinon {
            gen_v(c, s.a, v.type);
        }
        ranger(c, v);
    } sinon si g == N_ECRIRE {
        soit qe: Quit = nul;
        si c.optim {
            qe = motif_ecriture_quit(s);
        }
        si qe != nul {
            // STQ : le quit i d'un tableau rangé reçoit la valeur, en une instruction
            deux(c, qe.v, qe.idx);
            soit b = qe.base | (qe.etg << 62);
            soit rbq = 0;
            si b != 0 {
                charger(c, 3, b);
                rbq = 3;
            }
            rrr(c, 85, 1, rbq, 2);
        } sinon {
            ecrire_mem(c, s.val, s.a, s.b, s.c, s.ligne);
        }
    } sinon si g == N_ECRIRE_CHAMP {
        soit t = typ(c, s.a);
        soit st0 = struct_numero(c, t);
        soit pos = position_champ(st0, s.nom);
        soit tch = champ_de(c, st0, s.nom).type;
        si large(tch) {
            erreur(c, s.ligne, "un champ ne peut pas contenir une valeur de deux mots");
        }
        gen(c, s.a);
        pousser(c, 1);
        gen_v(c, s.c, tch);
        mov(c, 2, 1);
        depiler(c, 1);
        st(c, 1, 2, pos);
    } sinon si g == N_SI {
        soit sinon_ = nouvelle_etiquette(c);
        soit fin = nouvelle_etiquette(c);
        saut_faux(c, s.a, sinon_);
        instrs(c, s.premier);
        si s.val == 1 {
            saut(c, 48, fin);
        }
        poser_etiquette(c, sinon_);
        si s.val == 1 {
            instrs(c, s.deuxieme);
            poser_etiquette(c, fin);
        }
    } sinon si g == N_TANTQUE {
        soit haut = nouvelle_etiquette(c);
        soit fin2 = nouvelle_etiquette(c);
        poser_etiquette(c, haut);
        saut_faux(c, s.a, fin2);
        c.boucles = Boucle { haut: haut, fin: fin2, suivant: c.boucles };
        instrs(c, s.premier);
        c.boucles = c.boucles.suivant;
        saut(c, 48, haut);
        poser_etiquette(c, fin2);
    } sinon si g == N_POUR {
        soit vp = var_de(c, s.nom, s.ligne);
        soit off = vp.off;
        soit haut2 = nouvelle_etiquette(c);
        soit suite = nouvelle_etiquette(c);
        soit fin3 = nouvelle_etiquette(c);
        gen_v(c, s.a, 0);
        si vp.reg != 0 {
            mov(c, vp.reg, 1);
        } sinon {
            stf(c, 1, off);
        }
        poser_etiquette(c, haut2);
        si c.lignes_dbg == 1 {
            noter_ligne(c, s.ligne);
        }
        saut_faux(c, bin("<", Noeud { genre: N_VAR, nom: s.nom, ligne: s.ligne }, s.b, s.ligne), fin3);
        c.boucles = Boucle { haut: suite, fin: fin3, suivant: c.boucles };
        instrs(c, s.premier);
        c.boucles = c.boucles.suivant;
        poser_etiquette(c, suite);
        si vp.reg != 0 {
            rri(c, 6, vp.reg, vp.reg, s.val);        // la variable de boucle en registre : un seul pas
        } sinon {
            ldf(c, 1, off);
            rri(c, 6, 1, 1, s.val);
            stf(c, 1, off);
        }
        saut(c, 48, haut2);
        poser_etiquette(c, fin3);
    } sinon si g == N_RECRIRE {
        // soit __qi = i ; soit __qv = v ; mot = (mot & ~(3 << d)) | ((__qv & 3) << d)
        soit tr = tableau_de(c, s.nom);
        soit lr = s.ligne;
        soit vi = var_de(c, nom_cache("__qi", s.val), lr);
        soit vv = var_de(c, nom_cache("__qv", s.val), lr);
        gen_v(c, s.a, 0);
        stf(c, 1, vi.off);
        si tr.sorte == 2 {
            si type_logique(c, s.c) != T_LOG {
                erreur(c, lr, "un tableau de logique reçoit des logiques (vrai, faux, inconnu, variable) : utilisez logique() ou comme_logique()");
            }
            gen_v(c, s.c, T_LOG);
        } sinon {
            gen_v(c, s.c, 0);
        }
        stf(c, 1, vv.off);
        soit qi = Noeud { genre: N_VAR, nom: vi.nom, ligne: lr };
        soit qv = Noeud { genre: N_VAR, nom: vv.nom, ligne: lr };
        soit m = mot_rangee(tr, qi, lr);
        soit d = decalage_rangee(qi, lr);
        soit garde = bin("&", m, Noeud { genre: N_NON, a: bin("<<", nombre(3, lr), d, lr), ligne: lr }, lr);
        soit neuf = bin("|", garde, bin("<<", bin("&", qv, nombre(3, lr), lr), d, lr), lr);
        instr(c, Noeud { genre: N_ECRIRE, val: tr.etage, b: m.b, c: neuf, ligne: lr });
    } sinon si g == N_ACCORD {
        soit me = s.premier;
        soit k = 1;
        tantque me != nul {
            soit ta = me.premier;
            tantque ta != nul {
                marquer(c, 1, s.val, k);
                instr(c, ta);
                ta = ta.suivant;
            }
            me = me.suivant;
            k = k + 1;
        }
        marquer(c, 2, s.val, 0);
    } sinon si g == N_BLOC {
        instrs(c, s.premier);
    } sinon si g == N_DONNEES {
        // une boucle par bloc : l'adresse de destination est longue (l'étage dedans)
        soit dn = c.blocs;
        tantque dn != nul {
            si dn.vals.n > 0 {
                ldi_etiquette(c, 1, dn.etiq);
                emettre(c, ins(10, 2, 0, 0, 0));
                emettre(c, (dn.adr & 4611686018427387903) | (dn.etage << 62));
                emettre(c, ins(10, 3, 0, 0, 0));
                emettre(c, dn.vals.n);
                soit boucle = nouvelle_etiquette(c);
                poser_etiquette(c, boucle);
                ld(c, 5, 1, 0);
                st(c, 2, 5, 0);
                rri(c, 6, 1, 1, 1);
                rri(c, 6, 2, 2, 1);
                rri(c, 7, 3, 3, 1);
                saut(c, 50, boucle);
            }
            dn = dn.suivant;
        }
    } sinon si (g == N_ARRETER || g == N_CONTINUER) && c.boucles == nul {
        erreur(c, s.ligne, "« arrêter » ou « continuer » hors d'une boucle");
    } sinon si g == N_ARRETER {
        saut(c, 48, c.boucles.fin);
    } sinon si g == N_CONTINUER {
        saut(c, 48, c.boucles.haut);
    } sinon si g == N_RETOUR {
        si s.a == nul {
            ldis(c, 1, 0);
            si large(c.fcour.rtype) {
                ldis(c, 4, 0);
            }
        } sinon {
            gen_v(c, s.a, c.fcour.rtype);
        }
        si c.retour_final == 0 {
            saut(c, 48, c.ffin);
        }
    } sinon si g == N_EXPR {
        si s.a.genre == N_APPEL {
            soit fx = fonction_de(c, s.a.nom);
            si fx != nul && fx.el == 2 && recopier(c, fx, s.a.premier, 1) {
                retour;
            }
        }
        gen(c, s.a);
    }
}

fonction instrs(c: Ctx, s: Noeud) {
    tantque s != nul && c.erreur == 0 {
        instr(c, s);
        s = s.suivant;
    }
}

// Variables locales, dans l'ordre de vtx64.py : soit et pour, en profondeur (si : alors puis sinon)
fonction locales(c: Ctx, s: Noeud, nl) {
    tantque s != nul {
        si s.genre == N_SOIT || s.genre == N_POUR {
            soit genre = 1;
            si s.genre == N_POUR || (s.op != 0 && egal(s.op, "chaque")) {
                genre = 2;
            }
            soit trouve = var_ou_nul(c, s.nom);
            // la variable d'un « pour x dans t » a le type de ses valeurs (flottant pour un tableau de flottants)
            soit t = 0;
            si s.genre == N_SOIT {
                t = s.val;
                si t == 0 && s.expl != 1 {
                    t = typ(c, s.a);          // « soit x: entier = … » garde le type écrit
                }
            }
            si trouve != nul {
                si !(trouve.genre == 2 && genre == 2) {
                    erreur(c, s.ligne, "variable déjà déclarée");
                } sinon si t != trouve.type {
                    erreur(c, s.ligne, "la variable de boucle change de type : donnez-lui un autre nom");
                }
            } sinon {
                nl = nl + 1;
                c.vars = Var { nom: s.nom, off: 0 - nl, type: t, genre: genre, suivant: c.vars };
                noter_var(c);
                si large(t) {
                    nl = nl + 1;
                    c.vars.haut = 0 - nl;
                }
            }
            si s.genre == N_POUR && !s.copie {
                nl = locales(c, s.premier, nl);
            }
        } sinon si s.genre == N_SI {
            nl = locales(c, s.premier, nl);
            si s.val == 1 {
                nl = locales(c, s.deuxieme, nl);
            }
        } sinon si s.genre == N_TANTQUE || s.genre == N_BLOC {
            nl = locales(c, s.premier, nl);
        } sinon si s.genre == N_ACCORD {
            soit me = s.premier;
            tantque me != nul {
                soit ta = me.premier;
                tantque ta != nul {
                    soit suite_t = ta.suivant;
                    ta.suivant = nul;
                    nl = locales(c, ta, nl);
                    ta.suivant = suite_t;
                    ta = suite_t;
                }
                me = me.suivant;
            }
        } sinon si s.genre == N_RECRIRE {
            c.vars = Var { nom: nom_cache("__qi", s.val), off: 0 - nl - 1, type: 0, genre: 1, suivant: c.vars };
            noter_var(c);
            c.vars = Var { nom: nom_cache("__qv", s.val), off: 0 - nl - 2, type: 0, genre: 1, suivant: c.vars };
            noter_var(c);
            nl = nl + 2;
        }
        s = s.suivant;
    }
    retour nl;
}

// Paramètres : le dernier est à +2, le premier tout en haut ; une valeur de deux mots en prend deux (le haut d'abord)
fonction placer(c: Ctx, p: Param, ligne) {
    si p == nul {
        retour 2;
    }
    soit o = placer(c, p.suivant, ligne);
    si var_ou_nul(c, p.nom) != nul {
        erreur_nom(c, ligne, "paramètre en double :", p.nom);
    }
    si large(p.type) {
        c.vars = Var { nom: p.nom, off: o + 1, haut: o, type: p.type, genre: 3, suivant: c.vars };
        noter_var(c);
        retour o + 2;
    }
    c.vars = Var { nom: p.nom, off: o, type: p.type, genre: 3, suivant: c.vars };
    noter_var(c);
    retour o + 1;
}

// --------------------------------------------------------------------------------------------- épissage
// Le même épissage que vtx64.py (voir EPISSAGE) : les mots d'une fonction sont relus comme une suite d'opérations simples,
// et les introns (déplacements de valeurs) retirés par cinq règles : pile, constante, relecture, copie, échange. Chaque règle
// demande qu'un registre soit mort : l'analyse de vie de R1 à R8 sur le graphe de la fonction le dit.

constante RI_TOUS = 510;            // R1 à R8

// la sorte d'une instruction : 1 d s t (d écrit), 2 d s (d écrit), 3 d écrit seul, 4 d lu (STF), 5 s lu (OUT, PUSH,
// CMPI), 6 s t lus (CMP), 7 d s lus (ST), 8 d s t lus (STX, STQ), 9 saut, 10 appel, 11 retour, 12 arrêt, 0 autre
fonction ri_sorte_lent(op) {
    si op == 1 || op == 2 || op == 3 || op == 8 || op == 9 || op == 23 || op == 12 || op == 13 || op == 26 || op == 27
            || op == 16 || op == 17 || op == 19 || op == 20 || op == 21 || op == 22 || op == 56 || (op >= 64 && op <= 70)
            || op == 93 || (op >= 96 && op <= 102) || op == 78 || op == 30 || op == 79 || op == 41 || op == 84
            || op == 86 || op == 87 || op == 90 || op == 34 {
        retour 1;
    }
    si op == 4 || op == 5 || op == 11 || op == 18 || (op >= 71 && op <= 75) || op == 91 || op == 92 || op == 108
            || op == 109 || op == 103 || op == 106 || op == 104 || op == 105 || op == 28 || op == 29 || op == 80 || op == 6
            || op == 7 || op == 31 || op == 32 || op == 88 || op == 89 || op == 95 {
        retour 2;
    }
    si op == 10 || op == 24 || op == 25 || op == 37 || op == 35 || op == 40 { retour 3; }
    si op == 38 { retour 4; }
    si op == 36 || op == 39 || op == 15 { retour 5; }
    si op == 14 { retour 6; }
    si op == 33 { retour 7; }
    si op == 42 || op == 85 { retour 8; }
    si op == 48 || op == 49 || op == 50 || op == 53 || op == 54 { retour 9; }
    si op == 51 { retour 10; }
    si op == 52 { retour 11; }
    si op == 63 { retour 12; }
    retour 0;
}

fonction ri_bit(r) {
    si r >= 1 && r <= 8 {
        retour 1 << r;
    }
    retour 0;
}

fonction ri_op(w) { retour w >> 48; }
fonction ri_d(w) { retour (w >> 44) & 15; }
fonction ri_s(w) { retour (w >> 40) & 15; }
fonction ri_t(w) { retour (w >> 36) & 15; }

// registres écrits (masque de R1 à R8)
fonction ri_ecr(w) {
    soit s = ri_sorte(ri_op(w));
    si s == 1 || s == 2 || s == 3 {
        retour ri_bit(ri_d(w));
    }
    retour 0;
}

// registres lus (masque de R1 à R8) ; une barrière les lit tous
fonction ri_lus(w) {
    soit s = ri_sorte(ri_op(w));
    soit d = ri_d(w);
    soit sr = ri_s(w);
    soit t = ri_t(w);
    si s == 1 || s == 8 {
        soit m = ri_bit(sr) | ri_bit(t);
        si s == 8 { m = m | ri_bit(d); }
        retour m;
    }
    si s == 2 || s == 5 { retour ri_bit(sr); }
    si s == 4 { retour ri_bit(d); }
    si s == 6 { retour ri_bit(sr) | ri_bit(t); }
    si s == 7 { retour ri_bit(d) | ri_bit(sr); }
    si s == 0 { retour RI_TOUS; }
    retour 0;
}

// tous les registres nommés (R0 à R15), lus ou écrits, d'une instruction simple
fonction ri_nommes(w) {
    soit s = ri_sorte(ri_op(w));
    soit d = 1 << ri_d(w);
    soit sr = 1 << ri_s(w);
    soit t = 1 << ri_t(w);
    si s == 1 || s == 8 { retour d | sr | t; }
    si s == 2 || s == 7 { retour d | sr; }
    si s == 3 || s == 4 { retour d; }
    si s == 5 { retour sr; }
    si s == 6 { retour sr | t; }
    retour 0;
}

// les champs registres d'une instruction simple valant a deviennent b
fonction ri_renommer(w, a, b) {
    soit s = ri_sorte(ri_op(w));
    soit d = s == 1 || s == 2 || s == 3 || s == 4 || s == 7 || s == 8;
    soit sr = s == 1 || s == 2 || s == 5 || s == 6 || s == 7 || s == 8;
    soit t = s == 1 || s == 6 || s == 8;
    si d && ri_d(w) == a { w = (w & ~(15 << 44)) | (b << 44); }
    si sr && ri_s(w) == a { w = (w & ~(15 << 40)) | (b << 40); }
    si t && ri_t(w) == a { w = (w & ~(15 << 36)) | (b << 36); }
    retour w;
}

// les champs registres lus d'une instruction simple valant a deviennent b (les champs écrits ne changent pas)
fonction ri_renommer_lus(w, a, b) {
    soit s = ri_sorte(ri_op(w));
    si (s == 4 || s == 7 || s == 8) && ri_d(w) == a { w = (w & ~(15 << 44)) | (b << 44); }
    si (s == 1 || s == 2 || s == 5 || s == 6 || s == 7 || s == 8) && ri_s(w) == a { w = (w & ~(15 << 40)) | (b << 40); }
    si (s == 1 || s == 6 || s == 8) && ri_t(w) == a { w = (w & ~(15 << 36)) | (b << 36); }
    retour w;
}

// une instruction dont le premier registre est seulement écrit (pour la règle copie) : comme RI_DEST de vtx64.py
fonction ri_dest(op) {
    soit s = ri_sorte(op);
    retour s == 1 || s == 2 || op == 10 || op == 24 || op == 25 || op == 37;
}

// les instructions d'une fonction : mot, mot suivant (LDI), place d'origine, étiquette avant, vivants après, cible
// pour l'analyse de vie, décodés une fois par analyse : lu (registres lus), ec (écrits), s1 et s2 (les instructions
// suivantes possibles, -1 : aucune)
structure Ep { w: Liste, x: Liste, p: Liste, e: Liste, v: Liste, av: Liste, t: Liste, r: Liste, n, lu: Liste, ec: Liste,
               s1: Liste, s2: Liste, sites: Liste }

fonction ep_ajouter(ep: Ep, w, x, p, e, v, t) {
    ajouter(ep.w, w);
    ajouter(ep.x, x);
    ajouter(ep.p, p);
    ajouter(ep.e, e);
    ajouter(ep.v, v);
    ajouter(ep.av, 0);
    ajouter(ep.t, t);
    ajouter(ep.r, 0);
    ajouter(ep.lu, 0);
    ajouter(ep.ec, 0);
    ajouter(ep.s1, 0);
    ajouter(ep.s2, 0);
    ep.n = ep.n + 1;
}

fonction ep_neuf(): Ep {
    retour Ep { w: liste(), x: liste(), p: liste(), e: liste(), v: liste(), av: liste(), t: liste(), r: liste(),
                lu: liste(), ec: liste(), s1: liste(), s2: liste(), sites: liste() };
}

// l'indice de la première instruction gardée placée à partir de pos (ep.n s'il n'y en a pas)
fonction ep_indice(ep: Ep, pos) {
    soit a = 0;
    soit b = ep.n;
    tantque a < b {
        soit m = (a + b) / 2;
        si elem(ep.p, m) < pos {
            a = m + 1;
        } sinon {
            b = m;
        }
    }
    retour a;
}

// l'analyse de vie : les registres de R1 à R8 vivants après chaque instruction. Chaque instruction est décodée une fois
// (ce qu'elle lit, ce qu'elle écrit, où elle peut aller), puis on remonte la fonction jusqu'à ce que rien ne change.
fonction ep_vie(c: Ctx, ep: Ep) {
    soit n = ep.n;
    soit mw = ep.w.mem;
    soit mlu = ep.lu.mem;
    soit mec = ep.ec.mem;
    soit ms1 = ep.s1.mem;
    soit ms2 = ep.s2.mem;
    soit mv = ep.v.mem;
    soit mav = ep.av.mem;
    pour k0 dans 0..n {
        soit w = @[mw + k0];
        soit s = ri_sorte(ri_op(w));
        soit lus = 0;
        soit ecr = 0;
        soit p1 = 0 - 1;
        soit p2 = 0 - 1;
        si k0 + 1 < n {
            p1 = k0 + 1;
        }
        si s == 9 {
            si ri_op(w) == 48 {
                p1 = 0 - 1;
            }
            soit pc = elem(ep.t, k0);
            si pc == 0 - 1 {
                lus = RI_TOUS;
            } sinon {
                soit ti = ep_indice(ep, pc);
                si ti < n {
                    p2 = ti;
                }
            }
        } sinon si s == 10 {
            ecr = RI_TOUS;
        } sinon si s == 11 {
            lus = 18;                       // R1 et R4
            p1 = 0 - 1;
        } sinon si s == 12 {
            p1 = 0 - 1;
        } sinon {
            lus = ri_lus(w);
            ecr = ri_ecr(w);
        }
        @[mlu + k0] = lus;
        @[mec + k0] = ecr;
        @[ms1 + k0] = p1;
        @[ms2 + k0] = p2;
        @[mv + k0] = 0;
        @[mav + k0] = 0;
    }
    soit change = 1;
    tantque change {
        change = 0;
        soit k = n;
        tantque k > 0 {
            k = k - 1;
            soit a = 0;
            soit q1 = @[ms1 + k];
            si q1 != 0 - 1 {
                a = @[mav + q1];
            }
            soit q2 = @[ms2 + k];
            si q2 != 0 - 1 {
                a = a | @[mav + q2];
            }
            soit v = @[mlu + k] | (a & ~@[mec + k]);
            si a != @[mv + k] || v != @[mav + k] {
                @[mv + k] = a;
                @[mav + k] = v;
                change = 1;
            }
        }
    }
}

// l'instruction après j s'il n'y a pas d'étiquette entre elles, sinon -1
fonction ep_suivant(ep: Ep, j) {
    soit k = j + 1;
    tantque k < ep.n && elem(ep.r, k) == 1 {
        si elem(ep.e, k) == 1 {
            retour 0 - 1;
        }
        k = k + 1;
    }
    si k < ep.n && elem(ep.e, k) == 0 {
        retour k;
    }
    retour 0 - 1;
}

fonction ep_mort(ep: Ep, j, r) {
    retour ((elem(ep.v, j) >> r) & 1) == 0;
}

fonction ep_op(ep: Ep, j) { retour ri_op(elem(ep.w, j)); }
fonction ep_d(ep: Ep, j) { retour ri_d(elem(ep.w, j)); }
fonction ep_s(ep: Ep, j) { retour ri_s(elem(ep.w, j)); }
fonction ep_t(ep: Ep, j) { retour ri_t(elem(ep.w, j)); }
fonction ep_imm(ep: Ep, j) { retour elem(ep.w, j) & 4294967295; }

fonction ep_retirer(ep: Ep, j) {
    poser(ep.r, j, 1);
}

// règle pile : PUSH R1 ; S ; MOV R2,R1 ; POP R1  ->  S (R1 devient Rf) ; MOV R2,Rf
fonction regle_pile(ep: Ep, i) {
    si ep_op(ep, i) != 39 || ep_s(ep, i) != 1 {
        retour 0;
    }
    soit j = ep_suivant(ep, i);
    soit ns = 0;
    tantque j != 0 - 1 && !(ep_op(ep, j) == 11 && ep_d(ep, j) == 2 && ep_s(ep, j) == 1) {
        soit op = ep_op(ep, j);
        soit s = ri_sorte(op);
        si s == 0 || s >= 9 || op == 39 || op == 40 {
            retour 0;
        }
        ns = ns + 1;
        j = ep_suivant(ep, j);
    }
    si j == 0 - 1 || ns == 0 {
        retour 0;
    }
    soit jp = ep_suivant(ep, j);
    si jp == 0 - 1 || ep_op(ep, jp) != 40 || ep_d(ep, jp) != 1 {
        retour 0;
    }
    soit vus = 0;
    pour k dans i + 1..j {
        si elem(ep.r, k) == 0 {
            vus = vus | ri_nommes(elem(ep.w, k));
        }
    }
    si (vus & (1 << 13)) != 0 || (vus & (1 << 14)) != 0 {
        retour 0;
    }
    // R1 doit être écrit dans S avant d'y être lu
    soit vu = 0;
    pour k dans i + 1..j {
        si vu == 0 && elem(ep.r, k) == 0 {
            soit w = elem(ep.w, k);
            si (ri_lus(w) & 2) != 0 {
                retour 0;
            }
            si (ri_ecr(w) & 2) != 0 {
                vu = 1;
            }
        }
    }
    si vu == 0 {
        retour 0;
    }
    soit f = 0;
    soit cand = 3;
    tantque f == 0 && cand <= 8 {
        si cand != 4 && (vus & (1 << cand)) == 0 && ep_mort(ep, jp, cand) {
            f = cand;
        }
        cand = cand + 1;
    }
    si f == 0 {
        retour 0;
    }
    pour k dans i + 1..j {
        si elem(ep.r, k) == 0 {
            poser(ep.w, k, ri_renommer(elem(ep.w, k), 1, f));
        }
    }
    poser(ep.w, j, ins(11, 2, f, 0, 0));
    // la vie des registres dans le passage réécrit, refaite en remontant depuis la fin
    soit vivants = elem(ep.v, jp);
    soit kk = j + 1;
    tantque kk > i + 1 {
        kk = kk - 1;
        si elem(ep.r, kk) == 0 {
            poser(ep.v, kk, vivants);
            soit wk = elem(ep.w, kk);
            vivants = (vivants & ~ri_ecr(wk)) | ri_lus(wk);
        }
    }
    ep_retirer(ep, i);
    ep_retirer(ep, jp);
    retour 1;
}

// règle constante : LDIS Rk,#c ; ADD Rd,Ra,Rk  ->  ADDI Rd,Ra,#c (de même SUB -> SUBI)
fonction regle_constante(ep: Ep, i) {
    soit j = ep_suivant(ep, i);
    si ep_op(ep, i) != 24 || j == 0 - 1 || (ep_op(ep, j) != 1 && ep_op(ep, j) != 2) {
        retour 0;
    }
    soit k = ep_d(ep, i);
    si k == 0 {
        retour 0;
    }
    soit cst = ep_imm(ep, i);
    soit d = ep_d(ep, j);
    soit a = ep_s(ep, j);
    soit b = ep_t(ep, j);
    soit src = 0 - 1;
    si b == k && a != k {
        src = a;
    } sinon si ep_op(ep, j) == 1 && a == k && b != k {
        src = b;
    }
    si src == 0 - 1 {
        retour 0;
    }
    si k != d && !ep_mort(ep, j, k) {
        retour 0;
    }
    soit nop = 6;
    si ep_op(ep, j) == 2 {
        nop = 7;
    }
    poser(ep.w, j, ins(nop, d, src, 0, cst));
    ep_retirer(ep, i);
    retour 1;
}

// règle relecture : STF Ra,#o ; LDF Rb,#o  ->  STF Ra,#o, puis MOV Rb,Ra si Rb n'est pas Ra
fonction regle_relecture(ep: Ep, i) {
    soit j = ep_suivant(ep, i);
    si ep_op(ep, i) != 38 || j == 0 - 1 || ep_op(ep, j) != 37 || ep_imm(ep, i) != ep_imm(ep, j) {
        retour 0;
    }
    soit a = ep_d(ep, i);
    soit b = ep_d(ep, j);
    si a == b {
        ep_retirer(ep, j);
    } sinon {
        poser(ep.w, j, ins(11, b, a, 0, 0));
    }
    retour 1;
}

// règle copie : OP Rx,… ; MOV Ry,Rx  ->  OP Ry,…
fonction regle_copie(ep: Ep, i) {
    soit j = ep_suivant(ep, i);
    si !ri_dest(ep_op(ep, i)) || j == 0 - 1 || ep_op(ep, j) != 11 {
        retour 0;
    }
    soit x = ep_d(ep, i);
    soit y = ep_d(ep, j);
    si ep_s(ep, j) != x || y == x || x < 1 || x > 8 || y == 0 || y == 13 || y == 14 || y == 15 || !ep_mort(ep, j, x) {
        retour 0;
    }
    poser(ep.w, i, (elem(ep.w, i) & ~(15 << 44)) | (y << 44));
    poser(ep.v, i, elem(ep.v, j));
    ep_retirer(ep, j);
    retour 1;
}

// règle échange (voir ECHANGE_PORTEE dans vtx64.py) : MOV Ra,Rb ; … lit Ra …  ->  … lit Rb … ; le MOV s'en va
constante ECHANGE_PORTEE = 8;

fonction regle_echange(ep: Ep, i) {
    si ep_op(ep, i) != 11 {
        retour 0;
    }
    soit a = ep_d(ep, i);
    soit b = ep_s(ep, i);
    si a < 1 || a > 8 || b == a || b == 0 || b == 13 || b == 14 || b == 15 {
        retour 0;
    }
    ep.sites.n = 0;
    soit j = ep_suivant(ep, i);
    soit fini = 0;
    tantque !fini {
        si j == 0 - 1 || ep.sites.n >= ECHANGE_PORTEE {
            retour 0;
        }
        soit w = elem(ep.w, j);
        soit op = ri_op(w);
        soit s = ri_sorte(op);
        si s == 0 || s >= 9 || op == 39 {
            retour 0;
        }
        ajouter(ep.sites, j);
        soit ecrit = 0 - 1;
        si s == 1 || s == 2 || s == 3 {
            ecrit = ri_d(w);
        }
        si ecrit == a || ep_mort(ep, j, a) {
            fini = 1;                     // l'ancienne valeur de Ra ne sert plus après j
        } sinon si ecrit == b {
            retour 0;                     // Rb change alors que Ra sert encore
        } sinon {
            j = ep_suivant(ep, j);
        }
    }
    pour q dans 0..ep.sites.n {
        soit k = elem(ep.sites, q);
        poser(ep.w, k, ri_renommer_lus(elem(ep.w, k), a, b));
    }
    // la vie des registres sur le site, refaite en remontant depuis sa fin
    soit vivants = elem(ep.v, elem(ep.sites, ep.sites.n - 1));
    soit q2 = ep.sites.n;
    tantque q2 > 0 {
        q2 = q2 - 1;
        soit k2 = elem(ep.sites, q2);
        poser(ep.v, k2, vivants);
        soit wk = elem(ep.w, k2);
        vivants = (vivants & ~ri_ecr(wk)) | ri_lus(wk);
    }
    ep_retirer(ep, i);
    retour 1;
}

// les instructions retirées s'en vont ; une étiquette posée devant passe à l'instruction suivante
fonction ep_tasser(ep: Ep) {
    soit m = 0;
    soit report = 0;
    pour k dans 0..ep.n {
        si elem(ep.r, k) == 1 {
            si elem(ep.e, k) == 1 {
                report = 1;
            }
        } sinon {
            poser(ep.w, m, elem(ep.w, k));
            poser(ep.x, m, elem(ep.x, k));
            poser(ep.p, m, elem(ep.p, k));
            poser(ep.r, m, 0);
            poser(ep.e, m, elem(ep.e, k) | report);
            poser(ep.v, m, elem(ep.v, k));
            poser(ep.t, m, elem(ep.t, k));
            report = 0;
            m = m + 1;
        }
    }
    ep.n = m;
    ep.w.n = m;
    ep.x.n = m;
    ep.p.n = m;
    ep.e.n = m;
    ep.v.n = m;
    ep.av.n = m;
    ep.t.n = m;
    ep.r.n = m;
    ep.lu.n = m;
    ep.ec.n = m;
    ep.s1.n = m;
    ep.s2.n = m;
}

// l'épissage d'une fonction dont le code commence à debut ; fdeb : ses premiers renvois de sauts ; edeb : ses premières
// étiquettes
fonction episser(c: Ctx, debut, fdeb, edeb) {
    soit fin = c.code.n;
    soit ep = ep_neuf();
    // les étiquettes visées par un saut de la fonction séparent les instructions ; les autres sont transparentes
    soit marque = liste();
    pour q dans debut..fin {
        ajouter(marque, 0);
    }
    pour h dans fdeb..c.fix_pos.n {
        soit pos = elem(c.fix_pos, h);
        si elem(c.fix_genre, h) == 0 && ri_sorte(ri_op(elem(c.code, pos))) == 9 {
            soit cible = elem(c.etiq, elem(c.fix_etiq, h));
            si cible != 0 - 1 && cible >= debut && cible < fin {
                poser(marque, cible - debut, 1);
            }
        }
    }
    soit h2 = fdeb;
    soit pos2 = debut;
    tantque pos2 < fin {
        soit w = elem(c.code, pos2);
        soit x = 0;
        soit lg = 1;
        si ri_op(w) == 10 {
            x = elem(c.code, pos2 + 1);
            lg = 2;
        }
        // la cible d'un saut : la place de son étiquette dans la fonction, sinon -1 (inconnue)
        soit t = 0 - 1;
        tantque h2 < c.fix_pos.n && elem(c.fix_pos, h2) < pos2 {
            h2 = h2 + 1;
        }
        si h2 < c.fix_pos.n && elem(c.fix_pos, h2) == pos2 && ri_sorte(ri_op(w)) == 9 {
            soit cb = elem(c.etiq, elem(c.fix_etiq, h2));
            si cb != 0 - 1 && cb >= debut && cb <= fin {
                t = cb;
            }
        }
        ep_ajouter(ep, w, x, pos2, elem(marque, pos2 - debut), 0, t);
        pos2 = pos2 + lg;
    }
    soit change = 1;
    tantque change {
        change = 0;
        ep_vie(c, ep);
        soit i = 0;
        tantque i < ep.n {
            si elem(ep.r, i) == 0 && (regle_pile(ep, i) || regle_constante(ep, i) || regle_relecture(ep, i)
                                      || regle_copie(ep, i) || regle_echange(ep, i)) {
                change = 1;
            } sinon {
                i = i + 1;
            }
        }
        ep_tasser(ep);
    }
    // le code réécrit, puis les étiquettes et les renvois déplacés
    soit np = liste();
    c.code.n = debut;
    pour k dans 0..ep.n {
        ajouter(np, c.code.n);
        emettre(c, elem(ep.w, k));
        si ri_op(elem(ep.w, k)) == 10 {
            emettre(c, elem(ep.x, k));
        }
    }
    pour id dans edeb..c.etiq.n {
        soit pe = elem(c.etiq, id);
        si pe != 0 - 1 && pe >= debut {
            soit ke = ep_indice(ep, pe);
            si ke < ep.n {
                poser(c.etiq, id, elem(np, ke));
            } sinon {
                poser(c.etiq, id, c.code.n);
            }
        }
    }
    pour h3 dans fdeb..c.fix_pos.n {
        soit pf = elem(c.fix_pos, h3);
        soit kf = ep_indice(ep, pf);
        si kf < ep.n && elem(ep.p, kf) == pf {
            poser(c.fix_pos, h3, elem(np, kf));
        } sinon {
            poser(c.fix_pos, h3, elem(np, kf - 1) + 1);
        }
    }
}

// --------------------------------------------------------------------------------------------- variables en registres
// Les variables les plus utilisées dans les boucles (usages pondérés : x8 par niveau de boucle) vivent dans R9 à R12 ;
// la fonction garde ces registres dans des cases cachées de son cadre et les remet à la sortie (même règle que vtx64.py).
fonction commence(t, p) {
    si longueur(t) < longueur(p) {
        retour 0;
    }
    pour i dans 0..longueur(p) {
        si car(t, i) != car(p, i) {
            retour 0;
        }
    }
    retour 1;
}

fonction poids_boucle(d) {
    si d > 3 {
        d = 3;
    }
    retour 1 << (3 * d);
}

fonction compter_nom(c: Ctx, nom, w) {
    soit v = var_ou_nul(c, nom);
    si v != nul {
        v.score = v.score + w;
    }
}

fonction compter(c: Ctx, x: Noeud, d) {
    tantque x != nul {
        soit g = x.genre;
        si g == N_VAR {
            compter_nom(c, x.nom, poids_boucle(d));
        } sinon si g == N_SOIT || g == N_AFFECTER {
            compter_nom(c, x.nom, poids_boucle(d));
            compter(c, x.a, d);
        } sinon si g == N_RLIRE {
            // vtx.py écrit l'indice deux fois (le mot, puis la place dans le mot) : compté deux fois
            compter(c, x.a, d);
            compter(c, x.a, d);
        } sinon si g == N_TANTQUE {
            compter(c, x.a, d + 1);
            compter(c, x.premier, d + 1);
        } sinon si g == N_POUR {
            compter_nom(c, x.nom, poids_boucle(d) + 3 * poids_boucle(d + 1));
            compter(c, x.a, d);
            compter(c, x.b, d + 1);
            compter(c, x.premier, d + 1);
        } sinon {
            compter(c, x.a, d);
            compter(c, x.b, d);
            compter(c, x.c, d);
            compter(c, x.premier, d);
            compter(c, x.deuxieme, d);
        }
        x = x.suivant;
    }
}

// accords, segments, hypothèses : les variables restent dans le cadre
fonction sans_registres(x: Noeud) {
    tantque x != nul {
        si x.genre == N_ACCORD || (x.genre == N_POUR && x.c != nul && x.c.genre == N_INFO) {
            retour 1;
        }
        si x.genre == N_APPEL && x.nom != 0 && commence(x.nom, "__hyp") {
            retour 1;
        }
        si sans_registres(x.a) || sans_registres(x.b) || sans_registres(x.c) || sans_registres(x.premier)
                || sans_registres(x.deuxieme) {
            retour 1;
        }
        x = x.suivant;
    }
    retour 0;
}

// le ramasse-miettes lit la pile : il y range les quatre registres, où ses appelants gardent peut-être des adresses
fonction appelle_pile(x: Noeud) {
    tantque x != nul {
        si x.genre == N_APPEL && x.nom != 0 && egal(x.nom, "pile") {
            retour 1;
        }
        si appelle_pile(x.a) || appelle_pile(x.b) || appelle_pile(x.c) || appelle_pile(x.premier)
                || appelle_pile(x.deuxieme) {
            retour 1;
        }
        x = x.suivant;
    }
    retour 0;
}

fonction choisir_registres(c: Ctx, f: Fonction) {
    si !c.optim || c.lignes_dbg == 1 || sans_registres(f.corps) {
        retour 0;
    }
    compter(c, f.corps, 0);
    soit n = 0;
    tantque n < 4 {
        soit m: Var = nul;
        soit v = c.vars;
        tantque v != nul {
            si v.reg == 0 && v.score >= 16 && !large(v.type) && !commence(v.nom, "__q") {
                // à égalité, la plus haute dans le cadre (les décalages sont signés)
                si m == nul || v.score > m.score || (v.score == m.score && v.off .> m.off) {
                    m = v;
                }
            }
            v = v.suivant;
        }
        si m == nul {
            retour n;
        }
        m.reg = 9 + n;
        n = n + 1;
    }
    retour n;
}

fonction fonction_code(c: Ctx, f: Fonction) {
    soit debut = c.code.n;
    soit fdeb = c.fix_pos.n;
    soit edeb = c.etiq.n;
    c.fcour = f;
    c.vars = nul;
    table_jeter(K_VARS);
    c.boucles = nul;
    soit o = placer(c, f.params, f.ligne);
    soit nl = locales(c, f.corps, 0);
    soit ng = choisir_registres(c, f);
    si c.optim && c.lignes_dbg != 1 && appelle_pile(f.corps) {
        ng = 4;
    }
    si o > 1048576 || nl + ng > 1048576 {
        erreur(c, f.ligne, "trop de paramètres ou de variables");
    }
    poser_etiquette(c, f.etiq);
    pousser(c, 13);
    mov(c, 13, 14);
    si nl + ng != 0 {
        rri(c, 7, 14, 14, nl + ng);
    }
    // les registres gardés dans des cases cachées, puis les paramètres en registres chargés
    pour k dans 0..ng {
        stf(c, 9 + k, 0 - (nl + 1 + k));
    }
    pour r dans 9..13 {
        soit v = c.vars;
        tantque v != nul {
            si v.reg == r && v.off .> 0 {
                ldf(c, r, v.off);
            }
            v = v.suivant;
        }
    }
    c.ffin = nouvelle_etiquette(c);
    // un « retour » en dernière instruction du corps arrive à la fin sans saut, et la fin n'a pas à rendre 0
    soit dernier = f.corps;
    tantque dernier != nul && dernier.suivant != nul {
        dernier = dernier.suivant;
    }
    soit final = c.optim && dernier != nul && dernier.genre == N_RETOUR;
    soit sx = f.corps;
    tantque sx != nul && c.erreur == 0 {
        c.retour_final = final && sx.suivant == nul;
        instr(c, sx);
        sx = sx.suivant;
    }
    c.retour_final = 0;
    si !final {
        ldis(c, 1, 0);
        si large(f.rtype) {
            ldis(c, 4, 0);
        }
    }
    poser_etiquette(c, c.ffin);
    pour k2 dans 0..ng {
        ldf(c, 9 + k2, 0 - (nl + 1 + k2));
    }
    mov(c, 14, 13);
    depiler(c, 13);
    emettre(c, ins(52, 0, 0, 0, 0));
    // l'épissage : pas au pas à pas, ni dans __init, ni avec des accords, des segments ou une hypothèse
    si c.optim && c.lignes_dbg != 1 && !egal(f.nom, "__init") && !sans_registres(f.corps) {
        episser(c, debut, fdeb, edeb);
    }
}

// --------------------------------------------------------------------------------------------- partition des tâches
// Une suite d'au moins deux appels de fonctions écrits comme instructions forme un accord : le compilateur calcule ce
// que chaque appel lit et écrit (zones de mémoire, entrées et sorties), range dans une même mesure les tâches sans
// conflit, et l'ordre d'exécution devient celui de la partition. Une boucle en segments devient un accord de segments.
// Les zones sont des triplets (étage, début, fin) ; étage 4 : inconnu (tous), 5 : entrées et sorties.

fonction zone_ajouter(l: Liste, e, lo, hi) {
    pour i dans 0..l.n / 3 {
        si elem(l, 3 * i) == e && elem(l, 3 * i + 1) == lo && elem(l, 3 * i + 2) == hi {
            retour 0;
        }
    }
    ajouter(l, e);
    ajouter(l, lo);
    ajouter(l, hi);
    retour 1;
}

fonction tout(l: Liste) {
    zone_ajouter(l, ZONE_TOUT, 0, 16777216);
}

fonction es(l: Liste) {
    zone_ajouter(l, ZONE_ES, 0, 1);
}

fonction zones_conflit(ea, la, ha, eb, lb, hb) {
    si ea == ZONE_ES || eb == ZONE_ES {
        retour ea == eb;
    }
    si ea != ZONE_TOUT && eb != ZONE_TOUT && ea != eb {
        retour 0;
    }
    retour la < hb && lb < ha;
}

fonction ensembles_conflit(a: Liste, b: Liste) {
    pour i dans 0..a.n / 3 {
        pour j dans 0..b.n / 3 {
            si zones_conflit(elem(a, 3 * i), elem(a, 3 * i + 1), elem(a, 3 * i + 2), elem(b, 3 * j), elem(b, 3 * j + 1),
                             elem(b, 3 * j + 2)) {
                retour 1;
            }
        }
    }
    retour 0;
}

fonction union_zones(a: Liste, b: Liste) {
    soit change = 0;
    pour i dans 0..b.n / 3 {
        si zone_ajouter(a, elem(b, 3 * i), elem(b, 3 * i + 1), elem(b, 3 * i + 2)) {
            change = 1;
        }
    }
    retour change;
}

fonction zone_table(c: Ctx, l: Liste, nom) {
    soit t = tableau_de(c, nom);
    zone_ajouter(l, t.etage, t.base, t.base + mots_tableau(c, t));
}

// Ce qu'un accès mémoire lit ou écrit : la zone du tableau, une case, un étage entier, ou tout
fonction zone_acces(n: Noeud, l: Liste) {
    si n.zet != 0 {
        zone_ajouter(l, n.zet - 1, n.zlo, n.zhi);
    } sinon si n.a == nul && n.val != 4 {
        si n.b.genre == N_NOMBRE {
            zone_ajouter(l, n.val, n.b.val, n.b.val + 1);
        } sinon {
            zone_ajouter(l, n.val, 0, 16777216);
        }
    } sinon {
        tout(l);
    }
}

fonction effets_appel(c: Ctx, nom, r: Liste, w: Liste) {
    si egal(nom, "sortie") || egal(nom, "entrée") || egal(nom, "bruit") || egal(nom, "pile") {
        es(r);
        es(w);
        retour;
    }
    si egal(nom, "__service") {
        es(r);
        tout(r);
        es(w);
        tout(w);
        retour;
    }
    si egal(nom, "gemv") {
        zone_ajouter(r, 2, 0, 16777216);
        zone_ajouter(w, 2, 0, 16777216);
        retour;
    }
    si egal(nom, "lire_car") || egal(nom, "ecrire_car") || egal(nom, "ouvrir_lecture")
        || egal(nom, "ouvrir_ecriture") || egal(nom, "fermer") || egal(nom, "fin_de") {
        es(r);
        tout(r);
        es(w);
        retour;
    }
    si est_integre(nom) {
        retour;
    }
    soit f = fonction_de(c, nom);
    si f != nul && f.garde {
        union_zones(r, f.er);
        union_zones(w, f.ew);
        retour;
    }
    tout(r);
    tout(w);
}

fonction parcourir_liste(c: Ctx, x: Noeud, r: Liste, w: Liste) {
    tantque x != nul {
        parcourir(c, x, r, w);
        x = x.suivant;
    }
}

fonction parcourir(c: Ctx, n: Noeud, r: Liste, w: Liste) {
    si n == nul {
        retour;
    }
    soit g = n.genre;
    si g == N_LIRE {
        zone_acces(n, r);
    } sinon si g == N_RLIRE {
        zone_table(c, r, n.nom);
    } sinon si g == N_ECRIRE {
        zone_acces(n, w);
    } sinon si g == N_RECRIRE {
        zone_table(c, w, n.nom);
        zone_table(c, r, n.nom);
    } sinon si g == N_DONNEES {
        tout(r);
        tout(w);
    } sinon si g == N_CHAMP && !(egal(n.nom, "r") || egal(n.nom, "v") || egal(n.nom, "b") || egal(n.nom, "a")) {
        tout(r);
    } sinon si g == N_ECRIRE_CHAMP {
        tout(w);
    } sinon si g == N_CONSTRUIRE || g == N_NOUVEAU {
        tout(r);
        tout(w);
    } sinon si g == N_POUR && n.c != nul && n.c.genre == N_INFO && n.c.premier != nul {
        zone_ajouter(r, 3, COPIES_DEBUT, COPIES_FIN);
        zone_ajouter(w, 3, COPIES_DEBUT, COPIES_FIN);
    } sinon si g == N_APPEL {
        effets_appel(c, n.nom, r, w);
    }
    si g != N_INFO {
        parcourir(c, n.a, r, w);
        parcourir(c, n.b, r, w);
        parcourir(c, n.c, r, w);
        parcourir_liste(c, n.premier, r, w);
        parcourir_liste(c, n.deuxieme, r, w);
    }
}

// Lectures et écritures de chaque fonction gardée, appels compris (point fixe)
fonction calculer_effets(c: Ctx) {
    soit f = c.fonctions;
    tantque f != nul {
        f.er = liste();
        f.ew = liste();
        f = f.suivant;
    }
    soit change = 1;
    tantque change {
        change = 0;
        f = c.fonctions;
        tantque f != nul {
            si f.garde {
                soit r = liste();
                soit w = liste();
                parcourir_liste(c, f.corps, r, w);
                si union_zones(f.er, r) {
                    change = 1;
                }
                si union_zones(f.ew, w) {
                    change = 1;
                }
            }
            f = f.suivant;
        }
    }
}

fonction est_tache(c: Ctx, s: Noeud) {
    si s.genre != N_EXPR || s.a.genre != N_APPEL {
        retour 0;
    }
    soit f = fonction_de(c, s.a.nom);
    retour f != nul && f.garde && !(car(s.a.nom, 0) == '_' && car(s.a.nom, 1) == '_');
}

// Si l'adresse est base + var + k (ou var + k), rend 1 et range k dans c.lex_val
fonction decalage_var(e: Noeud, var, c: Ctx) {
    si meme_var(e, var) {
        c.lex_val = 0;
        retour 1;
    }
    si e.genre == N_BIN && (egal(e.op, "+") || egal(e.op, "-")) && meme_var(e.a, var) && e.b.genre == N_NOMBRE {
        c.lex_val = e.b.val;
        si egal(e.op, "-") {
            c.lex_val = 0 - e.b.val;
        }
        retour 1;
    }
    retour 0;
}

fonction indice_de(c: Ctx, adr: Noeud, var) {
    si decalage_var(adr, var, c) {
        retour 1;
    }
    si adr.genre == N_BIN && egal(adr.op, "+") && adr.a.genre == N_NOMBRE {
        retour decalage_var(adr.b, var, c);
    }
    retour 0;
}

// Le noeud est-il un accès à un tableau cumulé (zone privée de chaque segment) ?
fonction zone_privee(n: Noeud, privees: Liste) {
    si n.zet == 0 {
        retour 0;
    }
    pour i dans 0..privees.n / 3 {
        si elem(privees, 3 * i) == n.zet - 1 && elem(privees, 3 * i + 1) == n.zlo && elem(privees, 3 * i + 2) == n.zhi {
            retour 1;
        }
    }
    retour 0;
}

fonction marche_liste(c: Ctx, x: Noeud, var, privees: Liste, r: Liste, w: Liste, wi: Liste) {
    tantque x != nul {
        marche(c, x, var, privees, r, w, wi);
        x = x.suivant;
    }
}

// wi : (étage, début, fin, décalage) des écritures tableau[var + décalage]
fonction marche(c: Ctx, n: Noeud, var, privees: Liste, r: Liste, w: Liste, wi: Liste) {
    si n == nul {
        retour;
    }
    soit g = n.genre;
    si (g == N_LIRE || g == N_ECRIRE) && zone_privee(n, privees) {
        marche(c, n.b, var, privees, r, w, wi);
        marche(c, n.c, var, privees, r, w, wi);
        retour;
    }
    si g == N_ECRIRE && n.zet != 0 && n.a == nul && indice_de(c, n.b, var) {
        soit k = c.lex_val;
        soit trouve = 0;
        pour i dans 0..wi.n / 4 {
            si elem(wi, 4 * i) == n.zet - 1 && elem(wi, 4 * i + 1) == n.zlo && elem(wi, 4 * i + 2) == n.zhi
                && elem(wi, 4 * i + 3) == k {
                trouve = 1;
            }
        }
        si !trouve {
            ajouter(wi, n.zet - 1);
            ajouter(wi, n.zlo);
            ajouter(wi, n.zhi);
            ajouter(wi, k);
        }
        marche(c, n.b, var, privees, r, w, wi);
        marche(c, n.c, var, privees, r, w, wi);
        retour;
    }
    si g == N_RECRIRE {
        marche(c, n.a, var, privees, r, w, wi);
        marche(c, n.c, var, privees, r, w, wi);
        zone_table(c, w, n.nom);
        zone_table(c, r, n.nom);
        retour;
    }
    si g == N_LIRE || g == N_ECRIRE || g == N_RLIRE || g == N_DONNEES || g == N_APPEL || g == N_ECRIRE_CHAMP
        || g == N_NOUVEAU || g == N_CONSTRUIRE
        || (g == N_CHAMP && !(egal(n.nom, "r") || egal(n.nom, "v") || egal(n.nom, "b") || egal(n.nom, "a"))) {
        parcourir(c, n, r, w);
        retour;
    }
    si g == N_POUR && n.c != nul && n.c.genre == N_INFO && n.c.premier != nul {
        zone_ajouter(r, 3, COPIES_DEBUT, COPIES_FIN);
        zone_ajouter(w, 3, COPIES_DEBUT, COPIES_FIN);
    }
    si g != N_INFO {
        marche(c, n.a, var, privees, r, w, wi);
        marche(c, n.b, var, privees, r, w, wi);
        marche(c, n.c, var, privees, r, w, wi);
        marche_liste(c, n.premier, var, privees, r, w, wi);
        marche_liste(c, n.deuxieme, var, privees, r, w, wi);
    }
}

// Deux segments d'une même boucle sont-ils indépendants ? Les écritures tableau[i + k] d'un segment ne touchent que
// ses propres indices ; les tableaux cumulés ont une copie par segment ; tout le reste est pris en entier.
fonction segments_independants(c: Ctx, st: Noeud, privees: Liste) {
    soit r = liste();
    soit w = liste();
    soit wi = liste();
    marche_liste(c, st.premier, st.nom, privees, r, w, wi);
    soit zi = liste();
    pour i dans 0..wi.n / 4 {
        zone_ajouter(zi, elem(wi, 4 * i), elem(wi, 4 * i + 1), elem(wi, 4 * i + 2));
    }
    pour k dans 0..privees.n / 3 {
        soit z = liste();
        zone_ajouter(z, elem(privees, 3 * k), elem(privees, 3 * k + 1), elem(privees, 3 * k + 2));
        si ensembles_conflit(z, r) || ensembles_conflit(z, w) || ensembles_conflit(z, zi) {
            erreur(c, st.ligne, "un tableau cumulé est aussi atteint autrement que par son nom dans la boucle (fonction appelée ou adresse calculée) : la somme des segments ne serait pas sûre");
        }
    }
    si ensembles_conflit(w, w) || ensembles_conflit(w, r) || ensembles_conflit(w, zi) || ensembles_conflit(zi, r) {
        retour 0;
    }
    // une seule case par zone (décalage unique), et des zones qui ne se recouvrent pas
    pour i dans 0..wi.n / 4 {
        pour j dans 0..wi.n / 4 {
            soit meme_zone = elem(wi, 4 * i) == elem(wi, 4 * j) && elem(wi, 4 * i + 1) == elem(wi, 4 * j + 1)
                && elem(wi, 4 * i + 2) == elem(wi, 4 * j + 2);
            si meme_zone && elem(wi, 4 * i + 3) != elem(wi, 4 * j + 3) {
                retour 0;
            }
            si !meme_zone && zones_conflit(elem(wi, 4 * i), elem(wi, 4 * i + 1), elem(wi, 4 * i + 2), elem(wi, 4 * j),
                                          elem(wi, 4 * j + 1), elem(wi, 4 * j + 2)) {
                retour 0;
            }
        }
    }
    retour 1;
}

// Les accès aux tableaux cumulés redirigés vers la copie du segment : copies = (début, fin, copie) par tableau
fonction remplacer_cumul(c: Ctx, n: Noeud, copies: Liste): Noeud {
    si n == nul {
        retour nul;
    }
    soit m = Noeud { genre: n.genre, op: n.op, val: n.val, nom: n.nom, a: remplacer_cumul(c, n.a, copies),
                     b: remplacer_cumul(c, n.b, copies), c: remplacer_cumul(c, n.c, copies),
                     premier: remplacer_liste(c, n.premier, copies), deuxieme: remplacer_liste(c, n.deuxieme, copies),
                     ligne: n.ligne, zet: n.zet, zlo: n.zlo, zhi: n.zhi, copie: n.copie, expl: n.expl };
    si (n.genre == N_LIRE || n.genre == N_ECRIRE) && n.zet != 0 {
        pour i dans 0..copies.n / 4 {
            si elem(copies, 4 * i) == n.zet - 1 && elem(copies, 4 * i + 1) == n.zlo {
                soit cb = elem(copies, 4 * i + 3);
                soit nm = n.zhi - n.zlo;
                m.b = bin("+", nombre(cb - n.zlo, n.ligne), m.b, n.ligne);
                m.val = 3;
                m.zet = 4;
                m.zlo = cb;
                m.zhi = cb + nm;
                m.nom = 0;
            }
        }
    }
    retour m;
}

fonction remplacer_liste(c: Ctx, x: Noeud, copies: Liste): Noeud {
    soit premier: Noeud = nul;
    soit dernier: Noeud = nul;
    tantque x != nul {
        soit y = remplacer_cumul(c, x, copies);
        si dernier == nul {
            premier = y;
        } sinon {
            dernier.suivant = y;
        }
        dernier = y;
        x = x.suivant;
    }
    retour premier;
}

// Borne k sur n d'une boucle en segments : a + (b - a) × k / n
fonction borne(sa, sb, k, n, l): Noeud {
    si k == 0 {
        retour var_n(sa, l);
    }
    si k == n {
        retour var_n(sb, l);
    }
    retour bin("+", var_n(sa, l), bin("/", bin("*", bin("-", var_n(sb, l), var_n(sa, l), l), nombre(k, l), l), nombre(n, l), l), l);
}

fonction chainer(premier: Noeud, x: Noeud): Noeud {
    si premier == nul {
        retour x;
    }
    soit d = premier;
    tantque d.suivant != nul {
        d = d.suivant;
    }
    d.suivant = x;
    retour premier;
}

// Une boucle en segments -> un accord de segments (et, s'il y a des tableaux cumulés, la somme des copies ensuite)
fonction accord_segments(c: Ctx, st: Noeud): Noeud {
    soit info = st.c;
    soit n = info.val;
    soit sid = info.ligne;
    soit l = st.ligne;
    soit sa = nom_cache("__sa", sid);
    soit sb = nom_cache("__sb", sid);
    // zones des tableaux cumulés : étage, début, fin
    soit privees = liste();
    soit cu = info.premier;
    tantque cu != nul {
        zone_table(c, privees, cu.nom);
        cu = cu.suivant;
    }
    soit libres = segments_independants(c, st, privees);
    soit morceaux: Noeud = nul;
    soit reduction: Noeud = nul;
    si privees.n == 0 {
        pour k dans 0..n {
            soit m = Noeud { genre: N_POUR, nom: st.nom, a: borne(sa, sb, k, n, l), b: borne(sa, sb, k + 1, n, l),
                             premier: st.premier, val: 1, op: "segments", copie: k > 0, ligne: l };
            morceaux = chainer(morceaux, m);
        }
    } sinon {
        // une copie de chaque tableau cumulé par segment, dans @3[14680064…]
        soit bases = liste();            // par segment et par tableau : étage, début, fin, copie
        pour k2 dans 0..n {
            pour i dans 0..privees.n / 3 {
                ajouter(bases, elem(privees, 3 * i));
                ajouter(bases, elem(privees, 3 * i + 1));
                ajouter(bases, elem(privees, 3 * i + 2));
                ajouter(bases, c.copie_libre);
                c.copie_libre = c.copie_libre + elem(privees, 3 * i + 2) - elem(privees, 3 * i + 1);
            }
        }
        si c.copie_libre > COPIES_FIN {
            erreur(c, l, "plus de place pour les copies des tableaux cumulés");
        }
        soit nt = privees.n / 3;
        soit jk = nom_cache("__cz", sid);
        pour k3 dans 0..n {
            soit copies = liste();
            soit bloc_k: Noeud = nul;
            pour i2 dans 0..nt {
                soit o = 4 * (k3 * nt + i2);
                pour q dans 0..4 {
                    ajouter(copies, elem(bases, o + q));
                }
                soit cb = elem(bases, o + 3);
                soit nm = elem(bases, o + 2) - elem(bases, o + 1);
                soit zero = Noeud { genre: N_ECRIRE, val: 3, b: bin("+", nombre(cb, l), var_n(jk, l), l), c: nombre(0, l),
                                    ligne: l, zet: 4, zlo: cb, zhi: cb + nm };
                soit mz = Noeud { genre: N_POUR, nom: jk, a: nombre(0, l), b: nombre(nm, l), premier: zero, val: 1,
                                  op: "copie", copie: k3 > 0, ligne: l };
                bloc_k = chainer(bloc_k, mz);
            }
            soit boucle = Noeud { genre: N_POUR, nom: st.nom, a: borne(sa, sb, k3, n, l), b: borne(sa, sb, k3 + 1, n, l),
                                  premier: remplacer_liste(c, st.premier, copies), val: 1, op: "copie", copie: k3 > 0, ligne: l };
            bloc_k = chainer(bloc_k, boucle);
            morceaux = chainer(morceaux, Noeud { genre: N_BLOC, premier: bloc_k, ligne: l });
        }
        // la somme : tableau = tableau + toutes les copies
        soit jr = nom_cache("__cr", sid);
        pour i3 dans 0..nt {
            soit etg = elem(privees, 3 * i3);
            soit base = elem(privees, 3 * i3 + 1);
            soit fin = elem(privees, 3 * i3 + 2);
            soit somme = Noeud { genre: N_LIRE, val: etg, b: bin("+", nombre(base, l), var_n(jr, l), l), ligne: l,
                                 zet: etg + 1, zlo: base, zhi: fin };
            pour k4 dans 0..n {
                soit cb2 = elem(bases, 4 * (k4 * nt + i3) + 3);
                somme = bin("+", somme, Noeud { genre: N_LIRE, val: 3, b: bin("+", nombre(cb2, l), var_n(jr, l), l), ligne: l,
                                                zet: 4, zlo: cb2, zhi: cb2 + fin - base }, l);
            }
            soit ec = Noeud { genre: N_ECRIRE, val: etg, b: bin("+", nombre(base, l), var_n(jr, l), l), c: somme, ligne: l,
                              zet: etg + 1, zlo: base, zhi: fin };
            reduction = chainer(reduction, Noeud { genre: N_POUR, nom: jr, a: nombre(0, l), b: nombre(fin - base, l),
                                                   premier: ec, val: 1, op: "copie", copie: i3 > 0, ligne: l });
        }
    }
    // les mesures : toutes les tâches ensemble si les segments sont indépendants, sinon une par mesure
    soit mesures: Noeud = nul;
    si libres {
        mesures = Noeud { genre: N_MESURE, premier: morceaux, ligne: l };
    } sinon {
        soit m2 = morceaux;
        tantque m2 != nul {
            soit suivant = m2.suivant;
            m2.suivant = nul;
            mesures = chainer(mesures, Noeud { genre: N_MESURE, premier: m2, ligne: l });
            m2 = suivant;
        }
    }
    soit acc = Noeud { genre: N_ACCORD, val: c.naccords, premier: mesures, ligne: l };
    c.naccords = c.naccords + 1;
    acc.suivant = reduction;
    retour acc;
}

fonction partition_liste(c: Ctx, s: Noeud): Noeud {
    soit tete: Noeud = nul;
    soit dernier: Noeud = nul;
    tantque s != nul {
        soit r: Noeud = s;
        soit suivant = s.suivant;
        si est_tache(c, s) && suivant != nul && est_tache(c, suivant) {
            // une suite de tâches : niveau de chacune = 1 + le plus haut niveau des tâches précédentes en conflit
            soit taches = liste();
            soit x = s;
            soit tl: Noeud = nul;
            soit nb = 0;
            tantque x != nul && est_tache(c, x) {
                nb = nb + 1;
                x = x.suivant;
            }
            suivant = x;
            soit rs = liste();          // effets de chaque tâche : listes de zones, rangées par position
            soit ws = liste();
            soit lt = liste();          // les tâches (adresses des noeuds) : on les retrouve en parcourant
            soit niveau = liste();
            soit maxn = 1;
            soit t = s;
            pour k dans 0..nb {
                soit r1 = liste();
                soit w1 = liste();
                parcourir(c, t, r1, w1);
                soit nv = 1;
                soit u = s;
                pour m dans 0..k {
                    soit rm = liste();
                    soit wm = liste();
                    parcourir(c, u, rm, wm);
                    si ensembles_conflit(w1, wm) || ensembles_conflit(w1, rm) || ensembles_conflit(r1, wm) {
                        si elem(niveau, m) + 1 > nv {
                            nv = elem(niveau, m) + 1;
                        }
                    }
                    u = u.suivant;
                }
                ajouter(niveau, nv);
                si nv > maxn {
                    maxn = nv;
                }
                t = t.suivant;
            }
            // l'ordre d'origine est gardé dans deuxieme (inutilisé par une instruction-expression) pendant le rangement
            soit to = s;
            pour k1 dans 0..nb {
                to.deuxieme = to.suivant;
                to = to.suivant;
            }
            soit mesures: Noeud = nul;
            pour nv2 dans 1..maxn + 1 {
                soit chaine: Noeud = nul;
                soit dch: Noeud = nul;
                soit t2 = s;
                pour k2 dans 0..nb {
                    soit t3 = t2.deuxieme;
                    si elem(niveau, k2) == nv2 {
                        t2.suivant = nul;
                        si dch == nul {
                            chaine = t2;
                        } sinon {
                            dch.suivant = t2;
                        }
                        dch = t2;
                    }
                    t2 = t3;
                }
                mesures = chainer(mesures, Noeud { genre: N_MESURE, premier: chaine, ligne: s.ligne });
            }
            soit tz = s;
            pour k5 dans 0..nb {
                soit tn = tz.deuxieme;
                tz.deuxieme = nul;
                tz = tn;
            }
            r = Noeud { genre: N_ACCORD, val: c.naccords, premier: mesures, ligne: s.ligne };
            c.naccords = c.naccords + 1;
        } sinon si s.genre == N_POUR && s.c != nul && s.c.genre == N_INFO {
            s.premier = partition_liste(c, s.premier);
            r = accord_segments(c, s);
        } sinon {
            s.suivant = nul;
            si s.genre == N_SI || s.genre == N_TANTQUE || s.genre == N_POUR {
                s.premier = partition_liste(c, s.premier);
                si s.genre == N_SI && s.val == 1 {
                    s.deuxieme = partition_liste(c, s.deuxieme);
                }
            }
        }
        si dernier == nul {
            tete = r;
        } sinon {
            dernier.suivant = r;
        }
        dernier = r;
        tantque dernier.suivant != nul {
            dernier = dernier.suivant;
        }
        s = suivant;
    }
    retour tete;
}

fonction partitionner(c: Ctx) {
    calculer_effets(c);
    c.copie_libre = COPIES_DEBUT;
    soit f = c.fonctions;
    tantque f != nul {
        si f.garde && !f.prelude {
            f.corps = partition_liste(c, f.corps);
        }
        f = f.suivant;
    }
}

// La table des accords pour la machine Rust : nombre d'accords, puis pour chacun début, fin, nombre de mesures, et
// pour chaque mesure le nombre de tâches puis (début, fin) de chacune (même calcul que vtx.py exporter)
fonction table_accords(c: Ctx): Liste {
    soit m = c.marques;
    soit nm = m.n / 4;
    soit t = liste();
    ajouter(t, c.naccords);
    pour rid dans 0..c.naccords {
        soit debut = 0 - 1;
        soit fin = 0;
        soit nmes = 0;
        pour i dans 0..nm {
            si elem(m, 4 * i + 2) == rid {
                si elem(m, 4 * i + 1) == 2 {
                    fin = elem(m, 4 * i);
                } sinon {
                    si debut == 0 - 1 {
                        debut = elem(m, 4 * i);
                    }
                    si elem(m, 4 * i + 3) > nmes {
                        nmes = elem(m, 4 * i + 3);
                    }
                }
            }
        }
        ajouter(t, debut);
        ajouter(t, fin);
        ajouter(t, nmes);
        pour k dans 1..nmes + 1 {
            soit nt = 0;
            pour i2 dans 0..nm {
                si elem(m, 4 * i2 + 2) == rid && elem(m, 4 * i2 + 1) == 1 && elem(m, 4 * i2 + 3) == k {
                    nt = nt + 1;
                }
            }
            ajouter(t, nt);
            pour i3 dans 0..nm {
                si elem(m, 4 * i3 + 2) == rid && elem(m, 4 * i3 + 1) == 1 && elem(m, 4 * i3 + 3) == k {
                    ajouter(t, elem(m, 4 * i3));
                    soit j = i3 + 1;
                    tantque elem(m, 4 * j + 2) != rid {
                        j = j + 1;
                    }
                    ajouter(t, elem(m, 4 * j));
                }
            }
        }
    }
    retour t;
}

fonction marquer(c: Ctx, genre, rid, mesure) {
    ajouter(c.marques, c.code.n);
    ajouter(c.marques, genre);
    ajouter(c.marques, rid);
    ajouter(c.marques, mesure);
}

// Une fonction appelée : si l'élagage l'avait écartée, elle est générée après les autres (comme vtx.py)
fonction demander(c: Ctx, f: Fonction) {
    si f == nul {
        erreur(c, 0, "fonction « nouveau » absente");
        retour 0;
    }
    si !f.garde {
        f.garde = 2;      // 2 : demandée pendant la génération, produite après les autres (une seule fois)
        si c.file_debut == nul {
            c.file_debut = f;
        } sinon {
            c.file_fin.suite = f;
        }
        c.file_fin = f;
    }
    retour f.etiq;
}

fonction appels_liste(c: Ctx, x: Noeud, noms: Liste) {
    tantque x != nul {
        appels_de(c, x, noms);
        x = x.suivant;
    }
}

fonction appels_de(c: Ctx, e: Noeud, noms: Liste) {
    si e == nul {
        retour;
    }
    si e.genre == N_APPEL {
        ajouter(noms, e.nom);
    }
    si e.genre == N_CONSTRUIRE || e.genre == N_NOUVEAU {
        ajouter(noms, "nouveau");
    }
    appels_de(c, e.a, noms);
    appels_de(c, e.b, noms);
    appels_de(c, e.c, noms);
    appels_liste(c, e.premier, noms);
    appels_liste(c, e.deuxieme, noms);
}

// Élagage : seules les fonctions atteintes depuis principal sont gardées
fonction elaguer(c: Ctx) {
    soit f = c.fonctions;
    tantque f != nul {
        f.garde = !c.optim;
        f = f.suivant;
    }
    si !c.optim {
        retour;
    }
    soit pile = liste();
    ajouter(pile, "principal");
    tantque pile.n > 0 {
        pile.n = pile.n - 1;
        soit g = fonction_de(c, elem(pile, pile.n));
        si g != nul && !g.garde {
            g.garde = 1;
            soit noms = liste();
            appels_liste(c, g.corps, noms);
            pour i dans 0..noms.n {
                ajouter(pile, elem(noms, i));
            }
        }
    }
}

fonction generer(c: Ctx) {
    soit p = fonction_de(c, "principal");
    si p == nul {
        erreur(c, 0, "la fonction « principal » est absente");
        retour;
    }
    si p.nb != 0 {
        erreur(c, p.ligne, "la fonction « principal » ne prend aucun paramètre");
        retour;
    }
    soit fi = c.fonctions;
    tantque fi != nul {
        si est_integre(fi.nom) {
            erreur_nom(c, fi.ligne, "ce nom est celui d'une fonction intégrée :", fi.nom);
        }
        fi = fi.suivant;
    }
    charger(c, 14, 2147483647);
    // le brin : le code, les textes écrits et les données du programme sont de l'ADN (fixés) : une écriture dessus
    // arrête la machine au lieu de corrompre le programme
    soit fin_code = nouvelle_etiquette(c);
    ldi_etiquette(c, 2, fin_code);
    emettre(c, ins(94, 0, 0, 2, 1));
    saut(c, 51, p.etiq);
    emettre(c, ins(63, 0, 0, 0, 0));
    elaguer(c);
    si c.optim && c.partition {
        partitionner(c);
    }
    si c.optim {
        el_preparer(c);
    }
    soit f = c.fonctions;
    tantque f != nul && c.erreur == 0 {
        si f.garde == 1 {
            fonction_code(c, f);
        }
        f = f.suivant;
    }
    tantque c.file_debut != nul && c.erreur == 0 {
        soit g = c.file_debut;
        c.file_debut = g.suite;
        fonction_code(c, g);
    }
    // blocs de données, puis textes : longueur puis un caractère par mot, dans l'ordre de leur première apparition
    soit dn = c.blocs;
    tantque dn != nul {
        poser_etiquette(c, dn.etiq);
        pour iv dans 0..dn.vals.n {
            emettre(c, elem(dn.vals, iv));
        }
        dn = dn.suivant;
    }
    soit t = c.textes;
    tantque t != nul {
        poser_etiquette(c, t.etiq);
        soit n = longueur(t.val);
        emettre(c, n);
        pour i dans 0..n {
            emettre(c, car(t.val, i));
        }
        t = t.suivant;
    }
    poser_etiquette(c, fin_code);
    // résolution des sauts et des adresses
    pour j2 dans 0..c.fix_pos.n {
        soit pos = elem(c.fix_pos, j2);
        soit cible = elem(c.etiq, elem(c.fix_etiq, j2));
        si elem(c.fix_genre, j2) == 0 {
            // la cible du saut : les 32 bits de l'immédiat
            poser(c.code, pos, elem(c.code, pos) | (cible & 4294967295));
        } sinon {
            poser(c.code, pos, cible);
        }
    }
}

// --------------------------------------------------------------------------------------------- fichiers et importer
fonction lire_fichier(chemin): Liste {
    soit f = ouvrir_lecture(chemin);
    si f == 18446744073709551615 {
        retour nul;
    }
    soit l = liste();
    tantque fin_de(f) == 0 {
        ajouter(l, lire_car(f));
    }
    fermer(f);
    retour l;
}

fonction ajouter_texte(l: Liste, t) {
    pour i dans 0..longueur(t) {
        ajouter(l, car(t, i));
    }
}

// dossier + "/" + nom ; un nom absolu (/…, \…, C:…) reste tel quel
fonction joindre(dossier, nom) {
    si dossier == 0 || longueur(dossier) == 0 || car(nom, 0) == '/' || car(nom, 0) == '\\'
        || (longueur(nom) > 1 && car(nom, 1) == ':') {
        retour nom;
    }
    soit l = liste();
    ajouter_texte(l, dossier);
    soit d = car(dossier, longueur(dossier) - 1);
    si d != '/' && d != '\\' {
        ajouter(l, '/');
    }
    ajouter_texte(l, nom);
    retour texte_de(l, 0, l.n);
}

// a/b/../c/./d -> a/c/d (comme os.path.normpath) : un fichier importé par deux chemins n'est lu qu'une fois
fonction normaliser(chemin) {
    soit n = longueur(chemin);
    soit morceaux = liste();          // débuts et fins des morceaux gardés
    soit absolu = n > 0 && (car(chemin, 0) == '/' || car(chemin, 0) == '\\');
    soit i = 0;
    tantque i <= n {
        soit d = i;
        tantque i < n && car(chemin, i) != '/' && car(chemin, i) != '\\' {
            i = i + 1;
        }
        soit lg = i - d;
        si lg == 0 || (lg == 1 && car(chemin, d) == '.') {
            // rien
        } sinon si lg == 2 && car(chemin, d) == '.' && car(chemin, d + 1) == '.' {
            soit k = morceaux.n;
            soit precedent_point = 0;
            si k > 0 {
                soit pd = elem(morceaux, k - 2);
                precedent_point = elem(morceaux, k - 1) - pd == 2 && car(chemin, pd) == '.' && car(chemin, pd + 1) == '.';
            }
            si k > 0 && !precedent_point {
                morceaux.n = k - 2;
            } sinon si !absolu {
                ajouter(morceaux, d);
                ajouter(morceaux, i);
            }
        } sinon {
            ajouter(morceaux, d);
            ajouter(morceaux, i);
        }
        i = i + 1;
    }
    soit l = liste();
    si absolu {
        ajouter(l, '/');
    }
    pour m dans 0..morceaux.n / 2 {
        si m > 0 {
            ajouter(l, '/');
        }
        pour j dans elem(morceaux, 2 * m)..elem(morceaux, 2 * m + 1) {
            ajouter(l, car(chemin, j));
        }
    }
    si l.n == 0 {
        ajouter(l, '.');
    }
    retour texte_de(l, 0, l.n);
}

fonction dossier_de(chemin) {
    soit k = 0 - 1;
    pour i dans 0..longueur(chemin) {
        si car(chemin, i) == '/' || car(chemin, i) == '\\' {
            k = i;
        }
    }
    si k == 0 - 1 {
        retour "";
    }
    soit l = liste();
    pour j dans 0..k {
        ajouter(l, car(chemin, j));
    }
    retour texte_de(l, 0, l.n);
}

fonction blanc(x) {
    retour x == ' ' || x == 9;
}

// La ligne t[debut..fin] est-elle « importer "fichier"; » ? Rend le nom du fichier, ou 0
fonction ligne_import(c: Ctx, t: Liste, debut, fin) {
    soit i = debut;
    tantque i < fin && blanc(elem(t, i)) {
        i = i + 1;
    }
    soit motcle = "importer";
    pour k dans 0..8 {
        si i + k >= fin || elem(t, i + k) != car(motcle, k) {
            retour 0;
        }
    }
    i = i + 8;
    si i >= fin || !blanc(elem(t, i)) {
        retour 0;
    }
    tantque i < fin && blanc(elem(t, i)) {
        i = i + 1;
    }
    soit nom = 0;
    si i < fin && elem(t, i) == '"' {
        soit d = i + 1;
        i = d;
        tantque i < fin && elem(t, i) != '"' {
            i = i + 1;
        }
        si i >= fin || i == d {
            retour 0;
        }
        nom = texte_de(t, d, i);
        i = i + 1;
    } sinon {
        retour 0;
    }
    tantque i < fin && blanc(elem(t, i)) {
        i = i + 1;
    }
    si i >= fin || elem(t, i) != ';' {
        retour 0;
    }
    i = i + 1;
    tantque i < fin && (blanc(elem(t, i)) || elem(t, i) == 13) {
        i = i + 1;
    }
    si i != fin {
        retour 0;
    }
    retour nom;
}


fonction deja_vu(c: Ctx, chemin) {
    pour i dans 0..c.vus.n {
        si egal(elem(c.vus, i), chemin) {
            retour 1;
        }
    }
    retour 0;
}

// Une portion du texte assemblé : à partir de la ligne debut, elle vient de la ligne origine du fichier affiche
fonction segment(c: Ctx, affiche, origine) {
    ajouter(c.segs, c.nlignes + 1);
    ajouter(c.segs, affiche);
    ajouter(c.segs, origine);
}

// Range le fichier dans c.src ; chaque ligne « importer "x.vtx"; » est remplacée par le fichier (une fois par fichier)
fonction charger_source(c: Ctx, chemin, affiche, dossier) {
    soit t = lire_fichier(chemin);
    si t == nul {
        si affiche == 0 {
            erreur_nom(c, 0, "fichier introuvable :", chemin);
        } sinon {
            erreur_nom(c, c.nlignes + 1, "importer : fichier introuvable", affiche);
        }
        retour;
    }
    segment(c, affiche, 1);
    soit i = 0;
    soit ligne = 1;
    tantque i <= t.n && c.erreur == 0 {
        soit fin = i;
        tantque fin < t.n && elem(t, fin) != 10 {
            fin = fin + 1;
        }
        soit nom = ligne_import(c, t, i, fin);
        si nom != 0 {
            soit ch = normaliser(joindre(dossier, nom));
            si !deja_vu(c, ch) {
                ajouter(c.vus, ch);
                soit montre = nom;
                si affiche != 0 {
                    montre = normaliser(joindre(dossier_de(affiche), nom));
                }
                charger_source(c, ch, montre, dossier_de(ch));
            }
            segment(c, affiche, ligne + 1);
        } sinon {
            pour k dans i..fin {
                ajouter(c.src, elem(t, k));
            }
            ajouter(c.src, 10);
            c.nlignes = c.nlignes + 1;
        }
        ligne = ligne + 1;
        i = fin + 1;
    }
}

// --------------------------------------------------------------------------------------------- le type texte
// Comme typer_textes de vtx.py : avant l'élagage et la partition, les expressions de texte sont reconnues et réécrites
// en appels du prélude (a + b, a == b, a != b, afficher et ecrire d'un texte, afficher à plusieurs valeurs), puis le
// type texte redevient « entier » pour la génération du code.
// un champ est un texte s'il est déclaré texte dans toutes les structures qui ont un champ de ce nom
fonction champ_texte(c: Ctx, nom) {
    soit vu = 0;
    soit s = c.structs;
    tantque s != nul {
        soit ch = s.champs;
        tantque ch != nul {
            si egal(ch.nom, nom) {
                si ch.type != T_T {
                    retour 0;
                }
                vu = 1;
            }
            ch = ch.suivant;
        }
        s = s.suivant;
    }
    retour vu;
}

// la poignée h est-elle un tableau de textes (decouper, cles, ou une variable qui en contient un) ?
fonction tableau_de_textes(c: Ctx, h: Noeud, tabs: Liste) {
    si h.genre == N_VAR {
        retour dans_liste(tabs, h.nom);
    }
    retour h.genre == N_APPEL && (egal(h.nom, "decouper") || egal(h.nom, "cles")) && du_prelude(c, h.nom);
}

// ---- les tableaux de flottants : lus comme flottants, écrits par leurs bits
fonction flottant_ecrit(v: Noeud) {
    retour v.genre == N_FNOMBRE || (v.genre == N_BIN && egal(v.op, "-") && v.a.genre == N_NOMBRE && v.a.val == 0
        && v.b.genre == N_FNOMBRE);
}

// [a, b, c] avec au moins un flottant écrit en chiffres : un tableau de flottants
fonction literal_flottant(c: Ctx, e: Noeud) {
    tantque e != nul && e.genre == N_APPEL && egal(e.nom, "__remplir") && du_prelude(c, "__remplir") {
        si flottant_ecrit(e.premier.suivant.suivant) {
            retour 1;
        }
        e = e.premier;
    }
    retour 0;
}

fonction tableau_flottant(c: Ctx, h: Noeud) {
    si h == nul {
        retour 0;
    }
    si h.genre == N_VAR {
        retour dans_liste(c.tabflot, h.nom);
    }
    si h.genre == N_APPEL {
        si egal(h.nom, "copie") && du_prelude(c, "copie") && h.premier != nul && h.premier.suivant == nul {
            retour tableau_flottant(c, h.premier);
        }
        soit f = fonction_de(c, h.nom);
        retour (f != nul && f.rtype == T_TF) || literal_flottant(c, h);
    }
    retour 0;
}

// t[i] : (« lire », 3, (+, (« lire », 3, (+, t, 2)), i)) : la poignée t, sinon nul
fonction poignee(e: Noeud): Noeud {
    si e != nul && e.genre == N_LIRE && e.val == 3 && e.a == nul && e.b.genre == N_BIN && egal(e.b.op, "+")
        && e.b.a.genre == N_LIRE && e.b.a.val == 3 && e.b.a.a == nul && e.b.a.b.genre == N_BIN
        && egal(e.b.a.b.op, "+") && e.b.a.b.b.genre == N_NOMBRE && e.b.a.b.b.val == 2 {
        retour e.b.a.b.a;
    }
    retour nul;
}

// l'adresse de t[i] dans une écriture : (+, (« lire », 3, (+, t, 2)), i) : la poignée t, sinon nul
fonction adresse_poignee(a: Noeud): Noeud {
    si a != nul && a.genre == N_BIN && egal(a.op, "+") && a.a.genre == N_LIRE && a.a.val == 3 && a.a.a == nul
        && a.a.b.genre == N_BIN && egal(a.a.b.op, "+") && a.a.b.b.genre == N_NOMBRE && a.a.b.b.val == 2 {
        retour a.a.b.a;
    }
    retour nul;
}

// une valeur rangée dans un tableau de flottants : ses bits ; un nombre écrit est converti dès la compilation
fonction en_bits(v: Noeud): Noeud {
    soit l = v.ligne;
    si v.genre == N_FNOMBRE {
        retour nombre(v.val, l);
    }
    si v.genre == N_BIN && egal(v.op, "-") && v.a.genre == N_NOMBRE && v.a.val == 0 {
        si v.b.genre == N_FNOMBRE {
            retour nombre(v.b.val ^ 13835058055282163712, l);
        }
        si v.b.genre == N_NOMBRE && v.b.val < 2251799813685248 {
            retour nombre(bits(0.0 - flottant(v.b.val)), l);
        }
    }
    si v.genre == N_NOMBRE && v.val < 2251799813685248 {
        retour nombre(bits(flottant(v.val)), l);
    }
    retour appel1_de("bits", appel1_de("flottant", v, l), l);
}

fonction en_bits_litteral(x: Noeud) {
    tantque x != nul && x.genre == N_APPEL && egal(x.nom, "__remplir") {
        soit k = x.premier.suivant;
        soit nv = en_bits(k.suivant);
        k.suivant = nv;
        nv.suivant = nul;
        x = x.premier;
    }
}

// le noeud e devient f(e) (e est recopié dessous)
fonction envelopper(e: Noeud, nom) {
    soit dessous = Noeud { genre: e.genre, val: e.val, nom: e.nom, op: e.op, a: e.a, b: e.b, c: e.c, premier: e.premier,
                           deuxieme: e.deuxieme, ligne: e.ligne, zet: e.zet, zlo: e.zlo, zhi: e.zhi, copie: e.copie };
    e.genre = N_APPEL;
    e.nom = nom;
    e.premier = dessous;
    e.val = 0;
    e.op = 0;
    e.a = nul;
    e.b = nul;
    e.c = nul;
}

// les règles des tableaux de flottants sur un noeud dont les enfants sont faits ; 1 si une règle a servi
fonction flottants_noeud(c: Ctx, e: Noeud) {
    si poignee(e) != nul && tableau_flottant(c, poignee(e)) {
        envelopper(e, "comme_flottant");
        retour 1;
    }
    si e.genre == N_ECRIRE && e.val == 3 && e.a == nul && tableau_flottant(c, adresse_poignee(e.b)) {
        e.c = en_bits(e.c);
        retour 1;
    }
    si e.genre == N_APPEL && e.premier != nul && tableau_flottant(c, e.premier) && du_prelude(c, e.nom) {
        si (egal(e.nom, "ajouter") || egal(e.nom, "inserer") || egal(e.nom, "indice")
            || egal(e.nom, "contient")) && e.premier.suivant != nul {
            soit av = e.premier;
            tantque av.suivant.suivant != nul {
                av = av.suivant;
            }
            soit nv = en_bits(av.suivant);
            av.suivant = nv;
            nv.suivant = nul;
            retour 1;
        }
        si egal(e.nom, "retirer") || egal(e.nom, "enlever") {
            envelopper(e, "comme_flottant");
            retour 1;
        }
        si egal(e.nom, "somme") && e.premier.suivant == nul {
            e.nom = "__somme_f";
            retour 1;
        }
        si egal(e.nom, "trier") && e.premier.suivant == nul {
            e.nom = "__trier_f";
            retour 1;
        }
    }
    retour 0;
}

fonction est_texte(c: Ctx, e: Noeud, env: Liste) {
    si e == nul {
        retour 0;
    }
    si poignee(e) != nul {
        // t[i] d'un tableau de textes
        retour tableau_de_textes(c, poignee(e), c.tabtextes);
    }
    si e.genre == N_ETIQ {
        retour 1;
    }
    si e.genre == N_VAR {
        retour dans_liste(env, e.nom);
    }
    si e.genre == N_APPEL {
        si (egal(e.nom, "fixer") || egal(e.nom, "copier_arn")) && e.premier != nul && e.premier.suivant == nul
                && du_prelude(c, e.nom) {
            retour est_texte(c, e.premier, env);
        }
        soit f = fonction_de(c, e.nom);
        retour f != nul && f.rtype == T_T;
    }
    si e.genre == N_CHAMP {
        retour champ_texte(c, e.nom);
    }
    si e.genre == N_BIN && egal(e.op, "+") {
        retour est_texte(c, e.a, env) || est_texte(c, e.b, env);
    }
    retour 0;
}

// les « soit » d'une fonction : marque comme textes les variables déclarées texte ou initialisées par un texte
// (rend le nombre de nouvelles) ; avec normaliser, le type texte redevient entier
fonction soits_textes(c: Ctx, s: Noeud, env: Liste, normaliser) {
    soit n = 0;
    tantque s != nul {
        si s.genre == N_SOIT {
            si normaliser {
                si s.val == T_T || s.val == T_TF {
                    s.val = 0;
                }
            } sinon {
                soit t = 0;
                si s.val != 0 {
                    t = s.val == T_T;
                } sinon {
                    t = est_texte(c, s.a, env);
                }
                si t && !dans_liste(env, s.nom) {
                    ajouter(env, s.nom);
                    n = n + 1;
                }
                si !dans_liste(c.tabtextes, s.nom) && tableau_de_textes(c, s.a, c.tabtextes) {
                    ajouter(c.tabtextes, s.nom);
                    n = n + 1;
                }
                si !dans_liste(c.tabflot, s.nom) && (s.val == T_TF || tableau_flottant(c, s.a)) {
                    ajouter(c.tabflot, s.nom);
                    n = n + 1;
                }
            }
        }
        n = n + soits_textes(c, s.a, env, normaliser) + soits_textes(c, s.b, env, normaliser) + soits_textes(c, s.c, env, normaliser)
            + soits_textes(c, s.premier, env, normaliser) + soits_textes(c, s.deuxieme, env, normaliser);
        s = s.suivant;
    }
    retour n;
}

fonction appel1_de(nom, a: Noeud, l): Noeud {
    a.suivant = nul;
    retour Noeud { genre: N_APPEL, nom: nom, premier: a, ligne: l };
}

fonction vers_texte(c: Ctx, e: Noeud, env: Liste): Noeud {
    si est_texte(c, e, env) {
        retour e;
    }
    retour appel1_de("texte", e, e.ligne);
}

fonction du_prelude(c: Ctx, nom) {
    soit f = fonction_de(c, nom);
    retour f != nul && f.prelude;
}

// un noeud seul (pas la suite de sa liste), enfants d'abord
fonction textes_noeud(c: Ctx, e: Noeud, env: Liste) {
    si e == nul {
        retour;
    }
    // un littéral de flottants : chaque valeur rangée par ses bits (les entiers écrits deviennent des flottants)
    si e.genre == N_SOIT && e.val == T_TF && e.a != nul && e.a.genre == N_APPEL && egal(e.a.nom, "__remplir")
        && du_prelude(c, "__remplir") {
        en_bits_litteral(e.a);
    }
    si e.genre == N_APPEL && egal(e.nom, "__remplir") && literal_flottant(c, e) {
        en_bits_litteral(e);
    }
    textes_noeud(c, e.a, env);
    textes_noeud(c, e.b, env);
    textes_noeud(c, e.c, env);
    textes_liste(c, e.premier, env);
    textes_liste(c, e.deuxieme, env);
    si flottants_noeud(c, e) {
        retour;
    }
    si e.genre == N_BIN && egal(e.op, "+") && (est_texte(c, e.a, env) || est_texte(c, e.b, env)) {
        soit a = vers_texte(c, e.a, env);
        soit b = vers_texte(c, e.b, env);
        a.suivant = b;
        b.suivant = nul;
        e.genre = N_APPEL;
        e.nom = "__texte_plus";
        e.premier = a;
        e.a = nul;
        e.b = nul;
    } sinon si e.genre == N_BIN && (egal(e.op, "==") || egal(e.op, "!=")) && est_texte(c, e.a, env)
        && est_texte(c, e.b, env) {
        soit eg = Noeud { genre: N_APPEL, nom: "texte_egal", premier: e.a, ligne: e.ligne };
        e.a.suivant = e.b;
        e.b.suivant = nul;
        si egal(e.op, "==") {
            e.genre = N_APPEL;
            e.nom = "texte_egal";
            e.premier = e.a;
            e.a = nul;
            e.b = nul;
        } sinon {
            e.op = "==";
            e.a = eg;
            e.b = Noeud { genre: N_NOMBRE, val: 0, ligne: e.ligne };
        }
    } sinon si e.genre == N_APPEL && e.premier != nul && e.premier.suivant == nul && est_texte(c, e.premier, env) {
        si (egal(e.nom, "afficher") || egal(e.nom, "ecrire")) && du_prelude(c, e.nom) {
            si egal(e.nom, "afficher") {
                e.nom = "__afficher_t";
            } sinon {
                e.nom = "__ecrire_t";
            }
        } sinon si egal(e.nom, "texte") && du_prelude(c, "texte") {
            e.nom = "__texte_t";
        }
    }
    textes_tas(c, e, env);
}

// un texte rangé dans le tas y est recopié s'il est écrit dans le programme (voir __texte_tas dans le prélude)
fonction texte_tas(c: Ctx, v: Noeud, env: Liste, l): Noeud {
    si v != nul && est_texte(c, v, env) && du_prelude(c, "__texte_tas") {
        soit suite = v.suivant;
        soit w = appel1_de("__texte_tas", v, l);
        w.suivant = suite;
        retour w;
    }
    retour v;
}

fonction range_textes(nom) {
    retour egal(nom, "ajouter") || egal(nom, "inserer") || egal(nom, "ranger")
        || egal(nom, "affirmer") || egal(nom, "nier") || egal(nom, "__remplir");
}

fonction textes_tas(c: Ctx, e: Noeud, env: Liste) {
    si e.genre == N_CONSTRUIRE {
        soit q = e.premier;
        tantque q != nul {
            q.a = texte_tas(c, q.a, env, e.ligne);
            q = q.suivant;
        }
    } sinon si e.genre == N_ECRIRE_CHAMP {
        e.c = texte_tas(c, e.c, env, e.ligne);
    } sinon si e.genre == N_ECRIRE && e.val == 3 && e.a == nul && adresse_poignee(e.b) != nul {
        e.c = texte_tas(c, e.c, env, e.ligne);
    } sinon si e.genre == N_APPEL && range_textes(e.nom) && du_prelude(c, e.nom) && e.premier != nul
            && e.premier.suivant != nul {
        soit av = e.premier;
        tantque av.suivant != nul {
            av.suivant = texte_tas(c, av.suivant, env, e.ligne);
            av = av.suivant;
        }
    }
}

fonction textes_liste(c: Ctx, s: Noeud, env: Liste) {
    tantque s != nul {
        soit suite = s.suivant;
        textes_noeud(c, s, env);
        // afficher(a, b, c) : écrire a, une espace, b, une espace, puis afficher c (avec le retour à la ligne)
        si s.genre == N_EXPR && s.a.genre == N_APPEL && egal(s.a.nom, "afficher") && s.a.premier != nul
            && s.a.premier.suivant != nul && du_prelude(c, "afficher") {
            soit l = s.a.ligne;
            soit arg = s.a.premier;
            soit dernier = s;
            soit premier_fait = 0;
            tantque arg != nul {
                soit arg_suite = arg.suivant;
                soit nom = "afficher";
                si arg_suite != nul {
                    nom = "ecrire";
                }
                si est_texte(c, arg, env) {
                    si arg_suite != nul {
                        nom = "__ecrire_t";
                    } sinon {
                        nom = "__afficher_t";
                    }
                }
                soit ap = appel1_de(nom, arg, l);
                si premier_fait == 0 {
                    s.a = ap;
                    premier_fait = 1;
                } sinon {
                    soit st = Noeud { genre: N_EXPR, a: ap, ligne: s.ligne };
                    dernier.suivant = st;
                    dernier = st;
                }
                si arg_suite != nul {
                    soit un = Noeud { genre: N_NOMBRE, val: 1, ligne: l };
                    un.suivant = Noeud { genre: N_NOMBRE, val: 32, ligne: l };
                    soit esp = Noeud { genre: N_EXPR, a: Noeud { genre: N_APPEL, nom: "ecrire_car", premier: un, ligne: l },
                                       ligne: s.ligne };
                    dernier.suivant = esp;
                    dernier = esp;
                }
                arg = arg_suite;
            }
            dernier.suivant = suite;
        }
        s = suite;
    }
}

// --------------------------------------------------------------------------------------------- prélude à la demande
// Le prélude compte près de 150 fonctions ; les lire toutes à chaque compilation coûtait l'essentiel du temps. On ne lit
// que celles dont le nom paraît dans le programme, dans les fonctions qu'appelle le compilateur lui-même, et, de proche
// en proche, dans les fonctions retenues. Avec les optimisations, la génération ne garde de toute façon que les fonctions
// appelées (élagage) : le code produit est le même, dans le même ordre.
structure Morceau { debut, fin, nom, nl, pris, suivant: Morceau }

fonction car_de_nom(x) {
    retour (x >= 'a' && x <= 'z') || (x >= 'A' && x <= 'Z') || (x >= '0' && x <= '9') || x == '_' || x >= 128;
}

// le morceau (fonction du prélude) qui porte le nom u[d..d+n], sinon nul
fonction morceau_nomme(t, ms: Morceau, u, d, n): Morceau {
    soit m: Morceau = table_lire_sous(K_PRELUDE, u, d, n);
    retour m;
}

structure Pile { m: Morceau, suivant: Pile }

fonction prendre(m: Morceau, p: Pile): Pile {
    si m == nul || m.pris {
        retour p;
    }
    m.pris = 1;
    retour Pile { m: m, suivant: p };
}

fonction prelude_utile(c: Ctx, t) {
    soit n = longueur(t);
    // les morceaux : chaque « fonction » écrite en début de ligne, jusqu'à la suivante
    soit ms: Morceau = nul;
    soit der: Morceau = nul;
    soit i = 0;
    tantque i < n {
        si (i == 0 || car(t, i - 1) == 10) && i + 9 < n && car(t, i) == 'f' && car(t, i + 1) == 'o' && car(t, i + 2) == 'n'
                && car(t, i + 3) == 'c' && car(t, i + 4) == 't' && car(t, i + 5) == 'i' && car(t, i + 6) == 'o'
                && car(t, i + 7) == 'n' && car(t, i + 8) == ' ' {
            soit k = i + 9;
            tantque k < n && car_de_nom(car(t, k)) {
                k = k + 1;
            }
            soit nv = Morceau { debut: i, fin: n, nom: i + 9, nl: k - i - 9 };
            si der == nul {
                ms = nv;
            } sinon {
                der.fin = i;
                der.suivant = nv;
            }
            der = nv;
        }
        i = i + 1;
    }
    // chaque morceau rangé par son nom (le premier d'un nom l'emporte)
    soit mr = ms;
    tantque mr != nul {
        si table_lire_sous(K_PRELUDE, t, mr.nom, mr.nl) == 0 {
            soit cle = nouveau(mr.nl + 1);
            @[cle] = mr.nl;
            pour kn dans 0..mr.nl {
                @[cle + 1 + kn] = @[t + 1 + mr.nom + kn];
            }
            table_poser(K_PRELUDE, cle, bits(mr));
        }
        mr = mr.suivant;
    }
    // les graines : les noms du programme, ceux qu'emploie le compilateur lui-même, et les fonctions
    // qui écrivent un texte
    soit p: Pile = nul;
    soit j = c.jetons;
    tantque j != nul {
        si j.genre == 1 {
            p = prendre(morceau_nomme(t, ms, j.texte, 0, longueur(j.texte)), p);
        }
        j = j.suivant;
    }
    soit g = "nouveau tableau longueur texte_egal texte ecrire afficher ecrire_car comme_logique qegal nb_bits flottant_petuar __afficher_f __afficher_i __afficher_q __afficher_s __afficher_t __afficher_w __afficher_x __code_logique __ecrire_f __ecrire_i __ecrire_q __ecrire_s __ecrire_t __ecrire_w __ecrire_x __hyp_annuler __hyp_debut __hyp_noter __hyp_valider __pq_ __pq_abs __pq_add __pq_de_e __pq_de_f __pq_de_ieee __pq_de_s __pq_de_w __pq_div __pq_eq __pq_ge __pq_gt __pq_le __pq_lt __pq_max __pq_min __pq_mul __pq_ne __pq_neg __pq_racine __pq_sub __pq_vers_f __pq_vers_ieee __pq_vers_s __pq_vers_w __q __qabs __qdiv __qi __qlt __qmax __qmin __qsar __qshl __qv __remplir __service __somme_f __texte_f __texte_i __texte_plus __texte_q __texte_s __texte_t __texte_tas __texte_w __texte_x __trier_f";
    soit a = 0;
    tantque a < longueur(g) {
        soit b = a;
        tantque b < longueur(g) && car(g, b) != ' ' {
            b = b + 1;
        }
        p = prendre(morceau_nomme(t, ms, g, a, b - a), p);
        a = b + 1;
    }
    soit m = ms;
    tantque m != nul {
        // les textes écrits dans le prélude sont tous gardés dans le code (comme vtx.py) : leurs fonctions sont lues
        pour kq dans m.debut..m.fin {
            si car(t, kq) == '"' {
                p = prendre(m, p);
            }
        }
        m = m.suivant;
    }
    // de proche en proche : les noms écrits dans les fonctions retenues
    tantque p != nul {
        soit x = p.m;
        p = p.suivant;
        soit q = x.nom + x.nl;
        tantque q < x.fin {
            si car_de_nom(car(t, q)) && !car_de_nom(car(t, q - 1)) && !(car(t, q) >= '0' && car(t, q) <= '9') {
                soit r = q;
                tantque r < x.fin && car_de_nom(car(t, r)) {
                    r = r + 1;
                }
                p = prendre(morceau_nomme(t, ms, t, q, r - q), p);
                q = r;
            } sinon {
                q = q + 1;
            }
        }
    }
    // le texte lu : les fonctions retenues, dans l'ordre du prélude
    ajouter(c.src, 10);
    m = ms;
    tantque m != nul {
        si m.pris {
            pour kc dans m.debut..m.fin {
                ajouter(c.src, car(t, kc));
            }
        }
        m = m.suivant;
    }
}

fonction typer_textes(c: Ctx) {
    soit f = c.fonctions;
    tantque f != nul {
        si !f.prelude {
            c.tabtextes = liste();
            c.tabflot = liste();
            soit env = liste();
            soit p = f.params;
            tantque p != nul {
                si p.type == T_T {
                    ajouter(env, p.nom);
                }
                si p.type == T_TF {
                    ajouter(c.tabflot, p.nom);
                }
                p = p.suivant;
            }
            tantque soits_textes(c, f.corps, env, 0) > 0 {
            }
            textes_liste(c, f.corps, env);
        }
        f = f.suivant;
    }
    // pour la génération du code, un texte est un entier
    f = c.fonctions;
    tantque f != nul {
        si f.rtype == T_T || f.rtype == T_TF {
            f.rtype = 0;
        }
        soit p2 = f.params;
        tantque p2 != nul {
            si p2.type == T_T || p2.type == T_TF {
                p2.type = 0;
            }
            p2 = p2.suivant;
        }
        soits_textes(c, f.corps, liste(), 1);
        f = f.suivant;
    }
    soit s = c.structs;
    tantque s != nul {
        soit ch = s.champs;
        tantque ch != nul {
            si ch.type == T_T {
                ch.type = 0;
            }
            ch = ch.suivant;
        }
        s = s.suivant;
    }
}

// Les noms d'étages : CPU 0, GPU 1, PARTAGE 2, DISQUE 3
fonction constantes_predefinies(c: Ctx) {
    c.consts = Constante { nom: "CPU", val: 0, suivant: c.consts };
    table_poser(K_CONSTANTES + 4 * c.kconst, c.consts.nom, bits(c.consts));
    c.consts = Constante { nom: "GPU", val: 1, suivant: c.consts };
    table_poser(K_CONSTANTES + 4 * c.kconst, c.consts.nom, bits(c.consts));
    c.consts = Constante { nom: "PARTAGE", val: 2, suivant: c.consts };
    table_poser(K_CONSTANTES + 4 * c.kconst, c.consts.nom, bits(c.consts));
    c.consts = Constante { nom: "DISQUE", val: 3, suivant: c.consts };
    table_poser(K_CONSTANTES + 4 * c.kconst, c.consts.nom, bits(c.consts));
}

fonction principal() {
    tables_glacees();
    soit c = Ctx { src: liste(), code: liste(), etiq: liste(), fix_pos: liste(), fix_etiq: liste(), fix_genre: liste(),
                   vus: liste(), segs: liste(), pile: liste(), tab_w: liste() };
    // entrées : le dossier du programme, un caractère par entrée, terminé par 0 (les fichiers importés y sont cherchés)
    soit d = liste();
    soit x = entrée();
    tantque x != 0 {
        ajouter(d, x);
        x = entrée();
    }
    charger_source(c, "source.vtx", 0, texte_de(d, 0, d.n));
    si c.erreur != 0 {
        ecrire_texte(1, "vtxc : compilation arrêtée\n");
        retour;
    }
    soit avec_prelude = entrée();          // 1 : ajouter le prélude, comme vtx.py
    c.optim = entrée();                    // 1 : optimiser, comme vtx.py par défaut
    c.partition = entrée();                // 1 : partition des tâches en accords
    c.lignes_dbg = entrée();               // 1 : table des lignes pour le pas à pas (absente : 0)
    c.dbg = liste();
    c.marques = liste();
    constantes_predefinies(c);
    lexer(c);
    c.tok = c.jetons;
    programme(c);
    c.segs_prog = c.segs;
    si c.cumul_utilise {
        soit tz = c.tableaux;
        tantque tz != nul {
            soit nm = tz.taille;
            si tz.sorte == 1 || tz.sorte == 2 {
                nm = (tz.taille + 31) / 32;
            } sinon si tz.sorte == 3 {
                nm = tz.taille * struct_numero(c, tz.st).nb;
            }
            si tz.etage == 3 && tz.base < COPIES_FIN && tz.base + nm > COPIES_DEBUT {
                erreur_nom(c, 0, "ce tableau occupe @3[14680064..15728640], réservé aux copies des tableaux cumulés :", tz.nom);
            }
            tz = tz.suivant;
        }
    }
    injecter_donnees(c);
    si avec_prelude == 1 && c.erreur == 0 {
        // le prélude est lu à part : les constantes et les tableaux du programme n'y sont pas visibles
        soit consts = c.consts;
        soit tableaux = c.tableaux;
        c.consts = nul;
        c.kconst = 1;
        constantes_predefinies(c);
        c.tableaux = nul;
        c.src = liste();
        si c.optim {
            prelude_utile(c, texte_prelude());
        } sinon {
            // sans optimisation, rien n'est élagué : tout le prélude est compilé, comme vtx.py
            ajouter_texte(c.src, texte_prelude());
        }
        c.jetons = nul;
        c.segs = nul;
        lexer(c);
        c.tok = c.jetons;
        c.en_prelude = 1;
        programme(c);
        c.en_prelude = 0;
        c.consts = consts;
        c.kconst = 0;
        c.tableaux = tableaux;
    }
    si c.erreur == 0 {
        typer_textes(c);
    }
    si c.erreur == 0 {
        generer(c);
    }
    si c.erreur != 0 {
        ecrire_texte(1, "vtxc : compilation arrêtée\n");
        retour;
    }
    soit s = ouvrir_ecriture("code.mots");
    pour i dans 0..c.code.n {
        si i > 0 {
            ecrire_car(s, ',');
        }
        ecrire_nombre(s, elem(c.code, i));
    }
    si c.optim && c.partition {
        // « mots;table des accords »
        ecrire_car(s, ';');
        soit t = table_accords(c);
        pour j dans 0..t.n {
            si j > 0 {
                ecrire_car(s, ',');
            }
            ecrire_nombre(s, elem(t, j));
        }
    }
    si c.lignes_dbg == 1 {
        // « mots;table;lignes » : adresse, ligne, adresse, ligne…
        si !(c.optim && c.partition) {
            ecrire_car(s, ';');
        }
        ecrire_car(s, ';');
        pour j dans 0..c.dbg.n {
            si j > 0 {
                ecrire_car(s, ',');
            }
            ecrire_nombre(s, elem(c.dbg, j));
        }
    }
    fermer(s);
    ecrire_texte(1, "vtxc : ");
    ecrire_nombre(1, c.code.n);
    ecrire_texte(1, " mots\n");
}

// Le prélude de vtx64.py, mot pour mot (le test vérifie qu'il est identique) : ajouté à la fin du programme compilé,
// sauf les fonctions que le programme définit lui-même.
fonction texte_prelude() {
    retour "\nfonction abs(x) { si x .< 0 { retour 0 - x; } retour x; }\nfonction inf(a, b) { retour a .< b; }\nfonction sup(a, b) { retour a .> b; }\nfonction __hyp_debut() {\n    soit d = @3[16777201];\n    si d == 0 { @3[16777200] = 15728640; }\n    @3[16777201] = d + 1;\n    retour @3[16777200];\n}\nfonction __hyp_noter(e, a) {\n    soit p = @3[16777200];\n    @3[p] = e;\n    @3[p + 1] = a;\n    @3[p + 2] = @(e)[a];\n    @3[16777200] = p + 3;\n}\nfonction __hyp_valider() { @3[16777201] = @3[16777201] - 1; }\nfonction __hyp_annuler(p0) {\n    soit p = @3[16777200];\n    tantque p > p0 {\n        p = p - 3;\n        @(@3[p])[@3[p + 1]] = @3[p + 2];\n    }\n    @3[16777200] = p0;\n    @3[16777201] = @3[16777201] - 1;\n}\nfonction divs(a, b) { retour a ./ b; }\nfonction mods(a, b) { retour a .% b; }\nfonction asr(a, n) { retour a .>> n; }\nfonction signe(x) { si x == 0 { retour 0; } si x .< 0 { retour 18446744073709551615; } retour 1; }\nfonction min(a, b) { si a < b { retour a; } retour b; }\nfonction max(a, b) { si a > b { retour a; } retour b; }\nfonction poids(ecart, temperature) {\n    soit d = ecart >> temperature;\n    si d < 16 { retour 65536 >> d; }\n    retour 0;\n}\nfonction gdotn(ea, a, eb, b, n) {\n    soit s = 0;\n    pour i dans 0..n { s = s + gdot(@(ea)[a + i], @(eb)[b + i]); }\n    retour s;\n}\nfonction copier(ed, d, es, s, n) {\n    pour i dans 0..n { @(ed)[d + i] = @(es)[s + i]; }\n}\nfonction melange(ev, bv, ep, bp, decalage, n) {\n    soit s = 0;\n    pour i dans 0..n { s = s + @(ep)[bp + i] * ((@(ev)[bv + i] >> decalage) & 65535); }\n    retour s;\n}\n// une adresse longue : étage (bits 63-62), fréquence du cube (bits 47-24), #RRGGBB (bits 23-0)\nfonction cube_adresse(etage, frequence, a) {\n    retour (etage << 62) | ((frequence & 16777215) << 24) | (a & 16777215);\n}\n// un texte : l'adresse longue d'un bloc (longueur, puis un caractère par mot) ; écrit dans le programme, il est à\n// l'étage 0 avec le code ; fabriqué, il est dans le tas (étage 3)\nfonction longueur(t) {\n    retour @[t];\n}\nfonction car(t, i) {\n    retour @[t + 1 + i];\n}\nfonction changer_car(t, i, c) {\n    @[t + 1 + i] = c;\n}\nfonction texte_egal(a, b) {\n    soit n = longueur(a);\n    si n != longueur(b) {\n        retour 0;\n    }\n    pour i dans 0..n {\n        si car(a, i) != car(b, i) {\n            retour 0;\n        }\n    }\n    retour 1;\n}\nfonction nouveau(n) {\n    // chaque bloc a un mot d'en-tête (sa taille) juste avant lui ; un bloc libéré de la bonne taille est repris\n    // d'abord (listes par taille en @3[14680064 + taille], la liste 0 pour les grands blocs). Rend l'adresse longue\n    // du bloc (étage 3).\n    si n == 0 {\n        n = 1;\n    }\n    si n <= 64 {\n        soit t = @3[14680064 + n];\n        si t != 0 {\n            @3[14680064 + n] = @3[t];\n            @3[t - 1] = n;\n            liberer_brin(0xC000000000000000 + t, n);\n            pour i dans 0..n {\n                @3[t + i] = 0;\n            }\n            retour 0xC000000000000000 + t;\n        }\n    }\n    // un grand bloc libre (premier assez grand) ; ce qui dépasse redevient un bloc libre\n    soit prec = 0;\n    soit g = @3[14680064];\n    tantque g != 0 {\n        soit taille = @3[g - 1] & 16777215;\n        si taille >= n {\n            si prec == 0 {\n                @3[14680064] = @3[g];\n            } sinon {\n                @3[prec] = @3[g];\n            }\n            si taille >= n + 2 {\n                __rendre_suite(g + n, g + taille);\n                taille = n;\n            }\n            @3[g - 1] = taille;\n            liberer_brin(0xC000000000000000 + g, taille);\n            pour j dans 0..taille {\n                @3[g + j] = 0;\n            }\n            retour 0xC000000000000000 + g;\n        }\n        prec = g;\n        g = @3[g];\n    }\n    soit p = @3[14680056];\n    si p == 0 {\n        p = 8388608;\n    }\n    si p + n + 1 > 14080048 {\n        // le tas est plein (les 600 000 derniers mots restent au ramasse-miettes) : une purge, puis un second essai\n        @3[14680056] = p;\n        // pas de purge automatique si la dernière n'a rendu presque rien (le tas est vraiment plein : on ne s'acharne\n        // pas, nouveau rend nul) ; une purge demandée (ramasser) lève cette interdiction\n        si @3[14680252] == 0 && @3[14680253] == 0 {\n            @3[14680252] = 1;\n            soit libres = ramasser();\n            @3[14680252] = 0;\n            si libres < 355715 {\n                @3[14680253] = 1;\n            }\n            si libres > n {\n                retour nouveau(n);\n            }\n        }\n        retour 0;\n    }\n    @3[p] = n;\n    @3[14680056] = p + n + 1;\n    liberer_brin(0xC000000000000001 + p, n);\n    pour k dans 0..n {\n        @3[p + 1 + k] = 0;\n    }\n    retour 0xC000000000000001 + p;\n}\n// un bloc libre d'en-tête h0, qui s'étend jusqu'à h1 (exclu) : rangé dans la liste de sa taille\nfonction __rendre_suite(h0, h1) {\n    soit taille = h1 - h0 - 1;\n    @3[h0] = taille | 2147483648;\n    soit k = taille;\n    si k > 64 {\n        k = 0;\n    }\n    @3[h0 + 1] = @3[14680064 + k];\n    @3[14680064 + k] = h0 + 1;\n}\n// le tas est plein : le programme s'arrête avec un message clair (au lieu d'écrire à l'adresse 0)\nfonction __verifier(h) {\n    si h == 0 {\n        __service(10, 0);\n    }\n    retour h;\n}\nfonction liberer(h) {\n    soit p = h & 16777215;\n    si p <= 8388608 || p >= @3[14680056] {\n        retour;\n    }\n    soit taille = @3[p - 1];\n    si taille >= 2147483648 || brin(0xC000000000000000 + p) == 1 {\n        retour;                    // déjà libre, ou fixé (ADN) : un bloc fixé ne se libère pas\n    }\n    liberer_brin(0xC000000000000000 + p, taille);\n    @3[p - 1] = taille | 2147483648;\n    soit k = taille;\n    si k > 64 {\n        k = 0;\n    }\n    @3[p] = @3[14680064 + k];\n    @3[14680064 + k] = p;\n}\n// ---- le brin de chaque mot : 0 libre, 1 ADN (fixé : le résultat, en lecture seule), 2 ARN (le travail)\n// fixer(h) : le bloc du tas désigné par h (texte, structure, poignée) devient de l'ADN ; une écriture dessus arrête la\n// machine ; il ne sera jamais libéré. Rend h.\nfonction fixer(h) {\n    soit p = h & 16777215;\n    si (h >> 62) == 3 && p > 8388608 && p < @3[14680056] {\n        marquer_adn(0xC000000000000000 + p, @3[p - 1] & 16777215);\n    }\n    retour h;\n}\n// copier_arn(h) : une copie de travail (ARN) du bloc h, modifiable ; un texte écrit dans le programme se copie aussi\nfonction copier_arn(h) {\n    soit n = 0;\n    si (h >> 62) == 0 {\n        n = @[h] + 1;\n    } sinon {\n        n = @3[(h & 16777215) - 1] & 16777215;\n    }\n    soit r = __verifier(nouveau(n));\n    pour i dans 0..n {\n        @[r + i] = @[h + i];\n    }\n    marquer_arn(r, n);\n    retour r;\n}\n// les mêmes pour un tableau dynamique : la poignée et ses données\nfonction fixer_tableau(t) {\n    fixer(t);\n    fixer(0xC000000000000000 + @3[(t & 16777215) + 2]);\n    retour t;\n}\nfonction copier_arn_tableau(t) {\n    soit r = copie(t);\n    marquer_arn(r, 3);\n    marquer_arn(0xC000000000000000 + @3[(r & 16777215) + 2], @3[(r & 16777215) + 1]);\n    retour r;\n}\nfonction est_fixe(h) { retour brin(h) == 1; }\nfonction est_arn(h) { retour brin(h) == 2; }\nfonction tas_marque() {\n    soit p = @3[14680056];\n    si p == 0 {\n        p = 8388608;\n    }\n    retour p;\n}\nfonction tas_retour(m) {\n    @3[14680056] = m;\n    pour k dans 0..65 {\n        @3[14680064 + k] = 0;\n    }\n}\nfonction tas_utilise() {\n    soit p = @3[14680056];\n    si p == 0 {\n        retour 0;\n    }\n    retour p - 8388608;\n}\n// une valeur qui pourrait être l'adresse d'un bloc du tas : à l'étage 0 ou 3, au cube de fréquence 0\nfonction __marquer(v, deb, mar, pil, np, cap, haut) {\n    soit e = v >> 62;\n    si (e != 3 && e != 0) || ((v >> 24) & 274877906943) != 0 {\n        retour np;\n    }\n    soit p = v & 16777215;\n    si p <= 8388608 || p >= haut {\n        retour np;\n    }\n    soit k = p - 8388608;\n    si ((@3[deb + k / 32] >> (k % 32)) & 1) == 0 || ((@3[mar + k / 32] >> (k % 32)) & 1) == 1 {\n        retour np;\n    }\n    @3[mar + k / 32] = @3[mar + k / 32] | (1 << (k % 32));\n    si np < cap {\n        @3[pil + np] = p;\n        retour np + 1;\n    }\n    @3[14680063] = 1;\n    retour np;\n}\nfonction ramasser() {\n    // ramasse-miettes : ce que tiennent les variables (la pile) et les poignées protégées reste ; tout bloc qu'on\n    // ne peut plus atteindre est libéré. Rend le nombre de mots libérés.\n    soit haut = @3[14680056];\n    si haut == 0 {\n        retour 0;\n    }\n    @3[14680254] = @3[14680254] + 1;\n    si @3[14680252] == 0 {\n        @3[14680253] = 0;\n    }\n    soit nm = (haut - 8388608) / 32 + 1;\n    soit deb = haut;\n    soit mar = haut + nm;\n    soit pil = haut + 2 * nm;\n    si pil + 1024 > 14680048 {\n        retour 0;\n    }\n    soit cap = 14680048 - pil;\n    pour i dans 0..(2 * nm) {\n        @3[deb + i] = 0;\n    }\n    soit h = 8388608;\n    tantque h < haut {\n        soit kb = h + 1 - 8388608;\n        @3[deb + kb / 32] = @3[deb + kb / 32] | (1 << (kb % 32));\n        h = h + 1 + (@3[h] & 16777215);\n    }\n    @3[14680063] = 0;\n    soit np = 0;\n    // la pile du SPU-64 descend de 2147483647 (étage 0)\n    pour a dans pile()..2147483647 {\n        np = __marquer(@0[a], deb, mar, pil, np, cap, haut);\n    }\n    pour r dans 0..@3[14680200] {\n        np = __marquer(@3[14680201 + r], deb, mar, pil, np, cap, haut);\n    }\n    tantque np > 0 {\n        np = np - 1;\n        soit p = @3[pil + np];\n        soit taille = @3[p - 1];\n        si taille < 2147483648 {\n            pour j dans 0..taille {\n                np = __marquer(@3[p + j], deb, mar, pil, np, cap, haut);\n            }\n        }\n    }\n    si @3[14680063] == 1 {\n        retour 0;\n    }\n    // balayage : les listes de blocs libres sont refaites ; des blocs libres voisins sont fondus en un seul ; une suite\n    // libre qui touche le sommet fait redescendre le tas\n    pour k2 dans 0..65 {\n        @3[14680064 + k2] = 0;\n    }\n    soit libres = 0;\n    soit debut_libre = 0;\n    h = 8388608;\n    tantque h < haut {\n        soit b = h + 1;\n        soit t2 = @3[h];\n        soit kb2 = b - 8388608;\n        si t2 >= 2147483648 || (((@3[mar + kb2 / 32] >> (kb2 % 32)) & 1) == 0 && brin(0xC000000000000000 + b) != 1) {\n            si t2 < 2147483648 {\n                libres = libres + t2;\n            }\n            si debut_libre == 0 {\n                debut_libre = h;\n            }\n        } sinon si debut_libre != 0 {\n            __rendre_suite(debut_libre, h);\n            debut_libre = 0;\n        }\n        h = b + (t2 & 16777215);\n    }\n    si debut_libre != 0 {\n        @3[14680056] = debut_libre;\n    }\n    retour libres;\n}\nfonction purges() {\n    retour @3[14680254];\n}\nfonction proteger(h) {\n    soit n = @3[14680200];\n    si n < 50 {\n        @3[14680201 + n] = h;\n        @3[14680200] = n + 1;\n    }\n}\nfonction sauver_bloc(nom, adr, n) {\n    @3[14680060] = nom;\n    @3[14680061] = adr;\n    @3[14680062] = n;\n    retour __service(6, 0);\n}\nfonction charger_bloc(nom, adr, n) {\n    @3[14680060] = nom;\n    @3[14680061] = adr;\n    @3[14680062] = n;\n    retour __service(7, 0);\n}\nfonction __nom_ent(nom) {\n    soit n = longueur(nom);\n    soit t = texte_neuf(n + 4);\n    pour i dans 0..n {\n        changer_car(t, i, car(nom, i));\n    }\n    changer_car(t, n, 46);\n    changer_car(t, n + 1, 101);\n    changer_car(t, n + 2, 110);\n    changer_car(t, n + 3, 116);\n    retour t;\n}\nfonction sauver_tas(nom, racine) {\n    // tout le tas dans le fichier « nom », et son en-tête (sommet, listes libres, racine, format) dans « nom.ent »\n    @3[14680063] = racine;\n    @3[14680255] = 64;\n    soit haut = tas_marque();\n    soit e = __nom_ent(nom);\n    soit r = sauver_bloc(e, 0xC000000000000000 + 14680056, 200);\n    si r == 18446744073709551615 {\n        retour r;\n    }\n    retour sauver_bloc(nom, 0xC000000000000000 + 8388608, haut - 8388608);\n}\nfonction charger_tas(nom) {\n    // rend la racine rangée par sauver_tas, ou 0 si le fichier n'existe pas\n    // l'en-tête est lu à part (dans la réserve du ramasse-miettes) : un fichier absent, ou d'un autre format, ne\n    // touche à rien et rend 0\n    soit e = __nom_ent(nom);\n    si charger_bloc(e, 0xC000000000000000 + 14400000, 200) != 200 || @3[14400199] != 64 {\n        retour 0;\n    }\n    pour i dans 0..200 {\n        @3[14680056 + i] = @3[14400000 + i];\n    }\n    charger_bloc(nom, 0xC000000000000000 + 8388608, @3[14680056] - 8388608);\n    retour @3[14680063];\n}\nfonction ecrire_texte(c, t) {\n    pour i dans 0..longueur(t) {\n        ecrire_car(c, car(t, i));\n    }\n}\nfonction ecrire_nombre(c, n) {\n    si n >= 10 {\n        ecrire_nombre(c, n / 10);\n    }\n    ecrire_car(c, 48 + n % 10);\n}\nfonction texte_neuf(n) {\n    soit t = __verifier(nouveau(n + 1));\n    @[t] = n;\n    retour t;\n}\nfonction __texte_tas(t): texte {\n    // un texte rangé dans le tas (champ, tableau, dictionnaire) : un texte écrit dans le programme (gardé avec le code, à\n    // l'étage 0) est recopié dans le tas, pour qu'une mémoire sauvée (sauver_tas) reste juste quand le programme change\n    si t == 0 || (t >> 62) != 0 {\n        retour t;\n    }\n    soit n = longueur(t);\n    soit r = texte_neuf(n);\n    pour i dans 0..n {\n        changer_car(r, i, car(t, i));\n    }\n    retour r;\n}\n// écrire un caractère : sur un canal (moins de 65536), ou au bout d'un texte du tas\nfonction __mettre(c, x) {\n    si c < 65536 {\n        ecrire_car(c, x);\n    } sinon {\n        soit n = @[c];\n        @[c + 1 + n] = x;\n        @[c] = n + 1;\n    }\n}\nfonction __mettre_nombre(c, n) {\n    si n >= 10 {\n        __mettre_nombre(c, n / 10);\n    }\n    __mettre(c, 48 + n % 10);\n}\nfonction ecrire_entier(c, n) {\n    si n .< 0 {\n        __mettre(c, 45);\n        n = 0 - n;\n    }\n    __mettre_nombre(c, n);\n}\nfonction ecrire_hexa(c, n) {\n    __mettre(c, 35);\n    __hexa16(c, n);\n}\nfonction __hexa16(c, n) {\n    pour i dans 0..16 {\n        soit k = (n >> (60 - 4 * i)) & 15;\n        si k < 10 { __mettre(c, 48 + k); } sinon { __mettre(c, 55 + k); }\n    }\n}\nfonction __ecrire_chiffres(c, q, d) {\n    si d > 1 {\n        __ecrire_chiffres(c, q / 10, d - 1);\n    }\n    __mettre(c, 48 + q % 10);\n}\n// ---- grands entiers (limbes de 16 bits, mot bas d'abord) pour l'écriture décimale exacte des flottants\nfonction __bn_neuf(v) {\n    soit t = tableau(0);\n    tantque v != 0 {\n        ajouter(t, v & 65535);\n        v = v >> 16;\n    }\n    retour t;\n}\nfonction __bn_copie(a) {\n    soit r = tableau(0);\n    pour i dans 0..longueur(a) { ajouter(r, a[i]); }\n    retour r;\n}\nfonction __bn_mul(a, m) {\n    soit c = 0;\n    pour i dans 0..longueur(a) {\n        soit p = a[i] * m + c;\n        a[i] = p & 65535;\n        c = p >> 16;\n    }\n    tantque c != 0 { ajouter(a, c & 65535); c = c >> 16; }\n}\nfonction __bn_mul10(a, n) {\n    tantque n >= 4 { __bn_mul(a, 10000); n = n - 4; }\n    tantque n > 0 { __bn_mul(a, 10); n = n - 1; }\n}\nfonction __bn_cmp(a, b) {\n    soit na = longueur(a);\n    soit nb = longueur(b);\n    si na != nb {\n        si na > nb { retour 1; }\n        retour 2;\n    }\n    soit i = na;\n    tantque i > 0 {\n        i = i - 1;\n        si a[i] != b[i] {\n            si a[i] > b[i] { retour 1; }\n            retour 2;\n        }\n    }\n    retour 0;\n}\nfonction __bn_ajouter(a, b) {\n    soit n = longueur(b);\n    si longueur(a) > n { n = longueur(a); }\n    soit c = 0;\n    pour i dans 0..n {\n        soit x = c;\n        soit na = longueur(a);\n        si i < na { x = x + a[i]; }\n        si i < longueur(b) { x = x + b[i]; }\n        si i < na { a[i] = x & 65535; } sinon { ajouter(a, x & 65535); }\n        c = x >> 16;\n    }\n    si c != 0 { ajouter(a, c); }\n}\nfonction __bn_sub(a, b) {\n    soit emprunt = 0;\n    pour i dans 0..longueur(a) {\n        soit y = emprunt;\n        si i < longueur(b) { y = y + b[i]; }\n        si a[i] >= y { a[i] = a[i] - y; emprunt = 0; } sinon { a[i] = a[i] + 65536 - y; emprunt = 1; }\n    }\n    tantque longueur(a) > 0 && a[longueur(a) - 1] == 0 { retirer(a); }\n}\nfonction __bn_decaler(a, k) {\n    si longueur(a) == 0 { retour; }\n    soit q = k >> 4;\n    soit b = k & 15;\n    si b != 0 {\n        soit c = 0;\n        pour i dans 0..longueur(a) {\n            soit x = (a[i] << b) | c;\n            a[i] = x & 65535;\n            c = x >> 16;\n        }\n        si c != 0 { ajouter(a, c); }\n    }\n    si q != 0 {\n        soit n = longueur(a);\n        pour i dans 0..q { ajouter(a, 0); }\n        soit j = n;\n        tantque j > 0 { j = j - 1; a[j + q] = a[j]; }\n        pour i dans 0..q { a[i] = 0; }\n    }\n}\nfonction __bn_bits(a) {\n    soit n = longueur(a);\n    si n == 0 { retour 0; }\n    soit h = a[n - 1];\n    soit b = 0;\n    tantque h != 0 { b = b + 1; h = h >> 1; }\n    retour 16 * (n - 1) + b;\n}\n// chiffres décimaux les plus courts qui redonnent le flottant f * 2^e (Burger et Dybvig) : le tableau rendu contient\n// k + 20000 (la valeur vaut 0,d1d2d3... fois 10^k) puis les chiffres ; bord vaut 1 si l'écart inférieur est la moitié,\n// 2 s'il est le quart (le bas d'une puissance de 4 d'un flottant quaternaire)\nfonction __dragon(f, e, bord) {\n    soit pair = 1;\n    si f[0] & 1 { pair = 0; }\n    soit r = __bn_copie(f);\n    soit s = __bn_neuf(1);\n    soit mp = __bn_neuf(1);\n    soit mm = __bn_neuf(1);\n    si e .>= 0 {\n        si bord == 0 {\n            __bn_decaler(r, e + 1);\n            s = __bn_neuf(2);\n            __bn_decaler(mp, e);\n            __bn_decaler(mm, e);\n        } sinon si bord == 1 {\n            __bn_decaler(r, e + 2);\n            s = __bn_neuf(4);\n            __bn_decaler(mp, e + 1);\n            __bn_decaler(mm, e);\n        } sinon {\n            __bn_decaler(r, e + 3);\n            s = __bn_neuf(8);\n            __bn_decaler(mp, e + 2);\n            __bn_decaler(mm, e);\n        }\n    } sinon {\n        soit n = 0 - e;\n        si bord == 0 {\n            __bn_decaler(r, 1);\n            __bn_decaler(s, n + 1);\n        } sinon si bord == 1 {\n            __bn_decaler(r, 2);\n            __bn_decaler(s, n + 2);\n            mp = __bn_neuf(2);\n        } sinon {\n            __bn_decaler(r, 3);\n            __bn_decaler(s, n + 3);\n            mp = __bn_neuf(4);\n        }\n    }\n    // estimation par défaut de l'exposant décimal : log10(2) = 0,30103 ; le reste est corrigé par la boucle\n    soit x = e + __bn_bits(f) - 1;\n    soit est = 0;\n    si x .>= 0 {\n        est = x * 30102 / 100000;\n        __bn_mul10(s, est);\n    } sinon {\n        soit m = 0 - x;\n        est = (m * 30104 + 99999) / 100000;\n        __bn_mul10(r, est);\n        __bn_mul10(mp, est);\n        __bn_mul10(mm, est);\n        est = 0 - est;\n    }\n    soit k = est;\n    soit encore = 1;\n    tantque encore == 1 {\n        soit t1 = __bn_copie(r);\n        __bn_ajouter(t1, mp);\n        soit c = __bn_cmp(t1, s);\n        si (pair == 1 && c != 2) || (pair == 0 && c == 1) {\n            __bn_mul(s, 10);\n            k = k + 1;\n        } sinon {\n            encore = 0;\n        }\n    }\n    __bn_mul(r, 10);\n    __bn_mul(mp, 10);\n    __bn_mul(mm, 10);\n    soit dig = tableau(0);\n    ajouter(dig, k + 20000);\n    soit fini = 0;\n    tantque fini == 0 {\n        soit d = 0;\n        tantque __bn_cmp(r, s) != 2 {\n            __bn_sub(r, s);\n            d = d + 1;\n        }\n        soit c1 = __bn_cmp(r, mm);\n        soit tc1 = 0;\n        si (pair == 1 && c1 != 1) || (pair == 0 && c1 == 2) { tc1 = 1; }\n        soit t = __bn_copie(r);\n        __bn_ajouter(t, mp);\n        soit c2 = __bn_cmp(t, s);\n        soit tc2 = 0;\n        si (pair == 1 && c2 != 2) || (pair == 0 && c2 == 1) { tc2 = 1; }\n        si tc1 == 0 && tc2 == 0 {\n            ajouter(dig, d);\n            __bn_mul(r, 10);\n            __bn_mul(mp, 10);\n            __bn_mul(mm, 10);\n        } sinon {\n            si tc1 == 1 && tc2 == 0 {\n                ajouter(dig, d);\n            } sinon si tc1 == 0 && tc2 == 1 {\n                ajouter(dig, d + 1);\n            } sinon {\n                __bn_mul(r, 2);\n                si __bn_cmp(r, s) == 2 { ajouter(dig, d); } sinon { ajouter(dig, d + 1); }\n            }\n            fini = 1;\n        }\n    }\n    retour dig;\n}\nfonction __ecrire_chiffres_dec(c, dig, de, a) {\n    pour i dans de..a { __mettre(c, 48 + dig[i]); }\n}\nfonction __bn_divpetit(a, m) {\n    soit r = 0;\n    soit i = longueur(a);\n    tantque i > 0 {\n        i = i - 1;\n        soit x = (r << 16) | a[i];\n        a[i] = x / m;\n        r = x % m;\n    }\n    tantque longueur(a) > 0 && a[longueur(a) - 1] == 0 { retirer(a); }\n    retour r;\n}\nfonction __bn_bit(a, i) {\n    si (i >> 4) >= longueur(a) { retour 0; }\n    retour (a[i >> 4] >> (i & 15)) & 1;\n}\nfonction __bn_bas_nul(a, n) {\n    soit q = n >> 4;\n    pour i dans 0..q {\n        si i < longueur(a) && a[i] != 0 { retour 0; }\n    }\n    si (n & 15) != 0 && q < longueur(a) {\n        si (a[q] & ((1 << (n & 15)) - 1)) != 0 { retour 0; }\n    }\n    retour 1;\n}\nfonction __bn_droite(a, n) {\n    soit q = n >> 4;\n    soit b = n & 15;\n    soit m = longueur(a);\n    pour i dans 0..m {\n        soit lo = 0;\n        si i + q < m { lo = a[i + q] >> b; }\n        soit hi = 0;\n        si b != 0 && i + q + 1 < m { hi = (a[i + q + 1] << (16 - b)) & 65535; }\n        a[i] = lo | hi;\n    }\n    tantque longueur(a) > 0 && a[longueur(a) - 1] == 0 { retirer(a); }\n}\n// f * 2^e écrit avec d décimales exactes (arrondi au plus proche, pair en cas d'égalité, comme printf)\nfonction __ecrire_fixe(c, f, e, d) {\n    soit x = __bn_copie(f);\n    __bn_mul10(x, d);\n    si e .>= 0 {\n        __bn_decaler(x, e);\n    } sinon {\n        soit n = 0 - e;\n        soit demi = __bn_bit(x, n - 1);\n        soit reste = 1 - __bn_bas_nul(x, n - 1);\n        soit impair = __bn_bit(x, n);\n        __bn_droite(x, n);\n        si demi == 1 && (reste == 1 || impair == 1) { __bn_ajouter(x, __bn_neuf(1)); }\n    }\n    soit dd = tableau(0);\n    tantque longueur(x) > 0 {\n        soit q = __bn_divpetit(x, 10000);\n        ajouter(dd, q % 10);\n        ajouter(dd, (q / 10) % 10);\n        ajouter(dd, (q / 100) % 10);\n        ajouter(dd, q / 1000);\n    }\n    tantque longueur(dd) > d + 1 && dd[longueur(dd) - 1] == 0 { retirer(dd); }\n    tantque longueur(dd) < d + 1 { ajouter(dd, 0); }\n    soit i = longueur(dd);\n    tantque i > d {\n        i = i - 1;\n        __mettre(c, 48 + dd[i]);\n    }\n    si d > 0 {\n        __mettre(c, 46);\n        tantque i > 0 {\n            i = i - 1;\n            __mettre(c, 48 + dd[i]);\n        }\n    }\n}\n// écrit les chiffres rendus par __dragon (en fixe de 10^-3 à 10^16, sinon avec un exposant)\nfonction __ecrire_dragon(c, dig) {\n    soit n = longueur(dig) - 1;\n    soit k = dig[0];\n    si k >= 19997 && k <= 20016 {\n        si k <= 20000 {\n            __mettre(c, 48); __mettre(c, 46);\n            pour i dans 0..(20000 - k) { __mettre(c, 48); }\n            __ecrire_chiffres_dec(c, dig, 1, n + 1);\n        } sinon {\n            soit ent = k - 20000;\n            pour i dans 0..ent {\n                si i < n { __mettre(c, 48 + dig[1 + i]); } sinon { __mettre(c, 48); }\n            }\n            __mettre(c, 46);\n            si n > ent { __ecrire_chiffres_dec(c, dig, 1 + ent, n + 1); } sinon { __mettre(c, 48); }\n        }\n    } sinon {\n        __mettre(c, 48 + dig[1]);\n        __mettre(c, 46);\n        si n > 1 { __ecrire_chiffres_dec(c, dig, 2, n + 1); } sinon { __mettre(c, 48); }\n        __mettre(c, 101);\n        si k < 20001 {\n            __mettre(c, 45);\n            __mettre_nombre(c, 20001 - k);\n        } sinon {\n            __mettre_nombre(c, k - 20001);\n        }\n    }\n}\nfonction __mettre_mot(c, a, b, d, e) {\n    __mettre(c, a); __mettre(c, b); __mettre(c, d);\n    si e != 0 { __mettre(c, e); }\n}\n// un flottant quaternaire écrit en décimal : st l'état (Belnap), ef l'exposant, m la mantisse de p bits, bi le biais,\n// emax l'exposant de l'infini ; d décimales, ou 18446744073709551615 pour les chiffres les plus courts qui redonnent\n// exactement le nombre\nfonction __ecrire_quat(c, st, ef, m, p, bi, emax, d) {\n    si st == 0 {\n        __mettre_mot(c, 105, 110, 99, 111); __mettre_mot(c, 110, 110, 117, 0);\n        retour;\n    }\n    si st == 3 {\n        __mettre_mot(c, 118, 97, 114, 105); __mettre_mot(c, 97, 98, 108, 101);\n        retour;\n    }\n    si st == 1 { __mettre(c, 45); }\n    si ef == emax {\n        __mettre_mot(c, 105, 110, 102, 0);\n        retour;\n    }\n    soit f = __bn_neuf(m);\n    soit e1 = ef;\n    si e1 == 0 { e1 = 1; }\n    soit e = 2 * (e1 - bi);\n    si d != 18446744073709551615 {\n        si d > 60 { d = 60; }\n        __ecrire_fixe(c, f, e, d);\n        retour;\n    }\n    si m == 0 {\n        __mettre_mot(c, 48, 46, 48, 0);\n        retour;\n    }\n    // au bas d'une puissance de 4, le voisin du dessous est quatre fois plus près\n    soit bord = 0;\n    si ef > 1 && m == (1 << (p - 2)) { bord = 2; }\n    __ecrire_dragon(c, __dragon(f, e, bord));\n}\nfonction ecrire_flottant(c, x: flottant, d) {\n    soit b = bits(x);\n    __ecrire_quat(c, b >> 62, (b >> 52) & 1023, b & 4503599627370495, 52, 537, 1023, d);\n}\nfonction ecrire_flottant_32(c, x: flottant_32, d) {\n    soit b = bits(x);\n    __ecrire_quat(c, (b >> 30) & 3, (b >> 22) & 255, b & 4194303, 22, 138, 255, d);\n}\nfonction ecrire_logique(c, l: logique) {\n    selon l {\n        vrai { __mettre_mot(c, 118, 114, 97, 105); }\n        faux { __mettre_mot(c, 102, 97, 117, 120); }\n        inconnu { __mettre_mot(c, 105, 110, 99, 111); __mettre_mot(c, 110, 110, 117, 0); }\n        variable { __mettre_mot(c, 118, 97, 114, 105); __mettre_mot(c, 97, 98, 108, 101); }\n    }\n}\n// ---- la frontière avec le binaire : Belnap reste le cœur de Vercintorix ; binaire() donne le code d'échange\n// 0 non, 1 oui, 2 inconnu, 3 variable (le bit fort dit « pas binaire ») ; quaternaire() fait le chemin inverse\nfonction binaire(l: logique) {\n    soit c = entier(l);\n    soit v = c >> 1;\n    retour ((((v ^ c) & 1) ^ 1) << 1) | v;\n}\nfonction quaternaire(b): logique {\n    soit lo = b & 1;\n    soit hi = (b >> 1) & 1;\n    retour comme_logique((lo << 1) | (1 - (hi ^ lo)));\n}\n// les mêmes sur les 32 logiques rangés dans un mot (un par quit)\nfonction binaire32(x) {\n    soit v = (x >> 1) & 6148914691236517205;\n    soit f = x & 6148914691236517205;\n    retour ((~(v ^ f) & 6148914691236517205) << 1) | v;\n}\nfonction quaternaire32(b) {\n    soit lo = b & 6148914691236517205;\n    soit hi = (b >> 1) & 6148914691236517205;\n    retour (lo << 1) | (~(hi ^ lo) & 6148914691236517205);\n}\nfonction afficher(x) {\n    ecrire_entier(1, x);\n    ecrire_car(1, 10);\n}\nfonction __signe32(x: entier_32) {\n    soit v = entier(x);\n    si v >= 2147483648 { retour v - 4294967296; }\n    retour v;\n}\nfonction __afficher_i(x: entier_32) {\n    ecrire_entier(1, __signe32(x));\n    ecrire_car(1, 10);\n}\nfonction __afficher_f(x: flottant) {\n    ecrire_flottant(1, x, 18446744073709551615);\n    ecrire_car(1, 10);\n}\nfonction __afficher_s(x: flottant_32) {\n    ecrire_flottant_32(1, x, 18446744073709551615);\n    ecrire_car(1, 10);\n}\nfonction __afficher_q(x: logique) {\n    ecrire_logique(1, x);\n    ecrire_car(1, 10);\n}\nfonction __afficher_t(t) {\n    ecrire_texte(1, t);\n    ecrire_car(1, 10);\n}\nfonction ecrire(x) {\n    ecrire_entier(1, x);\n}\nfonction __ecrire_i(x: entier_32) {\n    ecrire_entier(1, __signe32(x));\n}\nfonction __ecrire_f(x: flottant) {\n    ecrire_flottant(1, x, 18446744073709551615);\n}\nfonction __ecrire_s(x: flottant_32) {\n    ecrire_flottant_32(1, x, 18446744073709551615);\n}\nfonction __ecrire_q(x: logique) {\n    ecrire_logique(1, x);\n}\nfonction __ecrire_t(t) {\n    ecrire_texte(1, t);\n}\nfonction __texte_t(t): texte {\n    retour t;\n}\nfonction __texte_fin(t): texte {\n    // le dernier bloc du tas prend juste la place du texte écrit ; un bloc repris ailleurs garde sa taille\n    soit p = t & 16777215;\n    si p + (@3[p - 1] & 16777215) == @3[14680056] {\n        @3[p - 1] = 1 + longueur(t);\n        @3[14680056] = p + 1 + longueur(t);\n    }\n    retour t;\n}\nfonction texte(n): texte {\n    soit t = __verifier(nouveau(24));\n    ecrire_entier(t, n);\n    retour __texte_fin(t);\n}\nfonction __texte_i(x: entier_32): texte {\n    soit t = __verifier(nouveau(16));\n    ecrire_entier(t, __signe32(x));\n    retour __texte_fin(t);\n}\nfonction __texte_f(x: flottant): texte {\n    soit t = __verifier(nouveau(40));\n    ecrire_flottant(t, x, 18446744073709551615);\n    retour __texte_fin(t);\n}\nfonction __texte_s(x: flottant_32): texte {\n    soit t = __verifier(nouveau(32));\n    ecrire_flottant_32(t, x, 18446744073709551615);\n    retour __texte_fin(t);\n}\nfonction __texte_q(x: logique): texte {\n    soit t = __verifier(nouveau(12));\n    ecrire_logique(t, x);\n    retour __texte_fin(t);\n}\nfonction __texte_plus(a, b): texte {\n    soit na = longueur(a);\n    soit nb = longueur(b);\n    soit t = texte_neuf(na + nb);\n    pour i dans 0..na {\n        changer_car(t, i, car(a, i));\n    }\n    pour i dans 0..nb {\n        changer_car(t, na + i, car(b, i));\n    }\n    retour t;\n}\nfonction sous_texte(t, debut, fin): texte {\n    si fin > longueur(t) {\n        fin = longueur(t);\n    }\n    si debut >= fin {\n        retour texte_neuf(0);\n    }\n    soit r = texte_neuf(fin - debut);\n    pour i dans debut..fin {\n        changer_car(r, i - debut, car(t, i));\n    }\n    retour r;\n}\nfonction position(t, motif) {\n    soit n = longueur(t);\n    soit m = longueur(motif);\n    si m > n {\n        retour 18446744073709551615;\n    }\n    pour i dans 0..n - m + 1 {\n        soit k = 0;\n        tantque k < m && car(t, i + k) == car(motif, k) {\n            k = k + 1;\n        }\n        si k == m {\n            retour i;\n        }\n    }\n    retour 18446744073709551615;\n}\nfonction nombre(t) {\n    soit r = 0;\n    soit i = 0;\n    soit neg = 0;\n    si longueur(t) > 0 && car(t, 0) == 45 {\n        neg = 1;\n        i = 1;\n    }\n    tantque i < longueur(t) && car(t, i) >= 48 && car(t, i) <= 57 {\n        r = r * 10 + car(t, i) - 48;\n        i = i + 1;\n    }\n    si neg == 1 {\n        retour 0 - r;\n    }\n    retour r;\n}\n// ---- flottants quaternaires de 64 bits : état (2 bits), exposant (10 bits, biais 537, 1023 : l'infini), mantisse\n// (26 quits) ; valeur : mantisse × 4^(exposant − 537)\nfonction __f_inf(s): flottant {\n    si s == 1 { retour comme_flottant(0x7FF0000000000000); }\n    retour comme_flottant(0xBFF0000000000000);\n}\nfonction __f_variable(): flottant { retour comme_flottant(0xC000000000000000); }\n// le nombre de bits de v (0 pour 0)\nfonction __nbits(v) {\n    soit n = 0;\n    si v >= 4294967296 { n = 32; v = v >> 32; }\n    si v >= 65536 { n = n + 16; v = v >> 16; }\n    si v >= 256 { n = n + 8; v = v >> 8; }\n    si v >= 16 { n = n + 4; v = v >> 4; }\n    si v >= 4 { n = n + 2; v = v >> 2; }\n    si v >= 2 { retour n + 2; }\n    retour n + v;\n}\n// 2^n (n signé), exact\nfonction __p2(n): flottant {\n    si n .> 1021 { retour __f_inf(0); }\n    si n .< 0 - 1072 { retour 0.0; }\n    si n .< 0 - 1022 { retour comme_flottant(9223372036854775808 | (1 << (n + 1072))); }\n    soit r = n & 1;\n    soit q = (n - r) ./ 2;\n    retour comme_flottant(9223372036854775808 | ((q + 512) << 52) | (1 << (50 + r)));\n}\n// l'exposant binaire d'un flottant fini non nul : |x| = m × 2^e avec 1 <= m < 2 (rend -1100 pour zéro)\nfonction __f_ex2(x: flottant) {\n    soit b = bits(x);\n    soit m = b & 4503599627370495;\n    si m == 0 { retour 0 - 1100; }\n    soit e = (b >> 52) & 1023;\n    si e == 0 { e = 1; }\n    retour __nbits(m) - 1 + 2 * (e - 537);\n}\n// la mantisse ramenée entre 1 et 4, exac