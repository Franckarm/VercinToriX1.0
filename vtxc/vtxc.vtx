// vtxc : le compilateur de Vercintorix écrit en Vercintorix (noyau du langage).
// Il lit « source.vtx » et écrit « code.mots » : les mots du code machine du SPU, séparés par des virgules.
// Il produit le même code que vtx.py sans optimisation ni prélude, pour le noyau du langage :
// constantes, structures (champs typés), tableaux simples, fonctions (paramètres et retours entiers ou références),
// soit, affectation, si / sinon si / sinon, tantque, pour, retour, arrêter, continuer, @étage[adresse], @(étage)[adresse],
// champs, construction Structure { … }, nouveau_de, textes, caractères, opérateurs entiers, entrées et sorties,
// et le cœur quaternaire : la logique à quatre valeurs (logique, vrai, faux, inconnu, variable, et4, ou4, non4, anti,
// fusion, consensus, logique(), comme_logique(), selon), les quits (<<q, >>q, x.q(i), min4, max4, addm4, gdot, cmp3,
// qegal, nb_bits) et les comparaisons signées (.< .<= .> .>=, ./ .% .>> par le prélude).
// Comme vtx ne convertit jamais un entier en référence, toutes les listes sont chaînées et typées.

constante MASQUE = 16777215;

// --------------------------------------------------------------------------------------------- mémoire et tas
fonction lit(a) {
    retour @(a >> 24)[a & 16777215];
}

fonction ecrit(a, v) {
    @(a >> 24)[a & 16777215] = v;
}

fonction nouveau(n) {
    soit p = @3[14680056];
    si p == 0 {
        p = 8388608;
    }
    @3[14680056] = p + n;
    pour i dans 0..n {
        @3[p + i] = 0;
    }
    retour 50331648 + p;
}

// --------------------------------------------------------------------------------------------- textes
fonction longueur(t) {
    retour lit(t);
}

fonction car(t, i) {
    retour lit(t + 1 + i);
}

fonction texte_egal(a, b) {
    soit n = longueur(a);
    si n != longueur(b) {
        retour 0;
    }
    pour i dans 0..n {
        si car(a, i) != car(b, i) {
            retour 0;
        }
    }
    retour 1;
}

fonction ecrire_texte(c, t) {
    pour i dans 0..longueur(t) {
        ecrire_car(c, car(t, i));
    }
}

fonction ecrire_nombre(c, n) {
    si n >= 10 {
        ecrire_nombre(c, n / 10);
    }
    ecrire_car(c, 48 + n % 10);
}

// --------------------------------------------------------------------------------------------- listes d'entiers
structure Liste { n, cap, mem }

fonction liste(): Liste {
    retour Liste { cap: 64, mem: nouveau(64) };
}

fonction ajouter(l: Liste, x) {
    si l.n == l.cap {
        soit m = nouveau(l.cap * 2);
        pour i dans 0..l.n {
            ecrit(m + i, lit(l.mem + i));
        }
        l.mem = m;
        l.cap = l.cap * 2;
    }
    ecrit(l.mem + l.n, x);
    l.n = l.n + 1;
}

fonction elem(l: Liste, i) {
    retour lit(l.mem + i);
}

fonction poser(l: Liste, i, x) {
    ecrit(l.mem + i, x);
}

// Texte neuf fait des caractères debut..fin de la liste
fonction texte_de(l: Liste, debut, fin) {
    soit t = nouveau(fin - debut + 1);
    ecrit(t, fin - debut);
    pour i dans debut..fin {
        ecrit(t + 1 + i - debut, elem(l, i));
    }
    retour t;
}

// --------------------------------------------------------------------------------------------- structures du compilateur
// Jeton : genre 1 identifiant, 2 mot-clé, 3 nombre, 4 opérateur, 5 texte, 6 fin
structure Jeton { genre, val, texte, ligne, suivant: Jeton }

// Noeud de l'arbre : genre (voir les constantes plus bas), op (texte), val, nom (texte), enfants a, b, c,
// liste chaînée d'instructions ou d'arguments (premier), suivant dans une liste, ligne
// zet, zlo, zhi : la zone mémoire d'un accès à un tableau (étage + 1, début, fin) ; copie : boucle recopiée (partition)
structure Noeud { genre, op, val, nom, a: Noeud, b: Noeud, c: Noeud, premier: Noeud, deuxieme: Noeud, suivant: Noeud, ligne,
                  zet, zlo, zhi, copie }

structure Champ { nom, type, suivant: Champ }
structure Struct { nom, champs: Champ, nb, suivant: Struct }
structure Param { nom, type, suivant: Param }
// garde : la fonction est générée ; suite : file des fonctions demandées pendant la génération (élagage)
structure Fonction { nom, params: Param, nb, rtype, corps: Noeud, etiq, ligne, garde, suivant: Fonction, suite: Fonction,
                     er: Liste, ew: Liste, prelude }
structure Constante { nom, val, type, haut, suivant: Constante }
// sorte : 0 tableau d'entiers, 1 de quits, 2 de logiques (16 par mot), 3 de structures (st : son numéro)
structure Tableau { nom, etage, base, taille, sorte, st, suivant: Tableau }
structure Texte { val, etiq, suivant: Texte }
structure Donnee { etage, adr, vals: Liste, etiq, suivant: Donnee }
structure Var { nom, off, type, genre, haut, reg, score, suivant: Var }
structure Boucle { haut, fin, suivant: Boucle }
structure Cumul { nom, suivant: Cumul }

structure Ctx {
    src: Liste,
    jetons: Jeton,
    tok: Jeton,
    structs: Struct,
    fonctions: Fonction,
    der_fonction: Fonction,
    consts: Constante,
    tableaux: Tableau,
    textes: Texte,
    der_texte: Texte,
    ntextes,
    code: Liste,
    etiq: Liste,
    fix_pos: Liste,
    fix_etiq: Liste,
    fix_genre: Liste,
    vars: Var,
    boucles: Boucle,
    ffin,
    fcour: Fonction,
    nselon,
    nrangee,
    nvect,
    blocs: Donnee,
    der_bloc: Donnee,
    vus: Liste,
    segs: Liste,
    nlignes,
    en_prelude,
    optim,              // 1 : les optimisations de vtx.py
    partition,          // 1 : la partition des tâches en accords (plusieurs cœurs)
    naccords,
    copie_libre,
    marques: Liste,     // (adresse, genre 1 tâche / 2 fin, accord, mesure) pour la table des accords
    file_debut: Fonction,
    file_fin: Fonction,
    pile: Liste,        // contexte d'analyse : 1 boucle, 2 boucle en segments, 3 hypothèse
    nseg,
    nhyp,
    cumul_utilise,
    lex_genre,
    lex_val,
    lex_haut,
    lignes_dbg,         // 1 : écrire aussi la table adresse -> ligne du programme (pas à pas de l'atelier)
    niter,              // compteur des boucles « pour x dans t » (variables cachées __itN, __ikN)
    tabtextes: Liste,   // typer_textes : les variables qui contiennent un tableau de textes
    tabflot: Liste,     // typer_textes : les variables qui contiennent un tableau de flottants
    dbg: Liste,
    segs_prog: Liste,
    erreur
}

// genres des noeuds
constante N_NOMBRE = 1;
constante N_VAR = 2;
constante N_ETIQ = 3;
constante N_NON = 4;
constante N_NONLOG = 5;
constante N_BIN = 6;
constante N_LIRE = 7;
constante N_APPEL = 8;
constante N_CHAMP = 9;
constante N_CONSTRUIRE = 10;
constante N_NOUVEAU = 11;
constante N_SOIT = 20;
constante N_AFFECTER = 21;
constante N_ECRIRE = 22;
constante N_ECRIRE_CHAMP = 23;
constante N_SI = 24;
constante N_TANTQUE = 25;
constante N_POUR = 26;
constante N_RETOUR = 27;
constante N_ARRETER = 28;
constante N_CONTINUER = 29;
constante N_EXPR = 30;
constante N_BLIT = 12;       // vrai ou faux : val = code logique (2 ou 1) ; entier 1 ou 0 hors d'un contexte logique
constante N_QNOMBRE = 13;    // inconnu 0, faux 1, vrai 2, variable 3
constante N_QUIT = 14;       // x.q(i)
constante N_RLIRE = 15;      // t[i] d'un tableau de quits ou de logiques : nom du tableau, a = indice
constante N_RECRIRE = 31;
constante N_DONNEES = 32;
constante N_ANNULER = 33;
constante N_ACCORD = 35;     // val = numéro ; premier = les mesures
constante N_MESURE = 36;     // premier = les tâches
constante N_BLOC = 37;       // premier = des instructions
constante N_INFO = 40;       // boucle en segments : val = segments, ligne = numéro, premier = tableaux cumulés
constante CANAUX = 6;
constante ZONE_TOUT = 4;     // étage inconnu
constante ZONE_ES = 5;       // entrées et sorties
constante N_VALIDER = 34;
constante MAX_SEGMENTS = 18;
constante COPIES_DEBUT = 0xE00000;
constante COPIES_FIN = 0xF00000;    // la copie des blocs de données (fonction __init)
constante DRAPEAU = 16777215; // étage 3, dernière adresse : données déjà copiées    // t[i] = v : nom, a = indice, c = valeur, val = numéro des deux variables cachées

// types : 0 entier, 1..T_LOG-1 une référence à la structure de ce numéro, T_LOG le logique
constante T_LOG = 1000000;
constante T_F = 1000001;     // flottant (IEEE 754 binary32)
constante T_L = 1000002;     // long : 64 bits, mot bas dans R1, mot haut dans R4
constante T_T = 1000003;
constante T_TF = 1000004;    // flottant[] : la poignée d'un tableau de flottants ; redevient un entier (typer_textes)     // texte : l'adresse d'un bloc ; redevient un entier avant la génération (typer_textes)
constante N_FNOMBRE = 16;    // val = les bits du flottant
constante N_LNOMBRE = 17;    // val = mot bas, nom = mot haut
constante SIGNE = 2147483648;
constante BITS_V = 0xAAAAAAAA;
constante BITS_F = 0x55555555;

fonction est_struct(t) {
    retour t > 0 && t < T_LOG;
}

// « ligne N », ou « fichier, ligne N » pour une ligne venue d'un fichier importé
fonction ecrire_ligne(c: Ctx, ligne) {
    soit k = 0 - 1;
    si c.segs != nul {
        pour i dans 0..c.segs.n / 3 {
            si elem(c.segs, 3 * i) <= ligne {
                k = i;
            }
        }
    }
    si k == 0 - 1 || ligne == 0 {
        ecrire_texte(1, "ligne ");
        ecrire_nombre(1, ligne);
        retour;
    }
    soit fichier = elem(c.segs, 3 * k + 1);
    si fichier != 0 {
        ecrire_texte(1, fichier);
        ecrire_texte(1, ", ");
    }
    ecrire_texte(1, "ligne ");
    ecrire_nombre(1, elem(c.segs, 3 * k + 2) + ligne - elem(c.segs, 3 * k));
}

fonction erreur(c: Ctx, ligne, message) {
    si c.erreur == 0 {
        ecrire_texte(1, "erreur ");
        ecrire_ligne(c, ligne);
        ecrire_texte(1, " : ");
        ecrire_texte(1, message);
        ecrire_car(1, 10);
    }
    c.erreur = 1;
}

// Erreur qui nomme ce qui manque : « message : nom »
fonction erreur_nom(c: Ctx, ligne, message, nom) {
    si c.erreur == 0 {
        ecrire_texte(1, "erreur ");
        ecrire_ligne(c, ligne);
        ecrire_texte(1, " : ");
        ecrire_texte(1, message);
        ecrire_texte(1, " « ");
        ecrire_texte(1, nom);
        ecrire_texte(1, " »\n");
    }
    c.erreur = 1;
}

// --------------------------------------------------------------------------------------------- grands entiers
// Chiffres de 16 bits, poids faible d'abord : de quoi lire un flottant décimal exactement, comme Python
// (arrondi correct vers un double, puis du double vers binary32, au plus proche pair).
fonction big(n): Liste {
    soit l = liste();
    tantque n > 0 {
        ajouter(l, n & 65535);
        n = n >> 16;
    }
    retour l;
}

fonction big_norm(a: Liste) {
    tantque a.n > 0 && elem(a, a.n - 1) == 0 {
        a.n = a.n - 1;
    }
}

// a = a * k + d (k et d < 65536)
fonction big_mul_ajoute(a: Liste, k, d) {
    soit r = d;
    pour i dans 0..a.n {
        soit x = elem(a, i) * k + r;
        poser(a, i, x & 65535);
        r = x >> 16;
    }
    tantque r > 0 {
        ajouter(a, r & 65535);
        r = r >> 16;
    }
}

fonction big_bits(a: Liste) {
    big_norm(a);
    si a.n == 0 {
        retour 0;
    }
    soit h = elem(a, a.n - 1);
    soit b = 0;
    tantque h > 0 {
        b = b + 1;
        h = h >> 1;
    }
    retour (a.n - 1) * 16 + b;
}

fonction big_bit(a: Liste, i) {
    si (i >> 4) >= a.n {
        retour 0;
    }
    retour (elem(a, i >> 4) >> (i & 15)) & 1;
}

// -1, 0 ou 1
fonction big_cmp(a: Liste, b: Liste) {
    big_norm(a);
    big_norm(b);
    si a.n != b.n {
        si a.n < b.n { retour 0 - 1; }
        retour 1;
    }
    soit i = a.n;
    tantque i > 0 {
        i = i - 1;
        si elem(a, i) != elem(b, i) {
            si elem(a, i) < elem(b, i) { retour 0 - 1; }
            retour 1;
        }
    }
    retour 0;
}

// a = a - b (a >= b)
fonction big_sub(a: Liste, b: Liste) {
    soit emprunt = 0;
    pour i dans 0..a.n {
        soit y = emprunt;
        si i < b.n {
            y = y + elem(b, i);
        }
        soit x = elem(a, i);
        si x >= y {
            poser(a, i, x - y);
            emprunt = 0;
        } sinon {
            poser(a, i, x + 65536 - y);
            emprunt = 1;
        }
    }
    big_norm(a);
}

fonction big_shl(a: Liste, s): Liste {
    soit r = liste();
    pour i dans 0..(s >> 4) {
        ajouter(r, 0);
    }
    soit k = s & 15;
    soit retenue = 0;
    pour j dans 0..a.n {
        soit x = (elem(a, j) << k) | retenue;
        ajouter(r, x & 65535);
        retenue = x >> 16;
    }
    ajouter(r, retenue);
    big_norm(r);
    retour r;
}

fonction big_shr(a: Liste, s): Liste {
    soit r = liste();
    soit nb = big_bits(a);
    // bit par bit : les nombres sont petits
    pour k dans 0..(nb + 15) / 16 {
        ajouter(r, 0);
    }
    pour b dans s..nb {
        si big_bit(a, b) {
            soit p = b - s;
            poser(r, p >> 4, elem(r, p >> 4) | (1 << (p & 15)));
        }
    }
    big_norm(r);
    retour r;
}

// q = a / b (rendu), r = a % b (dans reste)
fonction big_divmod(a: Liste, b: Liste, reste: Liste): Liste {
    soit q = liste();
    pour k dans 0..a.n + 1 {
        ajouter(q, 0);
    }
    reste.n = 0;
    soit i = big_bits(a);
    tantque i > 0 {
        i = i - 1;
        big_mul_ajoute(reste, 2, big_bit(a, i));
        si big_cmp(reste, b) != 0 - 1 {
            big_sub(reste, b);
            poser(q, i >> 4, elem(q, i >> 4) | (1 << (i & 15)));
        }
    }
    big_norm(q);
    retour q;
}

fonction big_entier(a: Liste) {
    soit v = 0;
    soit i = a.n;
    si i > 2 {
        i = 2;
    }
    tantque i > 0 {
        i = i - 1;
        v = (v << 16) | elem(a, i);
    }
    retour v;
}

// Arrondi au plus proche pair de q / 2^d
fonction big_arrondi(q: Liste, d): Liste {
    si d == 0 {
        retour big_shr(q, 0);
    }
    soit m = big_shr(q, d);
    soit reste = big_shr(q, 0);
    big_sub(reste, big_shl(m, d));
    soit demi = big_shl(big(1), d - 1);
    soit k = big_cmp(reste, demi);
    si k == 1 || (k == 0 && big_bit(m, 0) == 1) {
        big_mul_ajoute(m, 1, 1);
    }
    retour m;
}

// Le flottant n × 10^k (k signé), en bits binary32 ; 2139095040 (l'infini) s'il est trop grand
fonction bits_flottant(n: Liste, k) {
    si big_bits(n) == 0 {
        retour 0;
    }
    soit ordre = k + (big_bits(n) * 30103) / 100000;     // à peu près log10 de la valeur
    si ordre .> 400 {
        retour 2139095040;
    }
    si ordre .< 0 - 400 {
        retour 0;
    }
    soit a = big_shr(n, 0);
    soit b = big(1);
    si k .>= 0 {
        pour i dans 0..k {
            big_mul_ajoute(a, 10, 0);
        }
    } sinon {
        pour j dans 0..(0 - k) {
            big_mul_ajoute(b, 10, 0);
        }
    }
    // q = a × 2^s / b, de 53 bits : la mantisse du double
    soit s = 52 - (big_bits(a) - big_bits(b));
    soit reste = liste();
    soit q = liste();
    soit encore = 1;
    tantque encore {
        si s .> 1074 {
            s = 1074;
        }
        si s .>= 0 {
            q = big_divmod(big_shl(a, s), b, reste);
        } sinon {
            q = big_divmod(a, big_shl(b, 0 - s), reste);
        }
        soit nb = big_bits(q);
        encore = 0;
        si nb > 53 {
            s = s - 1;
            encore = 1;
        } sinon si nb < 53 && s .< 1074 {
            s = s + 1;
            encore = 1;
        }
    }
    soit den = b;
    si s .< 0 {
        den = big_shl(b, 0 - s);
    }
    big_mul_ajoute(reste, 2, 0);
    soit k2 = big_cmp(reste, den);
    si k2 == 1 || (k2 == 0 && big_bit(q, 0) == 1) {
        big_mul_ajoute(q, 1, 1);
    }
    si big_bits(q) > 53 {
        q = big_shr(q, 1);
        s = s - 1;
    }
    soit e = 52 - s;                     // exposant du double
    si e .> 127 {
        retour 2139095040;               // trop grand pour binary32 (l'infini)
    }
    si e .>= 0 - 126 {
        soit m = big_entier(big_arrondi(q, 29));
        soit r = ((e + 126) << 23) + m;
        si r >= 2139095040 {
            retour 2139095040;
        }
        retour r;
    }
    retour big_entier(big_arrondi(q, s - 149));
}

// --------------------------------------------------------------------------------------------- analyse lexicale
fonction lettre(x) {
    retour (x >= 'a' && x <= 'z') || (x >= 'A' && x <= 'Z') || x == '_' || x >= 128;
}

fonction chiffre(x) {
    retour x >= '0' && x <= '9';
}

fonction valeur_hexa(x) {
    si chiffre(x) {
        retour x - '0';
    }
    si x >= 'a' && x <= 'f' {
        retour x - 'a' + 10;
    }
    si x >= 'A' && x <= 'F' {
        retour x - 'A' + 10;
    }
    retour 99;
}

fonction est_mot_cle(t) {
    retour texte_egal(t, "fonction") || texte_egal(t, "soit") || texte_egal(t, "si") || texte_egal(t, "sinon")
        || texte_egal(t, "tantque") || texte_egal(t, "retour") || texte_egal(t, "constante") || texte_egal(t, "pour")
        || texte_egal(t, "dans") || texte_egal(t, "donnees") || texte_egal(t, "arrêter") || texte_egal(t, "continuer")
        || texte_egal(t, "hypothèse") || texte_egal(t, "annuler") || texte_egal(t, "valider") || texte_egal(t, "selon");
}

fonction nouveau_jeton(c: Ctx, dernier: Jeton, genre, val, texte, ligne): Jeton {
    soit j = Jeton { genre: genre, val: val, texte: texte, ligne: ligne };
    si dernier == nul {
        c.jetons = j;
    } sinon {
        dernier.suivant = j;
    }
    retour j;
}

// Échappement après une barre oblique inverse : rend le caractère, ou 0 si inconnu
fonction echappe(x) {
    si x == 'n' { retour 10; }
    si x == 't' { retour 9; }
    si x == '0' { retour 0; }
    si x == '\\' || x == '\'' || x == '"' { retour x; }
    retour 4294967295;
}

// opérateurs, du plus long au plus court
fonction operateur(c: Ctx, i) {
    soit s = c.src;
    soit x = elem(s, i);
    soit y = 0;
    soit z = 0;
    si i + 1 < s.n { y = elem(s, i + 1); }
    si i + 2 < s.n { z = elem(s, i + 2); }
    si (x == '<' && y == '<' && z == 'q') || (x == '>' && y == '>' && z == 'q') || (x == '.' && y == '>' && z == '>')
        || (x == '.' && (y == '<' || y == '>') && z == '=') {
        retour 3;
    }
    si (x == '<' && y == '<') || (x == '>' && y == '>') || (x == '<' && y == '=') || (x == '>' && y == '=')
        || (x == '=' && y == '=') || (x == '!' && y == '=') || (x == '&' && y == '&') || (x == '|' && y == '|')
        || (x == '.' && (y == '<' || y == '>' || y == '/' || y == '%' || y == '.')) {
        retour 2;
    }
    si x == '-' || x == '+' || x == '*' || x == '/' || x == '%' || x == '&' || x == '|' || x == '^' || x == '~'
        || x == '<' || x == '>' || x == '=' || x == '@' || x == '[' || x == ']' || x == '(' || x == ')' || x == '{'
        || x == '}' || x == ';' || x == ',' || x == '.' || x == '!' || x == ':' {
        retour 1;
    }
    retour 0;
}

// Après « adn » en position i : "ACGT…" (1 à 16 lettres) ? Rend 1 et range sa valeur dans c.lex_val, sinon 0
fonction valeur_adn(c: Ctx, s: Liste, i) {
    si i >= s.n || elem(s, i) != '"' {
        retour 0;
    }
    soit v = 0;
    soit k = i + 1;
    tantque k < s.n && elem(s, k) != '"' {
        soit x = elem(s, k);
        si x >= 'a' && x <= 'z' {
            x = x - 32;
        }
        soit q = 0 - 1;
        si x == 'A' { q = 0; }
        si x == 'C' { q = 1; }
        si x == 'G' { q = 2; }
        si x == 'T' || x == 'U' { q = 3; }
        si q == 0 - 1 || k - i > 16 {
            retour 0;
        }
        v = v * 4 + q;
        k = k + 1;
    }
    si k >= s.n || k == i + 1 {
        retour 0;
    }
    c.lex_val = v;
    retour 1;
}

fonction alnum(x) {
    retour lettre(x) || chiffre(x);
}

fonction car_en(s: Liste, i) {
    si i < s.n {
        retour elem(s, i);
    }
    retour 0;
}

// Un nombre à la position i : entier (genre 3), flottant (genre 7 : val = bits), long (genre 8 : val = mot bas,
// haut = mot haut) ; rend la position qui suit. Mêmes formes que vtx.py : 0q…, 0x…L, 123L, 0x…, 1.5, 1.5e-3, 2e10, 42.
fonction nombre_lexical(c: Ctx, i, ligne) {
    soit s = c.src;
    c.lex_genre = 3;
    c.lex_haut = 0;
    soit x = elem(s, i);
    soit y = car_en(s, i + 1);
    si x == '0' && y == 'q' && ((car_en(s, i + 2) >= '0' && car_en(s, i + 2) <= '3') || car_en(s, i + 2) == '_') {
        soit v = 0;
        i = i + 2;
        tantque i < s.n && ((elem(s, i) >= '0' && elem(s, i) <= '3') || elem(s, i) == '_') {
            si elem(s, i) != '_' {
                si (v >> 30) != 0 {
                    erreur(c, ligne, "nombre trop grand pour 32 bits");
                }
                v = v * 4 + elem(s, i) - '0';
            }
            i = i + 1;
        }
        c.lex_val = v;
        retour i;
    }
    // chiffres (base 16 après 0x), en grand entier
    soit base = 10;
    soit d = i;
    si x == '0' && y == 'x' && valeur_hexa(car_en(s, i + 2)) < 16 {
        base = 16;
        d = i + 2;
    }
    soit n = liste();
    soit j = d;
    tantque j < s.n && ((base == 10 && chiffre(elem(s, j))) || (base == 16 && valeur_hexa(elem(s, j)) < 16)
        || elem(s, j) == '_') {
        si elem(s, j) != '_' {
            big_mul_ajoute(n, base, valeur_hexa(elem(s, j)));
        }
        j = j + 1;
    }
    // long : …L non suivi d'une lettre ou d'un chiffre
    si car_en(s, j) == 'L' && !alnum(car_en(s, j + 1)) {
        si big_bits(n) > 64 {
            erreur(c, ligne, "nombre trop grand pour 64 bits");
        }
        c.lex_genre = 8;
        c.lex_val = big_entier(n);
        c.lex_haut = big_entier(big_shr(n, 32));
        retour j + 1;
    }
    si base == 10 {
        soit frac = 0;
        soit flottant = 0;
        si car_en(s, j) == '.' && chiffre(car_en(s, j + 1)) {
            flottant = 1;
            j = j + 1;
            tantque j < s.n && (chiffre(elem(s, j)) || elem(s, j) == '_') {
                si elem(s, j) != '_' {
                    big_mul_ajoute(n, 10, elem(s, j) - '0');
                    frac = frac + 1;
                }
                j = j + 1;
            }
        }
        soit ex = 0;
        soit e1 = car_en(s, j);
        soit e2 = car_en(s, j + 1);
        si (e1 == 'e' || e1 == 'E') && (chiffre(e2) || ((e2 == '+' || e2 == '-') && chiffre(car_en(s, j + 2)))) {
            flottant = 1;
            j = j + 1;
            soit neg = 0;
            si elem(s, j) == '+' || elem(s, j) == '-' {
                neg = elem(s, j) == '-';
                j = j + 1;
            }
            tantque j < s.n && chiffre(elem(s, j)) {
                si ex < 100000 {
                    ex = ex * 10 + elem(s, j) - '0';
                }
                j = j + 1;
            }
            si neg {
                ex = 0 - ex;
            }
        }
        si flottant {
            soit b = bits_flottant(n, ex - frac);
            si (b & 2147483647) == 2139095040 {
                erreur(c, ligne, "nombre flottant trop grand");
            }
            c.lex_genre = 7;
            c.lex_val = b;
            retour j;
        }
    }
    si big_bits(n) > 32 {
        erreur(c, ligne, "nombre trop grand pour 32 bits");
    }
    c.lex_val = big_entier(n);
    retour j;
}

fonction lexer(c: Ctx) {
    soit s = c.src;
    soit i = 0;
    soit ligne = 1;
    soit dernier: Jeton = nul;
    tantque i < s.n && c.erreur == 0 {
        soit x = elem(s, i);
        si x == ' ' || x == 9 || x == 13 {
            i = i + 1;
        } sinon si x == 10 {
            ligne = ligne + 1;
            i = i + 1;
        } sinon si x == '/' && i + 1 < s.n && elem(s, i + 1) == '/' {
            tantque i < s.n && elem(s, i) != 10 {
                i = i + 1;
            }
        } sinon si lettre(x) {
            soit d = i;
            tantque i < s.n && (lettre(elem(s, i)) || chiffre(elem(s, i))) {
                i = i + 1;
            }
            soit t = texte_de(s, d, i);
            soit adn = 0;
            si texte_egal(t, "adn") {
                adn = valeur_adn(c, s, i);
            }
            si adn {
                // adn"ACGT" : A = 0, C = 1, G = 2, T = U = 3, la première lettre la plus forte
                tantque elem(s, i + 1) != '"' {
                    i = i + 1;
                }
                i = i + 2;
                dernier = nouveau_jeton(c, dernier, 3, c.lex_val, 0, ligne);
            } sinon si texte_egal(t, "et") {
                dernier = nouveau_jeton(c, dernier, 4, 0, "&&", ligne);
            } sinon si texte_egal(t, "ou") {
                dernier = nouveau_jeton(c, dernier, 4, 0, "||", ligne);
            } sinon si texte_egal(t, "non") {
                dernier = nouveau_jeton(c, dernier, 4, 0, "!", ligne);
            } sinon si texte_egal(t, "entree") {
                dernier = nouveau_jeton(c, dernier, 1, 0, "entrée", ligne);
            } sinon si texte_egal(t, "arreter") {
                dernier = nouveau_jeton(c, dernier, 2, 0, "arrêter", ligne);
            } sinon si texte_egal(t, "données") {
                dernier = nouveau_jeton(c, dernier, 2, 0, "donnees", ligne);
            } sinon si texte_egal(t, "hypothese") {
                dernier = nouveau_jeton(c, dernier, 2, 0, "hypothèse", ligne);
            } sinon si est_mot_cle(t) {
                dernier = nouveau_jeton(c, dernier, 2, 0, t, ligne);
            } sinon {
                dernier = nouveau_jeton(c, dernier, 1, 0, t, ligne);
            }
        } sinon si chiffre(x) {
            i = nombre_lexical(c, i, ligne);
            dernier = nouveau_jeton(c, dernier, c.lex_genre, c.lex_val, c.lex_haut, ligne);
        } sinon si x == '#' {
            soit d2 = i + 1;
            soit v2 = 0;
            i = i + 1;
            tantque i < s.n && valeur_hexa(elem(s, i)) < 16 {
                v2 = v2 * 16 + valeur_hexa(elem(s, i));
                i = i + 1;
            }
            si i - d2 == 6 {
                v2 = v2 << 8;
            }
            dernier = nouveau_jeton(c, dernier, 3, v2, 0, ligne);
        } sinon si x == '\'' {
            soit v3 = elem(s, i + 1);
            i = i + 2;
            si v3 == '\\' {
                v3 = echappe(elem(s, i));
                i = i + 1;
            }
            i = i + 1;
            dernier = nouveau_jeton(c, dernier, 3, v3, 0, ligne);
        } sinon si x == '"' {
            soit l = liste();
            i = i + 1;
            tantque i < s.n && elem(s, i) != '"' {
                soit y = elem(s, i);
                si y == '\\' {
                    i = i + 1;
                    y = echappe(elem(s, i));
                }
                ajouter(l, y);
                i = i + 1;
            }
            i = i + 1;
            dernier = nouveau_jeton(c, dernier, 5, 0, texte_de(l, 0, l.n), ligne);
        } sinon {
            soit n = operateur(c, i);
            si n == 0 {
                erreur(c, ligne, "caractère inattendu");
            }
            dernier = nouveau_jeton(c, dernier, 4, 0, texte_de(s, i, i + n), ligne);
            i = i + n;
        }
    }
    dernier = nouveau_jeton(c, dernier, 6, 0, 0, ligne);
}

// --------------------------------------------------------------------------------------------- analyse : outils
fonction est_op(c: Ctx, t) {
    retour c.tok.genre == 4 && texte_egal(c.tok.texte, t);
}

fonction est_kw(c: Ctx, t) {
    retour c.tok.genre == 2 && texte_egal(c.tok.texte, t);
}

fonction est_id(c: Ctx, t) {
    retour c.tok.genre == 1 && texte_egal(c.tok.texte, t);
}

fonction avancer(c: Ctx): Jeton {
    soit j = c.tok;
    si c.tok.genre != 6 {
        c.tok = c.tok.suivant;
    }
    retour j;
}

fonction attendre(c: Ctx, t) {
    si est_op(c, t) {
        avancer(c);
    } sinon {
        erreur_nom(c, c.tok.ligne, "symbole attendu :", t);
    }
}

fonction fin_possible(c: Ctx) {
    retour est_op(c, ";");
}

// Fin d'une instruction : « ; »
fonction fin_instr(c: Ctx) {
    attendre(c, ";");
}

fonction identifiant(c: Ctx) {
    si c.tok.genre != 1 {
        erreur(c, c.tok.ligne, "identifiant attendu");
        retour "?";
    }
    retour avancer(c).texte;
}

// le nom d'une variable ou d'un paramètre : ni un nom de la logique à quatre valeurs, ni celui d'une constante (chaque
// lecture rendrait sinon la constante, pas la variable)
fonction nom_variable(c: Ctx) {
    soit l = c.tok.ligne;
    soit v = identifiant(c);
    si code_logique(v) != 0 - 1 || texte_egal(v, "et4") || texte_egal(v, "ou4") || texte_egal(v, "non4")
            || texte_egal(v, "anti") || texte_egal(v, "fusion") || texte_egal(v, "consensus") || texte_egal(v, "logique")
            || texte_egal(v, "comme_logique") {
        erreur_nom(c, l, "nom réservé de la logique à quatre valeurs :", v);
    } sinon si constante_de(c, v) != nul || texte_egal(v, "nul") {
        erreur_nom(c, l, "une variable ne peut pas porter le nom d'une constante :", v);
    }
    retour v;
}

fonction struct_de(c: Ctx, nom): Struct {
    soit s = c.structs;
    tantque s != nul {
        si texte_egal(s.nom, nom) {
            retour s;
        }
        s = s.suivant;
    }
    retour nul;
}

// type : 0 entier, sinon le numéro de la structure (son rang + 1)
fonction numero_struct(c: Ctx, nom) {
    soit s = c.structs;
    soit k = 1;
    tantque s != nul {
        si texte_egal(s.nom, nom) {
            retour k;
        }
        s = s.suivant;
        k = k + 1;
    }
    retour 0;
}

fonction struct_numero(c: Ctx, k): Struct {
    soit s = c.structs;
    tantque k > 1 && s != nul {
        s = s.suivant;
        k = k - 1;
    }
    retour s;
}

fonction type_opt(c: Ctx) {
    si !est_op(c, ":") {
        retour 0;
    }
    avancer(c);
    soit nom = identifiant(c);
    si texte_egal(nom, "entier") {
        retour 0;
    }
    si texte_egal(nom, "flottant") {
        si est_op(c, "[") {
            // flottant[] : un tableau dynamique de flottants
            avancer(c);
            attendre(c, "]");
            retour T_TF;
        }
        retour T_F;
    }
    si texte_egal(nom, "long") {
        retour T_L;
    }
    si texte_egal(nom, "logique") {
        retour T_LOG;
    }
    si texte_egal(nom, "texte") {
        retour T_T;
    }
    soit k = numero_struct(c, nom);
    si k == 0 {
        erreur(c, c.tok.ligne, "type inconnu dans le noyau");
    }
    retour k;
}

fonction constante_de(c: Ctx, nom): Constante {
    soit k = c.consts;
    tantque k != nul {
        si texte_egal(k.nom, nom) {
            retour k;
        }
        k = k.suivant;
    }
    retour nul;
}

fonction tableau_de(c: Ctx, nom): Tableau {
    soit t = c.tableaux;
    tantque t != nul {
        si texte_egal(t.nom, nom) {
            retour t;
        }
        t = t.suivant;
    }
    retour nul;
}

fonction fonction_de(c: Ctx, nom): Fonction {
    soit f = c.fonctions;
    tantque f != nul {
        si texte_egal(f.nom, nom) {
            retour f;
        }
        f = f.suivant;
    }
    retour nul;
}

fonction etiquette_texte(c: Ctx, t) {
    soit x = c.textes;
    tantque x != nul {
        si texte_egal(x.val, t) {
            retour x.etiq;
        }
        x = x.suivant;
    }
    soit n = Texte { val: t, etiq: nouvelle_etiquette(c) };
    si c.der_texte == nul {
        c.textes = n;
    } sinon {
        c.der_texte.suivant = n;
    }
    c.der_texte = n;
    retour n.etiq;
}

fonction noeud(genre, ligne): Noeud {
    retour Noeud { genre: genre, ligne: ligne };
}

fonction bin(op, a: Noeud, b: Noeud, ligne): Noeud {
    retour Noeud { genre: N_BIN, op: op, a: a, b: b, ligne: ligne };
}

fonction nombre(v, ligne): Noeud {
    retour Noeud { genre: N_NOMBRE, val: v, ligne: ligne };
}

// --------------------------------------------------------------------------------------------- expressions
fonction niveau_op(c: Ctx, n) {
    si c.tok.genre != 4 {
        retour 0;
    }
    soit t = c.tok.texte;
    si n == 0 { retour texte_egal(t, "||"); }
    si n == 1 { retour texte_egal(t, "&&"); }
    si n == 2 {
        retour texte_egal(t, "==") || texte_egal(t, "!=") || texte_egal(t, "<") || texte_egal(t, "<=")
            || texte_egal(t, ">") || texte_egal(t, ">=") || texte_egal(t, ".<") || texte_egal(t, ".<=")
            || texte_egal(t, ".>") || texte_egal(t, ".>=");
    }
    si n == 3 { retour texte_egal(t, "|"); }
    si n == 4 { retour texte_egal(t, "^"); }
    si n == 5 { retour texte_egal(t, "&"); }
    si n == 6 {
        retour texte_egal(t, "<<") || texte_egal(t, ">>") || texte_egal(t, "<<q") || texte_egal(t, ">>q")
            || texte_egal(t, ".>>");
    }
    si n == 7 { retour texte_egal(t, "+") || texte_egal(t, "-"); }
    retour texte_egal(t, "*") || texte_egal(t, "/") || texte_egal(t, "%") || texte_egal(t, "./") || texte_egal(t, ".%");
}

// Opérateurs signés : comparaisons par XOR du bit de signe, division, reste et décalage par le prélude
fonction binaire(op, a: Noeud, b: Noeud, l): Noeud {
    si car(op, 0) != '.' {
        retour bin(op, a, b, l);
    }
    soit o = "";
    si texte_egal(op, ".<") { o = "<"; }
    si texte_egal(op, ".<=") { o = "<="; }
    si texte_egal(op, ".>") { o = ">"; }
    si texte_egal(op, ".>=") { o = ">="; }
    si longueur(o) != 0 {
        retour bin(o, bin("^", a, nombre(2147483648, l), l), bin("^", b, nombre(2147483648, l), l), l);
    }
    soit f = "asr";
    si texte_egal(op, "./") { f = "divs"; }
    si texte_egal(op, ".%") { f = "mods"; }
    a.suivant = b;
    retour Noeud { genre: N_APPEL, nom: f, premier: a, ligne: l };
}

fonction expr(c: Ctx, n): Noeud {
    si n == 9 {
        retour unaire(c);
    }
    soit g = expr(c, n + 1);
    tantque c.erreur == 0 && niveau_op(c, n) {
        soit j = avancer(c);
        g = binaire(j.texte, g, expr(c, n + 1), j.ligne);
    }
    retour g;
}

// La case i d'un tableau dynamique : la poignée (étage 3) contient la longueur, la capacité et l'adresse des données
fonction element_dyn(h: Noeud, i: Noeud, l): Noeud {
    soit d = Noeud { genre: N_LIRE, val: 3, b: bin("+", bin("&", h, nombre(16777215, l), l), nombre(2, l), l), ligne: l };
    retour Noeud { genre: N_LIRE, val: 3, b: bin("+", d, i, l), ligne: l };
}

fonction unaire(c: Ctx): Noeud {
    soit l = c.tok.ligne;
    si est_op(c, "~") {
        avancer(c);
        retour Noeud { genre: N_NON, a: unaire(c), ligne: l };
    }
    si est_op(c, "!") {
        avancer(c);
        retour Noeud { genre: N_NONLOG, a: unaire(c), ligne: l };
    }
    si est_op(c, "-") {
        avancer(c);
        retour bin("-", nombre(0, l), unaire(c), l);
    }
    soit e = primaire(c);
    tantque c.erreur == 0 && (est_op(c, ".") || est_op(c, "[")) {
        si est_op(c, "[") {
            // t[i] d'un tableau dynamique : la case i de son bloc de données
            avancer(c);
            soit i = expr(c, 0);
            attendre(c, "]");
            e = element_dyn(e, i, l);
            continuer;
        }
        avancer(c);
        soit nom = identifiant(c);
        si texte_egal(nom, "q") {
            attendre(c, "(");
            e = Noeud { genre: N_QUIT, a: e, b: expr(c, 0), ligne: l };
            attendre(c, ")");
        } sinon {
            e = Noeud { genre: N_CHAMP, a: e, nom: nom, ligne: l };
        }
    }
    retour e;
}

// @étage[adresse] ou @(expression)[adresse] : rend un noeud N_LIRE (val = étage, ou a = étage calculé)
fonction acces(c: Ctx): Noeud {
    soit l = c.tok.ligne;
    attendre(c, "@");
    soit e = noeud(N_LIRE, l);
    si est_op(c, "(") {
        avancer(c);
        e.a = expr(c, 0);
        attendre(c, ")");
    } sinon {
        soit j = avancer(c);
        si j.genre == 1 && constante_de(c, j.texte) != nul {
            e.val = constante_de(c, j.texte).val;
        } sinon si j.genre == 3 {
            e.val = j.val;
        } sinon {
            e.val = 99;
        }
        si e.val > 3 {
            erreur(c, l, "numéro d'étage attendu (0 à 3)");
        }
    }
    attendre(c, "[");
    e.b = expr(c, 0);
    attendre(c, "]");
    retour e;
}

fonction arguments(c: Ctx): Noeud {
    soit premier: Noeud = nul;
    soit dernier: Noeud = nul;
    tantque c.erreur == 0 && !est_op(c, ")") {
        soit a = expr(c, 0);
        si dernier == nul {
            premier = a;
        } sinon {
            dernier.suivant = a;
        }
        dernier = a;
        si est_op(c, ",") {
            avancer(c);
        }
    }
    attendre(c, ")");
    retour premier;
}

// Un appel de fonction quelque part dans e ?
fonction contient_appel(e: Noeud) {
    si e == nul {
        retour 0;
    }
    si e.genre == N_APPEL || e.genre == N_CONSTRUIRE || e.genre == N_NOUVEAU {
        retour 1;
    }
    si contient_appel(e.a) || contient_appel(e.b) || contient_appel(e.c) {
        retour 1;
    }
    soit x = e.premier;
    tantque x != nul {
        si contient_appel(x) || contient_appel(x.a) {
            retour 1;
        }
        x = x.suivant;
    }
    retour 0;
}

fonction indice(c: Ctx, t: Tableau, l): Noeud {
    attendre(c, "[");
    soit idx = expr(c, 0);
    attendre(c, "]");
    si idx.genre == N_NOMBRE && idx.val >= t.taille {
        erreur_nom(c, l, "indice hors du tableau", t.nom);
    }
    retour idx;
}

// [i] d'un tableau de quits ou de logiques : l'indice ne doit pas appeler de fonction (il est évalué deux fois)
fonction indice_rangee(c: Ctx, t: Tableau, l): Noeud {
    soit idx = indice(c, t, l);
    si contient_appel(idx) {
        erreur_nom(c, l, "l'indice ne doit pas appeler de fonction (rangez-le d'abord dans une variable) :", t.nom);
    }
    retour idx;
}

// Adresse de t[i] (tableau d'entiers) ou de t[i].champ (tableau de structures)
fonction case_tableau(c: Ctx, t: Tableau, l): Noeud {
    soit idx = indice(c, t, l);
    si t.sorte != 3 {
        si t.base == 0 {
            retour idx;
        }
        retour bin("+", nombre(t.base, l), idx, l);
    }
    attendre(c, ".");
    soit st = struct_numero(c, t.st);
    soit champ = identifiant(c);
    si champ_de(c, st, champ) == nul {
        erreur_nom(c, l, "champ inconnu :", champ);
    }
    soit pos = idx;
    si st.nb != 1 {
        pos = bin("*", idx, nombre(st.nb, l), l);
    }
    retour bin("+", nombre(t.base + position_champ(st, champ), l), pos, l);
}

fonction mots_tableau(c: Ctx, t: Tableau) {
    si t.sorte == 1 || t.sorte == 2 {
        retour (t.taille + 15) / 16;
    }
    si t.sorte == 3 {
        retour t.taille * struct_numero(c, t.st).nb;
    }
    retour t.taille;
}

fonction zoner(c: Ctx, n: Noeud, t: Tableau) {
    n.zet = t.etage + 1;
    n.zlo = t.base;
    n.zhi = t.base + mots_tableau(c, t);
}

fonction primaire(c: Ctx): Noeud {
    soit j = c.tok;
    soit l = j.ligne;
    si j.genre == 3 {
        avancer(c);
        retour nombre(j.val, l);
    }
    si j.genre == 7 {
        avancer(c);
        retour Noeud { genre: N_FNOMBRE, val: j.val, ligne: l };
    }
    si j.genre == 8 {
        avancer(c);
        retour Noeud { genre: N_LNOMBRE, val: j.val, nom: j.texte, ligne: l };
    }
    si j.genre == 5 {
        avancer(c);
        etiquette_texte(c, j.texte);
        retour Noeud { genre: N_ETIQ, nom: j.texte, ligne: l };
    }
    si est_op(c, "(") {
        avancer(c);
        soit e = expr(c, 0);
        attendre(c, ")");
        retour e;
    }
    si est_op(c, "@") {
        retour acces(c);
    }
    si est_op(c, "[") {
        // [a, b, c] : un tableau dynamique neuf, rempli
        avancer(c);
        soit premier_v: Noeud = nul;
        soit dernier_v: Noeud = nul;
        soit nv = 0;
        tantque c.erreur == 0 && !est_op(c, "]") {
            soit xv = expr(c, 0);
            si dernier_v == nul {
                premier_v = xv;
            } sinon {
                dernier_v.suivant = xv;
            }
            dernier_v = xv;
            nv = nv + 1;
            si est_op(c, ",") {
                avancer(c);
            }
        }
        attendre(c, "]");
        soit tlit = appel1("tableau", nombre(nv, l), l);
        soit klit = 0;
        soit vlit = premier_v;
        tantque vlit != nul {
            soit suite_v = vlit.suivant;
            soit kn = nombre(klit, l);
            tlit.suivant = kn;
            kn.suivant = vlit;
            vlit.suivant = nul;
            tlit = Noeud { genre: N_APPEL, nom: "__remplir", premier: tlit, ligne: l };
            klit = klit + 1;
            vlit = suite_v;
        }
        retour tlit;
    }
    si j.genre != 1 {
        erreur(c, l, "expression attendue");
        avancer(c);
        retour nombre(0, l);
    }
    avancer(c);
    soit v = j.texte;
    si texte_egal(v, "vrai") {
        retour Noeud { genre: N_BLIT, val: 2, ligne: l };
    }
    si texte_egal(v, "faux") {
        retour Noeud { genre: N_BLIT, val: 1, ligne: l };
    }
    si texte_egal(v, "inconnu") {
        retour Noeud { genre: N_QNOMBRE, val: 0, ligne: l };
    }
    si texte_egal(v, "variable") {
        retour Noeud { genre: N_QNOMBRE, val: 3, ligne: l };
    }
    si texte_egal(v, "nul") {
        retour nombre(0, l);
    }
    soit t = tableau_de(c, v);
    si t != nul && est_op(c, "[") {
        si t.sorte == 1 || t.sorte == 2 {
            retour Noeud { genre: N_RLIRE, nom: v, a: indice_rangee(c, t, l), ligne: l };
        }
        soit lu = noeud(N_LIRE, l);
        lu.val = t.etage;
        lu.b = case_tableau(c, t, l);
        lu.nom = t.nom;
        zoner(c, lu, t);
        retour lu;
    }
    soit st = struct_de(c, v);
    si st != nul && est_op(c, "{") {
        avancer(c);
        soit e2 = Noeud { genre: N_CONSTRUIRE, nom: v, ligne: l };
        soit dernier: Noeud = nul;
        tantque c.erreur == 0 && !est_op(c, "}") {
            soit lc = c.tok.ligne;
            soit champ = identifiant(c);
            attendre(c, ":");
            si champ_de(c, st, champ) == nul {
                erreur_nom(c, lc, "champ inconnu dans la construction :", champ);
            }
            soit q = e2.premier;
            tantque q != nul {
                si texte_egal(q.nom, champ) {
                    erreur_nom(c, lc, "champ donné deux fois :", champ);
                }
                q = q.suivant;
            }
            soit paire = Noeud { genre: 0, nom: champ, a: expr(c, 0), ligne: l };
            si dernier == nul {
                e2.premier = paire;
            } sinon {
                dernier.suivant = paire;
            }
            dernier = paire;
            si est_op(c, ",") {
                avancer(c);
            }
        }
        attendre(c, "}");
        retour e2;
    }
    si texte_egal(v, "nouveau_de") && est_op(c, "(") {
        avancer(c);
        soit nom = identifiant(c);
        attendre(c, ")");
        retour Noeud { genre: N_NOUVEAU, nom: nom, ligne: l };
    }
    si est_op(c, "(") {
        avancer(c);
        retour Noeud { genre: N_APPEL, nom: v, premier: arguments(c), ligne: l };
    }
    soit k = constante_de(c, v);
    si k != nul {
        si k.type == T_F {
            retour Noeud { genre: N_FNOMBRE, val: k.val, ligne: l };
        }
        si k.type == T_L {
            retour Noeud { genre: N_LNOMBRE, val: k.val, nom: k.haut, ligne: l };
        }
        retour nombre(k.val, l);
    }
    retour Noeud { genre: N_VAR, nom: v, ligne: l };
}

// --------------------------------------------------------------------------------------------- instructions
fonction bloc(c: Ctx): Noeud {
    attendre(c, "{");
    soit premier: Noeud = nul;
    soit dernier: Noeud = nul;
    tantque c.erreur == 0 && !est_op(c, "}") && c.tok.genre != 6 {
        soit s = instruction(c);
        si dernier == nul {
            premier = s;
        } sinon {
            dernier.suivant = s;
        }
        dernier = s;
        tantque dernier.suivant != nul {
            dernier = dernier.suivant;
        }
    }
    attendre(c, "}");
    retour premier;
}

// Nom d'une variable cachée : un préfixe suivi d'un numéro
fonction nom_selon(n) {
    retour nom_cache("__selon", n);
}

fonction nom_cache(p, n) {
    soit l = liste();
    pour i dans 0..longueur(p) {
        ajouter(l, car(p, i));
    }
    soit d = liste();
    tantque n > 0 || d.n == 0 {
        ajouter(d, '0' + n % 10);
        n = n / 10;
    }
    soit k = d.n;
    tantque k > 0 {
        k = k - 1;
        ajouter(l, elem(d, k));
    }
    retour texte_de(l, 0, l.n);
}

fonction code_logique(t) {
    si texte_egal(t, "inconnu") { retour 0; }
    si texte_egal(t, "faux") { retour 1; }
    si texte_egal(t, "vrai") { retour 2; }
    si texte_egal(t, "variable") { retour 3; }
    retour 0 - 1;
}

// Une branche de selon : codes logiques (bits 0 à 3 de val) et corps
structure Branche { codes, liste: Noeud, corps: Noeud, ligne, suivant: Branche }

// selon x { vrai { … } faux, inconnu { … } autre { … } } : la valeur est calculée une fois dans une variable cachée,
// puis rendue comme une suite de si / sinon si, exactement comme vtx.py
fonction analyse_selon(c: Ctx, l): Noeud {
    soit x = expr(c, 0);
    attendre(c, "{");
    soit branches: Branche = nul;
    soit autre: Noeud = nul;
    soit a_autre = 0;
    soit vus = 0;
    tantque c.erreur == 0 && !est_op(c, "}") {
        soit l2 = c.tok.ligne;
        si est_id(c, "autre") {
            avancer(c);
            si a_autre {
                erreur(c, l2, "« autre » apparaît deux fois");
            }
            a_autre = 1;
            autre = bloc(c);
        } sinon {
            soit premier: Noeud = nul;
            soit dernier: Noeud = nul;
            soit encore = 1;
            tantque encore && c.erreur == 0 {
                soit ln = c.tok.ligne;
                soit k = 0 - 1;
                si c.tok.genre == 1 {
                    k = code_logique(c.tok.texte);
                }
                si k == 0 - 1 {
                    erreur(c, ln, "branche de « selon » attendue : vrai, faux, inconnu, variable ou autre");
                } sinon si (vus >> k) & 1 {
                    erreur(c, ln, "cette valeur a déjà sa branche");
                }
                vus = vus | (1 << k);
                avancer(c);
                soit q = Noeud { genre: N_QNOMBRE, val: k, ligne: l2 };
                si dernier == nul {
                    premier = q;
                } sinon {
                    dernier.suivant = q;
                }
                dernier = q;
                encore = est_op(c, ",");
                si encore {
                    avancer(c);
                }
            }
            branches = Branche { liste: premier, corps: bloc(c), ligne: l2, suivant: branches };
        }
    }
    attendre(c, "}");
    c.nselon = c.nselon + 1;
    soit tmp = nom_selon(c.nselon);
    // les branches sont déjà dans l'ordre inverse : on construit la chaîne de la dernière à la première
    soit chaine: Noeud = autre;
    soit a_chaine = a_autre;     // un « autre » vide compte : vtx.py émet alors le saut vers la fin
    soit b = branches;
    tantque b != nul {
        soit cond: Noeud = nul;
        soit q2 = b.liste;
        tantque q2 != nul {
            soit suivant = q2.suivant;
            q2.suivant = nul;
            soit t = bin("==", Noeud { genre: N_VAR, nom: tmp, ligne: b.ligne }, q2, b.ligne);
            si cond == nul {
                cond = t;
            } sinon {
                cond = bin("||", cond, t, b.ligne);
            }
            q2 = suivant;
        }
        soit si_ = Noeud { genre: N_SI, a: cond, premier: b.corps, ligne: b.ligne };
        si a_chaine {
            si_.val = 1;
            si_.deuxieme = chaine;
        }
        chaine = si_;
        a_chaine = 1;
        b = b.suivant;
    }
    retour Noeud { genre: N_SOIT, nom: tmp, val: T_LOG, a: x, ligne: l, suivant: chaine };
}

fonction instruction(c: Ctx): Noeud {
    soit l = c.tok.ligne;
    si est_kw(c, "soit") {
        avancer(c);
        soit s = noeud(N_SOIT, l);
        s.nom = nom_variable(c);
        s.val = type_opt(c);
        attendre(c, "=");
        s.a = expr(c, 0);
        fin_instr(c);
        retour s;
    }
    si est_kw(c, "si") {
        avancer(c);
        soit s2 = noeud(N_SI, l);
        s2.a = expr(c, 0);
        s2.premier = bloc(c);
        si est_kw(c, "sinon") {
            avancer(c);
            s2.val = 1;
            si est_kw(c, "si") {
                s2.deuxieme = instruction(c);
            } sinon {
                s2.deuxieme = bloc(c);
            }
        }
        retour s2;
    }
    si est_kw(c, "selon") {
        avancer(c);
        retour analyse_selon(c, l);
    }
    si est_kw(c, "tantque") {
        avancer(c);
        soit s3 = noeud(N_TANTQUE, l);
        s3.a = expr(c, 0);
        ajouter(c.pile, 1);
        s3.premier = bloc(c);
        c.pile.n = c.pile.n - 1;
        retour s3;
    }
    si est_kw(c, "hypothèse") {
        avancer(c);
        pour k dans 0..c.pile.n {
            si elem(c.pile, k) == 2 {
                erreur(c, l, "pas d'hypothèse dans une boucle en segments");
            }
        }
        c.nhyp = c.nhyp + 1;
        soit nh = c.nhyp;
        ajouter(c.pile, 3);
        soit corps = bloc(c);
        c.pile.n = c.pile.n - 1;
        retour bloc_hypothese(c, nh, abaisser_liste(c, corps), l);
    }
    si est_kw(c, "annuler") || est_kw(c, "valider") {
        soit g = N_ANNULER;
        si est_kw(c, "valider") {
            g = N_VALIDER;
        }
        avancer(c);
        fin_instr(c);
        si c.pile.n == 0 || elem(c.pile, c.pile.n - 1) != 3 {
            erreur(c, l, "« annuler » ou « valider » doit être directement dans une hypothèse, hors de toute boucle");
        }
        retour noeud(g, l);
    }
    si est_kw(c, "pour") {
        avancer(c);
        soit s4 = noeud(N_POUR, l);
        s4.nom = nom_variable(c);
        soit annot = type_opt(c);
        si !est_kw(c, "dans") {
            erreur(c, l, "« dans » attendu");
        }
        avancer(c);
        s4.a = expr(c, 0);
        si !est_op(c, "..") {
            // pour x dans t { … } : chaque case d'un tableau dynamique, dans l'ordre
            c.niter = c.niter + 1;
            soit tt = nom_cache("__it", c.niter);
            soit kk = nom_cache("__ik", c.niter);
            soit st0 = Noeud { genre: N_SOIT, nom: tt, a: s4.a, ligne: l };
            si annot != 0 && annot != T_T && annot != T_F {
                erreur(c, l, "la variable d'une boucle « pour … dans » est un entier, un flottant ou un texte");
            }
            soit el = element_dyn(var_n(tt, l), var_n(kk, l), l);
            si annot == T_F {
                el = appel1_de("comme_flottant", el, l);
            }
            soit x = Noeud { genre: N_SOIT, nom: s4.nom, val: annot, op: "chaque", a: el, ligne: l };
            s4.nom = kk;
            s4.a = nombre(0, l);
            s4.b = appel1("longueur", var_n(tt, l), l);
            s4.val = 1;
            ajouter(c.pile, 1);
            x.suivant = bloc(c);
            c.pile.n = c.pile.n - 1;
            s4.premier = x;
            st0.suivant = s4;
            retour st0;
        }
        si annot != 0 {
            erreur(c, l, "une boucle entre deux bornes compte en entiers : pas de type ici");
        }
        attendre(c, "..");
        s4.b = expr(c, 0);
        s4.val = 1;
        si est_id(c, "par") {
            avancer(c);
            s4.val = valeur_constante(c, expr(c, 0));
            si s4.val < 1 || s4.val > 2147483647 {
                erreur(c, l, "pas de boucle invalide");
            }
        }
        soit nseg = 0;
        si est_id(c, "en") {
            avancer(c);
            nseg = 12;
            si c.tok.genre == 3 {
                nseg = avancer(c).val;
            }
            si !est_id(c, "segments") {
                erreur(c, c.tok.ligne, "« segments » attendu après « en »");
            }
            avancer(c);
            si nseg < 2 || nseg > MAX_SEGMENTS {
                erreur(c, l, "nombre de segments entre 2 et 18");
            }
            si s4.val != 1 {
                erreur(c, l, "une boucle en segments avance de 1 en 1");
            }
            nseg = ((nseg + CANAUX - 1) / CANAUX) * CANAUX;   // multiple du nombre de cylindres
        }
        soit cumul: Cumul = nul;
        si nseg != 0 && est_id(c, "cumulant") {
            avancer(c);
            soit encore = 1;
            tantque encore && c.erreur == 0 {
                soit ln = c.tok.ligne;
                soit tn = tableau_de(c, c.tok.texte);
                si c.tok.genre != 1 || tn == nul {
                    erreur(c, ln, "nom de tableau attendu après « cumulant »");
                } sinon si tn.sorte == 1 || tn.sorte == 2 {
                    erreur(c, ln, "un tableau de quits ou de logiques ne peut pas être cumulé");
                }
                soit nc = Cumul { nom: avancer(c).texte };
                si cumul == nul {
                    cumul = nc;
                } sinon {
                    soit dc = cumul;
                    tantque dc.suivant != nul {
                        dc = dc.suivant;
                    }
                    dc.suivant = nc;
                }
                encore = est_op(c, ",");
                si encore {
                    avancer(c);
                }
            }
        }
        si nseg != 0 {
            ajouter(c.pile, 2);
        } sinon {
            ajouter(c.pile, 1);
        }
        s4.premier = bloc(c);
        c.pile.n = c.pile.n - 1;
        si nseg == 0 {
            retour s4;
        }
        // sans optimisation, une boucle en segments est une boucle ordinaire entre deux bornes calculées une fois
        verifier_segment(c, s4.nom, s4.premier);
        si cumul != nul {
            verifier_cumul(c, s4.premier, cumul);
            c.cumul_utilise = 1;
        }
        c.nseg = c.nseg + 1;
        soit sa = nom_cache("__sa", c.nseg);
        soit sb = nom_cache("__sb", c.nseg);
        soit p1 = Noeud { genre: N_SOIT, nom: sa, a: s4.a, ligne: l };
        soit p2 = Noeud { genre: N_SOIT, nom: sb, a: s4.b, ligne: l };
        s4.a = var_n(sa, l);
        s4.b = var_n(sb, l);
        s4.op = "segments";          // pas de réécriture en 16 : vtx.py ne réécrit pas une boucle en segments
        soit info = Noeud { genre: N_INFO, val: nseg, ligne: c.nseg };
        soit dcu: Noeud = nul;
        soit cu = cumul;
        tantque cu != nul {
            soit vn = var_n(cu.nom, l);
            si dcu == nul {
                info.premier = vn;
            } sinon {
                dcu.suivant = vn;
            }
            dcu = vn;
            cu = cu.suivant;
        }
        s4.c = info;
        p1.suivant = p2;
        p2.suivant = s4;
        retour p1;
    }
    si est_kw(c, "retour") {
        pour kr dans 0..c.pile.n {
            si elem(c.pile, kr) == 3 {
                erreur(c, l, "« retour » interdit dans une hypothèse : validez ou annulez d'abord");
            }
        }
        avancer(c);
        soit s5 = noeud(N_RETOUR, l);
        si !fin_possible(c) {
            s5.a = expr(c, 0);
        }
        fin_instr(c);
        retour s5;
    }
    si est_kw(c, "arrêter") || est_kw(c, "continuer") {
        soit ga = N_ARRETER;
        si est_kw(c, "continuer") {
            ga = N_CONTINUER;
        }
        avancer(c);
        fin_instr(c);
        si c.pile.n > 0 && elem(c.pile, c.pile.n - 1) == 3 {
            erreur(c, l, "« arrêter » ou « continuer » ne peut pas sortir d'une hypothèse : utilisez annuler ou valider");
        }
        retour noeud(ga, l);
    }
    si est_id(c, "tableau") && c.tok.suivant.genre == 1 && c.tok.suivant.suivant.genre == 4
        && texte_egal(c.tok.suivant.suivant.texte, "[") {
        // tableau t[n]; dans une fonction : un tableau dynamique de n cases (sur le tas)
        avancer(c);
        soit st = noeud(N_SOIT, l);
        st.nom = nom_variable(c);
        attendre(c, "[");
        st.a = appel1("tableau", expr(c, 0), l);
        attendre(c, "]");
        fin_instr(c);
        retour st;
    }
    si est_op(c, "@") {
        soit m = acces(c);
        attendre(c, "=");
        soit s6 = Noeud { genre: N_ECRIRE, val: m.val, a: m.a, b: m.b, ligne: l };
        s6.c = expr(c, 0);
        fin_instr(c);
        retour s6;
    }
    si c.tok.genre == 1 && tableau_de(c, c.tok.texte) != nul && c.tok.suivant.genre == 4
        && texte_egal(c.tok.suivant.texte, "[") {
        soit t = tableau_de(c, avancer(c).texte);
        si t.sorte == 1 || t.sorte == 2 {
            soit r = Noeud { genre: N_RECRIRE, nom: t.nom, a: indice_rangee(c, t, l), ligne: l };
            c.nrangee = c.nrangee + 1;
            r.val = c.nrangee;
            attendre(c, "=");
            r.c = expr(c, 0);
            fin_instr(c);
            retour r;
        }
        soit s7 = Noeud { genre: N_ECRIRE, val: t.etage, nom: t.nom, ligne: l };
        zoner(c, s7, t);
        s7.b = case_tableau(c, t, l);
        attendre(c, "=");
        s7.c = expr(c, 0);
        fin_instr(c);
        retour s7;
    }
    si c.tok.genre == 1 && c.tok.suivant.genre == 4 && texte_egal(c.tok.suivant.texte, "=") {
        soit s8 = noeud(N_AFFECTER, l);
        s8.nom = avancer(c).texte;
        avancer(c);
        s8.a = expr(c, 0);
        fin_instr(c);
        retour s8;
    }
    soit e = expr(c, 0);
    si est_op(c, "=") {
        avancer(c);
        si e.genre == N_LIRE {
            soit sl = Noeud { genre: N_ECRIRE, val: e.val, a: e.a, b: e.b, ligne: l };
            sl.c = expr(c, 0);
            fin_instr(c);
            retour sl;
        }
        si e.genre != N_CHAMP {
            erreur(c, l, "affectation impossible");
        }
        soit s9 = Noeud { genre: N_ECRIRE_CHAMP, a: e.a, nom: e.nom, ligne: l };
        s9.c = expr(c, 0);
        fin_instr(c);
        retour s9;
    }
    fin_instr(c);
    retour Noeud { genre: N_EXPR, a: e, ligne: l };
}

// --------------------------------------------------------------------------------------------- 16 éléments d'un coup
// Réécrit « pour i dans a..b { T[i] = … ; } » sur des tableaux de quits ou de logiques quand chaque élément ne dépend
// que des éléments de même indice, par des opérations quit par quit : les mots entiers sont traités 16 éléments d'un
// coup ; le début et la fin, qui ne remplissent pas un mot, restent traités un par un. Même règle que vtx.py.

// Une réduction : « n = n + E » (genre 1, somme) ou « si E1 == E2 { n = n + 1; } » (genre 2 ; 3 pour !=)
structure Reduction { nom, genre, e1: Noeud, e2: Noeud, suivant: Reduction }

fonction meme_var(e: Noeud, nom) {
    retour e != nul && e.genre == N_VAR && texte_egal(e.nom, nom);
}

fonction var_n(nom, l): Noeud {
    retour Noeud { genre: N_VAR, nom: nom, ligne: l };
}

fonction appel1(nom, a: Noeud, l): Noeud {
    retour Noeud { genre: N_APPEL, nom: nom, premier: a, ligne: l };
}

fonction reduction(s: Noeud): Reduction {
    si s.genre == N_AFFECTER && s.a.genre == N_BIN && texte_egal(s.a.op, "+") && meme_var(s.a.a, s.nom) {
        retour Reduction { nom: s.nom, genre: 1, e1: s.a.b };
    }
    si s.genre == N_SI && s.val == 0 && s.a.genre == N_BIN && (texte_egal(s.a.op, "==") || texte_egal(s.a.op, "!="))
        && s.premier != nul && s.premier.suivant == nul {
        soit x = s.premier;
        si x.genre == N_AFFECTER && x.a.genre == N_BIN && texte_egal(x.a.op, "+") && meme_var(x.a.a, x.nom)
            && x.a.b.genre == N_NOMBRE && x.a.b.val == 1 {
            soit g = 2;
            si texte_egal(s.a.op, "!=") {
                g = 3;
            }
            retour Reduction { nom: x.nom, genre: g, e1: s.a.a, e2: s.a.b };
        }
    }
    retour nul;
}

// Le noeud e (ou ses enfants, ou ses listes) lit-il la variable nom ?
fonction lit_var(e: Noeud, nom) {
    si e == nul {
        retour 0;
    }
    si meme_var(e, nom) || lit_var(e.a, nom) || lit_var(e.b, nom) || lit_var(e.c, nom) {
        retour 1;
    }
    retour lit_liste(e.premier, nom) || lit_liste(e.deuxieme, nom);
}

fonction lit_liste(x: Noeud, nom) {
    tantque x != nul {
        si lit_var(x, nom) {
            retour 1;
        }
        x = x.suivant;
    }
    retour 0;
}

// Sortes des tableaux rangés lus dans e : bit 1 quits, bit 2 logiques
fonction sortes_lues(c: Ctx, e: Noeud) {
    si e == nul {
        retour 0;
    }
    soit m = sortes_lues(c, e.a) | sortes_lues(c, e.b) | sortes_lues(c, e.c) | sortes_liste(c, e.premier)
        | sortes_liste(c, e.deuxieme);
    si e.genre == N_RLIRE {
        m = m | (1 << tableau_de(c, e.nom).sorte);
    }
    retour m;
}

fonction sortes_liste(c: Ctx, x: Noeud) {
    soit m = 0;
    tantque x != nul {
        m = m | sortes_lues(c, x);
        x = x.suivant;
    }
    retour m;
}

fonction quit_par_quit(nom, sorte) {
    si sorte == 2 {
        retour op_logique(nom) != 0;
    }
    retour texte_egal(nom, "min4") || texte_egal(nom, "max4") || texte_egal(nom, "addm4") || texte_egal(nom, "cmp3")
        || texte_egal(nom, "qegal");
}

// La valeur d'un élément ne tient-elle que dans son quit (les 15 autres à 0) ?
fonction propre(e: Noeud) {
    soit g = e.genre;
    si g == N_RLIRE || g == N_QNOMBRE || g == N_BLIT {
        retour 1;
    }
    si g == N_NOMBRE {
        retour e.val <= 3;
    }
    si g == N_APPEL {
        si texte_egal(e.nom, "comme_logique") {
            retour 1;
        }
        si texte_egal(e.nom, "cmp3") || texte_egal(e.nom, "qegal") {
            retour 0;
        }
        soit x = e.premier;
        tantque x != nul {
            si !propre(x) {
                retour 0;
            }
            x = x.suivant;
        }
        retour 1;
    }
    si g == N_BIN {
        retour propre(e.a) && propre(e.b);
    }
    retour 0;
}

// Le même calcul sur 16 éléments à la fois, ou nul si un élément pourrait dépendre d'un autre
fonction mot_vectoriel(c: Ctx, e: Noeud, var, sorte, vk): Noeud {
    soit g = e.genre;
    soit l = e.ligne;
    si g == N_RLIRE {
        soit t = tableau_de(c, e.nom);
        si !meme_var(e.a, var) || t.sorte != sorte {
            retour nul;
        }
        soit k = var_n(vk, l);
        si t.base != 0 {
            k = bin("+", nombre(t.base, l), k, l);
        }
        retour Noeud { genre: N_LIRE, val: t.etage, b: k, ligne: l, zet: t.etage + 1, zlo: t.base,
                       zhi: t.base + (t.taille + 15) / 16 };
    }
    si sorte == 2 && (g == N_QNOMBRE || g == N_BLIT) {
        retour nombre(e.val * 1431655765, l);
    }
    si sorte == 1 && g == N_NOMBRE {
        retour nombre((e.val & 3) * 1431655765, l);
    }
    si g == N_APPEL {
        soit a = e.premier;
        si (texte_egal(e.nom, "comme_logique") || texte_egal(e.nom, "entier")) && a != nul && a.suivant == nul {
            retour mot_vectoriel(c, a, var, sorte, vk);
        }
        si quit_par_quit(e.nom, sorte) {
            soit premier: Noeud = nul;
            soit dernier: Noeud = nul;
            tantque a != nul {
                soit w = mot_vectoriel(c, a, var, sorte, vk);
                si w == nul {
                    retour nul;
                }
                si dernier == nul {
                    premier = w;
                } sinon {
                    dernier.suivant = w;
                }
                dernier = w;
                a = a.suivant;
            }
            retour Noeud { genre: N_APPEL, nom: e.nom, premier: premier, ligne: e.ligne };
        }
        retour nul;
    }
    si sorte == 1 && g == N_BIN && (texte_egal(e.op, "&") || texte_egal(e.op, "|") || texte_egal(e.op, "^")) {
        soit wa = mot_vectoriel(c, e.a, var, sorte, vk);
        soit wb = mot_vectoriel(c, e.b, var, sorte, vk);
        si wa == nul || wb == nul {
            retour nul;
        }
        retour bin(e.op, wa, wb, l);
    }
    retour nul;
}

// Copie profonde d'une liste d'instructions (la boucle de fin a son propre corps, comme dans vtx.py)
fonction copier(n: Noeud): Noeud {
    si n == nul {
        retour nul;
    }
    retour Noeud { genre: n.genre, op: n.op, val: n.val, nom: n.nom, a: copier(n.a), b: copier(n.b), c: copier(n.c),
                   premier: copier_liste(n.premier), deuxieme: copier_liste(n.deuxieme), ligne: n.ligne,
                   zet: n.zet, zlo: n.zlo, zhi: n.zhi, copie: n.copie };
}

fonction copier_liste(x: Noeud): Noeud {
    soit premier: Noeud = nul;
    soit dernier: Noeud = nul;
    tantque x != nul {
        soit y = copier(x);
        si dernier == nul {
            premier = y;
        } sinon {
            dernier.suivant = y;
        }
        dernier = y;
        x = x.suivant;
    }
    retour premier;
}

// Les écritures de tableaux rangés d'une copie reçoivent leurs propres variables cachées
fonction renumeroter(c: Ctx, x: Noeud): Noeud {
    soit y = x;
    tantque y != nul {
        si y.genre == N_RECRIRE {
            c.nrangee = c.nrangee + 1;
            y.val = c.nrangee;
        }
        renumeroter(c, y.premier);
        renumeroter(c, y.deuxieme);
        y = y.suivant;
    }
    retour x;
}

fonction un_bit(m) {
    retour m == 2 || m == 4;
}

fonction boucle_vectorielle(c: Ctx, st: Noeud): Noeud {
    soit corps = st.premier;
    si corps == nul {
        retour nul;
    }
    soit var = st.nom;
    soit l = st.ligne;
    soit reds: Reduction = nul;
    soit der: Reduction = nul;
    soit sortes = 0;
    soit s = corps;
    tantque s != nul {
        si s.genre == N_RECRIRE && meme_var(s.a, var) {
            sortes = sortes | (1 << tableau_de(c, s.nom).sorte);
        } sinon {
            soit r = reduction(s);
            si r == nul || texte_egal(r.nom, var) {
                retour nul;
            }
            si der == nul {
                reds = r;
            } sinon {
                der.suivant = r;
            }
            der = r;
        }
        s = s.suivant;
    }
    // accumulateurs distincts, et lus seulement par leur propre mise à jour
    soit r1 = reds;
    tantque r1 != nul {
        soit r2 = r1.suivant;
        tantque r2 != nul {
            si texte_egal(r1.nom, r2.nom) {
                retour nul;
            }
            r2 = r2.suivant;
        }
        r1 = r1.suivant;
    }
    s = corps;
    tantque s != nul {
        soit propre_r: Reduction = nul;
        si s.genre != N_RECRIRE {
            propre_r = reduction(s);
        }
        r1 = reds;
        tantque r1 != nul {
            si lit_var(s, r1.nom) && !(propre_r != nul && texte_egal(propre_r.nom, r1.nom)) {
                retour nul;
            }
            r1 = r1.suivant;
        }
        s = s.suivant;
    }
    sortes = sortes | sortes_liste(c, corps);
    si !un_bit(sortes) {
        retour nul;
    }
    soit sorte = 1;
    si sortes == 4 {
        sorte = 2;
    }
    soit n = c.nvect + 1;
    soit vk = nom_cache("__vk", n);
    // les écritures de mots
    soit mots: Noeud = nul;
    soit dm: Noeud = nul;
    s = corps;
    tantque s != nul {
        si s.genre == N_RECRIRE && meme_var(s.a, var) {
            soit w = mot_vectoriel(c, s.c, var, sorte, vk);
            si w == nul {
                retour nul;
            }
            soit t = tableau_de(c, s.nom);
            soit k = var_n(vk, s.ligne);
            si t.base != 0 {
                k = bin("+", nombre(t.base, s.ligne), k, s.ligne);
            }
            soit e = Noeud { genre: N_ECRIRE, val: t.etage, b: k, c: w, ligne: s.ligne, zet: t.etage + 1, zlo: t.base,
                             zhi: t.base + (t.taille + 15) / 16 };
            si dm == nul {
                mots = e;
            } sinon {
                dm.suivant = e;
            }
            dm = e;
        }
        s = s.suivant;
    }
    // les réductions : 16 éléments comptés d'un coup
    r1 = reds;
    tantque r1 != nul {
        soit w1 = mot_vectoriel(c, r1.e1, var, sorte, vk);
        soit w2: Noeud = nul;
        soit lu = sortes_lues(c, r1.e1);
        soit pr = propre(r1.e1);
        si r1.genre != 1 {
            w2 = mot_vectoriel(c, r1.e2, var, sorte, vk);
            lu = lu | sortes_lues(c, r1.e2);
            pr = pr && propre(r1.e2);
            si w2 == nul {
                retour nul;
            }
        }
        si w1 == nul || lu == 0 || !pr {
            retour nul;
        }
        soit compte: Noeud = nul;
        si r1.genre == 1 {
            si sorte != 1 {
                retour nul;
            }
            compte = bin("+", appel1("nb_bits", bin("&", w1, nombre(1431655765, l), l), l),
                bin("*", nombre(2, l), appel1("nb_bits", bin("&", w1, nombre(2863311530, l), l), l), l), l);
        } sinon {
            w1.suivant = w2;
            compte = appel1("nb_bits", appel1("qegal", w1, l), l);
            si r1.genre == 3 {
                compte = bin("-", nombre(16, l), compte, l);
            }
        }
        soit maj = Noeud { genre: N_AFFECTER, nom: r1.nom, a: bin("+", var_n(r1.nom, l), compte, l), ligne: l };
        si dm == nul {
            mots = maj;
        } sinon {
            dm.suivant = maj;
        }
        dm = maj;
        r1 = r1.suivant;
    }
    c.nvect = n;
    soit va = nom_cache("__va", n);
    soit vb = nom_cache("__vb", n);
    soit vh = nom_cache("__vh", n);
    soit vt = nom_cache("__vt", n);
    soit quinze = Noeud { genre: N_NON, a: nombre(15, l), ligne: l };
    soit s1 = Noeud { genre: N_SOIT, nom: va, a: st.a, ligne: l };
    soit s2 = Noeud { genre: N_SOIT, nom: vb, a: st.b, ligne: l };
    soit s3 = Noeud { genre: N_SOIT, nom: vh, a: bin("&", bin("+", var_n(va, l), nombre(15, l), l), quinze, l), ligne: l };
    soit s4 = Noeud { genre: N_SI, a: bin(">", var_n(vh, l), var_n(vb, l), l),
                      premier: Noeud { genre: N_AFFECTER, nom: vh, a: var_n(vb, l), ligne: l }, ligne: l };
    soit s5 = Noeud { genre: N_SOIT, nom: vt, a: bin("&", var_n(vb, l), Noeud { genre: N_NON, a: nombre(15, l), ligne: l }, l), ligne: l };
    soit s6 = Noeud { genre: N_SI, a: bin("<", var_n(vt, l), var_n(vh, l), l),
                      premier: Noeud { genre: N_AFFECTER, nom: vt, a: var_n(vh, l), ligne: l }, ligne: l };
    soit s7 = Noeud { genre: N_POUR, nom: var, a: var_n(va, l), b: var_n(vh, l), premier: corps, val: 1, ligne: l };
    soit s8 = Noeud { genre: N_POUR, nom: vk, a: bin(">>", var_n(vh, l), nombre(4, l), l),
                      b: bin(">>", var_n(vt, l), nombre(4, l), l), premier: mots, val: 1, ligne: l };
    soit s9 = Noeud { genre: N_POUR, nom: var, a: var_n(vt, l), b: var_n(vb, l), premier: renumeroter(c, copier_liste(corps)), val: 1, ligne: l };
    s1.suivant = s2;
    s2.suivant = s3;
    s3.suivant = s4;
    s4.suivant = s5;
    s5.suivant = s6;
    s6.suivant = s7;
    s7.suivant = s8;
    s8.suivant = s9;
    retour s1;
}

fonction vectoriser(c: Ctx, s: Noeud): Noeud {
    soit tete: Noeud = nul;
    soit dernier: Noeud = nul;
    tantque s != nul {
        soit suivant = s.suivant;
        soit r: Noeud = nul;
        si s.genre == N_POUR && s.val == 1 && s.op == 0 {
            r = boucle_vectorielle(c, s);
        }
        si r == nul {
            r = s;
            si s.genre == N_POUR || s.genre == N_TANTQUE || s.genre == N_SI {
                s.premier = vectoriser(c, s.premier);
            }
            si s.genre == N_SI {
                s.deuxieme = vectoriser(c, s.deuxieme);
            }
            s.suivant = nul;
        }
        si dernier == nul {
            tete = r;
        } sinon {
            dernier.suivant = r;
        }
        dernier = r;
        tantque dernier.suivant != nul {
            dernier = dernier.suivant;
        }
        s = suivant;
    }
    retour tete;
}

// --------------------------------------------------------------------------------------------- segments
// Un segment doit être indépendant des autres : il ne modifie aucune variable déclarée hors de la boucle, ni sa variable
// de boucle, et n'en sort pas (arrêter au premier niveau, retour).
fonction declarees(s: Noeud, l: Liste) {
    tantque s != nul {
        si s.genre == N_SOIT || s.genre == N_POUR {
            ajouter(l, s.nom);
        }
        si s.genre == N_POUR || s.genre == N_TANTQUE || s.genre == N_SI {
            declarees(s.premier, l);
        }
        si s.genre == N_SI && s.val == 1 {
            declarees(s.deuxieme, l);
        }
        s = s.suivant;
    }
}

fonction dans_liste(l: Liste, t) {
    pour i dans 0..l.n {
        si texte_egal(elem(l, i), t) {
            retour 1;
        }
    }
    retour 0;
}

fonction verifier_seg(c: Ctx, s: Noeud, var, internes: Liste, profondeur) {
    tantque s != nul {
        si s.genre == N_AFFECTER && (!dans_liste(internes, s.nom) || texte_egal(s.nom, var)) {
            erreur_nom(c, s.ligne, "un segment ne peut pas modifier une variable déclarée hors de la boucle (chaque segment doit être indépendant : écrivez plutôt dans un tableau, à la case de l'indice) :", s.nom);
        }
        si s.genre == N_ARRETER && profondeur == 0 {
            erreur(c, s.ligne, "« arrêter » ne peut pas sortir d'une boucle en segments");
        }
        si s.genre == N_RETOUR {
            erreur(c, s.ligne, "« retour » interdit dans une boucle en segments");
        }
        si s.genre == N_SI {
            verifier_seg(c, s.premier, var, internes, profondeur);
            si s.val == 1 {
                verifier_seg(c, s.deuxieme, var, internes, profondeur);
            }
        } sinon si s.genre == N_TANTQUE || s.genre == N_POUR {
            verifier_seg(c, s.premier, var, internes, profondeur + 1);
        }
        s = s.suivant;
    }
}

fonction verifier_segment(c: Ctx, var, corps: Noeud) {
    soit internes = liste();
    declarees(corps, internes);
    soit garde = liste();
    pour i dans 0..internes.n {
        si !texte_egal(elem(internes, i), var) {
            ajouter(garde, elem(internes, i));
        }
    }
    verifier_seg(c, corps, var, garde, 0);
}

// Deux expressions identiques (sans les numéros de ligne) ?
fonction meme_expr(a: Noeud, b: Noeud) {
    si a == nul || b == nul {
        retour a == b;
    }
    si a.genre != b.genre || a.val != b.val {
        retour 0;
    }
    si (a.op != 0) != (b.op != 0) || (a.op != 0 && !texte_egal(a.op, b.op)) {
        retour 0;
    }
    si a.genre != N_LNOMBRE && ((a.nom != 0) != (b.nom != 0) || (a.nom != 0 && !texte_egal(a.nom, b.nom))) {
        retour 0;
    }
    si a.genre == N_LNOMBRE && a.nom != b.nom {
        retour 0;
    }
    si !meme_expr(a.a, b.a) || !meme_expr(a.b, b.b) || !meme_expr(a.c, b.c) {
        retour 0;
    }
    soit x = a.premier;
    soit y = b.premier;
    tantque x != nul && y != nul {
        si !meme_expr(x, y) {
            retour 0;
        }
        x = x.suivant;
        y = y.suivant;
    }
    retour x == nul && y == nul;
}

fonction est_cumule(cumul: Cumul, nom) {
    si nom == 0 {
        retour 0;
    }
    soit k = cumul;
    tantque k != nul {
        si texte_egal(k.nom, nom) {
            retour 1;
        }
        k = k.suivant;
    }
    retour 0;
}

fonction lit_cumule(e: Noeud, cumul: Cumul) {
    retour e != nul && e.genre == N_LIRE && est_cumule(cumul, e.nom);
}

// Aucune lecture d'un tableau cumulé dans e
fonction interdit_cumul(c: Ctx, e: Noeud, cumul: Cumul, ligne) {
    si e == nul {
        retour;
    }
    si lit_cumule(e, cumul) {
        erreur_nom(c, ligne, "un tableau cumulé ne peut être lu que dans « T[x] = T[x] + valeur » :", e.nom);
        retour;
    }
    interdit_cumul(c, e.a, cumul, ligne);
    interdit_cumul(c, e.b, cumul, ligne);
    interdit_cumul(c, e.c, cumul, ligne);
    soit x = e.premier;
    tantque x != nul {
        interdit_cumul(c, x, cumul, ligne);
        interdit_cumul(c, x.a, cumul, ligne);
        x = x.suivant;
    }
}

// Chaque tableau cumulé ne sert qu'à des additions T[e] = T[e] + v (ou - v), v sans tableau cumulé
fonction verifier_cumul(c: Ctx, s: Noeud, cumul: Cumul) {
    tantque s != nul && c.erreur == 0 {
        si s.genre == N_ECRIRE && est_cumule(cumul, s.nom) {
            soit v = s.c;
            soit bon = 0;
            si v.genre == N_BIN && (texte_egal(v.op, "+") || texte_egal(v.op, "-")) {
                si lit_cumule(v.a, cumul) && texte_egal(v.a.nom, s.nom) && meme_expr(v.a.b, s.b) {
                    interdit_cumul(c, v.b, cumul, s.ligne);
                    bon = 1;
                } sinon si texte_egal(v.op, "+") && lit_cumule(v.b, cumul) && texte_egal(v.b.nom, s.nom) && meme_expr(v.b.b, s.b) {
                    interdit_cumul(c, v.a, cumul, s.ligne);
                    bon = 1;
                }
            }
            si !bon {
                erreur_nom(c, s.ligne, "un tableau cumulé ne s'écrit que sous la forme « T[x] = T[x] + valeur » (ou « - valeur ») :", s.nom);
            }
            interdit_cumul(c, s.b, cumul, s.ligne);
        } sinon si s.genre == N_SI {
            interdit_cumul(c, s.a, cumul, s.ligne);
            verifier_cumul(c, s.premier, cumul);
            si s.val == 1 {
                verifier_cumul(c, s.deuxieme, cumul);
            }
        } sinon si s.genre == N_TANTQUE {
            interdit_cumul(c, s.a, cumul, s.ligne);
            verifier_cumul(c, s.premier, cumul);
        } sinon si s.genre == N_POUR {
            interdit_cumul(c, s.a, cumul, s.ligne);
            interdit_cumul(c, s.b, cumul, s.ligne);
            verifier_cumul(c, s.premier, cumul);
        } sinon {
            interdit_cumul(c, s.a, cumul, s.ligne);
            interdit_cumul(c, s.b, cumul, s.ligne);
            interdit_cumul(c, s.c, cumul, s.ligne);
            soit x = s.premier;
            tantque x != nul {
                interdit_cumul(c, x, cumul, s.ligne);
                x = x.suivant;
            }
        }
        s = s.suivant;
    }
}

// --------------------------------------------------------------------------------------------- hypothèses
// Les accès aux tableaux de quits et de logiques traduits tout de suite en accès aux mots (comme vtx.py avant de
// journaliser les écritures d'une hypothèse)
fonction abaisser_expr(c: Ctx, e: Noeud): Noeud {
    si e == nul {
        retour nul;
    }
    e.a = abaisser_expr(c, e.a);
    e.b = abaisser_expr(c, e.b);
    e.c = abaisser_expr(c, e.c);
    soit premier: Noeud = nul;
    soit dernier: Noeud = nul;
    soit x = e.premier;
    tantque x != nul {
        soit suivant = x.suivant;
        soit y = abaisser_expr(c, x);
        y.suivant = nul;
        si dernier == nul {
            premier = y;
        } sinon {
            dernier.suivant = y;
        }
        dernier = y;
        x = suivant;
    }
    e.premier = premier;
    si e.genre == N_RLIRE {
        retour rangee_basse(c, e);
    }
    retour e;
}

fonction abaisser_liste(c: Ctx, s: Noeud): Noeud {
    soit tete: Noeud = nul;
    soit dernier: Noeud = nul;
    tantque s != nul {
        soit suivant = s.suivant;
        soit r = s;
        s.suivant = nul;
        si s.genre == N_RECRIRE {
            // soit __qi = i ; soit __qv = v ; mot = (mot & ~(3 << d)) | ((__qv & 3) << d)
            soit t = tableau_de(c, s.nom);
            soit l = s.ligne;
            c.nrangee = c.nrangee + 1;
            soit ni = nom_cache("__qi", c.nrangee);
            soit nv = nom_cache("__qv", c.nrangee);
            soit v = abaisser_expr(c, s.c);
            si t.sorte == 2 {
                v = Noeud { genre: N_APPEL, nom: "__code_logique", premier: v, ligne: l };
            }
            soit s1 = Noeud { genre: N_SOIT, nom: ni, a: abaisser_expr(c, s.a), ligne: l };
            soit s2 = Noeud { genre: N_SOIT, nom: nv, a: v, ligne: l };
            soit m = mot_rangee(t, var_n(ni, l), l);
            soit d = decalage_rangee(var_n(ni, l), l);
            soit garde = bin("&", m, Noeud { genre: N_NON, a: bin("<<", nombre(3, l), d, l), ligne: l }, l);
            soit neuf = bin("|", garde, bin("<<", bin("&", var_n(nv, l), nombre(3, l), l), d, l), l);
            s1.suivant = s2;
            s2.suivant = Noeud { genre: N_ECRIRE, val: t.etage, b: m.b, c: neuf, ligne: l, zet: m.zet, zlo: m.zlo, zhi: m.zhi };
            r = s1;
        } sinon {
            s.a = abaisser_expr(c, s.a);
            s.b = abaisser_expr(c, s.b);
            s.c = abaisser_expr(c, s.c);
            si s.genre == N_SI || s.genre == N_TANTQUE || s.genre == N_POUR {
                s.premier = abaisser_liste(c, s.premier);
                s.deuxieme = abaisser_liste(c, s.deuxieme);
            } sinon {
                s.premier = abaisser_expr_liste(c, s.premier);
            }
        }
        si dernier == nul {
            tete = r;
        } sinon {
            dernier.suivant = r;
        }
        dernier = r;
        tantque dernier.suivant != nul {
            dernier = dernier.suivant;
        }
        s = suivant;
    }
    retour tete;
}

fonction abaisser_expr_liste(c: Ctx, x: Noeud): Noeud {
    soit premier: Noeud = nul;
    soit dernier: Noeud = nul;
    tantque x != nul {
        soit suivant = x.suivant;
        soit y = abaisser_expr(c, x);
        y.suivant = nul;
        si dernier == nul {
            premier = y;
        } sinon {
            dernier.suivant = y;
        }
        dernier = y;
        x = suivant;
    }
    retour premier;
}

fonction appel_hyp(nom, a: Noeud, l): Noeud {
    retour Noeud { genre: N_EXPR, a: Noeud { genre: N_APPEL, nom: nom, premier: a, ligne: l }, ligne: l };
}

// Les écritures mémoire d'une hypothèse sont notées (étage, adresse, ancienne valeur) avant d'être faites
fonction journaliser(c: Ctx, s: Noeud, n, cpt: Liste): Noeud {
    soit tete: Noeud = nul;
    soit dernier: Noeud = nul;
    tantque s != nul {
        soit suivant = s.suivant;
        s.suivant = nul;
        soit r = s;
        soit l = s.ligne;
        si s.genre == N_ECRIRE {
            si s.a == nul && s.val == 0 {
                erreur(c, l, "écriture dans l'étage 0 interdite dans une hypothèse");
            }
            poser(cpt, 0, elem(cpt, 0) + 1);
            soit ta = nom_cache2(n, elem(cpt, 0));
            soit s1 = Noeud { genre: N_SOIT, nom: ta, a: s.b, ligne: l };
            s.zet = 0;
            s.nom = 0;
            s.b = var_n(ta, l);
            si s.a == nul {
                s1.suivant = appel_hyp("__hyp_noter", nombre(s.val, l), l);
                s1.suivant.a.premier.suivant = var_n(ta, l);
                s1.suivant.suivant = s;
            } sinon {
                poser(cpt, 0, elem(cpt, 0) + 1);
                soit te = nom_cache2(n, elem(cpt, 0));
                soit s2 = Noeud { genre: N_SOIT, nom: te, a: s.a, ligne: l };
                s1.suivant = s2;
                s2.suivant = appel_hyp("__hyp_noter", var_n(te, l), l);
                s2.suivant.a.premier.suivant = var_n(ta, l);
                s2.suivant.suivant = s;
                s.a = var_n(te, l);
            }
            r = s1;
        } sinon si s.genre == N_ANNULER {
            r = appel_hyp("__hyp_annuler", var_n(nom_cache("__h", n), l), l);
            r.suivant = noeud(N_ARRETER, l);
        } sinon si s.genre == N_VALIDER {
            r = appel_hyp("__hyp_valider", nul, l);
            r.suivant = noeud(N_ARRETER, l);
        } sinon si (s.genre == N_SI || s.genre == N_TANTQUE || s.genre == N_POUR) && s.op == 0 {
            s.premier = journaliser(c, s.premier, n, cpt);
            si s.genre == N_SI && s.val == 1 {
                s.deuxieme = journaliser(c, s.deuxieme, n, cpt);
            }
        }
        si dernier == nul {
            tete = r;
        } sinon {
            dernier.suivant = r;
        }
        dernier = r;
        tantque dernier.suivant != nul {
            dernier = dernier.suivant;
        }
        s = suivant;
    }
    retour tete;
}

fonction nom_cache2(n, k) {
    soit l = liste();
    ajouter_texte(l, nom_cache("__t", n));
    ajouter(l, '_');
    soit d = liste();
    tantque k > 0 || d.n == 0 {
        ajouter(d, '0' + k % 10);
        k = k / 10;
    }
    soit i = d.n;
    tantque i > 0 {
        i = i - 1;
        ajouter(l, elem(d, i));
    }
    retour texte_de(l, 0, l.n);
}

// Bloc d'hypothèse -> boucle à un tour : annuler défait les écritures notées, valider (ou la fin du bloc) les garde
fonction bloc_hypothese(c: Ctx, n, corps: Noeud, l): Noeud {
    soit cpt = liste();
    ajouter(cpt, 0);
    soit entree = Noeud { genre: N_SOIT, nom: nom_cache("__h", n), a: Noeud { genre: N_APPEL, nom: "__hyp_debut", ligne: l }, ligne: l };
    entree.suivant = journaliser(c, corps, n, cpt);
    soit d = entree;
    tantque d.suivant != nul {
        d = d.suivant;
    }
    d.suivant = appel_hyp("__hyp_valider", nul, l);
    retour Noeud { genre: N_POUR, nom: nom_cache("__hk", n), a: nombre(0, l), b: nombre(1, l), val: 1, premier: entree, ligne: l };
}

// --------------------------------------------------------------------------------------------- déclarations
fonction valeur_constante(c: Ctx, e: Noeud) {
    si e.genre == N_NOMBRE || e.genre == N_FNOMBRE {
        retour e.val;
    }
    si e.genre == N_BIN && texte_egal(e.op, "-") && e.a.genre == N_NOMBRE && e.a.val == 0 && e.b.genre == N_FNOMBRE {
        retour e.b.val ^ SIGNE;
    }
    si e.genre == N_BLIT {
        retour e.val == 2;
    }
    si e.genre == N_NON {
        retour ~valeur_constante(c, e.a);
    }
    si e.genre == N_BIN {
        soit x = valeur_constante(c, e.a);
        soit y = valeur_constante(c, e.b);
        soit o = e.op;
        si texte_egal(o, "+") { retour x + y; }
        si texte_egal(o, "-") { retour x - y; }
        si texte_egal(o, "*") { retour x * y; }
        si texte_egal(o, "/") { retour x / y; }
        si texte_egal(o, "%") { retour x % y; }
        si texte_egal(o, "<<") { retour x << y; }
        si texte_egal(o, ">>") { retour x >> y; }
        si texte_egal(o, "&") { retour x & y; }
        si texte_egal(o, "|") { retour x | y; }
        si texte_egal(o, "^") { retour x ^ y; }
        si texte_egal(o, "<<q") {
            si y >= 16 { retour 0; }
            retour x << (2 * y);
        }
        si texte_egal(o, ">>q") {
            si y >= 16 { retour 0; }
            retour x >> (2 * y);
        }
    }
    erreur(c, e.ligne, "expression constante attendue");
    retour 0;
}

// Les données : une fonction __init, appelée au début de principal, les copie une seule fois (au premier lancement)
fonction injecter_donnees(c: Ctx) {
    si c.blocs == nul {
        retour;
    }
    soit l = 0;
    soit copie = Noeud { genre: N_DONNEES, ligne: l };
    copie.suivant = Noeud { genre: N_ECRIRE, val: 3, b: nombre(DRAPEAU, l), c: nombre(1, l), ligne: l };
    soit cond = bin("==", Noeud { genre: N_LIRE, val: 3, b: nombre(DRAPEAU, l), ligne: l }, nombre(0, l), l);
    soit f = Fonction { nom: "__init", corps: Noeud { genre: N_SI, a: cond, premier: copie, ligne: l }, etiq: nouvelle_etiquette(c) };
    soit p = fonction_de(c, "principal");
    si p != nul {
        soit appel = Noeud { genre: N_EXPR, a: Noeud { genre: N_APPEL, nom: "__init", ligne: l }, ligne: l };
        appel.suivant = p.corps;
        p.corps = appel;
    }
    si c.der_fonction == nul {
        c.fonctions = f;
    } sinon {
        c.der_fonction.suivant = f;
    }
    c.der_fonction = f;
}

fonction une_constante(c: Ctx) {
    soit nom = identifiant(c);
    attendre(c, "=");
    soit ec = expr(c, 0);
    fin_instr(c);
    // flottant ou long (éventuellement précédé de -), sinon expression entière constante
    soit neg = ec.genre == N_BIN && texte_egal(ec.op, "-") && ec.a.genre == N_NOMBRE && ec.a.val == 0;
    soit xc = ec;
    si neg {
        xc = ec.b;
    }
    soit k = Constante { nom: nom, suivant: c.consts };
    si xc.genre == N_FNOMBRE {
        k.type = T_F;
        k.val = xc.val;
        si neg {
            k.val = xc.val ^ SIGNE;
        }
    } sinon si xc.genre == N_LNOMBRE {
        k.type = T_L;
        k.val = xc.val;
        k.haut = xc.nom;
        si neg {
            k.val = 0 - xc.val;
            k.haut = ~xc.nom + (xc.val == 0);
        }
    } sinon {
        k.val = valeur_constante(c, ec);
    }
    c.consts = k;
}

fonction un_tableau(c: Ctx) {
    soit t = Tableau { nom: identifiant(c) };
    attendre(c, "[");
    t.taille = valeur_constante(c, expr(c, 0));
    attendre(c, "]");
    si est_id(c, "de") {
        avancer(c);
        soit l2 = c.tok.ligne;
        soit sorte = identifiant(c);
        si texte_egal(sorte, "quits") {
            t.sorte = 1;
        } sinon si texte_egal(sorte, "logique") {
            t.sorte = 2;
        } sinon {
            t.st = numero_struct(c, sorte);
            si t.st == 0 {
                erreur_nom(c, l2, "structure inconnue :", sorte);
            }
            t.sorte = 3;
        }
    }
    soit m = acces(c);
    t.etage = m.val;
    t.base = valeur_constante(c, m.b);
    fin_instr(c);
    t.suivant = c.tableaux;
    c.tableaux = t;
}

fonction programme(c: Ctx) {
    tantque c.erreur == 0 && c.tok.genre != 6 {
        soit l = c.tok.ligne;
        si est_kw(c, "constante") {
            avancer(c);
            une_constante(c);
        } sinon si est_id(c, "structure") {
            avancer(c);
            soit nom2 = identifiant(c);
            soit s = Struct { nom: nom2 };
            si c.structs == nul {
                c.structs = s;
            } sinon {
                soit d = c.structs;
                tantque d.suivant != nul {
                    d = d.suivant;
                }
                d.suivant = s;
            }
            attendre(c, "{");
            soit dernier: Champ = nul;
            tantque c.erreur == 0 && !est_op(c, "}") {
                soit ch = Champ { nom: identifiant(c) };
                ch.type = type_opt(c);
                si dernier == nul {
                    s.champs = ch;
                } sinon {
                    dernier.suivant = ch;
                }
                dernier = ch;
                s.nb = s.nb + 1;
                si est_op(c, ";") || est_op(c, ",") {
                    avancer(c);
                }
            }
            attendre(c, "}");
            si est_op(c, ";") {
                avancer(c);
            }
        } sinon si est_kw(c, "donnees") {
            avancer(c);
            soit m2 = acces(c);
            si m2.a != nul {
                erreur(c, l, "étage constant attendu dans donnees");
            }
            soit dd = Donnee { etage: m2.val, adr: valeur_constante(c, m2.b), vals: liste(), etiq: nouvelle_etiquette(c) };
            attendre(c, "=");
            attendre(c, "{");
            tantque c.erreur == 0 && !est_op(c, "}") {
                ajouter(dd.vals, valeur_constante(c, expr(c, 0)));
                si est_op(c, ",") {
                    avancer(c);
                }
            }
            attendre(c, "}");
            fin_instr(c);
            si c.der_bloc == nul {
                c.blocs = dd;
            } sinon {
                c.der_bloc.suivant = dd;
            }
            c.der_bloc = dd;
        } sinon si est_id(c, "tableau") {
            avancer(c);
            un_tableau(c);
        } sinon si est_kw(c, "fonction") {
            avancer(c);
            soit f = Fonction { nom: identifiant(c), ligne: l };
            attendre(c, "(");
            soit dp: Param = nul;
            tantque c.erreur == 0 && !est_op(c, ")") {
                soit p = Param { nom: nom_variable(c) };
                p.type = type_opt(c);
                si dp == nul {
                    f.params = p;
                } sinon {
                    dp.suivant = p;
                }
                dp = p;
                f.nb = f.nb + 1;
                si est_op(c, ",") {
                    avancer(c);
                }
            }
            attendre(c, ")");
            f.rtype = type_opt(c);
            f.etiq = nouvelle_etiquette(c);
            // une fonction du prélude cède la place à celle du programme qui porte le même nom
            soit garder = 1;
            si fonction_de(c, f.nom) != nul {
                garder = 0;
                si !c.en_prelude {
                    erreur_nom(c, l, "fonction déjà définie :", f.nom);
                }
            }
            f.prelude = c.en_prelude;
            si garder {
                si c.der_fonction == nul {
                    c.fonctions = f;
                } sinon {
                    c.der_fonction.suivant = f;
                }
                c.der_fonction = f;
            }
            f.corps = vectoriser(c, bloc(c));
        } sinon {
            erreur(c, l, "déclaration attendue");
        }
    }
}

// --------------------------------------------------------------------------------------------- code machine
fonction mot(op, g, b, etage) {
    retour (op << 24) | (g << 16) | (b << 8) | 16 | ((etage & 3) << 6);
}

fonction emettre(c: Ctx, w) {
    ajouter(c.code, w);
}

fonction rrr(c: Ctx, op, d, s, t) {
    emettre(c, mot(op, (d << 4) | s, t << 4, 0));
}

fonction rri(c: Ctx, op, d, s, imm) {
    emettre(c, mot(op, (d << 4) | s, imm, 0));
}

fonction rr(c: Ctx, op, d, s) {
    emettre(c, mot(op, (d << 4) | s, 0, 0));
}

fonction cmp(c: Ctx, a, b) {
    emettre(c, mot(14, a, b << 4, 0));
}

fonction pousser(c: Ctx, r) {
    emettre(c, mot(39, r, 0, 0));
}

fonction depiler(c: Ctx, r) {
    emettre(c, mot(40, r << 4, 0, 0));
}

fonction ldf(c: Ctx, r, off) {
    emettre(c, mot(37, r << 4, off & 255, 0));
}

fonction stf(c: Ctx, r, off) {
    emettre(c, mot(38, r << 4, off & 255, 0));
}

fonction nouvelle_etiquette(c: Ctx) {
    ajouter(c.etiq, 0 - 1);
    retour c.etiq.n - 1;
}

fonction poser_etiquette(c: Ctx, e) {
    poser(c.etiq, e, c.code.n);
}

fonction saut(c: Ctx, op, e) {
    ajouter(c.fix_pos, c.code.n);
    ajouter(c.fix_etiq, e);
    ajouter(c.fix_genre, 0);
    emettre(c, mot(op, 0, 0, 0));
}

fonction ldi_etiquette(c: Ctx, r, e) {
    emettre(c, mot(10, r << 4, 0, 0));
    ajouter(c.fix_pos, c.code.n);
    ajouter(c.fix_etiq, e);
    ajouter(c.fix_genre, 1);
    emettre(c, 0);
}

fonction charger(c: Ctx, r, v) {
    si v <= 255 {
        rri(c, 6, r, 0, v);
    } sinon {
        emettre(c, mot(10, r << 4, 0, 0));
        emettre(c, v);
    }
}

// --------------------------------------------------------------------------------------------- types
fonction var_de(c: Ctx, nom, ligne): Var {
    soit v = c.vars;
    tantque v != nul {
        si texte_egal(v.nom, nom) {
            retour v;
        }
        v = v.suivant;
    }
    erreur_nom(c, ligne, "variable inconnue :", nom);
    retour Var { nom: nom };
}

fonction champ_de(c: Ctx, st: Struct, nom): Champ {
    soit ch = st.champs;
    tantque ch != nul {
        si texte_egal(ch.nom, nom) {
            retour ch;
        }
        ch = ch.suivant;
    }
    retour nul;
}

fonction position_champ(st: Struct, nom) {
    soit ch = st.champs;
    soit k = 0;
    tantque ch != nul {
        si texte_egal(ch.nom, nom) {
            retour k;
        }
        ch = ch.suivant;
        k = k + 1;
    }
    retour 0;
}

fonction joindre_types(c: Ctx, a, b, ligne) {
    si a == b {
        retour a;
    }
    si (a == 0 && b == T_F) || (a == T_F && b == 0) {
        retour T_F;
    }
    si (a == 0 && b == T_L) || (a == T_L && b == 0) {
        retour T_L;
    }
    si (a == T_F && b == T_L) || (a == T_L && b == T_F) {
        erreur(c, ligne, "l'opération mélange un flottant et un long : convertissez avec flottant(), long() ou entier()");
    } sinon {
        erreur(c, ligne, "types incompatibles dans l'opération");
    }
    retour 0;
}

fonction est_comparaison(o) {
    retour texte_egal(o, "==") || texte_egal(o, "!=") || texte_egal(o, "<") || texte_egal(o, "<=") || texte_egal(o, ">")
        || texte_egal(o, ">=");
}

fonction typ_bin(c: Ctx, e: Noeud) {
    soit o = e.op;
    soit ta = typ(c, e.a);
    soit tb = typ(c, e.b);
    soit l = e.ligne;
    si est_struct(ta) || est_struct(tb) {
        soit nul_a = e.a.genre == N_NOMBRE && e.a.val == 0;
        soit nul_b = e.b.genre == N_NOMBRE && e.b.val == 0;
        si !((texte_egal(o, "==") || texte_egal(o, "!=")) && (ta == tb || (est_struct(ta) && nul_b) || (est_struct(tb) && nul_a))) {
            erreur(c, l, "une référence se compare seulement (== ou !=) à une référence de même structure ou à nul");
        }
        retour 0;
    }
    si est_comparaison(o) || texte_egal(o, "&&") || texte_egal(o, "||") {
        si !(ta == T_LOG || tb == T_LOG) {
            joindre_types(c, ta, tb, l);
        }
        retour 0;
    }
    si est_struct(ta) || est_struct(tb) {
        erreur(c, l, "cet opérateur ne s'applique pas à une référence : comparez seulement (== ou !=) à une référence de même structure ou à nul");
        retour 0;
    }
    si ta == T_LOG || tb == T_LOG {
        retour 0;                   // refusé à la génération
    }
    si texte_egal(o, "+") || texte_egal(o, "-") || texte_egal(o, "*") || texte_egal(o, "/") || texte_egal(o, "%") {
        soit t = joindre_types(c, ta, tb, l);
        si t == T_F && texte_egal(o, "%") {
            erreur(c, l, "le reste « % » n'est pas défini pour les flottants");
        }
        retour t;
    }
    si texte_egal(o, "&") || texte_egal(o, "|") || texte_egal(o, "^") {
        soit t2 = joindre_types(c, ta, tb, l);
        si t2 == T_F {
            erreur(c, l, "opération bit à bit sur un flottant (voir bits())");
        }
        retour t2;
    }
    si texte_egal(o, "<<") || texte_egal(o, ">>") {
        si ta == T_F || tb != 0 {
            erreur(c, l, "décalage d'un entier ou d'un long par un entier seulement");
        }
        retour ta;
    }
    si ta != 0 || tb != 0 {
        erreur(c, l, "cet opérateur s'applique aux entiers seulement");
    }
    retour 0;
}

fonction retour_integre(nom) {
    si texte_egal(nom, "flottant") || texte_egal(nom, "flottant_signe") || texte_egal(nom, "racine")
        || texte_egal(nom, "comme_flottant") {
        retour T_F;
    }
    si texte_egal(nom, "long") || texte_egal(nom, "long_signe") || texte_egal(nom, "long_de") {
        retour T_L;
    }
    retour 0 - 1;
}

fonction est_integre(nom) {
    retour texte_egal(nom, "lire_car") || texte_egal(nom, "ecrire_car") || texte_egal(nom, "ouvrir_lecture")
        || texte_egal(nom, "ouvrir_ecriture") || texte_egal(nom, "fermer") || texte_egal(nom, "fin_de")
        || texte_egal(nom, "sortie") || texte_egal(nom, "entrée") || texte_egal(nom, "min4") || texte_egal(nom, "max4")
        || texte_egal(nom, "addm4") || texte_egal(nom, "cmp3") || texte_egal(nom, "gdot") || texte_egal(nom, "gemv")
        || texte_egal(nom, "qegal") || texte_egal(nom, "nb_bits") || texte_egal(nom, "entier") || texte_egal(nom, "arrondi")
        || texte_egal(nom, "bits") || texte_egal(nom, "bas") || texte_egal(nom, "haut") || texte_egal(nom, "bruit")
        || texte_egal(nom, "pile") || texte_egal(nom, "__service") || retour_integre(nom) != 0 - 1;
}

// abs, min, max sur des flottants ou des longs : en ligne ; sinon la fonction du même nom
fonction type_surcharge(c: Ctx, e: Noeud) {
    si !(texte_egal(e.nom, "abs") || texte_egal(e.nom, "min") || texte_egal(e.nom, "max")) {
        retour 0;
    }
    soit a = e.premier;
    soit t = 0;
    soit fl = 0;
    tantque a != nul {
        soit ta = typ(c, a);
        si ta == T_F || ta == T_L {
            fl = 1;
        }
        t = joindre_types(c, t, ta, e.ligne);
        a = a.suivant;
    }
    si fl {
        retour t;
    }
    retour 0;
}

fonction typ(c: Ctx, e: Noeud) {
    si e.genre == N_VAR {
        retour var_de(c, e.nom, e.ligne).type;
    }
    si e.genre == N_FNOMBRE {
        retour T_F;
    }
    si e.genre == N_LNOMBRE {
        retour T_L;
    }
    si e.genre == N_BIN {
        retour typ_bin(c, e);
    }
    si e.genre == N_NON {
        soit tn = typ(c, e.a);
        si tn == T_F {
            erreur(c, e.ligne, "« ~ » ne s'applique pas à un flottant");
        }
        si tn == T_L {
            retour T_L;
        }
        retour 0;
    }
    si e.genre == N_QNOMBRE {
        retour T_LOG;
    }
    si e.genre == N_RLIRE {
        si tableau_de(c, e.nom).sorte == 2 {
            retour T_LOG;
        }
        retour 0;
    }
    si e.genre == N_APPEL {
        si op_logique(e.nom) != 0 {
            si e.premier == nul {
                retour 0;
            }
            retour type_logique(c, e.premier);
        }
        si texte_egal(e.nom, "logique") || texte_egal(e.nom, "comme_logique") {
            retour T_LOG;
        }
        si retour_integre(e.nom) != 0 - 1 {
            retour retour_integre(e.nom);
        }
        si est_integre(e.nom) {
            retour 0;
        }
        soit ts = type_surcharge(c, e);
        si ts != 0 {
            retour ts;
        }
        soit f = fonction_de(c, e.nom);
        si f != nul {
            retour f.rtype;
        }
        retour 0;
    }
    si e.genre == N_CONSTRUIRE || e.genre == N_NOUVEAU {
        retour numero_struct(c, e.nom);
    }
    si e.genre == N_CHAMP {
        soit t = typ(c, e.a);
        si est_struct(t) {
            soit ch = champ_de(c, struct_numero(c, t), e.nom);
            si ch != nul {
                retour ch.type;
            }
            erreur_nom(c, e.ligne, "champ inconnu dans la structure :", e.nom);
        } sinon si !(texte_egal(e.nom, "r") || texte_egal(e.nom, "v") || texte_egal(e.nom, "b") || texte_egal(e.nom, "a")) {
            erreur_nom(c, e.ligne, "il faut une référence à une structure pour ce champ :", e.nom);
        }
    }
    retour 0;
}

// Opérations de la logique à quatre valeurs : nombre d'arguments (0 si ce n'en est pas une)
fonction op_logique(nom) {
    si texte_egal(nom, "et4") || texte_egal(nom, "ou4") || texte_egal(nom, "fusion") || texte_egal(nom, "consensus") {
        retour 2;
    }
    si texte_egal(nom, "non4") || texte_egal(nom, "anti") {
        retour 1;
    }
    retour 0;
}

// Type d'un argument d'une opération logique : vrai et faux y sont des logiques
fonction type_logique(c: Ctx, a: Noeud) {
    si a.genre == N_BLIT {
        retour T_LOG;
    }
    retour typ(c, a);
}

fonction refuser_logique(c: Ctx, e: Noeud) {
    si typ(c, e) == T_LOG {
        erreur(c, e.ligne, "un logique a quatre valeurs et ne sert pas de condition : utilisez « selon », ou comparez (x == vrai)");
    }
}

// --------------------------------------------------------------------------------------------- génération des expressions
// CMP et saut si la comparaison est fausse
fonction saut_comp_faux(c: Ctx, o, lab) {
    saut_comp_faux_r(c, o, lab, 1, 2);
}

fonction saut_comp_faux_r(c: Ctx, o, lab, ra, rb) {
    si texte_egal(o, ">") || texte_egal(o, "<=") {
        cmp(c, rb, ra);
    } sinon {
        cmp(c, ra, rb);
    }
    si texte_egal(o, "==") { saut(c, 50, lab); }
    si texte_egal(o, "!=") { saut(c, 49, lab); }
    si texte_egal(o, "<") || texte_egal(o, ">") { saut(c, 54, lab); }
    si texte_egal(o, ">=") || texte_egal(o, "<=") { saut(c, 53, lab); }
}

fonction saut_faux(c: Ctx, e: Noeud, lab) {
    si c.optim {
        refuser_logique(c, e);
        si e.genre == N_BIN && est_comparaison(e.op) {
            soit ta = typ(c, e.a);
            soit tb = typ(c, e.b);
            si ta == T_LOG || tb == T_LOG || est_struct(ta) || est_struct(tb) {
                soit t = T_LOG;
                si ta != T_LOG && tb != T_LOG {
                    t = tb;
                    si est_struct(ta) {
                        t = ta;
                    }
                }
                paire(c, e.a, e.b, t);
                saut_comp_faux(c, e.op, lab);
                retour;
            }
            si joindre_types(c, ta, tb, e.ligne) == 0 {
                soit pk = deux_ops(c, e.a, e.b);
                saut_comp_faux_r(c, e.op, lab, pk >> 4, pk & 15);
                retour;
            }
        }
        si e.genre == N_BIN && texte_egal(e.op, "&&") {
            saut_faux(c, e.a, lab);
            saut_faux(c, e.b, lab);
            retour;
        }
        si e.genre == N_BIN && texte_egal(e.op, "||") {
            soit lb = nouvelle_etiquette(c);
            soit lt = nouvelle_etiquette(c);
            saut_faux(c, e.a, lb);
            saut(c, 48, lt);
            poser_etiquette(c, lb);
            saut_faux(c, e.b, lab);
            poser_etiquette(c, lt);
            retour;
        }
        si e.genre == N_NONLOG {
            soit lc = nouvelle_etiquette(c);
            saut_faux(c, e.a, lc);
            saut(c, 48, lab);
            poser_etiquette(c, lc);
            retour;
        }
    }
    gen_bool(c, e);
    cmp(c, 1, 0);
    saut(c, 49, lab);
}

fonction deux(c: Ctx, a: Noeud, b: Noeud) {
    paire(c, a, b, 0);
}

// a dans R1, b dans R2, chacun évalué au type voulu (seul le logique change quelque chose : vrai vaut alors 2)
fonction paire(c: Ctx, a: Noeud, b: Noeud, voulu) {
    si voulu == T_L {
        // R1:R4 et R2:R5
        gen_v(c, a, T_L);
        pousser(c, 1);
        pousser(c, 4);
        gen_v(c, b, T_L);
        rr(c, 11, 2, 1);
        rr(c, 11, 5, 4);
        depiler(c, 4);
        depiler(c, 1);
        retour;
    }
    gen_v(c, a, voulu);
    si c.optim {
        // b est une feuille : directement dans R2, sans passer par la pile
        si b.genre == N_BLIT && (voulu == 0 || voulu == T_LOG) {
            si voulu == 0 {
                charger(c, 2, b.val == 2);
            } sinon {
                charger(c, 2, b.val);
            }
            retour;
        }
        si (b.genre == N_NOMBRE || b.genre == N_QNOMBRE) && (voulu == 0 || voulu == T_LOG) {
            charger(c, 2, b.val);
            retour;
        }
        si b.genre == N_FNOMBRE && voulu == T_F {
            charger(c, 2, b.val);
            retour;
        }
        si b.genre == N_VAR {
            soit vb = var_de(c, b.nom, b.ligne);
            si vb.type == voulu {
                si vb.reg != 0 {
                    rr(c, 11, 2, vb.reg);
                } sinon {
                    ldf(c, 2, vb.off);
                }
                retour;
            }
        }
    }
    pousser(c, 1);
    gen_v(c, b, voulu);
    rr(c, 11, 2, 1);
    depiler(c, 1);
}

// e au type voulu : vrai vaut 2 pour un logique ; un entier devient flottant (ITOF) ou long (mot haut à 0)
fonction gen_v(c: Ctx, e: Noeud, voulu) {
    si e.genre == N_BLIT && voulu == T_LOG {
        charger(c, 1, e.val);
        retour;
    }
    si est_struct(voulu) {
        soit tr = typ(c, e);
        si tr != voulu && !(e.genre == N_NOMBRE && e.val == 0) {
            erreur(c, e.ligne, "il faut une référence de cette structure (ou nul) : conversion impossible");
        }
    }
    gen(c, e);
    si voulu == 0 {
        soit t0 = typ(c, e);
        si t0 == T_F || t0 == T_L {
            erreur(c, e.ligne, "conversion implicite impossible vers un entier : utilisez entier(), bas() ou bits()");
        }
    }
    si voulu == T_F || voulu == T_L {
        soit t = typ(c, e);
        si t == 0 {
            si voulu == T_F {
                rr(c, 72, 1, 1);
            } sinon {
                rri(c, 6, 4, 0, 0);
            }
        } sinon si t != voulu {
            erreur(c, e.ligne, "conversion implicite impossible : utilisez entier(), flottant(), long() ou logique()");
        }
    }
}

// Saute à vrai si (g op d) sur des longs signés ; registres de travail R6, R7, R8
fonction saut_long(c: Ctx, op, cible, g0, g1, d0, d1) {
    si texte_egal(op, "==") || texte_egal(op, "!=") {
        rrr(c, 22, 6, g0, d0);
        rrr(c, 22, 7, g1, d1);
        rrr(c, 21, 6, 6, 7);
        cmp(c, 6, 0);
        si texte_egal(op, "==") { saut(c, 49, cible); } sinon { saut(c, 50, cible); }
        retour;
    }
    soit o = op;
    si texte_egal(op, ">") || texte_egal(op, ">=") {
        soit x0 = g0;
        soit x1 = g1;
        g0 = d0;
        g1 = d1;
        d0 = x0;
        d1 = x1;
        o = "<";
        si texte_egal(op, ">=") {
            o = "<=";
        }
    }
    soit faux_ = nouvelle_etiquette(c);
    charger(c, 8, SIGNE);
    rrr(c, 22, 6, g1, 8);
    rrr(c, 22, 7, d1, 8);
    cmp(c, 6, 7);
    saut(c, 53, cible);
    cmp(c, 7, 6);
    saut(c, 53, faux_);
    si texte_egal(o, "<") {
        cmp(c, g0, d0);
        saut(c, 53, cible);
    } sinon {
        cmp(c, d0, g0);
        saut(c, 54, cible);
    }
    poser_etiquette(c, faux_);
}

// Valeur de vérité dans R1 : un flottant est vrai s'il n'est pas ±0, un long s'il n'est pas nul
fonction gen_bool(c: Ctx, e: Noeud) {
    refuser_logique(c, e);
    gen(c, e);
    soit t = typ(c, e);
    si t == T_F {
        charger(c, 2, 2147483647);
        rrr(c, 20, 1, 1, 2);
    } sinon si t == T_L {
        rrr(c, 21, 1, 1, 4);
    }
}

fonction booleen(c: Ctx, op, ra, rb) {
    soit lv = nouvelle_etiquette(c);
    soit fin = nouvelle_etiquette(c);
    cmp(c, ra, rb);
    saut(c, op, lv);
    rri(c, 6, 1, 0, 0);
    saut(c, 48, fin);
    poser_etiquette(c, lv);
    rri(c, 6, 1, 0, 1);
    poser_etiquette(c, fin);
}

fonction adresse_champ(c: Ctx, base: Noeud, pos) {
    gen(c, base);
    rr(c, 11, 2, 1);
    rri(c, 6, 6, 0, 24);
    rrr(c, 9, 2, 2, 6);
    si pos != 0 {
        rri(c, 6, 1, 1, pos);
    }
}

// flottant, flottant_signe, entier, arrondi, racine, comme_flottant, bits, long, long_signe, long_de, bas, haut
fonction conversion(c: Ctx, e: Noeud) {
    soit nom = e.nom;
    si !(retour_integre(nom) != 0 - 1 || texte_egal(nom, "entier") || texte_egal(nom, "arrondi") || texte_egal(nom, "bits")
        || texte_egal(nom, "bas") || texte_egal(nom, "haut")) {
        retour 0;
    }
    soit x = e.premier;
    si x == nul {
        erreur_nom(c, e.ligne, "il manque l'argument de", nom);
        retour 1;
    }
    soit t = typ(c, x);
    soit interdit = 0;
    si texte_egal(nom, "flottant") {
        interdit = t == T_L;
        gen(c, x);
        si t == 0 { rr(c, 72, 1, 1); }
    } sinon si texte_egal(nom, "flottant_signe") {
        interdit = t != 0;
        gen(c, x);
        rr(c, 73, 1, 1);
    } sinon si texte_egal(nom, "entier") {
        gen(c, x);
        si t == T_F { rr(c, 74, 1, 1); }
    } sinon si texte_egal(nom, "arrondi") {
        interdit = t != T_F;
        gen(c, x);
        rr(c, 75, 1, 1);
    } sinon si texte_egal(nom, "racine") {
        gen_v(c, x, T_F);
        rr(c, 71, 1, 1);
    } sinon si texte_egal(nom, "comme_flottant") || texte_egal(nom, "bits") {
        interdit = t == T_L;
        gen(c, x);
    } sinon si texte_egal(nom, "long") {
        interdit = t == T_F;
        gen_v(c, x, T_L);
    } sinon si texte_egal(nom, "long_signe") {
        interdit = t != 0;
        gen(c, x);
        rri(c, 6, 2, 0, 31);
        rrr(c, 9, 4, 1, 2);
        rrr(c, 2, 4, 0, 4);
    } sinon si texte_egal(nom, "long_de") {
        interdit = t != 0 || x.suivant == nul || typ(c, x.suivant) != 0;
        si x.suivant != nul {
            deux(c, x, x.suivant);
        }
        rr(c, 11, 4, 1);
        rr(c, 11, 1, 2);
    } sinon {
        interdit = t != T_L;
        gen(c, x);
        si texte_egal(nom, "haut") {
            rr(c, 11, 1, 4);
        }
    }
    si interdit {
        erreur_nom(c, e.ligne, "argument d'un type qui ne convient pas à", nom);
    }
    retour 1;
}

// abs, min et max pour les flottants et les longs, en ligne
fonction surcharge(c: Ctx, e: Noeud, t) {
    soit a = e.premier;
    si texte_egal(e.nom, "abs") {
        gen_v(c, a, t);
        si t == T_F {
            charger(c, 2, 2147483647);
            rrr(c, 20, 1, 1, 2);
        } sinon {
            soit fin = nouvelle_etiquette(c);
            charger(c, 8, SIGNE);
            rrr(c, 20, 6, 4, 8);
            cmp(c, 6, 0);
            saut(c, 49, fin);
            rrr(c, 2, 1, 0, 1);
            rrr(c, 77, 4, 0, 4);
            poser_etiquette(c, fin);
        }
        retour;
    }
    si a == nul || a.suivant == nul {
        erreur_nom(c, e.ligne, "deux arguments attendus pour", e.nom);
        retour;
    }
    paire(c, a, a.suivant, t);
    soit prendre = nouvelle_etiquette(c);
    soit fin2 = nouvelle_etiquette(c);
    soit est_min = texte_egal(e.nom, "min");
    si t == T_F {
        si est_min { rrr(c, 69, 3, 2, 1); } sinon { rrr(c, 69, 3, 1, 2); }
        cmp(c, 3, 0);
        saut(c, 50, prendre);
    } sinon {
        si est_min {
            saut_long(c, "<", prendre, 2, 5, 1, 4);
        } sinon {
            saut_long(c, "<", prendre, 1, 4, 2, 5);
        }
    }
    saut(c, 48, fin2);
    poser_etiquette(c, prendre);
    rr(c, 11, 1, 2);
    si t == T_L {
        rr(c, 11, 4, 5);
    }
    poser_etiquette(c, fin2);
}

fonction appel(c: Ctx, e: Noeud) {
    soit nom = e.nom;
    soit a = e.premier;
    si texte_egal(nom, "sortie") {
        gen(c, a);
        emettre(c, mot(36, 1, 0, 0));
        si typ(c, a) == T_L {
            emettre(c, mot(36, 4, 0, 0));
        }
        retour;
    }
    si texte_egal(nom, "gemv") {
        soit x = a;
        tantque x != nul {
            gen(c, x);
            pousser(c, 1);
            x = x.suivant;
        }
        emettre(c, mot(57, 0, 0, 0));
        rri(c, 6, 14, 14, 5);
        rri(c, 6, 1, 0, 0);
        retour;
    }
    si conversion(c, e) {
        retour;
    }
    soit tsur = type_surcharge(c, e);
    si tsur != 0 {
        surcharge(c, e, tsur);
        retour;
    }
    si texte_egal(nom, "entrée") {
        emettre(c, mot(35, 16, 0, 0));
        retour;
    }
    si texte_egal(nom, "bruit") {
        rri(c, 6, 1, 0, 5);
        rrr(c, 83, 1, 1, 0);
        retour;
    }
    si texte_egal(nom, "pile") {
        // le sommet de la pile (R14) : pour le ramasse-miettes
        rr(c, 11, 1, 14);
        retour;
    }
    si texte_egal(nom, "__service") {
        // un service de la machine hôte : SYS code, argument
        deux(c, a, a.suivant);
        rrr(c, 83, 1, 1, 2);
        retour;
    }
    si texte_egal(nom, "lire_car") {
        gen(c, a);
        rr(c, 81, 1, 1);
        retour;
    }
    si texte_egal(nom, "ecrire_car") {
        deux(c, a.suivant, a);
        rrr(c, 82, 0, 1, 2);
        rri(c, 6, 1, 0, 0);
        retour;
    }
    si op_logique(nom) != 0 {
        gen_logique(c, e);
        retour;
    }
    si texte_egal(nom, "__code_logique") {
        si type_logique(c, a) != T_LOG {
            erreur(c, e.ligne, "un tableau de logique reçoit des logiques (vrai, faux, inconnu, variable) : utilisez logique() ou comme_logique()");
        }
        gen_v(c, a, T_LOG);
        retour;
    }
    si texte_egal(nom, "logique") || texte_egal(nom, "comme_logique") {
        si type_logique(c, a) == T_LOG {
            gen_v(c, a, T_LOG);
            retour;
        }
        gen(c, a);
        si texte_egal(nom, "comme_logique") {
            rri(c, 6, 2, 0, 3);
            rrr(c, 20, 1, 1, 2);
        } sinon {
            soit lz = nouvelle_etiquette(c);
            soit lf = nouvelle_etiquette(c);
            cmp(c, 1, 0);
            saut(c, 49, lz);
            rri(c, 6, 1, 0, 2);
            saut(c, 48, lf);
            poser_etiquette(c, lz);
            rri(c, 6, 1, 0, 1);
            poser_etiquette(c, lf);
        }
        retour;
    }

    si texte_egal(nom, "cmp3") {
        gen(c, a);
        rr(c, 18, 1, 1);
        retour;
    }
    si texte_egal(nom, "nb_bits") {
        gen(c, a);
        rr(c, 80, 1, 1);
        retour;
    }
    soit op4 = 0;
    si texte_egal(nom, "min4") { op4 = 16; }
    si texte_egal(nom, "max4") { op4 = 17; }
    si texte_egal(nom, "addm4") { op4 = 19; }
    si texte_egal(nom, "gdot") { op4 = 56; }
    si texte_egal(nom, "qegal") { op4 = 79; }
    si op4 != 0 {
        deux(c, a, a.suivant);
        rrr(c, op4, 1, 1, 2);
        retour;
    }
    soit code = 0;
    si texte_egal(nom, "ouvrir_lecture") { code = 1; }
    si texte_egal(nom, "ouvrir_ecriture") { code = 2; }
    si texte_egal(nom, "fermer") { code = 3; }
    si texte_egal(nom, "fin_de") { code = 4; }
    si code != 0 {
        gen(c, a);
        rr(c, 11, 2, 1);
        rri(c, 6, 1, 0, code);
        rrr(c, 83, 1, 1, 2);
        retour;
    }
    // afficher(x) : la version du prélude qui convient au type de x (texte, flottant, long, logique)
    si (texte_egal(nom, "afficher") || texte_egal(nom, "ecrire") || texte_egal(nom, "texte")) && a != nul && a.suivant == nul {
        soit pf = fonction_de(c, nom);
        si pf != nul && pf.prelude {
            soit ta = type_logique(c, a);
            soit suffixe = 0;
            si ta == T_F { suffixe = "_f"; }
            si ta == T_L { suffixe = "_l"; }
            si ta == T_LOG { suffixe = "_q"; }
            si suffixe != 0 {
                soit l = liste();
                ajouter_texte(l, "__");
                ajouter_texte(l, nom);
                ajouter_texte(l, suffixe);
                nom = texte_de(l, 0, l.n);
            }
        }
    }
    soit f = fonction_de(c, nom);
    si f == nul {
        erreur_nom(c, e.ligne, "fonction inconnue :", nom);
        retour;
    }
    soit n = 0;
    soit p = f.params;
    tantque a != nul {
        si p == nul {
            erreur_nom(c, e.ligne, "trop d'arguments pour", nom);
            retour;
        }
        gen_v(c, a, p.type);
        pousser(c, 1);
        n = n + 1;
        si p.type == T_L {
            pousser(c, 4);
            n = n + 1;
        }
        a = a.suivant;
        p = p.suivant;
    }
    si p != nul {
        erreur_nom(c, e.ligne, "pas assez d'arguments pour", nom);
    }
    saut(c, 51, demander(c, f));
    si n != 0 {
        rri(c, 6, 14, 14, n);
    }
}

// et4, ou4, non4, anti, fusion, consensus : des ET et des OU sur les deux bits de chaque quit (v : bit 1, f : bit 0),
// donc la même instruction traite un logique ou 16 logiques rangés dans un entier
fonction gen_logique(c: Ctx, e: Noeud) {
    soit nom = e.nom;
    soit a = e.premier;
    soit n = op_logique(nom);
    soit k = 0;
    soit x = a;
    tantque x != nul {
        k = k + 1;
        x = x.suivant;
    }
    si k != n {
        erreur_nom(c, e.ligne, "mauvais nombre d'arguments pour", nom);
        retour;
    }
    soit t = type_logique(c, a);
    si n == 2 {
        si type_logique(c, a.suivant) != t || (t != 0 && t != T_LOG) {
            erreur_nom(c, e.ligne, "des logiques, ou des entiers qui rangent 16 logiques, sans mélange, pour", nom);
        }
        paire(c, a, a.suivant, t);
    } sinon {
        gen_v(c, a, t);
    }
    soit est_et = texte_egal(nom, "et4");
    si est_et || texte_egal(nom, "ou4") {
        // ET4, OU4 : les 16 quits d'un coup
        si est_et { rrr(c, 86, 1, 1, 2); } sinon { rrr(c, 87, 1, 1, 2); }
    } sinon si texte_egal(nom, "fusion") {
        rrr(c, 21, 1, 1, 2);
    } sinon si texte_egal(nom, "consensus") {
        rrr(c, 20, 1, 1, 2);
    } sinon si texte_egal(nom, "anti") && t != T_LOG {
        rr(c, 89, 1, 1);                // ANTI : non puis complément, sur les 16 quits
    } sinon {
        rr(c, 88, 1, 1);                // NON4 : échange les preuves du vrai et du faux
        si texte_egal(nom, "anti") {
            rri(c, 6, 2, 0, 3);
            rrr(c, 22, 1, 1, 2);
        }
    }
}

// Mot et décalage du quit i : (base + (i >> 4), (i & 15) * 2)
fonction mot_rangee(t: Tableau, idx: Noeud, l): Noeud {
    soit adr = bin(">>", idx, nombre(4, l), l);
    si t.base != 0 {
        adr = bin("+", nombre(t.base, l), adr, l);
    }
    retour Noeud { genre: N_LIRE, val: t.etage, b: adr, ligne: l, zet: t.etage + 1, zlo: t.base,
                   zhi: t.base + (t.taille + 15) / 16 };
}

fonction decalage_rangee(idx: Noeud, l): Noeud {
    retour bin("*", bin("&", idx, nombre(15, l), l), nombre(2, l), l);
}

// t[i] traduit en lecture de mot : (mot >> décalage) & 3, lu comme un logique pour un tableau de logiques
fonction rangee_basse(c: Ctx, e: Noeud): Noeud {
    soit t = tableau_de(c, e.nom);
    soit l = e.ligne;
    soit v = bin("&", bin(">>", mot_rangee(t, e.a, l), decalage_rangee(e.a, l), l), nombre(3, l), l);
    si t.sorte == 2 {
        retour Noeud { genre: N_APPEL, nom: "comme_logique", premier: v, ligne: l };
    }
    retour v;
}

fonction gen(c: Ctx, e: Noeud) {
    soit g = e.genre;
    si g == N_NOMBRE {
        charger(c, 1, e.val);
    } sinon si g == N_FNOMBRE {
        charger(c, 1, e.val);
    } sinon si g == N_LNOMBRE {
        charger(c, 1, e.val);
        charger(c, 4, e.nom);
    } sinon si g == N_BLIT {
        charger(c, 1, e.val == 2);
    } sinon si g == N_QNOMBRE {
        charger(c, 1, e.val);
    } sinon si g == N_RLIRE {
        gen(c, rangee_basse(c, e));
    } sinon si g == N_QUIT {
        // EXQ : le quit i d'un registre
        gen(c, e.a);
        pousser(c, 1);
        gen(c, e.b);
        rr(c, 11, 2, 1);
        depiler(c, 1);
        rrr(c, 90, 1, 1, 2);
    } sinon si g == N_VAR {
        soit vr = var_de(c, e.nom, e.ligne);
        si vr.reg != 0 {
            rr(c, 11, 1, vr.reg);
        } sinon {
            ldf(c, 1, vr.off);
        }
        si vr.type == T_L {
            ldf(c, 4, vr.haut);
        }
    } sinon si g == N_ETIQ {
        ldi_etiquette(c, 1, etiquette_texte(c, e.nom));
    } sinon si g == N_NON {
        soit tn = typ(c, e.a);
        si tn == T_LOG {
            erreur(c, e.ligne, "« ~ » ne s'applique pas à un logique : utilisez non4() ou anti()");
        }
        si tn == T_F {
            erreur(c, e.ligne, "« ~ » ne s'applique pas à un flottant");
        }
        gen(c, e.a);
        rr(c, 18, 1, 1);
        si tn == T_L {
            rr(c, 18, 4, 4);
        }
    } sinon si g == N_NONLOG {
        soit lv = nouvelle_etiquette(c);
        soit fin = nouvelle_etiquette(c);
        si typ(c, e.a) == T_LOG {
            erreur(c, e.ligne, "« ! » ne s'applique pas à un logique : utilisez non4() ou anti()");
        }
        gen_bool(c, e.a);
        cmp(c, 1, 0);
        saut(c, 49, lv);
        rri(c, 6, 1, 0, 0);
        saut(c, 48, fin);
        poser_etiquette(c, lv);
        rri(c, 6, 1, 0, 1);
        poser_etiquette(c, fin);
    } sinon si g == N_BIN {
        gen_bin(c, e);
    } sinon si g == N_LIRE {
        si e.a == nul {
            gen(c, e.b);
            emettre(c, mot(32, 17, 0, e.val));
        } sinon {
            gen(c, e.b);
            pousser(c, 1);
            gen(c, e.a);
            rr(c, 11, 2, 1);
            depiler(c, 1);
            rrr(c, 41, 1, 1, 2);
        }
    } sinon si g == N_APPEL {
        appel(c, e);
    } sinon si g == N_CHAMP {
        soit t = typ(c, e.a);
        si est_struct(t) {
            adresse_champ(c, e.a, position_champ(struct_numero(c, t), e.nom));
            rrr(c, 41, 1, 1, 2);
        } sinon {
            gen(c, e.a);
            soit dec = 0;
            si texte_egal(e.nom, "r") { dec = 24; }
            si texte_egal(e.nom, "v") { dec = 16; }
            si texte_egal(e.nom, "b") { dec = 8; }
            si dec != 0 {
                rri(c, 6, 2, 0, dec);
                rrr(c, 9, 1, 1, 2);
            }
            rri(c, 6, 2, 0, 255);
            rrr(c, 20, 1, 1, 2);
        }
    } sinon si g == N_CONSTRUIRE {
        soit st = struct_de(c, e.nom);
        charger(c, 1, st.nb);
        pousser(c, 1);
        saut(c, 51, demander(c, fonction_de(c, "nouveau")));
        rri(c, 6, 14, 14, 1);
        pousser(c, 1);
        soit p = e.premier;
        tantque p != nul {
            soit pos = position_champ(st, p.nom);
            gen_v(c, p.a, champ_de(c, st, p.nom).type);
            rr(c, 11, 7, 1);
            depiler(c, 1);
            pousser(c, 1);
            rr(c, 11, 2, 1);
            rri(c, 6, 6, 0, 24);
            rrr(c, 9, 2, 2, 6);
            si pos != 0 {
                rri(c, 6, 1, 1, pos);
            }
            rrr(c, 42, 1, 7, 2);
            p = p.suivant;
        }
        depiler(c, 1);
    } sinon si g == N_NOUVEAU {
        charger(c, 1, struct_de(c, e.nom).nb);
        pousser(c, 1);
        saut(c, 51, demander(c, fonction_de(c, "nouveau")));
        rri(c, 6, 14, 14, 1);
    }
}

fonction code_operation(o) {
    si texte_egal(o, "+") { retour 1; }
    si texte_egal(o, "-") { retour 2; }
    si texte_egal(o, "*") { retour 3; }
    si texte_egal(o, "/") { retour 12; }
    si texte_egal(o, "%") { retour 13; }
    si texte_egal(o, "&") { retour 20; }
    si texte_egal(o, "|") { retour 21; }
    si texte_egal(o, "^") { retour 22; }
    si texte_egal(o, "<<") { retour 8; }
    si texte_egal(o, ">>") { retour 9; }
    retour 0;
}

// Opérations sur des longs : en ligne, ou par le prélude (division, reste, décalages)
fonction gen_long(c: Ctx, e: Noeud) {
    soit o = e.op;
    soit l = e.ligne;
    si texte_egal(o, "/") || texte_egal(o, "%") || texte_egal(o, "<<") || texte_egal(o, ">>") {
        soit a = copier(e.a);
        a.suivant = copier(e.b);
        soit f = "__lshl";
        si texte_egal(o, ">>") {
            f = "__lsar";
        }
        si texte_egal(o, "/") || texte_egal(o, "%") {
            f = "__ldiv";
            a.suivant.suivant = nombre(texte_egal(o, "%"), l);
        }
        appel(c, Noeud { genre: N_APPEL, nom: f, premier: a, ligne: l });
        retour;
    }
    paire(c, e.a, e.b, T_L);
    si texte_egal(o, "+") {
        rrr(c, 1, 1, 1, 2);
        rrr(c, 76, 4, 4, 5);
    } sinon si texte_egal(o, "-") {
        rrr(c, 2, 1, 1, 2);
        rrr(c, 77, 4, 4, 5);
    } sinon si texte_egal(o, "*") {
        rrr(c, 3, 6, 1, 2);
        rrr(c, 78, 7, 1, 2);
        rrr(c, 3, 8, 1, 5);
        rrr(c, 1, 7, 7, 8);
        rrr(c, 3, 8, 4, 2);
        rrr(c, 1, 7, 7, 8);
        rr(c, 11, 1, 6);
        rr(c, 11, 4, 7);
    } sinon si texte_egal(o, "&") || texte_egal(o, "|") || texte_egal(o, "^") {
        soit k = code_operation(o);
        rrr(c, k, 1, 1, 2);
        rrr(c, k, 4, 4, 5);
    } sinon {
        erreur(c, l, "cet opérateur ne s'applique pas à un long");
    }
}

// --------------------------------------------------------------------------------------------- quits rangés
// t[i] d'un tableau de quits ou de logiques s'écrit (@e[base + (i >> 4)] >> ((i & 15) * 2)) & 3 ; avec les
// optimisations, cette forme (et celle de l'écriture) devient LDQ (et STQ) quand l'indice est simple : un nombre, une
// variable, ou a + b, a - b, a × b de ceux-là, le même à chaque place. Comme vtx.py (motif_quit, motif_ecriture_quit).
structure Quit { etg, base, idx: Noeud, v: Noeud }

fonction est_nombre(e: Noeud, v) {
    retour e != nul && e.genre == N_NOMBRE && e.val == v;
}

fonction est_bin(e: Noeud, o) {
    retour e != nul && e.genre == N_BIN && texte_egal(e.op, o);
}

fonction feuille_q(e: Noeud) {
    retour e != nul && (e.genre == N_NOMBRE || e.genre == N_VAR);
}

fonction indice_simple(e: Noeud) {
    si feuille_q(e) {
        retour 1;
    }
    retour e != nul && e.genre == N_BIN && (texte_egal(e.op, "+") || texte_egal(e.op, "-") || texte_egal(e.op, "*"))
        && feuille_q(e.a) && feuille_q(e.b);
}

fonction meme_feuille(a: Noeud, b: Noeud) {
    si a.genre != b.genre {
        retour 0;
    }
    si a.genre == N_NOMBRE {
        retour a.val == b.val;
    }
    retour texte_egal(a.nom, b.nom) && a.ligne == b.ligne;
}

fonction meme_indice(a: Noeud, b: Noeud) {
    si a.genre != b.genre {
        retour 0;
    }
    si a.genre == N_BIN {
        retour texte_egal(a.op, b.op) && meme_feuille(a.a, b.a) && meme_feuille(a.b, b.b);
    }
    retour meme_feuille(a, b);
}

// base + (i >> 4) (ou i >> 4) et (i & 15) * 2, avec le même indice simple
fonction motif_place(etg, adr: Noeud, dec: Noeud): Quit {
    si !(est_bin(dec, "*") && est_nombre(dec.b, 2) && est_bin(dec.a, "&") && est_nombre(dec.a.b, 15)) {
        retour nul;
    }
    soit idx = dec.a.a;
    si !indice_simple(idx) {
        retour nul;
    }
    si est_bin(adr, ">>") && meme_indice(adr.a, idx) && est_nombre(adr.b, 4) {
        retour Quit { etg: etg, base: 0, idx: idx };
    }
    si est_bin(adr, "+") && adr.a.genre == N_NOMBRE && est_bin(adr.b, ">>") && meme_indice(adr.b.a, idx)
            && est_nombre(adr.b.b, 4) {
        retour Quit { etg: etg, base: adr.a.val, idx: idx };
    }
    retour nul;
}

fonction meme_place(p: Quit, q: Quit) {
    retour p != nul && q != nul && p.etg == q.etg && p.base == q.base && meme_indice(p.idx, q.idx);
}

fonction motif_quit(e: Noeud): Quit {
    si !(est_bin(e, "&") && est_nombre(e.b, 3) && est_bin(e.a, ">>")) {
        retour nul;
    }
    soit lu = e.a.a;
    si lu.genre != N_LIRE || lu.a != nul {
        retour nul;
    }
    retour motif_place(lu.val, lu.b, e.a.b);
}

fonction motif_ecriture_quit(s: Noeud): Quit {
    soit nv = s.c;
    si s.a != nul || !(est_bin(nv, "|") && est_bin(nv.a, "&") && est_bin(nv.b, "<<")) {
        retour nul;
    }
    soit lu = nv.a.a;
    soit garde = nv.a.b;
    soit mis = nv.b;
    si !(lu.genre == N_LIRE && lu.a == nul && lu.val == s.val && garde.genre == N_NON && est_bin(garde.a, "<<")
            && est_nombre(garde.a.a, 3) && est_bin(mis.a, "&") && est_nombre(mis.a.b, 3)) {
        retour nul;
    }
    soit q = motif_place(s.val, s.b, garde.a.b);
    si q == nul || !meme_place(motif_place(s.val, lu.b, garde.a.b), q) || !meme_place(motif_place(s.val, s.b, mis.b), q) {
        retour nul;
    }
    q.v = mis.a.a;
    retour q;
}

fonction gen_bin(c: Ctx, e: Noeud) {
    soit o = e.op;
    si c.optim && texte_egal(o, "&") {
        soit q = motif_quit(e);
        si q != nul {
            // LDQ : le quit i d'un tableau rangé, en une instruction
            gen_v(c, q.idx, 0);
            soit rlq = 0;
            si q.base != 0 {
                charger(c, 2, q.base);
                rlq = 2;
            }
            emettre(c, mot(84, (1 << 4) | rlq, 1 << 4, q.etg));
            retour;
        }
    }
    si texte_egal(o, "&&") {
        soit lf = nouvelle_etiquette(c);
        soit fin = nouvelle_etiquette(c);
        saut_faux(c, e.a, lf);
        saut_faux(c, e.b, lf);
        rri(c, 6, 1, 0, 1);
        saut(c, 48, fin);
        poser_etiquette(c, lf);
        rri(c, 6, 1, 0, 0);
        poser_etiquette(c, fin);
        retour;
    }
    si texte_egal(o, "||") {
        soit lb = nouvelle_etiquette(c);
        soit lt = nouvelle_etiquette(c);
        soit lf2 = nouvelle_etiquette(c);
        soit fin2 = nouvelle_etiquette(c);
        saut_faux(c, e.a, lb);
        saut(c, 48, lt);
        poser_etiquette(c, lb);
        saut_faux(c, e.b, lf2);
        poser_etiquette(c, lt);
        rri(c, 6, 1, 0, 1);
        saut(c, 48, fin2);
        poser_etiquette(c, lf2);
        rri(c, 6, 1, 0, 0);
        poser_etiquette(c, fin2);
        retour;
    }
    soit ta = typ(c, e.a);
    soit tb = typ(c, e.b);
    si ta != T_LOG && tb != T_LOG && !est_struct(ta) && !est_struct(tb) {
        si est_comparaison(o) {
            soit tc = joindre_types(c, ta, tb, e.ligne);
            si tc == T_F {
                paire(c, e.a, e.b, T_F);
                si texte_egal(o, "==") || texte_egal(o, "!=") { rrr(c, 68, 1, 1, 2); }
                si texte_egal(o, "<") { rrr(c, 69, 1, 1, 2); }
                si texte_egal(o, "<=") { rrr(c, 70, 1, 1, 2); }
                si texte_egal(o, ">") { rrr(c, 69, 1, 2, 1); }
                si texte_egal(o, ">=") { rrr(c, 70, 1, 2, 1); }
                si texte_egal(o, "!=") {
                    rri(c, 6, 2, 0, 1);
                    rrr(c, 22, 1, 1, 2);
                }
                retour;
            }
            si tc == T_L {
                paire(c, e.a, e.b, T_L);
                soit lv = nouvelle_etiquette(c);
                soit lfin = nouvelle_etiquette(c);
                saut_long(c, o, lv, 1, 4, 2, 5);
                rri(c, 6, 1, 0, 0);
                saut(c, 48, lfin);
                poser_etiquette(c, lv);
                rri(c, 6, 1, 0, 1);
                poser_etiquette(c, lfin);
                retour;
            }
        } sinon {
            soit t = typ(c, e);
            si t == T_F {
                si texte_egal(o, "-") && (e.a.genre == N_NOMBRE || e.a.genre == N_FNOMBRE) && e.a.val == 0 {
                    gen_v(c, e.b, T_F);
                    charger(c, 2, SIGNE);
                    rrr(c, 22, 1, 1, 2);
                    retour;
                }
                paire(c, e.a, e.b, T_F);
                si texte_egal(o, "+") { rrr(c, 64, 1, 1, 2); }
                si texte_egal(o, "-") { rrr(c, 65, 1, 1, 2); }
                si texte_egal(o, "*") { rrr(c, 66, 1, 1, 2); }
                si texte_egal(o, "/") { rrr(c, 67, 1, 1, 2); }
                retour;
            }
            si t == T_L {
                gen_long(c, e);
                retour;
            }
        }
    }
    soit voulu = 0;
    si ta == T_LOG || tb == T_LOG {
        si !(texte_egal(o, "==") || texte_egal(o, "!=")) {
            erreur(c, e.ligne, "opérateur sur un logique : utilisez et4(), ou4(), non4(), anti(), fusion(), consensus()");
        } sinon si ta != tb && e.a.genre != N_BLIT && e.b.genre != N_BLIT {
            erreur(c, e.ligne, "comparaison entre un logique et un entier : utilisez logique() ou entier()");
        }
        voulu = T_LOG;
    } sinon si est_struct(ta) {
        voulu = ta;                  // comparaison de références : à la référence (nul compris)
    } sinon si est_struct(tb) {
        voulu = tb;
    }
    soit ra = 1;
    soit rb = 2;
    si voulu == 0 && !texte_egal(o, "<<q") && !texte_egal(o, ">>q") {
        soit pk = deux_ops(c, e.a, e.b);
        ra = pk >> 4;
        rb = pk & 15;
    } sinon {
        paire(c, e.a, e.b, voulu);
    }
    soit k = code_operation(o);
    si k != 0 {
        rrr(c, k, 1, ra, rb);
    } sinon si texte_egal(o, "<<q") || texte_egal(o, ">>q") {
        rrr(c, 1, 2, 2, 2);
        si texte_egal(o, "<<q") { rrr(c, 8, 1, 1, 2); } sinon { rrr(c, 9, 1, 1, 2); }
    } sinon si texte_egal(o, "==") {
        booleen(c, 49, ra, rb);
    } sinon si texte_egal(o, "!=") {
        booleen(c, 50, ra, rb);
    } sinon si texte_egal(o, "<") {
        booleen(c, 53, ra, rb);
    } sinon si texte_egal(o, ">=") {
        booleen(c, 54, ra, rb);
    } sinon si texte_egal(o, ">") {
        booleen(c, 53, rb, ra);
    } sinon si texte_egal(o, "<=") {
        booleen(c, 54, rb, ra);
    } sinon {
        erreur(c, e.ligne, "opérateur hors du noyau");
    }
}

// --------------------------------------------------------------------------------------------- génération des instructions
// Pas à pas : l'adresse où commence une instruction du programme et sa ligne dans le fichier (pas les fichiers
// importés ni le prélude)
fonction noter_ligne(c: Ctx, ligne) {
    si ligne == 0 || c.fcour == nul || c.fcour.prelude {
        retour;
    }
    soit l = ligne;
    si c.segs_prog != nul {
        soit k = 0 - 1;
        pour i dans 0..c.segs_prog.n / 3 {
            si elem(c.segs_prog, 3 * i) <= ligne {
                k = i;
            }
        }
        si k != 0 - 1 {
            si elem(c.segs_prog, 3 * k + 1) != 0 {
                retour;
            }
            l = elem(c.segs_prog, 3 * k + 2) + ligne - elem(c.segs_prog, 3 * k);
        }
    }
    ajouter(c.dbg, c.code.n);
    ajouter(c.dbg, l);
}

// x = a op b, x entier en registre : le calcul va directement dans le registre de x
fonction reg_direct(c: Ctx, s: Noeud) {
    soit v = var_ou_nul(c, s.nom);
    si v == nul || v.reg == 0 || v.type != 0 {
        retour 0;
    }
    soit x = s.a;
    si x.genre != N_BIN || code_operation(x.op) == 0 {
        retour 0;
    }
    si typ(c, x) != 0 || typ(c, x.a) != 0 || typ(c, x.b) != 0 {
        retour 0;
    }
    soit rt = v.reg;
    si (texte_egal(x.op, "+") || texte_egal(x.op, "-")) && x.a.genre == N_VAR && texte_egal(x.a.nom, s.nom)
            && x.b.genre == N_NOMBRE && x.b.val <= 255 {
        si texte_egal(x.op, "+") {
            rri(c, 6, rt, rt, x.b.val);
        } sinon {
            rri(c, 7, rt, rt, x.b.val);
        }
        retour 1;
    }
    soit pk = deux_ops(c, x.a, x.b);
    rrr(c, code_operation(x.op), rt, pk >> 4, pk & 15);
    retour 1;
}

fonction instr(c: Ctx, s: Noeud) {
    soit g = s.genre;
    si c.lignes_dbg == 1 {
        noter_ligne(c, s.ligne);
    }
    si (g == N_SOIT || g == N_AFFECTER) && c.optim && reg_direct(c, s) {
        retour;
    }
    si g == N_SOIT || g == N_AFFECTER {
        soit v = var_de(c, s.nom, s.ligne);
        si g == N_SOIT && est_struct(s.val) && (s.a.genre == N_VAR || s.a.genre == N_APPEL) && typ(c, s.a) == 0 {
            // soit x: Structure = variable ou appel entier : la déclaration explicite vaut conversion (la racine
            // d'une mémoire rechargée, par exemple) ; un nombre écrit reste refusé
            gen(c, s.a);
        } sinon {
            gen_v(c, s.a, v.type);
        }
        si v.reg != 0 {
            rr(c, 11, v.reg, 1);
        } sinon {
            stf(c, 1, v.off);
        }
        si v.type == T_L {
            stf(c, 4, v.haut);
        }
    } sinon si g == N_ECRIRE {
        si typ(c, s.c) == T_L {
            erreur(c, s.ligne, "un long occupe deux mots : écrivez bas(x) et haut(x) séparément");
        }
        soit qe: Quit = nul;
        si c.optim {
            qe = motif_ecriture_quit(s);
        }
        si qe != nul {
            // STQ : le quit i d'un tableau rangé reçoit la valeur, en une instruction
            deux(c, qe.v, qe.idx);
            soit rbq = 0;
            si qe.base != 0 {
                charger(c, 3, qe.base);
                rbq = 3;
            }
            emettre(c, mot(85, (1 << 4) | rbq, 2 << 4, qe.etg));
        } sinon si s.a == nul {
            gen(c, s.b);
            pousser(c, 1);
            gen(c, s.c);
            rr(c, 11, 2, 1);
            depiler(c, 1);
            emettre(c, mot(33, 18, 0, s.val));
        } sinon {
            gen(c, s.b);
            pousser(c, 1);
            gen(c, s.a);
            pousser(c, 1);
            gen(c, s.c);
            depiler(c, 2);
            depiler(c, 3);
            rrr(c, 42, 3, 1, 2);
        }
    } sinon si g == N_ECRIRE_CHAMP {
        soit t = typ(c, s.a);
        soit pos = position_champ(struct_numero(c, t), s.nom);
        soit tch = champ_de(c, struct_numero(c, t), s.nom).type;
        si tch == T_L {
            erreur(c, s.ligne, "un champ ne peut pas contenir un long");
        }
        gen_v(c, s.c, tch);
        pousser(c, 1);
        adresse_champ(c, s.a, pos);
        depiler(c, 7);
        rrr(c, 42, 1, 7, 2);
    } sinon si g == N_SI {
        soit sinon_ = nouvelle_etiquette(c);
        soit fin = nouvelle_etiquette(c);
        saut_faux(c, s.a, sinon_);
        instrs(c, s.premier);
        si s.val == 1 {
            saut(c, 48, fin);
        }
        poser_etiquette(c, sinon_);
        si s.val == 1 {
            instrs(c, s.deuxieme);
            poser_etiquette(c, fin);
        }
    } sinon si g == N_TANTQUE {
        soit haut = nouvelle_etiquette(c);
        soit fin2 = nouvelle_etiquette(c);
        poser_etiquette(c, haut);
        saut_faux(c, s.a, fin2);
        c.boucles = Boucle { haut: haut, fin: fin2, suivant: c.boucles };
        instrs(c, s.premier);
        c.boucles = c.boucles.suivant;
        saut(c, 48, haut);
        poser_etiquette(c, fin2);
    } sinon si g == N_POUR {
        soit vp = var_de(c, s.nom, s.ligne);
        soit off = vp.off;
        soit haut2 = nouvelle_etiquette(c);
        soit suite = nouvelle_etiquette(c);
        soit fin3 = nouvelle_etiquette(c);
        gen_v(c, s.a, 0);
        si vp.reg != 0 {
            rr(c, 11, vp.reg, 1);
        } sinon {
            stf(c, 1, off);
        }
        poser_etiquette(c, haut2);
        saut_faux(c, bin("<", Noeud { genre: N_VAR, nom: s.nom, ligne: s.ligne }, s.b, s.ligne), fin3);
        c.boucles = Boucle { haut: suite, fin: fin3, suivant: c.boucles };
        instrs(c, s.premier);
        c.boucles = c.boucles.suivant;
        poser_etiquette(c, suite);
        si vp.reg != 0 {
            // la variable de boucle en registre : un seul pas
            si s.val <= 255 {
                rri(c, 6, vp.reg, vp.reg, s.val);
            } sinon {
                charger(c, 2, s.val);
                rrr(c, 1, vp.reg, vp.reg, 2);
            }
        } sinon {
            ldf(c, 1, off);
            si s.val <= 255 {
                rri(c, 6, 1, 1, s.val);
            } sinon {
                charger(c, 2, s.val);
                rrr(c, 1, 1, 1, 2);
            }
            stf(c, 1, off);
        }
        saut(c, 48, haut2);
        poser_etiquette(c, fin3);
    } sinon si g == N_RECRIRE {
        // soit __qi = i ; soit __qv = v ; mot = (mot & ~(3 << d)) | ((__qv & 3) << d)
        soit tr = tableau_de(c, s.nom);
        soit lr = s.ligne;
        soit vi = var_de(c, nom_cache("__qi", s.val), lr);
        soit vv = var_de(c, nom_cache("__qv", s.val), lr);
        gen(c, s.a);
        stf(c, 1, vi.off);
        si tr.sorte == 2 {
            si type_logique(c, s.c) != T_LOG {
                erreur(c, lr, "un tableau de logique reçoit des logiques (vrai, faux, inconnu, variable) : utilisez logique() ou comme_logique()");
            }
            gen_v(c, s.c, T_LOG);
        } sinon {
            gen(c, s.c);
        }
        stf(c, 1, vv.off);
        soit qi = Noeud { genre: N_VAR, nom: vi.nom, ligne: lr };
        soit qv = Noeud { genre: N_VAR, nom: vv.nom, ligne: lr };
        soit m = mot_rangee(tr, qi, lr);
        soit d = decalage_rangee(qi, lr);
        soit garde = bin("&", m, Noeud { genre: N_NON, a: bin("<<", nombre(3, lr), d, lr), ligne: lr }, lr);
        soit neuf = bin("|", garde, bin("<<", bin("&", qv, nombre(3, lr), lr), d, lr), lr);
        instr(c, Noeud { genre: N_ECRIRE, val: tr.etage, b: m.b, c: neuf, ligne: lr });
    } sinon si g == N_ACCORD {
        soit me = s.premier;
        soit k = 1;
        tantque me != nul {
            soit ta = me.premier;
            tantque ta != nul {
                marquer(c, 1, s.val, k);
                instr(c, ta);
                ta = ta.suivant;
            }
            me = me.suivant;
            k = k + 1;
        }
        marquer(c, 2, s.val, 0);
    } sinon si g == N_BLOC {
        instrs(c, s.premier);
    } sinon si g == N_DONNEES {
        soit dn = c.blocs;
        tantque dn != nul {
            si dn.vals.n > 0 {
                ldi_etiquette(c, 1, dn.etiq);
                emettre(c, mot(10, 2 << 4, 0, 0));
                emettre(c, dn.adr);
                emettre(c, mot(10, 3 << 4, 0, 0));
                emettre(c, dn.vals.n);
                rri(c, 6, 4, 0, dn.etage);
                soit boucle = nouvelle_etiquette(c);
                poser_etiquette(c, boucle);
                emettre(c, mot(32, 81, 0, 0));
                rrr(c, 42, 2, 5, 4);
                rri(c, 6, 1, 1, 1);
                rri(c, 6, 2, 2, 1);
                rri(c, 7, 3, 3, 1);
                saut(c, 50, boucle);
            }
            dn = dn.suivant;
        }
    } sinon si (g == N_ARRETER || g == N_CONTINUER) && c.boucles == nul {
        erreur(c, s.ligne, "« arrêter » ou « continuer » hors d'une boucle");
    } sinon si g == N_ARRETER {
        saut(c, 48, c.boucles.fin);
    } sinon si g == N_CONTINUER {
        saut(c, 48, c.boucles.haut);
    } sinon si g == N_RETOUR {
        si s.a == nul {
            rri(c, 6, 1, 0, 0);
            si c.fcour.rtype == T_L {
                rri(c, 6, 4, 0, 0);
            }
        } sinon {
            gen_v(c, s.a, c.fcour.rtype);
        }
        saut(c, 48, c.ffin);
    } sinon si g == N_EXPR {
        gen(c, s.a);
    }
}

fonction instrs(c: Ctx, s: Noeud) {
    tantque s != nul && c.erreur == 0 {
        instr(c, s);
        s = s.suivant;
    }
}

// Variables locales, dans l'ordre de vtx.py : soit et pour, en profondeur (si : alors puis sinon)
fonction locales(c: Ctx, s: Noeud, nl) {
    tantque s != nul {
        si s.genre == N_SOIT || s.genre == N_POUR {
            soit genre = 1;
            si s.genre == N_POUR || (s.op != 0 && texte_egal(s.op, "chaque")) {
                genre = 2;
            }
            soit v = c.vars;
            soit trouve: Var = nul;
            tantque v != nul {
                si texte_egal(v.nom, s.nom) {
                    trouve = v;
                }
                v = v.suivant;
            }
            // la variable d'un « pour x dans t » a le type de ses valeurs (flottant pour un tableau de flottants)
            soit t = 0;
            si s.genre == N_SOIT {
                t = s.val;
                si t == 0 {
                    t = typ(c, s.a);
                }
            }
            si trouve != nul {
                si !(trouve.genre == 2 && genre == 2) {
                    erreur(c, s.ligne, "variable déjà déclarée");
                } sinon si t != trouve.type {
                    erreur(c, s.ligne, "la variable de boucle change de type : donnez-lui un autre nom");
                }
            } sinon {
                nl = nl + 1;
                c.vars = Var { nom: s.nom, off: 0 - nl, type: t, genre: genre, suivant: c.vars };
                si t == T_L {
                    nl = nl + 1;
                    c.vars.haut = 0 - nl;
                }
            }
            si s.genre == N_POUR && !s.copie {
                nl = locales(c, s.premier, nl);
            }
        } sinon si s.genre == N_SI {
            nl = locales(c, s.premier, nl);
            si s.val == 1 {
                nl = locales(c, s.deuxieme, nl);
            }
        } sinon si s.genre == N_TANTQUE || s.genre == N_BLOC {
            nl = locales(c, s.premier, nl);
        } sinon si s.genre == N_ACCORD {
            soit me = s.premier;
            tantque me != nul {
                soit ta = me.premier;
                tantque ta != nul {
                    soit suite_t = ta.suivant;
                    ta.suivant = nul;
                    nl = locales(c, ta, nl);
                    ta.suivant = suite_t;
                    ta = suite_t;
                }
                me = me.suivant;
            }
        } sinon si s.genre == N_RECRIRE {
            c.vars = Var { nom: nom_cache("__qi", s.val), off: 0 - nl - 1, type: 0, genre: 1, suivant: c.vars };
            c.vars = Var { nom: nom_cache("__qv", s.val), off: 0 - nl - 2, type: 0, genre: 1, suivant: c.vars };
            nl = nl + 2;
        }
        s = s.suivant;
    }
    retour nl;
}

// Paramètres : le dernier est à +2, le premier tout en haut ; un long prend deux mots (le haut d'abord)
fonction placer(c: Ctx, p: Param, ligne) {
    si p == nul {
        retour 2;
    }
    soit o = placer(c, p.suivant, ligne);
    soit v = c.vars;
    tantque v != nul {
        si texte_egal(v.nom, p.nom) {
            erreur_nom(c, ligne, "paramètre en double :", p.nom);
        }
        v = v.suivant;
    }
    si p.type == T_L {
        c.vars = Var { nom: p.nom, off: o + 1, haut: o, type: p.type, genre: 3, suivant: c.vars };
        retour o + 2;
    }
    c.vars = Var { nom: p.nom, off: o, type: p.type, genre: 3, suivant: c.vars };
    retour o + 1;
}

// --------------------------------------------------------------------------------------------- épissage
// Le même épissage que vtx.py (voir EPISSAGE dans vtx.py) : les mots d'une fonction sont relus comme une suite
// d'opérations simples, et les introns (déplacements de valeurs) retirés par quatre règles : pile, constante, relecture,
// copie. Chaque règle demande qu'un registre soit mort : l'analyse de vie de R1 à R8 sur le graphe de la fonction le dit.

constante RI_TOUS = 510;            // R1 à R8

// la sorte d'une instruction : 1 d s t (d écrit), 2 d s (d écrit), 3 d écrit seul, 4 d lu (STF), 5 s lu (OUT, PUSH),
// 6 s t lus (CMP), 7 d s lus (ST), 8 d s t lus (STX), 9 saut, 10 appel, 11 retour, 12 arrêt, 0 autre (barrière)
fonction ri_sorte(op) {
    si op == 1 || op == 2 || op == 3 || op == 8 || op == 9 || op == 12 || op == 13 || op == 16 || op == 17 || op == 19
            || op == 20 || op == 21 || op == 22 || op == 56 || (op >= 64 && op <= 70) || op == 78 || op == 79 || op == 41
            || op == 84 || op == 86 || op == 87 || op == 90 {
        retour 1;
    }
    si op == 4 || op == 5 || op == 11 || op == 18 || (op >= 71 && op <= 75) || op == 80 || op == 6 || op == 7 || op == 32
            || op == 88 || op == 89 {
        retour 2;
    }
    si op == 10 || op == 37 || op == 35 || op == 40 { retour 3; }
    si op == 38 { retour 4; }
    si op == 36 || op == 39 { retour 5; }
    si op == 14 { retour 6; }
    si op == 33 { retour 7; }
    si op == 42 || op == 85 { retour 8; }
    si op == 48 || op == 49 || op == 50 || op == 53 || op == 54 { retour 9; }
    si op == 51 { retour 10; }
    si op == 52 { retour 11; }
    si op == 63 { retour 12; }
    retour 0;
}

fonction ri_bit(r) {
    si r >= 1 && r <= 8 {
        retour 1 << r;
    }
    retour 0;
}

// registres écrits (masque de R1 à R8)
fonction ri_ecr(w) {
    soit s = ri_sorte(w >> 24);
    si s == 1 || s == 2 || s == 3 {
        retour ri_bit((w >> 20) & 15);
    }
    retour 0;
}

// registres lus (masque de R1 à R8) ; une barrière les lit tous
fonction ri_lus(w) {
    soit s = ri_sorte(w >> 24);
    soit d = (w >> 20) & 15;
    soit sr = (w >> 16) & 15;
    soit t = (w >> 12) & 15;
    si s == 1 || s == 8 {
        soit m = ri_bit(sr) | ri_bit(t);
        si s == 8 { m = m | ri_bit(d); }
        retour m;
    }
    si s == 2 || s == 5 { retour ri_bit(sr); }
    si s == 4 { retour ri_bit(d); }
    si s == 6 { retour ri_bit(sr) | ri_bit(t); }
    si s == 7 { retour ri_bit(d) | ri_bit(sr); }
    si s == 0 { retour RI_TOUS; }
    retour 0;
}

// tous les registres nommés (R0 à R15), lus ou écrits, d'une instruction simple
fonction ri_nommes(w) {
    soit s = ri_sorte(w >> 24);
    soit d = 1 << ((w >> 20) & 15);
    soit sr = 1 << ((w >> 16) & 15);
    soit t = 1 << ((w >> 12) & 15);
    si s == 1 || s == 8 { retour d | sr | t; }
    si s == 2 || s == 7 { retour d | sr; }
    si s == 3 || s == 4 { retour d; }
    si s == 5 { retour sr; }
    si s == 6 { retour sr | t; }
    retour 0;
}

// les champs registres d'une instruction simple valant a deviennent b
fonction ri_renommer(w, a, b) {
    soit s = ri_sorte(w >> 24);
    soit d = s == 1 || s == 2 || s == 3 || s == 4 || s == 7 || s == 8;
    soit sr = s == 1 || s == 2 || s == 5 || s == 6 || s == 7 || s == 8;
    soit t = s == 1 || s == 6 || s == 8;
    si d && ((w >> 20) & 15) == a { w = (w & ~(15 << 20)) | (b << 20); }
    si sr && ((w >> 16) & 15) == a { w = (w & ~(15 << 16)) | (b << 16); }
    si t && ((w >> 12) & 15) == a { w = (w & ~(15 << 12)) | (b << 12); }
    retour w;
}

// une instruction dont le premier registre est seulement écrit (pour la règle copie) : comme RI_DEST de vtx.py
fonction ri_dest(op) {
    soit s = ri_sorte(op);
    retour s == 1 || s == 2 || op == 10 || op == 37;
}

// les instructions d'une fonction : mot, mot suivant (LDI), place d'origine, étiquette avant, vivants après, cible
structure Ep { w: Liste, x: Liste, p: Liste, e: Liste, v: Liste, av: Liste, t: Liste, r: Liste, n }

fonction ep_ajouter(ep: Ep, w, x, p, e, v, t) {
    ajouter(ep.w, w);
    ajouter(ep.x, x);
    ajouter(ep.p, p);
    ajouter(ep.e, e);
    ajouter(ep.v, v);
    ajouter(ep.av, 0);
    ajouter(ep.t, t);
    ajouter(ep.r, 0);
    ep.n = ep.n + 1;
}

fonction ep_neuf(): Ep {
    retour Ep { w: liste(), x: liste(), p: liste(), e: liste(), v: liste(), av: liste(), t: liste(), r: liste() };
}

// l'indice de la première instruction gardée placée à partir de pos (ep.n s'il n'y en a pas)
fonction ep_indice(ep: Ep, pos) {
    soit a = 0;
    soit b = ep.n;
    tantque a < b {
        soit m = (a + b) / 2;
        si elem(ep.p, m) < pos {
            a = m + 1;
        } sinon {
            b = m;
        }
    }
    retour a;
}

// l'analyse de vie : les registres de R1 à R8 vivants après chaque instruction
fonction ep_vie(c: Ctx, ep: Ep) {
    soit n = ep.n;
    pour k0 dans 0..n {
        poser(ep.v, k0, 0);
        poser(ep.av, k0, 0);
    }
    soit change = 1;
    tantque change {
        change = 0;
        soit k = n;
        tantque k > 0 {
            k = k - 1;
            soit w = elem(ep.w, k);
            soit s = ri_sorte(w >> 24);
            soit a = 0;
            soit lus = 0;
            soit ecr = 0;
            si s == 9 {
                si (w >> 24) != 48 && k + 1 < n {
                    a = elem(ep.av, k + 1);
                }
                soit pc = elem(ep.t, k);
                si pc == 0 - 1 {
                    lus = RI_TOUS;
                } sinon {
                    soit ti = ep_indice(ep, pc);
                    si ti < n {
                        a = a | elem(ep.av, ti);
                    }
                }
            } sinon si s == 10 {
                si k + 1 < n {
                    a = elem(ep.av, k + 1);
                }
                ecr = RI_TOUS;
            } sinon si s == 11 {
                lus = 18;                       // R1 et R4
            } sinon si s == 12 {
                a = 0;
            } sinon {
                si k + 1 < n {
                    a = elem(ep.av, k + 1);
                }
                lus = ri_lus(w);
                ecr = ri_ecr(w);
            }
            soit v = lus | (a & ~ecr);
            si a != elem(ep.v, k) || v != elem(ep.av, k) {
                poser(ep.v, k, a);
                poser(ep.av, k, v);
                change = 1;
            }
        }
    }
}

// l'instruction après j s'il n'y a pas d'étiquette entre elles, sinon -1
// (les instructions retirées pendant un tour restent en place, transparentes, jusqu'au tassement de la fin du tour ;
// une étiquette posée devant l'une d'elles sépare toujours)
fonction ep_suivant(ep: Ep, j) {
    soit k = j + 1;
    tantque k < ep.n && elem(ep.r, k) == 1 {
        si elem(ep.e, k) == 1 {
            retour 0 - 1;
        }
        k = k + 1;
    }
    si k < ep.n && elem(ep.e, k) == 0 {
        retour k;
    }
    retour 0 - 1;
}

fonction ep_mort(ep: Ep, j, r) {
    retour ((elem(ep.v, j) >> r) & 1) == 0;
}

fonction ep_op(ep: Ep, j) {
    retour elem(ep.w, j) >> 24;
}

fonction ep_d(ep: Ep, j) { retour (elem(ep.w, j) >> 20) & 15; }
fonction ep_s(ep: Ep, j) { retour (elem(ep.w, j) >> 16) & 15; }
fonction ep_t(ep: Ep, j) { retour (elem(ep.w, j) >> 12) & 15; }

// retire l'instruction j (marquée ; l'étiquette éventuelle passe à la suivante au moment du tassement)
fonction ep_retirer(ep: Ep, j) {
    poser(ep.r, j, 1);
}

// règle pile : PUSH R1 ; S ; MOV R2,R1 ; POP R1  ->  S (R1 devient Rf) ; MOV R2,Rf
fonction regle_pile(ep: Ep, i) {
    si ep_op(ep, i) != 39 || ep_s(ep, i) != 1 {
        retour 0;
    }
    soit j = ep_suivant(ep, i);
    soit ns = 0;
    tantque j >= 0 && !(ep_op(ep, j) == 11 && ep_d(ep, j) == 2 && ep_s(ep, j) == 1) {
        soit op = ep_op(ep, j);
        soit s = ri_sorte(op);
        si s == 0 || s >= 9 || op == 39 || op == 40 {
            retour 0;
        }
        ns = ns + 1;
        j = ep_suivant(ep, j);
    }
    si j < 0 || ns == 0 {
        retour 0;
    }
    soit jp = ep_suivant(ep, j);
    si jp < 0 || ep_op(ep, jp) != 40 || ep_d(ep, jp) != 1 {
        retour 0;
    }
    soit vus = 0;
    pour k dans i + 1..j {
        si elem(ep.r, k) == 0 {
            vus = vus | ri_nommes(elem(ep.w, k));
        }
    }
    si (vus & (1 << 13)) != 0 || (vus & (1 << 14)) != 0 {
        retour 0;
    }
    // R1 doit être écrit dans S avant d'y être lu
    soit vu = 0;
    pour k dans i + 1..j {
        si vu == 0 && elem(ep.r, k) == 0 {
            soit w = elem(ep.w, k);
            si (ri_lus(w) & 2) != 0 {
                retour 0;
            }
            si (ri_ecr(w) & 2) != 0 {
                vu = 1;
            }
        }
    }
    si vu == 0 {
        retour 0;
    }
    soit f = 0;
    soit cand = 3;
    tantque f == 0 && cand <= 8 {
        si cand != 4 && (vus & (1 << cand)) == 0 && ep_mort(ep, jp, cand) {
            f = cand;
        }
        cand = cand + 1;
    }
    si f == 0 {
        retour 0;
    }
    pour k dans i + 1..j {
        si elem(ep.r, k) == 0 {
            poser(ep.w, k, ri_renommer(elem(ep.w, k), 1, f));
        }
    }
    poser(ep.w, j, mot(11, (2 << 4) | f, 0, 0));
    // la vie des registres dans le passage réécrit, refaite en remontant depuis la fin
    soit vivants = elem(ep.v, jp);
    soit kk = j + 1;
    tantque kk > i + 1 {
        kk = kk - 1;
        si elem(ep.r, kk) == 0 {
            poser(ep.v, kk, vivants);
            soit wk = elem(ep.w, kk);
            vivants = (vivants & ~ri_ecr(wk)) | ri_lus(wk);
        }
    }
    ep_retirer(ep, i);
    ep_retirer(ep, jp);
    retour 1;
}

// règle constante : ADDI Rk,R0,#c ; ADD Rd,Ra,Rk  ->  ADDI Rd,Ra,#c (de même SUB -> SUBI)
fonction regle_constante(ep: Ep, i) {
    soit j = ep_suivant(ep, i);
    si ep_op(ep, i) != 6 || j < 0 || (ep_op(ep, j) != 1 && ep_op(ep, j) != 2) {
        retour 0;
    }
    soit k = ep_d(ep, i);
    si ep_s(ep, i) != 0 || k == 0 {
        retour 0;
    }
    soit cst = (elem(ep.w, i) >> 8) & 255;
    soit d = ep_d(ep, j);
    soit a = ep_s(ep, j);
    soit b = ep_t(ep, j);
    soit src = 0 - 1;
    si b == k && a != k {
        src = a;
    } sinon si ep_op(ep, j) == 1 && a == k && b != k {
        src = b;
    }
    si src == 0 - 1 {
        retour 0;
    }
    si k != d && !ep_mort(ep, j, k) {
        retour 0;
    }
    soit nop = 6;
    si ep_op(ep, j) == 2 {
        nop = 7;
    }
    poser(ep.w, j, mot(nop, (d << 4) | src, cst, 0));
    ep_retirer(ep, i);
    retour 1;
}

// règle relecture : STF Ra,#o ; LDF Rb,#o  ->  STF Ra,#o, puis MOV Rb,Ra si Rb n'est pas Ra
fonction regle_relecture(ep: Ep, i) {
    soit j = ep_suivant(ep, i);
    si ep_op(ep, i) != 38 || j < 0 || ep_op(ep, j) != 37 || ((elem(ep.w, i) >> 8) & 255) != ((elem(ep.w, j) >> 8) & 255) {
        retour 0;
    }
    soit a = ep_d(ep, i);
    soit b = ep_d(ep, j);
    si a == b {
        ep_retirer(ep, j);
    } sinon {
        poser(ep.w, j, mot(11, (b << 4) | a, 0, 0));
    }
    retour 1;
}

// règle copie : OP Rx,… ; MOV Ry,Rx  ->  OP Ry,…
fonction regle_copie(ep: Ep, i) {
    soit j = ep_suivant(ep, i);
    si !ri_dest(ep_op(ep, i)) || j < 0 || ep_op(ep, j) != 11 {
        retour 0;
    }
    soit x = ep_d(ep, i);
    soit y = ep_d(ep, j);
    si ep_s(ep, j) != x || y == x || x < 1 || x > 8 || y == 0 || y == 13 || y == 14 || y == 15 || !ep_mort(ep, j, x) {
        retour 0;
    }
    poser(ep.w, i, (elem(ep.w, i) & ~(15 << 20)) | (y << 20));
    poser(ep.v, i, elem(ep.v, j));
    ep_retirer(ep, j);
    retour 1;
}

// les instructions retirées s'en vont ; une étiquette posée devant passe à l'instruction suivante
fonction ep_tasser(ep: Ep) {
    soit m = 0;
    soit report = 0;
    pour k dans 0..ep.n {
        si elem(ep.r, k) == 1 {
            si elem(ep.e, k) == 1 {
                report = 1;
            }
        } sinon {
            poser(ep.w, m, elem(ep.w, k));
            poser(ep.x, m, elem(ep.x, k));
            poser(ep.p, m, elem(ep.p, k));
            poser(ep.r, m, 0);
            poser(ep.e, m, elem(ep.e, k) | report);
            poser(ep.v, m, elem(ep.v, k));
            poser(ep.t, m, elem(ep.t, k));
            report = 0;
            m = m + 1;
        }
    }
    ep.n = m;
    ep.w.n = m;
    ep.x.n = m;
    ep.p.n = m;
    ep.e.n = m;
    ep.v.n = m;
    ep.av.n = m;
    ep.t.n = m;
    ep.r.n = m;
}

// l'épissage d'une fonction dont le code commence à debut ; fdeb : ses premiers renvois de sauts ; edeb : ses premières
// étiquettes
fonction episser(c: Ctx, debut, fdeb, edeb) {
    soit fin = c.code.n;
    soit ep = ep_neuf();
    // les étiquettes visées par un saut de la fonction séparent les instructions ; les autres sont transparentes
    soit marque = liste();
    pour q dans debut..fin {
        ajouter(marque, 0);
    }
    pour h dans fdeb..c.fix_pos.n {
        soit pos = elem(c.fix_pos, h);
        si elem(c.fix_genre, h) == 0 && ri_sorte(elem(c.code, pos) >> 24) == 9 {
            soit cible = elem(c.etiq, elem(c.fix_etiq, h));
            si cible != 0 - 1 && cible >= debut && cible < fin {
                poser(marque, cible - debut, 1);
            }
        }
    }
    soit h2 = fdeb;
    soit pos2 = debut;
    tantque pos2 < fin {
        soit w = elem(c.code, pos2);
        soit x = 0;
        soit lg = 1;
        si (w >> 24) == 10 {
            x = elem(c.code, pos2 + 1);
            lg = 2;
        }
        // la cible d'un saut : la place de son étiquette dans la fonction, sinon -1 (inconnue)
        soit t = 0 - 1;
        tantque h2 < c.fix_pos.n && elem(c.fix_pos, h2) < pos2 {
            h2 = h2 + 1;
        }
        si h2 < c.fix_pos.n && elem(c.fix_pos, h2) == pos2 && ri_sorte(w >> 24) == 9 {
            soit cb = elem(c.etiq, elem(c.fix_etiq, h2));
            si cb != 0 - 1 && cb >= debut && cb <= fin {
                t = cb;
            }
        }
        ep_ajouter(ep, w, x, pos2, elem(marque, pos2 - debut), 0, t);
        pos2 = pos2 + lg;
    }
    soit change = 1;
    tantque change {
        change = 0;
        ep_vie(c, ep);
        soit i = 0;
        tantque i < ep.n {
            si elem(ep.r, i) == 0 && (regle_pile(ep, i) || regle_constante(ep, i) || regle_relecture(ep, i)
                                      || regle_copie(ep, i)) {
                change = 1;
            } sinon {
                i = i + 1;
            }
        }
        ep_tasser(ep);
    }
    // le code réécrit, puis les étiquettes et les renvois déplacés
    soit np = liste();
    c.code.n = debut;
    pour k dans 0..ep.n {
        ajouter(np, c.code.n);
        emettre(c, elem(ep.w, k));
        si (elem(ep.w, k) >> 24) == 10 {
            emettre(c, elem(ep.x, k));
        }
    }
    pour id dans edeb..c.etiq.n {
        soit pe = elem(c.etiq, id);
        si pe != 0 - 1 && pe >= debut {
            soit ke = ep_indice(ep, pe);
            si ke < ep.n {
                poser(c.etiq, id, elem(np, ke));
            } sinon {
                poser(c.etiq, id, c.code.n);
            }
        }
    }
    pour h3 dans fdeb..c.fix_pos.n {
        soit pf = elem(c.fix_pos, h3);
        soit kf = ep_indice(ep, pf);
        si kf < ep.n && elem(ep.p, kf) == pf {
            poser(c.fix_pos, h3, elem(np, kf));
        } sinon {
            poser(c.fix_pos, h3, elem(np, kf - 1) + 1);
        }
    }
}

// --------------------------------------------------------------------------------------------- variables en registres
// Les variables les plus utilisées dans les boucles (usages pondérés : x8 par niveau de boucle) vivent dans R9 à R12 ;
// la fonction garde ces registres dans des cases cachées de son cadre et les remet à la sortie (même règle que vtx.py).
fonction commence(t, p) {
    si longueur(t) < longueur(p) {
        retour 0;
    }
    pour i dans 0..longueur(p) {
        si car(t, i) != car(p, i) {
            retour 0;
        }
    }
    retour 1;
}

fonction var_ou_nul(c: Ctx, nom): Var {
    soit v = c.vars;
    tantque v != nul {
        si texte_egal(v.nom, nom) {
            retour v;
        }
        v = v.suivant;
    }
    retour nul;
}

fonction poids_boucle(d) {
    si d > 3 {
        d = 3;
    }
    retour 1 << (3 * d);
}

fonction compter_nom(c: Ctx, nom, w) {
    soit v = var_ou_nul(c, nom);
    si v != nul {
        v.score = v.score + w;
    }
}

fonction compter(c: Ctx, x: Noeud, d) {
    tantque x != nul {
        soit g = x.genre;
        si g == N_VAR {
            compter_nom(c, x.nom, poids_boucle(d));
        } sinon si g == N_SOIT || g == N_AFFECTER {
            compter_nom(c, x.nom, poids_boucle(d));
            compter(c, x.a, d);
        } sinon si g == N_RLIRE {
            // vtx.py écrit l'indice deux fois (le mot, puis la place dans le mot) : compté deux fois
            compter(c, x.a, d);
            compter(c, x.a, d);
        } sinon si g == N_TANTQUE {
            compter(c, x.a, d + 1);
            compter(c, x.premier, d + 1);
        } sinon si g == N_POUR {
            compter_nom(c, x.nom, poids_boucle(d) + 3 * poids_boucle(d + 1));
            compter(c, x.a, d);
            compter(c, x.b, d + 1);
            compter(c, x.premier, d + 1);
        } sinon {
            compter(c, x.a, d);
            compter(c, x.b, d);
            compter(c, x.c, d);
            compter(c, x.premier, d);
            compter(c, x.deuxieme, d);
        }
        x = x.suivant;
    }
}

// accords, segments, hypothèses : les variables restent dans le cadre
fonction sans_registres(x: Noeud) {
    tantque x != nul {
        si x.genre == N_ACCORD || (x.genre == N_POUR && x.c != nul && x.c.genre == N_INFO) {
            retour 1;
        }
        si x.genre == N_APPEL && x.nom != 0 && commence(x.nom, "__hyp") {
            retour 1;
        }
        si sans_registres(x.a) || sans_registres(x.b) || sans_registres(x.c) || sans_registres(x.premier)
                || sans_registres(x.deuxieme) {
            retour 1;
        }
        x = x.suivant;
    }
    retour 0;
}

// le ramasse-miettes lit la pile : il y range les quatre registres, où ses appelants gardent peut-être des adresses
fonction appelle_pile(x: Noeud) {
    tantque x != nul {
        si x.genre == N_APPEL && x.nom != 0 && texte_egal(x.nom, "pile") {
            retour 1;
        }
        si appelle_pile(x.a) || appelle_pile(x.b) || appelle_pile(x.c) || appelle_pile(x.premier)
                || appelle_pile(x.deuxieme) {
            retour 1;
        }
        x = x.suivant;
    }
    retour 0;
}

fonction choisir_registres(c: Ctx, f: Fonction) {
    si !c.optim || c.lignes_dbg == 1 || sans_registres(f.corps) {
        retour 0;
    }
    compter(c, f.corps, 0);
    soit n = 0;
    tantque n < 4 {
        soit m: Var = nul;
        soit v = c.vars;
        tantque v != nul {
            si v.reg == 0 && v.score >= 16 && v.type != T_L && !commence(v.nom, "__q") {
                // à égalité, la plus haute dans le cadre (les décalages sont signés)
                si m == nul || v.score > m.score || (v.score == m.score && (v.off ^ 2147483648) > (m.off ^ 2147483648)) {
                    m = v;
                }
            }
            v = v.suivant;
        }
        si m == nul {
            retour n;
        }
        m.reg = 9 + n;
        n = n + 1;
    }
    retour n;
}

// le registre d'une variable entière en registre, sinon 0
fonction reg_var(c: Ctx, e: Noeud) {
    si c.optim && e.genre == N_VAR {
        soit v = var_ou_nul(c, e.nom);
        si v != nul && v.reg != 0 && v.type == 0 {
            retour v.reg;
        }
    }
    retour 0;
}

// les deux opérandes entiers d'une opération, lus sur place quand ils sont en registres : rend ra * 16 + rb
fonction deux_ops(c: Ctx, a: Noeud, b: Noeud) {
    soit ra = reg_var(c, a);
    soit rb = reg_var(c, b);
    si ra != 0 && rb != 0 {
        retour ra * 16 + rb;
    }
    si ra != 0 {
        si b.genre == N_BLIT {
            charger(c, 2, b.val == 2);
        } sinon si b.genre == N_NOMBRE || b.genre == N_QNOMBRE {
            charger(c, 2, b.val);
        } sinon si b.genre == N_VAR && var_de(c, b.nom, b.ligne).type == 0 {
            ldf(c, 2, var_de(c, b.nom, b.ligne).off);
        } sinon {
            gen_v(c, b, 0);
            rr(c, 11, 2, 1);
        }
        retour ra * 16 + 2;
    }
    si rb != 0 {
        gen_v(c, a, 0);
        retour 16 + rb;
    }
    deux(c, a, b);
    retour 18;
}

fonction fonction_code(c: Ctx, f: Fonction) {
    soit debut = c.code.n;
    soit fdeb = c.fix_pos.n;
    soit edeb = c.etiq.n;
    c.fcour = f;
    c.vars = nul;
    c.boucles = nul;
    soit o = placer(c, f.params, f.ligne);
    soit nl = locales(c, f.corps, 0);
    soit ng = choisir_registres(c, f);
    si c.optim && c.lignes_dbg != 1 && appelle_pile(f.corps) {
        ng = 4;
    }
    si o > 128 || nl + ng > 127 {
        erreur(c, f.ligne, "trop de paramètres ou de variables");
    }
    poser_etiquette(c, f.etiq);
    pousser(c, 13);
    rr(c, 11, 13, 14);
    si nl + ng != 0 {
        rri(c, 7, 14, 14, nl + ng);
    }
    // les registres gardés dans des cases cachées, puis les paramètres en registres chargés
    pour k dans 0..ng {
        stf(c, 9 + k, 0 - (nl + 1 + k));
    }
    pour r dans 9..13 {
        soit v = c.vars;
        tantque v != nul {
            si v.reg == r && v.off < 128 && v.off > 0 {
                ldf(c, r, v.off);
            }
            v = v.suivant;
        }
    }
    c.ffin = nouvelle_etiquette(c);
    instrs(c, f.corps);
    rri(c, 6, 1, 0, 0);
    si f.rtype == T_L {
        rri(c, 6, 4, 0, 0);
    }
    poser_etiquette(c, c.ffin);
    pour k dans 0..ng {
        ldf(c, 9 + k, 0 - (nl + 1 + k));
    }
    rr(c, 11, 14, 13);
    depiler(c, 13);
    emettre(c, mot(52, 0, 0, 0));
    // l'épissage : pas au pas à pas, ni dans __init, ni avec des accords, des segments ou une hypothèse
    si c.optim && c.lignes_dbg != 1 && !texte_egal(f.nom, "__init") && !sans_registres(f.corps) {
        episser(c, debut, fdeb, edeb);
    }
}

// --------------------------------------------------------------------------------------------- partition des tâches
// Une suite d'au moins deux appels de fonctions écrits comme instructions forme un accord : le compilateur calcule ce
// que chaque appel lit et écrit (zones de mémoire, entrées et sorties), range dans une même mesure les tâches sans
// conflit, et l'ordre d'exécution devient celui de la partition. Une boucle en segments devient un accord de segments.
// Les zones sont des triplets (étage, début, fin) ; étage 4 : inconnu (tous), 5 : entrées et sorties.

fonction zone_ajouter(l: Liste, e, lo, hi) {
    pour i dans 0..l.n / 3 {
        si elem(l, 3 * i) == e && elem(l, 3 * i + 1) == lo && elem(l, 3 * i + 2) == hi {
            retour 0;
        }
    }
    ajouter(l, e);
    ajouter(l, lo);
    ajouter(l, hi);
    retour 1;
}

fonction tout(l: Liste) {
    zone_ajouter(l, ZONE_TOUT, 0, 16777216);
}

fonction es(l: Liste) {
    zone_ajouter(l, ZONE_ES, 0, 1);
}

fonction zones_conflit(ea, la, ha, eb, lb, hb) {
    si ea == ZONE_ES || eb == ZONE_ES {
        retour ea == eb;
    }
    si ea != ZONE_TOUT && eb != ZONE_TOUT && ea != eb {
        retour 0;
    }
    retour la < hb && lb < ha;
}

fonction ensembles_conflit(a: Liste, b: Liste) {
    pour i dans 0..a.n / 3 {
        pour j dans 0..b.n / 3 {
            si zones_conflit(elem(a, 3 * i), elem(a, 3 * i + 1), elem(a, 3 * i + 2), elem(b, 3 * j), elem(b, 3 * j + 1),
                             elem(b, 3 * j + 2)) {
                retour 1;
            }
        }
    }
    retour 0;
}

fonction union_zones(a: Liste, b: Liste) {
    soit change = 0;
    pour i dans 0..b.n / 3 {
        si zone_ajouter(a, elem(b, 3 * i), elem(b, 3 * i + 1), elem(b, 3 * i + 2)) {
            change = 1;
        }
    }
    retour change;
}

fonction zone_table(c: Ctx, l: Liste, nom) {
    soit t = tableau_de(c, nom);
    zone_ajouter(l, t.etage, t.base, t.base + mots_tableau(c, t));
}

// Ce qu'un accès mémoire lit ou écrit : la zone du tableau, une case, un étage entier, ou tout
fonction zone_acces(n: Noeud, l: Liste) {
    si n.zet != 0 {
        zone_ajouter(l, n.zet - 1, n.zlo, n.zhi);
    } sinon si n.a == nul {
        si n.b.genre == N_NOMBRE {
            zone_ajouter(l, n.val, n.b.val, n.b.val + 1);
        } sinon {
            zone_ajouter(l, n.val, 0, 16777216);
        }
    } sinon {
        tout(l);
    }
}

fonction effets_appel(c: Ctx, nom, r: Liste, w: Liste) {
    si texte_egal(nom, "sortie") || texte_egal(nom, "entrée") || texte_egal(nom, "bruit") || texte_egal(nom, "pile") {
        es(r);
        es(w);
        retour;
    }
    si texte_egal(nom, "__service") {
        es(r);
        tout(r);
        es(w);
        tout(w);
        retour;
    }
    si texte_egal(nom, "gemv") {
        zone_ajouter(r, 2, 0, 16777216);
        zone_ajouter(w, 2, 0, 16777216);
        retour;
    }
    si texte_egal(nom, "lire_car") || texte_egal(nom, "ecrire_car") || texte_egal(nom, "ouvrir_lecture")
        || texte_egal(nom, "ouvrir_ecriture") || texte_egal(nom, "fermer") || texte_egal(nom, "fin_de") {
        es(r);
        tout(r);
        es(w);
        retour;
    }
    si est_integre(nom) {
        retour;
    }
    soit f = fonction_de(c, nom);
    si f != nul && f.garde {
        union_zones(r, f.er);
        union_zones(w, f.ew);
        retour;
    }
    tout(r);
    tout(w);
}

fonction parcourir_liste(c: Ctx, x: Noeud, r: Liste, w: Liste) {
    tantque x != nul {
        parcourir(c, x, r, w);
        x = x.suivant;
    }
}

fonction parcourir(c: Ctx, n: Noeud, r: Liste, w: Liste) {
    si n == nul {
        retour;
    }
    soit g = n.genre;
    si g == N_LIRE {
        zone_acces(n, r);
    } sinon si g == N_RLIRE {
        zone_table(c, r, n.nom);
    } sinon si g == N_ECRIRE {
        zone_acces(n, w);
    } sinon si g == N_RECRIRE {
        zone_table(c, w, n.nom);
        zone_table(c, r, n.nom);
    } sinon si g == N_DONNEES {
        tout(r);
        tout(w);
    } sinon si g == N_CHAMP && !(texte_egal(n.nom, "r") || texte_egal(n.nom, "v") || texte_egal(n.nom, "b") || texte_egal(n.nom, "a")) {
        tout(r);
    } sinon si g == N_ECRIRE_CHAMP {
        tout(w);
    } sinon si g == N_CONSTRUIRE || g == N_NOUVEAU {
        tout(r);
        tout(w);
    } sinon si g == N_POUR && n.c != nul && n.c.genre == N_INFO && n.c.premier != nul {
        zone_ajouter(r, 3, COPIES_DEBUT, COPIES_FIN);
        zone_ajouter(w, 3, COPIES_DEBUT, COPIES_FIN);
    } sinon si g == N_APPEL {
        effets_appel(c, n.nom, r, w);
    }
    si g != N_INFO {
        parcourir(c, n.a, r, w);
        parcourir(c, n.b, r, w);
        parcourir(c, n.c, r, w);
        parcourir_liste(c, n.premier, r, w);
        parcourir_liste(c, n.deuxieme, r, w);
    }
}

// Lectures et écritures de chaque fonction gardée, appels compris (point fixe)
fonction calculer_effets(c: Ctx) {
    soit f = c.fonctions;
    tantque f != nul {
        f.er = liste();
        f.ew = liste();
        f = f.suivant;
    }
    soit change = 1;
    tantque change {
        change = 0;
        f = c.fonctions;
        tantque f != nul {
            si f.garde {
                soit r = liste();
                soit w = liste();
                parcourir_liste(c, f.corps, r, w);
                si union_zones(f.er, r) {
                    change = 1;
                }
                si union_zones(f.ew, w) {
                    change = 1;
                }
            }
            f = f.suivant;
        }
    }
}

fonction est_tache(c: Ctx, s: Noeud) {
    si s.genre != N_EXPR || s.a.genre != N_APPEL {
        retour 0;
    }
    soit f = fonction_de(c, s.a.nom);
    retour f != nul && f.garde && !(car(s.a.nom, 0) == '_' && car(s.a.nom, 1) == '_');
}

// Si l'adresse est base + var + k (ou var + k), rend 1 et range k dans c.lex_val
fonction decalage_var(e: Noeud, var, c: Ctx) {
    si meme_var(e, var) {
        c.lex_val = 0;
        retour 1;
    }
    si e.genre == N_BIN && (texte_egal(e.op, "+") || texte_egal(e.op, "-")) && meme_var(e.a, var) && e.b.genre == N_NOMBRE {
        c.lex_val = e.b.val;
        si texte_egal(e.op, "-") {
            c.lex_val = 0 - e.b.val;
        }
        retour 1;
    }
    retour 0;
}

fonction indice_de(c: Ctx, adr: Noeud, var) {
    si decalage_var(adr, var, c) {
        retour 1;
    }
    si adr.genre == N_BIN && texte_egal(adr.op, "+") && adr.a.genre == N_NOMBRE {
        retour decalage_var(adr.b, var, c);
    }
    retour 0;
}

// Le noeud est-il un accès à un tableau cumulé (zone privée de chaque segment) ?
fonction zone_privee(n: Noeud, privees: Liste) {
    si n.zet == 0 {
        retour 0;
    }
    pour i dans 0..privees.n / 3 {
        si elem(privees, 3 * i) == n.zet - 1 && elem(privees, 3 * i + 1) == n.zlo && elem(privees, 3 * i + 2) == n.zhi {
            retour 1;
        }
    }
    retour 0;
}

fonction marche_liste(c: Ctx, x: Noeud, var, privees: Liste, r: Liste, w: Liste, wi: Liste) {
    tantque x != nul {
        marche(c, x, var, privees, r, w, wi);
        x = x.suivant;
    }
}

// wi : (étage, début, fin, décalage) des écritures tableau[var + décalage]
fonction marche(c: Ctx, n: Noeud, var, privees: Liste, r: Liste, w: Liste, wi: Liste) {
    si n == nul {
        retour;
    }
    soit g = n.genre;
    si (g == N_LIRE || g == N_ECRIRE) && zone_privee(n, privees) {
        marche(c, n.b, var, privees, r, w, wi);
        marche(c, n.c, var, privees, r, w, wi);
        retour;
    }
    si g == N_ECRIRE && n.zet != 0 && n.a == nul && indice_de(c, n.b, var) {
        soit k = c.lex_val;
        soit trouve = 0;
        pour i dans 0..wi.n / 4 {
            si elem(wi, 4 * i) == n.zet - 1 && elem(wi, 4 * i + 1) == n.zlo && elem(wi, 4 * i + 2) == n.zhi
                && elem(wi, 4 * i + 3) == k {
                trouve = 1;
            }
        }
        si !trouve {
            ajouter(wi, n.zet - 1);
            ajouter(wi, n.zlo);
            ajouter(wi, n.zhi);
            ajouter(wi, k);
        }
        marche(c, n.b, var, privees, r, w, wi);
        marche(c, n.c, var, privees, r, w, wi);
        retour;
    }
    si g == N_RECRIRE {
        marche(c, n.a, var, privees, r, w, wi);
        marche(c, n.c, var, privees, r, w, wi);
        zone_table(c, w, n.nom);
        zone_table(c, r, n.nom);
        retour;
    }
    si g == N_LIRE || g == N_ECRIRE || g == N_RLIRE || g == N_DONNEES || g == N_APPEL || g == N_ECRIRE_CHAMP
        || g == N_NOUVEAU || g == N_CONSTRUIRE
        || (g == N_CHAMP && !(texte_egal(n.nom, "r") || texte_egal(n.nom, "v") || texte_egal(n.nom, "b") || texte_egal(n.nom, "a"))) {
        parcourir(c, n, r, w);
        retour;
    }
    si g == N_POUR && n.c != nul && n.c.genre == N_INFO && n.c.premier != nul {
        zone_ajouter(r, 3, COPIES_DEBUT, COPIES_FIN);
        zone_ajouter(w, 3, COPIES_DEBUT, COPIES_FIN);
    }
    si g != N_INFO {
        marche(c, n.a, var, privees, r, w, wi);
        marche(c, n.b, var, privees, r, w, wi);
        marche(c, n.c, var, privees, r, w, wi);
        marche_liste(c, n.premier, var, privees, r, w, wi);
        marche_liste(c, n.deuxieme, var, privees, r, w, wi);
    }
}

// Deux segments d'une même boucle sont-ils indépendants ? Les écritures tableau[i + k] d'un segment ne touchent que
// ses propres indices ; les tableaux cumulés ont une copie par segment ; tout le reste est pris en entier.
fonction segments_independants(c: Ctx, st: Noeud, privees: Liste) {
    soit r = liste();
    soit w = liste();
    soit wi = liste();
    marche_liste(c, st.premier, st.nom, privees, r, w, wi);
    soit zi = liste();
    pour i dans 0..wi.n / 4 {
        zone_ajouter(zi, elem(wi, 4 * i), elem(wi, 4 * i + 1), elem(wi, 4 * i + 2));
    }
    pour k dans 0..privees.n / 3 {
        soit z = liste();
        zone_ajouter(z, elem(privees, 3 * k), elem(privees, 3 * k + 1), elem(privees, 3 * k + 2));
        si ensembles_conflit(z, r) || ensembles_conflit(z, w) || ensembles_conflit(z, zi) {
            erreur(c, st.ligne, "un tableau cumulé est aussi atteint autrement que par son nom dans la boucle (fonction appelée ou adresse calculée) : la somme des segments ne serait pas sûre");
        }
    }
    si ensembles_conflit(w, w) || ensembles_conflit(w, r) || ensembles_conflit(w, zi) || ensembles_conflit(zi, r) {
        retour 0;
    }
    // une seule case par zone (décalage unique), et des zones qui ne se recouvrent pas
    pour i dans 0..wi.n / 4 {
        pour j dans 0..wi.n / 4 {
            soit meme_zone = elem(wi, 4 * i) == elem(wi, 4 * j) && elem(wi, 4 * i + 1) == elem(wi, 4 * j + 1)
                && elem(wi, 4 * i + 2) == elem(wi, 4 * j + 2);
            si meme_zone && elem(wi, 4 * i + 3) != elem(wi, 4 * j + 3) {
                retour 0;
            }
            si !meme_zone && zones_conflit(elem(wi, 4 * i), elem(wi, 4 * i + 1), elem(wi, 4 * i + 2), elem(wi, 4 * j),
                                          elem(wi, 4 * j + 1), elem(wi, 4 * j + 2)) {
                retour 0;
            }
        }
    }
    retour 1;
}

// Les accès aux tableaux cumulés redirigés vers la copie du segment : copies = (début, fin, copie) par tableau
fonction remplacer_cumul(c: Ctx, n: Noeud, copies: Liste): Noeud {
    si n == nul {
        retour nul;
    }
    soit m = Noeud { genre: n.genre, op: n.op, val: n.val, nom: n.nom, a: remplacer_cumul(c, n.a, copies),
                     b: remplacer_cumul(c, n.b, copies), c: remplacer_cumul(c, n.c, copies),
                     premier: remplacer_liste(c, n.premier, copies), deuxieme: remplacer_liste(c, n.deuxieme, copies),
                     ligne: n.ligne, zet: n.zet, zlo: n.zlo, zhi: n.zhi, copie: n.copie };
    si (n.genre == N_LIRE || n.genre == N_ECRIRE) && n.zet != 0 {
        pour i dans 0..copies.n / 4 {
            si elem(copies, 4 * i) == n.zet - 1 && elem(copies, 4 * i + 1) == n.zlo {
                soit cb = elem(copies, 4 * i + 3);
                soit nm = n.zhi - n.zlo;
                m.b = bin("+", nombre(cb - n.zlo, n.ligne), m.b, n.ligne);
                m.val = 3;
                m.zet = 4;
                m.zlo = cb;
                m.zhi = cb + nm;
                m.nom = 0;
            }
        }
    }
    retour m;
}

fonction remplacer_liste(c: Ctx, x: Noeud, copies: Liste): Noeud {
    soit premier: Noeud = nul;
    soit dernier: Noeud = nul;
    tantque x != nul {
        soit y = remplacer_cumul(c, x, copies);
        si dernier == nul {
            premier = y;
        } sinon {
            dernier.suivant = y;
        }
        dernier = y;
        x = x.suivant;
    }
    retour premier;
}

// Borne k sur n d'une boucle en segments : a + (b - a) × k / n
fonction borne(sa, sb, k, n, l): Noeud {
    si k == 0 {
        retour var_n(sa, l);
    }
    si k == n {
        retour var_n(sb, l);
    }
    retour bin("+", var_n(sa, l), bin("/", bin("*", bin("-", var_n(sb, l), var_n(sa, l), l), nombre(k, l), l), nombre(n, l), l), l);
}

fonction chainer(premier: Noeud, x: Noeud): Noeud {
    si premier == nul {
        retour x;
    }
    soit d = premier;
    tantque d.suivant != nul {
        d = d.suivant;
    }
    d.suivant = x;
    retour premier;
}

// Une boucle en segments -> un accord de segments (et, s'il y a des tableaux cumulés, la somme des copies ensuite)
fonction accord_segments(c: Ctx, st: Noeud): Noeud {
    soit info = st.c;
    soit n = info.val;
    soit sid = info.ligne;
    soit l = st.ligne;
    soit sa = nom_cache("__sa", sid);
    soit sb = nom_cache("__sb", sid);
    // zones des tableaux cumulés : étage, début, fin
    soit privees = liste();
    soit cu = info.premier;
    tantque cu != nul {
        zone_table(c, privees, cu.nom);
        cu = cu.suivant;
    }
    soit libres = segments_independants(c, st, privees);
    soit morceaux: Noeud = nul;
    soit reduction: Noeud = nul;
    si privees.n == 0 {
        pour k dans 0..n {
            soit m = Noeud { genre: N_POUR, nom: st.nom, a: borne(sa, sb, k, n, l), b: borne(sa, sb, k + 1, n, l),
                             premier: st.premier, val: 1, op: "segments", copie: k > 0, ligne: l };
            morceaux = chainer(morceaux, m);
        }
    } sinon {
        // une copie de chaque tableau cumulé par segment, dans @3[14680064…]
        soit bases = liste();            // par segment et par tableau : étage, début, fin, copie
        pour k2 dans 0..n {
            pour i dans 0..privees.n / 3 {
                ajouter(bases, elem(privees, 3 * i));
                ajouter(bases, elem(privees, 3 * i + 1));
                ajouter(bases, elem(privees, 3 * i + 2));
                ajouter(bases, c.copie_libre);
                c.copie_libre = c.copie_libre + elem(privees, 3 * i + 2) - elem(privees, 3 * i + 1);
            }
        }
        si c.copie_libre > COPIES_FIN {
            erreur(c, l, "plus de place pour les copies des tableaux cumulés");
        }
        soit nt = privees.n / 3;
        soit jk = nom_cache("__cz", sid);
        pour k3 dans 0..n {
            soit copies = liste();
            soit bloc_k: Noeud = nul;
            pour i2 dans 0..nt {
                soit o = 4 * (k3 * nt + i2);
                pour q dans 0..4 {
                    ajouter(copies, elem(bases, o + q));
                }
                soit cb = elem(bases, o + 3);
                soit nm = elem(bases, o + 2) - elem(bases, o + 1);
                soit zero = Noeud { genre: N_ECRIRE, val: 3, b: bin("+", nombre(cb, l), var_n(jk, l), l), c: nombre(0, l),
                                    ligne: l, zet: 4, zlo: cb, zhi: cb + nm };
                soit mz = Noeud { genre: N_POUR, nom: jk, a: nombre(0, l), b: nombre(nm, l), premier: zero, val: 1,
                                  op: "copie", copie: k3 > 0, ligne: l };
                bloc_k = chainer(bloc_k, mz);
            }
            soit boucle = Noeud { genre: N_POUR, nom: st.nom, a: borne(sa, sb, k3, n, l), b: borne(sa, sb, k3 + 1, n, l),
                                  premier: remplacer_liste(c, st.premier, copies), val: 1, op: "copie", copie: k3 > 0, ligne: l };
            bloc_k = chainer(bloc_k, boucle);
            morceaux = chainer(morceaux, Noeud { genre: N_BLOC, premier: bloc_k, ligne: l });
        }
        // la somme : tableau = tableau + toutes les copies
        soit jr = nom_cache("__cr", sid);
        pour i3 dans 0..nt {
            soit etg = elem(privees, 3 * i3);
            soit base = elem(privees, 3 * i3 + 1);
            soit fin = elem(privees, 3 * i3 + 2);
            soit somme = Noeud { genre: N_LIRE, val: etg, b: bin("+", nombre(base, l), var_n(jr, l), l), ligne: l,
                                 zet: etg + 1, zlo: base, zhi: fin };
            pour k4 dans 0..n {
                soit cb2 = elem(bases, 4 * (k4 * nt + i3) + 3);
                somme = bin("+", somme, Noeud { genre: N_LIRE, val: 3, b: bin("+", nombre(cb2, l), var_n(jr, l), l), ligne: l,
                                                zet: 4, zlo: cb2, zhi: cb2 + fin - base }, l);
            }
            soit ec = Noeud { genre: N_ECRIRE, val: etg, b: bin("+", nombre(base, l), var_n(jr, l), l), c: somme, ligne: l,
                              zet: etg + 1, zlo: base, zhi: fin };
            reduction = chainer(reduction, Noeud { genre: N_POUR, nom: jr, a: nombre(0, l), b: nombre(fin - base, l),
                                                   premier: ec, val: 1, op: "copie", copie: i3 > 0, ligne: l });
        }
    }
    // les mesures : toutes les tâches ensemble si les segments sont indépendants, sinon une par mesure
    soit mesures: Noeud = nul;
    si libres {
        mesures = Noeud { genre: N_MESURE, premier: morceaux, ligne: l };
    } sinon {
        soit m2 = morceaux;
        tantque m2 != nul {
            soit suivant = m2.suivant;
            m2.suivant = nul;
            mesures = chainer(mesures, Noeud { genre: N_MESURE, premier: m2, ligne: l });
            m2 = suivant;
        }
    }
    soit acc = Noeud { genre: N_ACCORD, val: c.naccords, premier: mesures, ligne: l };
    c.naccords = c.naccords + 1;
    acc.suivant = reduction;
    retour acc;
}

fonction partition_liste(c: Ctx, s: Noeud): Noeud {
    soit tete: Noeud = nul;
    soit dernier: Noeud = nul;
    tantque s != nul {
        soit r: Noeud = s;
        soit suivant = s.suivant;
        si est_tache(c, s) && suivant != nul && est_tache(c, suivant) {
            // une suite de tâches : niveau de chacune = 1 + le plus haut niveau des tâches précédentes en conflit
            soit taches = liste();
            soit x = s;
            soit tl: Noeud = nul;
            soit nb = 0;
            tantque x != nul && est_tache(c, x) {
                nb = nb + 1;
                x = x.suivant;
            }
            suivant = x;
            soit rs = liste();          // effets de chaque tâche : listes de zones, rangées par position
            soit ws = liste();
            soit lt = liste();          // les tâches (adresses des noeuds) : on les retrouve en parcourant
            soit niveau = liste();
            soit maxn = 1;
            soit t = s;
            pour k dans 0..nb {
                soit r1 = liste();
                soit w1 = liste();
                parcourir(c, t, r1, w1);
                soit nv = 1;
                soit u = s;
                pour m dans 0..k {
                    soit rm = liste();
                    soit wm = liste();
                    parcourir(c, u, rm, wm);
                    si ensembles_conflit(w1, wm) || ensembles_conflit(w1, rm) || ensembles_conflit(r1, wm) {
                        si elem(niveau, m) + 1 > nv {
                            nv = elem(niveau, m) + 1;
                        }
                    }
                    u = u.suivant;
                }
                ajouter(niveau, nv);
                si nv > maxn {
                    maxn = nv;
                }
                t = t.suivant;
            }
            // l'ordre d'origine est gardé dans deuxieme (inutilisé par une instruction-expression) pendant le rangement
            soit to = s;
            pour k1 dans 0..nb {
                to.deuxieme = to.suivant;
                to = to.suivant;
            }
            soit mesures: Noeud = nul;
            pour nv2 dans 1..maxn + 1 {
                soit chaine: Noeud = nul;
                soit dch: Noeud = nul;
                soit t2 = s;
                pour k2 dans 0..nb {
                    soit t3 = t2.deuxieme;
                    si elem(niveau, k2) == nv2 {
                        t2.suivant = nul;
                        si dch == nul {
                            chaine = t2;
                        } sinon {
                            dch.suivant = t2;
                        }
                        dch = t2;
                    }
                    t2 = t3;
                }
                mesures = chainer(mesures, Noeud { genre: N_MESURE, premier: chaine, ligne: s.ligne });
            }
            soit tz = s;
            pour k5 dans 0..nb {
                soit tn = tz.deuxieme;
                tz.deuxieme = nul;
                tz = tn;
            }
            r = Noeud { genre: N_ACCORD, val: c.naccords, premier: mesures, ligne: s.ligne };
            c.naccords = c.naccords + 1;
        } sinon si s.genre == N_POUR && s.c != nul && s.c.genre == N_INFO {
            s.premier = partition_liste(c, s.premier);
            r = accord_segments(c, s);
        } sinon {
            s.suivant = nul;
            si s.genre == N_SI || s.genre == N_TANTQUE || s.genre == N_POUR {
                s.premier = partition_liste(c, s.premier);
                si s.genre == N_SI && s.val == 1 {
                    s.deuxieme = partition_liste(c, s.deuxieme);
                }
            }
        }
        si dernier == nul {
            tete = r;
        } sinon {
            dernier.suivant = r;
        }
        dernier = r;
        tantque dernier.suivant != nul {
            dernier = dernier.suivant;
        }
        s = suivant;
    }
    retour tete;
}

fonction partitionner(c: Ctx) {
    calculer_effets(c);
    c.copie_libre = COPIES_DEBUT;
    soit f = c.fonctions;
    tantque f != nul {
        si f.garde && !f.prelude {
            f.corps = partition_liste(c, f.corps);
        }
        f = f.suivant;
    }
}

// La table des accords pour la machine Rust : nombre d'accords, puis pour chacun début, fin, nombre de mesures, et
// pour chaque mesure le nombre de tâches puis (début, fin) de chacune (même calcul que vtx.py exporter)
fonction table_accords(c: Ctx): Liste {
    soit m = c.marques;
    soit nm = m.n / 4;
    soit t = liste();
    ajouter(t, c.naccords);
    pour rid dans 0..c.naccords {
        soit debut = 0 - 1;
        soit fin = 0;
        soit nmes = 0;
        pour i dans 0..nm {
            si elem(m, 4 * i + 2) == rid {
                si elem(m, 4 * i + 1) == 2 {
                    fin = elem(m, 4 * i);
                } sinon {
                    si debut == 0 - 1 {
                        debut = elem(m, 4 * i);
                    }
                    si elem(m, 4 * i + 3) > nmes {
                        nmes = elem(m, 4 * i + 3);
                    }
                }
            }
        }
        ajouter(t, debut);
        ajouter(t, fin);
        ajouter(t, nmes);
        pour k dans 1..nmes + 1 {
            soit nt = 0;
            pour i2 dans 0..nm {
                si elem(m, 4 * i2 + 2) == rid && elem(m, 4 * i2 + 1) == 1 && elem(m, 4 * i2 + 3) == k {
                    nt = nt + 1;
                }
            }
            ajouter(t, nt);
            pour i3 dans 0..nm {
                si elem(m, 4 * i3 + 2) == rid && elem(m, 4 * i3 + 1) == 1 && elem(m, 4 * i3 + 3) == k {
                    ajouter(t, elem(m, 4 * i3));
                    soit j = i3 + 1;
                    tantque elem(m, 4 * j + 2) != rid {
                        j = j + 1;
                    }
                    ajouter(t, elem(m, 4 * j));
                }
            }
        }
    }
    retour t;
}

fonction marquer(c: Ctx, genre, rid, mesure) {
    ajouter(c.marques, c.code.n);
    ajouter(c.marques, genre);
    ajouter(c.marques, rid);
    ajouter(c.marques, mesure);
}

// Une fonction appelée : si l'élagage l'avait écartée, elle est générée après les autres (comme vtx.py)
fonction demander(c: Ctx, f: Fonction) {
    si f == nul {
        erreur(c, 0, "fonction « nouveau » absente");
        retour 0;
    }
    si !f.garde {
        f.garde = 2;      // 2 : demandée pendant la génération, produite après les autres (une seule fois)
        si c.file_debut == nul {
            c.file_debut = f;
        } sinon {
            c.file_fin.suite = f;
        }
        c.file_fin = f;
    }
    retour f.etiq;
}

fonction appels_liste(c: Ctx, x: Noeud, noms: Liste) {
    tantque x != nul {
        appels_de(c, x, noms);
        x = x.suivant;
    }
}

fonction appels_de(c: Ctx, e: Noeud, noms: Liste) {
    si e == nul {
        retour;
    }
    si e.genre == N_APPEL {
        ajouter(noms, e.nom);
    }
    si e.genre == N_CONSTRUIRE || e.genre == N_NOUVEAU {
        ajouter(noms, "nouveau");
    }
    appels_de(c, e.a, noms);
    appels_de(c, e.b, noms);
    appels_de(c, e.c, noms);
    appels_liste(c, e.premier, noms);
    appels_liste(c, e.deuxieme, noms);
}

// Élagage : seules les fonctions atteintes depuis principal sont gardées
fonction elaguer(c: Ctx) {
    soit f = c.fonctions;
    tantque f != nul {
        f.garde = !c.optim;
        f = f.suivant;
    }
    si !c.optim {
        retour;
    }
    soit pile = liste();
    ajouter(pile, "principal");
    tantque pile.n > 0 {
        pile.n = pile.n - 1;
        soit g = fonction_de(c, elem(pile, pile.n));
        si g != nul && !g.garde {
            g.garde = 1;
            soit noms = liste();
            appels_liste(c, g.corps, noms);
            pour i dans 0..noms.n {
                ajouter(pile, elem(noms, i));
            }
        }
    }
}

fonction generer(c: Ctx) {
    soit p = fonction_de(c, "principal");
    si p == nul {
        erreur(c, 0, "la fonction « principal » est absente");
        retour;
    }
    si p.nb != 0 {
        erreur(c, p.ligne, "la fonction « principal » ne prend aucun paramètre");
        retour;
    }
    soit fi = c.fonctions;
    tantque fi != nul {
        si est_integre(fi.nom) {
            erreur_nom(c, fi.ligne, "ce nom est celui d'une fonction intégrée :", fi.nom);
        }
        fi = fi.suivant;
    }
    emettre(c, mot(10, 14 << 4, 0, 0));
    emettre(c, 8388607);
    saut(c, 51, p.etiq);
    emettre(c, mot(63, 0, 0, 0));
    elaguer(c);
    si c.optim && c.partition {
        partitionner(c);
    }
    soit f = c.fonctions;
    tantque f != nul && c.erreur == 0 {
        si f.garde == 1 {
            fonction_code(c, f);
        }
        f = f.suivant;
    }
    tantque c.file_debut != nul && c.erreur == 0 {
        soit g = c.file_debut;
        c.file_debut = g.suite;
        fonction_code(c, g);
    }
    // blocs de données, puis textes : longueur puis un caractère par mot, dans l'ordre de leur première apparition
    soit dn = c.blocs;
    tantque dn != nul {
        poser_etiquette(c, dn.etiq);
        pour iv dans 0..dn.vals.n {
            emettre(c, elem(dn.vals, iv));
        }
        dn = dn.suivant;
    }
    soit t = c.textes;
    tantque t != nul {
        poser_etiquette(c, t.etiq);
        soit n = longueur(t.val);
        emettre(c, n);
        pour i dans 0..n {
            emettre(c, car(t.val, i));
        }
        t = t.suivant;
    }
    // résolution des sauts et des adresses
    pour j2 dans 0..c.fix_pos.n {
        soit pos = elem(c.fix_pos, j2);
        soit cible = elem(c.etiq, elem(c.fix_etiq, j2));
        si elem(c.fix_genre, j2) == 0 {
            // adresse sur 20 bits : g et b, puis les 4 bits bas du dernier octet (le code dépasse 65 536 mots)
            poser(c.code, pos, elem(c.code, pos) | (((cible >> 8) & 255) << 16) | ((cible & 255) << 8) | (cible >> 16));
        } sinon {
            poser(c.code, pos, cible);
        }
    }
}

// --------------------------------------------------------------------------------------------- fichiers et importer
fonction lire_fichier(chemin): Liste {
    soit f = ouvrir_lecture(chemin);
    si f == 4294967295 {
        retour nul;
    }
    soit l = liste();
    tantque fin_de(f) == 0 {
        ajouter(l, lire_car(f));
    }
    fermer(f);
    retour l;
}

fonction ajouter_texte(l: Liste, t) {
    pour i dans 0..longueur(t) {
        ajouter(l, car(t, i));
    }
}

// dossier + "/" + nom ; un nom absolu (/…, \…, C:…) reste tel quel
fonction joindre(dossier, nom) {
    si dossier == 0 || longueur(dossier) == 0 || car(nom, 0) == '/' || car(nom, 0) == '\\'
        || (longueur(nom) > 1 && car(nom, 1) == ':') {
        retour nom;
    }
    soit l = liste();
    ajouter_texte(l, dossier);
    soit d = car(dossier, longueur(dossier) - 1);
    si d != '/' && d != '\\' {
        ajouter(l, '/');
    }
    ajouter_texte(l, nom);
    retour texte_de(l, 0, l.n);
}

// a/b/../c/./d -> a/c/d (comme os.path.normpath) : un fichier importé par deux chemins n'est lu qu'une fois
fonction normaliser(chemin) {
    soit n = longueur(chemin);
    soit morceaux = liste();          // débuts et fins des morceaux gardés
    soit absolu = n > 0 && (car(chemin, 0) == '/' || car(chemin, 0) == '\\');
    soit i = 0;
    tantque i <= n {
        soit d = i;
        tantque i < n && car(chemin, i) != '/' && car(chemin, i) != '\\' {
            i = i + 1;
        }
        soit lg = i - d;
        si lg == 0 || (lg == 1 && car(chemin, d) == '.') {
            // rien
        } sinon si lg == 2 && car(chemin, d) == '.' && car(chemin, d + 1) == '.' {
            soit k = morceaux.n;
            soit precedent_point = 0;
            si k > 0 {
                soit pd = elem(morceaux, k - 2);
                precedent_point = elem(morceaux, k - 1) - pd == 2 && car(chemin, pd) == '.' && car(chemin, pd + 1) == '.';
            }
            si k > 0 && !precedent_point {
                morceaux.n = k - 2;
            } sinon si !absolu {
                ajouter(morceaux, d);
                ajouter(morceaux, i);
            }
        } sinon {
            ajouter(morceaux, d);
            ajouter(morceaux, i);
        }
        i = i + 1;
    }
    soit l = liste();
    si absolu {
        ajouter(l, '/');
    }
    pour m dans 0..morceaux.n / 2 {
        si m > 0 {
            ajouter(l, '/');
        }
        pour j dans elem(morceaux, 2 * m)..elem(morceaux, 2 * m + 1) {
            ajouter(l, car(chemin, j));
        }
    }
    si l.n == 0 {
        ajouter(l, '.');
    }
    retour texte_de(l, 0, l.n);
}

fonction dossier_de(chemin) {
    soit k = 0 - 1;
    pour i dans 0..longueur(chemin) {
        si car(chemin, i) == '/' || car(chemin, i) == '\\' {
            k = i;
        }
    }
    si k == 0 - 1 {
        retour "";
    }
    soit l = liste();
    pour j dans 0..k {
        ajouter(l, car(chemin, j));
    }
    retour texte_de(l, 0, l.n);
}

fonction blanc(x) {
    retour x == ' ' || x == 9;
}

// La ligne t[debut..fin] est-elle « importer "fichier"; » ? Rend le nom du fichier, ou 0
fonction ligne_import(c: Ctx, t: Liste, debut, fin) {
    soit i = debut;
    tantque i < fin && blanc(elem(t, i)) {
        i = i + 1;
    }
    soit motcle = "importer";
    pour k dans 0..8 {
        si i + k >= fin || elem(t, i + k) != car(motcle, k) {
            retour 0;
        }
    }
    i = i + 8;
    si i >= fin || !blanc(elem(t, i)) {
        retour 0;
    }
    tantque i < fin && blanc(elem(t, i)) {
        i = i + 1;
    }
    soit nom = 0;
    si i < fin && elem(t, i) == '"' {
        soit d = i + 1;
        i = d;
        tantque i < fin && elem(t, i) != '"' {
            i = i + 1;
        }
        si i >= fin || i == d {
            retour 0;
        }
        nom = texte_de(t, d, i);
        i = i + 1;
    } sinon {
        retour 0;
    }
    tantque i < fin && blanc(elem(t, i)) {
        i = i + 1;
    }
    si i >= fin || elem(t, i) != ';' {
        retour 0;
    }
    i = i + 1;
    tantque i < fin && (blanc(elem(t, i)) || elem(t, i) == 13) {
        i = i + 1;
    }
    si i != fin {
        retour 0;
    }
    retour nom;
}


fonction deja_vu(c: Ctx, chemin) {
    pour i dans 0..c.vus.n {
        si texte_egal(elem(c.vus, i), chemin) {
            retour 1;
        }
    }
    retour 0;
}

// Une portion du texte assemblé : à partir de la ligne debut, elle vient de la ligne origine du fichier affiche
fonction segment(c: Ctx, affiche, origine) {
    ajouter(c.segs, c.nlignes + 1);
    ajouter(c.segs, affiche);
    ajouter(c.segs, origine);
}

// Range le fichier dans c.src ; chaque ligne « importer "x.vtx"; » est remplacée par le fichier (une fois par fichier)
fonction charger_source(c: Ctx, chemin, affiche, dossier) {
    soit t = lire_fichier(chemin);
    si t == nul {
        si affiche == 0 {
            erreur_nom(c, 0, "fichier introuvable :", chemin);
        } sinon {
            erreur_nom(c, c.nlignes + 1, "importer : fichier introuvable", affiche);
        }
        retour;
    }
    segment(c, affiche, 1);
    soit i = 0;
    soit ligne = 1;
    tantque i <= t.n && c.erreur == 0 {
        soit fin = i;
        tantque fin < t.n && elem(t, fin) != 10 {
            fin = fin + 1;
        }
        soit nom = ligne_import(c, t, i, fin);
        si nom != 0 {
            soit ch = normaliser(joindre(dossier, nom));
            si !deja_vu(c, ch) {
                ajouter(c.vus, ch);
                soit montre = nom;
                si affiche != 0 {
                    montre = normaliser(joindre(dossier_de(affiche), nom));
                }
                charger_source(c, ch, montre, dossier_de(ch));
            }
            segment(c, affiche, ligne + 1);
        } sinon {
            pour k dans i..fin {
                ajouter(c.src, elem(t, k));
            }
            ajouter(c.src, 10);
            c.nlignes = c.nlignes + 1;
        }
        ligne = ligne + 1;
        i = fin + 1;
    }
}

// --------------------------------------------------------------------------------------------- le type texte
// Comme typer_textes de vtx.py : avant l'élagage et la partition, les expressions de texte sont reconnues et réécrites
// en appels du prélude (a + b, a == b, a != b, afficher et ecrire d'un texte, afficher à plusieurs valeurs), puis le
// type texte redevient « entier » pour la génération du code.
// un champ est un texte s'il est déclaré texte dans toutes les structures qui ont un champ de ce nom
fonction champ_texte(c: Ctx, nom) {
    soit vu = 0;
    soit s = c.structs;
    tantque s != nul {
        soit ch = s.champs;
        tantque ch != nul {
            si texte_egal(ch.nom, nom) {
                si ch.type != T_T {
                    retour 0;
                }
                vu = 1;
            }
            ch = ch.suivant;
        }
        s = s.suivant;
    }
    retour vu;
}

// la poignée h est-elle un tableau de textes (decouper, cles, ou une variable qui en contient un) ?
fonction tableau_de_textes(c: Ctx, h: Noeud, tabs: Liste) {
    si h.genre == N_VAR {
        retour dans_liste(tabs, h.nom);
    }
    retour h.genre == N_APPEL && (texte_egal(h.nom, "decouper") || texte_egal(h.nom, "cles")) && du_prelude(c, h.nom);
}

// ---- les tableaux de flottants : lus comme flottants, écrits par leurs bits
fonction flottant_ecrit(v: Noeud) {
    retour v.genre == N_FNOMBRE || (v.genre == N_BIN && texte_egal(v.op, "-") && v.a.genre == N_NOMBRE && v.a.val == 0
        && v.b.genre == N_FNOMBRE);
}

// [a, b, c] avec au moins un flottant écrit en chiffres : un tableau de flottants
fonction literal_flottant(c: Ctx, e: Noeud) {
    tantque e != nul && e.genre == N_APPEL && texte_egal(e.nom, "__remplir") && du_prelude(c, "__remplir") {
        si flottant_ecrit(e.premier.suivant.suivant) {
            retour 1;
        }
        e = e.premier;
    }
    retour 0;
}

fonction tableau_flottant(c: Ctx, h: Noeud) {
    si h == nul {
        retour 0;
    }
    si h.genre == N_VAR {
        retour dans_liste(c.tabflot, h.nom);
    }
    si h.genre == N_APPEL {
        si texte_egal(h.nom, "copie") && du_prelude(c, "copie") && h.premier != nul && h.premier.suivant == nul {
            retour tableau_flottant(c, h.premier);
        }
        soit f = fonction_de(c, h.nom);
        retour (f != nul && f.rtype == T_TF) || literal_flottant(c, h);
    }
    retour 0;
}

// t[i] : la poignée t, sinon nul
fonction poignee(e: Noeud): Noeud {
    si e != nul && e.genre == N_LIRE && e.val == 3 && e.a == nul && e.b.genre == N_BIN && texte_egal(e.b.op, "+")
        && e.b.a.genre == N_LIRE && e.b.a.a == nul && e.b.a.b.genre == N_BIN && e.b.a.b.a.genre == N_BIN
        && texte_egal(e.b.a.b.a.op, "&") {
        retour e.b.a.b.a.a;
    }
    retour nul;
}

// l'adresse de t[i] dans une écriture : la poignée t, sinon nul
fonction adresse_poignee(a: Noeud): Noeud {
    si a != nul && a.genre == N_BIN && texte_egal(a.op, "+") && a.a.genre == N_LIRE && a.a.a == nul && a.a.b.genre == N_BIN
        && a.a.b.a.genre == N_BIN && texte_egal(a.a.b.a.op, "&") {
        retour a.a.b.a.a;
    }
    retour nul;
}

// une valeur rangée dans un tableau de flottants : ses bits ; un nombre écrit est converti dès la compilation
fonction en_bits(v: Noeud): Noeud {
    soit l = v.ligne;
    si v.genre == N_FNOMBRE {
        retour nombre(v.val, l);
    }
    si v.genre == N_BIN && texte_egal(v.op, "-") && v.a.genre == N_NOMBRE && v.a.val == 0 {
        si v.b.genre == N_FNOMBRE {
            retour nombre(v.b.val ^ 2147483648, l);
        }
        si v.b.genre == N_NOMBRE && v.b.val < 16777216 {
            retour nombre(bits(0.0 - flottant(v.b.val)), l);
        }
    }
    si v.genre == N_NOMBRE && v.val < 16777216 {
        retour nombre(bits(flottant(v.val)), l);
    }
    retour appel1_de("bits", appel1_de("flottant", v, l), l);
}

fonction en_bits_litteral(x: Noeud) {
    tantque x != nul && x.genre == N_APPEL && texte_egal(x.nom, "__remplir") {
        soit k = x.premier.suivant;
        soit nv = en_bits(k.suivant);
        k.suivant = nv;
        nv.suivant = nul;
        x = x.premier;
    }
}

// le noeud e devient f(e) (e est recopié dessous)
fonction envelopper(e: Noeud, nom) {
    soit dessous = Noeud { genre: e.genre, val: e.val, nom: e.nom, op: e.op, a: e.a, b: e.b, c: e.c, premier: e.premier,
                           deuxieme: e.deuxieme, ligne: e.ligne, zet: e.zet, zlo: e.zlo, zhi: e.zhi, copie: e.copie };
    e.genre = N_APPEL;
    e.nom = nom;
    e.premier = dessous;
    e.val = 0;
    e.op = 0;
    e.a = nul;
    e.b = nul;
    e.c = nul;
}

// les règles des tableaux de flottants sur un noeud dont les enfants sont faits ; 1 si une règle a servi
fonction flottants_noeud(c: Ctx, e: Noeud) {
    si poignee(e) != nul && tableau_flottant(c, poignee(e)) {
        envelopper(e, "comme_flottant");
        retour 1;
    }
    si e.genre == N_ECRIRE && e.val == 3 && e.a == nul && tableau_flottant(c, adresse_poignee(e.b)) {
        e.c = en_bits(e.c);
        retour 1;
    }
    si e.genre == N_APPEL && e.premier != nul && tableau_flottant(c, e.premier) && du_prelude(c, e.nom) {
        si (texte_egal(e.nom, "ajouter") || texte_egal(e.nom, "inserer") || texte_egal(e.nom, "indice")
            || texte_egal(e.nom, "contient")) && e.premier.suivant != nul {
            soit av = e.premier;
            tantque av.suivant.suivant != nul {
                av = av.suivant;
            }
            soit nv = en_bits(av.suivant);
            av.suivant = nv;
            nv.suivant = nul;
            retour 1;
        }
        si texte_egal(e.nom, "retirer") || texte_egal(e.nom, "enlever") {
            envelopper(e, "comme_flottant");
            retour 1;
        }
        si texte_egal(e.nom, "somme") && e.premier.suivant == nul {
            e.nom = "__somme_f";
            retour 1;
        }
        si texte_egal(e.nom, "trier") && e.premier.suivant == nul {
            e.nom = "__trier_f";
            retour 1;
        }
    }
    retour 0;
}

fonction est_texte(c: Ctx, e: Noeud, env: Liste) {
    si e == nul {
        retour 0;
    }
    si e.genre == N_LIRE && e.val == 3 && e.a == nul && e.b.genre == N_BIN && texte_egal(e.b.op, "+")
        && e.b.a.genre == N_LIRE && e.b.a.a == nul && e.b.a.b.genre == N_BIN && e.b.a.b.a.genre == N_BIN
        && texte_egal(e.b.a.b.a.op, "&") {
        // t[i] d'un tableau de textes
        retour tableau_de_textes(c, e.b.a.b.a.a, c.tabtextes);
    }
    si e.genre == N_ETIQ {
        retour 1;
    }
    si e.genre == N_VAR {
        retour dans_liste(env, e.nom);
    }
    si e.genre == N_APPEL {
        soit f = fonction_de(c, e.nom);
        retour f != nul && f.rtype == T_T;
    }
    si e.genre == N_CHAMP {
        retour champ_texte(c, e.nom);
    }
    si e.genre == N_BIN && texte_egal(e.op, "+") {
        retour est_texte(c, e.a, env) || est_texte(c, e.b, env);
    }
    retour 0;
}

// les « soit » d'une fonction : marque comme textes les variables déclarées texte ou initialisées par un texte
// (rend le nombre de nouvelles) ; avec normaliser, le type texte redevient entier
fonction soits_textes(c: Ctx, s: Noeud, env: Liste, normaliser) {
    soit n = 0;
    tantque s != nul {
        si s.genre == N_SOIT {
            si normaliser {
                si s.val == T_T || s.val == T_TF {
                    s.val = 0;
                }
            } sinon {
                soit t = 0;
                si s.val != 0 {
                    t = s.val == T_T;
                } sinon {
                    t = est_texte(c, s.a, env);
                }
                si t && !dans_liste(env, s.nom) {
                    ajouter(env, s.nom);
                    n = n + 1;
                }
                si !dans_liste(c.tabtextes, s.nom) && tableau_de_textes(c, s.a, c.tabtextes) {
                    ajouter(c.tabtextes, s.nom);
                    n = n + 1;
                }
                si !dans_liste(c.tabflot, s.nom) && (s.val == T_TF || tableau_flottant(c, s.a)) {
                    ajouter(c.tabflot, s.nom);
                    n = n + 1;
                }
            }
        }
        n = n + soits_textes(c, s.a, env, normaliser) + soits_textes(c, s.b, env, normaliser) + soits_textes(c, s.c, env, normaliser)
            + soits_textes(c, s.premier, env, normaliser) + soits_textes(c, s.deuxieme, env, normaliser);
        s = s.suivant;
    }
    retour n;
}

fonction appel1_de(nom, a: Noeud, l): Noeud {
    a.suivant = nul;
    retour Noeud { genre: N_APPEL, nom: nom, premier: a, ligne: l };
}

fonction vers_texte(c: Ctx, e: Noeud, env: Liste): Noeud {
    si est_texte(c, e, env) {
        retour e;
    }
    retour appel1_de("texte", e, e.ligne);
}

fonction du_prelude(c: Ctx, nom) {
    soit f = fonction_de(c, nom);
    retour f != nul && f.prelude;
}

// un noeud seul (pas la suite de sa liste), enfants d'abord
fonction textes_noeud(c: Ctx, e: Noeud, env: Liste) {
    si e == nul {
        retour;
    }
    // un littéral de flottants : chaque valeur rangée par ses bits (les entiers écrits deviennent des flottants)
    si e.genre == N_SOIT && e.val == T_TF && e.a != nul && e.a.genre == N_APPEL && texte_egal(e.a.nom, "__remplir")
        && du_prelude(c, "__remplir") {
        en_bits_litteral(e.a);
    }
    si e.genre == N_APPEL && texte_egal(e.nom, "__remplir") && literal_flottant(c, e) {
        en_bits_litteral(e);
    }
    textes_noeud(c, e.a, env);
    textes_noeud(c, e.b, env);
    textes_noeud(c, e.c, env);
    textes_liste(c, e.premier, env);
    textes_liste(c, e.deuxieme, env);
    si flottants_noeud(c, e) {
        retour;
    }
    si e.genre == N_BIN && texte_egal(e.op, "+") && (est_texte(c, e.a, env) || est_texte(c, e.b, env)) {
        soit a = vers_texte(c, e.a, env);
        soit b = vers_texte(c, e.b, env);
        a.suivant = b;
        b.suivant = nul;
        e.genre = N_APPEL;
        e.nom = "__texte_plus";
        e.premier = a;
        e.a = nul;
        e.b = nul;
    } sinon si e.genre == N_BIN && (texte_egal(e.op, "==") || texte_egal(e.op, "!=")) && est_texte(c, e.a, env)
        && est_texte(c, e.b, env) {
        soit eg = Noeud { genre: N_APPEL, nom: "texte_egal", premier: e.a, ligne: e.ligne };
        e.a.suivant = e.b;
        e.b.suivant = nul;
        si texte_egal(e.op, "==") {
            e.genre = N_APPEL;
            e.nom = "texte_egal";
            e.premier = e.a;
            e.a = nul;
            e.b = nul;
        } sinon {
            e.op = "==";
            e.a = eg;
            e.b = Noeud { genre: N_NOMBRE, val: 0, ligne: e.ligne };
        }
    } sinon si e.genre == N_APPEL && e.premier != nul && e.premier.suivant == nul && est_texte(c, e.premier, env) {
        si (texte_egal(e.nom, "afficher") || texte_egal(e.nom, "ecrire")) && du_prelude(c, e.nom) {
            si texte_egal(e.nom, "afficher") {
                e.nom = "__afficher_t";
            } sinon {
                e.nom = "__ecrire_t";
            }
        } sinon si texte_egal(e.nom, "texte") && du_prelude(c, "texte") {
            e.nom = "__texte_t";
        }
    }
    textes_tas(c, e, env);
}

// un texte rangé dans le tas y est recopié s'il est écrit dans le programme (voir __texte_tas dans le prélude)
fonction texte_tas(c: Ctx, v: Noeud, env: Liste, l): Noeud {
    si v != nul && est_texte(c, v, env) && du_prelude(c, "__texte_tas") {
        soit suite = v.suivant;
        soit w = appel1_de("__texte_tas", v, l);
        w.suivant = suite;
        retour w;
    }
    retour v;
}

fonction range_textes(nom) {
    retour texte_egal(nom, "ajouter") || texte_egal(nom, "inserer") || texte_egal(nom, "ranger")
        || texte_egal(nom, "affirmer") || texte_egal(nom, "nier") || texte_egal(nom, "__remplir");
}

fonction textes_tas(c: Ctx, e: Noeud, env: Liste) {
    si e.genre == N_CONSTRUIRE {
        soit q = e.premier;
        tantque q != nul {
            q.a = texte_tas(c, q.a, env, e.ligne);
            q = q.suivant;
        }
    } sinon si e.genre == N_ECRIRE_CHAMP {
        e.c = texte_tas(c, e.c, env, e.ligne);
    } sinon si e.genre == N_ECRIRE && e.val == 3 && e.a == nul && adresse_poignee(e.b) != nul {
        e.c = texte_tas(c, e.c, env, e.ligne);
    } sinon si e.genre == N_APPEL && range_textes(e.nom) && du_prelude(c, e.nom) && e.premier != nul
            && e.premier.suivant != nul {
        soit av = e.premier;
        tantque av.suivant != nul {
            av.suivant = texte_tas(c, av.suivant, env, e.ligne);
            av = av.suivant;
        }
    }
}

fonction textes_liste(c: Ctx, s: Noeud, env: Liste) {
    tantque s != nul {
        soit suite = s.suivant;
        textes_noeud(c, s, env);
        // afficher(a, b, c) : écrire a, une espace, b, une espace, puis afficher c (avec le retour à la ligne)
        si s.genre == N_EXPR && s.a.genre == N_APPEL && texte_egal(s.a.nom, "afficher") && s.a.premier != nul
            && s.a.premier.suivant != nul && du_prelude(c, "afficher") {
            soit l = s.a.ligne;
            soit arg = s.a.premier;
            soit dernier = s;
            soit premier_fait = 0;
            tantque arg != nul {
                soit arg_suite = arg.suivant;
                soit nom = "afficher";
                si arg_suite != nul {
                    nom = "ecrire";
                }
                si est_texte(c, arg, env) {
                    si arg_suite != nul {
                        nom = "__ecrire_t";
                    } sinon {
                        nom = "__afficher_t";
                    }
                }
                soit ap = appel1_de(nom, arg, l);
                si premier_fait == 0 {
                    s.a = ap;
                    premier_fait = 1;
                } sinon {
                    soit st = Noeud { genre: N_EXPR, a: ap, ligne: s.ligne };
                    dernier.suivant = st;
                    dernier = st;
                }
                si arg_suite != nul {
                    soit un = Noeud { genre: N_NOMBRE, val: 1, ligne: l };
                    un.suivant = Noeud { genre: N_NOMBRE, val: 32, ligne: l };
                    soit esp = Noeud { genre: N_EXPR, a: Noeud { genre: N_APPEL, nom: "ecrire_car", premier: un, ligne: l },
                                       ligne: s.ligne };
                    dernier.suivant = esp;
                    dernier = esp;
                }
                arg = arg_suite;
            }
            dernier.suivant = suite;
        }
        s = suite;
    }
}

// --------------------------------------------------------------------------------------------- prélude à la demande
// Le prélude compte près de 150 fonctions ; les lire toutes à chaque compilation coûtait l'essentiel du temps. On ne lit
// que celles dont le nom paraît dans le programme, dans les fonctions qu'appelle le compilateur lui-même, et, de proche
// en proche, dans les fonctions retenues. Avec les optimisations, la génération ne garde de toute façon que les fonctions
// appelées (élagage) : le code produit est le même, dans le même ordre.
structure Morceau { debut, fin, nom, nl, pris, suivant: Morceau }

fonction car_de_nom(x) {
    retour (x >= 'a' && x <= 'z') || (x >= 'A' && x <= 'Z') || (x >= '0' && x <= '9') || x == '_' || x >= 128;
}

// le morceau (fonction du prélude) qui porte le nom t[d..d+n], sinon nul
fonction morceau_nomme(t, ms: Morceau, u, d, n): Morceau {
    soit m = ms;
    tantque m != nul {
        si m.nl == n && car(t, m.nom) == car(u, d) {
            soit k = 1;
            tantque k < n && car(t, m.nom + k) == car(u, d + k) {
                k = k + 1;
            }
            si k == n {
                retour m;
            }
        }
        m = m.suivant;
    }
    retour nul;
}

structure Pile { m: Morceau, suivant: Pile }

fonction prendre(m: Morceau, p: Pile): Pile {
    si m == nul || m.pris {
        retour p;
    }
    m.pris = 1;
    retour Pile { m: m, suivant: p };
}

fonction prelude_utile(c: Ctx, t) {
    soit n = longueur(t);
    // les morceaux : chaque « fonction » écrite en début de ligne, jusqu'à la suivante
    soit ms: Morceau = nul;
    soit der: Morceau = nul;
    soit i = 0;
    tantque i < n {
        si (i == 0 || car(t, i - 1) == 10) && i + 9 < n && car(t, i) == 'f' && car(t, i + 1) == 'o' && car(t, i + 2) == 'n'
                && car(t, i + 3) == 'c' && car(t, i + 4) == 't' && car(t, i + 5) == 'i' && car(t, i + 6) == 'o'
                && car(t, i + 7) == 'n' && car(t, i + 8) == ' ' {
            soit k = i + 9;
            tantque k < n && car_de_nom(car(t, k)) {
                k = k + 1;
            }
            soit nv = Morceau { debut: i, fin: n, nom: i + 9, nl: k - i - 9 };
            si der == nul {
                ms = nv;
            } sinon {
                der.fin = i;
                der.suivant = nv;
            }
            der = nv;
        }
        i = i + 1;
    }
    // les graines : les noms du programme, ceux qu'emploie le compilateur lui-même, et les fonctions
    // qui écrivent un texte
    soit p: Pile = nul;
    soit j = c.jetons;
    tantque j != nul {
        si j.genre == 1 {
            p = prendre(morceau_nomme(t, ms, j.texte, 0, longueur(j.texte)), p);
        }
        j = j.suivant;
    }
    soit g = "divs mods asr nouveau tableau longueur texte_egal texte ecrire afficher ecrire_car comme_logique qegal nb_bits __code_logique __lshl __lsar __ldiv __afficher_t __ecrire_t __texte_t __afficher_f __ecrire_f __texte_f __afficher_l __ecrire_l __texte_l __afficher_q __ecrire_q __texte_q __texte_plus __texte_tas __remplir __somme_f __trier_f __hyp_debut __hyp_noter __hyp_valider __hyp_annuler";
    soit a = 0;
    tantque a < longueur(g) {
        soit b = a;
        tantque b < longueur(g) && car(g, b) != ' ' {
            b = b + 1;
        }
        p = prendre(morceau_nomme(t, ms, g, a, b - a), p);
        a = b + 1;
    }
    soit m = ms;
    tantque m != nul {
        // les textes écrits dans le prélude sont tous gardés dans le code (comme vtx.py) : leurs fonctions sont lues
        pour kq dans m.debut..m.fin {
            si car(t, kq) == '"' {
                p = prendre(m, p);
            }
        }
        m = m.suivant;
    }
    // de proche en proche : les noms écrits dans les fonctions retenues
    tantque p != nul {
        soit x = p.m;
        p = p.suivant;
        soit q = x.nom + x.nl;
        tantque q < x.fin {
            si car_de_nom(car(t, q)) && !car_de_nom(car(t, q - 1)) && !(car(t, q) >= '0' && car(t, q) <= '9') {
                soit r = q;
                tantque r < x.fin && car_de_nom(car(t, r)) {
                    r = r + 1;
                }
                p = prendre(morceau_nomme(t, ms, t, q, r - q), p);
                q = r;
            } sinon {
                q = q + 1;
            }
        }
    }
    // le texte lu : les fonctions retenues, dans l'ordre du prélude
    ajouter(c.src, 10);
    m = ms;
    tantque m != nul {
        si m.pris {
            pour kc dans m.debut..m.fin {
                ajouter(c.src, car(t, kc));
            }
        }
        m = m.suivant;
    }
}

fonction typer_textes(c: Ctx) {
    soit f = c.fonctions;
    tantque f != nul {
        si !f.prelude {
            c.tabtextes = liste();
            c.tabflot = liste();
            soit env = liste();
            soit p = f.params;
            tantque p != nul {
                si p.type == T_T {
                    ajouter(env, p.nom);
                }
                si p.type == T_TF {
                    ajouter(c.tabflot, p.nom);
                }
                p = p.suivant;
            }
            tantque soits_textes(c, f.corps, env, 0) > 0 {
            }
            textes_liste(c, f.corps, env);
        }
        f = f.suivant;
    }
    // pour la génération du code, un texte est un entier
    f = c.fonctions;
    tantque f != nul {
        si f.rtype == T_T || f.rtype == T_TF {
            f.rtype = 0;
        }
        soit p2 = f.params;
        tantque p2 != nul {
            si p2.type == T_T || p2.type == T_TF {
                p2.type = 0;
            }
            p2 = p2.suivant;
        }
        soits_textes(c, f.corps, liste(), 1);
        f = f.suivant;
    }
    soit s = c.structs;
    tantque s != nul {
        soit ch = s.champs;
        tantque ch != nul {
            si ch.type == T_T {
                ch.type = 0;
            }
            ch = ch.suivant;
        }
        s = s.suivant;
    }
}

// Les noms d'étages : CPU 0, GPU 1, PARTAGE 2, DISQUE 3
fonction constantes_predefinies(c: Ctx) {
    c.consts = Constante { nom: "CPU", val: 0, suivant: c.consts };
    c.consts = Constante { nom: "GPU", val: 1, suivant: c.consts };
    c.consts = Constante { nom: "PARTAGE", val: 2, suivant: c.consts };
    c.consts = Constante { nom: "DISQUE", val: 3, suivant: c.consts };
}

fonction principal() {
    soit c = Ctx { src: liste(), code: liste(), etiq: liste(), fix_pos: liste(), fix_etiq: liste(), fix_genre: liste(),
                   vus: liste(), segs: liste(), pile: liste() };
    // entrées : le dossier du programme, un caractère par entrée, terminé par 0 (les fichiers importés y sont cherchés)
    soit d = liste();
    soit x = entrée();
    tantque x != 0 {
        ajouter(d, x);
        x = entrée();
    }
    charger_source(c, "source.vtx", 0, texte_de(d, 0, d.n));
    si c.erreur != 0 {
        ecrire_texte(1, "vtxc : compilation arrêtée\n");
        retour;
    }
    soit avec_prelude = entrée();          // 1 : ajouter le prélude, comme vtx.py
    c.optim = entrée();                    // 1 : optimiser, comme vtx.py par défaut
    c.partition = entrée();                // 1 : partition des tâches en accords
    c.lignes_dbg = entrée();               // 1 : table des lignes pour le pas à pas (absente : 0)
    c.dbg = liste();
    c.marques = liste();
    constantes_predefinies(c);
    lexer(c);
    c.tok = c.jetons;
    programme(c);
    c.segs_prog = c.segs;
    si c.cumul_utilise {
        soit tz = c.tableaux;
        tantque tz != nul {
            soit nm = tz.taille;
            si tz.sorte == 1 || tz.sorte == 2 {
                nm = (tz.taille + 15) / 16;
            } sinon si tz.sorte == 3 {
                nm = tz.taille * struct_numero(c, tz.st).nb;
            }
            si tz.etage == 3 && tz.base < COPIES_FIN && tz.base + nm > COPIES_DEBUT {
                erreur_nom(c, 0, "ce tableau occupe @3[14680064..15728640], réservé aux copies des tableaux cumulés :", tz.nom);
            }
            tz = tz.suivant;
        }
    }
    injecter_donnees(c);
    si avec_prelude == 1 && c.erreur == 0 {
        // le prélude est lu à part : les constantes et les tableaux du programme n'y sont pas visibles
        soit consts = c.consts;
        soit tableaux = c.tableaux;
        c.consts = nul;
        constantes_predefinies(c);
        c.tableaux = nul;
        c.src = liste();
        si c.optim {
            prelude_utile(c, texte_prelude());
        } sinon {
            // sans optimisation, rien n'est élagué : tout le prélude est compilé, comme vtx.py
            ajouter_texte(c.src, texte_prelude());
        }
        c.jetons = nul;
        c.segs = nul;
        lexer(c);
        c.tok = c.jetons;
        c.en_prelude = 1;
        programme(c);
        c.en_prelude = 0;
        c.consts = consts;
        c.tableaux = tableaux;
    }
    si c.erreur == 0 {
        typer_textes(c);
    }
    si c.erreur == 0 {
        generer(c);
    }
    si c.erreur != 0 {
        ecrire_texte(1, "vtxc : compilation arrêtée\n");
        retour;
    }
    soit s = ouvrir_ecriture("code.mots");
    pour i dans 0..c.code.n {
        si i > 0 {
            ecrire_car(s, ',');
        }
        ecrire_nombre(s, elem(c.code, i));
    }
    si c.optim && c.partition {
        // « mots;table des accords »
        ecrire_car(s, ';');
        soit t = table_accords(c);
        pour j dans 0..t.n {
            si j > 0 {
                ecrire_car(s, ',');
            }
            ecrire_nombre(s, elem(t, j));
        }
    }
    si c.lignes_dbg == 1 {
        // « mots;table;lignes » : adresse, ligne, adresse, ligne…
        si !(c.optim && c.partition) {
            ecrire_car(s, ';');
        }
        ecrire_car(s, ';');
        pour j dans 0..c.dbg.n {
            si j > 0 {
                ecrire_car(s, ',');
            }
            ecrire_nombre(s, elem(c.dbg, j));
        }
    }
    fermer(s);
    ecrire_texte(1, "vtxc : ");
    ecrire_nombre(1, c.code.n);
    ecrire_texte(1, " mots\n");
}

// Le prélude de vtx.py, mot pour mot (le test vérifie qu'il est identique) : ajouté à la fin du programme compilé,
// sauf les fonctions que le programme définit lui-même.
fonction texte_prelude() {
    retour "\nfonction abs(x) { si x >= 2147483648 { retour 0 - x; } retour x; }\nfonction inf(a, b) { retour (a ^ 2147483648) < (b ^ 2147483648); }\nfonction sup(a, b) { retour (b ^ 2147483648) < (a ^ 2147483648); }\nfonction __hyp_debut() {\n    soit d = @3[16777201];\n    si d == 0 { @3[16777200] = 15728640; }\n    @3[16777201] = d + 1;\n    retour @3[16777200];\n}\nfonction __hyp_noter(e, a) {\n    soit p = @3[16777200];\n    @3[p] = e;\n    @3[p + 1] = a;\n    @3[p + 2] = @(e)[a];\n    @3[16777200] = p + 3;\n}\nfonction __hyp_valider() { @3[16777201] = @3[16777201] - 1; }\nfonction __hyp_annuler(p0) {\n    soit p = @3[16777200];\n    tantque p > p0 {\n        p = p - 3;\n        @(@3[p])[@3[p + 1]] = @3[p + 2];\n    }\n    @3[16777200] = p0;\n    @3[16777201] = @3[16777201] - 1;\n}\nfonction divs(a, b) {\n    soit n = 0;\n    si a >= 2147483648 { a = 0 - a; n = 1; }\n    si b >= 2147483648 { b = 0 - b; n = 1 - n; }\n    soit q = a / b;\n    si n == 1 { retour 0 - q; }\n    retour q;\n}\nfonction mods(a, b) {\n    soit n = 0;\n    si a >= 2147483648 { a = 0 - a; n = 1; }\n    si b >= 2147483648 { b = 0 - b; }\n    soit r = a % b;\n    si n == 1 { retour 0 - r; }\n    retour r;\n}\nfonction asr(a, n) {\n    soit k = n & 31;\n    soit r = a >> k;\n    si a >= 2147483648 && k > 0 { r = r | (4294967295 << (32 - k)); }\n    retour r;\n}\nfonction signe(x) { si x == 0 { retour 0; } si x >= 2147483648 { retour 4294967295; } retour 1; }\nfonction exp2(x: flottant): flottant {\n    si x < -126.0 { retour 0.0; }\n    si x >= 128.0 { retour comme_flottant(2139095040); }\n    soit n = entier(x);\n    si flottant_signe(n) > x { n = n - 1; }\n    soit f = x - flottant_signe(n);\n    soit p = 1.0 + f * (0.6931472 + f * (0.2402265 + f * (0.05550411 + f * (0.009618129 + f * (0.001333355\n        + f * (0.0001540353 + f * 0.00001525273))))));\n    retour comme_flottant(bits(p) + (n << 23));\n}\nfonction __lshl(a: long, n): long {\n    soit k = n & 63;\n    si k == 0 { retour a; }\n    si k >= 32 { retour long_de(bas(a) << (k - 32), 0); }\n    retour long_de((haut(a) << k) | (bas(a) >> (32 - k)), bas(a) << k);\n}\nfonction __lsar(a: long, n): long {\n    soit k = n & 63;\n    soit h = haut(a);\n    si k == 0 { retour a; }\n    soit s = 0;\n    si h >= 2147483648 { s = 4294967295; }\n    si k >= 32 { retour long_de(s, asr(h, k - 32)); }\n    retour long_de(asr(h, k), (bas(a) >> k) | (h << (32 - k)));\n}\nfonction __ldivu(ah, al, bh, bl, reste): long {\n    soit qh = 0; soit ql = 0; soit rh = 0; soit rl = 0;\n    pour i dans 0..64 {\n        soit bit = 0;\n        si i < 32 { bit = (ah >> (31 - i)) & 1; } sinon { bit = (al >> (63 - i)) & 1; }\n        soit dessus = rh >> 31;\n        rh = (rh << 1) | (rl >> 31);\n        rl = (rl << 1) | bit;\n        qh = (qh << 1) | (ql >> 31);\n        ql = ql << 1;\n        si dessus == 1 || rh > bh || (rh == bh && rl >= bl) {\n            soit emprunt = 0;\n            si rl < bl { emprunt = 1; }\n            rl = rl - bl;\n            rh = rh - bh - emprunt;\n            ql = ql | 1;\n        }\n    }\n    si reste == 1 { retour long_de(rh, rl); }\n    retour long_de(qh, ql);\n}\nfonction __ldiv(a: long, b: long, reste): long {\n    si b == 0L { si reste == 1 { retour a; } retour 0L - 1L; }\n    soit na = 0;\n    soit nb = 0;\n    soit x = a;\n    soit y = b;\n    si a < 0L { x = 0L - a; na = 1; }\n    si b < 0L { y = 0L - b; nb = 1; }\n    soit q = __ldivu(haut(x), bas(x), haut(y), bas(y), reste);\n    si reste == 1 { si na == 1 { retour 0L - q; } retour q; }\n    si na != nb { retour 0L - q; }\n    retour q;\n}\nfonction min(a, b) { si a < b { retour a; } retour b; }\nfonction max(a, b) { si a > b { retour a; } retour b; }\nfonction poids(ecart, temperature) {\n    soit d = ecart >> temperature;\n    si d < 16 { retour 65536 >> d; }\n    retour 0;\n}\nfonction gdotn(ea, a, eb, b, n) {\n    soit s = 0;\n    pour i dans 0..n { s = s + gdot(@(ea)[a + i], @(eb)[b + i]); }\n    retour s;\n}\nfonction copier(ed, d, es, s, n) {\n    pour i dans 0..n { @(ed)[d + i] = @(es)[s + i]; }\n}\nfonction melange(ev, bv, ep, bp, decalage, n) {\n    soit s = 0;\n    pour i dans 0..n { s = s + @(ep)[bp + i] * ((@(ev)[bv + i] >> decalage) & 255); }\n    retour s;\n}\nfonction longueur(t) {\n    retour @(t >> 24)[t & 16777215];\n}\nfonction car(t, i) {\n    retour @(t >> 24)[(t & 16777215) + 1 + i];\n}\nfonction changer_car(t, i, c) {\n    @(t >> 24)[(t & 16777215) + 1 + i] = c;\n}\nfonction texte_egal(a, b) {\n    soit n = longueur(a);\n    si n != longueur(b) {\n        retour 0;\n    }\n    pour i dans 0..n {\n        si car(a, i) != car(b, i) {\n            retour 0;\n        }\n    }\n    retour 1;\n}\nfonction nouveau(n) {\n    // chaque bloc a un mot d'en-tête (sa taille) juste avant lui ; un bloc libéré de la bonne taille est repris\n    // d'abord (listes par taille en @3[14680064 + taille], la liste 0 pour les grands blocs)\n    si n == 0 {\n        n = 1;\n    }\n    si n <= 64 {\n        soit t = @3[14680064 + n];\n        si t != 0 {\n            @3[14680064 + n] = @3[t];\n            @3[t - 1] = n;\n            pour i dans 0..n {\n                @3[t + i] = 0;\n            }\n            retour 50331648 + t;\n        }\n    }\n    // un grand bloc libre (premier assez grand) ; ce qui dépasse redevient un bloc libre\n    soit prec = 0;\n    soit g = @3[14680064];\n    tantque g != 0 {\n        soit taille = @3[g - 1] & 16777215;\n        si taille >= n {\n            si prec == 0 {\n                @3[14680064] = @3[g];\n            } sinon {\n                @3[prec] = @3[g];\n            }\n            si taille >= n + 2 {\n                __rendre_suite(g + n, g + taille);\n                taille = n;\n            }\n            @3[g - 1] = taille;\n            pour j dans 0..taille {\n                @3[g + j] = 0;\n            }\n            retour 50331648 + g;\n        }\n        prec = g;\n        g = @3[g];\n    }\n    soit p = @3[14680056];\n    si p == 0 {\n        p = 8388608;\n    }\n    si p + n + 1 > 14080048 {\n        // le tas est plein (les 600 000 derniers mots restent au ramasse-miettes) : une purge, puis un second essai\n        @3[14680056] = p;\n        // pas de purge automatique si la dernière n'a rendu presque rien (le tas est vraiment plein : on ne s'acharne\n        // pas, nouveau rend nul) ; une purge demandée (ramasser) lève cette interdiction\n        si @3[14680252] == 0 && @3[14680253] == 0 {\n            @3[14680252] = 1;\n            soit libres = ramasser();\n            @3[14680252] = 0;\n            si libres < 355715 {\n                @3[14680253] = 1;\n            }\n            si libres > n {\n                retour nouveau(n);\n            }\n        }\n        retour 0;\n    }\n    @3[p] = n;\n    @3[14680056] = p + n + 1;\n    pour k dans 0..n {\n        @3[p + 1 + k] = 0;\n    }\n    retour 50331649 + p;\n}\n// un bloc libre d'en-tête h0, qui s'étend jusqu'à h1 (exclu) : rangé dans la liste de sa taille\nfonction __rendre_suite(h0, h1) {\n    soit taille = h1 - h0 - 1;\n    @3[h0] = taille | 2147483648;\n    soit k = taille;\n    si k > 64 {\n        k = 0;\n    }\n    @3[h0 + 1] = @3[14680064 + k];\n    @3[14680064 + k] = h0 + 1;\n}\n// le tas est plein : le programme s'arrête avec un message clair (au lieu d'écrire à l'adresse 0)\nfonction __verifier(h) {\n    si h == 0 {\n        __service(10, 0);\n    }\n    retour h;\n}\nfonction liberer(h) {\n    soit p = h & 16777215;\n    si p <= 8388608 || p >= @3[14680056] {\n        retour;\n    }\n    soit taille = @3[p - 1];\n    si taille >= 2147483648 {\n        retour;\n    }\n    @3[p - 1] = taille | 2147483648;\n    soit k = taille;\n    si k > 64 {\n        k = 0;\n    }\n    @3[p] = @3[14680064 + k];\n    @3[14680064 + k] = p;\n}\nfonction tas_marque() {\n    soit p = @3[14680056];\n    si p == 0 {\n        p = 8388608;\n    }\n    retour p;\n}\nfonction tas_retour(m) {\n    @3[14680056] = m;\n    pour k dans 0..65 {\n        @3[14680064 + k] = 0;\n    }\n}\nfonction tas_utilise() {\n    soit p = @3[14680056];\n    si p == 0 {\n        retour 0;\n    }\n    retour p - 8388608;\n}\nfonction __marquer(v, deb, mar, pil, np, cap, haut) {\n    soit e = v >> 24;\n    si e != 3 && e != 0 {\n        retour np;\n    }\n    soit p = v & 16777215;\n    si p <= 8388608 || p >= haut {\n        retour np;\n    }\n    soit k = p - 8388608;\n    si ((@3[deb + k / 32] >> (k % 32)) & 1) == 0 || ((@3[mar + k / 32] >> (k % 32)) & 1) == 1 {\n        retour np;\n    }\n    @3[mar + k / 32] = @3[mar + k / 32] | (1 << (k % 32));\n    si np < cap {\n        @3[pil + np] = p;\n        retour np + 1;\n    }\n    @3[14680063] = 1;\n    retour np;\n}\nfonction ramasser() {\n    // ramasse-miettes : ce que tiennent les variables (la pile) et les poignées protégées reste ; tout bloc qu'on\n    // ne peut plus atteindre est libéré. Rend le nombre de mots libérés.\n    soit haut = @3[14680056];\n    si haut == 0 {\n        retour 0;\n    }\n    @3[14680254] = @3[14680254] + 1;\n    si @3[14680252] == 0 {\n        @3[14680253] = 0;\n    }\n    soit nm = (haut - 8388608) / 32 + 1;\n    soit deb = haut;\n    soit mar = haut + nm;\n    soit pil = haut + 2 * nm;\n    si pil + 1024 > 14680048 {\n        retour 0;\n    }\n    soit cap = 14680048 - pil;\n    pour i dans 0..(2 * nm) {\n        @3[deb + i] = 0;\n    }\n    soit h = 8388608;\n    tantque h < haut {\n        soit kb = h + 1 - 8388608;\n        @3[deb + kb / 32] = @3[deb + kb / 32] | (1 << (kb % 32));\n        h = h + 1 + (@3[h] & 16777215);\n    }\n    @3[14680063] = 0;\n    soit np = 0;\n    pour a dans pile()..8388608 {\n        np = __marquer(@0[a], deb, mar, pil, np, cap, haut);\n    }\n    pour r dans 0..@3[14680200] {\n        np = __marquer(@3[14680201 + r], deb, mar, pil, np, cap, haut);\n    }\n    tantque np > 0 {\n        np = np - 1;\n        soit p = @3[pil + np];\n        soit taille = @3[p - 1];\n        si taille < 2147483648 {\n            pour j dans 0..taille {\n                np = __marquer(@3[p + j], deb, mar, pil, np, cap, haut);\n            }\n        }\n    }\n    si @3[14680063] == 1 {\n        retour 0;\n    }\n    // balayage : les listes de blocs libres sont refaites ; des blocs libres voisins sont fondus en un seul ; une suite\n    // libre qui touche le sommet fait redescendre le tas\n    pour k2 dans 0..65 {\n        @3[14680064 + k2] = 0;\n    }\n    soit libres = 0;\n    soit debut_libre = 0;\n    h = 8388608;\n    tantque h < haut {\n        soit b = h + 1;\n        soit t2 = @3[h];\n        soit kb2 = b - 8388608;\n        si t2 >= 2147483648 || ((@3[mar + kb2 / 32] >> (kb2 % 32)) & 1) == 0 {\n            si t2 < 2147483648 {\n                libres = libres + t2;\n            }\n            si debut_libre == 0 {\n                debut_libre = h;\n            }\n        } sinon si debut_libre != 0 {\n            __rendre_suite(debut_libre, h);\n            debut_libre = 0;\n        }\n        h = b + (t2 & 16777215);\n    }\n    si debut_libre != 0 {\n        @3[14680056] = debut_libre;\n    }\n    retour libres;\n}\nfonction purges() {\n    retour @3[14680254];\n}\nfonction proteger(h) {\n    soit n = @3[14680200];\n    si n < 50 {\n        @3[14680201 + n] = h;\n        @3[14680200] = n + 1;\n    }\n}\nfonction sauver_bloc(nom, adr, n) {\n    @3[14680060] = nom;\n    @3[14680061] = adr;\n    @3[14680062] = n;\n    retour __service(6, 0);\n}\nfonction charger_bloc(nom, adr, n) {\n    @3[14680060] = nom;\n    @3[14680061] = adr;\n    @3[14680062] = n;\n    retour __service(7, 0);\n}\nfonction __nom_ent(nom) {\n    soit n = longueur(nom);\n    soit t = texte_neuf(n + 4);\n    pour i dans 0..n {\n        changer_car(t, i, car(nom, i));\n    }\n    changer_car(t, n, 46);\n    changer_car(t, n + 1, 101);\n    changer_car(t, n + 2, 110);\n    changer_car(t, n + 3, 116);\n    retour t;\n}\nfonction sauver_tas(nom, racine) {\n    // tout le tas dans le fichier « nom », et son en-tête (sommet, listes libres, racine, format) dans « nom.ent »\n    @3[14680063] = racine;\n    @3[14680255] = 3;\n    soit haut = tas_marque();\n    soit e = __nom_ent(nom);\n    soit r = sauver_bloc(e, 50331648 + 14680056, 200);\n    si r == 4294967295 {\n        retour r;\n    }\n    retour sauver_bloc(nom, 50331648 + 8388608, haut - 8388608);\n}\nfonction charger_tas(nom) {\n    // rend la racine rangée par sauver_tas, ou 0 si le fichier n'existe pas\n    // l'en-tête est lu à part (dans la réserve du ramasse-miettes) : un fichier absent, ou d'un autre format, ne\n    // touche à rien et rend 0\n    soit e = __nom_ent(nom);\n    si charger_bloc(e, 50331648 + 14400000, 200) != 200 || @3[14400199] != 3 {\n        retour 0;\n    }\n    pour i dans 0..200 {\n        @3[14680056 + i] = @3[14400000 + i];\n    }\n    charger_bloc(nom, 50331648 + 8388608, @3[14680056] - 8388608);\n    retour @3[14680063];\n}\nfonction ecrire_texte(c, t) {\n    pour i dans 0..longueur(t) {\n        ecrire_car(c, car(t, i));\n    }\n}\nfonction ecrire_nombre(c, n) {\n    si n >= 10 {\n        ecrire_nombre(c, n / 10);\n    }\n    ecrire_car(c, 48 + n % 10);\n}\nfonction texte_neuf(n) {\n    soit t = __verifier(nouveau(n + 1));\n    @(t >> 24)[t & 16777215] = n;\n    retour t;\n}\nfonction __texte_tas(t): texte {\n    // un texte rangé dans le tas (champ, tableau, dictionnaire) : un texte écrit dans le programme (gardé avec le code, à\n    // l'étage 0) est recopié dans le tas, pour qu'une mémoire sauvée (sauver_tas) reste juste quand le programme change\n    si t == 0 || (t >> 24) != 0 {\n        retour t;\n    }\n    soit n = longueur(t);\n    soit r = texte_neuf(n);\n    pour i dans 0..n {\n        changer_car(r, i, car(t, i));\n    }\n    retour r;\n}\nfonction __mettre(c, x) {\n    si c < 65536 {\n        ecrire_car(c, x);\n    } sinon {\n        soit e = c >> 24;\n        soit a = c & 16777215;\n        soit n = @(e)[a];\n        @(e)[a + 1 + n] = x;\n        @(e)[a] = n + 1;\n    }\n}\nfonction __mettre_nombre(c, n) {\n    si n >= 10 {\n        __mettre_nombre(c, n / 10);\n    }\n    __mettre(c, 48 + n % 10);\n}\nfonction ecrire_entier(c, n) {\n    si n >= 2147483648 {\n        __mettre(c, 45);\n        n = 0 - n;\n    }\n    __mettre_nombre(c, n);\n}\nfonction ecrire_hexa(c, n) {\n    __mettre(c, 35);\n    pour i dans 0..8 {\n        soit k = (n >> (28 - 4 * i)) & 15;\n        si k < 10 { __mettre(c, 48 + k); } sinon { __mettre(c, 55 + k); }\n    }\n}\nfonction __ecrire_chiffres(c, q, d) {\n    si d > 1 {\n        __ecrire_chiffres(c, q / 10, d - 1);\n    }\n    __mettre(c, 48 + q % 10);\n}\nfonction ecrire_flottant(c, x: flottant, d) {\n    soit b = bits(x);\n    si b >= 2147483648 {\n        __mettre(c, 45);\n        b = b & 2147483647;\n    }\n    si b >= 2139095040 {\n        si b == 2139095040 {\n            __mettre(c, 105); __mettre(c, 110); __mettre(c, 102);\n        } sinon {\n            __mettre(c, 110); __mettre(c, 97); __mettre(c, 110);\n        }\n        retour;\n    }\n    soit y = comme_flottant(b);\n    soit auto = 0;\n    si d == 4294967295 { auto = 1; d = 6; }\n    si d > 9 { d = 9; }\n    soit e = 0;\n    soit eneg = 0;\n    si y >= 10000000.0 || (auto == 1 && y < 0.0001 && b != 0) {\n        tantque y >= 10.0 { y = y / 10.0; e = e + 1; }\n        tantque y < 1.0 { y = y * 10.0; e = e + 1; eneg = 1; }\n    }\n    soit ip = entier(y);\n    si auto == 1 {\n        soit nc = 1;\n        soit t = ip / 10;\n        tantque t > 0 { nc = nc + 1; t = t / 10; }\n        si nc >= 7 { d = 1; } sinon { d = 7 - nc; }\n    }\n    soit pe = 1;\n    pour i dans 0..d { pe = pe * 10; }\n    soit q = arrondi((y - flottant(ip)) * flottant(pe));\n    si q >= pe { ip = ip + 1; q = q - pe; }\n    si auto == 1 {\n        tantque d > 1 && q % 10 == 0 { q = q / 10; d = d - 1; }\n    }\n    __mettre_nombre(c, ip);\n    si d > 0 {\n        __mettre(c, 46);\n        __ecrire_chiffres(c, q, d);\n    }\n    si e > 0 {\n        __mettre(c, 101);\n        si eneg == 1 { __met