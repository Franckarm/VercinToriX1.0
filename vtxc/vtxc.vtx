5;\n    si (@3[p] + 1) * 4 > @3[p + 1] * 3 {\n        soit cap = @3[p + 1];\n        soit ks = @3[p + 2];\n        soit vs = @3[p + 3];\n        soit qs = @3[p + 4];\n        @3[p] = 0;\n        @3[p + 1] = 2 * cap;\n        @3[p + 2] = __verifier(nouveau(2 * cap)) & 16777215;\n        @3[p + 3] = __verifier(nouveau(2 * cap)) & 16777215;\n        @3[p + 4] = __verifier(nouveau(2 * cap)) & 16777215;\n        pour k dans 0..cap {\n            si @3[ks + k] != 0 {\n                __remettre(d, @3[ks + k], @3[vs + k], @3[qs + k]);\n            }\n        }\n        liberer(50331648 + ks);\n        liberer(50331648 + vs);\n        liberer(50331648 + qs);\n    }\n    soit i = __place(d, cle);\n    si @3[@3[p + 2] + i] == 0 {\n        @3[@3[p + 2] + i] = cle;\n        @3[p] = @3[p] + 1;\n    }\n    retour i;\n}\nfonction ranger(d, cle, v) {\n    soit p = d & 16777215;\n    soit i = __case(d, cle);\n    @3[@3[p + 3] + i] = v;\n    @3[@3[p + 4] + i] = 2;\n}\nfonction affirmer(d, cle, v) {\n    soit p = d & 16777215;\n    soit neuf = existe(d, cle) == 0;\n    soit i = __case(d, cle);\n    soit q = @3[@3[p + 4] + i];\n    si neuf {\n        q = 2;\n    } sinon si q == 1 || (q == 2 && @3[@3[p + 3] + i] != v) {\n        q = 3;\n    }\n    @3[@3[p + 3] + i] = v;\n    @3[@3[p + 4] + i] = q;\n}\nfonction nier(d, cle) {\n    soit p = d & 16777215;\n    soit neuf = existe(d, cle) == 0;\n    soit i = __case(d, cle);\n    soit q = @3[@3[p + 4] + i];\n    si neuf {\n        q = 1;\n    } sinon si q == 2 {\n        q = 3;\n    }\n    @3[@3[p + 4] + i] = q;\n}\nfonction trouver(d, cle) {\n    soit p = d & 16777215;\n    soit i = __place(d, cle);\n    retour @3[@3[p + 3] + i];\n}\nfonction existe(d, cle) {\n    soit p = d & 16777215;\n    retour @3[@3[p + 2] + __place(d, cle)] != 0;\n}\nfonction savoir(d, cle): logique {\n    si d == 0 {\n        retour inconnu;\n    }\n    soit p = d & 16777215;\n    soit i = __place(d, cle);\n    si @3[@3[p + 2] + i] == 0 {\n        si @3[p + 5] == 1 {\n            retour inconnu;\n        }\n        retour faux;\n    }\n    retour comme_logique(@3[@3[p + 4] + i]);\n}\nfonction nommer(l: logique, noms): texte {\n    retour @3[@3[(noms & 16777215) + 2] + entier(l)];\n}\nfonction cles(d) {\n    soit p = d & 16777215;\n    soit r = tableau(0);\n    soit ks = @3[p + 2];\n    pour k dans 0..@3[p + 1] {\n        si @3[ks + k] != 0 {\n            __ajouter(r, @3[ks + k]);\n        }\n    }\n    retour r;\n}\nfonction majuscules(t): texte {\n    soit n = longueur(t);\n    soit r = texte_neuf(n);\n    pour i dans 0..n {\n        soit c = car(t, i);\n        si (c >= 97 && c <= 122) || (c >= 224 && c <= 254 && c != 247) {\n            c = c - 32;\n        }\n        changer_car(r, i, c);\n    }\n    retour r;\n}\nfonction minuscules(t): texte {\n    soit n = longueur(t);\n    soit r = texte_neuf(n);\n    pour i dans 0..n {\n        soit c = car(t, i);\n        si (c >= 65 && c <= 90) || (c >= 192 && c <= 222 && c != 215) {\n            c = c + 32;\n        }\n        changer_car(r, i, c);\n    }\n    retour r;\n}\nfonction commence_par(t, debut) {\n    soit n = longueur(debut);\n    si n > longueur(t) {\n        retour 0;\n    }\n    pour i dans 0..n {\n        si car(t, i) != car(debut, i) {\n            retour 0;\n        }\n    }\n    retour 1;\n}\nfonction finit_par(t, fin) {\n    soit n = longueur(fin);\n    soit m = longueur(t);\n    si n > m {\n        retour 0;\n    }\n    pour i dans 0..n {\n        si car(t, m - n + i) != car(fin, i) {\n            retour 0;\n        }\n    }\n    retour 1;\n}\nfonction car_texte(c): texte {\n    soit t = texte_neuf(1);\n    changer_car(t, 0, c);\n    retour t;\n}\nfonction repeter(t, n): texte {\n    soit m = longueur(t);\n    soit r = texte_neuf(m * n);\n    pour k dans 0..n {\n        pour i dans 0..m {\n            changer_car(r, k * m + i, car(t, i));\n        }\n    }\n    retour r;\n}\nfonction nettoyer(t): texte {\n    soit a = 0;\n    soit b = longueur(t);\n    tantque a < b && (car(t, a) == 32 || car(t, a) == 9 || car(t, a) == 10 || car(t, a) == 13) {\n        a = a + 1;\n    }\n    tantque b > a && (car(t, b - 1) == 32 || car(t, b - 1) == 9 || car(t, b - 1) == 10 || car(t, b - 1) == 13) {\n        b = b - 1;\n    }\n    retour sous_texte(t, a, b);\n}\nfonction decouper(t, sep) {\n    soit r = tableau(0);\n    soit n = longueur(t);\n    soit m = longueur(sep);\n    soit debut = 0;\n    soit i = 0;\n    tantque i + m <= n && m > 0 {\n        soit egal = 1;\n        pour k dans 0..m {\n            si car(t, i + k) != car(sep, k) {\n                egal = 0;\n            }\n        }\n        si egal == 1 {\n            __ajouter(r, sous_texte(t, debut, i));\n            i = i + m;\n            debut = i;\n        } sinon {\n            i = i + 1;\n        }\n    }\n    __ajouter(r, sous_texte(t, debut, n));\n    retour r;\n}\nfonction assembler(tab, sep): texte {\n    soit p = tab & 16777215;\n    soit d = @3[p + 2];\n    soit n = @3[p];\n    soit total = 0;\n    pour k dans 0..n {\n        total = total + longueur(@3[d + k]);\n    }\n    si n > 0 {\n        total = total + (n - 1) * longueur(sep);\n    }\n    soit r = texte_neuf(total);\n    soit j = 0;\n    pour k dans 0..n {\n        si k > 0 {\n            pour i dans 0..longueur(sep) {\n                changer_car(r, j, car(sep, i));\n                j = j + 1;\n            }\n        }\n        soit x = @3[d + k];\n        pour i dans 0..longueur(x) {\n            changer_car(r, j, car(x, i));\n            j = j + 1;\n        }\n    }\n    retour r;\n}\nfonction remplacer(t, ancien, neuf): texte {\n    retour assembler(decouper(t, ancien), neuf);\n}\nfonction lire_ligne(): texte {\n    soit t = __verifier(nouveau(257));\n    soit c = lire_car(1);\n    si c == 4294967295 {\n        retour __texte_fin(t);\n    }\n    tantque c != 10 && c != 4294967295 {\n        si c != 13 {\n            si longueur(t) < 256 {\n                __mettre(t, c);\n            }\n        }\n        c = lire_car(1);\n    }\n    retour __texte_fin(t);\n}\nfonction pgcd(a, b) {\n    tantque b != 0 {\n        soit r = a % b;\n        a = b;\n        b = r;\n    }\n    retour a;\n}\nfonction borne(x, a, b) {\n    si x .< a {\n        retour a;\n    }\n    si x .> b {\n        retour b;\n    }\n    retour x;\n}\n";
}
