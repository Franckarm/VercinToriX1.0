// Feu de camp : la scène en voxels (volume N³ = 128³ dans l'étage 1, voxel (x, y, z) = @1[(z·N + y)·N + x], y vers le haut).
// Un voxel est un mot #MMVVCCAA : MM matière, VV variation (grain de la pierre, de l'écorce…), CC chaleur, AA densité.
// Densité 0 : vide ; 1 à 127 : brume (flammes, fumée) ; 128 à 255 : plein (sol, pierres, bûches, braises, marmite).
// Matières : 1 neige, 2 cendre, 3 pierre, 4 écorce, 5 bois carbonisé, 6 braise, 7 fonte (marmite), 8 flamme, 9 fumée.

constante N = 128;
tableau blocs[4096] @2[200000];      // bloc de 8³ : 1 s'il contient autre chose que du vide

donnees @2[410000] = {
    90, 10, 69, 6, 4, 5,   84, 10, 84, 7, 6, 5,   71, 10, 92, 8, 5, 5,   55, 10, 89, 6, 4, 5,
    42, 10, 81, 7, 6, 5,   35, 10, 66, 8, 5, 5,   40, 10, 51, 6, 4, 5,   50, 10, 40, 7, 6, 5,
    66, 10, 35, 8, 5, 5,   80, 10, 42, 6, 4, 5,   90, 10, 54, 7, 6, 5 };          // pierres : centre, rayons
donnees @2[410100] = {
    81, 10, 73, 62, 44, 65,   60, 10, 83, 62, 44, 63,   45, 10, 66, 65, 44, 62,
    56, 10, 47, 66, 44, 64,   78, 10, 51, 65, 44, 66 };                           // bûches : pied, sommet

fonction ecart(a, b) {
    si a > b {
        retour a - b;
    }
    retour b - a;
}

fonction hache(x, y, z) {
    soit h = (x * 73856093) ^ (y * 19349663) ^ (z * 83492791);
    h = h ^ (h >> 13);
    h = h * 1274126177;
    retour h ^ (h >> 16);
}

fonction voxel(m, v, c, a) {
    retour (m << 24) | ((v & 255) << 16) | ((c & 255) << 8) | (a & 255);
}

fonction poser(x, y, z, mot) {
    @1[(z * N + y) * N + x] = mot;
    blocs[((z >> 3) * 16 + (y >> 3)) * 16 + (x >> 3)] = 1;
}

fonction vide_ici(x, y, z) {
    retour (@1[(z * N + y) * N + x] & 255) < 128;
}

fonction sol() {
    pour z dans 0..N {
        pour x dans 0..N {
            soit h = 10;
            soit d2 = ecart(x, 64) * ecart(x, 64) + ecart(z, 64) * ecart(z, 64);
            soit m = 1;
            si d2 < 576 {
                m = 2;
            }
            soit v = hache(x, 1, z) & 31;
            pour y dans 0..h {
                poser(x, y, z, voxel(m, v, 0, 255));
            }
        }
    }
}

fonction pierres() {
    pour k dans 0..11 {
        soit cx = @2[410000 + k * 6];
        soit cy = @2[410001 + k * 6];
        soit cz = @2[410002 + k * 6];
        soit rx = @2[410003 + k * 6];
        soit ry = @2[410004 + k * 6];
        soit rz = @2[410005 + k * 6];
        soit r2 = rx * rx * ry * ry * rz * rz;
        pour z dans cz - rz..cz + rz + 1 {
            pour y dans cy - ry..cy + ry + 1 {
                pour x dans cx - rx..cx + rx + 1 {
                    soit dx = ecart(x, cx);
                    soit dy = ecart(y, cy);
                    soit dz = ecart(z, cz);
                    soit val = dx * dx * ry * ry * rz * rz + dy * dy * rx * rx * rz * rz + dz * dz * rx * rx * ry * ry;
                    soit h = hache(x, y, z);
                    si val <= (r2 * (28 + (h & 7))) / 32 {
                        poser(x, y, z, voxel(3, h >> 8, 0, 255));
                    }
                }
            }
        }
    }
}

fonction buches() {
    pour k dans 0..5 {
        soit bx = @2[410100 + k * 6];
        soit by = @2[410101 + k * 6];
        soit bz = @2[410102 + k * 6];
        soit ux = @2[410103 + k * 6] - bx;
        soit uy = @2[410104 + k * 6] - by;
        soit uz = @2[410105 + k * 6] - bz;
        soit l2 = ux * ux + uy * uy + uz * uz;
        soit x0 = min(bx, bx + ux) - 4;
        soit x1 = max(bx, bx + ux) + 5;
        soit z0 = min(bz, bz + uz) - 4;
        soit z1 = max(bz, bz + uz) + 5;
        pour z dans z0..z1 {
            pour y dans by - 4..by + uy + 5 {
                pour x dans x0..x1 {
                    soit px = x - bx;
                    soit py = y - by;
                    soit pz = z - bz;
                    soit tn = px * ux + py * uy + pz * uz;
                    si tn .>= 0 && tn .<= l2 {
                        soit perp = (px * px + py * py + pz * pz) * l2 - tn * tn;
                        si perp <= 9 * l2 {
                            soit h = hache(x, y, z);
                            soit frac = (tn * 100) / l2;
                            soit m = 4;
                            soit c = 0;
                            si frac < 30 {
                                m = 5;
                                si (h & 7) == 0 && perp >= 4 * l2 {
                                    m = 6;
                                    c = 160 + ((h >> 8) & 63);
                                }
                            }
                            poser(x, y, z, voxel(m, h >> 16, c, 255));
                        }
                    }
                }
            }
        }
    }
}

fonction braises() {
    pour z dans 53..76 {
        pour y dans 9..13 {
            pour x dans 53..76 {
                soit d2 = ecart(x, 64) * ecart(x, 64) + ecart(z, 64) * ecart(z, 64);
                soit h = hache(x, y, z);
                si d2 < 121 && (y < 11 || (h & 3) != 0) {
                    soit m = 5;
                    soit c = 0;
                    si (h & 1) == 1 {
                        m = 6;
                        c = 200 + ((h >> 8) & 55) - y * 4;
                    }
                    poser(x, y, z, voxel(m, h >> 16, c, 255));
                }
            }
        }
    }
}

fonction marmite() {
    pour z dans 43..58 {
        pour y dans 10..20 {
            pour x dans 97..112 {
                soit d2 = ecart(x, 104) * ecart(x, 104) + ecart(z, 50) * ecart(z, 50);
                si d2 <= 49 && !(y >= 12 && d2 <= 25) {
                    poser(x, y, z, voxel(7, hache(x, y, z) >> 20, 0, 255));
                }
            }
        }
    }
}

// Paramètres du feu (@2[450000 + k]) : 0 hauteur des flammes, 1 rayon à la base, 2 penchant (128 = droit),
// 3 vitesse de montée des langues, 4 puissance de la lumière (× 64), 5 teinte (128 = neutre), 6 seuil des langues,
// 7 balancement (0 à 3) ; @2[450010] : numéro de l'image. Fixés par construire_scene, puis par la mémoire du cube.
constante FEU = 450000;

fonction regler_feu(hauteur, rayon, penchant, montee, puissance, teinte, seuil, balance) {
    @2[FEU] = hauteur;
    @2[FEU + 1] = rayon;
    @2[FEU + 2] = penchant;
    @2[FEU + 3] = montee;
    @2[FEU + 4] = puissance;
    @2[FEU + 5] = teinte;
    @2[FEU + 6] = seuil;
    @2[FEU + 7] = balance;
}

fonction flammes() {
    soit f = @2[FEU + 10];
    soit glisse = f * @2[FEU + 3];                  // les langues montent : le bruit est lu plus bas à chaque image
    pour y dans 12..12 + @2[FEU] {
        soit hh = y - 12;
        soit r = @2[FEU + 1] - hh * 2 / 7;
        soit penche = (hh * hh * @2[FEU + 2] - hh * hh * 128) ./ 8192;   // la flamme se courbe en montant
        soit cx = 63 + (((hache(1, (y - glisse) >> 2, 7) >> 5) & 3) * @2[FEU + 7]) / 3 + penche;
        soit cz = 63 + ((hache(2, (y - glisse) >> 2, 9) >> 5) & 3);
        si r .> 0 {
            soit r2 = r * r;
            pour z dans cz - r..cz + r + 1 {
                pour x dans cx - r..cx + r + 1 {
                    soit d2 = ecart(x, cx) * ecart(x, cx) + ecart(z, cz) * ecart(z, cz);
                    soit n = hache(x >> 1, (y - glisse) >> 2, z >> 1) & 255;
                    si d2 < r2 && n > hh * @2[FEU + 6] && vide_ici(x, y, z) {
                        soit dens = 20 + ((r2 - d2) * 90) / r2;
                        soit chaud = 255 - hh * 3 - (d2 * 60) / r2 + @2[FEU + 5] - 128;
                        si chaud .< 0 {
                            chaud = 0;
                        }
                        si chaud .> 255 {
                            chaud = 255;
                        }
                        poser(x, y, z, voxel(8, n, chaud, dens));
                    }
                }
            }
        }
    }
}

fonction fumee() {
    soit f = @2[FEU + 10];
    pour y dans 60..127 {
        soit hh = y - 60;
        soit r = 5 + hh / 5;
        soit cx = 64 + hh / 4 + (hh * @2[FEU + 2] - hh * 128) ./ 256;
        soit cz = 64 + hh / 10;
        soit r2 = r * r;
        pour z dans cz - r..cz + r + 1 {
            pour x dans cx - r..cx + r + 1 {
                soit d2 = ecart(x, cx) * ecart(x, cx) + ecart(z, cz) * ecart(z, cz);
                soit n = hache(x >> 2, (y - f * 2) >> 2, z >> 2) & 255;
                si d2 < r2 && n < 140 && (@1[(z * N + y) * N + x] & 255) == 0 {
                    soit dens = 8 + (n & 15);
                    si dens > hh / 8 + 2 {
                        dens = dens - hh / 8;
                    } sinon {
                        dens = 2;
                    }
                    poser(x, y, z, voxel(9, n, 0, dens));
                }
            }
        }
    }
}

// Efface les flammes et la fumée (pour refaire le feu à chaque image).
fonction effacer_feu() {
    pour z dans 30..110 {
        pour y dans 12..127 {
            pour x dans 0..N {
                soit v = (z * N + y) * N + x;
                soit m = @1[v] >> 24;
                si m == 8 || m == 9 {
                    @1[v] = 0;
                }
            }
        }
    }
}

fonction construire_scene() {
    regler_feu(46, 13, 128, 0, 141, 128, 4, 3);
    @2[FEU + 10] = 0;
    sol();
    pierres();
    buches();
    braises();
    marmite();
    flammes();
    fumee();
}
