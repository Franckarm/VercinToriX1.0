// 0.835 : Ésus : la division et le reste par une constante, sur 128 bits (tests/test_esus.py)
// 0.835 : les accumulateurs : bornés (ou-exclusif, masque, reste) ou non (une somme, un produit, un décalage qui
// grandissent au-delà de 64 bits) : une borne fausse couperait un nombre, la sortie le montrerait
fonction accumulateurs() {
    soit x = 0;
    soit g = 7;
    soit r = 5;
    soit somme = 0;
    soit produit = 1;
    soit h = 1;
    pour i dans 0..5000 {
        x = x ^ ((i * 2654435761) & 4294967295);
        g = (g * 6364136223846793005 + 1442695040888963407) & 18446744073709551615;
        r = (r * 31 + i) % 1000003;
        somme = somme + i * 18446744073709551557;
        produit = produit * 3 + 1;
        h = (h << 5) + i;
    }
    afficher(x, g, r, somme, produit, h);
    afficher(x / 7, g % 1000, r * r, somme / 3, produit % 1000003, h % 97);
}

// 0.836 : les valeurs négatives : bornées en signé (Ésus prend l'opération de 64 bits signée), ou non
fonction negatifs() {
    soit t = 0;
    soit m = 0;
    soit q = 0;
    soit r = 0;
    soit grand = 0;
    soit tous = 0;
    pour i dans 0..3000 {
        soit d = (i % 21) - 10;
        t = d * 3 - 7;
        m = (i & 7) - 100;
        q = m ./ 7 + m .% 5;
        r = (0 - i) .% 9 + (0 - i) ./ 1000;
        grand = (0 - i) * 6148914691236517205;
        tous = tous + d;
    }
    afficher(t, m, q, r, grand, tous);
    afficher(t .< 0, m .>> 2, q * q, (0 - 3) * (0 - 4));
}

fonction brasser_mol(a, b) {
    retour (a * 31 + b) % 65536;
}

fonction decaler_mol(i) {
    retour (i & 255) - 128;
}

fonction sommer_mol(n) {
    soit s = 0;
    pour k dans 0..n {
        s = s + brasser_mol(k, k & 15) + decaler_mol(k);
    }
    retour s;
}

fonction cellules() {
    soit t = 0;
    pour j dans 0..2000 {
        t = t ^ sommer_mol(j % 100);
    }
    afficher(t, brasser_mol(3, 4), decaler_mol(7));
}

// une molécule récursive : sa membrane tient d'un appel à l'autre
fonction descendre_mol(n, acc) {
    si n == 0 {
        retour acc % 1000;
    }
    retour descendre_mol(n - 1, (acc * 7 + n) % 100003);
}

fonction principal() {
    cellules();
    afficher(descendre_mol(50, 1), descendre_mol(3, 99999));
    negatifs();
    accumulateurs();
    soit x = 1;
    soit s = 0;
    pour i dans 0..3000 {
        x = x * 6364136223846793005 + 1442695040888963407 + (x >> 64) * 31;
        s = s ^ (x / 3) ^ ((x % 3) << 3);
        s = s ^ (x / 5) ^ ((x % 5) << 3);
        s = s ^ (x / 7) ^ ((x % 7) << 3);
        s = s ^ (x / 10) ^ ((x % 10) << 3);
        s = s ^ (x / 12) ^ ((x % 12) << 3);
        s = s ^ (x / 1000003) ^ ((x % 1000003) << 3);
        s = s ^ (x / 18446744073709551617) ^ ((x % 18446744073709551617) << 3);
        s = s ^ (x / 170141183460469231731687303715884105729) ^ ((x % 170141183460469231731687303715884105729) << 3);
        s = s ^ (x / 340282366920938463463374607431768211455) ^ ((x % 340282366920938463463374607431768211455) << 3);
        s = s ^ (x / 1024) ^ ((x % 1024) << 3);
        s = s ^ (x / 1) ^ ((x % 1) << 3);
        s = s ^ (x / 1267650600228229401496703205373) ^ ((x % 1267650600228229401496703205373) << 3);
        s = s ^ (x / 1326920977895) ^ ((x % 1326920977895) << 3);
        s = s ^ (x / 217461284906067) ^ ((x % 217461284906067) << 3);
        s = s ^ (x / 1684) ^ ((x % 1684) << 3);
        s = s ^ (x / 689275300611517638676) ^ ((x % 689275300611517638676) << 3);
        s = s ^ (x / 468) ^ ((x % 468) << 3);
        s = s ^ (x / 691672907343361487) ^ ((x % 691672907343361487) << 3);
        s = s ^ (x / 10067229044200606) ^ ((x % 10067229044200606) << 3);
        s = s ^ (x / 389609436) ^ ((x % 389609436) << 3);
        s = s ^ (x / 3893353395913092844073) ^ ((x % 3893353395913092844073) << 3);
        s = s ^ (x / 4223335011051845549094) ^ ((x % 4223335011051845549094) << 3);
        s = s ^ (x / 4582846065090743968429752) ^ ((x % 4582846065090743968429752) << 3);
        s = s ^ (x / 298) ^ ((x % 298) << 3);
        s = s ^ (x / 73750997568051466787351) ^ ((x % 73750997568051466787351) << 3);
        s = s ^ (x / 50017775) ^ ((x % 50017775) << 3);
        s = s ^ (x / 2732574764684693247694) ^ ((x % 2732574764684693247694) << 3);
        s = s ^ (x / 19480258582275751) ^ ((x % 19480258582275751) << 3);
        s = s ^ (x / 74833) ^ ((x % 74833) << 3);
        s = s ^ (x / 1793407649115) ^ ((x % 1793407649115) << 3);
        s = s ^ (x / 359993063993175567610680718) ^ ((x % 359993063993175567610680718) << 3);
        s = s ^ (x / 14059884592889722819914) ^ ((x % 14059884592889722819914) << 3);
    }
    afficher(s);
    afficher(0 / 3, (0 - 1) / 3, (0 - 1) % 3, 340282366920938463463374607431768211454 / 3);
    afficher(0 / 5, (0 - 1) / 5, (0 - 1) % 5, 340282366920938463463374607431768211454 / 5);
    afficher(0 / 7, (0 - 1) / 7, (0 - 1) % 7, 340282366920938463463374607431768211454 / 7);
    afficher(0 / 10, (0 - 1) / 10, (0 - 1) % 10, 340282366920938463463374607431768211454 / 10);
    afficher(0 / 12, (0 - 1) / 12, (0 - 1) % 12, 340282366920938463463374607431768211454 / 12);
    afficher(0 / 1000003, (0 - 1) / 1000003, (0 - 1) % 1000003, 340282366920938463463374607431768211454 / 1000003);
    afficher(0 / 18446744073709551617, (0 - 1) / 18446744073709551617, (0 - 1) % 18446744073709551617, 340282366920938463463374607431768211454 / 18446744073709551617);
    afficher(0 / 170141183460469231731687303715884105729, (0 - 1) / 170141183460469231731687303715884105729, (0 - 1) % 170141183460469231731687303715884105729, 340282366920938463463374607431768211454 / 170141183460469231731687303715884105729);
    afficher(0 / 340282366920938463463374607431768211455, (0 - 1) / 340282366920938463463374607431768211455, (0 - 1) % 340282366920938463463374607431768211455, 340282366920938463463374607431768211454 / 340282366920938463463374607431768211455);
    afficher(0 / 1024, (0 - 1) / 1024, (0 - 1) % 1024, 340282366920938463463374607431768211454 / 1024);
    afficher(0 / 1, (0 - 1) / 1, (0 - 1) % 1, 340282366920938463463374607431768211454 / 1);
    afficher(0 / 1267650600228229401496703205373, (0 - 1) / 1267650600228229401496703205373, (0 - 1) % 1267650600228229401496703205373, 340282366920938463463374607431768211454 / 1267650600228229401496703205373);
}
