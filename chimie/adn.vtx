    @2[V_FORME + 70] = 13;
    @2[V_FORME + 71] = 5;
    @2[V_FORME + 72] = 5;
    @2[V_FORME + 73] = 5;
    @2[V_FORME + 74] = 5;
    @2[V_FORME + 75] = 5;
    @2[V_FORME + 76] = 13;
    @2[V_FORME + 77] = 13;
    @2[V_FORME + 78] = 13;
    @2[V_FORME + 79] = 13;
    @2[V_FORME + 80] = 5;
    @2[V_FORME + 81] = 5;
    @2[V_FORME + 82] = 13;
    @2[V_FORME + 83] = 13;
    @2[V_FORME + 84] = 13;
    @2[V_FORME + 85] = 14;
    @2[V_FORME + 86] = 13;
    @2[V_FORME + 87] = 13;
    @2[V_FORME + 88] = 5;
    @2[V_FORME + 89] = 5;
    @2[V_FORME + 90] = 13;
    @2[V_FORME + 91] = 5;
    @2[V_FORME + 92] = 5;
    @2[V_FORME + 93] = 13;
    @2[V_FORME + 94] = 12;
    @2[V_FORME + 95] = 5;
    @2[V_FORME + 108] = 5;
    @2[V_FORME + 109] = 5;
    @2[V_FORME + 110] = 5;
    @2[V_FORME + 128] = 13;
    @2[V_FORME + 129] = 13;
    @2[V_FORME + 130] = 13;
    @2[V_FORME + 131] = 13;
    @2[V_FORME + 132] = 13;
    @2[V_FORME + 133] = 13;
    @2[V_FORME + 134] = 13;
    @2[V_FORME + 135] = 13;
    @2[V_FORME + 136] = 13;
    @2[V_FORME + 137] = 5;
    @2[V_FORME + 138] = 13;
