    @2[V_FORME + 146] = 13;
    @2[V_FORME + 147] = 5;
}

fonction vib_melanger(h, x) {
    retour brasser(h ^ x);
}

fonction vib_saut(op) {
    retour op == 48 || op == 49 || op == 50 || op == 53 || op == 54;
}

// une constante (haut, bas) qui est sans doute une adresse : elle change d'un programme à l'autre
fonction vib_adresse(haut, bas) {
    si haut == 0 && bas <= V_M32 {
        retour 1;
    }
    retour (haut >> 62) != 0 && (haut & 4611686018427387903) == 0 && bas < 281474976710656;
}

fonction vib_lier(a, b) {
    si a != b {
        soit ne = @2[V_ETAT + 4];
        @2[V_EA + ne] = a;
        @2[V_EB + ne] = b;
        @2[V_EA + ne + 1] = b;
        @2[V_EB + ne + 1] = a;
        @2[V_ETAT + 4] = ne + 2;
    }
}

// les débuts des morceaux des mots lus (MH, MB : n mots) : 0, la cible de chaque CALL, chaque prologue
fonction vib_debuts(n) {
    soit n2 = 2 * n;
    soit lit = 0;
    pour p dans 0..n2 {
        @2[V_LIT + p] = lit;
        @2[V_RANG + p] = 0;
        @2[V_PREM + p] = 0;
        si lit == 1 {
            lit = 0;
        } sinon {
            soit op = demi(p) >> 48;
            si op == 10 || op == 43 {
                lit = 1;
            }
        }
    }
    @2[V_RANG] = 1;
    pour p2 dans 0..n2 {
        si @2[V_LIT + p2] == 0 {
            soit h = demi(p2);
            si (h >> 48) == 51 && (h & V_M32) < n2 {
                @2[V_RANG + (h & V_M32)] = 1;
            }
            si p2 + 1 < n2 && h == V_PRO1 && @2[V_LIT + p2 + 1] == 0 && demi(p2 + 1) == V_PRO2 {
                @2[V_RANG + p2] = 1;
            }
        }
    }
    soit k = 0;
    pour p3 dans 0..n2 {
        si @2[V_RANG + p3] == 1 {
            @2[V_DEB + k] = p3;
            k = k + 1;
            @2[V_RANG + p3] = 0;
        }
    }
    @2[V_DEB + k] = n2;
    @2[V_ETAT] = k;
    @2[V_ETAT + 1] = n2;
}

// le morceau [p, q) : rend sa vibration (ses atomes et sa masse dans V_ETAT + 2, + 3) ; passe 2 : un CALL porte la
// première vibration de sa cible
fonction vib_morceau(p, q, passe) {
    soit n2 = @2[V_ETAT + 1];
    soit n = 0;
    pour i dans p..q {
        si @2[V_LIT + i] == 0 {
            @2[V_AT + n] = i;
            n = n + 1;
            @2[V_RANG + i] = n;
        }
    }
    @2[V_ETAT + 4] = 0;
    pour r dans 0..16 {
        @2[V_DER + r] = 0;
    }
    pour j dans 0..n {
        soit i2 = @2[V_AT + j];
        soit h = demi(i2);
        soit op = h >> 48;
        soit d = (h >> 44) & 15;
        soit s = (h >> 40) & 15;
        soit t = (h >> 36) & 15;
        soit imm = h & V_M32;
        soit lit = 0;
        soit cle = imm;
        si vib_saut(op) {
            si imm >= p && imm < q {
                cle = imm - p;
            } sinon {
                cle = V_M32;
            }
        } sinon si op == 51 {
            cle = V_M32;
            si passe == 2 && imm < n2 {
                lit = @2[V_PREM + imm];
            }
        }
        si (op == 10 || op == 43) && i2 + 1 < q {
            soit bas_ = 0;
            soit haut_ = 0;
            si op == 10 {
                bas_ = demi(i2 + 1);
                si i2 + 3 < q && (demi(i2 + 2) >> 48) == 43 && ((demi(i2 + 2) >> 44) & 15) == d {
                    haut_ = demi(i2 + 3);
                }
            } sinon {
                haut_ = demi(i2 + 1);
                si i2 >= p + 2 && (demi(i2 - 2) >> 48) == 10 {
                    bas_ = demi(i2 - 1);
                }
            }
            si vib_adresse(haut_, bas_) == 0 {
                lit = demi(i2 + 1);
            }
        }
        @2[V_CLE + j] = (h & V_HAUTS) | cle;
        @2[V_LV + j] = lit;
        si j + 1 < n && op != 48 && op != 52 && op != 63 {
            vib_lier(j, j + 1);
        }
        si vib_saut(op) && imm >= p && imm < q && @2[V_RANG + imm] != 0 {
            vib_lier(j, @2[V_RANG + imm] - 1);
        }
        soit f = @2[V_FORME + op];
        si (f & 2) != 0 && @2[V_DER + d] != 0 {
            vib_lier(j, @2[V_DER + d] - 1);
        }
        si (f & 4) != 0 && @2[V_DER + s] != 0 {
            vib_lier(j, @2[V_DER + s] - 1);
        }
        si (f & 8) != 0 && @2[V_DER + t] != 0 {
            vib_lier(j, @2[V_DER + t] - 1);
        }
        si (f & 1) != 0 {
            @2[V_DER + d] = j + 1;
        }
        si op == 51 {
            pour r2 dans 0..16 {
                @2[V_DER + r2] = j + 1;
            }
        }
    }
    // les voisins de chaque atome, triés, sans double
    soit ne = @2[V_ETAT + 4];
    pour a dans 0..n + 1 {
        @2[V_OFF + a] = 0;
    }
    pour e dans 0..ne {
        @2[V_OFF + @2[V_EA + e] + 1] = @2[V_OFF + @2[V_EA + e] + 1] + 1;
    }
    pour a2 dans 0..n {
        @2[V_OFF + a2 + 1] = @2[V_OFF + a2 + 1] + @2[V_OFF + a2];
        @2[V_DEG + a2] = 0;
    }
    pour e2 dans 0..ne {
        soit a3 = @2[V_EA + e2];
        @2[V_ADJ + @2[V_OFF + a3] + @2[V_DEG + a3]] = @2[V_EB + e2];
        @2[V_DEG + a3] = @2[V_DEG + a3] + 1;
    }
    soit masse = 0;
    soit liaisons = 0;
    pour a4 dans 0..n {
        soit o = @2[V_OFF + a4];
        soit m = @2[V_DEG + a4];
        pour x dans 1..m {
            soit y = @2[V_ADJ + o + x];
            soit z = x;
            tantque z > 0 && @2[V_ADJ + o + z - 1] > y {
                @2[V_ADJ + o + z] = @2[V_ADJ + o + z - 1];
                z = z - 1;
            }
            @2[V_ADJ + o + z] = y;
        }
        soit u = 0;
        pour x2 dans 0..m {
            si u == 0 || @2[V_ADJ + o + x2] != @2[V_ADJ + o + u - 1] {
                @2[V_ADJ + o + u] = @2[V_ADJ + o + x2];
                u = u + 1;
            }
        }
        @2[V_DEG + a4] = u;
        liaisons = liaisons + u;
        soit ma = 12;
        si u <= 1 {
            ma = 1;
        } sinon si u == 2 {
            ma = 16;
        } sinon si u == 3 {
            ma = 14;
        }
        @2[V_MA + a4] = ma;
        masse = masse + ma;
    }
    liaisons = liaisons / 2;
    // la vibration locale : les chemins fermés de longueur 1 à 6 (ceux de longueur a + b, par les chemins de longueur a
    // et b depuis l'atome, a et b au plus 3)
    pour v dans 0..n {
        @2[V_W + v] = 1;
        @2[V_T] = v;
        @2[V_NT] = 1;
        pour lg dans 1..4 {
            soit wa = V_W + (lg - 1) * V_PAS;
            soit ta = V_T + (lg - 1) * V_PAS;
            soit wb = V_W + lg * V_PAS;
            soit tb = V_T + lg * V_PAS;
            soit nb = 0;
            pour k dans 0..@2[V_NT + lg - 1] {
                soit u2 = @2[ta + k];
                soit c = @2[wa + u2];
                soit o2 = @2[V_OFF + u2];
                pour x3 dans 0..@2[V_DEG + u2] {
                    soit y2 = @2[V_ADJ + o2 + x3];
                    si @2[wb + y2] == 0 {
                        @2[tb + nb] = y2;
                        nb = nb + 1;
                    }
                    @2[wb + y2] = @2[wb + y2] + c;
                }
            }
            @2[V_NT + lg] = nb;
        }
        soit hv = vib_melanger(0, 6);
        pour k2 dans 1..7 {
            soit a5 = k2 / 2;
            soit b5 = k2 - a5;
            soit wa2 = V_W + a5 * V_PAS;
            soit wb2 = V_W + b5 * V_PAS;
            soit ta2 = V_T + a5 * V_PAS;
            soit somme_c = 0;
            pour k3 dans 0..@2[V_NT + a5] {
                soit u3 = @2[ta2 + k3];
                somme_c = somme_c + @2[wa2 + u3] * @2[wb2 + u3];
            }
            hv = vib_melanger(hv, somme_c);
        }
        hv = vib_melanger(hv, @2[V_MA + v]);
        hv = vib_melanger(hv, @2[V_CLE + v]);
        hv = vib_melanger(hv, @2[V_LV + v]);
        @2[V_LAB + v] = hv;
        pour lg2 dans 0..4 {
            soit w0 = V_W + lg2 * V_PAS;
            soit t0 = V_T + lg2 * V_PAS;
            pour k4 dans 0..@2[V_NT + lg2] {
                @2[w0 + @2[t0 + k4]] = 0;
            }
        }
    }
    // trois tours : chaque atome prend la vibration de ses voisins, triées
    pour tour dans 0..3 {
        pour v2 dans 0..n {
            soit o3 = @2[V_OFF + v2];
            soit m3 = @2[V_DEG + v2];
            pour x4 dans 0..m3 {
                soit y3 = @2[V_LAB + @2[V_ADJ + o3 + x4]];
                soit z2 = x4;
                tantque z2 > 0 && @2[V_TRI + z2 - 1] > y3 {
                    @2[V_TRI + z2] = @2[V_TRI + z2 - 1];
                    z2 = z2 - 1;
                }
                @2[V_TRI + z2] = y3;
            }
            soit h2 = vib_melanger(0, @2[V_LAB + v2]);
            pour x5 dans 0..m3 {
                h2 = vib_melanger(h2, @2[V_TRI + x5]);
            }
            @2[V_LAB2 + v2] = h2;
        }
        pour v3 dans 0..n {
            @2[V_LAB + v3] = @2[V_LAB2 + v3];
        }
    }
    soit somme = 0;
    soit oux = 0;
    pour v4 dans 0..n {
        somme = somme + @2[V_LAB + v4];
        oux = oux ^ @2[V_LAB + v4];
    }
    pour i3 dans p..q {
        @2[V_RANG + i3] = 0;
    }
    @2[V_ETAT + 2] = n;
    @2[V_ETAT + 3] = masse;
    soit hm = vib_melanger(0, n);
    hm = vib_melanger(hm, liaisons);
    hm = vib_melanger(hm, masse);
    hm = vib_melanger(hm, somme);
    retour vib_melanger(hm, oux);
}

// tous les morceaux des n mots lus : leurs vibrations (deux passes) dans V_VIB, V_NAT, V_MAS
fonction vib_morceaux(n) {
    vib_debuts(n);
    soit k = @2[V_ETAT];
    pour i dans 0..k {
        @2[V_PREM + @2[V_DEB + i]] = vib_morceau(@2[V_DEB + i], @2[V_DEB + i + 1], 1);
    }
    pour i2 dans 0..k {
        @2[V_VIB + i2] = vib_morceau(@2[V_DEB + i2], @2[V_DEB + i2 + 1], 2);
        @2[V_NAT + i2] = @2[V_ETAT + 2];
        @2[V_MAS + i2] = @2[V_ETAT + 3];
    }
}

// le chiffre hexadécimal en minuscule (comme lugus empreinte)
fonction vib_hexa(c, x) {
    pour i dans 0..16 {
        soit d = (x >> (60 - 4 * i)) & 15;
        si d < 10 {
            ecrire_car(c, 48 + d);
        } sinon {
            ecrire_car(c, 87 + d);
        }
    }
}

// « lugus morceaux PROG » : les morceaux et leur vibration (comme « python3 chimie/adn.py morceaux »), pour comparer
fonction montrer_morceaux(chemin) {
    lire_fichier_mots(chemin);
    si @2[G + G_ERR] != 0 {
        retour;
    }
    vib_morceaux(@2[G + G_N]);
    pour i dans 0..@2[V_ETAT] {
        ecrire_u64(1, @2[V_DEB + i]);
        ecrire_car(1, ' ');
        ecrire_u64(1, @2[V_DEB + i + 1]);
        ecrire_car(1, ' ');
        ecrire_u64(1, @2[V_NAT + i]);
        ecrire_car(1, ' ');
        ecrire_u64(1, @2[V_MAS + i]);
        ecrire_car(1, ' ');
        vib_hexa(1, @2[V_VIB + i]);
        ecrire_car(1, 10);
    }
}

// --------------------------------------------------------------------------------------------- le catalogue (0.62)
// « lugus cataloguer DOSSIER » : DOSSIER/catalogue.vtxcat, comme cataloguer() de chimie/adn.py, octet pour octet. Pour
// chaque module du dossier (un .vtx sans « principal », dans l'ordre de la liste du dossier, le service 28) : son nom,
// son empreinte (FNV-1a de ses caractères, les retours chariot sautés : celle de « importer … empreinte »), et ses
// molécules : chacune compilée par vtxc128 (le service 27) dans une sonde qui prend en valeur les fonctions que le
// module n'appelle pas lui-même, puis sa masse, ses atomes et sa vibration. Un module qui ne se compile pas seul : « - ».
constante C_VIDE = 179999990;    // un texte vide (le dossier lui-même)
constante C_NOMS = 180000000;    // la liste du dossier : les caractères, le début et la longueur de chaque nom
constante C_ND = 181000000;
constante C_NL = 181100000;
constante C_MOD = 182000000;     // le module lu (sans les retours chariot), le début de chaque ligne
constante C_LD = 186000000;
constante C_FD = 187000000;      // ses fonctions : le début du nom (dans C_MOD), sa longueur, 1 si le module l'appelle
constante C_FL = 187100000;
constante C_FI = 187200000;
constante C_FM = 187300000;      // ce que le catalogue en dit : le morceau (plus un ; 0 : aucun)
constante C_TX = 189000000;      // un nom de fichier, en texte (une longueur, puis ses caractères)
constante C_ETAT = 189100000;    // 0 : les noms ; 1 : les caractères du module ; 2 : ses lignes ; 3 : ses fonctions

fonction cat_texte(debut, n) {
    // le nom C_NOMS[debut..debut + n] en texte, dans C_TX
    @2[C_TX] = n;
    pour i dans 0..n {
        @2[C_TX + 1 + i] = @2[C_NOMS + debut + i];
    }
    retour ETAGE2 + C_TX;
}

fonction cat_ligne_commence(l, t) {
    // la ligne l du module commence-t-elle par le texte t ?
    soit d = @2[C_LD + l];
    soit f = @2[C_LD + l + 1] - 1;
    si f - d < longueur(t) {
        retour 0;
    }
    pour i dans 0..longueur(t) {
        si @2[C_MOD + d + i] != car(t, i) {
            retour 0;
        }
    }
    retour 1;
}

// la ligne l commence-t-elle par « fonction NOM( », NOM la fonction k ?
fonction cat_entete_de(l, k) {
    si cat_ligne_commence(l, "fonction ") == 0 {
        retour 0;
    }
    soit d = @2[C_LD + l] + 9;
    soit f = @2[C_LD + l + 1] - 1;
    soit n = @2[C_FL + k];
    si f - d < n + 1 {
        retour 0;
    }
    pour i dans 0..n {
        si @2[C_MOD + d + i] != @2[C_MOD + @2[C_FD + k] + i] {
            retour 0;
        }
    }
    retour @2[C_MOD + d + n] == '(';
}

// le nom de la fonction k est-il celui de la ligne « nom|place » i des noms donnés par le compilateur (en minuscules) ?
fonction cat_meme_nom(k, i) {
    soit n = @2[C_FL + k];
    si @2[NLEN + i] != n {
        retour 0;
    }
    pour j dans 0..n {
        si @2[NCAR + @2[NDEB + i] + j] != bas_car(@2[C_MOD + @2[C_FD + k] + j]) {
            retour 0;
        }
    }
    retour 1;
}

fonction cat_ecrire_nom(c, k) {
    pour i dans 0..@2[C_FL + k] {
        ecrire_car(c, @2[C_MOD + @2[C_FD + k] + i]);
    }
}

// la sonde, dans TEXTE : un texte (ou un nombre) ajouté à la place lg ; rend la nouvelle longueur
fonction cat_mettre(lg, t) {
    pour i dans 0..longueur(t) {
        @2[TEXTE + 1 + lg + i] = car(t, i);
    }
    retour lg + longueur(t);
}

fonction cat_mettre_nombre(lg, x) {
    soit p = 1;
    tantque p * 10 <= x {
        p = p * 10;
    }
    soit l = lg;
    soit y = x;
    tantque p > 0 {
        @2[TEXTE + 1 + l] = 48 + y / p;
        y = y % p;
        p = p / 10;
        l = l + 1;
    }
    retour l;
}

// le module (le nom i de la liste) : lu, son empreinte, ses fonctions, sa sonde compilée, ses molécules ; écrit dans c
fonction cat_module(i) {
    soit nd = @2[C_ND + i];
    soit nl = @2[C_NL + i];
    soit f = ouvrir_lecture(cat_texte(nd, nl));
    si f == 18446744073709551615 {
        retour;
    }
    soit n = 0;
    soit h = 14695981039346656037;
    tantque fin_de(f) == 0 {
        soit x = lire_car(f);
        si x != 13 {
            @2[C_MOD + n] = x;
            n = n + 1;
            h = (h ^ x) * 1099511628211;
        }
    }
    fermer(f);
    // les lignes
    soit nlg = 0;
    @2[C_LD] = 0;
    pour j dans 0..n {
        si @2[C_MOD + j] == 10 {
            nlg = nlg + 1;
            @2[C_LD + nlg] = j + 1;
        }
    }
    nlg = nlg + 1;
    @2[C_LD + nlg] = n + 1;
    pour l dans 0..nlg {
        si cat_ligne_commence(l, "fonction principal(") {
            retour;
        }
    }
    // les fonctions écrites en tête de ligne, dans l'ordre, chacune une fois
    soit nf = 0;
    pour l2 dans 0..nlg {
        si cat_ligne_commence(l2, "fonction ") {
            soit d = @2[C_LD + l2] + 9;
            soit fin = @2[C_LD + l2 + 1] - 1;
            soit p = d;
            tantque p < fin && @2[C_MOD + p] != '(' {
                p = p + 1;
            }
            si p < fin {
                soit a = d;
                soit b = p;
                tantque a < b && (@2[C_MOD + a] == ' ' || @2[C_MOD + a] == 9) {
                    a = a + 1;
                }
                tantque b > a && (@2[C_MOD + b - 1] == ' ' || @2[C_MOD + b - 1] == 9) {
                    b = b - 1;
                }
                soit double = 0;
                pour k dans 0..nf {
                    si @2[C_FL + k] == b - a {
                        soit meme = 1;
                        pour q dans 0..b - a {
                            si @2[C_MOD + @2[C_FD + k] + q] != @2[C_MOD + a + q] {
                                meme = 0;
                            }
                        }
                        si meme == 1 {
                            double = 1;
                        }
                    }
                }
                si b > a && double == 0 {
                    @2[C_FD + nf] = a;
                    @2[C_FL + nf] = b - a;
                    nf = nf + 1;
                }
            }
        }
    }
    // celles que le module appelle lui-même (« nom( » ailleurs que dans son en-tête, hors d'une ligne de commentaire)
    pour k2 dans 0..nf {
        @2[C_FI + k2] = 0;
        soit fd = @2[C_FD + k2];
        soit fl = @2[C_FL + k2];
        pour l3 dans 0..nlg {
            soit d3 = @2[C_LD + l3];
            soit f3 = @2[C_LD + l3 + 1] - 1;
            soit s3 = d3;
            tantque s3 < f3 && (@2[C_MOD + s3] == ' ' || @2[C_MOD + s3] == 9) {
                s3 = s3 + 1;
            }
            soit commentaire = s3 + 1 < f3 && @2[C_MOD + s3] == '/' && @2[C_MOD + s3 + 1] == '/';
            si @2[C_FI + k2] == 0 && cat_entete_de(l3, k2) == 0 && commentaire == 0 {
                pour j3 dans d3..f3 {
                    si @2[C_FI + k2] == 0 && j3 + fl < f3 && @2[C_MOD + j3 + fl] == '(' {
                        soit meme3 = 1;
                        pour q3 dans 0..fl {
                            si @2[C_MOD + j3 + q3] != @2[C_MOD + fd + q3] {
                                meme3 = 0;
                            }
                        }
                        si meme3 == 1 && (j3 == d3 || lettre_nom(@2[C_MOD + j3 - 1]) == 0) {
                            @2[C_FI + k2] = 1;
                        }
                    }
                }
            }
        }
    }
    // la sonde : importer le module, prendre en valeur les fonctions qu'il n'appelle pas lui-même
    soit lg = 0;
    soit tete = "importer \"";
    pour q4 dans 0..longueur(tete) {
        @2[TEXTE + 1 + lg] = car(tete, q4);
        lg = lg + 1;
    }
    pour q5 dans 0..nl {
        @2[TEXTE + 1 + lg] = @2[C_NOMS + nd + q5];
        lg = lg + 1;
    }
    soit milieu = "\";\nfonction principal() {\n";
    pour q6 dans 0..longueur(milieu) {
        @2[TEXTE + 1 + lg] = car(milieu, q6);
        lg = lg + 1;
    }
    // « soit __vK = f; sortie(__vK); » (comme sonde() de chimie/adn.py)
    soit kv = 0;
    pour k3 dans 0..nf {
        si @2[C_FI + k3] == 0 {
            lg = cat_mettre(lg, "    soit __v");
            lg = cat_mettre_nombre(lg, kv);
            lg = cat_mettre(lg, " = ");
            pour q8 dans 0..@2[C_FL + k3] {
                @2[TEXTE + 1 + lg] = @2[C_MOD + @2[C_FD + k3] + q8];
                lg = lg + 1;
            }
            lg = cat_mettre(lg, ";\n    sortie(__v");
            lg = cat_mettre_nombre(lg, kv);
            lg = cat_mettre(lg, ");\n");
            kv = kv + 1;
        }
    }
    @2[TEXTE + 1 + lg] = '}';
    @2[TEXTE + 2 + lg] = 10;
    @2[TEXTE] = lg + 2;
    soit g = __service(27, ETAGE2 + TEXTE);
    si g == 18446744073709551615 {
        refuser("cette machine n'a pas de compilateur pour le lecteur");
        retour;
    }
    @2[G + G_CANAL] = g;
    @2[G + G_COPIE] = 0;
    avancer();
    si car_courant() == '!' {
        fermer(g);
        cat_placer(nd, nl, h, 1, 0);
        retour;
    }
    soit nm = 0;
    tantque car_courant() != ';' && car_courant() != FIN {
        soit bb = lire_nombre();
        @2[MH + nm] = @2[G + G_HAUT];
        @2[MB + nm] = bb;
        nm = nm + 1;
        si car_courant() == ',' {
            avancer();
        }
    }
    si car_courant() == ';' {
        avancer();
    }
    si car_courant() == 10 {
        avancer();
    }
    @2[G + G_NN] = 0;
    @2[NDEB] = 0;
    @2[NLEN] = 0;
    soit place = 0;
    soit barre = 0;
    tantque car_courant() != FIN {
        soit cc = car_courant();
        si cc == 10 {
            noms_finir(place, barre);
            place = 0;
            barre = 0;
        } sinon si cc != 13 {
            si barre == 1 {
                place = place * 10 + (cc - 48);
            } sinon si cc == '|' {
                barre = 1;
            } sinon {
                noms_ajouter(cc);
            }
        }
        avancer();
    }
    noms_finir(place, barre);
    fermer(g);
    @2[G + G_N] = nm;
    vib_morceaux(nm);
    soit trouvees = 0;
    pour k4 dans 0..nf {
        @2[C_FM + k4] = 0;
        soit w = 18446744073709551615;
        pour i4 dans 0..@2[G + G_NN] {
            si w == 18446744073709551615 && cat_meme_nom(k4, i4) {
                w = @2[NPL + i4];
            }
        }
        si w != 18446744073709551615 {
            pour m dans 0..@2[V_ETAT] {
                soit p4 = @2[V_DEB + m];
                si @2[C_FM + k4] == 0 && p4 / 2 == w && p4 + 1 < 2 * nm && demi(p4) == V_PRO1 && demi(p4 + 1) == V_PRO2 {
                    @2[C_FM + k4] = m + 1;
                }
            }
        }
        si @2[C_FM + k4] != 0 {
            trouvees = trouvees + 1;
        }
    }
    cat_placer(nd, nl, h, 0, nf);
}

// --------------------------------------------------------------------------------------------- le cube du catalogue (0.62c)
// Le catalogue est d'abord un cube (l'ADN : ce qui dure), cube128-1-392.cub, rangé avec son anti-cube et son ombre ; son
// hex, catalogue.vtxcat, est écrit en lisant ce cube. Les places, comme placer_catalogue() de chimie/adn.py, au bit près
// (docs/vtx-reactions.md, section 67) : les modules dans la moitié basse (la colonne #RRGG vient de l'empreinte, la
// chaîne descend la colonne à la Fischer : la tête, le nom, chaque molécule et son nom) ; l'index des vibrations dans la
// moitié haute (la place vient de la vibration, le point dit où est la molécule) ; la coiffe en #FFFFFE, la queue en
// #FFFFFF.
constante CP_FR = 392;
constante CP_ETAT = 189200000;   // 0 : les points posés ; 1 : leur somme ; 2 : leur ou exclusif ; 3 : modules ; 4 : molécules
constante CP_TMP = 189300000;    // un nom, à poser
constante CP_ZONE = 8388608;     // #800000 : l'index des vibrations
constante CP_TAILLE = 8323072;   // #800000 à #FEFFFF
constante CP_QUEUE = 6220694031187574785;   // « VTXCAT », version 1

fonction cp_place(c, t) {
    retour (((c + t / 256) & 32767) << 8) | (t & 255);
}

fonction cp_vide(p) {
    soit w: entier_128 = @[cube_adresse(1, CP_FR, p)];
    retour haut(w) == 0 && bas(w) == 0;
}

fonction cp_haut(p) {
    soit w: entier_128 = @[cube_adresse(1, CP_FR, p)];
    retour haut(w);
}

fonction cp_bas(p) {
    soit w: entier_128 = @[cube_adresse(1, CP_FR, p)];
    retour bas(w);
}

fonction cp_poser(p, hi, lo) {
    @[cube_adresse(1, CP_FR, p)] = entier_128_de(hi, lo);
    soit g = brasser(brasser(brasser(p) ^ hi) ^ lo);
    @2[CP_ETAT] = @2[CP_ETAT] + 1;
    @2[CP_ETAT + 1] = @2[CP_ETAT + 1] + g;
    @2[CP_ETAT + 2] = @2[CP_ETAT + 2] ^ g;
}

// le nom CP_TMP[0..ln], quatre caractères par point (un par voie), à partir du rang t de la chaîne c ; rend le rang suivant
fonction cp_poser_nom(c, t, ln) {
    soit np = (ln + 3) / 4;
    pour i dans 0..np {
        soit q0 = 0;
        soit q1 = 0;
        soit q2 = 0;
        soit q3 = 0;
        si 4 * i < ln { q0 = @2[CP_TMP + 4 * i]; }
        si 4 * i + 1 < ln { q1 = @2[CP_TMP + 4 * i + 1]; }
        si 4 * i + 2 < ln { q2 = @2[CP_TMP + 4 * i + 2]; }
        si 4 * i + 3 < ln { q3 = @2[CP_TMP + 4 * i + 3]; }
        cp_poser(cp_place(c, t + i), (q0 << 32) | q1, (q2 << 32) | q3);
    }
    retour t + np;
}

fonction cp_court(n) {
    si n > 255 {
        retour 255;
    }
    retour n;
}

// le module (son nom dans C_NOMS[nd..nd + nl], son empreinte h) et ses molécules (C_FM, C_FD, C_FL ; V_MAS, V_NAT, V_VIB)
// posés dans le cube ; sans : il ne se compile pas seul
fonction cat_placer(nd, nl, h, sans, nf) {
    soit lnom = cp_court(nl);
    soit lg = 1 + (lnom + 3) / 4;
    soit nmol = 0;
    si sans == 0 {
        pour k dans 0..nf {
            si @2[C_FM + k] != 0 {
                lg = lg + 1 + (cp_court(@2[C_FL + k]) + 3) / 4;
                nmol = nmol + 1;
            }
        }
    }
    soit kc = (lg + 255) / 256;
    soit c = brasser(h) & 255;
    soit libre = 0;
    tantque libre == 0 {
        libre = 1;
        pour j dans 0..kc {
            si cp_vide(((c + j) & 32767) << 8) == 0 {
                libre = 0;
            }
        }
        si libre == 0 {
            c = (c + 1) & 32767;
        }
    }
    soit n = nmol;
    si sans == 1 {
        n = 16777215;
    }
    cp_poser(cp_place(c, 0), h, (77 << 56) | (n << 32) | (lnom << 16) | kc);
    pour i dans 0..lnom {
        @2[CP_TMP + i] = @2[C_NOMS + nd + i];
    }
    soit t = cp_poser_nom(c, 1, lnom);
    si sans == 0 {
        pour k2 dans 0..nf {
            soit m2 = @2[C_FM + k2];
            si m2 != 0 {
                soit lf = cp_court(@2[C_FL + k2]);
                soit v = @2[V_VIB + m2 - 1];
                soit tm = t;
                cp_poser(cp_place(c, t), v, ((@2[V_MAS + m2 - 1] & 16777215) << 32) | ((@2[V_NAT + m2 - 1] & 16777215) << 8) | lf);
                pour i2 dans 0..lf {
                    @2[CP_TMP + i2] = @2[C_MOD + @2[C_FD + k2] + i2];
                }
                t = cp_poser_nom(c, t + 1, lf);
                soit sv = brasser(v) & 65535;
                tantque cp_vide(CP_ZONE + sv) == 0 {
                    sv = (sv + 1) % CP_TAILLE;
                }
                cp_poser(CP_ZONE + sv, v, (c << 32) | tm);
                @2[CP_ETAT + 4] = @2[CP_ETAT + 4] + 1;
            }
        }
    }
    @2[CP_ETAT + 3] = @2[CP_ETAT + 3] + 1;
}

// n caractères de la chaîne c, à partir du rang t, écrits dans le canal f
fonction cp_ecrire_nom(f, c, t, n) {
    pour i dans 0..n {
        soit p = cp_place(c, t + i / 4);
        soit x = 0;
        soit v = 3 - i % 4;
        si v == 3 { x = cp_haut(p) >> 32; }
        si v == 2 { x = cp_haut(p) & 4294967295; }
        si v == 1 { x = cp_bas(p) >> 32; }
        si v == 0 { x = cp_bas(p) & 4294967295; }
        ecrire_car(f, x);
    }
}

// la lecture hex du cube : catalogue.vtxcat
fonction cp_ecrire_hex(f) {
    ecrire_t(f, "VTXCAT02\n// le catalogue des modules de ce dossier, lu dans son cube (cube128-1-392.cub, avec son anti-cube et son ombre ; lugus cataloguer) : cube|étage|fréquence|coiffe|modules|molécules, puis module|nom|empreinte|molécules|place et molecule|nom|masse|atomes|vibration|place\n");
    ecrire_t(f, "cube|1|392|");
    vib_hexa(f, cp_bas(16777214));
    ecrire_car(f, '|');
    ecrire_u64(f, cp_bas(16777215) >> 32);
    ecrire_car(f, '|');
    ecrire_u64(f, cp_bas(16777215) & 4294967295);
    ecrire_car(f, 10);
    pour c dans 0..32768 {
        soit lo = cp_bas(c << 8);
        si ((lo >> 56) & 255) == 77 {
            soit n = (lo >> 32) & 16777215;
            soit ln = (lo >> 16) & 255;
            ecrire_t(f, "module|");
            cp_ecrire_nom(f, c, 1, ln);
            ecrire_car(f, '|');
            vib_hexa(f, cp_haut(c << 8));
            ecrire_car(f, '|');
            si n == 16777215 {
                ecrire_car(f, '-');
            } sinon {
                ecrire_u64(f, n);
            }
            ecrire_t(f, "|#");
            ecrire_hex(f, c << 8, 6);
            ecrire_car(f, 10);
            soit t = 1 + (ln + 3) / 4;
            si n != 16777215 {
                pour j dans 0..n {
                    soit p = cp_place(c, t);
                    soit lo2 = cp_bas(p);
                    soit lf = lo2 & 255;
                    ecrire_t(f, "molecule|");
                    cp_ecrire_nom(f, c, t + 1, lf);
                    ecrire_car(f, '|');
                    ecrire_u64(f, (lo2 >> 32) & 16777215);
                    ecrire_car(f, '|');
                    ecrire_u64(f, (lo2 >> 8) & 16777215);
                    ecrire_car(f, '|');
                    vib_hexa(f, cp_haut(p));
                    ecrire_t(f, "|#");
                    ecrire_hex(f, p, 6);
                    ecrire_car(f, 10);
                    t = t + 1 + (lf + 3) / 4;
                }
            }
        }
    }
}

fonction cataloguer() {
    vib_preparer();
    @2[C_VIDE] = 0;
    soit l = __service(28, ETAGE2 + C_VIDE);
    si l == 18446744073709551615 || l == 18446744073709551614 {
        refuser("le dossier ne se lit pas");
        retour;
    }
    soit n = 0;
    soit k = 0;
    @2[C_ND] = 0;
    tantque fin_de(l) == 0 {
        soit x = lire_car(l);
        si x == 10 {
            @2[C_NL + k] = n - @2[C_ND + k];
            k = k + 1;
            @2[C_ND + k] = n;
        } sinon {
            @2[C_NOMS + n] = x;
            n = n + 1;
        }
    }
    fermer(l);
    // le cube d'abord : vidé (sans relire le disque), puis chaque module et chaque molécule à sa place
    jeter_cube(1, CP_FR);
    pour e dans 0..5 {
        @2[CP_ETAT + e] = 0;
    }
    soit modules = 0;
    pour i2 dans 0..k {
        soit d = @2[C_ND + i2];
        soit lg = @2[C_NL + i2];
        si lg >= 4 && @2[C_NOMS + d + lg - 4] == '.' && @2[C_NOMS + d + lg - 3] == 'v' && @2[C_NOMS + d + lg - 2] == 't'
                && @2[C_NOMS + d + lg - 1] == 'x' && @2[G + G_ERR] == 0 {
            cat_module(i2);
            modules = modules + 1;
        }
    }
    si @2[G + G_ERR] != 0 {
        retour;
    }
    // la coiffe (ce que portent tous les points) et la queue, puis le cube rangé avec son anti-cube et son ombre
    soit npts = @2[CP_ETAT];
    soit coiffe = brasser(brasser(brasser(npts) ^ @2[CP_ETAT + 1]) ^ @2[CP_ETAT + 2]);
    @[cube_adresse(1, CP_FR, 16777214)] = entier_128_de(0, coiffe);
    @[cube_adresse(1, CP_FR, 16777215)] = entier_128_de(CP_QUEUE, (@2[CP_ETAT + 3] << 32) | @2[CP_ETAT + 4]);
    soit pages = ranger_cube(1, CP_FR);
    si pages == 18446744073709551615 {
        refuser("le cube du catalogue ne s'écrit pas");
        retour;
    }
    // le hex, lu dans le cube
    soit fin = "catalogue.vtxcat";
    @2[C_TX] = longueur(fin);
    pour i dans 0..longueur(fin) {
        @2[C_TX + 1 + i] = car(fin, i);
    }
    soit c = ouvrir_ecriture(ETAGE2 + C_TX);
    cp_ecrire_hex(c);
    fermer(c);
    ecrire_t(1, "le catalogue : ");
    ecrire_u64(1, @2[CP_ETAT + 3]);
    ecrire_t(1, " module(s), ");
    ecrire_u64(1, @2[CP_ETAT + 4]);
    ecrire_t(1, " molécule(s) -> cube128-1-392.cub (");
    ecrire_u64(1, pages);
    ecrire_t(1, " page(s), avec son anti-cube et son ombre), lu en hex dans catalogue.vtxcat\n");
}

// --------------------------------------------------------------------------------------------- d'où vient une molécule (0.62)
// La carte lit les cubes des catalogues (0.62c ; ceux des dossiers que « importer empreinte » lit : le dossier du
// programme, bibliotheque/, ../bibliotheque/ ; chacun choisi par son chemin, service 29) ; une molécule dont la vibration est celle d'une molécule d'un module catalogué vient de ce module ;
// une molécule qui porte le nom d'une molécule d'un module, mais pas sa vibration, a été retouchée (ou compilée
// autrement) : elle se voit.
constante K_ETAT = 190000000;    // 0 : les modules ; 1 : les molécules ; 2 : les caractères ; 3 : 1, des catalogues lus
constante K_CAR = 190100000;     // les noms (des modules et des molécules)
constante K_MD = 191000000;      // les modules : le nom (début, longueur), l'empreinte
constante K_ML = 191100000;
constante K_ME = 191200000;
constante K_VIB = 192000000;     // les molécules : la vibration, le module, le nom (début, longueur)
constante K_VM = 192100000;
constante K_FD = 192200000;
constante K_FL = 192300000;
constante K_FRS = 193000000;     // les cubes de catalogue lus : leur fréquence (le nombre dans K_ETAT + 5)
constante K_PL = 193100000;      // chaque molécule : sa place dans son cube, la fréquence de ce cube
constante K_FQ = 193200000;

fonction cq_haut(fr, p) {
    soit w: entier_128 = @[cube_adresse(1, fr, p)];
    retour haut(w);
}

fonction cq_bas(fr, p) {
    soit w: entier_128 = @[cube_adresse(1, fr, p)];
    retour bas(w);
}

// n caractères de la chaîne c du cube fr, à partir du rang t, recopiés dans K_CAR : rend leur début
fonction cq_garder(fr, c, t, n) {
    soit d = @2[K_ETAT + 2];
    pour i dans 0..n {
        soit p = cp_place(c, t + i / 4);
        soit v = 3 - i % 4;
        soit x = 0;
        si v == 3 { x = cq_haut(fr, p) >> 32; }
        si v == 2 { x = cq_haut(fr, p) & 4294967295; }
        si v == 1 { x = cq_bas(fr, p) >> 32; }
        si v == 0 { x = cq_bas(fr, p) & 4294967295; }
        @2[K_CAR + d + i] = x;
    }
    @2[K_ETAT + 2] = d + n;
    retour d;
}

// 0.62c : le cube du catalogue de fréquence fr (accordé par la machine : ses pages viennent du disque, réparées s'il le
// faut par son anti-cube et son ombre) ; ses modules et ses molécules, lus le long de leurs colonnes
fonction lire_catalogue_cube(fr) {
    si cq_haut(fr, 16777215) != CP_QUEUE {
        retour;
    }
    @2[K_ETAT + 3] = 1;
    @2[K_FRS + @2[K_ETAT + 5]] = fr;
    @2[K_ETAT + 5] = @2[K_ETAT + 5] + 1;
    pour c dans 0..32768 {
        soit lo = cq_bas(fr, c << 8);
        si ((lo >> 56) & 255) == 77 && @2[K_ETAT] < 99999 {
            soit m = @2[K_ETAT];
            soit n = (lo >> 32) & 16777215;
            soit ln = (lo >> 16) & 255;
            @2[K_ME + m] = cq_haut(fr, c << 8);
            @2[K_ML + m] = ln;
            @2[K_MD + m] = cq_garder(fr, c, 1, ln);
            @2[K_ETAT] = m + 1;
            soit t = 1 + (ln + 3) / 4;
            si n != 16777215 {
                pour j dans 0..n {
                    soit p = cp_place(c, t);
                    soit lf = cq_bas(fr, p) & 255;
                    soit q = @2[K_ETAT + 1];
                    si q < 99999 {
                        @2[K_VIB + q] = cq_haut(fr, p);
                        @2[K_VM + q] = m;
                        @2[K_FL + q] = lf;
                        @2[K_FD + q] = cq_garder(fr, c, t + 1, lf);
                        @2[K_PL + q] = p;
                        @2[K_FQ + q] = fr;
                        @2[K_ETAT + 1] = q + 1;
                    }
                    t = t + 1 + (lf + 3) / 4;
                }
            }
        }
    }
}

fonction choisir_catalogue(chemin) {
    soit g = __service(29, chemin);
    si g <= 16777215 {
        lire_catalogue_cube(g);
    }
}

// la molécule du catalogue qui a cette vibration (plus un ; 0 : aucune) : cherchée par l'index des vibrations de chaque
// cube (la place vient de la vibration), puis retrouvée à sa place dans la colonne de son module
fonction k_trouver(v) {
    pour i dans 0..@2[K_ETAT + 5] {
        soit fr = @2[K_FRS + i];
        soit s = brasser(v) & 65535;
        tantque cq_haut(fr, CP_ZONE + s) != 0 || cq_bas(fr, CP_ZONE + s) != 0 {
            si cq_haut(fr, CP_ZONE + s) == v {
                soit lo = cq_bas(fr, CP_ZONE + s);
                soit p = cp_place(lo >> 32, lo & 4294967295);
                pour j dans 0..@2[K_ETAT + 1] {
                    si @2[K_PL + j] == p && @2[K_FQ + j] == fr {
                        retour j + 1;
                    }
                }
            }
            s = (s + 1) % CP_TAILLE;
        }
    }
    retour 0;
}

// la molécule du catalogue qui porte le nom de la molécule k de la carte (en minuscules ; plus un ; 0 : aucune)
fonction k_meme_nom(k) {
    si champ_vide(k, 1) {
        retour 0;
    }
    soit d = @2[FOFF + 32 * k + 1];
    soit l = champ_fin(k, 1) - d;
    pour j dans 0..@2[K_ETAT + 1] {
        si @2[K_FL + j] == l {
            soit ok = 1;
            pour i dans 0..l {
                si bas_car(@2[K_CAR + @2[K_FD + j] + i]) != bas_car(@2[CARTEB + d + i]) {
                    ok = 0;
                }
            }
            si ok == 1 {
                retour j + 1;
            }
        }
    }
    retour 0;
}

fonction k_ecrire_module(j) {
    soit m = @2[K_VM + j];
    pour i dans 0..@2[K_ML + m] {
        ecrire_car(1, @2[K_CAR + @2[K_MD + m] + i]);
    }
    ecrire_t(1, " (empreinte ");
    vib_hexa(1, @2[K_ME + m]);
    ecrire_car(1, ')');
}

fonction k_ecrire_nom(j) {
    pour i dans 0..@2[K_FL + j] {
        ecrire_car(1, @2[K_CAR + @2[K_FD + j] + i]);
    }
}

// le premier morceau de la molécule k de la carte (plus un ; 0 : aucun), puis le suivant après lui
fonction k_premier_morceau(k) {
    soit a = 2 * @2[DEBK + k];
    pour m dans 0..@2[V_ETAT] {
        si @2[V_DEB + m] >= a {
            si @2[V_DEB + m] < a + 2 * champ_n(k, 4) {
                retour m + 1;
            }
            retour 0;
        }
    }
    retour 0;
}

// la molécule k vient-elle d'un module catalogué ? (1 : oui)
fonction k_vient(k) {
    soit m = k_premier_morceau(k);
    retour m != 0 && k_trouver(@2[V_VIB + m - 1]) != 0;
}

// la molécule k porte-t-elle le nom d'une molécule d'un module catalogué, mais pas sa vibration ? (1 : oui)
fonction k_retouchee(k) {
    soit m = k_premier_morceau(k);
    retour m != 0 && k_trouver(@2[V_VIB + m - 1]) == 0 && k_meme_nom(k) != 0;
}

// la suite de la face « sa mémoire » : sa vibration, et d'où elle vient
fonction montrer_origine(k) {
    soit m = k_premier_morceau(k);
    si m == 0 {
        retour;
    }
    ecrire_t(1, " ; sa vibration ");
    vib_hexa(1, @2[V_VIB + m - 1]);
    si @2[K_ETAT + 3] == 0 {
        retour;
    }
    soit j = k_trouver(@2[V_VIB + m - 1]);
    si j != 0 {
        ecrire_t(1, " ; elle vient du module ");
        k_ecrire_module(j - 1);
        soit jn = k_meme_nom(k);
        si jn != j {
            ecrire_t(1, ", sa molécule ");
            k_ecrire_nom(j - 1);
        }
    } sinon {
        soit j2 = k_meme_nom(k);
        si j2 != 0 {
            ecrire_t(1, " ; son nom est celui d'une molécule du module ");
            k_ecrire_module(j2 - 1);
            ecrire_t(1, ", mais pas sa vibration : retouchée, ou compilée autrement");
        }
    }
    // les autres morceaux qu'elle porte (des fonctions sans molécule à elles, posées à la suite)
    soit fin = 2 * (@2[DEBK + k] + champ_n(k, 4));
    soit q = m;
    tantque q < @2[V_ETAT] && @2[V_DEB + q] < fin {
        soit j3 = k_trouver(@2[V_VIB + q]);
        si j3 != 0 {
            ecrire_t(1, " ; elle porte aussi ");
            k_ecrire_nom(j3 - 1);
            ecrire_t(1, " du module ");
            k_ecrire_module(j3 - 1);
        }
        q = q + 1;
    }
}

fonction principal() {
    preparer();
    soit entree = lire_chemin(CHEMIN);
    soit relu = lire_chemin(CHEMIN2);
    soit verbe = lire_chemin(CHEMIN3);
    si verbe != 0 && texte_egal(verbe, "ranger") {
        soit source = lire_chemin(CHEMIN4);
        soit iso = lire_chemin(CHEMIN5);
        soit comp = lire_chemin(CHEMIN6);
        soit noms = lire_chemin(CHEMIN7);
        soit ancien = lire_chemin(CHEMIN8);
        ranger(entree, relu, source, iso, comp, noms, ancien);
        si @2[G + G_ERR] != 0 {
            sortie(E_INCONNU);
            retour;
        }
        sortie(E_VRAI);
        retour;
    }
    si verbe != 0 && texte_egal(verbe, "cataloguer") {
        cataloguer();
        si @2[G + G_ERR] != 0 {
            sortie(E_INCONNU);
            retour;
        }
        sortie(E_VRAI);
        retour;
    }
    si verbe != 0 && texte_egal(verbe, "morceaux") {
        vib_preparer();
        montrer_morceaux(entree);
        sortie(E_VRAI);
        retour;
    }
    si verbe != 0 && texte_egal(verbe, "promesses") {
        soit src = lire_chemin(CHEMIN4);
        sortie(juger_promesses(entree, relu, src));
        retour;
    }
    si verbe != 0 && texte_egal(verbe, "carte") {
        soit tout = 0;
        si relu != 0 && texte_egal(relu, "--tout") {
            tout = 1;
        }
        @2[K_ETAT] = 0;
        @2[K_ETAT + 1] = 0;
        @2[K_ETAT + 2] = 0;
        @2[K_ETAT + 3] = 0;
        @2[K_ETAT + 5] = 0;
        soit fc1 = lire_chemin(CHEMIN4);
        soit fc2 = lire_chemin(CHEMIN5);
        soit fc3 = lire_chemin(CHEMIN6);
        // chaque cube choisi par son chemin (service 29 : la machine l'accorde, réparé au besoin), puis lu à ses adresses
        si fc1 != 0 && longueur(fc1) > 0 { choisir_catalogue(fc1); }
        si fc2 != 0 && longueur(fc2) > 0 { choisir_catalogue(fc2); }
        si fc3 != 0 && longueur(fc3) > 0 { choisir_catalogue(fc3); }
        soit dc = etat_disque();
        selon dc {
            faux { ecrire_t(1, "un cube de catalogue a été réparé par son anti-cube et son ombre (sa copie ; relancez lugus cataloguer)\n"); }
            variable { ecrire_t(1, "les copies d'un cube de catalogue se contredisent, au-delà de son ombre\n"); }
            vrai { }
            inconnu { }
        }
        soit e5 = montrer_carte(entree, tout);
        si @2[G + G_ERR] != 0 {
            sortie(E_INCONNU);
            retour;
        }
        sortie(e5);
        retour;
    }
    si verbe != 0 && texte_egal(verbe, "arnc") {
        soit source2 = lire_chemin(CHEMIN4);
        soit iso2 = lire_chemin(CHEMIN5);
        soit comp3 = lire_chemin(CHEMIN6);
        soit noms3 = lire_chemin(CHEMIN7);
        soit ancien3 = lire_chemin(CHEMIN8);
        faire_arnc(entree, relu, source2, iso2, comp3, noms3, ancien3);
        si @2[G + G_ERR] != 0 {
            sortie(E_INCONNU);
            retour;
        }
        sortie(E_VRAI);
        retour;
    }
    si verbe != 0 && texte_egal(verbe, "transcrire") {
        soit isof = lire_chemin(CHEMIN4);
        soit comp2 = lire_chemin(CHEMIN5);
        soit etat_t = transcrire(entree, relu, isof);
        si comp2 != 0 && (etat_t == E_VRAI || etat_t == E_FAUX) && @2[G + G_ERR] == 0 {
            verifier_texte(comp2);
        }
        sortie(etat_t);
        retour;
    }
    si verbe != 0 && (texte_egal(verbe, "hex") || texte_egal(verbe, "cube") || texte_egal(verbe, "mots")) {
        soit fr0 = lire_chemin(CHEMIN4);
        soit nm0 = lire_chemin(CHEMIN5);
        soit e2 = charger(entree);
        si @2[G + G_ERR] != 0 {
            sortie(E_INCONNU);
            retour;
        }
        si e2 == E_VARIABLE {
            ecrire_t(1, "rien n'est écrit : le brin est gardé tel qu'il a été lu, pour la preuve\n");
            sortie(e2);
            retour;
        }
        si texte_egal(verbe, "hex") {
            ecrire_hex_fichier(relu);
        } sinon si texte_egal(verbe, "cube") {
            soit fr = 440;
            si fr0 != 0 {
                fr = nombre_dans(fr0, 0);
            }
            si fr > 16777215 {
                refuser("la fréquence d'un cube est un nombre, de 0 à 16 777 215");
            } sinon {
                ecrire_cube(fr, nm0);
            }
        } sinon {
            ecrire_mots_seuls(relu);
        }
        si @2[G + G_ERR] != 0 {
            sortie(E_INCONNU);
            retour;
        }
        sortie(e2);
        retour;
    }
    si entree == 0 {
        entree = "code.adn";
    }
    lire_adn(entree);
    si @2[G + G_ERR] != 0 {
        sortie(E_INCONNU);
        retour;
    }
    soit etat = lire();
    rendre_compte(etat);
    si etat == E_VARIABLE {
        ecrire_t(1, "rien n'est relu : l'ADN est gardé tel qu'il a été lu, pour la preuve\n");
    } sinon si relu != 0 {
        ecrire_adn(relu);
    }
    sortie(etat);
}
