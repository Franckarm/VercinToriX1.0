// machine : lugus
// Le lecteur d'ADN écrit en vtx : la même lecture que chimie/adn.py et vtx-rs/src/adn.rs (docs/vtx-reactions.md,
// section 9), dans le langage lui-même, pour l'Ogmios écrit en vtx et pour que l'ADN ne dépende ni de Python ni de Rust.
// Il lit un ADN (versions 3 et 4), vérifie chaque molécule par ses trois témoins (la signature, l'ombre de Reed-Solomon des
// colonnes entrelacées, les neutrons), répare ce qui peut l'être et confirme chaque réparation par la triangulation ;
// les introns qu'il ne connaît pas sont gardés tels quels. Le compte rendu est celui de Lugus, ligne pour ligne.
//
//     lugus relire PROG.adn [RELU.adn]
//
// Les entrées : le chemin de l'ADN, puis celui de l'ADN relu (un caractère par entrée, chacun terminé par 0 ; sans
// chemin, « code.adn », et rien n'est écrit). La sortie : l'état de l'ADN (2 vrai, 1 faux : réparé, 3 variable : abîmé
// au-delà de ses témoins, 0 : illisible). Un ADN variable n'est pas réécrit : il est gardé tel qu'il a été lu.
//
// La mémoire (étage 2) : les mots (deux moitiés de 64 bits), les témoins, GF(256), les brouillons du décodage.

constante MH = 0;                // les mots : les 64 bits hauts
constante MB = 1000000;          // les 64 bits bas
constante AH = 2000000;          // les mots tels qu'ils ont été lus
constante AB = 3000000;
constante NEU = 4000000;         // les neutrons de chaque place (256 : aucun)
constante PARN = 5000000;        // 1 : la place est désignée par ses neutrons
constante MOL = 6000000;         // les molécules, huit cases : début, fin, frontière, isotope, signature, état, quoi, changés
constante OMB = 7000000;         // les ombres : quatre mots par colonne (haut, bas)
constante COLE = 7100000;        // l'état de chaque colonne
constante COLR = 7110000;        // le nombre de mots réparés dans chaque colonne
constante EXPO = 7120000;        // GF(256) : les puissances (512)
constante LOGA = 7121000;        // les logarithmes (256)
constante CRC = 7122000;         // la table du CRC-8 (256)
constante LGEN = 7123000;        // les logarithmes des coefficients du générateur (r = 4)
constante DH = 7124000;          // la colonne lue : hauts, bas, places (251 au plus)
constante DB = 7124300;
constante DP = 7124600;
constante OC = 7124900;          // l'ombre recalculée d'une colonne (quatre mots)
constante TRAV = 7124920;        // le travail du codage d'une voie (255 octets)
constante VOIE = 7125200;        // les seize voies d'une colonne (une longueur, puis 255 octets chacune)
constante EFF = 7130000;         // les effacements d'une colonne (une longueur, puis les rangs)
constante CHIF = 7130500;        // les chiffres d'un nombre écrit
constante PUIS = 7130560;        // les puissances de 10, de 1 à 10^19
constante NOM = 7130600;         // le nom d'une section lue
constante CHEMIN = 7130700;      // le chemin de l'ADN lu (un texte, 290 caractères au plus)
constante G = 7131000;           // l'état du lecteur
constante CHEMIN2 = 7131100;     // le chemin de l'ADN relu (290 caractères au plus)
constante CHEMIN3 = 7197600;     // le verbe (relire, ranger, transcrire), puis les chemins suivants (0.6n) : entre la
constante CHEMIN4 = 7197900;     // table CRC2 (jusqu'à 7 197 536) et le brouillon (7 200 000)
constante CHEMIN5 = 7198200;
constante CHEMIN6 = 7198500;
constante CHEMIN7 = 7198800;
constante CHEMIN8 = 7199100;     // le brin rangé avant (0.6q : la face de la mémoire)
constante NPL = 40000000;        // la carte : les noms (la place, le début dans NCAR, la longueur)
constante NDEB = 40200000;
constante NLEN = 40400000;
constante NCAR = 41000000;
constante TOUD = 42000000;       // ce que touche chaque molécule, elle-même ; avec ses appels ; sa profondeur ; la file
constante TOUT = 42200000;
constante PROF = 42400000;
constante FILE = 42600000;
constante CAD = 42800000;        // les appels de chaque molécule : le début dans CALLS, leur nombre
constante CAN = 43000000;
constante CALLS = 44000000;
constante CTMP = 44900000;       // les appels d'une molécule, avant le tri
constante LST = 45000000;        // le début de chaque ligne du texte (dans INTR)
constante HDR = 46000000;        // les en-têtes : seize cases chacun
constante FOFF = 75000000;       // la carte lue : le début de chaque champ (trente-deux cases par ligne), puis la fin
constante ANCK = 80000000;       // les faces d'avant : la clé (adresse, longueur ; 4294967294 : la tête), l'empreinte,
constante ANCKL = 80200000;      // l'histoire (adresse, longueur)
constante ANCE = 80400000;
constante ANCH = 80600000;
constante ANCHL = 80800000;
constante ANCT = 85000000;       // le brin d'avant, lu en entier
constante DEBK = 49000000;       // la carte lue : le début de chaque molécule
constante CARTEB = 50000000;     // le texte de la carte
constante CARTEL = 59000000;     // la carte gardée, quand on la compare
constante TEXTE = 30000000;      // le texte gardé, recopié pour le compilateur (une longueur, puis ses caractères)
constante CRC2 = 7132000;        // le CRC-8 deux octets à la fois (65 536) : CRC2[x | y << 8] = CRC[CRC[x] ^ y]
constante BROUILLON = 7200000;   // les polynômes du décodage (repris à chaque voie)
constante INTR = 8000000;        // les introns inconnus, recopiés tels quels
constante MAXMOTS = 1000000;
constante MAXINTR = 7900000;
constante FIN = 4611686018427387904;     // la fin du fichier
constante ETAGE2 = 9223372036854775808;  // l'adresse longue de l'étage 2

// l'état du lecteur : G + …
constante G_CANAL = 0;
constante G_CAR = 1;
constante G_N = 2;
constante G_NM = 3;
constante G_NC = 4;
constante G_NO = 5;
constante G_NI = 6;
constante G_BR = 7;
constante G_ERR = 8;
constante G_HAUT = 9;
constante G_COPIE = 10;
constante G_OMB4 = 11;
constante G_VERSION = 12;        // 3 : neutrons CRC-8 ; 4 : neutrons quaternaires (GF(4))
constante G_COIFFE = 13;         // la signature de la coiffe d'un ARN lu (0.6n bis)
constante G_ARN = 14;            // 1 : le brin lu est un ARN
constante G_TEM = 15;            // 1 : les trois témoins ont été lus (un ADN, un ARN sûr) ; 0 : les mots seuls
constante G_SDEB = 16;           // une section des introns trouvée : le début de ses lignes, sa fin (sans le dernier \n)
constante G_SFIN = 17;
constante G_NN = 18;             // la carte (0.6p) : le nombre de noms donnés par le compilateur
constante G_CL = 19;             // la longueur du texte de la carte (CARTEB)
constante G_NH = 20;             // le nombre de fonctions et de réactions écrites dans le texte
constante G_NL = 21;             // le nombre de lignes du texte
constante G_NK = 22;             // le nombre de lignes de la carte lue (pour la montrer)
constante G_NA = 23;             // le nombre de lignes des faces d'avant (4294967295 : pas de rangement d'avant)
constante G_GARDEE = 25;         // la carte montrée est celle que le brin garde (1), ou refaite de ses mots seuls (0)
constante G_HCOPIE = 24;         // 1 : l'histoire est recopiée des faces gardées (pour les comparer), pas refaite

constante COLONNE = 251;
constante OMBRE = 4;
constante E_INCONNU = 0;
constante E_FAUX = 1;
constante E_VRAI = 2;
constante E_VARIABLE = 3;

// --------------------------------------------------------------------------------------------- textes et nombres
fonction ecrire_t(c, t) {
    pour i dans 0..longueur(t) {
        ecrire_car(c, car(t, i));
    }
}

// les n chiffres de x (x < 10^n), du plus fort au plus faible : une division par une puissance de 10 chacun
fonction ecrire_chiffres(c, x0, n) {
    soit x = x0;
    soit k = n;
    tantque k > 0 {
        k = k - 1;
        soit p = @2[PUIS + k];
        soit d = x / p;
        x = x - d * p;
        ecrire_car(c, 48 + d);
    }
}

fonction ecrire_u64(c, x) {
    si x < 10 {
        ecrire_car(c, 48 + x);
        retour;
    }
    soit n = 2;
    tantque n < 20 && x >= @2[PUIS + n] {
        n = n + 1;
    }
    ecrire_chiffres(c, x, n);
}

// un mot de 128 bits en décimal (h les 64 bits hauts, b les bas) : coupé en morceaux de 19 chiffres par l'entier_128 de
// la machine ; il est signé, alors le mot est d'abord divisé par deux (⌊x / 10^19⌋ = ⌊⌊x / 2⌋ / (5·10^18)⌋)
fonction ecrire_u128(c, h, b) {
    si h == 0 {
        ecrire_u64(c, b);
        retour;
    }
    soit x: entier_128 = entier_128_de(h, b);
    soit y: entier_128 = (x >> 1) & 170141183460469231731687303715884105727LL;
    soit q: entier_128 = y / 5000000000000000000LL;
    soit r = bas(x - q * 10000000000000000000LL);
    soit q2: entier_128 = q / 10000000000000000000LL;
    soit r2 = bas(q - q2 * 10000000000000000000LL);
    si q2 != 0LL {
        ecrire_car(c, 48 + bas(q2));
        ecrire_chiffres(c, r2, 19);
    } sinon {
        ecrire_u64(c, r2);
    }
    ecrire_chiffres(c, r, 19);
}

fonction refuser(t) {
    si @2[G + G_ERR] == 0 {
        ecrire_t(1, "ADN : ");
        ecrire_t(1, t);
        ecrire_car(1, 10);
    }
    @2[G + G_ERR] = 1;
}

// --------------------------------------------------------------------------------------------- la lecture du fichier
// le caractère courant est consommé : recopié dans les introns s'il le faut, puis le suivant est lu (\r est sauté)
fonction avancer() {
    si @2[G + G_COPIE] == 1 {
        soit ni = @2[G + G_NI];
        si ni < MAXINTR - INTR {
            @2[INTR + ni] = @2[G + G_CAR];
            @2[G + G_NI] = ni + 1;
        }
    }
    soit f = @2[G + G_CANAL];
    soit c = 13;
    tantque c == 13 {
        si fin_de(f) != 0 {
            @2[G + G_CAR] = FIN;
            retour;
        }
        c = lire_car(f);
    }
    @2[G + G_CAR] = c;
}

fonction car_courant() {
    retour @2[G + G_CAR];
}

fonction attendre(ch) {
    si car_courant() != ch {
        refuser("le fichier ne suit pas la forme d'un ADN (version 3 ou 4)");
        retour;
    }
    avancer();
}

// un nombre dans un en-tête recopié (les introns) : caractère par caractère, par avancer
fonction lire_nombre_recopie() {
    soit x: entier_128 = 0LL;
    tantque car_courant() >= 48 && car_courant() <= 57 {
        x = x * 10LL + entier_128(car_courant() - 48);
        avancer();
    }
    @2[G + G_HAUT] = haut(x);
    retour bas(x);
}

// un nombre décimal de 128 bits au plus : rend ses 64 bits bas, les hauts dans G_HAUT. Le chemin court : le caractère
// courant reste dans c, le fichier est lu ici (\r sauté, comme avancer) ; le nombre est fait dans un entier_128 (un
// mot de Lugus : une multiplication, une addition), coupé à la fin ; c, x, f d'abord, pour qu'ils aient un registre
fonction lire_nombre() {
    soit c = @2[G + G_CAR];
    soit x: entier_128 = 0LL;
    soit f = @2[G + G_CANAL];
    // c - 48 < 10 (sans signe) : c est un chiffre ; lire_car rend « tout à un » au bout du fichier (les deux
    // machines) : ce n'est pas un chiffre, la boucle s'arrête
    si c - 48 >= 10 {
        refuser("un nombre est attendu");
    }
    si @2[G + G_COPIE] == 1 {
        retour lire_nombre_recopie();
    }
    tantque c - 48 < 10 {
        x = x * 10LL + entier_128(c - 48);
        c = lire_car(f);
        tantque c == 13 {
            c = lire_car(f);
        }
    }
    si c == 18446744073709551615 {
        c = FIN;
    }
    @2[G + G_CAR] = c;
    @2[G + G_HAUT] = haut(x);
    retour bas(x);
}

fonction nom_est(t) {
    si @2[NOM] != longueur(t) {
        retour 0;
    }
    pour i dans 0..longueur(t) {
        si @2[NOM + 1 + i] != car(t, i) {
            retour 0;
        }
    }
    retour 1;
}

fonction lire_mots() {
    soit n = 0;
    tantque car_courant() != 10 && car_courant() != FIN && @2[G + G_ERR] == 0 {
        si n >= MAXMOTS {
            refuser("trop de mots pour ce lecteur (un million au plus)");
            retour;
        }
        soit l = lire_nombre();
        @2[MH + n] = @2[G + G_HAUT];
        @2[MB + n] = l;
        n = n + 1;
        si car_courant() == ',' {
            avancer();
        }
    }
    @2[G + G_N] = n;
    attendre(10);
}

fonction lire_molecules(nl) {
    pour j dans 0..nl {
        tantque car_courant() != '|' && car_courant() != FIN {
            avancer();
        }
        attendre('|');
        soit base = MOL + 8 * j;
        @2[base] = lire_nombre();
        attendre('|');
        @2[base + 1] = lire_nombre();
        attendre('|');
        @2[base + 2] = lire_nombre();
        attendre('|');
        @2[base + 4] = lire_nombre();
        attendre('|');
        @2[base + 3] = lire_nombre();
        attendre(10);
        si @2[G + G_ERR] != 0 {
            retour;
        }
    }
    @2[G + G_NM] = nl;
}

fonction lire_ombres(nl) {
    pour k dans 0..nl {
        soit z = 0;
        tantque car_courant() != 10 && car_courant() != FIN && @2[G + G_ERR] == 0 {
            soit l = lire_nombre();
            si z < OMBRE {
                @2[OMB + 8 * k + 2 * z] = @2[G + G_HAUT];
                @2[OMB + 8 * k + 2 * z + 1] = l;
            }
            z = z + 1;
            si car_courant() == ',' {
                avancer();
            }
        }
        si z != OMBRE {
            @2[G + G_OMB4] = 1;
        }
        attendre(10);
    }
    @2[G + G_NO] = nl;
}

fonction lire_neutrons(nl) {
    pour i dans 0..MAXMOTS {
        @2[NEU + i] = 256;
    }
    pour k dans 0..nl {
        tantque car_courant() != 10 && car_courant() != FIN && @2[G + G_ERR] == 0 {
            soit p = lire_nombre();
            attendre(':');
            soit v = lire_nombre();
            si p < MAXMOTS {
                @2[NEU + p] = v & 255;
            }
            si car_courant() == ',' {
                avancer();
            }
        }
        attendre(10);
    }
}

// une section inconnue (un intron : les isotopes, le texte, l'épigénome…) : recopiée telle quelle, sans être analysée
fonction recopier_intron(nl) {
    soit vues = 0;
    tantque vues < nl && car_courant() != FIN {
        si car_courant() == 10 {
            vues = vues + 1;
        }
        avancer();
    }
    attendre('A');
    attendre('G');
    attendre(10);
}

fonction lire_adn(chemin) {
    soit f = ouvrir_lecture(chemin);
    si f == 18446744073709551615 {
        refuser("le fichier ne s'ouvre pas");
        retour;
    }
    @2[G + G_CANAL] = f;
    @2[G + G_COPIE] = 0;
    avancer();
    // « VTXADN03 », « VTXADN04 » ; ou l'ARN (0.6n bis) : « VTXARN01 » (neutrons CRC-8, ceux de la version 3),
    // « VTXARN02 » (quaternaires, version 4), lu par le même chemin : sa coiffe est une section connue de plus
    soit tete = "VTXA";
    pour i dans 0..longueur(tete) {
        si car_courant() != car(tete, i) {
            refuser("ce n'est pas un ADN de vtx (version 3 ou 4)");
            fermer(f);
            retour;
        }
        avancer();
    }
    soit arn = 0;
    si car_courant() == 'R' {
        arn = 1;
    } sinon si car_courant() != 'D' {
        refuser("ce n'est pas un ADN de vtx (version 3 ou 4)");
        fermer(f);
        retour;
    }
    @2[G + G_ARN] = arn;
    avancer();
    si car_courant() != 'N' {
        refuser("ce n'est pas un ADN de vtx (version 3 ou 4)");
        fermer(f);
        retour;
    }
    avancer();
    si car_courant() != '0' {
        refuser("ce n'est pas un ADN de vtx (version 3 ou 4)");
        fermer(f);
        retour;
    }
    avancer();
    soit v = car_courant() - 48 + 2 * arn;
    si v != 3 && v != 4 {
        si arn == 1 {
            refuser("ce n'est pas un ARN de vtx (version 1 ou 2)");
        } sinon {
            refuser("ce n'est pas un ADN de vtx (version 3 ou 4)");
        }
        fermer(f);
        retour;
    }
    @2[G + G_VERSION] = v;
    avancer();
    attendre(10);
    preparer_neutrons();
    soit vus = 0;
    tantque car_courant() != FIN && car_courant() != 10 && @2[G + G_ERR] == 0 {
        // « GU nom N » : l'en-tête est recopié, puis repris si la section est connue
        soit marque = @2[G + G_NI];
        @2[G + G_COPIE] = 1;
        attendre('G');
        attendre('U');
        attendre(' ');
        soit ln = 0;
        tantque car_courant() != ' ' && car_courant() != 10 && car_courant() != FIN {
            si ln < 90 {
                @2[NOM + 1 + ln] = car_courant();
                ln = ln + 1;
            }
            avancer();
        }
        @2[NOM] = ln;
        attendre(' ');
        soit nl = lire_nombre();
        attendre(10);
        si nom_est("mots") == 1 {
            @2[G + G_COPIE] = 0;
            @2[G + G_NI] = marque;
            si nl != 1 {
                refuser("la section des mots a une ligne");
            }
            lire_mots();
            vus = vus | 1;
        } sinon si nom_est("molecules") == 1 {
            @2[G + G_COPIE] = 0;
            @2[G + G_NI] = marque;
            lire_molecules(nl);
            vus = vus | 2;
        } sinon si nom_est("ombres") == 1 {
            @2[G + G_COPIE] = 0;
            @2[G + G_NI] = marque;
            lire_ombres(nl);
            vus = vus | 4;
        } sinon si nom_est("neutrons") == 1 {
            @2[G + G_COPIE] = 0;
            @2[G + G_NI] = marque;
            lire_neutrons(nl);
            vus = vus | 8;
        } sinon si nom_est("coiffe") == 1 && arn == 1 {
            // la coiffe de l'ARN : « signature|isoforme » ; l'isoforme n'est pas gardée (l'ADN n'en a pas)
            @2[G + G_COPIE] = 0;
            @2[G + G_NI] = marque;
            @2[G + G_COIFFE] = lire_nombre();
            attendre('|');
            tantque car_courant() != 10 && car_courant() != FIN {
                avancer();
            }
            attendre(10);
            vus = vus | 16;
        } sinon {
            recopier_intron(nl);
        }
        si @2[G + G_COPIE] == 0 {
            attendre('A');
            attendre('G');
            attendre(10);
        }
        @2[G + G_COPIE] = 0;
        si @2[G + G_ERR] == 0 && @2[G + G_NI] >= MAXINTR - INTR {
            refuser("les introns sont trop longs pour ce lecteur");
        }
        si car_courant() != FIN && car_courant() != 10 && car_courant() != 'G' && @2[G + G_ERR] == 0 {
            refuser("borne d'intron attendue (GU)");
        }
    }
    fermer(f);
    si @2[G + G_ERR] != 0 {
        retour;
    }
    @2[G + G_TEM] = 1;
    si arn == 1 {
        // l'ARN : la coiffe et les mots, et les trois témoins (sur, complet) ou aucun (rapide, memoire)
        si (vus & 17) != 17 {
            refuser("l'ARN est dégradé (sans coiffe ou sans mots)");
            retour;
        }
        si (vus & 14) == 0 {
            @2[G + G_TEM] = 0;
            retour;
        }
        si (vus & 14) != 14 {
            refuser("une section des témoins de l'ARN manque");
            retour;
        }
    } sinon si vus != 15 {
        refuser("une section manque");
        retour;
    }
    // un ADN dont les tables ne collent pas aux mots (tronqué, mal recopié) n'est pas lu
    soit n = @2[G + G_N];
    @2[G + G_NC] = nb_colonnes(n);
    soit faux_temoins = @2[G + G_NO] != @2[G + G_NC] || @2[G + G_OMB4] != 0;
    pour j dans 0..@2[G + G_NM] {
        si @2[MOL + 8 * j + 1] > n || @2[MOL + 8 * j] >= @2[MOL + 8 * j + 1] {
            faux_temoins = 1;
        }
    }
    si faux_temoins {
        refuser("les témoins ne correspondent pas aux mots");
    }
}

// --------------------------------------------------------------------------------------------- les témoins
fonction brasser(z0) {
    soit z = z0 + 11400714819323198485;
    z = (z ^ (z >> 30)) * 13787848793156543929;
    z = (z ^ (z >> 27)) * 10723151780598845931;
    retour z ^ (z >> 31);
}

// l'empreinte des mots [a, b) : 64 bits, chaque moitié de mot mêlée à son tour, la basse d'abord
fonction signature(a, b) {
    soit h = brasser(6215904648730267136 ^ (b - a));
    pour i dans a..b {
        h = brasser(h ^ @2[MB + i]);
        h = brasser(h ^ @2[MH + i]);
    }
    retour h;
}

// les neutrons d'un mot : un CRC de 8 bits (polynôme 0x07) sur ses seize octets, le plus faible d'abord ; deux octets
// par lecture de la table CRC2
fonction crc8(h, b) {
    soit c = @2[CRC2 + (b & 65535)];
    c = @2[CRC2 + (c ^ ((b >> 16) & 65535))];
    c = @2[CRC2 + (c ^ ((b >> 32) & 65535))];
    c = @2[CRC2 + (c ^ (b >> 48))];
    c = @2[CRC2 + (c ^ (h & 65535))];
    c = @2[CRC2 + (c ^ ((h >> 16) & 65535))];
    c = @2[CRC2 + (c ^ ((h >> 32) & 65535))];
    retour @2[CRC2 + (c ^ (h >> 48))];
}

// les neutrons quaternaires (version 4) : le mot lu comme 64 quits, le plus fort d'abord, divisé par
// g(x) = x^4 + x^2 + ωx + 1 sur GF(4) (comme chimie/adn.py) ; deux octets par lecture de CRC2, l'octet fort d'abord.
// La table est rangée décalée de 8 bits (CRC2[x << 8 | y] = T[T[x] ^ y] << 8) : c reste décalé, chaque pas est un OU
// exclusif et une lecture (Lugus n'a pas de décalage par une valeur écrite : deux instructions de moins par pas)
fonction crc4(h, b) {
    soit c = @2[CRC2 + (h >> 48)];
    c = @2[CRC2 + (c ^ ((h >> 32) & 65535))];
    c = @2[CRC2 + (c ^ ((h >> 16) & 65535))];
    c = @2[CRC2 + (c ^ (h & 65535))];
    c = @2[CRC2 + (c ^ (b >> 48))];
    c = @2[CRC2 + (c ^ ((b >> 32) & 65535))];
    c = @2[CRC2 + (c ^ ((b >> 16) & 65535))];
    retour @2[CRC2 + (c ^ (b & 65535))] >> 8;
}

// les neutrons d'un mot selon la version de l'ADN lu
fonction neutron(h, b) {
    si @2[G + G_VERSION] >= 4 {
        retour crc4(h, b);
    }
    retour crc8(h, b);
}

// le produit dans GF(4) (0, 1, ω = 2, ω² = 3)
fonction gf4_mul(a, b) {
    si a == 0 || b == 0 {
        retour 0;
    }
    soit l = (a - 1) + (b - 1);
    si l >= 3 {
        l = l - 3;
    }
    retour l + 1;
}

// la table de deux octets de la version lue : CRC-8 (le plus faible d'abord) ou quaternaire (le plus fort d'abord)
fonction preparer_neutrons() {
    si @2[G + G_VERSION] >= 4 {
        // T : un octet (quatre quits, le fort d'abord) entré dans un reste nul ; rangé dans CRC (256 cases)
        pour x dans 0..256 {
            soit r = 0;
            soit k = 4;
            tantque k > 0 {
                k = k - 1;
                soit q = (x >> (2 * k)) & 3;
                soit t = q ^ (r >> 6);
                soit r0 = (r >> 4) & 3;
                soit r1 = (r >> 2) & 3;
                soit r2 = r & 3;
                r = (r0 << 6) | ((r1 ^ gf4_mul(t, 1)) << 4) | ((r2 ^ gf4_mul(t, 2)) << 2) | gf4_mul(t, 1);
            }
            @2[CRC + x] = r;
        }
        pour x2 dans 0..256 {
            pour y dans 0..256 {
                @2[CRC2 + ((x2 << 8) | y)] = @2[CRC + (@2[CRC + x2] ^ y)] << 8;
            }
        }
        retour;
    }
    pour y2 dans 0..256 {
        pour x3 dans 0..256 {
            @2[CRC2 + (x3 | (y2 << 8))] = @2[CRC + (@2[CRC + x3] ^ y2)];
        }
    }
}

fonction nb_colonnes(n) {
    soit c = (n + COLONNE - 1) / COLONNE;
    si c < 1 {
        retour 1;
    }
    retour c;
}

// l'octet de la voie k d'un mot (la voie 0 : l'octet le plus fort)
fonction octet(h, b, k) {
    si k < 8 {
        retour (h >> (8 * (7 - k))) & 255;
    }
    retour (b >> (8 * (15 - k))) & 255;
}

// --------------------------------------------------------------------------------------------- Reed-Solomon, GF(256)
fonction preparer() {
    soit p10 = 1;
    pour i0 dans 0..20 {
        @2[PUIS + i0] = p10;
        p10 = p10 * 10;
    }
    soit x = 1;
    pour i dans 0..255 {
        @2[EXPO + i] = x;
        @2[LOGA + x] = i;
        x = x << 1;
        si (x & 256) != 0 {
            x = x ^ 285;
        }
    }
    pour j dans 255..512 {
        @2[EXPO + j] = @2[EXPO + j - 255];
    }
    pour k dans 0..256 {
        soit c = k;
        pour t dans 0..8 {
            si (c & 128) != 0 {
                c = ((c << 1) ^ 7) & 255;
            } sinon {
                c = (c << 1) & 255;
            }
        }
        @2[CRC + k] = c;
    }
    // la table de deux octets (CRC2) attend la version de l'ADN : preparer_neutrons, après l'en-tête
    // le générateur : le produit des (x + 2^i), i < 4 ; ses coefficients ne sont jamais nuls
    brouillon_repris();
    soit g = brouillon(1);
    @2[g + 1] = 1;
    pour i2 dans 0..OMBRE {
        soit f = brouillon(2);
        @2[f + 1] = 1;
        @2[f + 2] = @2[EXPO + i2];
        g = p_mul(g, f);
    }
    pour j2 dans 1..OMBRE + 1 {
        @2[LGEN + j2] = @2[LOGA + @2[g + 1 + j2]];
    }
}

fonction gmul(a, b) {
    si a == 0 || b == 0 {
        retour 0;
    }
    retour @2[EXPO + @2[LOGA + a] + @2[LOGA + b]];
}

fonction gdiv(a, b) {
    si a == 0 {
        retour 0;
    }
    retour @2[EXPO + (@2[LOGA + a] + 255 - @2[LOGA + b]) % 255];
}

fonction gpw(a, n) {
    si a == 0 {
        retour 0;
    }
    retour @2[EXPO + (@2[LOGA + a] * n) % 255];
}

fonction ginv(a) {
    retour @2[EXPO + 255 - @2[LOGA + a]];
}

// les polynômes et les listes : une longueur, puis les coefficients (le plus fort d'abord), pris dans le brouillon
fonction brouillon_repris() {
    @2[G + G_BR] = BROUILLON;
}

fonction brouillon(n) {
    soit p = @2[G + G_BR];
    @2[G + G_BR] = p + n + 1;
    @2[p] = n;
    pour i dans 0..n {
        @2[p + 1 + i] = 0;
    }
    retour p;
}

fonction p_copie(p) {
    soit r = brouillon(@2[p]);
    pour i dans 0..@2[p] {
        @2[r + 1 + i] = @2[p + 1 + i];
    }
    retour r;
}

fonction p_renverse(p) {
    soit n = @2[p];
    soit r = brouillon(n);
    pour i dans 0..n {
        @2[r + 1 + i] = @2[p + n - i];
    }
    retour r;
}

fonction p_mul(p, q) {
    soit lp = @2[p];
    soit lq = @2[q];
    soit r = brouillon(lp + lq - 1);
    pour j dans 0..lq {
        soit b = @2[q + 1 + j];
        pour i dans 0..lp {
            @2[r + 1 + i + j] = @2[r + 1 + i + j] ^ gmul(@2[p + 1 + i], b);
        }
    }
    retour r;
}

fonction p_add(p, q) {
    soit lp = @2[p];
    soit lq = @2[q];
    soit n = lp;
    si lq > n {
        n = lq;
    }
    soit r = brouillon(n);
    pour i dans 0..lp {
        @2[r + 1 + n - lp + i] = @2[p + 1 + i];
    }
    pour j dans 0..lq {
        @2[r + 1 + j + n - lq] = @2[r + 1 + j + n - lq] ^ @2[q + 1 + j];
    }
    retour r;
}

fonction p_scale(p, x) {
    soit r = brouillon(@2[p]);
    pour i dans 0..@2[p] {
        @2[r + 1 + i] = gmul(@2[p + 1 + i], x);
    }
    retour r;
}

fonction p_eval(p, x) {
    soit y = @2[p + 1];
    pour i dans 1..@2[p] {
        y = gmul(y, x) ^ @2[p + 1 + i];
    }
    retour y;
}

fonction dans_liste(l, x) {
    pour i dans 0..@2[l] {
        si @2[l + 1 + i] == x {
            retour 1;
        }
    }
    retour 0;
}

fonction syndromes(cw, r) {
    soit s = brouillon(r + 1);
    pour i dans 0..r {
        @2[s + 2 + i] = p_eval(cw, @2[EXPO + i]);
    }
    retour s;
}

fonction tous_nuls(p) {
    pour i dans 0..@2[p] {
        si @2[p + 1 + i] != 0 {
            retour 0;
        }
    }
    retour 1;
}

fonction localisateur_effacements(pos) {
    soit e = brouillon(1);
    @2[e + 1] = 1;
    pour i dans 0..@2[pos] {
        soit a = brouillon(2);         // [1] + [2^p, 0] : (2^p, 1)
        @2[a + 1] = @2[EXPO + @2[pos + 1 + i]];
        @2[a + 2] = 1;
        e = p_mul(e, a);
    }
    retour e;
}

// le reste de la division (ses d derniers coefficients, d = len(diviseur) - 1)
fonction divmod_reste(dd, dv) {
    soit out = p_copie(dd);
    soit ld = @2[dd];
    soit lv = @2[dv];
    soit d = lv - 1;
    si ld >= d {
        pour i dans 0..ld - d {
            soit c = @2[out + 1 + i];
            si c != 0 {
                pour j dans 1..lv {
                    si @2[dv + 1 + j] != 0 {
                        @2[out + 1 + i + j] = @2[out + 1 + i + j] ^ gmul(@2[dv + 1 + j], c);
                    }
                }
            }
        }
    }
    soit r = brouillon(d);
    pour k dans 0..d {
        @2[r + 1 + k] = @2[out + 1 + ld - d + k];
    }
    retour r;
}

fonction corriger_valeurs(cw, synd, pos_err) {
    soit n = @2[cw];
    soit ne = @2[pos_err];
    soit coef = brouillon(ne);
    pour i dans 0..ne {
        @2[coef + 1 + i] = n - 1 - @2[pos_err + 1 + i];
    }
    soit loc = localisateur_effacements(coef);
    soit synd_inv = p_renverse(synd);
    soit dv = brouillon(@2[loc] + 1);
    @2[dv + 1] = 1;
    soit om = divmod_reste(p_mul(synd_inv, loc), dv);      // omega renversé deux fois : le reste lui-même
    soit xs = brouillon(ne);
    pour i2 dans 0..ne {
        @2[xs + 1 + i2] = @2[EXPO + @2[coef + 1 + i2]];
    }
    soit e = brouillon(n);
    pour i3 dans 0..ne {
        soit xi = @2[xs + 1 + i3];
        soit xi_inv = ginv(xi);
        soit prime = 1;
        pour j dans 0..ne {
            si j != i3 {
                prime = gmul(prime, 1 ^ gmul(xi_inv, @2[xs + 1 + j]));
            }
        }
        si prime == 0 {
            retour 0;
        }
        soit y = gmul(gpw(xi, 1), p_eval(om, xi_inv));
        @2[e + 1 + @2[pos_err + 1 + i3]] = gdiv(y, prime);
    }
    soit out = brouillon(n);
    pour k dans 0..n {
        @2[out + 1 + k] = @2[cw + 1 + k] ^ @2[e + 1 + k];
    }
    retour out;
}

fonction trouver_localisateur(synd, r, nb_eff) {
    soit err = brouillon(1);
    @2[err + 1] = 1;
    soit old = brouillon(1);
    @2[old + 1] = 1;
    soit decal = @2[synd] - r;
    soit tours = 0;
    si r > nb_eff {
        tours = r - nb_eff;
    }
    pour i dans 0..tours {
        soit k = i + decal;
        soit delta = @2[synd + 1 + k];
        soit le = @2[err];
        pour j dans 1..le {
            delta = delta ^ gmul(@2[err + 1 + le - 1 - j], @2[synd + 1 + k - j]);
        }
        soit o2 = brouillon(@2[old] + 1);
        pour z dans 0..@2[old] {
            @2[o2 + 1 + z] = @2[old + 1 + z];
        }
        old = o2;
        si delta != 0 {
            si @2[old] > @2[err] {
                soit neuf = p_scale(old, delta);
                old = p_scale(err, ginv(delta));
                err = neuf;
            }
            err = p_add(err, p_scale(old, delta));
        }
    }
    soit debut = 0;
    tantque debut < @2[err] && @2[err + 1 + debut] == 0 {
        debut = debut + 1;
    }
    si debut == @2[err] {
        retour 0;
    }
    soit res = brouillon(@2[err] - debut);
    pour i2 dans 0..@2[res] {
        @2[res + 1 + i2] = @2[err + 1 + debut + i2];
    }
    soit errs = @2[res] - 1;
    si 2 * errs > r + nb_eff {
        retour 0;
    }
    retour res;
}

fonction trouver_erreurs(err_loc, n) {
    soit errs = @2[err_loc] - 1;
    soit pos = brouillon(n);
    soit np = 0;
    pour i dans 0..n {
        si p_eval(err_loc, gpw(2, i)) == 0 {
            @2[pos + 1 + np] = n - 1 - i;
            np = np + 1;
        }
    }
    @2[pos] = np;
    si np != errs {
        retour 0;
    }
    retour pos;
}

fonction forney_syndromes(synd, pos, n) {
    soit lf = @2[synd] - 1;
    soit fs = brouillon(lf);
    pour i dans 0..lf {
        @2[fs + 1 + i] = @2[synd + 2 + i];
    }
    pour k dans 0..@2[pos] {
        soit x = @2[EXPO + n - 1 - @2[pos + 1 + k]];
        pour j dans 0..lf - 1 {
            @2[fs + 1 + j] = gmul(@2[fs + 1 + j], x) ^ @2[fs + 2 + j];
        }
    }
    retour fs;
}

// le mot de code corrigé (2 erreurs + effacements <= r), ou 0 : au-delà de la capacité
fonction decoder(cw0, r, eff) {
    brouillon_repris();
    soit cw = p_copie(cw0);
    soit n = @2[cw];
    soit ne = @2[eff];
    si ne > r {
        retour 0;
    }
    pour i dans 0..ne {
        @2[cw + 1 + @2[eff + 1 + i]] = 0;
    }
    soit synd = syndromes(cw, r);
    si tous_nuls(synd) == 1 {
        retour cw;
    }
    soit fsynd = forney_syndromes(synd, eff, n);
    soit err_loc = trouver_localisateur(fsynd, r, ne);
    si err_loc == 0 {
        retour 0;
    }
    soit pos = trouver_erreurs(p_renverse(err_loc), n);
    si pos == 0 {
        retour 0;
    }
    soit toutes = brouillon(ne + @2[pos]);
    soit nt = 0;
    pour i2 dans 0..ne {
        @2[toutes + 1 + nt] = @2[eff + 1 + i2];
        nt = nt + 1;
    }
    pour i3 dans 0..@2[pos] {
        si dans_liste(eff, @2[pos + 1 + i3]) == 0 {
            @2[toutes + 1 + nt] = @2[pos + 1 + i3];
            nt = nt + 1;
        }
    }
    @2[toutes] = nt;
    soit out = corriger_valeurs(cw, synd, toutes);
    si out == 0 {
        retour 0;
    }
    si tous_nuls(syndromes(out, r)) == 0 {
        retour 0;
    }
    retour out;
}

// les quatre octets d'ombre d'une voie de n octets (TRAV, suivis de quatre zéros : la division par le générateur)
fonction coder_voie(n) {
    pour z dans 0..OMBRE {
        @2[TRAV + n + z] = 0;
    }
    soit g1 = @2[LGEN + 1];
    soit g2 = @2[LGEN + 2];
    soit g3 = @2[LGEN + 3];
    soit g4 = @2[LGEN + 4];
    pour i dans 0..n {
        soit c = @2[TRAV + i];
        si c != 0 {
            soit lc = @2[LOGA + c];
            @2[TRAV + i + 1] = @2[TRAV + i + 1] ^ @2[EXPO + lc + g1];
            @2[TRAV + i + 2] = @2[TRAV + i + 2] ^ @2[EXPO + lc + g2];
            @2[TRAV + i + 3] = @2[TRAV + i + 3] ^ @2[EXPO + lc + g3];
            @2[TRAV + i + 4] = @2[TRAV + i + 4] ^ @2[EXPO + lc + g4];
        }
    }
}

// l'ombre des m mots de la colonne lue (DH, DB) : quatre mots dans OC
fonction ombre_colonne(m) {
    pour z dans 0..2 * OMBRE {
        @2[OC + z] = 0;
    }
    pour k dans 0..16 {
        pour j dans 0..m {
            @2[TRAV + j] = octet(@2[DH + j], @2[DB + j], k);
        }
        coder_voie(m);
        pour z2 dans 0..OMBRE {
            soit o = @2[TRAV + m + z2];
            si k < 8 {
                @2[OC + 2 * z2] = @2[OC + 2 * z2] | (o << (8 * (7 - k)));
            } sinon {
                @2[OC + 2 * z2 + 1] = @2[OC + 2 * z2 + 1] | (o << (8 * (15 - k)));
            }
        }
    }
}

// α fois chacun des huit octets d'une moitié de mot, en une fois (GF(256), polynôme 0x11D) : les huit voies ensemble
fonction fois2(x) {
    retour ((x << 1) & 18374403900871474942) ^ (((x >> 7) & 72340172838076673) * 29);
}

// la colonne lue (DH, DB) et ses quatre mots d'ombre forment-ils un mot de code ? Les quatre syndromes (en 1, α, α², α³)
// des seize voies, calculés huit voies à la fois par moitié de mot : tous nuls si et seulement si l'ombre est celle
// que donnerait le codage (le code est systématique : pour des données, une seule ombre)
fonction ombre_saine(k, m) {
    soit a0 = 0;
    soit a1 = 0;
    soit a2 = 0;
    soit a3 = 0;
    soit b0 = 0;
    soit b1 = 0;
    soit b2 = 0;
    soit b3 = 0;
    pour j dans 0..m + OMBRE {
        soit h = 0;
        soit l = 0;
        si j < m {
            h = @2[DH + j];
            l = @2[DB + j];
        } sinon {
            h = @2[OMB + 8 * k + 2 * (j - m)];
            l = @2[OMB + 8 * k + 2 * (j - m) + 1];
        }
        a0 = a0 ^ h;
        a1 = fois2(a1) ^ h;
        a2 = fois2(fois2(a2)) ^ h;
        a3 = fois2(fois2(fois2(a3))) ^ h;
        b0 = b0 ^ l;
        b1 = fois2(b1) ^ l;
        b2 = fois2(fois2(b2)) ^ l;
        b3 = fois2(fois2(fois2(b3))) ^ l;
    }
    retour (a0 | a1 | a2 | a3 | b0 | b1 | b2 | b3) == 0;
}

// --------------------------------------------------------------------------------------------- la lecture
// répare la colonne k en place ; rend son état (le nombre de mots réparés dans COLR, les places désignées dans PARN)
fonction lire_colonne(k) {
    soit n = @2[G + G_N];
    soit nc = @2[G + G_NC];
    soit m = 0;
    soit i = k;
    tantque i < n {
        @2[DP + m] = i;
        @2[DH + m] = @2[MH + i];
        @2[DB + m] = @2[MB + i];
        m = m + 1;
        i = i + nc;
    }
    soit ne = 0;
    pour j dans 0..m {
        soit p = @2[DP + j];
        soit v = @2[NEU + p];
        si v != 256 && neutron(@2[DH + j], @2[DB + j]) != v {
            @2[EFF + 1 + ne] = j;
            ne = ne + 1;
            @2[PARN + p] = 1;
        }
    }
    @2[EFF] = ne;
    @2[COLR + k] = 0;
    soit pareille = 1;
    si ombre_saine(k, m) == 0 {
        // le chemin lent, rare : l'ombre recalculée voie par voie
        ombre_colonne(m);
        pour z dans 0..2 * OMBRE {
            si @2[OC + z] != @2[OMB + 8 * k + z] {
                pareille = 0;
            }
        }
    }
    si pareille == 1 {
        si ne == 0 {
            retour E_VRAI;
        }
        retour E_FAUX;
    }
    si ne > OMBRE {
        retour E_VARIABLE;
    }
    pour v2 dans 0..16 {
        soit base = VOIE + 256 * v2;
        @2[base] = m + OMBRE;
        pour j2 dans 0..m {
            @2[base + 1 + j2] = octet(@2[DH + j2], @2[DB + j2], v2);
        }
        pour z2 dans 0..OMBRE {
            @2[base + 1 + m + z2] = octet(@2[OMB + 8 * k + 2 * z2], @2[OMB + 8 * k + 2 * z2 + 1], v2);
        }
        soit out = decoder(base, OMBRE, EFF);
        si out == 0 {
            retour E_VARIABLE;
        }
        pour j3 dans 0..m + OMBRE {
            @2[base + 1 + j3] = @2[out + 1 + j3];
        }
    }
    soit rep = 0;
    pour j4 dans 0..m + OMBRE {
        soit h = 0;
        soit b = 0;
        pour v3 dans 0..16 {
            soit o = @2[VOIE + 256 * v3 + 1 + j4];
            si v3 < 8 {
                h = h | (o << (8 * (7 - v3)));
            } sinon {
                b = b | (o << (8 * (15 - v3)));
            }
        }
        si j4 < m {
            si h != @2[DH + j4] || b != @2[DB + j4] {
                rep = rep + 1;
            }
            @2[MH + @2[DP + j4]] = h;
            @2[MB + @2[DP + j4]] = b;
        } sinon {
            @2[OMB + 8 * k + 2 * (j4 - m)] = h;
            @2[OMB + 8 * k + 2 * (j4 - m) + 1] = b;
        }
    }
    @2[COLR + k] = rep;
    retour E_FAUX;
}

fonction rang(e) {
    si e == E_VRAI {
        retour 0;
    }
    si e == E_INCONNU {
        retour 1;
    }
    si e == E_FAUX {
        retour 2;
    }
    retour 3;
}

fonction pire(a, b) {
    si rang(a) >= rang(b) {
        retour a;
    }
    retour b;
}

fonction change(i) {
    retour @2[MH + i] != @2[AH + i] || @2[MB + i] != @2[AB + i];
}

// vérifie et répare l'ADN en place ; rend l'état le pire (chaque molécule a le sien, et ce qui a été fait)
fonction lire() {
    soit n = @2[G + G_N];
    soit nc = @2[G + G_NC];
    pour i dans 0..n {
        @2[AH + i] = @2[MH + i];
        @2[AB + i] = @2[MB + i];
        @2[PARN + i] = 0;
    }
    soit etat = E_VRAI;
    pour k dans 0..nc {
        soit e = lire_colonne(k);
        @2[COLE + k] = e;
        si e == E_FAUX {
            etat = E_FAUX;
        }
    }
    pour j dans 0..@2[G + G_NM] {
        soit base = MOL + 8 * j;
        soit d = @2[base];
        soit f = @2[base + 1];
        soit neutronee = @2[base + 2] == 1 || @2[base + 3] == 1;
        soit abimee = 0;
        soit haut = f;
        si d + nc < haut {
            haut = d + nc;
        }
        pour i2 dans d..haut {
            si @2[COLE + i2 % nc] == E_VARIABLE {
                abimee = 1;
            }
        }
        soit nch = 0;
        pour i3 dans d..f {
            si change(i3) {
                nch = nch + 1;
            }
        }
        soit sig_ok = signature(d, f) == @2[base + 4];
        soit e2 = E_VRAI;
        soit quoi = 0;
        si sig_ok && nch == 0 && abimee == 0 {
            e2 = E_VRAI;
        } sinon si sig_ok {
            e2 = E_FAUX;
            si nch == 0 {
                quoi = 1;
            } sinon {
                quoi = 2;
            }
        } sinon si abimee == 1 {
            e2 = E_VARIABLE;
            quoi = 3;
        } sinon si nch == 0 {
            // l'ombre et les neutrons s'accordent avec les mots : c'est la signature qui est abîmée (deux contre un)
            @2[base + 4] = signature(d, f);
            e2 = E_FAUX;
            quoi = 4;
        } sinon {
            // deux témoins contre un : les neutrons désignaient les mots réparés et les reconnaissent, ou l'ombre n'a
            // eu qu'un mot à réparer dans chaque colonne ; la signature, seule contre eux, est refaite
            soit par_neutrons = neutronee;
            soit un_par_colonne = 1;
            pour i4 dans d..f {
                si change(i4) {
                    si @2[PARN + i4] != 1 || @2[NEU + i4] != neutron(@2[MH + i4], @2[MB + i4]) {
                        par_neutrons = 0;
                    }
                    si @2[COLR + i4 % nc] != 1 {
                        un_par_colonne = 0;
                    }
                }
            }
            si par_neutrons || un_par_colonne == 1 {
                @2[base + 4] = signature(d, f);
                e2 = E_FAUX;
                quoi = 5;
            } sinon {
                // la réparation n'est pas confirmée : la molécule est gardée telle qu'elle a été lue
                pour i5 dans d..f {
                    @2[MH + i5] = @2[AH + i5];
                    @2[MB + i5] = @2[AB + i5];
                }
                e2 = E_VARIABLE;
                quoi = 6;
            }
        }
        @2[base + 5] = e2;
        @2[base + 6] = quoi;
        @2[base + 7] = nch;
        etat = pire(etat, e2);
    }
    si etat != E_VARIABLE {
        pour i6 dans 0..n {
            si @2[NEU + i6] != 256 {
                @2[NEU + i6] = neutron(@2[MH + i6], @2[MB + i6]);
            }
        }
    }
    retour etat;
}

fonction ecrire_etat(c, e) {
    si e == E_VRAI {
        ecrire_t(c, "vrai");
    } sinon si e == E_FAUX {
        ecrire_t(c, "faux (réparé)");
    } sinon si e == E_VARIABLE {
        ecrire_t(c, "variable");
    } sinon {
        ecrire_t(c, "inconnu");
    }
}

// le compte rendu, comme celui de Lugus : chaque molécule qui n'est pas vraie, puis l'état de l'ADN
fonction rendre_compte(etat) {
    pour j dans 0..@2[G + G_NM] {
        soit base = MOL + 8 * j;
        soit e = @2[base + 5];
        si e != E_VRAI {
            ecrire_t(1, "  m");
            ecrire_u64(1, @2[base]);
            ecrire_t(1, " : ");
            ecrire_etat(1, e);
            ecrire_t(1, ", ");
            soit q = @2[base + 6];
            si q == 1 {
                ecrire_t(1, "ombre ou neutrons refaits");
            } sinon si q == 2 {
                ecrire_u64(1, @2[base + 7]);
                ecrire_t(1, " mot(s) réparé(s)");
            } sinon si q == 3 {
                ecrire_t(1, "abîmée au-delà de son ombre");
            } sinon si q == 4 {
                ecrire_t(1, "signature refaite");
            } sinon si q == 5 {
                ecrire_u64(1, @2[base + 7]);
                ecrire_t(1, " mot(s) réparé(s), signature refaite");
            } sinon {
                ecrire_t(1, "réparation non confirmée par la signature");
            }
            ecrire_car(1, 10);
        }
    }
    si @2[G + G_ARN] == 1 {
        ecrire_t(1, "l'ARN : ");
    } sinon {
        ecrire_t(1, "l'ADN : ");
    }
    ecrire_etat(1, etat);
    ecrire_car(1, 10);
}

// l'ADN relu, écrit comme chimie/adn.py l'écrit (octet pour octet)
fonction ecrire_adn(chemin) {
    soit c = ouvrir_ecriture(chemin);
    // la version garde ses neutrons : un ADN lu en version 3 est réécrit en version 3
    si @2[G + G_VERSION] >= 4 {
        ecrire_t(c, "VTXADN04\nGU mots 1\n");
    } sinon {
        ecrire_t(c, "VTXADN03\nGU mots 1\n");
    }
    soit n = @2[G + G_N];
    pour i dans 0..n {
        si i > 0 {
            ecrire_car(c, ',');
        }
        ecrire_u128(c, @2[MH + i], @2[MB + i]);
    }
    ecrire_t(c, "\nAG\nGU molecules ");
    ecrire_u64(c, @2[G + G_NM]);
    ecrire_car(c, 10);
    pour j dans 0..@2[G + G_NM] {
        soit base = MOL + 8 * j;
        ecrire_car(c, 'm');
        ecrire_u64(c, @2[base]);
        ecrire_car(c, '|');
        ecrire_u64(c, @2[base]);
        ecrire_car(c, '|');
        ecrire_u64(c, @2[base + 1]);
        ecrire_car(c, '|');
        ecrire_u64(c, @2[base + 2]);
        ecrire_car(c, '|');
        ecrire_u64(c, @2[base + 4]);
        ecrire_car(c, '|');
        ecrire_u64(c, @2[base + 3]);
        ecrire_car(c, 10);
    }
    ecrire_t(c, "AG\nGU ombres ");
    ecrire_u64(c, @2[G + G_NO]);
    ecrire_car(c, 10);
    pour k dans 0..@2[G + G_NO] {
        pour z dans 0..OMBRE {
            si z > 0 {
                ecrire_car(c, ',');
            }
            ecrire_u128(c, @2[OMB + 8 * k + 2 * z], @2[OMB + 8 * k + 2 * z + 1]);
        }
        ecrire_car(c, 10);
    }
    ecrire_t(c, "AG\nGU neutrons 1\n");
    soit premier = 1;
    pour i2 dans 0..n {
        si @2[NEU + i2] != 256 {
            si premier == 0 {
                ecrire_car(c, ',');
            }
            premier = 0;
            ecrire_u64(c, i2);
            ecrire_car(c, ':');
            ecrire_u64(c, @2[NEU + i2]);
        }
    }
    ecrire_t(c, "\nAG\n");
    pour i3 dans 0..@2[G + G_NI] {
        ecrire_car(c, @2[INTR + i3]);
    }
    fermer(c);
}

// un chemin (ou un mot) lu dans les entrées : un caractère par entrée, terminé par 0 (ou par la fin des entrées) ; un
// texte de l'étage 2, ou 0 s'il est vide
fonction lire_chemin(place) {
    soit n = 0;
    soit x = entrée();
    tantque x != 0 && x < 1114112 {
        si n < 290 {
            @2[place + 1 + n] = x;
            n = n + 1;
        }
        x = entrée();
    }
    @2[place] = n;
    si n == 0 {
        retour 0;
    }
    retour ETAGE2 + place;
}

fonction finit_par_texte(t, fin) {
    soit n = longueur(t);
    soit m = longueur(fin);
    si m > n {
        retour 0;
    }
    pour i dans 0..m {
        si car(t, n - m + i) != car(fin, i) {
            retour 0;
        }
    }
    retour 1;
}

// --------------------------------------------------------------------------------------------- ranger (0.6n)
// L'ADN d'un programme : ses mots (un fichier « a,b,c;\n », celui de lugus compiler), découpés en molécules, leurs
// trois témoins, et les introns : les isotopes lourds, le texte du programme, la signature du compilateur qui l'a
// compilé. Le même ADN que chimie/adn.py et vtx-rs/src/adn.rs, octet pour octet.

// les mots d'un fichier de mots (jusqu'au « ; »)
fonction lire_fichier_mots(chemin) {
    soit f = ouvrir_lecture(chemin);
    si f == 18446744073709551615 {
        refuser("le fichier des mots ne s'ouvre pas");
        retour;
    }
    @2[G + G_CANAL] = f;
    @2[G + G_COPIE] = 0;
    avancer();
    soit n = 0;
    tantque car_courant() != ';' && car_courant() != FIN && car_courant() != 10 && @2[G + G_ERR] == 0 {
        si n >= MAXMOTS {
            refuser("trop de mots pour ce lecteur (un million au plus)");
            fermer(f);
            retour;
        }
        soit l = lire_nombre();
        @2[MH + n] = @2[G + G_HAUT];
        @2[MB + n] = l;
        n = n + 1;
        si car_courant() == ',' {
            avancer();
        }
    }
    fermer(f);
    @2[G + G_N] = n;
}

// les demi-instructions qui sont des instructions (pas la constante d'un LDI ou d'un LDIH) : 1 dans AH + p
fonction marquer_instructions(n) {
    soit lit = 0;
    pour p dans 0..2 * n {
        soit h = @2[MB + p / 2];
        si p % 2 == 0 {
            h = @2[MH + p / 2];
        }
        si lit == 1 {
            @2[AH + p] = 0;
            lit = 0;
        } sinon {
            @2[AH + p] = 1;
            soit op = h >> 48;
            si op == 10 || op == 43 {
                lit = 1;
            }
        }
    }
}

fonction op_frontiere(op) {
    retour op == 33 || op == 36 || op == 42 || op == 57 || op == 82 || op == 83 || op == 85 || op == 94 || op == 95;
}

// les molécules : la tête, puis une par fonction (de la cible d'un CALL à la suivante) ; une frontière (O) si son code
// écrit en mémoire ou sort quelque chose. Les débuts sont marqués dans AB (les mots), les instructions dans AH (2n).
fonction decouper() {
    soit n = @2[G + G_N];
    marquer_instructions(n);
    pour i dans 0..n {
        @2[AB + i] = 0;
    }
    @2[AB] = 1;
    pour p dans 0..2 * n {
        si @2[AH + p] == 1 {
            soit h = @2[MB + p / 2];
            si p % 2 == 0 {
                h = @2[MH + p / 2];
            }
            si (h >> 48) == 51 {
                soit cible = (h & 4294967295) / 2;
                si cible < n {
                    @2[AB + cible] = 1;
                }
            }
        }
    }
    soit nm = 0;
    soit debut = 0;
    pour i2 dans 1..n + 1 {
        si i2 == n || @2[AB + i2] == 1 {
            soit base = MOL + 8 * nm;
            @2[base] = debut;
            @2[base + 1] = i2;
            soit fr = 0;
            pour q dans 2 * debut..2 * i2 {
                si @2[AH + q] == 1 {
                    soit hq = @2[MB + q / 2];
                    si q % 2 == 0 {
                        hq = @2[MH + q / 2];
                    }
                    si op_frontiere(hq >> 48) {
                        fr = 1;
                    }
                }
            }
            @2[base + 2] = fr;
            @2[base + 3] = 0;
            nm = nm + 1;
            debut = i2;
        }
    }
    @2[G + G_NM] = nm;
}

// une ligne de texte dans les introns
fonction intron_car(x) {
    soit ni = @2[G + G_NI];
    si ni < MAXINTR - INTR {
        @2[INTR + ni] = x;
        @2[G + G_NI] = ni + 1;
    } sinon {
        refuser("les introns sont trop longs pour ce lecteur");
    }
}

fonction intron_texte(t) {
    pour i dans 0..longueur(t) {
        intron_car(car(t, i));
    }
}

fonction intron_nombre(x) {
    si x >= 10 {
        intron_nombre(x / 10);
    }
    intron_car(48 + x % 10);
}

// les isotopes lourds (un fichier de lignes « nom|place », rangées par place) : chaque molécule où tombe une place
// est un isotope ; puis l'intron « isotopes », recopié tel quel
fonction lire_isotopes(chemin) {
    soit f = ouvrir_lecture(chemin);
    si f == 18446744073709551615 {
        retour;
    }
    // d'abord les lignes, comptées et gardées dans le brouillon (étage 2, BROUILLON)
    soit nl = 0;
    soit nc = 0;
    soit place = 0;
    soit dans_place = 0;
    tantque fin_de(f) == 0 {
        soit c = lire_car(f);
        si c == 13 {
            continuer;
        }
        si c == 10 {
            si nc > 0 {
                @2[BROUILLON + nc] = 10;
                nc = nc + 1;
                nl = nl + 1;
                pour j dans 0..@2[G + G_NM] {
                    si @2[MOL + 8 * j] <= place && place < @2[MOL + 8 * j + 1] {
                        @2[MOL + 8 * j + 3] = 1;
                    }
                }
            }
            place = 0;
            dans_place = 0;
        } sinon {
            @2[BROUILLON + nc] = c;
            nc = nc + 1;
            si c == '|' {
                dans_place = 1;
            } sinon si dans_place == 1 {
                place = place * 10 + (c - 48);
            }
        }
    }
    fermer(f);
    si nl == 0 {
        retour;
    }
    intron_texte("GU isotopes ");
    intron_nombre(nl);
    intron_car(10);
    pour k dans 0..nc {
        intron_car(@2[BROUILLON + k]);
    }
    intron_texte("AG\n");
}

// le texte du programme, dans l'intron « source » : ses lignes (\r\n devient \n), la dernière comprise même vide
fonction garder_source(chemin) {
    soit f = ouvrir_lecture(chemin);
    si f == 18446744073709551615 {
        refuser("le texte du programme ne s'ouvre pas");
        retour;
    }
    // compter les lignes d'abord : le nombre est dans l'en-tête
    soit nl = 1;
    tantque fin_de(f) == 0 {
        soit c = lire_car(f);
        si c == 10 {
            nl = nl + 1;
        }
    }
    fermer(f);
    intron_texte("GU source ");
    intron_nombre(nl);
    intron_car(10);
    soit f2 = ouvrir_lecture(chemin);
    soit prec = 0;
    soit a_prec = 0;
    tantque fin_de(f2) == 0 {
        soit c2 = lire_car(f2);
        si a_prec == 1 && !(prec == 13 && c2 == 10) {
            intron_car(prec);
        }
        prec = c2;
        a_prec = 1;
    }
    si a_prec == 1 {
        intron_car(prec);
    }
    fermer(f2);
    intron_texte("\nAG\n");
}

// la signature du compilateur (un nombre écrit par Lugus) : l'intron « compilateur ». À la rétrotranscription, des
// mots qui ne reviennent pas sont un texte retouché si le compilateur est le même, et un inconnu s'il a changé.
fonction garder_compilateur(t) {
    si t == 0 {
        retour;
    }
    intron_texte("GU compilateur 1\n");
    intron_texte(t);
    intron_texte("\nAG\n");
}

// les témoins d'un brin qui n'a que ses mots (un fichier de mots, un hex, un cube, un ARN rapide) : les molécules
// découpées, les isotopes lourds s'il y en a, la signature de chaque molécule, les neutrons des frontières et des
// isotopes, l'ombre des colonnes
fonction faire_temoins(isotopes) {
    soit n = @2[G + G_N];
    decouper();
    si isotopes != 0 {
        lire_isotopes(isotopes);
    }
    pour i dans 0..n {
        @2[NEU + i] = 256;
    }
    pour j dans 0..@2[G + G_NM] {
        soit base = MOL + 8 * j;
        @2[base + 4] = signature(@2[base], @2[base + 1]);
        si @2[base + 2] == 1 || @2[base + 3] == 1 {
            pour i2 dans @2[base]..@2[base + 1] {
                @2[NEU + i2] = neutron(@2[MH + i2], @2[MB + i2]);
            }
        }
    }
    soit nc = nb_colonnes(n);
    @2[G + G_NC] = nc;
    @2[G + G_NO] = nc;
    pour k dans 0..nc {
        soit m = 0;
        soit p = k;
        tantque p < n {
            @2[DH + m] = @2[MH + p];
            @2[DB + m] = @2[MB + p];
            m = m + 1;
            p = p + nc;
        }
        ombre_colonne(m);
        pour z dans 0..2 * OMBRE {
            @2[OMB + 8 * k + z] = @2[OC + z];
        }
    }
}

fonction ranger(mots, adn, source, isotopes, compilateur, noms, ancien) {
    soit etat = charger(mots);
    si @2[G + G_ERR] != 0 {
        retour;
    }
    si etat == E_VARIABLE {
        ecrire_t(1, "rien n'est rangé : le brin est gardé tel qu'il a été lu, pour la preuve\n");
        @2[G + G_ERR] = 1;
        retour;
    }
    soit n = @2[G + G_N];
    si n == 0 {
        refuser("aucun mot à ranger");
        retour;
    }
    si @2[G + G_TEM] == 0 {
        // les mots seuls : l'ADN version 4 (un ARN rapide garde la version de son ADN)
        faire_temoins(isotopes);
    }
    soit neutrones = 0;
    pour i dans 0..n {
        si @2[NEU + i] != 256 {
            neutrones = neutrones + 1;
        }
    }
    soit nc = @2[G + G_NC];
    si source != 0 {
        garder_source(source);
    }
    garder_compilateur(compilateur);
    garder_carte(noms, ancien);
    si @2[G + G_ERR] != 0 {
        retour;
    }
    ecrire_adn(adn);
    // le compte rendu, comme Lugus : les témoins en mots (deux signatures par mot, l'ombre, seize neutrons par mot)
    soit nm = @2[G + G_NM];
    soit tm = (nm + 1) / 2 + OMBRE * nc + (neutrones + 15) / 16;
    ecrire_u64(1, n);
    ecrire_t(1, " mots, ");
    ecrire_u64(1, nm);
    ecrire_t(1, " molécules, témoins ");
    ecrire_u64(1, tm);
    ecrire_t(1, " mots (");
    soit pm = (tm * 1000 + n / 2) / n;
    ecrire_u64(1, pm / 10);
    ecrire_car(1, '.');
    ecrire_u64(1, pm % 10);
    ecrire_t(1, " %)");
    soit premier = 1;
    pour j2 dans 0..nm {
        si @2[MOL + 8 * j2 + 3] == 1 {
            si premier == 1 {
                ecrire_t(1, ", isotopes lourds : m");
                premier = 0;
            } sinon {
                ecrire_t(1, ", m");
            }
            ecrire_u64(1, @2[MOL + 8 * j2]);
        }
    }
    ecrire_t(1, " -> ");
    ecrire_t(1, adn);
    ecrire_car(1, 10);
    si @2[G + G_ARN] == 1 {
        ecrire_t(1, "l'ADNc : l'ARN rétrotranscrit, ses mots et ses témoins");
        si @2[G + G_TEM] == 0 {
            ecrire_t(1, " (refaits : l'isoforme n'en avait pas)");
        }
        si trouver_section("source") == 1 {
            ecrire_t(1, " ; l'ARNc portait le texte du programme : l'ADN est entier\n");
        } sinon {
            ecrire_t(1, " ; le texte du programme et le nom des isotopes, retirés à l'épissage, n'y sont pas\n");
        }
    }
}

// --------------------------------------------------------------------------------------------- transcrire (0.6n)
// l'ARN : les mots seuls (« a,b,c;\n »), ou, pour un fichier .arn ou une isoforme nommée, l'ARN avec sa coiffe (la
// signature des mots et l'isoforme : rapide, sur, memoire, complet), comme vtx-rs/src/adn.rs l'écrit
fonction ecrire_mots_seuls(chemin) {
    soit c = ouvrir_ecriture(chemin);
    pour i dans 0..@2[G + G_N] {
        si i > 0 {
            ecrire_car(c, ',');
        }
        ecrire_u128(c, @2[MH + i], @2[MB + i]);
    }
    ecrire_t(c, ";\n");
    fermer(c);
}

// la section « nom » des introns, recopiée telle quelle sur le canal c (rien si elle n'y est pas)
fonction recopier_section(c, nom) {
    soit ni = @2[G + G_NI];
    soit i = 0;
    tantque i < ni {
        // une section commence par « GU nom N\n » et finit par la ligne « AG\n »
        soit ok = 1;
        si @2[INTR + i] != 'G' || @2[INTR + i + 1] != 'U' || @2[INTR + i + 2] != ' ' {
            ok = 0;
        }
        si ok == 1 {
            pour k dans 0..longueur(nom) {
                si @2[INTR + i + 3 + k] != car(nom, k) {
                    ok = 0;
                }
            }
            si @2[INTR + i + 3 + longueur(nom)] != ' ' {
                ok = 0;
            }
        }
        // la fin de cette section : après la ligne « AG »
        soit j = i;
        soit fin = ni;
        soit debut_ligne = 1;
        tantque j < ni {
            si debut_ligne == 1 && j > i && @2[INTR + j] == 'A' && @2[INTR + j + 1] == 'G' && @2[INTR + j + 2] == 10 {
                fin = j + 3;
                j = ni;
            } sinon {
                debut_ligne = @2[INTR + j] == 10;
                j = j + 1;
            }
        }
        si ok == 1 {
            pour q dans i..fin {
                ecrire_car(c, @2[INTR + q]);
            }
            retour;
        }
        i = fin;
    }
}

fonction ecrire_arn(chemin, isoforme) {
    // l'ARNc (0.6o) : l'ARN sûr qui porte aussi tous les introns (le texte, les isotopes, le compilateur,
    // l'épigénome) : rétrotranscrit, il rend l'ADN entier
    soit arnc = texte_egal(isoforme, "arnc");
    soit sur = texte_egal(isoforme, "sur") || texte_egal(isoforme, "complet") || arnc;
    soit memoire = texte_egal(isoforme, "memoire") || texte_egal(isoforme, "complet");
    si !sur && !memoire && !texte_egal(isoforme, "rapide") {
        ecrire_t(1, "isoforme inconnue « ");
        ecrire_t(1, isoforme);
        ecrire_t(1, " » (rapide, sur, memoire, complet, arnc)\n");
        @2[G + G_ERR] = 1;
        retour;
    }
    soit c = ouvrir_ecriture(chemin);
    si @2[G + G_VERSION] >= 4 {
        ecrire_t(c, "VTXARN02\n");
    } sinon {
        ecrire_t(c, "VTXARN01\n");
    }
    ecrire_t(c, "GU coiffe 1\n");
    ecrire_u64(c, signature(0, @2[G + G_N]));
    ecrire_car(c, '|');
    ecrire_t(c, isoforme);
    ecrire_t(c, "\nAG\nGU mots 1\n");
    pour i dans 0..@2[G + G_N] {
        si i > 0 {
            ecrire_car(c, ',');
        }
        ecrire_u128(c, @2[MH + i], @2[MB + i]);
    }
    ecrire_t(c, "\nAG\n");
    si sur {
        ecrire_t(c, "GU molecules ");
        ecrire_u64(c, @2[G + G_NM]);
        ecrire_car(c, 10);
        pour j dans 0..@2[G + G_NM] {
            soit base = MOL + 8 * j;
            ecrire_car(c, 'm');
            ecrire_u64(c, @2[base]);
            ecrire_car(c, '|');
            ecrire_u64(c, @2[base]);
            ecrire_car(c, '|');
            ecrire_u64(c, @2[base + 1]);
            ecrire_car(c, '|');
            ecrire_u64(c, @2[base + 2]);
            ecrire_car(c, '|');
            ecrire_u64(c, @2[base + 4]);
            ecrire_car(c, '|');
            ecrire_u64(c, @2[base + 3]);
            ecrire_car(c, 10);
        }
        ecrire_t(c, "AG\nGU ombres ");
        ecrire_u64(c, @2[G + G_NO]);
        ecrire_car(c, 10);
        pour k dans 0..@2[G + G_NO] {
            pour z dans 0..OMBRE {
                si z > 0 {
                    ecrire_car(c, ',');
                }
                ecrire_u128(c, @2[OMB + 8 * k + 2 * z], @2[OMB + 8 * k + 2 * z + 1]);
            }
            ecrire_car(c, 10);
        }
        ecrire_t(c, "AG\nGU neutrons 1\n");
        soit premier = 1;
        pour i2 dans 0..@2[G + G_N] {
            si @2[NEU + i2] != 256 {
                si premier == 0 {
                    ecrire_car(c, ',');
                }
                premier = 0;
                ecrire_u64(c, i2);
                ecrire_car(c, ':');
                ecrire_u64(c, @2[NEU + i2]);
            }
        }
        ecrire_t(c, "\nAG\n");
    }
    si memoire {
        recopier_section(c, "epigenome");
    }
    si arnc {
        pour i9 dans 0..@2[G + G_NI] {
            ecrire_car(c, @2[INTR + i9]);
        }
    }
    fermer(c);
}

// rend l'état de l'ADN (comme le lecteur) ; l'ARN n'est écrit que d'un ADN vrai ou réparé
fonction transcrire(adn, sortie, isoforme) {
    lire_adn(adn);
    si @2[G + G_ERR] != 0 {
        retour E_INCONNU;
    }
    soit etat = lire();
    rendre_compte(etat);
    si etat == E_VARIABLE {
        ecrire_t(1, "rien n'est transcrit : l'ADN est gardé tel qu'il a été lu, pour la preuve\n");
        retour etat;
    }
    si etat == E_FAUX {
        ecrire_adn(adn);
        ecrire_t(1, "l'ADN réparé est réécrit\n");
    }
    si isoforme != 0 || finit_par_texte(sortie, ".arn") {
        soit iso = isoforme;
        si iso == 0 {
            iso = "rapide";
        }
        ecrire_arn(sortie, iso);
        si @2[G + G_ERR] == 0 {
            ecrire_t(1, "l'ARN, isoforme ");
            ecrire_t(1, iso);
            ecrire_t(1, " (avec sa coiffe) -> ");
            ecrire_t(1, sortie);
            ecrire_car(1, 10);
        }
    } sinon {
        ecrire_mots_seuls(sortie);
        ecrire_t(1, "l'ARN (les mots seuls, les témoins retirés) -> ");
        ecrire_t(1, sortie);
        ecrire_car(1, 10);
    }
    retour etat;
}

// --------------------------------------------------------------------------------------------- le chemin dans les deux sens (0.6n bis)
// Cube → Hex → ADN → ARN, et retour : ARN → ADN (la rétrotranscription, l'ADNc), ADN → Hex → Cube. Chaque station
// rend les mêmes mots. Le hex est l'écriture des mots à la main de l'homme : une ligne par mot, sa place dans le cube
// (#RRGGBB) et le mot, ses quatre voies (#RRRRRRRR_VVVVVVVV_BBBBBBBB_MMMMMMMM). Le cube est la mémoire elle-même : les
// mots rangés aux points du cube de l'étage 1, à une fréquence (440, le la du diapason, si rien n'est dit) ; la queue,
// au point blanc #FFFFFF, dit combien il y en a, la coiffe, au point #FFFFFE, les signe ; la machine l'écrit avec son
// anti-cube et son ombre (le miroir inversé), et le relit réparé s'il a été abîmé.

fonction chiffre_hex(c) {
    si c >= 48 && c <= 57 {
        retour c - 48;
    }
    si c >= 65 && c <= 70 {
        retour c - 55;
    }
    si c >= 97 && c <= 102 {
        retour c - 87;
    }
    retour 16;
}

// les k chiffres hexadécimaux de x, le plus fort d'abord
fonction ecrire_hex(c, x, k) {
    soit i = k;
    tantque i > 0 {
        i = i - 1;
        soit d = (x >> (4 * i)) & 15;
        si d < 10 {
            ecrire_car(c, 48 + d);
        } sinon {
            ecrire_car(c, 55 + d);
        }
    }
}

fonction ecrire_hex_fichier(chemin) {
    soit n = @2[G + G_N];
    soit c = ouvrir_ecriture(chemin);
    si c == 18446744073709551615 {
        refuser("le hex ne s'écrit pas");
        retour;
    }
    ecrire_t(c, "VTXHEX01 ");
    ecrire_u64(c, n);
    ecrire_car(c, ' ');
    ecrire_u64(c, signature(0, n));
    ecrire_car(c, 10);
    pour i dans 0..n {
        ecrire_car(c, '#');
        ecrire_hex(c, i, 6);
        ecrire_t(c, " #");
        soit h = @2[MH + i];
        soit b = @2[MB + i];
        ecrire_hex(c, h >> 32, 8);
        ecrire_car(c, '_');
        ecrire_hex(c, h & 4294967295, 8);
        ecrire_car(c, '_');
        ecrire_hex(c, b >> 32, 8);
        ecrire_car(c, '_');
        ecrire_hex(c, b & 4294967295, 8);
        ecrire_car(c, 10);
    }
    fermer(c);
    ecrire_t(1, "le hex : ");
    ecrire_u64(1, n);
    ecrire_t(1, " mots, chacun à sa place du cube -> ");
    ecrire_t(1, chemin);
    ecrire_car(1, 10);
}

// la fin d'une ligne : sautée jusqu'au \n compris
fonction sauter_ligne() {
    tantque car_courant() != 10 && car_courant() != FIN {
        avancer();
    }
    si car_courant() == 10 {
        avancer();
    }
}

// le hex : « VTXHEX01 N SIGNATURE », puis une ligne par mot ; les lignes vides et celles qui commencent par « // »
// sont sautées, les « _ » d'un mot sont libres ; les places doivent se suivre (#000000, #000001…)
fonction lire_hex(chemin) {
    soit f = ouvrir_lecture(chemin);
    si f == 18446744073709551615 {
        refuser("le hex ne s'ouvre pas");
        retour;
    }
    @2[G + G_CANAL] = f;
    @2[G + G_COPIE] = 0;
    avancer();
    soit tete = "VTXHEX01 ";
    pour i dans 0..longueur(tete) {
        si car_courant() != car(tete, i) {
            refuser("ce n'est pas un hex de vtx (VTXHEX01)");
            fermer(f);
            retour;
        }
        avancer();
    }
    soit annonce = lire_nombre();
    attendre(' ');
    soit sig = lire_nombre();
    attendre(10);
    soit n = 0;
    tantque car_courant() != FIN && @2[G + G_ERR] == 0 {
        soit c = car_courant();
        si c == 10 || c == 32 {
            avancer();
        } sinon si c == '/' {
            sauter_ligne();
        } sinon {
            attendre('#');
            soit place = 0;
            pour k dans 0..6 {
                soit d = chiffre_hex(car_courant());
                si d > 15 {
                    refuser("une place du cube (#RRGGBB) est attendue");
                }
                place = (place << 4) | d;
                avancer();
            }
            si @2[G + G_ERR] == 0 && place != n {
                refuser("les places ne se suivent pas (chaque mot à la sienne, depuis #000000)");
            }
            attendre(' ');
            attendre('#');
            soit h = 0;
            soit b = 0;
            soit nd = 0;
            tantque nd < 32 && @2[G + G_ERR] == 0 {
                soit c2 = car_courant();
                si c2 == '_' {
                    avancer();
                } sinon {
                    soit d2 = chiffre_hex(c2);
                    si d2 > 15 {
                        refuser("un mot a 32 chiffres hexadécimaux");
                    } sinon {
                        si nd < 16 {
                            h = (h << 4) | d2;
                        } sinon {
                            b = (b << 4) | d2;
                        }
                        nd = nd + 1;
                        avancer();
                    }
                }
            }
            si @2[G + G_ERR] == 0 {
                si n >= MAXMOTS {
                    refuser("trop de mots pour ce lecteur (un million au plus)");
                } sinon {
                    @2[MH + n] = h;
                    @2[MB + n] = b;
                    n = n + 1;
                }
            }
            tantque car_courant() == 32 {
                avancer();
            }
            si car_courant() != FIN {
                attendre(10);
            }
        }
    }
    fermer(f);
    @2[G + G_N] = n;
    si @2[G + G_ERR] != 0 {
        retour;
    }
    si n != annonce {
        refuser("le hex annonce un autre nombre de mots : il est tronqué ou mal recopié");
        retour;
    }
    si signature(0, n) != sig {
        ecrire_t(1, "le hex a été retouché depuis qu'il a été écrit (sa signature ne reconnaît plus ses mots) : ses mots sont pris tels qu'ils sont écrits\n");
    }
}

// un nombre écrit dans un texte, à partir de la place i ; rend 4294967295 s'il n'y a pas de chiffre
fonction nombre_dans(t, i) {
    si i >= longueur(t) || car(t, i) < 48 || car(t, i) > 57 {
        retour 4294967295;
    }
    soit x = 0;
    soit j = i;
    tantque j < longueur(t) && car(t, j) >= 48 && car(t, j) <= 57 {
        x = x * 10 + car(t, j) - 48;
        j = j + 1;
    }
    @2[G + G_SFIN] = j;
    retour x;
}

// le cube nommé « cube128-ÉTAGE-FRÉQUENCE.cub » : l'étage dans G_SDEB, la fréquence rendue (4294967295 : pas ce nom)
fonction cube_du_nom(chemin) {
    soit n = longueur(chemin);
    soit d = 0;
    pour i dans 0..n {
        si car(chemin, i) == '/' || car(chemin, i) == 92 {
            d = i + 1;
        }
    }
    soit tete = "cube128-";
    pour k dans 0..longueur(tete) {
        si d + k >= n || car(chemin, d + k) != car(tete, k) {
            retour 4294967295;
        }
    }
    soit e = nombre_dans(chemin, d + 8);
    si e == 4294967295 || e < 1 || e > 3 {
        retour 4294967295;
    }
    soit j = @2[G + G_SFIN];
    si j >= n || car(chemin, j) != '-' {
        retour 4294967295;
    }
    soit fr = nombre_dans(chemin, j + 1);
    @2[G + G_SDEB] = e;
    retour fr;
}

// lire un cube : les pages viennent du disque à la demande (la machine accorde le cube, son anti-cube et son ombre) ;
// rend l'état : celui du disque (vrai, faux : réparé), variable si les copies se contredisent ou si la coiffe ne
// reconnaît pas les mots
fonction lire_cube(chemin) {
    soit fr = cube_du_nom(chemin);
    si fr == 4294967295 {
        refuser("un cube se nomme cube128-ÉTAGE-FRÉQUENCE.cub");
        retour E_INCONNU;
    }
    soit e = @2[G + G_SDEB];
    soit tout = etat_disque();
    soit n = @[cube_adresse(e, fr, 16777215)];
    soit sig = @[cube_adresse(e, fr, 16777214)];
    si n == 0 || n > MAXMOTS {
        refuser("le cube ne porte pas de programme (sa queue, au point #FFFFFF, est vide)");
        retour E_INCONNU;
    }
    pour k dans 0..n {
        soit w: entier_128 = @[cube_adresse(e, fr, k)];
        @2[MH + k] = haut(w);
        @2[MB + k] = bas(w);
    }
    @2[G + G_N] = n;
    soit d = etat_disque();
    soit etat = E_VRAI;
    selon d {
        vrai {
            etat = E_VRAI;
        }
        faux {
            ecrire_t(1, "le cube a été réparé par son anti-cube et son ombre (ses fichiers sont réécrits)\n");
            etat = E_FAUX;
        }
        variable {
            ecrire_t(1, "les copies du cube se contredisent, au-delà de son ombre\n");
            etat = E_VARIABLE;
        }
        inconnu {
            etat = E_VRAI;
        }
    }
    si etat != E_VARIABLE && signature(0, n) != sig {
        ecrire_t(1, "la coiffe du cube (au point #FFFFFE) ne reconnaît pas ses mots\n");
        etat = E_VARIABLE;
    }
    ecrire_t(1, "le cube : ");
    ecrire_etat(1, etat);
    ecrire_car(1, 10);
    retour etat;
}

fonction ecrire_cube(fr) {
    soit n = @2[G + G_N];
    si n > 16777214 {
        refuser("trop de mots pour un cube");
        retour;
    }
    // le cube est d'abord vidé (sans relire le disque), puis chaque mot va à sa place
    jeter_cube(1, fr);
    pour k dans 0..n {
        @[cube_adresse(1, fr, k)] = entier_128_de(@2[MH + k], @2[MB + k]);
    }
    @[cube_adresse(1, fr, 16777214)] = signature(0, n);
    @[cube_adresse(1, fr, 16777215)] = n;
    soit pages = ranger_cube(1, fr);
    si pages == 18446744073709551615 {
        refuser("le cube ne s'écrit pas");
        retour;
    }
    ecrire_t(1, "le cube : ");
    ecrire_u64(1, n);
    ecrire_t(1, " mots aux points #000000 à #");
    ecrire_hex(1, n - 1, 6);
    ecrire_t(1, " de l'étage 1, la coiffe en #FFFFFE, la queue en #FFFFFF, ");
    ecrire_u64(1, pages);
    ecrire_t(1, " page(s) -> cube128-1-");
    ecrire_u64(1, fr);
    ecrire_t(1, ".cub, avec son anti-cube et son ombre\n");
}

// un brin, quel qu'il soit (selon son nom) : des mots (.mots), un hex, un cube, un ARN, un ADN ; rend son état (un
// ADN, un ARN sûr ou un cube : vérifié, réparé s'il le faut ; des mots seuls : vrai, rien ne les vérifie)
fonction charger(chemin) {
    @2[G + G_NI] = 0;
    @2[G + G_TEM] = 0;
    @2[G + G_ARN] = 0;
    @2[G + G_VERSION] = 4;
    si chemin == 0 {
        refuser("aucun brin n'est nommé");
        retour E_INCONNU;
    }
    si finit_par_texte(chemin, ".adn") || finit_par_texte(chemin, ".arn") {
        lire_adn(chemin);
        si @2[G + G_ERR] != 0 {
            retour E_INCONNU;
        }
        si @2[G + G_TEM] == 0 {
            // un ARN sans témoins : sa coiffe seule dit si ses mots sont les siens
            si signature(0, @2[G + G_N]) != @2[G + G_COIFFE] {
                ecrire_t(1, "la coiffe ne reconnaît pas les mots : l'ARN est dégradé, et sans témoins rien ne le répare\n");
                retour E_VARIABLE;
            }
            ecrire_t(1, "l'ARN : vrai (sa coiffe reconnaît ses mots)\n");
            retour E_VRAI;
        }
        soit etat = lire();
        si @2[G + G_ARN] == 1 && etat != E_VARIABLE && signature(0, @2[G + G_N]) != @2[G + G_COIFFE] {
            // les trois témoins reconnaissent les mots, la coiffe seule non : c'est elle qui est abîmée
            ecrire_t(1, "  la coiffe : faux (réparé), les témoins reconnaissent les mots, elle est refaite\n");
            etat = pire(etat, E_FAUX);
        }
        rendre_compte(etat);
        retour etat;
    }
    preparer_neutrons();
    si finit_par_texte(chemin, ".hex") {
        lire_hex(chemin);
        retour E_VRAI;
    }
    si finit_par_texte(chemin, ".cub") {
        retour lire_cube(chemin);
    }
    lire_fichier_mots(chemin);
    retour E_VRAI;
}

// --------------------------------------------------------------------------------------------- le texte gardé (0.6n bis)
// La vérification du texte, en vtx : le texte gardé dans l'ADN est donné au compilateur de vtx (vtxc128, en vtx lui
// aussi, sur une machine fille : service 27), et ses mots sont comparés à ceux de l'ADN, un pour un.

// la section « nom » des introns : le début de ses lignes dans G_SDEB, leur fin (sans le dernier \n) dans G_SFIN ;
// rend 1 si elle y est. Les lignes sont comptées par l'en-tête (une ligne du texte peut être « AG »)
fonction trouver_section(nom) {
    soit ni = @2[G + G_NI];
    soit i = 0;
    tantque i < ni {
        soit ok = 1;
        si @2[INTR + i] != 'G' || @2[INTR + i + 1] != 'U' || @2[INTR + i + 2] != ' ' {
            retour 0;
        }
        pour k dans 0..longueur(nom) {
            si @2[INTR + i + 3 + k] != car(nom, k) {
                ok = 0;
            }
        }
        soit j = i + 3;
        tantque j < ni && @2[INTR + j] != ' ' {
            j = j + 1;
        }
        si j - i - 3 != longueur(nom) {
            ok = 0;
        }
        soit nl = 0;
        j = j + 1;
        tantque j < ni && @2[INTR + j] >= 48 && @2[INTR + j] <= 57 {
            nl = nl * 10 + @2[INTR + j] - 48;
            j = j + 1;
        }
        j = j + 1;
        soit debut = j;
        soit vues = 0;
        tantque vues < nl && j < ni {
            si @2[INTR + j] == 10 {
                vues = vues + 1;
            }
            j = j + 1;
        }
        si ok == 1 {
            @2[G + G_SDEB] = debut;
            si j > debut {
                @2[G + G_SFIN] = j - 1;
            } sinon {
                @2[G + G_SFIN] = debut;
            }
            retour 1;
        }
        // « AG\n »
        i = j + 3;
    }
    retour 0;
}

// la carte gardée, refaite des mots, du texte et des noms que vient de donner le compilateur : la même ?
fonction verifier_carte() {
    si trouver_section("faces") == 0 {
        si trouver_section("carte") == 1 {
            ecrire_t(1, "la carte : inconnu, elle a quatre faces (rangée en 0.6p) : rangez de nouveau pour les six\n");
        } sinon {
            ecrire_t(1, "la carte : inconnu, cet ADN n'a pas de carte (rangé avant la 0.6p)\n");
        }
        retour;
    }
    soit d = @2[G + G_SDEB];
    soit l = @2[G + G_SFIN] - d;
    // l'histoire ne se vérifie pas (elle n'est ni dans le texte ni dans les mots) : elle est recopiée
    anciens_lignes(INTR + d, INTR + d + l + 1);
    @2[G + G_HCOPIE] = 1;
    faire_carte(1);
    @2[G + G_HCOPIE] = 0;
    trouver_section("faces");
    soit cl = @2[G + G_CL];
    soit ligne = 0;
    soit ecart = 4294967295;
    pour i dans 0..l {
        si ecart == 4294967295 && (i >= cl || @2[CARTEB + i] != @2[INTR + d + i]) {
            ecart = ligne;
        }
        si @2[INTR + d + i] == 10 {
            ligne = ligne + 1;
        }
    }
    si ecart == 4294967295 && cl != l + 1 {
        ecart = ligne;
    }
    si ecart == 4294967295 {
        ecrire_t(1, "la carte : vrai, elle dit ce que disent le texte et les mots\n");
    } sinon {
        ecrire_t(1, "la carte : faux, elle ne dit plus ce que disent le texte et les mots (dès la molécule m");
        si ecart < @2[G + G_NM] {
            ecrire_u64(1, @2[MOL + 8 * ecart]);
        }
        ecrire_t(1, ")\n");
    }
}

fonction verifier_texte(comp_actuel) {
    si trouver_section("source") == 0 {
        retour;
    }
    soit d = @2[G + G_SDEB];
    soit l = @2[G + G_SFIN] - d;
    @2[TEXTE] = l;
    pour q dans 0..l {
        @2[TEXTE + 1 + q] = @2[INTR + d + q];
    }
    soit a_comp = trouver_section("compilateur");
    soit change = 0;
    si a_comp == 1 && comp_actuel != 0 {
        soit dc = @2[G + G_SDEB];
        soit lc = @2[G + G_SFIN] - dc;
        si lc != longueur(comp_actuel) {
            change = 1;
        } sinon {
            pour k dans 0..lc {
                si @2[INTR + dc + k] != car(comp_actuel, k) {
                    change = 1;
                }
            }
        }
    }
    soit f = __service(27, ETAGE2 + TEXTE);
    si f == 18446744073709551615 {
        ecrire_t(1, "le texte : inconnu, cette machine n'a pas de compilateur pour le lecteur\n");
        retour;
    }
    @2[G + G_CANAL] = f;
    @2[G + G_COPIE] = 0;
    avancer();
    si car_courant() == '!' {
        si change == 1 {
            ecrire_t(1, "le texte : inconnu, le compilateur a changé depuis le rangement : le texte ne peut pas être vérifié\n");
        } sinon {
            ecrire_t(1, "le texte : faux, le texte gardé ne compile plus : ");
            avancer();
            tantque car_courant() != FIN {
                ecrire_car(1, car_courant());
                avancer();
            }
            ecrire_car(1, 10);
        }
        fermer(f);
        retour;
    }
    soit n = @2[G + G_N];
    soit k2 = 0;
    soit ecarts = 0;
    tantque car_courant() != ';' && car_courant() != FIN {
        soit b = lire_nombre();
        soit h = @2[G + G_HAUT];
        si k2 >= n || h != @2[MH + k2] || b != @2[MB + k2] {
            ecarts = ecarts + 1;
        }
        k2 = k2 + 1;
        si car_courant() == ',' {
            avancer();
        }
    }
    // 0.6p : après les mots, les noms des fonctions, pour refaire la carte
    si car_courant() == ';' {
        avancer();
    }
    si car_courant() == 10 {
        avancer();
    }
    @2[G + G_NN] = 0;
    @2[NDEB] = 0;
    @2[NLEN] = 0;
    soit place = 0;
    soit barre = 0;
    tantque car_courant() != FIN {
        soit cc = car_courant();
        si cc == 10 {
            noms_finir(place, barre);
            place = 0;
            barre = 0;
        } sinon si cc != 13 {
            si barre == 1 {
                place = place * 10 + (cc - 48);
            } sinon si cc == '|' {
                barre = 1;
            } sinon {
                noms_ajouter(cc);
            }
        }
        avancer();
    }
    noms_finir(place, barre);
    fermer(f);
    si k2 < n {
        ecarts = ecarts + n - k2;
    }
    si ecarts == 0 {
        ecrire_t(1, "le texte : vrai, le texte gardé redonne les mots, un pour un\n");
        verifier_carte();
    } sinon si change == 1 {
        ecrire_t(1, "le texte : inconnu, le compilateur a changé depuis le rangement : le texte ne peut pas être vérifié\n");
    } sinon {
        ecrire_t(1, "le texte : faux, le texte gardé ne redonne pas ces mots (");
        ecrire_u64(1, ecarts);
        ecrire_t(1, " écart(s))");
        si a_comp == 0 {
            ecrire_t(1, " ; cet ADN ne note pas son compilateur : il a pu changer depuis");
        }
        ecrire_car(1, 10);
    }
}

// --------------------------------------------------------------------------------------------- la carte (0.6p, 0.6q)
// Pour chaque molécule, une ligne, les six faces d'un dé en trois paires opposées : ce qu'elle est | ce qu'elle touche
// (0 rien, 1 lit la mémoire, 2 écrit la mémoire, 3 le monde ; elle-même, puis avec ses appels) ; ses racines (sa
// profondeur, qui l'appelle) | ses branches (ce qu'elle appelle) ; ses promesses (exige, garantit, les exemples, isotope
// lourd) | sa mémoire (son empreinte, son histoire d'un rangement à l'autre : ? n c iK). Le centre, son état de Belnap,
// se lit à chaque lecture du brin :
//   m<début>|nom|genre|L-E|mots|touche|avec ses appels|profondeur|appelle|appelée par|exige|garantit|exemples|lourd|
//   empreinte|histoire|en-tête
// Tirée des mots, du texte gardé et des noms que donne le compilateur ; chimie/adn.py l'écrit de même (faire_carte).

fonction bas_car(c) {
    si (c >= 65 && c <= 90) || (c >= 192 && c <= 222 && c != 215) {
        retour c + 32;
    }
    si c == 338 {
        retour 339;
    }
    si c == 376 {
        retour 255;
    }
    retour c;
}

fonction lettre_nom(c) {
    retour (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 || c >= 128;
}

fonction carte_car(x) {
    soit l = @2[G + G_CL];
    si l < CARTEL - CARTEB {
        @2[CARTEB + l] = x;
        @2[G + G_CL] = l + 1;
    }
}

fonction carte_texte(t) {
    pour i dans 0..longueur(t) {
        carte_car(car(t, i));
    }
}

fonction carte_nombre(x) {
    si x >= 10 {
        carte_nombre(x / 10);
    }
    carte_car(48 + x % 10);
}

// les noms des fonctions, « nom|mot » par ligne (code.carte du compilateur), mis en minuscules
fonction noms_ajouter(c) {
    soit k = @2[G + G_NN];
    soit d = @2[NDEB + k];
    soit l = @2[NLEN + k];
    si l < 1000000 {
        @2[NCAR + d + l] = bas_car(c);
        @2[NLEN + k] = l + 1;
    }
}

// une ligne « nom|place » lue (le nom déjà rangé) : elle compte
fonction noms_finir(place, vu_barre) {
    soit k = @2[G + G_NN];
    si vu_barre == 1 && @2[NLEN + k] > 0 && k < 199999 {
        @2[NPL + k] = place;
        @2[G + G_NN] = k + 1;
        @2[NDEB + k + 1] = @2[NDEB + k] + @2[NLEN + k];
    }
    @2[NLEN + @2[G + G_NN]] = 0;
}

fonction lire_noms(chemin) {
    @2[G + G_NN] = 0;
    @2[NDEB] = 0;
    @2[NLEN] = 0;
    soit f = ouvrir_lecture(chemin);
    si f == 18446744073709551615 {
        retour;
    }
    soit place = 0;
    soit barre = 0;
    tantque fin_de(f) == 0 {
        soit c = lire_car(f);
        si c == 13 {
            continuer;
        }
        si c == 10 {
            noms_finir(place, barre);
            place = 0;
            barre = 0;
        } sinon si barre == 1 {
            place = place * 10 + (c - 48);
        } sinon si c == '|' {
            barre = 1;
        } sinon {
            noms_ajouter(c);
        }
    }
    noms_finir(place, barre);
    fermer(f);
}

// le nom donné pour la place p : son rang, ou 4294967295
fonction nom_de_place(p) {
    pour k dans 0..@2[G + G_NN] {
        si @2[NPL + k] == p {
            retour k;
        }
    }
    retour 4294967295;
}

// le rang de la molécule qui commence à d (les débuts sont croissants), ou 4294967295
fonction molecule_de(d) {
    soit a = 0;
    soit b = @2[G + G_NM];
    tantque a < b {
        soit m = (a + b) / 2;
        soit x = @2[MOL + 8 * m];
        si x == d {
            retour m;
        }
        si x < d {
            a = m + 1;
        } sinon {
            b = m;
        }
    }
    retour 4294967295;
}

fonction demi(p) {
    si p % 2 == 0 {
        retour @2[MH + p / 2];
    }
    retour @2[MB + p / 2];
}

fonction niveau_service(code, su) {
    si su == 0 {
        retour 3;
    }
    si code == 10 || code == 13 || code == 26 {
        retour 2;
    }
    si code == 25 {
        retour 1;
    }
    retour 3;
}

// ce que touche la molécule k elle-même (TOUD), ses appels (triés, sans double : CAD, CAN) ; la propagation des
// constantes ne sert qu'à reconnaître le numéro d'un service (SYS)
fonction toucher(k, ncalls) {
    soit a = @2[MOL + 8 * k];
    soit b = @2[MOL + 8 * k + 1];
    soit n2 = 2 * @2[G + G_N];
    soit niveau = 0;
    soit nt = 0;
    // les registres connus : @2[BROUILLON + r] (la valeur), @2[BROUILLON + 16 + r] (1 : connue) ; la pile ensuite
    pour r dans 0..32 {
        @2[BROUILLON + r] = 0;
    }
    soit sp = 0;
    pour p dans 2 * a..2 * b {
        si @2[AH + p] == 1 {
            soit h = demi(p);
            soit op = h >> 48;
            soit d = (h >> 44) & 15;
            soit s2 = (h >> 40) & 15;
            soit imm = h & 4294967295;
            si op == 32 || op == 41 || op == 84 || op == 56 || op == 95 {
                si niveau < 1 {
                    niveau = 1;
                }
            } sinon si op == 33 || op == 42 || op == 85 || op == 57 || op == 94 {
                si niveau < 2 {
                    niveau = 2;
                }
            } sinon si op == 36 || op == 82 || op == 35 || op == 81 {
                niveau = 3;
            }
            si op == 24 {
                si (imm >> 31) == 1 {
                    @2[BROUILLON + d] = imm | 18446744069414584320;
                } sinon {
                    @2[BROUILLON + d] = imm;
                }
                @2[BROUILLON + 16 + d] = 1;
            } sinon si op == 25 {
                @2[BROUILLON + d] = imm;
                @2[BROUILLON + 16 + d] = 1;
            } sinon si op == 10 {
                si p + 1 < n2 {
                    @2[BROUILLON + d] = demi(p + 1);
                    @2[BROUILLON + 16 + d] = 1;
                } sinon {
                    @2[BROUILLON + 16 + d] = 0;
                }
            } sinon si op == 11 {
                @2[BROUILLON + d] = @2[BROUILLON + s2];
                @2[BROUILLON + 16 + d] = @2[BROUILLON + 16 + s2];
            } sinon si op == 39 {
                @2[BROUILLON + 32 + 2 * sp] = @2[BROUILLON + s2];
                @2[BROUILLON + 33 + 2 * sp] = @2[BROUILLON + 16 + s2];
                si sp < 1000 {
                    sp = sp + 1;
                }
            } sinon si op == 40 {
                si sp > 0 {
                    sp = sp - 1;
                    @2[BROUILLON + d] = @2[BROUILLON + 32 + 2 * sp];
                    @2[BROUILLON + 16 + d] = @2[BROUILLON + 33 + 2 * sp];
                } sinon {
                    @2[BROUILLON + 16 + d] = 0;
                }
            } sinon si op == 83 {
                soit nv = niveau_service(@2[BROUILLON + s2], @2[BROUILLON + 16 + s2]);
                si nv > niveau {
                    niveau = nv;
                }
                @2[BROUILLON + 16 + d] = 0;
            } sinon si op == 51 {
                soit cible = imm / 2;
                si molecule_de(cible) != 4294967295 {
                    @2[CTMP + nt] = cible;
                    nt = nt + 1;
                }
                pour r2 dans 0..16 {
                    @2[BROUILLON + 16 + r2] = 0;
                }
            } sinon {
                @2[BROUILLON + 16 + d] = 0;
            }
        }
    }
    // trier les appels, sans double
    pour i dans 1..nt {
        soit x = @2[CTMP + i];
        soit j = i;
        tantque j > 0 && @2[CTMP + j - 1] > x {
            @2[CTMP + j] = @2[CTMP + j - 1];
            j = j - 1;
        }
        @2[CTMP + j] = x;
    }
    @2[CAD + k] = ncalls;
    soit m = 0;
    pour i2 dans 0..nt {
        si i2 == 0 || @2[CTMP + i2] != @2[CTMP + i2 - 1] {
            @2[CALLS + ncalls + m] = @2[CTMP + i2];
            m = m + 1;
        }
    }
    @2[CAN + k] = m;
    @2[TOUD + k] = niveau;
    retour ncalls + m;
}

// le texte gardé, en lignes (LST : le début de chaque ligne dans INTR) ; 0 s'il n'y en a pas
fonction lignes_du_texte() {
    @2[G + G_NL] = 0;
    si trouver_section("source") == 0 {
        retour 0;
    }
    soit d = @2[G + G_SDEB];
    soit f = @2[G + G_SFIN];
    soit nl = 1;
    @2[LST] = d;
    pour i dans d..f {
        si @2[INTR + i] == 10 {
            @2[LST + nl] = i + 1;
            nl = nl + 1;
        }
    }
    @2[LST + nl] = f + 1;
    @2[G + G_NL] = nl;
    retour 1;
}

// la ligne i : son début, sa fin (sans le \n)
fonction ligne_deb(i) {
    retour @2[LST + i];
}

fonction ligne_fin(i) {
    retour @2[LST + i + 1] - 1;
}

fonction ligne_commence(i, t) {
    soit d = ligne_deb(i);
    si ligne_fin(i) - d < longueur(t) {
        retour 0;
    }
    pour k dans 0..longueur(t) {
        si @2[INTR + d + k] != car(t, k) {
            retour 0;
        }
    }
    retour 1;
}

fonction ligne_haute(i) {
    retour ligne_commence(i, "fonction ") || ligne_commence(i, "reaction ") || ligne_commence(i, "structure ")
        || ligne_commence(i, "constante ") || ligne_commence(i, "exemple ") || ligne_commence(i, "importer ");
}

// une ligne vide (espaces et tabulations) ou un commentaire en début de ligne
fonction ligne_vide_ou_note(i) {
    soit d = ligne_deb(i);
    soit f = ligne_fin(i);
    si f - d >= 2 && @2[INTR + d] == '/' && @2[INTR + d + 1] == '/' {
        retour 1;
    }
    pour k dans d..f {
        si @2[INTR + k] != 32 && @2[INTR + k] != 9 {
            retour 0;
        }
    }
    retour 1;
}

// le mot « mot » au début de la ligne i (après son retrait), suivi d'un espace, d'une parenthèse ou de rien
fonction ligne_mot(i, mot) {
    soit d = ligne_deb(i);
    soit f = ligne_fin(i);
    tantque d < f && (@2[INTR + d] == 32 || @2[INTR + d] == 9) {
        d = d + 1;
    }
    si f - d < longueur(mot) {
        retour 0;
    }
    pour k dans 0..longueur(mot) {
        si @2[INTR + d + k] != car(mot, k) {
            retour 0;
        }
    }
    soit e = d + longueur(mot);
    retour e == f || @2[INTR + e] == 32 || @2[INTR + e] == '(';
}

// les en-têtes des fonctions et réactions écrites : HDR + 16 k : le début et la longueur du nom (dans INTR), le genre
// (1 fonction, 2 réaction), la ligne, la dernière, exige, garantit, les exemples, le début et la longueur de l'en-tête
fonction lire_entetes() {
    @2[G + G_NH] = 0;
    soit nl = @2[G + G_NL];
    soit nh = 0;
    pour i dans 0..nl {
        soit genre = 0;
        soit lk = 0;
        si ligne_commence(i, "fonction ") {
            genre = 1;
            lk = 9;
        } sinon si ligne_commence(i, "reaction ") {
            genre = 2;
            lk = 9;
        }
        si genre == 0 {
            continuer;
        }
        soit d = ligne_deb(i) + lk;
        soit f = ligne_fin(i);
        soit par = d;
        tantque par < f && @2[INTR + par] != '(' {
            par = par + 1;
        }
        si par >= f {
            continuer;
        }
        soit nd = d;
        tantque nd < par && (@2[INTR + nd] == 32 || @2[INTR + nd] == 9) {
            nd = nd + 1;
        }
        soit nf = par;
        tantque nf > nd && (@2[INTR + nf - 1] == 32 || @2[INTR + nf - 1] == 9) {
            nf = nf - 1;
        }
        soit suivant = i + 1;
        tantque suivant < nl && ligne_haute(suivant) == 0 {
            suivant = suivant + 1;
        }
        soit fin = suivant - 1;
        tantque fin > i && ligne_vide_ou_note(fin) == 1 {
            fin = fin - 1;
        }
        soit ex = 0;
        soit ga = 0;
        pour j dans i..fin + 1 {
            si ligne_mot(j, "exige") {
                ex = ex + 1;
            } sinon si ligne_mot(j, "garantit") {
                ga = ga + 1;
            }
        }
        soit td = ligne_deb(i);
        soit tf = f;
        tantque tf > td && (@2[INTR + tf - 1] == 32 || @2[INTR + tf - 1] == 9) {
            tf = tf - 1;
        }
        si tf > td && @2[INTR + tf - 1] == '{' {
            tf = tf - 1;
            tantque tf > td && (@2[INTR + tf - 1] == 32 || @2[INTR + tf - 1] == 9) {
                tf = tf - 1;
            }
        }
        soit b = HDR + 16 * nh;
        @2[b] = nd;
        @2[b + 1] = nf - nd;
        @2[b + 2] = genre;
        @2[b + 3] = i + 1;
        @2[b + 4] = fin + 1;
        @2[b + 5] = ex;
        @2[b + 6] = ga;
        @2[b + 7] = 0;
        @2[b + 8] = td;
        @2[b + 9] = tf - td;
        si nh < 60000 {
            nh = nh + 1;
        }
    }
    @2[G + G_NH] = nh;
    // les exemples : une ligne « exemple … » compte une fois pour chaque nom écrit qu'elle appelle
    pour i2 dans 0..nl {
        si ligne_commence(i2, "exemple ") == 0 {
            continuer;
        }
        soit d2 = ligne_deb(i2);
        soit f2 = ligne_fin(i2);
        pour h dans 0..nh {
            soit b2 = HDR + 16 * h;
            soit ln = @2[b2 + 1];
            soit trouve = 0;
            soit j2 = d2;
            tantque trouve == 0 && j2 + ln < f2 {
                soit ok = 1;
                pour q dans 0..ln {
                    si @2[INTR + j2 + q] != @2[INTR + @2[b2] + q] {
                        ok = 0;
                    }
                }
                si ok == 1 && @2[INTR + j2 + ln] == '(' && (j2 == d2 || lettre_nom(@2[INTR + j2 - 1]) == 0) {
                    trouve = 1;
                }
                j2 = j2 + 1;
            }
            si trouve == 1 {
                @2[b2 + 7] = @2[b2 + 7] + 1;
            }
        }
    }
}

// l'en-tête dont le nom (en minuscules) est le nom donné k, ou 4294967295
fonction entete_du_nom(k) {
    soit ln = @2[NLEN + k];
    pour h dans 0..@2[G + G_NH] {
        soit b = HDR + 16 * h;
        si @2[b + 1] == ln {
            soit ok = 1;
            pour q dans 0..ln {
                si bas_car(@2[INTR + @2[b] + q]) != @2[NCAR + @2[NDEB + k] + q] {
                    ok = 0;
                }
            }
            si ok == 1 {
                retour h;
            }
        }
    }
    retour 4294967295;
}


// FNV-1a sur 64 bits, caractère par caractère
fonction fnv_lignes(a, b) {
    soit h = 14695981039346656037;
    pour i dans a..b + 1 {
        pour k dans ligne_deb(i)..ligne_fin(i) {
            h = (h ^ @2[INTR + k]) * 1099511628211;
        }
        h = (h ^ 10) * 1099511628211;
    }
    retour h;
}

// les faces d'avant, lues dans la mémoire [a, b) (des lignes de la carte) : leur clé, leur empreinte, leur histoire
fonction anciens_lignes(a, b) {
    soit n = 0;
    soit i = a;
    tantque i < b && n < 199999 {
        soit ls = i;
        soit barres = 0;
        @2[CTMP] = i;
        tantque i < b && @2[i] != 10 {
            si @2[i] == '|' && barres < 16 {
                barres = barres + 1;
                @2[CTMP + barres] = i + 1;
            }
            i = i + 1;
        }
        si barres >= 16 {
            soit f1 = @2[CTMP + 1];
            soit f2 = @2[CTMP + 2];
            soit f3 = @2[CTMP + 3];
            si f2 - f1 > 1 {
                @2[ANCK + n] = f1;
                @2[ANCKL + n] = f2 - f1 - 1;
            } sinon si f3 - f2 - 1 == 4 && @2[f2] == 't' && @2[f2 + 1] == 'e' && @2[f2 + 2] == 't' && @2[f2 + 3] == 'e' {
                @2[ANCK + n] = 0;
                @2[ANCKL + n] = 4294967294;
            } sinon {
                @2[ANCK + n] = ls;
                @2[ANCKL + n] = f1 - ls - 1;
            }
            soit e = 0;
            soit j = @2[CTMP + 14];
            tantque @2[j] >= 48 && @2[j] <= 57 {
                e = e * 10 + @2[j] - 48;
                j = j + 1;
            }
            @2[ANCE + n] = e;
            @2[ANCH + n] = @2[CTMP + 15];
            @2[ANCHL + n] = @2[CTMP + 16] - @2[CTMP + 15] - 1;
            n = n + 1;
        }
        i = i + 1;
    }
    @2[G + G_NA] = n;
}

// le brin rangé avant : ses faces (la section « faces »), s'il en a
fonction lire_anciens(chemin) {
    @2[G + G_NA] = 4294967295;
    si chemin == 0 {
        retour;
    }
    soit f = ouvrir_lecture(chemin);
    si f == 18446744073709551615 {
        retour;
    }
    soit n = 0;
    tantque fin_de(f) == 0 && n < 14000000 {
        @2[ANCT + n] = lire_car(f);
        n = n + 1;
    }
    fermer(f);
    soit tete = "GU faces ";
    soit i = 0;
    tantque i < n {
        soit ok = 1;
        pour k dans 0..longueur(tete) {
            si i + k >= n || @2[ANCT + i + k] != car(tete, k) {
                ok = 0;
            }
        }
        si ok == 1 {
            soit j = i + longueur(tete);
            soit nl = 0;
            tantque j < n && @2[ANCT + j] >= 48 && @2[ANCT + j] <= 57 {
                nl = nl * 10 + @2[ANCT + j] - 48;
                j = j + 1;
            }
            j = j + 1;
            soit d = j;
            soit vues = 0;
            tantque j < n && vues < nl {
                si @2[ANCT + j] == 10 {
                    vues = vues + 1;
                }
                j = j + 1;
            }
            anciens_lignes(ANCT + d, ANCT + j);
            retour;
        }
        // à la ligne suivante
        tantque i < n && @2[ANCT + i] != 10 {
            i = i + 1;
        }
        i = i + 1;
    }
}

// la ligne d'avant de même clé que celle qui s'écrit (CARTEB : la ligne commence en ls, le nom de f1 à f2 - 1, le
// genre est « tete » si tete == 1), ou 4294967295
fonction ancien_de(ls, f1, f2, tete) {
    soit na = @2[G + G_NA];
    pour k dans 0..na {
        soit a = @2[ANCK + k];
        soit l = @2[ANCKL + k];
        si f2 - f1 > 1 {
            si l == f2 - f1 - 1 {
                soit ok = 1;
                pour q dans 0..l {
                    si @2[a + q] != @2[CARTEB + f1 + q] {
                        ok = 0;
                    }
                }
                si ok == 1 {
                    retour k;
                }
            }
        } sinon si tete == 1 {
            si l == 4294967294 {
                retour k;
            }
        } sinon si l == f1 - ls - 1 {
            soit ok2 = 1;
            pour q2 dans 0..l {
                si @2[a + q2] != @2[CARTEB + ls + q2] {
                    ok2 = 0;
                }
            }
            si ok2 == 1 {
                retour k;
            }
        }
    }
    retour 4294967295;
}

// l'histoire : « ? » rien d'avant, « n » nouvelle, « c » changée, « iK » inchangée depuis K rangements
fonction carte_histoire(ls, f1, f2, tete, empreinte) {
    si @2[G + G_NA] == 4294967295 {
        carte_car('?');
        retour;
    }
    soit k = ancien_de(ls, f1, f2, tete);
    si k == 4294967295 {
        si @2[G + G_HCOPIE] == 1 {
            carte_car('?');
        } sinon {
            carte_car('n');
        }
        retour;
    }
    si @2[G + G_HCOPIE] == 1 {
        pour q dans 0..@2[ANCHL + k] {
            carte_car(@2[@2[ANCH + k] + q]);
        }
        retour;
    }
    si @2[ANCE + k] != empreinte {
        carte_car('c');
        retour;
    }
    soit h = @2[ANCH + k];
    si @2[ANCHL + k] >= 2 && @2[h] == 'i' {
        soit x = 0;
        pour q3 dans 1..@2[ANCHL + k] {
            x = x * 10 + @2[h + q3] - 48;
        }
        carte_car('i');
        carte_nombre(x + 1);
        retour;
    }
    carte_texte("i1");
}

// la carte, écrite dans CARTEB (une ligne par molécule) ; avec_noms : des noms ont été donnés
fonction faire_carte(avec_noms) {
    @2[G + G_CL] = 0;
    soit nm = @2[G + G_NM];
    marquer_instructions(@2[G + G_N]);
    soit nc = 0;
    pour k dans 0..nm {
        nc = toucher(k, nc);
        @2[TOUT + k] = @2[TOUD + k];
        @2[PROF + k] = 4294967295;
    }
    soit change = 1;
    tantque change == 1 {
        change = 0;
        pour k2 dans 0..nm {
            pour c dans 0..@2[CAN + k2] {
                soit m = molecule_de(@2[CALLS + @2[CAD + k2] + c]);
                si @2[TOUT + m] > @2[TOUT + k2] {
                    @2[TOUT + k2] = @2[TOUT + m];
                    change = 1;
                }
            }
        }
    }
    si nm > 0 {
        @2[PROF] = 0;
        @2[FILE] = 0;
        soit nf = 1;
        soit q2 = 0;
        tantque q2 < nf {
            soit k3 = @2[FILE + q2];
            pour c2 dans 0..@2[CAN + k3] {
                soit m2 = molecule_de(@2[CALLS + @2[CAD + k3] + c2]);
                si @2[PROF + m2] == 4294967295 {
                    @2[PROF + m2] = @2[PROF + k3] + 1;
                    @2[FILE + nf] = m2;
                    nf = nf + 1;
                }
            }
            q2 = q2 + 1;
        }
    }
    lignes_du_texte();
    lire_entetes();
    pour k4 dans 0..nm {
        soit base = MOL + 8 * k4;
        soit deb = @2[base];
        soit ls = @2[G + G_CL];
        carte_car('m');
        carte_nombre(deb);
        carte_car('|');
        soit f1 = @2[G + G_CL];
        soit kn = 4294967295;
        si deb != 0 && avec_noms == 1 {
            kn = nom_de_place(deb);
        }
        soit h = 4294967295;
        si kn != 4294967295 {
            h = entete_du_nom(kn);
        }
        soit empreinte = @2[base + 1] - deb;
        si h != 4294967295 {
            soit bh = HDR + 16 * h;
            pour q3 dans 0..@2[bh + 1] {
                carte_car(@2[INTR + @2[bh] + q3]);
            }
            empreinte = fnv_lignes(@2[bh + 3] - 1, @2[bh + 4] - 1);
        } sinon si kn != 4294967295 {
            pour q4 dans 0..@2[NLEN + kn] {
                carte_car(@2[NCAR + @2[NDEB + kn] + q4]);
            }
        }
        soit f2 = @2[G + G_CL] + 1;
        soit tete = 0;
        si h != 4294967295 {
            si @2[HDR + 16 * h + 2] == 1 {
                carte_texte("|fonction|");
            } sinon {
                carte_texte("|reaction|");
            }
            carte_nombre(@2[HDR + 16 * h + 3]);
            carte_car('-');
            carte_nombre(@2[HDR + 16 * h + 4]);
        } sinon si kn != 4294967295 {
            carte_texte("|empruntee|0-0");
        } sinon si deb == 0 {
            carte_texte("|tete|0-0");
            tete = 1;
        } sinon {
            carte_texte("|inconnue|0-0");
        }
        carte_car('|');
        carte_nombre(@2[base + 1] - deb);
        carte_car('|');
        carte_nombre(@2[TOUD + k4]);
        carte_car('|');
        carte_nombre(@2[TOUT + k4]);
        carte_car('|');
        si @2[PROF + k4] == 4294967295 {
            carte_car('-');
        } sinon {
            carte_nombre(@2[PROF + k4]);
        }
        carte_car('|');
        pour c3 dans 0..@2[CAN + k4] {
            si c3 > 0 {
                carte_car(',');
            }
            carte_nombre(@2[CALLS + @2[CAD + k4] + c3]);
        }
        carte_car('|');
        // qui l'appelle (les débuts croissants : les molécules sont dans l'ordre), sans elle-même
        soit premier = 1;
        pour j dans 0..nm {
            si j != k4 {
                soit vu = 0;
                pour c4 dans 0..@2[CAN + j] {
                    si @2[CALLS + @2[CAD + j] + c4] == deb {
                        vu = 1;
                    }
                }
                si vu == 1 {
                    si premier == 0 {
                        carte_car(',');
                    }
                    carte_nombre(@2[MOL + 8 * j]);
                    premier = 0;
                }
            }
        }
        carte_car('|');
        si h != 4294967295 {
            soit bh2 = HDR + 16 * h;
            carte_nombre(@2[bh2 + 5]);
            carte_car('|');
            carte_nombre(@2[bh2 + 6]);
            carte_car('|');
            carte_nombre(@2[bh2 + 7]);
        } sinon {
            carte_texte("0|0|0");
        }
        carte_car('|');
        carte_nombre(@2[base + 3]);
        carte_car('|');
        carte_nombre(empreinte);
        carte_car('|');
        carte_histoire(ls, f1, f2, tete, empreinte);
        carte_car('|');
        si h != 4294967295 {
            soit bh3 = HDR + 16 * h;
            pour q5 dans 0..@2[bh3 + 9] {
                carte_car(@2[INTR + @2[bh3 + 8] + q5]);
            }
        }
        carte_car(10);
    }
}

// la carte, rangée dans les introns (après le compilateur)
fonction garder_carte(noms, ancien) {
    si noms == 0 {
        retour;
    }
    lire_noms(noms);
    lire_anciens(ancien);
    @2[G + G_HCOPIE] = 0;
    faire_carte(1);
    intron_texte("GU faces ");
    intron_nombre(@2[G + G_NM]);
    intron_car(10);
    pour i dans 0..@2[G + G_CL] {
        intron_car(@2[CARTEB + i]);
    }
    intron_texte("AG\n");
}

// --------------------------------------------------------------------------------------------- la carte montrée
// Les champs de chaque ligne de CARTEB : FOFF + 32 k + f, le début du champ f (0 à 16), FOFF + 32 k + 31, la fin de la
// ligne ; DEBK + k, le début de la molécule.
fonction lire_carte_texte() {
    soit l = @2[G + G_CL];
    soit k = 0;
    soit f = 0;
    @2[FOFF] = 0;
    pour i dans 0..l {
        soit c = @2[CARTEB + i];
        si c == 10 {
            @2[FOFF + 32 * k + 31] = i;
            k = k + 1;
            f = 0;
            @2[FOFF + 32 * k] = i + 1;
        } sinon si c == '|' && f < 16 {
            f = f + 1;
            @2[FOFF + 32 * k + f] = i + 1;
        }
    }
    @2[G + G_NK] = k;
    pour j dans 0..k {
        @2[DEBK + j] = champ_n(j, 0);
    }
}

fonction champ_fin(k, f) {
    si f == 16 {
        retour @2[FOFF + 32 * k + 31];
    }
    retour @2[FOFF + 32 * k + f + 1] - 1;
}

// un nombre au début du champ (« m » ou « i » sauté) ; « - » : 4294967295
fonction champ_n(k, f) {
    soit i = @2[FOFF + 32 * k + f];
    si @2[CARTEB + i] == 'm' || @2[CARTEB + i] == 'i' {
        i = i + 1;
    }
    si @2[CARTEB + i] == '-' {
        retour 4294967295;
    }
    soit x = 0;
    tantque @2[CARTEB + i] >= 48 && @2[CARTEB + i] <= 57 {
        x = x * 10 + @2[CARTEB + i] - 48;
        i = i + 1;
    }
    retour x;
}

fonction champ_vide(k, f) {
    retour champ_fin(k, f) == @2[FOFF + 32 * k + f];
}

fonction champ_car(k, f) {
    retour @2[CARTEB + @2[FOFF + 32 * k + f]];
}

fonction champ_est(k, f, t) {
    soit d = @2[FOFF + 32 * k + f];
    si champ_fin(k, f) - d != longueur(t) {
        retour 0;
    }
    pour i dans 0..longueur(t) {
        si @2[CARTEB + d + i] != car(t, i) {
            retour 0;
        }
    }
    retour 1;
}

fonction ecrire_champ(c, k, f) {
    pour i dans @2[FOFF + 32 * k + f]..champ_fin(k, f) {
        ecrire_car(c, @2[CARTEB + i]);
    }
}

fonction ligne_de_debut(d) {
    soit a = 0;
    soit b = @2[G + G_NK];
    tantque a < b {
        soit m = (a + b) / 2;
        soit x = @2[DEBK + m];
        si x == d {
            retour m;
        }
        si x < d {
            a = m + 1;
        } sinon {
            b = m;
        }
    }
    retour 4294967295;
}

fonction ecrire_nom_mol(k) {
    si champ_est(k, 2, "tete") {
        ecrire_t(1, "la tête");
    } sinon si champ_vide(k, 1) {
        ecrire_car(1, 'm');
        ecrire_u64(1, @2[DEBK + k]);
    } sinon {
        ecrire_champ(1, k, 1);
    }
}

fonction mot_touche(n) {
    si n == 0 {
        ecrire_t(1, "rien");
    } sinon si n == 1 {
        ecrire_t(1, "lit la mémoire");
    } sinon si n == 2 {
        ecrire_t(1, "écrit la mémoire");
    } sinon {
        ecrire_t(1, "le monde");
    }
}

// la liste de débuts du champ f de la ligne k (« a,b,c »), rangée en liste : son nombre
fonction liste_de(k, f, liste) {
    soit i = @2[FOFF + 32 * k + f];
    soit fin = champ_fin(k, f);
    soit n = 0;
    tantque i < fin {
        soit x = 0;
        tantque i < fin && @2[CARTEB + i] != ',' {
            x = x * 10 + @2[CARTEB + i] - 48;
            i = i + 1;
        }
        @2[liste + n] = x;
        n = n + 1;
        i = i + 1;
    }
    retour n;
}

fonction ecrire_liste_noms(liste, n) {
    soit montre = n;
    si montre > 8 {
        montre = 8;
    }
    pour i dans 0..montre {
        si i > 0 {
            ecrire_t(1, ", ");
        }
        soit k = ligne_de_debut(@2[liste + i]);
        si k == 4294967295 {
            ecrire_car(1, 'm');
            ecrire_u64(1, @2[liste + i]);
        } sinon {
            ecrire_nom_mol(k);
        }
    }
    si n > 8 {
        ecrire_t(1, " et ");
        ecrire_u64(1, n - 8);
        ecrire_t(1, " autres");
    }
}

// le centre : l'état de la molécule à cette lecture du brin (avec_temoins : le brin a ses témoins)
fonction ecrire_centre(k, avec_temoins) {
    soit m = molecule_de(@2[DEBK + k]);
    si avec_temoins == 0 || m == 4294967295 {
        ecrire_t(1, "inconnu (ce brin n'a pas de témoins pour la vérifier)");
        retour;
    }
    soit e = @2[MOL + 8 * m + 5];
    si e == E_FAUX {
        ecrire_t(1, "faux (réparée à cette lecture)");
    } sinon si e == E_VARIABLE {
        ecrire_t(1, "variable (abîmée, non réparée)");
    } sinon {
        ecrire_t(1, "vrai (intacte à cette lecture)");
    }
}

fonction montrer_molecule(k, avec_temoins) {
    ecrire_car(1, 10);
    // ce qu'elle est
    ecrire_nom_mol(k);
    ecrire_t(1, " : ");
    soit genre_ecrit = champ_est(k, 2, "fonction") || champ_est(k, 2, "reaction");
    si champ_est(k, 2, "fonction") {
        ecrire_t(1, "une fonction, lignes ");
    } sinon si champ_est(k, 2, "reaction") {
        ecrire_t(1, "une réaction, lignes ");
    } sinon si champ_est(k, 2, "empruntee") {
        ecrire_t(1, "empruntée (au prélude ou à une bibliothèque), ");
    } sinon si champ_est(k, 2, "tete") {
        ecrire_t(1, "le départ du programme, ");
    } sinon {
        ecrire_t(1, "son nom est inconnu (ce brin n'a pas de carte), ");
    }
    si genre_ecrit {
        soit i = @2[FOFF + 32 * k + 3];
        tantque @2[CARTEB + i] != '-' {
            ecrire_car(1, @2[CARTEB + i]);
            i = i + 1;
        }
        ecrire_t(1, " à ");
        i = i + 1;
        tantque @2[CARTEB + i] != '|' {
            ecrire_car(1, @2[CARTEB + i]);
            i = i + 1;
        }
        ecrire_t(1, ", ");
    }
    ecrire_u64(1, champ_n(k, 4));
    ecrire_t(1, " mots\n");
    si !champ_vide(k, 16) {
        ecrire_t(1, "    ");
        ecrire_champ(1, k, 16);
        ecrire_car(1, 10);
    }
    ecrire_t(1, "  au centre         : ");
    ecrire_centre(k, avec_temoins);
    ecrire_car(1, 10);
    // ce qu'elle touche
    soit d = champ_n(k, 5);
    soit t = champ_n(k, 6);
    ecrire_t(1, "  ce qu'elle touche : ");
    si d == t {
        mot_touche(d);
        si champ_vide(k, 8) {
            ecrire_t(1, " (elle-même)");
        } sinon {
            ecrire_t(1, " (elle-même et ses appels)");
        }
    } sinon {
        mot_touche(d);
        ecrire_t(1, " elle-même ; ");
        mot_touche(t);
        ecrire_t(1, " par ses appels");
    }
    ecrire_car(1, 10);
    // ses racines
    ecrire_t(1, "  ses racines       : ");
    soit nc = liste_de(k, 9, CTMP);
    si champ_est(k, 2, "tete") {
        ecrire_t(1, "la racine du programme");
    } sinon si nc == 0 {
        ecrire_t(1, "appelée par personne (sinon par elle-même)");
    } sinon {
        ecrire_t(1, "appelée par ");
        ecrire_liste_noms(CTMP, nc);
    }
    soit pr = champ_n(k, 7);
    si pr == 4294967295 {
        ecrire_t(1, " ; hors d'atteinte depuis la tête");
    } sinon si pr > 0 {
        ecrire_t(1, " ; à ");
        ecrire_u64(1, pr);
        ecrire_t(1, " pas de la tête");
    }
    ecrire_car(1, 10);
    // ses branches
    ecrire_t(1, "  ses branches      : ");
    soit na = liste_de(k, 8, CTMP + 1000);
    si na == 0 {
        ecrire_t(1, "n'appelle rien (une feuille)");
    } sinon {
        ecrire_t(1, "appelle ");
        ecrire_liste_noms(CTMP + 1000, na);
    }
    ecrire_car(1, 10);
    // ses promesses
    ecrire_t(1, "  ses promesses     : ");
    soit lourd = champ_n(k, 13) == 1;
    si genre_ecrit {
        soit ex = champ_n(k, 10);
        soit ga = champ_n(k, 11);
        soit ee = champ_n(k, 12);
        soit rien = 1;
        si ex > 0 {
            ecrire_t(1, "exige ");
            ecrire_u64(1, ex);
            rien = 0;
        }
        si ga > 0 {
            si rien == 0 {
                ecrire_t(1, ", ");
            }
            ecrire_t(1, "garantit ");
            ecrire_u64(1, ga);
            rien = 0;
        }
        si ee > 0 {
            si rien == 0 {
                ecrire_t(1, ", ");
            }
            ecrire_u64(1, ee);
            si ee == 1 {
                ecrire_t(1, " exemple vérifié");
            } sinon {
                ecrire_t(1, " exemples vérifiés");
            }
            rien = 0;
        }
        si lourd {
            si rien == 0 {
                ecrire_t(1, ", ");
            }
            ecrire_t(1, "isotope lourd (relue à l'entrée et à la sortie)");
            rien = 0;
        }
        si rien == 1 {
            ecrire_t(1, "aucune écrite");
        }
    } sinon si champ_est(k, 2, "tete") {
        ecrire_t(1, "aucune");
    } sinon {
        si lourd {
            ecrire_t(1, "isotope lourd ; le reste ");
        }
        si champ_est(k, 2, "empruntee") {
            ecrire_t(1, "inconnues (son texte est dans le prélude ou une bibliothèque)");
        } sinon {
            ecrire_t(1, "inconnues (ce brin n'a pas son texte)");
        }
    }
    ecrire_car(1, 10);
    // sa mémoire
    ecrire_t(1, "  sa mémoire        : ");
    soit hc = champ_car(k, 15);
    si @2[G + G_GARDEE] == 0 || champ_vide(k, 15) {
        ecrire_t(1, "inconnue (ce brin n'a pas de carte)");
    } sinon si hc == '?' {
        ecrire_t(1, "son histoire est inconnue (rien n'était rangé avant)");
    } sinon si hc == 'n' {
        ecrire_t(1, "nouvelle à ce rangement");
    } sinon si hc == 'c' {
        ecrire_t(1, "changée depuis le rangement d'avant");
    } sinon {
        soit kk = champ_n(k, 15);
        ecrire_t(1, "inchangée depuis ");
        ecrire_u64(1, kk);
        si kk == 1 {
            ecrire_t(1, " rangement");
        } sinon {
            ecrire_t(1, " rangements");
        }
    }
    si genre_ecrit {
        ecrire_t(1, " (l'empreinte de son texte)");
    }
    ecrire_car(1, 10);
}

// montrer la carte d'un brin : celle qu'il garde, ou ce que ses mots seuls en disent
fonction montrer_carte(chemin, tout) {
    soit etat = charger(chemin);
    si @2[G + G_ERR] != 0 {
        retour etat;
    }
    soit avec_temoins = @2[G + G_TEM];
    soit gardee = 0;
    si trouver_section("faces") == 1 {
        gardee = 1;
        soit d = @2[G + G_SDEB];
        soit f = @2[G + G_SFIN];
        @2[G + G_CL] = 0;
        pour i dans d..f {
            carte_car(@2[INTR + i]);
        }
        carte_car(10);
    } sinon {
        si @2[G + G_TEM] == 0 {
            decouper();
        }
        @2[G + G_NN] = 0;
        @2[G + G_NA] = 4294967295;
        @2[G + G_HCOPIE] = 0;
        faire_carte(0);
        // sans carte rangée, la mémoire n'est pas sue : le champ de l'histoire vide
    }
    lire_carte_texte();
    @2[G + G_GARDEE] = gardee;
    soit nk = @2[G + G_NK];
    soit ne = 0;
    soit nemp = 0;
    pour k dans 0..nk {
        si champ_est(k, 2, "fonction") || champ_est(k, 2, "reaction") {
            ne = ne + 1;
        } sinon si champ_est(k, 2, "empruntee") {
            nemp = nemp + 1;
        }
    }
    ecrire_t(1, "la carte de ");
    soit db = 0;
    pour i2 dans 0..longueur(chemin) {
        si car(chemin, i2) == '/' || car(chemin, i2) == 92 {
            db = i2 + 1;
        }
    }
    pour i3 dans db..longueur(chemin) {
        ecrire_car(1, car(chemin, i3));
    }
    ecrire_t(1, " : ");
    ecrire_u64(1, nk);
    ecrire_t(1, " molécules");
    si gardee == 1 {
        ecrire_t(1, " ; ");
        ecrire_u64(1, ne);
        ecrire_t(1, " écrites dans le texte, ");
        ecrire_u64(1, nemp);
        ecrire_t(1, " empruntées (au prélude ou à une bibliothèque), et la tête\n");
        ecrire_t(1, "six faces par molécule, comme un dé (ce qu'elle est et ce qu'elle touche, ses racines et ses branches, ses promesses et sa mémoire), et au centre son état à cette lecture\n");
    } sinon {
        ecrire_t(1, "\nce brin n'a pas de carte rangée : ce qui suit vient de ses mots seuls (ce que chaque molécule touche, ses racines, ses branches) ; ses noms, ses promesses et sa mémoire sont inconnus\n");
    }
    pour k2 dans 0..nk {
        si gardee == 0 || tout == 1 || champ_est(k2, 2, "fonction") || champ_est(k2, 2, "reaction") {
            montrer_molecule(k2, avec_temoins);
        }
    }
    si gardee == 1 {
        // les fonctions écrites qui n'ont pas de molécule à elles : recopiées en ligne là où elles servent
        lignes_du_texte();
        lire_entetes();
        soit premier = 1;
        pour h dans 0..@2[G + G_NH] {
            soit bh = HDR + 16 * h;
            soit vue = 0;
            pour k3 dans 0..nk {
                si champ_est(k3, 2, "fonction") || champ_est(k3, 2, "reaction") {
                    soit dd = @2[FOFF + 32 * k3 + 1];
                    si champ_fin(k3, 1) - dd == @2[bh + 1] {
                        soit ok = 1;
                        pour q dans 0..@2[bh + 1] {
                            si @2[CARTEB + dd + q] != @2[INTR + @2[bh] + q] {
                                ok = 0;
                            }
                        }
                        si ok == 1 {
                            vue = 1;
                        }
                    }
                }
            }
            si vue == 0 {
                si premier == 1 {
                    ecrire_t(1, "\nécrites, mais sans molécule à elles (recopiées en ligne là où elles servent, ou jamais appelées) : ");
                    premier = 0;
                } sinon {
                    ecrire_t(1, ", ");
                }
                pour q2 dans 0..@2[bh + 1] {
                    ecrire_car(1, @2[INTR + @2[bh] + q2]);
                }
            }
        }
        si premier == 0 {
            ecrire_car(1, 10);
        }
        si tout == 0 && nemp > 0 {
            ecrire_t(1, "\n(--tout montre aussi les molécules empruntées)\n");
        }
    } sinon si trouver_section("carte") == 1 {
        ecrire_t(1, "\n(ce brin a une carte à quatre faces, rangée en 0.6p : rangez de nouveau pour les six)\n");
    }
    retour etat;
}

// --------------------------------------------------------------------------------------------- l'ARNc (0.6o)
// Le programme naît en ARN (le travail), sans passer par un fichier d'ADN : ses mots compilés, la coiffe, les trois
// témoins, et les introns (les isotopes, le texte, la signature du compilateur). La rétrotranscription de cet ARN
// rend l'ADN entier, celui que « ranger » aurait écrit, octet pour octet.
fonction faire_arnc(mots, sortie, source, isotopes, compilateur, noms, ancien) {
    charger(mots);
    si @2[G + G_ERR] != 0 {
        retour;
    }
    si @2[G + G_N] == 0 {
        refuser("aucun mot à transcrire");
        retour;
    }
    faire_temoins(isotopes);
    si source != 0 {
        garder_source(source);
    }
    garder_compilateur(compilateur);
    garder_carte(noms, ancien);
    si @2[G + G_ERR] != 0 {
        retour;
    }
    ecrire_arn(sortie, "arnc");
    si @2[G + G_ERR] != 0 {
        retour;
    }
    ecrire_u64(1, @2[G + G_N]);
    ecrire_t(1, " mots, ");
    ecrire_u64(1, @2[G + G_NM]);
    ecrire_t(1, " molécules : l'ARNc (sa coiffe, ses témoins, le texte du programme) -> ");
    ecrire_t(1, sortie);
    ecrire_car(1, 10);
}

// Les entrées : deux chemins, puis le verbe (relire s'il manque), puis selon le verbe :
//   relire     ADN [RELU]
//   transcrire ADN SORTIE [ISOFORME] [SIGNATURE DU COMPILATEUR : le texte gardé est alors vérifié]
//   ranger     BRIN ADN [SOURCE] [ISOTOPES] [SIGNATURE DU COMPILATEUR]   (le brin : .mots, .hex, .cub, .arn, .adn)
//   arnc       MOTS ARN [SOURCE] [ISOTOPES] [SIGNATURE DU COMPILATEUR] [NOMS]   (l'ARNc : le programme né en ARN)
//   carte      BRIN [--tout]             (la carte du programme : ce qu'est chaque molécule, ce qu'elle touche, ses
//                                         racines, ses promesses)
//   hex        BRIN HEX
//   cube       BRIN - [FRÉQUENCE]        (cube128-1-FRÉQUENCE.cub, dans le dossier de la machine ; 440 sinon)
//   mots       BRIN MOTS                 (les mots seuls, pour les lancer)
// La sortie : l'état du brin (2 vrai, 1 faux : réparé, 3 variable, 0 : illisible).
fonction principal() {
    preparer();
    soit entree = lire_chemin(CHEMIN);
    soit relu = lire_chemin(CHEMIN2);
    soit verbe = lire_chemin(CHEMIN3);
    si verbe != 0 && texte_egal(verbe, "ranger") {
        soit source = lire_chemin(CHEMIN4);
        soit iso = lire_chemin(CHEMIN5);
        soit comp = lire_chemin(CHEMIN6);
        soit noms = lire_chemin(CHEMIN7);
        soit ancien = lire_chemin(CHEMIN8);
        ranger(entree, relu, source, iso, comp, noms, ancien);
        si @2[G + G_ERR] != 0 {
            sortie(E_INCONNU);
            retour;
        }
        sortie(E_VRAI);
        retour;
    }
    si verbe != 0 && texte_egal(verbe, "carte") {
        soit tout = 0;
        si relu != 0 && texte_egal(relu, "--tout") {
            tout = 1;
        }
        soit e5 = montrer_carte(entree, tout);
        si @2[G + G_ERR] != 0 {
            sortie(E_INCONNU);
            retour;
        }
        sortie(e5);
        retour;
    }
    si verbe != 0 && texte_egal(verbe, "arnc") {
        soit source2 = lire_chemin(CHEMIN4);
        soit iso2 = lire_chemin(CHEMIN5);
        soit comp3 = lire_chemin(CHEMIN6);
        soit noms3 = lire_chemin(CHEMIN7);
        soit ancien3 = lire_chemin(CHEMIN8);
        faire_arnc(entree, relu, source2, iso2, comp3, noms3, ancien3);
        si @2[G + G_ERR] != 0 {
            sortie(E_INCONNU);
            retour;
        }
        sortie(E_VRAI);
        retour;
    }
    si verbe != 0 && texte_egal(verbe, "transcrire") {
        soit isof = lire_chemin(CHEMIN4);
        soit comp2 = lire_chemin(CHEMIN5);
        soit etat_t = transcrire(entree, relu, isof);
        si comp2 != 0 && (etat_t == E_VRAI || etat_t == E_FAUX) && @2[G + G_ERR] == 0 {
            verifier_texte(comp2);
        }
        sortie(etat_t);
        retour;
    }
    si verbe != 0 && (texte_egal(verbe, "hex") || texte_egal(verbe, "cube") || texte_egal(verbe, "mots")) {
        soit fr0 = lire_chemin(CHEMIN4);
        soit e2 = charger(entree);
        si @2[G + G_ERR] != 0 {
            sortie(E_INCONNU);
            retour;
        }
        si e2 == E_VARIABLE {
            ecrire_t(1, "rien n'est écrit : le brin est gardé tel qu'il a été lu, pour la preuve\n");
            sortie(e2);
            retour;
        }
        si texte_egal(verbe, "hex") {
            ecrire_hex_fichier(relu);
        } sinon si texte_egal(verbe, "cube") {
            soit fr = 440;
            si fr0 != 0 {
                fr = nombre_dans(fr0, 0);
            }
            si fr > 16777215 {
                refuser("la fréquence d'un cube est un nombre, de 0 à 16 777 215");
            } sinon {
                ecrire_cube(fr);
            }
        } sinon {
            ecrire_mots_seuls(relu);
        }
        si @2[G + G_ERR] != 0 {
            sortie(E_INCONNU);
            retour;
        }
        sortie(e2);
        retour;
    }
    si entree == 0 {
        entree = "code.adn";
    }
    lire_adn(entree);
    si @2[G + G_ERR] != 0 {
        sortie(E_INCONNU);
        retour;
    }
    soit etat = lire();
    rendre_compte(etat);
    si etat == E_VARIABLE {
        ecrire_t(1, "rien n'est relu : l'ADN est gardé tel qu'il a été lu, pour la preuve\n");
    } sinon si relu != 0 {
        ecrire_adn(relu);
    }
    sortie(etat);
}
