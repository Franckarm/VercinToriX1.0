    @2[V_FORME + 35] = 1;
    @2[V_FORME + 36] = 4;
    @2[V_FORME + 37] = 1;
    @2[V_FORME + 38] = 2;
    @2[V_FORME + 39] = 4;
    @2[V_FORME + 40] = 1;
    @2[V_FORME + 41] = 13;
    @2[V_FORME + 42] = 14;
    @2[V_FORME + 43] = 3;
    @2[V_FORME + 44] = 13;
    @2[V_FORME + 45] = 14;
    @2[V_FORME + 56] = 13;
    @2[V_FORME + 64] = 13;
    @2[V_FORME + 65] = 13;
    @2[V_FORME + 66] = 13;
    @2[V_FORME + 67] = 13;
    @2[V_FORME + 68] = 13;
