fonction colonne(x, px0, py0, pa) {
    soit a = (pa + x * 2 - 128) & 1023;
    soit cosa = @1[COSB + a];
    soit sina = @1[SINB + a];
    soit px = px0;
    soit py = py0;
    soit d = 0;
    soit pas = 0;
    tantque pas < 90 {
        soit nx1 = px + ((cosa * 64) >> 8) - 64;
        soit ny1 = py + ((sina * 64) >> 8) - 64;
        si @1[MAPB + (ny1 >> 8) * 16 + (nx1 >> 8)] != 0 {
            arrêter;
        }
        px = nx1;
        py = ny1;
        d = d + 64;
        pas = pas + 1;
    }
    soit l2 = 32;
    tantque l2 > 0 {
        soit nx2 = px + ((cosa * l2) >> 8) - l2;
        soit ny2 = py + ((sina * l2) >> 8) - l2;
        si @1[MAPB + (ny2 >> 8) * 16 + (nx2 >> 8)] == 0 {
            px = nx2;
            py = ny2;
            d = d + l2;
        }
        l2 = l2 >> 1;
    }
    soit wx = px + ((cosa * 8) >> 8) - 8;
    soit wy = py + ((sina * 8) >> 8) - 8;
    soit wt = @1[MAPB + (wy >> 8) * 16 + (wx >> 8)];
    si wt == 0 {
        wt = 1;
    }
    soit perp = (d * (@1[COSB + ((x * 2 + 896) & 1023)] - 256)) >> 8;
    si perp < 16 {
        perp = 16;
    }
    soit h = 13312 / perp;
    soit top = 0;
    soit bot = H;
    si h < H {
        top = (H - h) >> 1;
        bot = top + h;
    }
    soit br = (255 * 512) / (512 + perp);
    soit wc = @1[WCB + wt];
    soit cr = ((wc >> 24) * br) >> 8;
    soit cg = (((wc >> 16) & 255) * br) >> 8;
    soit cb = (((wc >> 8) & 255) * br) >> 8;
    soit mur = (cr << 24) | (cg << 16) | (cb << 8) | 255;
    pour y dans 0..H {
        soit c = mur;
        si y < top {
            soit cc = 20 + y * 3;
            c = (cc << 24) | (cc << 16) | ((cc + 40) << 8) | 255;
        } sinon {
            si y >= bot {
                soit ff = 20 + (H - y) * 3;
                c = ((ff + 20) << 24) | (ff << 16) | ((ff >> 1) << 8) | 255;
            }
        }
        @2[FB + y * W + x] = c;
    }
}

fonction principal() {
    soit px = entrée();
    soit py = entrée();
    soit pa = entrée();
    pour x dans 0..W {
        colonne(x, px, py, pa);
    }
}
