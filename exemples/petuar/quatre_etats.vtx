// L'état d'un flottant_petuar est une valeur de la logique à quatre valeurs (Belnap), gravée dans son premier quit :
//   inconnu  (A) : le nombre n'a pas été calculé : il manque une information (une mémoire jamais écrite est inconnue)
//   faux     (C) : négatif ; vrai (G) : positif
//   variable (T/U) : contradiction : 0/0, infini moins infini, racine d'un négatif
// Le binary128 de l'IEEE 754 confond les deux premiers cas dans un seul NaN ; ici, le nombre dit pourquoi il n'en est pas un.
// Dans un calcul, variable l'emporte sur inconnu, et inconnu sur un nombre. Un flottant_petuar ne sert pas de condition :
// on le compare, ou on demande son état avec « selon etat(x) ».
fonction dire(nom: texte, x: flottant_petuar) {
    afficher(nom);
    selon etat(x) {
        vrai { afficher("  positif : "); }
        faux { afficher("  négatif : "); }
        inconnu { afficher("  inconnu : il manque une information"); }
        variable { afficher("  variable : contradiction"); }
    }
    afficher(x);
    afficher(texte_adn(bits(x)));
}
fonction principal() {
    soit zero = 0Q;
    soit un = 1Q;
    dire("1/3", un / 3Q);
    dire("-2.5", -2.5Q);
    dire("0/0", zero / zero);
    dire("racine(-1)", racine(-un));
    dire("une mémoire jamais écrite", comme_flottant_petuar(0LL));
    dire("inconnu + 1", inconnu_petuar() + un);
    dire("inconnu + variable", inconnu_petuar() + variable_petuar());
    dire("1/0", un / zero);
    dire("infini - infini", un / zero - un / zero);
    // une comparaison avec un état inconnu ou variable est fausse dans les deux sens
    afficher(inconnu_petuar() < un);
    afficher(inconnu_petuar() >= un);
}
